+static int preexec_setup_plan(void)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    QemuCrucibleProcessPurposePlan *plan = &owner->plan;
+    const uint8_t *payload = owner->frame + QEMU_CRUCIBLE_PREEXEC_SETUP_PAYLOAD_OFFSET;
+    int fd = owner->descriptors[QEMU_CRUCIBLE_PREEXEC_SETUP_PURPOSE_PLAN_INDEX];
+    /* These are the existing Linux fcntl seal ABI constants used by memfd.h. */
+    const int get_seals = 1024 + 10;
+    const int required_seals = 1 | 2 | 4 | 8;
+    long status;
+
+    status = preexec_setup_syscall5(SYS_fstat, fd,
+        (long)(uintptr_t)&owner->plan_before, 0, 0, 0);
+    if (status < 0) {
+        return (int)status;
+    }
+    if (!S_ISREG(owner->plan_before.st_mode) || owner->plan_before.st_size < 40 ||
+        (uint64_t)owner->plan_before.st_size >
+            QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_TOTAL_MAX) {
+        return -EINVAL;
+    }
+    status = preexec_setup_syscall5(SYS_fcntl, fd, get_seals, 0, 0, 0);
+    if (status < 0) {
+        return (int)status;
+    }
+    owner->plan_seals = status;
+    if ((owner->plan_seals & required_seals) != required_seals) {
+        return -EPERM;
+    }
+    status = preexec_setup_pread(fd, owner->plan_header, 40, 0);
+    if (!status && !preexec_setup_compare(owner->plan_header,
+            QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN9_MAGIC, 8)) {
+        status = preexec_setup_pread(fd, owner->plan_header + 40, 8, 40);
+    }
+    if (!status) {
+        status = preexec_literal_purpose_plan_header(
+            owner->plan_header, owner->plan_before.st_size, plan);
+    }
+    if (!status && plan->workspace_bytes) {
+        status = preexec_setup_pread(fd, owner->workspace_wire,
+            sizeof(owner->workspace_wire), plan->workspace_offset);
+        if (!status) {
+            status = preexec_literal_qemu_crucible_process_workspace_purpose_decode_v2(
+                owner->workspace_wire, sizeof(owner->workspace_wire), &plan->workspace);
+        }
+    }
+    if (!status) {
+        status = preexec_setup_pread(fd, owner->startup_wire,
+            sizeof(owner->startup_wire), plan->startup_offset);
+    }
+    if (!status) {
+        status = preexec_literal_qemu_crucible_original_startup_decode(
+            owner->startup_wire, sizeof(owner->startup_wire), &plan->startup);
+    }
+    if (!status) {
+        status = preexec_setup_pread(fd, owner->purpose_wire,
+            sizeof(owner->purpose_wire), plan->purpose_offset);
+    }
+    if (!status) {
+        status = preexec_literal_qemu_crucible_process_purpose_decode_v8(
+            owner->purpose_wire, sizeof(owner->purpose_wire), &plan->purpose);
+    }
+    if (status) {
+        return (int)status;
+    }
+    if ((owner->frame[4] == QEMU_CRUCIBLE_PREEXEC_SETUP_TAG_V6) !=
+            (plan->schema == 9) ||
+        plan->startup.original_total_bytes != plan->purpose.original_total ||
+        plan->startup.process_generation != plan->purpose.process_generation ||
+        plan->purpose.process_generation != preexec_setup_be64(payload + 16) ||
+        preexec_setup_compare(plan->startup.cap_id,
+            plan->purpose.containing_capability, 32) ||
+        (!!plan->workspace_bytes !=
+            (owner->descriptor_count == (plan->schema == 9 ?
+                QEMU_CRUCIBLE_PREEXEC_SETUP_V6_WORKSPACE_FDS :
+                QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_FDS)))) {
+        return -ESTALE;
+    }
+    if (plan->workspace_bytes &&
+        (plan->workspace.original_total != plan->purpose.original_total ||
+         plan->workspace.process_generation != plan->purpose.process_generation ||
+         plan->workspace.account_generation != plan->purpose.account_generation ||
+         plan->workspace.host_owner_extent > plan->purpose.assigned_outside ||
+         plan->workspace.account_generation != preexec_setup_be64(payload + 24) ||
+         plan->workspace.workspace_generation != preexec_setup_be64(payload + 32) ||
+         plan->workspace.device != preexec_setup_be64(payload + 40) ||
+         plan->workspace.inode != preexec_setup_be64(payload + 48) ||
+         preexec_setup_compare(plan->workspace.containing_capability,
+             plan->purpose.containing_capability, 32))) {
+        return -ESTALE;
+    }
+    if (plan->subscription_bytes) {
+        status = preexec_setup_pread(fd, owner->subscription_wire,
+            sizeof(owner->subscription_wire), plan->subscription_offset);
+        if (!status) {
+            status = preexec_literal_qemu_crucible_publisher_purpose_decode_v1(
+                owner->subscription_wire, sizeof(owner->subscription_wire),
+                &plan->subscription);
+        }
+        if (status) {
+            return status;
+        }
+        if (plan->subscription.account_generation != plan->purpose.account_generation ||
+            plan->subscription.process_generation != plan->purpose.process_generation ||
+            preexec_setup_compare(plan->subscription.capability,
+                plan->purpose.containing_capability, 32) ||
+            preexec_setup_compare(plan->subscription.reservation,
+                plan->purpose.family.source.assignment_id, 32)) {
+            return -ESTALE;
+        }
+    }
+    status = preexec_setup_syscall5(SYS_fstat, fd,
+        (long)(uintptr_t)&owner->plan_after, 0, 0, 0);
+    if (status < 0) {
+        return (int)status;
+    }
+    status = preexec_setup_syscall5(SYS_fcntl, fd, get_seals, 0, 0, 0);
+    if (status < 0) {
+        return (int)status;
+    }
+    if (status != owner->plan_seals ||
+        owner->plan_before.st_dev != owner->plan_after.st_dev ||
+        owner->plan_before.st_ino != owner->plan_after.st_ino ||
+        owner->plan_before.st_mode != owner->plan_after.st_mode ||
+        owner->plan_before.st_size != owner->plan_after.st_size) {
+        return -ESTALE;
+    }
+    owner->plan_validated = true;
+    return 0;
+}
