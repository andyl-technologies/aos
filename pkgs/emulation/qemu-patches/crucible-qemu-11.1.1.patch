+static void test_hot_fork_source_graph_receipt_stale(void)
+{
+    HotForkSourceSetFixture fixture;
+    QemuBlockHotForkSourceSet *sources;
+    QemuBlockHotForkChildFiles *plan;
+    QemuBlockHotForkSourceSetInventory inventory;
+    QemuBlockHotForkGraphReceipt graph = { 0 };
+    QemuBlockHotForkChildFile files[2];
+    char base_path[] = "/tmp/qemu-hot-fork-chain-base-XXXXXX";
+    char child_paths[2][80];
+    BdrvChild *backing;
+    char *original_edge;
+    struct stat original_stat;
+    struct timespec original_times[2];
+    uint8_t original_byte, changed_byte;
+    pid_t child;
+    int base, status;
+    size_t index;
+
+    test_hot_fork_source_set_setup(&fixture, false);
+    blk_unref(fixture.roots[2].backend);
+    unlink(fixture.paths[2]);
+    base = mkstemp(base_path);
+    g_assert_cmpint(base, >=, 0);
+    close(base);
+    bdrv_img_create(base_path, "qcow2", NULL, NULL, NULL,
+                    HOT_FORK_SNAPSHOT_SIZE, BDRV_O_RDWR, true, &error_abort);
+    bdrv_img_create(fixture.paths[2], "qcow2", base_path, "qcow2", NULL,
+                    HOT_FORK_SNAPSHOT_SIZE, BDRV_O_RDWR, true, &error_abort);
+    {
+        QDict *options = qdict_new();
+
+        qdict_put_str(options, "driver", "qcow2");
+        qdict_put_str(options, "node-name", "set-readonly-chain");
+        qdict_put_str(options, "file.driver", "file");
+        qdict_put_str(options, "file.filename", fixture.paths[2]);
+        fixture.roots[2].backend =
+            blk_new_open(NULL, NULL, options, 0, &error_abort);
+        fixture.roots[2].root = blk_bs(fixture.roots[2].backend);
+    }
+    for (index = 0; index < G_N_ELEMENTS(files); index++) {
+        g_snprintf(child_paths[index], sizeof(child_paths[index]),
+                    "/tmp/qemu-hot-fork-chain-child-%zu-XXXXXX", index);
+        files[index] = (QemuBlockHotForkChildFile) {
+            .node = fixture.roots[index].root->file->bs,
+            .descriptor = mkstemp(child_paths[index]),
+        };
+        g_assert_cmpint(files[index].descriptor, >=, 0);
+    }
+
+    sources = qemu_block_hot_fork_source_set_new(
+        fixture.roots, G_N_ELEMENTS(fixture.roots), &error_abort);
+    g_assert_true(qemu_block_hot_fork_source_set_freeze(sources,
+                                                        &error_abort));
+    g_assert_true(qemu_block_hot_fork_source_set_graph_receipt(
+        sources, 64, 16 * HOT_FORK_SNAPSHOT_SIZE, &graph, &error_abort));
+    g_assert_cmpuint(graph.count, ==, 8);
+    {
+        int64_t backing_index = -1;
+        bool backing_file_found = false;
+
+        for (index = 0; index < graph.count; index++) {
+            QemuBlockHotForkGraphMember *member = &graph.members[index];
+
+            if (member->root_index == 2 &&
+                !strcmp(member->edge_name, "backing")) {
+                backing_index = member->node_index;
+                g_assert_cmpint(member->parent_index, ==, 0);
+            }
+        }
+        g_assert_cmpint(backing_index, >=, 0);
+        for (index = 0; index < graph.count; index++) {
+            QemuBlockHotForkGraphMember *member = &graph.members[index];
+
+            if (member->root_index == 2 && member->file_backed &&
+                member->parent_index == backing_index) {
+                g_autofree char *contents = NULL;
+                g_autofree char *digest = NULL;
+                gsize length;
+
+                g_assert_cmpstr(member->file_path, ==, base_path);
+                g_assert_true(g_file_get_contents(base_path, &contents,
+                                                  &length, NULL));
+                g_assert_cmpuint(member->file_size, ==, length);
+                digest = g_compute_checksum_for_data(
+                    G_CHECKSUM_SHA256, (const guchar *)contents, length);
+                g_assert_cmpstr(member->file_sha256, ==, digest);
+                backing_file_found = true;
+            }
+        }
+        g_assert_true(backing_file_found);
+    }
+    qemu_block_hot_fork_graph_receipt_destroy(&graph);
+
+    {
+        BlockDriverState *descendant = fixture.roots[2].root->backing->bs;
+        char original_name[sizeof(descendant->node_name)];
+
+        memcpy(original_name, descendant->node_name, sizeof(original_name));
+        g_strlcpy(descendant->node_name, "changed-chain-node",
+                  sizeof(descendant->node_name));
+        g_assert_false(qemu_block_hot_fork_source_set_query(
+            sources, &inventory, NULL));
+        g_assert_false(qemu_block_hot_fork_source_set_graph_receipt(
+            sources, 64, 16 * HOT_FORK_SNAPSHOT_SIZE, &graph, NULL));
+        memcpy(descendant->node_name, original_name, sizeof(original_name));
+    }
+
+    backing = fixture.roots[2].root->backing;
+    original_edge = backing->name;
+    backing->name = g_strdup("swapped-backing");
+    g_assert_false(qemu_block_hot_fork_source_set_query(sources,
+                                                        &inventory, NULL));
+    g_free(backing->name);
+    backing->name = original_edge;
+    g_assert_true(qemu_block_hot_fork_source_set_query(sources,
+                                                       &inventory,
+                                                       &error_abort));
+    {
+        BlockDriverState *unexpected = bdrv_new();
+
+        g_assert_false(qemu_block_hot_fork_source_set_graph_receipt(
+            sources, 64, 16 * HOT_FORK_SNAPSHOT_SIZE, &graph, NULL));
+        bdrv_unref(unexpected);
+        g_assert_true(qemu_block_hot_fork_source_set_graph_receipt(
+            sources, 64, 16 * HOT_FORK_SNAPSHOT_SIZE, &graph,
+            &error_abort));
+        qemu_block_hot_fork_graph_receipt_destroy(&graph);
+    }
+    plan = qemu_block_hot_fork_child_files_prepare(
+        sources, files, G_N_ELEMENTS(files), 16 * HOT_FORK_SNAPSHOT_SIZE,
+        &error_abort);
+    g_assert_nonnull(plan);
+    g_assert_true(qemu_aio_hot_fork_prepare_thread_pools(&error_abort));
+
+    {
+        g_autofree char *retained_path = g_strdup_printf("%s-retained", base_path);
+        int replacement;
+
+        g_assert_cmpint(rename(base_path, retained_path), ==, 0);
+        replacement = open(base_path, O_CREAT | O_EXCL | O_RDWR, 0600);
+        g_assert_cmpint(replacement, >=, 0);
+        close(replacement);
+        g_assert_false(qemu_block_hot_fork_source_set_graph_receipt(
+            sources, 64, 16 * HOT_FORK_SNAPSHOT_SIZE, &graph, NULL));
+        g_assert_null(qemu_block_hot_fork_child_files_prepare(
+            sources, files, G_N_ELEMENTS(files),
+            16 * HOT_FORK_SNAPSHOT_SIZE, NULL));
+        g_assert_cmpint(unlink(base_path), ==, 0);
+        g_assert_cmpint(rename(retained_path, base_path), ==, 0);
+    }
+
+    base = open(base_path, O_RDWR);
+    g_assert_cmpint(base, >=, 0);
+    g_assert_cmpint(fstat(base, &original_stat), ==, 0);
+    original_times[0] = original_stat.st_atim;
+    original_times[1] = original_stat.st_mtim;
+    g_assert_cmpint(pread(base, &original_byte, 1, 1024), ==, 1);
+    changed_byte = original_byte ^ 0xff;
+    g_assert_cmpint(pwrite(base, &changed_byte, 1, 1024), ==, 1);
+    g_assert_cmpint(futimens(base, original_times), ==, 0);
+    g_assert_false(qemu_block_hot_fork_source_set_graph_receipt(
+        sources, 64, 16 * HOT_FORK_SNAPSHOT_SIZE, &graph, NULL));
+    child = fork();
+    g_assert_cmpint(child, >=, 0);
+    if (child == 0) {
+        test_hot_fork_child_alarm(15);
+        g_assert_false(qemu_block_hot_fork_child_files_install(plan, NULL));
+        _exit(0);
+    }
+    g_assert_cmpint(waitpid(child, &status, 0), ==, child);
+    g_assert_true(WIFEXITED(status));
+    g_assert_cmpint(WEXITSTATUS(status), ==, 0);
+    g_assert_true(qemu_block_hot_fork_child_files_free(plan, &error_abort));
+    g_assert_null(qemu_block_hot_fork_child_files_prepare(
+        sources, files, G_N_ELEMENTS(files), 16 * HOT_FORK_SNAPSHOT_SIZE,
+        NULL));
+    g_assert_cmpint(pwrite(base, &original_byte, 1, 1024), ==, 1);
+    g_assert_cmpint(futimens(base, original_times), ==, 0);
+    close(base);
+
+    g_assert_true(qemu_block_hot_fork_source_set_restore(sources,
+                                                        &error_abort));
+    g_assert_true(qemu_block_hot_fork_source_set_free(sources,
+                                                     &error_abort));
+    for (index = 0; index < G_N_ELEMENTS(files); index++) {
+        status = close(files[index].descriptor);
+        g_assert_cmpint(status, ==, 0);
+        unlink(child_paths[index]);
+    }
+    test_hot_fork_source_set_cleanup(&fixture);
+    unlink(base_path);
+}
