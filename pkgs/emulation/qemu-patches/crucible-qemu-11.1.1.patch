+{
+    abort();
+}
+
+static int apic_getter_initial_dispatch(APICCommonState *apic,
+                                       APICCommonClass *klass)
+{
+    abort();
+}
+
+#undef X86_CPU
+#define X86_CPU(cpu) (&input_cpu)
+
+int cpu_get_apic_tpr(APICCommonState *apic)
+{
+    getter_calls++;
+    assert(apic == input_cpu.apic_state);
+    assert(refused_status < 0);
+    return refused_status;
+}
+
+/* These unrelated read branches must never run in this CR8 control. */
+uint32_t cpu_cc_compute_all(CPUX86State *env)
+{
+    abort();
+}
+
+uint32_t cpu_get_mxcsr(CPUX86State *env)
+{
+    abort();
+}
+
+bool tcg_allowed;
+
+const TargetInfo *target_info(void)
+{
+    static const TargetInfo input = { .endianness = ENDIAN_MODE_LITTLE };
+
+    return &input;
+}
+"""
+
+
+CHECKS = r"""
+int main(void)
+{
+    APICCommonState apic = { 0 };
+    const int refusals[] = { -EPERM, -ENOKEY, -ESTALE, -EOVERFLOW,
+                             -EDEADLK, -EIO, -ETIMEDOUT, -ENOTSUP };
+    uint8_t value[8], expected[8];
+    GByteArray *output = g_byte_array_new();
+    CPUState *cpu = &input_cpu.parent_obj;
+
+    input_cpu.apic_state = &apic;
+    assert(common_cpu_get_apic_tpr(NULL) == 0);
+    memset(expected, 0xa5, sizeof(expected));
+    for (size_t index = 0; index < G_N_ELEMENTS(refusals); index++) {
+        refused_status = refusals[index];
+        getter_calls = 0;
+        memcpy(value, expected, sizeof(value));
+        assert(x86_crucible_register_read(cpu, X86_CRUCIBLE_CR8,
+                                          value, sizeof(value)) == refused_status);
+        assert(getter_calls == 1);
+        assert(!memcmp(value, expected, sizeof(value)));
+
+        g_byte_array_set_size(output, 0);
+        g_byte_array_append(output, expected, sizeof(expected));
+        assert(x86_cpu_gdb_read_register(cpu, output, IDX_CTL_CR8_REG) == 0);
+        assert(getter_calls == 2);
+        assert(output->len == sizeof(expected));
+        assert(!memcmp(output->data, expected, sizeof(expected)));
+    }
+    g_byte_array_unref(output);
+
+    for (unsigned tpr = 0; tpr <= UINT8_MAX; tpr++) {
+        apic.tpr = tpr;
+        assert(kvm_apic_get_tpr(&apic) == tpr >> 4);
+        assert(xen_apic_get_tpr(&apic) == 0);
+        assert(whpx_apic_get_tpr(&apic) == tpr);
+    }
+    puts("PASS literal CR8/GDB refusal withholding and distinct scalar producers; no Source issuer");
+    return 0;
+}
+"""
+
+
+def translation_unit(source):
+    extract = runpy.run_path(str(source / "tests/unit/extract-crucible-startup-source-controls.py"))
+    function = extract["function"]
+    registers = (source / "target/i386/crucible-register.c").read_text()
+    gdb = (source / "target/i386/gdbstub.c").read_text()
+    headers = r"""
