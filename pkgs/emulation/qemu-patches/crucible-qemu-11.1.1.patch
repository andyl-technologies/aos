+static int fingerprint_retirement_return_identity(
+    struct QemuCrucibleFingerprintRetirementLoan *loan)
+{
+    if (loan != &ordinary_fingerprint || !bql_locked() || !qemu_in_main_thread() ||
+        current_cpu || qemu_in_coroutine() || candidate_capture.active ||
+        (capture_active && (!logical_capture->active ||
+                            logical_capture->generation != loan->operation_capture_generation ||
+                            fingerprint_root_frame.active || logical_capture->source_claim ||
+                            logical_capture->progress.borrowed || logical_capture->progress.published)) ||
+        loan->process != getpid() || !qemu_thread_is_self(&loan->thread) ||
+        loan->invoking || !loan->attempted || !loan->operation_borrowed ||
+        !loan->regions || loan->regions != admission_regions) {
+        return -EPERM;
