diff --git a/tests/unit/extract-crucible-x86-table-projection.py b/tests/unit/extract-crucible-x86-table-projection.py
new file mode 100644
index 0000000000000000000000000000000000000000..228f5bfb67fb64768c9806c3617cc3087a5305b7
--- /dev/null
+++ b/tests/unit/extract-crucible-x86-table-projection.py
@@ -0,0 +1,92 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Extract source-bound current and omission-predecessor projection bodies.
+
+Only function/descriptor symbols are renamed.  The predecessor reconstruction
+must match its native function and metadata hashes before any output is written.
+"""
+
+import argparse
+import hashlib
+from pathlib import Path
+
+
+CURRENT_SOURCE_SHA256 = (
+    "d36a710009f133eefdde7430c2f64392b528ab1cb65cc55815b6181219be47b4"
+)
+PREDECESSOR_FUNCTION_SHA256 = (
+    "10b4298b377498bc2cb6f09911669aaf7b31cf3a2766309e7194ec6b1f34ed6b"
+)
+PREDECESSOR_METADATA_SHA256 = (
+    "9cfd211864c028ea2db7f81126711f61eb679275e7676f264a36e3d1adeca561"
+)
+TABLE_WRITES = """    qemu_put_be64(f, env->gdt.base);
+    qemu_put_be32(f, env->gdt.limit);
+    qemu_put_be64(f, env->idt.base);
+    qemu_put_be32(f, env->idt.limit);
+"""
+
+
+def sha256(text):
+    return hashlib.sha256(text.encode()).hexdigest()
+
+
+def definition(source, signature, trailing_semicolon=False):
+    start = source.index(signature)
+    opening = source.index("{", start)
+    depth = 0
+
+    for index in range(opening, len(source)):
+        depth += (source[index] == "{") - (source[index] == "}")
+        if depth == 0:
+            end = index + 1 + int(trailing_semicolon)
+            return source[start:end]
+
+    raise ValueError(f"Unterminated native definition: {signature}")
+
+
+def extract(source):
+    if sha256(source) != CURRENT_SOURCE_SHA256:
+        raise ValueError("Projection source differs from its reviewed input")
+
+    conversion = definition(source, "static void cpu_get_fp80(")
+    current = definition(source, "static bool x86_cpu_fingerprint_projection(")
+    metadata = definition(
+        source,
+        "static const CrucibleFingerprintProjection x86_cpu_fingerprint =",
+        trailing_semicolon=True,
+    )
+    if current.count(TABLE_WRITES) != 1:
+        raise ValueError("Expected exactly the four direct table writes")
+
+    predecessor = current.replace(TABLE_WRITES, "", 1)
+    predecessor_metadata = metadata.replace("x86-cpu.v3", "x86-cpu.v2")
+    predecessor_metadata = predecessor_metadata.replace(
+        ".version = 3", ".version = 2"
+    )
+    if sha256(predecessor) != PREDECESSOR_FUNCTION_SHA256:
+        raise ValueError("Omission body is not the literal native predecessor")
+    if sha256(predecessor_metadata) != PREDECESSOR_METADATA_SHA256:
+        raise ValueError("Metadata is not the literal native predecessor")
+
+    predecessor = predecessor.replace(
+        "x86_cpu_fingerprint_projection", "x86_cpu_fingerprint_predecessor"
+    )
+    predecessor_metadata = predecessor_metadata.replace(
+        "x86_cpu_fingerprint_projection", "x86_cpu_fingerprint_predecessor"
+    ).replace("x86_cpu_fingerprint =", "x86_cpu_fingerprint_v2 =")
+    return "\n\n".join(
+        [conversion, current, metadata, predecessor, predecessor_metadata]
+    ) + "\n"
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("source", type=Path)
+    parser.add_argument("output", type=Path)
+    arguments = parser.parse_args()
+    output = extract(arguments.source.read_text())
+    arguments.output.write_text(output)
+
+
+if __name__ == "__main__":
+    main()
