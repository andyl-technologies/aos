+static void test_piix4_hotplug_configuration_presence(void)
+{
+    PIIX4PMState first = { 0 };
+    PIIX4PMState second = { 0 };
+    g_autoptr(GBytes) first_bytes = NULL;
+    g_autoptr(GBytes) second_bytes = NULL;
+
+    first_bytes = project_piix4_hotplug(&first, false, true);
+    second.acpi_memory_hotplug.is_enabled = true;
+    second_bytes = project_piix4_hotplug(&second, false, true);
+    g_assert_false(g_bytes_equal(first_bytes, second_bytes));
+
+    second = (PIIX4PMState) { 0 };
+    first_bytes = project_piix4_hotplug(&first, false, true);
+    second_bytes = project_piix4_hotplug(&second, true, true);
+    g_assert_false(g_bytes_equal(first_bytes, second_bytes));
+
+    second.cpuhp_state.selector = 7;
+    first_bytes = project_piix4_hotplug(&first, false, true);
+    second_bytes = project_piix4_hotplug(&second, false, true);
+    g_assert_true(g_bytes_equal(first_bytes, second_bytes));
