+                    !binding->holder || *binding->holder != binding ||
+                    binding->registered)) {
+        status = -EPERM;
+    }
+    if (!status) {
+        /* Existing preeffect component capture is not a receipt proving a
+         * Native descriptor or a complete grouped publication. */
+        binding->registered = true;
