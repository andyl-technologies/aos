+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise the production TSC search hint with real GLib arrays and threads.
+
+Lookup, manifest sorting/finalization, activation, projection and restore guards
+are extracted unchanged. Registration and backing-storage relocation are bounded,
+quiescent providers; decoded transforms, virtual time and error reporting are
+explicit providers. This does not prove concurrent registry mutation, translated
+execution, a migration stream, the complete retained fork, or performance.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import runpy
+import shlex
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parents[2]
+definition = runpy.run_path(str(Path(__file__).with_name(
+    "test-crucible-net-output-stop.py")))["definition"]
+
+
+PRELUDE = r"""
+#include <glib.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+/* CLOCK_SOURCE_KIND_DEFINITION */
+#define CRUCIBLE_CLOCK_HEALTHY 1
+#define ICOUNT_PRECISE 1
+#define QEMU_CLOCK_VIRTUAL 0
+
+typedef struct CrucibleClockSource {
+    struct { uint16_t source_kind, architecture; const char *id; } capability;
+    uint32_t instance;
+    GArray *rules;
+    void *source_rule;
+    int64_t additive_picos;
+    uint64_t drift_numerator, drift_denominator;
+    bool frozen, synchronizing;
+    unsigned source_state;
+    uint64_t provider_value;
+} CrucibleClockSource;
+
+static GArray *crucible_clock_sources;
+static bool crucible_clock_manifest_finalized, crucible_clock_bindings_sealed;
+static bool crucible_clock_terminal;
+static unsigned crucible_clock_vmstate_load_depth;
+static __thread unsigned row_reads;
+static bool sim_mode = true;
+static unsigned icount_mode = ICOUNT_PRECISE;
+static unsigned mode_reads, projections, failures;
+
+bool qemu_crucible_fault_clock_source_active(uint16_t kind, uint32_t instance);
+bool qemu_crucible_fault_clock_project_ps(uint16_t kind, uint32_t instance,
+    uint64_t raw, uint64_t *value, bool *read_error);
+
+static void *checked_row(GArray *array, size_t width, guint index)
+{
+    g_assert_cmpuint(index, <, array->len);
+    row_reads++;
+    return array->data + width * index;
+}
+
+#undef g_array_index
+#define g_array_index(array, type, index) \
+    (*(type *)checked_row((array), sizeof(type), (index)))
+
+static bool current_accel_is_sim(void)
+{
+    mode_reads++;
+    return sim_mode;
+}
+
+#define icount_enabled() icount_mode
+
+static uint64_t qemu_clock_get_ps(unsigned kind)
+{
+    g_assert_cmpuint(kind, ==, QEMU_CLOCK_VIRTUAL);
+    return 1000;
+}
+
+static bool crucible_clock_source_value(CrucibleClockSource *source,
+    uint64_t raw, uint64_t now, uint64_t opportunity, bool observing,
+    uint64_t *value, bool *read_error)
+{
+    g_assert_cmpuint(raw, ==, 7);
+    g_assert_cmpuint(now, ==, 1000);
+    g_assert_cmpuint(opportunity, ==, 0);
+    g_assert_false(observing);
+    projections++;
+    *value = source->provider_value;
+    *read_error = source->source_state == 4;
+    return true;
+}
+
+static void crucible_clock_report_read_failure(CrucibleClockSource *source,
+    uint16_t kind, uint32_t instance, uint64_t raw, const char *reason)
+{
+    (void)source;
+    (void)kind;
+    (void)instance;
+    (void)raw;
+    g_assert_nonnull(reason);
+    failures++;
+}
+"""
+
+
+CHECKS = r"""
+static CrucibleClockSource make_source(uint16_t kind, uint32_t instance,
+                                        const char *id, uint64_t value)
+{
+    return (CrucibleClockSource) {
+        .capability = { .source_kind = kind, .architecture = 1, .id = id },
+        .instance = instance, .drift_numerator = 1, .drift_denominator = 1,
+        .source_state = CRUCIBLE_CLOCK_HEALTHY, .provider_value = value,
+    };
+}
+
+/* Registration is quiescent and rejects duplicate kind/instance pairs. */
+static void append_source(CrucibleClockSource source)
+{
+    g_assert_null(crucible_clock_source_by_kind(
+        source.capability.source_kind, source.instance));
+    g_array_append_val(crucible_clock_sources, source);
+}
+
+static CrucibleClockSource *query(uint16_t kind, uint32_t instance,
+                                  uint64_t expected)
+{
+    CrucibleClockSource *source = crucible_clock_source_by_kind(kind, instance);
+
+    g_assert_nonnull(source);
+    g_assert_cmpuint(source->capability.source_kind, ==, kind);
+    g_assert_cmpuint(source->instance, ==, instance);
+    g_assert_cmpuint(source->provider_value, ==, expected);
+    return source;
+}
+
+static void check_unsealed_and_key(void)
+{
+    g_assert_null(crucible_clock_source_by_kind(1, 0));
+    crucible_clock_sources = g_array_new(false, true, sizeof(CrucibleClockSource));
+    g_assert_null(crucible_clock_source_by_kind(1, 0));
+    for (unsigned i = 0; i < 4; i++) {
+        append_source(make_source(9, i, "device", 10 + i));
+    }
+    append_source(make_source(1, 0, "z-tsc-0", 50));
+    row_reads = 0;
+    query(1, 0, 50);
+    g_assert_cmpuint(row_reads, ==, 5);
+    row_reads = 0;
+    query(1, 0, 50);
+    g_assert_cmpuint(row_reads, ==, HINT_ENABLED ? 1 : 5);
+    fprintf(stderr, "unsealed-second-lookup: row-reads=%u\n", row_reads);
+    g_assert_false(crucible_clock_manifest_finalized);
+    g_assert_false(crucible_clock_bindings_sealed);
+    g_assert_false(qemu_crucible_fault_clock_source_active(1, 0));
+
+    /* Missing keys must still scan; an absent lookup cannot poison a later hit. */
+    g_assert_null(crucible_clock_source_by_kind(1, 77));
+    append_source(make_source(1, 1, "a-tsc-1", 60));
+    query(1, 1, 60);
+    query(1, 0, 50);
+    query(9, 0, 10);
+    g_assert_null(crucible_clock_source_by_kind(1, 77));
+    append_source(make_source(1, 77, "b-tsc-77", 77));
+    query(1, 77, 77);
+    puts("unsealed applicability, exact keys and absent lookup: passed");
+}
+
+static void check_storage_and_sort(void)
+{
+    query(1, 0, 50);
+    GArray *old = crucible_clock_sources;
+    GArray *relocated = g_array_sized_new(false, true,
+        sizeof(CrucibleClockSource), old->len + 100);
+    g_array_append_vals(relocated, old->data, old->len);
+    crucible_clock_sources = relocated;
+    /* Keep old storage alive so pointer-reuse controls fail deterministically. */
+    ((CrucibleClockSource *)old->data)[4].provider_value = 999;
+    query(1, 0, 50);
+    g_array_unref(old);
+
+    /* A cached slot can now name a different kind after the real manifest sort. */
+    ((CrucibleClockSource *)relocated->data)[0].capability.id = "y-device-0";
+    ((CrucibleClockSource *)relocated->data)[1].capability.id = "x-device-1";
+    ((CrucibleClockSource *)relocated->data)[2].capability.id = "w-device-2";
+    ((CrucibleClockSource *)relocated->data)[3].capability.id = "v-device-3";
+    g_assert_true(crucible_clock_manifest_finalize());
+    query(1, 1, 60);
+    query(1, 0, 50);
+    query(1, 77, 77);
+    g_assert_true(crucible_clock_manifest_finalized);
+    g_assert_false(crucible_clock_bindings_sealed);
+    puts("live backing storage and production manifest sorting: passed");
+}
+
+static void check_live_predicates(void)
+{
+    CrucibleClockSource *source = query(1, 0, 50);
+
+    crucible_clock_bindings_sealed = true;
+    g_assert_false(qemu_crucible_fault_clock_source_active(1, 0));
+    source->additive_picos = 1;
+    g_assert_true(qemu_crucible_fault_clock_source_active(1, 0));
+    source->provider_value = 81;
+    uint64_t value;
+    bool read_error;
+    g_assert_true(qemu_crucible_fault_clock_project_ps(1, 0, 7,
+                                                     &value, &read_error));
+    g_assert_cmpuint(value, ==, 81);
+    g_assert_false(read_error);
+    g_assert_cmpuint(projections, ==, 1);
+
+    for (unsigned depth = 1; depth <= 2; depth++) {
+        crucible_clock_vmstate_load_depth = depth;
+        unsigned before = mode_reads;
+        g_assert_false(qemu_crucible_fault_clock_source_active(1, 0));
+        g_assert_cmpuint(mode_reads, ==, before);
+    }
+    crucible_clock_vmstate_load_depth = 0;
+    source->provider_value = 91;
+    source->source_state = 4;
+    g_assert_true(qemu_crucible_fault_clock_project_ps(1, 0, 7,
+                                                     &value, &read_error));
+    g_assert_cmpuint(value, ==, 91);
+    g_assert_true(read_error);
+
+    source->source_state = CRUCIBLE_CLOCK_HEALTHY;
+    source->additive_picos = 0;
+    g_assert_false(qemu_crucible_fault_clock_source_active(1, 0));
+    crucible_clock_terminal = true;
+    g_assert_true(qemu_crucible_fault_clock_source_active(1, 0));
+    g_assert_false(qemu_crucible_fault_clock_project_ps(1, 0, 7,
+                                                      &value, &read_error));
+    g_assert_cmpuint(failures, ==, 1);
+    crucible_clock_terminal = false;
+    puts("live activation, restore-depth guards, values and terminal failure: passed");
+}
+
+static void *cold_thread(void *opaque)
+{
+    (void)opaque;
+    row_reads = 0;
+    query(1, 0, 91);
+    g_assert_cmpuint(row_reads, ==, 7);
+    row_reads = 0;
+    query(1, 0, 91);
+    g_assert_cmpuint(row_reads, ==, HINT_ENABLED ? 1 : 7);
+    return NULL;
+}
+
+static void check_fork_and_thread(void)
+{
+    query(1, 0, 91);
+    pid_t child = fork();
+    g_assert_cmpint(child, >=, 0);
+    if (child == 0) {
+        row_reads = 0;
+        query(1, 0, 91);
+        g_assert_cmpuint(row_reads, ==, HINT_ENABLED ? 1 : 7);
+        CrucibleClockSource *source = query(1, 0, 91);
+        source->provider_value = 101;
+        query(1, 0, 101);
+        pthread_t worker;
+        /* New threads start with a cold TLS hint even in a forked process. */
+        source->provider_value = 91;
+        g_assert_cmpint(pthread_create(&worker, NULL, cold_thread, NULL), ==, 0);
+        g_assert_cmpint(pthread_join(worker, NULL), ==, 0);
+        _exit(0);
+    }
+    int status;
+    g_assert_cmpint(waitpid(child, &status, 0), ==, child);
+    g_assert_true(WIFEXITED(status));
+    g_assert_cmpint(WEXITSTATUS(status), ==, 0);
+    query(1, 0, 91);
+    puts("native fork private rows, inherited hint and cold replacement thread: passed");
+}
+
+static void check_empty_shrink(void)
+{
+    query(1, 0, 91);
+    /* Shrink is an adversarial provider, not a production registry operation. */
+    g_array_set_size(crucible_clock_sources, 0);
+    g_assert_null(crucible_clock_source_by_kind(1, 0));
+    CrucibleClockSource source = make_source(1, 0, "replacement", 123);
+    g_array_append_val(crucible_clock_sources, source);
+    query(1, 0, 123);
+    puts("empty and adversarial shrink bounds: passed");
+}
+
+int main(void)
+{
+    check_unsealed_and_key();
+    check_storage_and_sort();
+    check_live_predicates();
+    check_fork_and_thread();
+    check_empty_shrink();
+    g_array_unref(crucible_clock_sources);
+    return 0;
+}
+"""
+
+
+def fixture(root: Path, negative: str | None) -> str:
+    """Compose native definitions with bounded quiescent registry providers."""
+    clock = (root / "plugins/crucible-fault-clock.c").read_text()
+    signatures = [
+        "static CrucibleClockSource *crucible_clock_source_by_kind(",
+        "static gint crucible_clock_source_compare(",
+        "static bool crucible_clock_manifest_finalize(",
+        "static bool crucible_clock_mode(",
+        "static bool crucible_clock_source_has_effective_transform(",
+        "bool qemu_crucible_fault_clock_source_active(",
+        "bool qemu_crucible_fault_clock_project_ps(",
+    ]
+    bodies = "\n\n".join(definition(clock, item) for item in signatures)
+    optimized = "static __thread guint tsc_index" in bodies
+    replacements = {
+        "preseal-gate": ("if (kind == QEMU_CRUCIBLE_CLOCK_X86_TSC &&\n",
+                         "if (crucible_clock_bindings_sealed &&\n"
+                         "        kind == QEMU_CRUCIBLE_CLOCK_X86_TSC &&\n"),
+        "omit-bounds": ("tsc_index < crucible_clock_sources->len",
+                        "tsc_index != G_MAXUINT"),
+        "omit-instance": ("            source->instance == instance)",
+                          "            true)"),
+        "omit-kind": ("source->capability.source_kind == kind &&\n"
+                      "            source->instance == instance",
+                      "source->instance == instance"),
+        "stale-slot": ("if (source->capability.source_kind == kind &&\n"
+                       "            source->instance == instance)", "if (true)"),
+        "shared-hint": ("static __thread guint tsc_index", "static guint tsc_index"),
+        "activation-before-load": ("crucible_clock_vmstate_load_depth == 0 &&",
+                                   "true &&"),
+    }
+    if negative == "stale-pointer":
+        bodies = bodies.replace("static __thread guint tsc_index = G_MAXUINT;",
+            "static __thread guint tsc_index = G_MAXUINT;\n"
+            "    static __thread CrucibleClockSource *old_source;")
+        bodies = bodies.replace("CrucibleClockSource, tsc_index);",
+                                "CrucibleClockSource, tsc_index);\n"
+                                "        source = old_source;")
+        bodies = bodies.replace("tsc_index = i;", "tsc_index = i;\n"
+                                "                old_source = source;")
+    elif negative == "negative-cache":
+        bodies = bodies.replace("static __thread guint tsc_index = G_MAXUINT;",
+            "static __thread guint tsc_index = G_MAXUINT;\n"
+            "    static __thread bool absent;\n"
+            "    static __thread uint32_t absent_instance;\n"
+            "    if (absent && kind == 1 && instance == absent_instance) {\n"
+            "        return NULL;\n    }")
+        lookup_end = "    return NULL;\n}"
+        bodies = bodies.replace(lookup_end,
+            "    if (crucible_clock_sources && kind == 1) {\n"
+            "        absent = true;\n        absent_instance = instance;\n    }\n"
+            + lookup_end, 1)
+    elif negative:
+        old, new = replacements[negative]
+        if old not in bodies:
+            raise ValueError(f"Negative control anchor missing: {negative}")
+        bodies = bodies.replace(old, new, 1)
+    header = (root / "include/qemu/crucible-fault.h").read_text()
+    kinds = definition(header, "enum QemuCrucibleClockSourceKind {") + ";"
+    return (PRELUDE.replace("/* CLOCK_SOURCE_KIND_DEFINITION */", kinds)
+            + f"\n#define HINT_ENABLED {int(optimized)}\n" + bodies + CHECKS)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source-root", type=Path, default=ROOT)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--negative", choices=[
+        "preseal-gate", "omit-bounds", "omit-instance", "omit-kind",
+        "stale-slot", "shared-hint", "activation-before-load",
+        "stale-pointer", "negative-cache",
+    ])
+    arguments = parser.parse_args()
+    arguments.output_dir.mkdir(parents=True, exist_ok=True)
+    source = arguments.output_dir / "tsc-source-index.c"
+    binary = arguments.output_dir / "tsc-source-index"
+    source.write_text(fixture(arguments.source_root, arguments.negative))
+    command = shlex.split(os.environ.get("CC", "cc"))
+    command += shlex.split(os.environ.get("CFLAGS", ""))
+    command += ["-std=gnu11", "-Wall", "-Wextra", "-Werror", "-pthread",
+                str(source), "-o", str(binary)]
+    command += shlex.split(os.environ.get("LDFLAGS", ""))
+    (arguments.output_dir / "compile-command.json").write_text(
+        json.dumps({"argv": command}, indent=2) + "\n")
+    subprocess.run(command, check=True)
+    subprocess.run([str(binary)], check=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/unit/test-crucible-vcpu-service-time.c b/tests/unit/test-crucible-vcpu-service-time.c
new file mode 100644
index 0000000000000000000000000000000000000000..fcaf79206b24b8b0c789097dfea173d06b437586
--- /dev/null
+++ b/tests/unit/test-crucible-vcpu-service-time.c
@@ -0,0 +1,350 @@
+/*
+ * Crucible vCPU service instruction-to-tick accounting tests.
+ *
+ * Copyright (c) 2026 ANDYL Technologies
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+
+/* The fixture invokes service accounting directly, without registration. */
+#undef type_init
+#define type_init(fn) static void (* const fixture_##fn)(void) \
+    __attribute__((unused)) = fn;
+#include "../../accel/tcg/icount-common.c"
+#include "../../plugins/crucible-fault-vcpu-service.c"
+
+TimersState timers_state;
+__thread CPUState *current_cpu;
+CPUTailQ cpus_queue = QTAILQ_HEAD_INITIALIZER(cpus_queue);
+
+static const char *test_accel = "sim";
+static bool test_ceiling_enabled;
+static uint64_t test_ceiling;
+static unsigned test_timers;
+static unsigned test_notify;
+static unsigned test_events;
+static uint8_t test_evidence[192];
+static uint64_t test_event_raw;
+static uint64_t test_event_tick;
+
+/* Only the external accelerator, scheduler and event sinks are controlled. */
+bool cpu_can_run(CPUState *cpu)
+{
+    return true;
+}
+
+bool cpu_has_work(CPUState *cpu)
+{
+    return true;
+}
+
+void qemu_plugin_fire_rr_handoff_cb(unsigned int from, unsigned int to,
+                                   uint64_t quantum, uint64_t retired)
+{
+    g_assert_not_reached();
+}
+
+void error_report(const char *format, ...)
+{
+    g_assert_not_reached();
+}
+
+const char *current_accel_name(void)
+{
+    return test_accel;
+}
+
+bool current_accel_is_sim(void)
+{
+    return strcmp(test_accel, "sim") == 0;
+}
+
+bool crucible_sim_shmem_dispatch_registered(void)
+{
+    return test_ceiling_enabled;
+}
+
+uint64_t crucible_sim_shmem_logical_ceiling(void)
+{
+    return test_ceiling;
+}
+
+bool qemu_clock_run_timers(QEMUClockType clock)
+{
+    g_assert_cmpint(clock, ==, QEMU_CLOCK_VIRTUAL);
+    test_timers++;
+    return false;
+}
+
+void qemu_clock_notify(QEMUClockType clock)
+{
+    g_assert_cmpint(clock, ==, QEMU_CLOCK_VIRTUAL);
+    test_notify++;
+}
+
+uint64_t qemu_plugin_icount_raw(void)
+{
+    return icount_get_raw_observed();
+}
+
+int qemu_plugin_rr_cursor(struct qemu_plugin_rr_cursor *out)
+{
+    memset(out, 0, sizeof(*out));
+    return 0;
+}
+
+uint64_t qemu_crucible_internal_rr_cursor_position(void)
+{
+    return 0;
+}
+
+uint64_t qemu_crucible_fault_rule_generation(const QemuCrucibleFaultRule *rule)
+{
+    return 1;
+}
+
+QemuCrucibleFaultEventReservation *qemu_crucible_fault_event_reserve(size_t n)
+{
+    return (void *)1;
+}
+
+void qemu_crucible_fault_event_reservation_consume(
+    QemuCrucibleFaultEventReservation *reservation)
+{
+    g_assert_nonnull(reservation);
+}
+
+void qemu_crucible_fault_event_reservation_release(
+    QemuCrucibleFaultEventReservation *reservation)
+{
+    g_assert_nonnull(reservation);
+}
+
+void qemu_crucible_fault_rule_event(const QemuCrucibleFaultRule *rule,
+    uint16_t outcome, uint64_t raw, const uint8_t opportunity[32],
+    const uint8_t before[32], const uint8_t after[32],
+    const uint8_t *evidence, size_t len)
+{
+    g_assert_cmpuint(len, ==, sizeof(test_evidence));
+    test_events++;
+    memcpy(test_evidence, evidence, len);
+    test_event_raw = raw;
+    test_event_tick = icount_crucible_sim_tick_observed();
+}
+
+void qemu_system_vmstop_request_prepare(void)
+{
+    g_assert_not_reached();
+}
+
+void qemu_system_vmstop_request(RunState state)
+{
+    g_assert_not_reached();
+}
+
+static void reset_clock(void)
+{
+    memset(&timers_state, 0, sizeof(timers_state));
+    seqlock_init(&timers_state.vm_clock_seqlock);
+    qemu_spin_init(&timers_state.vm_clock_lock);
+    current_cpu = NULL;
+    use_icount = ICOUNT_PRECISE;
+    test_accel = "sim";
+    crucible_rr_switch_quantum = 96;
+    test_ceiling_enabled = false;
+    test_timers = test_notify = 0;
+    test_events = 0;
+}
+
+static void test_ratio(uint64_t numerator, uint64_t denominator,
+                       uint64_t expected_credit, uint64_t expected_denied)
+{
+    CPUState cpu = { .cpu_index = 0 };
+    CrucibleVcpuService service = {
+        .numerator = numerator, .denominator = denominator, .quantum = 96,
+        .discipline = CRUCIBLE_VCPU_STRICT_CAP,
+        .state = CRUCIBLE_VCPU_ONLINE,
+    };
+
+    reset_clock();
+    timers_state.crucible_sim_tick_bias = 357;
+    service.service_rules = g_ptr_array_new();
+    g_ptr_array_add(service.service_rules, (void *)1);
+    crucible_vcpu_services = g_array_new(false, true, sizeof(service));
+    g_array_append_val(crucible_vcpu_services, service);
+    service = g_array_index(crucible_vcpu_services, CrucibleVcpuService, 0);
+
+    g_assert_cmpint(qemu_crucible_fault_vcpu_service_clamp_budget(&cpu, 96),
+                    ==, expected_credit);
+    timers_state.qemu_icount = expected_credit;
+    qemu_crucible_fault_vcpu_service_account(&cpu, 0, expected_credit, true);
+
+    g_assert_cmpint(icount_crucible_sim_tick_observed(), ==, 5157);
+    g_assert_cmpmem(test_evidence, 8, "CRUCVCS2", 8);
+    g_assert_cmpuint(ldq_le_p(test_evidence + 64), ==, expected_credit);
+    g_assert_cmpuint(ldq_le_p(test_evidence + 80), ==, expected_denied);
+    g_assert_cmpuint(ldq_le_p(test_evidence + 88), ==,
+                     357 + expected_credit * 50);
+    g_assert_cmpuint(ldq_le_p(test_evidence + 96), ==, 5157);
+    g_assert_cmpuint(ldq_le_p(test_evidence + 112), ==, test_event_raw);
+    g_assert_cmpuint(ldq_le_p(test_evidence + 96), ==, test_event_tick);
+    g_assert_cmpuint(test_timers, ==, expected_denied != 0);
+    g_assert_cmpuint(test_notify, ==, expected_denied != 0);
+    g_assert_cmpuint(test_events, ==, 1);
+    g_ptr_array_unref(service.service_rules);
+    g_array_unref(crucible_vcpu_services);
+    crucible_vcpu_services = NULL;
+}
+
+static void test_service_ratios(void)
+{
+    test_ratio(1, 1, 96, 0);
+    test_ratio(1, 2, 48, 48);
+    test_ratio(1, 3, 32, 64);
+}
+
+static void test_service_interruption(void)
+{
+    CPUState cpu = { .cpu_index = 0 };
+    CrucibleVcpuService service = {
+        .numerator = 1, .denominator = 2, .quantum = 96,
+        .discipline = CRUCIBLE_VCPU_STRICT_CAP,
+        .state = CRUCIBLE_VCPU_ONLINE,
+    };
+
+    reset_clock();
+    timers_state.qemu_icount = 3;
+    timers_state.crucible_sim_tick_bias = 357;
+    service.service_rules = g_ptr_array_new();
+    g_ptr_array_add(service.service_rules, (void *)1);
+
+    g_assert_true(crucible_vcpu_refill(&cpu, &service));
+    crucible_vcpu_interrupt_window(&cpu, &service);
+
+    g_assert_cmpmem(test_evidence, 8, "CRUCVCS2", 8);
+    g_assert_cmpuint(ldq_le_p(test_evidence + 80), ==, 48);
+    g_assert_cmpuint(ldq_le_p(test_evidence + 88), ==, 507);
+    g_assert_cmpuint(ldq_le_p(test_evidence + 96), ==, 507);
+    g_assert_cmpuint(ldq_le_p(test_evidence + 112), ==, 3);
+    g_assert_cmpuint(ldl_le_p(test_evidence + 184), ==, 2);
+    g_assert_cmpuint(test_event_tick, ==, 507);
+    g_assert_cmpuint(test_timers, ==, 0);
+    g_assert_cmpuint(test_notify, ==, 0);
+    g_assert_cmpuint(test_events, ==, 1);
+    g_ptr_array_unref(service.service_rules);
+}
+
+static void test_ordinary_mode(void)
+{
+    CPUState cpu = { .cpu_index = 0 };
+
+    reset_clock();
+    test_accel = "tcg";
+    timers_state.icount_time_shift = 3;
+    timers_state.qemu_icount = 3;
+    timers_state.crucible_sim_tick_bias = 357;
+
+    g_assert_false(crucible_vcpu_service_mode());
+    g_assert_cmpint(qemu_crucible_fault_vcpu_service_clamp_budget(&cpu, 96),
+                    ==, 96);
+    g_assert_false(icount_crucible_advance_virtual_time_by_ticks(2400));
+    g_assert_cmpint(icount_get_observed(), ==, 24);
+    g_assert_cmpint(timers_state.crucible_sim_tick_bias, ==, 357);
+    g_assert_cmpint(timers_state.qemu_icount, ==, 3);
+    g_assert_cmpuint(test_timers, ==, 0);
+
+    test_accel = "sim";
+    use_icount = ICOUNT_ADAPTATIVE;
+    g_assert_false(crucible_vcpu_service_mode());
+    g_assert_false(icount_crucible_advance_virtual_time_by_ticks(2400));
+    use_icount = ICOUNT_DISABLED;
+    g_assert_false(crucible_vcpu_service_mode());
+    g_assert_false(icount_crucible_advance_virtual_time_by_ticks(2400));
+}
+
+static void test_tick_range(void)
+{
+    CPUState cpu = { .cpu_index = 0 };
+    CrucibleVcpuService service = {
+        .denied_pending = INT64_MAX / CRUCIBLE_SIM_TICKS_PER_INSTRUCTION,
+    };
+
+    reset_clock();
+    service.service_rules = g_ptr_array_new();
+
+    crucible_vcpu_close_window(&cpu, &service, 0);
+
+    g_assert_cmpint(icount_crucible_sim_tick_observed(), ==,
+                    INT64_MAX - INT64_MAX %
+                    CRUCIBLE_SIM_TICKS_PER_INSTRUCTION);
+    g_assert_cmpuint(test_timers, ==, 1);
+    g_assert_false(icount_crucible_advance_virtual_time_by_ticks(8));
+    g_assert_cmpint(icount_crucible_sim_tick_observed(), ==,
+                    INT64_MAX - INT64_MAX %
+                    CRUCIBLE_SIM_TICKS_PER_INSTRUCTION);
+    g_assert_cmpuint(test_timers, ==, 1);
+    g_ptr_array_unref(service.service_rules);
+
+    reset_clock();
+    timers_state.crucible_sim_tick_bias = 357;
+    test_ceiling_enabled = true;
+    test_ceiling = 2756;
+
+    g_assert_false(icount_crucible_advance_virtual_time_by_ticks(2400));
+    g_assert_cmpint(timers_state.crucible_sim_tick_bias, ==, 357);
+    g_assert_cmpint(timers_state.qemu_icount, ==, 0);
+    g_assert_cmpuint(test_timers, ==, 0);
+    g_assert_cmpuint(test_notify, ==, 0);
+
+    test_ceiling = 2757;
+    g_assert_true(icount_crucible_advance_virtual_time_by_ticks(2400));
+    g_assert_cmpint(icount_crucible_sim_tick_observed(), ==, 2757);
+}
+
+static void conversion_refused(int signal_number)
+{
+    /* The production guard must abort before committing an executing prefix. */
+    _exit(signal_number == SIGABRT && timers_state.qemu_icount == 0 &&
+          timers_state.crucible_sim_tick_bias == 357 &&
+          test_timers == 0 && test_notify == 0 && test_events == 0 ?
+          EXIT_SUCCESS : EXIT_FAILURE);
+}
+
+static void test_instruction_overflow(void)
+{
+    CPUState cpu = {
+        .cpu_index = 0, .running = true, .icount_budget = 1,
+    };
+    CrucibleVcpuService service = {
+        .denied_pending = INT64_MAX / CRUCIBLE_SIM_TICKS_PER_INSTRUCTION + 1,
+    };
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    reset_clock();
+    timers_state.crucible_sim_tick_bias = 357;
+    cpu.neg.can_do_io = true;
+    current_cpu = &cpu;
+    signal(SIGABRT, conversion_refused);
+
+    crucible_vcpu_close_window(&cpu, &service, 0);
+    g_assert_not_reached();
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/vcpu-service/ratios", test_service_ratios);
+    g_test_add_func("/vcpu-service/interruption", test_service_interruption);
+    g_test_add_func("/vcpu-service/ordinary-mode", test_ordinary_mode);
+    g_test_add_func("/vcpu-service/tick-range", test_tick_range);
+    g_test_add_func("/vcpu-service/instruction-overflow",
+                    test_instruction_overflow);
+    return g_test_run();
+}
diff --git a/tests/unit/test-crucible-vfio-timer.c b/tests/unit/test-crucible-vfio-timer.c
new file mode 100644
index 0000000000000000000000000000000000000000..5a7447bcaf67f68882479417aeeb384a56639472
--- /dev/null
+++ b/tests/unit/test-crucible-vfio-timer.c
@@ -0,0 +1,238 @@
+/*
+ * VFIO INTx relative timer tests.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/main-loop.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "system/cpu-timers.h"
+
+/* Retain literal affected bodies without registering a passthrough backend. */
+#undef type_init
+#define type_init(function) \
+    static void (*const vfio_fixture_registration)(void) \
+        G_GNUC_UNUSED = function;
+#include "../../hw/vfio/pci.c"
+
+static __int128 observed_ps;
+static VFIOPCIDevice *hardware_device;
+static unsigned int irq_calls;
+static unsigned int mmap_calls;
+static bool mmap_enabled;
+
+/* Controlled samples supply clock inputs; they confer no vCPU permission. */
+int64_t cpu_get_clock(void)
+{
+    return observed_ps / PICOSECONDS_PER_NANOSECOND;
+}
+
+static __int128 observed_clock_ps(void)
+{
+    return observed_ps;
+}
+
+/* Hardware doubles check identity, ordering and requested disposition. */
+void pci_set_irq(PCIDevice *device, int level)
+{
+    g_assert_true(device == &hardware_device->parent_obj);
+    g_assert_cmpint(level, ==, 1);
+    irq_calls++;
+}
+
+void vfio_region_mmaps_set_enabled(VFIORegion *region, bool enabled)
+{
+    unsigned int index = mmap_calls % PCI_ROM_SLOT;
+
+    g_assert_true(region == &hardware_device->bars[index].region);
+    mmap_calls++;
+    mmap_enabled = enabled;
+}
+
+static VFIOPCIDevice *fixture_create(bool tcg_ps, uint32_t timeout_ms)
+{
+    const TypeInfo pci_fixture = {
+        .name = TYPE_PCI_DEVICE,
+        .parent = TYPE_OBJECT,
+        .instance_size = sizeof(PCIDevice),
+    };
+    const TypeInfo vfio_fixture = {
+        .name = "vfio-timer-fixture",
+        .parent = TYPE_PCI_DEVICE,
+        .instance_size = sizeof(VFIOPCIDevice),
+    };
+    VFIOPCIDevice *device;
+
+    module_call_init(MODULE_INIT_QOM);
+    type_register_static(&pci_fixture);
+    type_register_static(&vfio_fixture);
+    qemu_init_main_loop(&error_fatal);
+    if (tcg_ps) {
+        qemu_timer_enable_tcg_ps_clock(NULL, observed_clock_ps);
+    }
+    qemu_clock_enable(QEMU_CLOCK_VIRTUAL, true);
+
+    device = (VFIOPCIDevice *)object_new("vfio-timer-fixture");
+    device->intx.mmap_timeout = timeout_ms;
+    device->intx.mmap_timer = timer_new_ms(QEMU_CLOCK_VIRTUAL,
+                                         vfio_intx_mmap_enable, device);
+    hardware_device = device;
+    g_assert_cmpint(event_notifier_init(&device->intx.interrupt, 0), ==, 0);
+    return device;
+}
+
+static void fixture_destroy(VFIOPCIDevice *device)
+{
+    timer_free(device->intx.mmap_timer);
+    event_notifier_cleanup(&device->intx.interrupt);
+    object_unref(OBJECT(device));
+    hardware_device = NULL;
+}
+
+static void test_pending_rearm(void)
+{
+    VFIOPCIDevice *device;
+    __int128 deadline_ps;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    observed_ps = 123456789;
+    device = fixture_create(true, 1);
+    device->intx.pending = true;
+    deadline_ps = observed_ps + SCALE_MS * PICOSECONDS_PER_NANOSECOND;
+    vfio_intx_mmap_enable(device);
+
+    g_assert_true(timer_expire_time_ps_wide(device->intx.mmap_timer) ==
+                  deadline_ps);
+    g_assert_cmpuint(irq_calls, ==, 0);
+    g_assert_cmpuint(mmap_calls, ==, 0);
+    observed_ps = deadline_ps - 1;
+    g_assert_false(qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL));
+
+    observed_ps = deadline_ps;
+    g_assert_true(qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL));
+    g_assert_cmpuint(mmap_calls, ==, 0);
+    deadline_ps += SCALE_MS * PICOSECONDS_PER_NANOSECOND;
+    g_assert_true(timer_expire_time_ps_wide(device->intx.mmap_timer) ==
+                  deadline_ps);
+
+    device->intx.pending = false;
+    observed_ps = deadline_ps;
+    g_assert_true(qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL));
+    g_assert_cmpuint(mmap_calls, ==, PCI_ROM_SLOT);
+    g_assert_true(mmap_enabled);
+    g_assert_false(timer_pending(device->intx.mmap_timer));
+    fixture_destroy(device);
+}
+
+static void test_interrupt_origin(gconstpointer opaque)
+{
+    uint32_t timeout_ms = GPOINTER_TO_UINT(opaque);
+    VFIOPCIDevice *device;
+    __int128 deadline_ps;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    observed_ps = 123456789;
+    device = fixture_create(true, timeout_ms);
+    vfio_intx_interrupt(device);
+    g_assert_false(device->intx.pending);
+    g_assert_cmpuint(irq_calls, ==, 0);
+    g_assert_cmpuint(mmap_calls, ==, 0);
+    g_assert_false(timer_pending(device->intx.mmap_timer));
+
+    event_notifier_set(&device->intx.interrupt);
+    vfio_intx_interrupt(device);
+    g_assert_true(device->intx.pending);
+    g_assert_cmpuint(irq_calls, ==, 1);
+    g_assert_cmpuint(mmap_calls, ==, PCI_ROM_SLOT);
+    g_assert_false(mmap_enabled);
+
+    if (timeout_ms) {
+        deadline_ps = observed_ps + (__int128)timeout_ms * SCALE_MS *
+                      PICOSECONDS_PER_NANOSECOND;
+        g_assert_true(timer_expire_time_ps_wide(device->intx.mmap_timer) ==
+                      deadline_ps);
+    } else {
+        g_assert_false(timer_pending(device->intx.mmap_timer));
+    }
+
+    /* A drained notifier must not repeat IRQ/mmap effects or rebase a timer. */
+    observed_ps++;
+    vfio_intx_interrupt(device);
+    g_assert_cmpuint(irq_calls, ==, 1);
+    g_assert_cmpuint(mmap_calls, ==, PCI_ROM_SLOT);
+    if (timeout_ms) {
+        g_assert_true(timer_expire_time_ps_wide(device->intx.mmap_timer) ==
+                      deadline_ps);
+    }
+    fixture_destroy(device);
+}
+
+static void test_nanosecond_origin(void)
+{
+    VFIOPCIDevice *device;
+    uint64_t deadline_ns;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    observed_ps = 123456789;
+    device = fixture_create(false, 1);
+    device->intx.pending = true;
+    deadline_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + SCALE_MS;
+    vfio_intx_mmap_enable(device);
+
+    g_assert_cmpuint(timer_expire_time_ns(device->intx.mmap_timer), ==,
+                     deadline_ns);
+    g_assert_cmpuint(irq_calls, ==, 0);
+    g_assert_cmpuint(mmap_calls, ==, 0);
+    fixture_destroy(device);
+}
+
+static void test_deadline_overflow(void)
+{
+    VFIOPCIDevice *device;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_failed();
+        g_test_trap_assert_stderr(
+            "*VFIO INTx mmap timeout exceeds virtual clock range*");
+        return;
+    }
+
+    observed_ps = (((__int128)INT64_MAX << 64) | UINT64_MAX) - 500;
+    device = fixture_create(true, 1);
+    device->intx.pending = true;
+    vfio_intx_mmap_enable(device);
+    g_assert_not_reached();
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/vfio/timer/pending-rearm", test_pending_rearm);
+    g_test_add_data_func("/vfio/timer/interrupt", GUINT_TO_POINTER(1),
+                         test_interrupt_origin);
+    g_test_add_data_func("/vfio/timer/interrupt-disabled", GUINT_TO_POINTER(0),
+                         test_interrupt_origin);
+    g_test_add_data_func("/vfio/timer/interrupt-maximum",
+                         GUINT_TO_POINTER(UINT32_MAX), test_interrupt_origin);
+    g_test_add_func("/vfio/timer/nanosecond-origin", test_nanosecond_origin);
+    g_test_add_func("/vfio/timer/deadline-overflow", test_deadline_overflow);
+    return g_test_run();
+}
diff --git a/tests/unit/test-crucible-vga-blink.c b/tests/unit/test-crucible-vga-blink.c
new file mode 100644
index 0000000000000000000000000000000000000000..8b1d257a2d76721a3015fc66f09d4a051a2fb54e
--- /dev/null
+++ b/tests/unit/test-crucible-vga-blink.c
@@ -0,0 +1,258 @@
+/*
+ * Actual VGA text rendering interval tests.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/main-loop.h"
+#include "qemu/module.h"
+#include "system/cpu-timers.h"
+#include "../../hw/display/vga.c"
+
+static __int128 observed_ps;
+static DisplaySurface framebuffer;
+static char console_cookie;
+static unsigned int updates;
+
+int64_t cpu_get_clock(void)
+{
+    return observed_ps / PICOSECONDS_PER_NANOSECOND;
+}
+
+static __int128 observed_clock_ps(void)
+{
+    return observed_ps;
+}
+
+/* Framebuffer/backend doubles keep actual rendering and cache logic intact. */
+DisplaySurface *qemu_console_surface(QemuConsole *console)
+{
+    g_assert_true(console == (QemuConsole *)&console_cookie);
+    return &framebuffer;
+}
+
+void qemu_console_resize(QemuConsole *console, int width, int height)
+{
+    qemu_console_surface(console);
+    if (framebuffer.image) {
+        pixman_image_unref(framebuffer.image);
+    }
+    framebuffer.image = pixman_image_create_bits(PIXMAN_x8r8g8b8,
+                                                 width, height, NULL, 0);
+    g_assert_nonnull(framebuffer.image);
+}
+
+void qemu_console_text_resize(QemuConsole *console, int width, int height)
+{
+    qemu_console_surface(console);
+    g_assert_cmpint(width, ==, 2);
+    g_assert_cmpint(height, ==, 1);
+}
+
+void qemu_console_update(QemuConsole *console, int x, int y, int w, int h)
+{
+    qemu_console_surface(console);
+    g_assert_cmpint(x, >=, 0);
+    g_assert_cmpint(y, >=, 0);
+    g_assert_cmpint(x + w, <=, surface_width(&framebuffer));
+    g_assert_cmpint(y + h, <=, surface_height(&framebuffer));
+    updates++;
+}
+
+void qemu_flush_coalesced_mmio_buffer(void)
+{
+    /* No hardware coalesced writes exist in this framebuffer fixture. */
+}
+
+/* Graphics/blank-mode and RAM dirty tracking are outside this text fixture. */
+DisplaySurface *qemu_create_displaysurface(int width, int height)
+{
+    g_assert_not_reached();
+}
+
+DisplaySurface *qemu_create_displaysurface_from(int width, int height,
+                                                pixman_format_code_t format,
+                                                int linesize, uint8_t *data)
+{
+    g_assert_not_reached();
+}
+
+void qemu_console_set_surface(QemuConsole *console, DisplaySurface *surface)
+{
+    g_assert_not_reached();
+}
+
+void qemu_console_update_full(QemuConsole *console)
+{
+    g_assert_not_reached();
+}
+
+bool qemu_console_check_format(QemuConsole *console,
+                               pixman_format_code_t format)
+{
+    g_assert_not_reached();
+}
+
+DirtyBitmapSnapshot *memory_region_snapshot_and_clear_dirty(MemoryRegion *mr,
+                                                            hwaddr addr,
+                                                            hwaddr size,
+                                                            unsigned client)
+{
+    g_assert_not_reached();
+}
+
+bool memory_region_snapshot_get_dirty(MemoryRegion *mr,
+                                      DirtyBitmapSnapshot *snapshot,
+                                      hwaddr addr, hwaddr size)
+{
+    g_assert_not_reached();
+}
+
+static void initialize_vga(VGACommonState *state, bool tcg_ps)
+{
+    module_call_init(MODULE_INIT_QOM);
+    qemu_init_main_loop(&error_fatal);
+    if (tcg_ps) {
+        qemu_timer_enable_tcg_ps_clock(NULL, observed_clock_ps);
+    }
+    qemu_clock_enable(QEMU_CLOCK_VIRTUAL, true);
+    memset(state, 0, sizeof(*state));
+    state->con = (QemuConsole *)&console_cookie;
+    state->vram_size = 128 * KiB;
+    state->vram_ptr = g_malloc0(state->vram_size);
+    state->cr[VGA_CRTC_H_DISP] = 1;
+    state->ar[VGA_ATC_MODE] = 8;
+    state->ar[1] = 1;
+    state->palette[3] = 63;
+    state->vram_ptr[1] = state->vram_ptr[5] = 0x81;
+    state->vram_ptr[2] = 0xff;
+    state->cr[VGA_CRTC_CURSOR_START] = 0x20;
+    state->ar_index = 0x20;
+    state->graphic_mode = -1;
+    state->get_params = vga_get_params;
+    state->get_resolution = vga_get_resolution;
+    qemu_console_resize(state->con, 16, 1);
+}
+
+static void destroy_vga(VGACommonState *state)
+{
+    g_free(state->vram_ptr);
+    pixman_image_unref(framebuffer.image);
+    framebuffer.image = NULL;
+}
+
+static void test_render_intervals(gconstpointer opaque)
+{
+    bool tcg_ps = GPOINTER_TO_INT(opaque);
+    VGACommonState state;
+    __int128 origin_ps;
+    __int128 cursor_deadline;
+    __int128 blink_deadline;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    observed_ps = 123456789;
+    initialize_vga(&state, tcg_ps);
+    origin_ps = tcg_ps ? observed_ps : 0;
+    cursor_deadline = origin_ps + (__int128)(VGA_TEXT_CURSOR_PERIOD_MS / 2) *
+                      SCALE_MS * PICOSECONDS_PER_NANOSECOND;
+    blink_deadline = origin_ps + (__int128)(VGA_TEXT_BLINK_PERIOD_MS / 2) *
+                     SCALE_MS * PICOSECONDS_PER_NANOSECOND;
+    g_assert_true(vga_update_display(&state));
+    g_assert_true(state.cursor_visible_phase);
+    g_assert_true(state.blink_visible_phase);
+    g_assert_true(state.cursor_blink_time_ps == cursor_deadline);
+    g_assert_true(state.blink_time_ps == blink_deadline);
+    g_assert_cmpuint(updates, >, 0);
+    g_assert_cmphex(pixman_image_get_data(framebuffer.image)[9], !=, 0);
+
+    observed_ps = cursor_deadline - 1;
+    g_assert_true(vga_update_display(&state));
+    g_assert_true(state.cursor_visible_phase);
+    observed_ps = cursor_deadline;
+    g_assert_true(vga_update_display(&state));
+    g_assert_false(state.cursor_visible_phase);
+    g_assert_true(state.blink_visible_phase);
+
+    observed_ps = blink_deadline - 1;
+    g_assert_true(vga_update_display(&state));
+    g_assert_true(state.blink_visible_phase);
+    observed_ps = blink_deadline;
+    g_assert_true(vga_update_display(&state));
+    g_assert_false(state.blink_visible_phase);
+    g_assert_cmphex(pixman_image_get_data(framebuffer.image)[9], ==, 0);
+    destroy_vga(&state);
+}
+
+static void test_mode_change_reset(void)
+{
+    VGACommonState state;
+    __int128 old_blink_deadline;
+    __int128 old_cursor_deadline;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    observed_ps = 123456789;
+    initialize_vga(&state, true);
+    g_assert_true(vga_update_display(&state));
+    old_blink_deadline = state.blink_time_ps;
+    old_cursor_deadline = state.cursor_blink_time_ps;
+
+    /* Mode transitions reset cursor timing and preserve blink timing. */
+    observed_ps += 17;
+    state.graphic_mode = GMODE_GRAPH;
+    g_assert_true(vga_update_display(&state));
+    g_assert_cmpint(state.graphic_mode, ==, GMODE_TEXT);
+    g_assert_false(state.cursor_visible_phase);
+    g_assert_true(state.cursor_blink_time_ps == old_cursor_deadline + 17);
+    g_assert_true(state.blink_time_ps == old_blink_deadline);
+    g_assert_true(state.blink_visible_phase);
+
+    observed_ps = state.cursor_blink_time_ps - 1;
+    g_assert_true(vga_update_display(&state));
+    g_assert_false(state.cursor_visible_phase);
+    observed_ps++;
+    g_assert_true(vga_update_display(&state));
+    g_assert_true(state.cursor_visible_phase);
+    destroy_vga(&state);
+}
+
+static void test_render_overflow(void)
+{
+    VGACommonState state;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_failed();
+        g_test_trap_assert_stderr(
+            "*VGA blink deadline exceeds virtual clock range*");
+        return;
+    }
+
+    observed_ps = 0;
+    initialize_vga(&state, true);
+    observed_ps = (((__int128)INT64_MAX << 64) | UINT64_MAX) - 500;
+    vga_update_display(&state);
+    g_assert_not_reached();
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_data_func("/vga/blink/fractional-render", GINT_TO_POINTER(true),
+                         test_render_intervals);
+    g_test_add_data_func("/vga/blink/non-tcg-render", GINT_TO_POINTER(false),
+                         test_render_intervals);
+    g_test_add_func("/vga/blink/mode-change-reset", test_mode_change_reset);
+    g_test_add_func("/vga/blink/render-overflow", test_render_overflow);
+    return g_test_run();
+}
diff --git a/tests/unit/test-crucible-vga-fingerprint.c b/tests/unit/test-crucible-vga-fingerprint.c
new file mode 100644
index 0000000000000000000000000000000000000000..8bca357b65257a6572ee6c8ace8267d431c85521
--- /dev/null
+++ b/tests/unit/test-crucible-vga-fingerprint.c
@@ -0,0 +1,174 @@
+/*
+ * Standard PCI VGA fingerprint projection tests
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "qemu/osdep.h"
+
+#include "hw/display/vga-fingerprint.h"
+#include "io/channel-file.h"
+#include "qemu/module.h"
+
+static GBytes *project_vga(VGACommonState *vga, uint32_t flags,
+                           const uint8_t *edid, bool edid_enabled,
+                           bool expected_success)
+{
+    char *path = NULL;
+    int read_fd;
+    int write_fd = g_file_open_tmp("qemu-vga-fingerprint-XXXXXX", &path,
+                                   NULL);
+    QIOChannelFile *channel;
+    QEMUFile *file;
+    Error *error = NULL;
+    struct stat stat_buffer;
+    bool success;
+
+    g_assert_cmpint(write_fd, >=, 0);
+    read_fd = dup(write_fd);
+    g_assert_cmpint(read_fd, >=, 0);
+    unlink(path);
+    g_free(path);
+    channel = qio_channel_file_new_fd(write_fd);
+    file = qemu_file_new_output(QIO_CHANNEL(channel));
+
+    success = pci_vga_state_fingerprint_validate(vga, &error);
+    g_assert_cmpint(success, ==, expected_success);
+    if (success) {
+        pci_vga_state_fingerprint_put(
+            file, vga, flags, edid, edid_enabled);
+    }
+    if (!success) {
+        g_assert_nonnull(error);
+        error_free(error);
+        qemu_fclose(file);
+        g_assert_cmpint(fstat(read_fd, &stat_buffer), ==, 0);
+        g_assert_cmpuint(stat_buffer.st_size, ==, 0);
+        object_unref(OBJECT(channel));
+        close(read_fd);
+        return NULL;
+    }
+    g_assert_null(error);
+    g_assert_cmpint(qemu_fflush(file), ==, 0);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+
+    g_assert_cmpint(fstat(read_fd, &stat_buffer), ==, 0);
+    g_autofree uint8_t *data = g_malloc(stat_buffer.st_size);
+    g_assert_cmpint(pread(read_fd, data, stat_buffer.st_size, 0), ==,
+                    stat_buffer.st_size);
+    GBytes *bytes = g_bytes_new(data, stat_buffer.st_size);
+    object_unref(OBJECT(channel));
+    close(read_fd);
+    return bytes;
+}
+
+static void initialize_vga(VGACommonState *vga)
+{
+    memset(vga, 0, sizeof(*vga));
+    vga->vram_size_mb = 16;
+    vga->vram_size = 16 * MiB;
+    vga->vbe_size = vga->vram_size;
+    vga->vbe_size_mask = vga->vbe_size - 1;
+    vga->is_vbe_vmstate = 1;
+}
+
+static void test_vga_mutable_state_and_configuration(void)
+{
+    VGACommonState first;
+    VGACommonState second;
+    uint8_t first_edid[PCI_VGA_FINGERPRINT_EDID_SIZE] = { 0 };
+    uint8_t second_edid[PCI_VGA_FINGERPRINT_EDID_SIZE] = { 0 };
+    g_autoptr(GBytes) first_bytes = NULL;
+    g_autoptr(GBytes) second_bytes = NULL;
+
+    initialize_vga(&first);
+    initialize_vga(&second);
+    first_bytes = project_vga(&first, 0, first_edid, false, true);
+    second.latch = 1;
+    second_bytes = project_vga(&second, 0, second_edid, false, true);
+    g_assert_false(g_bytes_equal(first_bytes, second_bytes));
+
+    second = first;
+    second.palette[17] = 1;
+    second_bytes = project_vga(&second, 0, second_edid, false, true);
+    g_assert_false(g_bytes_equal(first_bytes, second_bytes));
+
+    second = first;
+    second.vbe_regs[VBE_DISPI_INDEX_XRES] = 8;
+    second_bytes = project_vga(&second, 0, second_edid, false, true);
+    g_assert_false(g_bytes_equal(first_bytes, second_bytes));
+
+    second = first;
+    second.big_endian_fb = true;
+    second_bytes = project_vga(&second, 0, second_edid, false, true);
+    g_assert_false(g_bytes_equal(first_bytes, second_bytes));
+
+    second = first;
+    first_bytes = project_vga(&first, 0, first_edid, false, true);
+    second_bytes = project_vga(&second, 1, second_edid, false, true);
+    g_assert_false(g_bytes_equal(first_bytes, second_bytes));
+
+    second_edid[17] = 1;
+    first_bytes = project_vga(&first, 0, first_edid, false, true);
+    second_bytes = project_vga(&second, 0, first_edid, true, true);
+    g_assert_false(g_bytes_equal(first_bytes, second_bytes));
+
+    first_bytes = project_vga(&first, 0, first_edid, true, true);
+    second_bytes = project_vga(&second, 0, second_edid, true, true);
+    g_assert_false(g_bytes_equal(first_bytes, second_bytes));
+
+    first_bytes = project_vga(&first, 0, first_edid, false, true);
+    second_bytes = project_vga(&second, 0, second_edid, false, true);
+    g_assert_true(g_bytes_equal(first_bytes, second_bytes));
+}
+
+static void test_vga_rejects_unrestorable_state(void)
+{
+    VGACommonState vga;
+    uint8_t edid[PCI_VGA_FINGERPRINT_EDID_SIZE] = { 0 };
+
+    initialize_vga(&vga);
+    vga.dac_8bit = 1;
+    g_assert_null(project_vga(&vga, 0, edid, false, false));
+
+    initialize_vga(&vga);
+    vga.sr_vbe[VGA_SEQ_MEMORY_MODE] = VGA_SR04_CHN_4M;
+    g_assert_null(project_vga(&vga, 0, edid, false, false));
+
+    initialize_vga(&vga);
+    vga.vbe_size_mask = 0;
+    g_assert_null(project_vga(&vga, 0, edid, false, false));
+
+    initialize_vga(&vga);
+    vga.vbe_regs[VBE_DISPI_INDEX_ENABLE] = VBE_DISPI_ENABLED;
+    vga.vbe_regs[VBE_DISPI_INDEX_XRES] = 640;
+    vga.vbe_regs[VBE_DISPI_INDEX_YRES] = 480;
+    vga.vbe_regs[VBE_DISPI_INDEX_BPP] = 8;
+    vga.vbe_line_offset = 640;
+    vga.gr[VGA_GFX_MISC] = 0x05;
+    vga.gr[VGA_GFX_MODE] = 0x40;
+    vga.cr[VGA_CRTC_MODE] = 3;
+    vga.cr[VGA_CRTC_OFFSET] = 80;
+    vga.cr[VGA_CRTC_H_DISP] = 79;
+    vga.cr[VGA_CRTC_V_DISP_END] = 0xdf;
+    vga.cr[VGA_CRTC_OVERFLOW] = 0x12;
+    vga.cr[VGA_CRTC_LINE_COMPARE] = 0xff;
+    vga.cr[VGA_CRTC_MAX_SCAN] = 0x40;
+    vga.sr_vbe[VGA_SEQ_MEMORY_MODE] = VGA_SR04_CHN_4M;
+    vga.sr_vbe[VGA_SEQ_PLANE_WRITE] = VGA_SR02_ALL_PLANES;
+    g_assert_nonnull(project_vga(&vga, 0, edid, false, true));
+
+    vga.cr[VGA_CRTC_H_DISP]++;
+    g_assert_null(project_vga(&vga, 0, edid, false, false));
+}
+
+int main(int argc, char **argv)
+{
+    module_call_init(MODULE_INIT_QOM);
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/crucible/vga/mutable-state-configuration",
+                    test_vga_mutable_state_and_configuration);
+    g_test_add_func("/crucible/vga/unrestorable-state",
+                    test_vga_rejects_unrestorable_state);
+    return g_test_run();
+}
diff --git a/tests/unit/test-crucible-x86-fingerprint.c b/tests/unit/test-crucible-x86-fingerprint.c
new file mode 100644
index 0000000000000000000000000000000000000000..bbf3a52a228ea810d6e78c149eef2c8d02adf5ba
--- /dev/null
+++ b/tests/unit/test-crucible-x86-fingerprint.c
@@ -0,0 +1,205 @@
+/*
+ * x86 CPU fingerprint projection tests
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+
+#include "io/channel-file.h"
+#include "qemu/module.h"
+#include "target/i386/crucible-fingerprint.h"
+
+typedef void (*X86Projection)(QEMUFile *file, const X86CPU *cpu);
+
+static GBytes *project_x86_state(const X86CPU *cpu, X86Projection projection)
+{
+    char *path = NULL;
+    int read_fd;
+    int write_fd = g_file_open_tmp("qemu-x86-fingerprint-XXXXXX", &path,
+                                   NULL);
+    QIOChannelFile *channel;
+    QEMUFile *file;
+    struct stat stat_buffer;
+
+    g_assert_cmpint(write_fd, >=, 0);
+    read_fd = dup(write_fd);
+    g_assert_cmpint(read_fd, >=, 0);
+    unlink(path);
+    g_free(path);
+
+    channel = qio_channel_file_new_fd(write_fd);
+    file = qemu_file_new_output(QIO_CHANNEL(channel));
+    projection(file, cpu);
+    g_assert_cmpint(qemu_fflush(file), ==, 0);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+
+    g_assert_cmpint(fstat(read_fd, &stat_buffer), ==, 0);
+    g_autofree uint8_t *data = g_malloc(stat_buffer.st_size);
+    g_assert_cmpint(pread(read_fd, data, stat_buffer.st_size, 0), ==,
+                    stat_buffer.st_size);
+    GBytes *bytes = g_bytes_new(data, stat_buffer.st_size);
+    object_unref(OBJECT(channel));
+    close(read_fd);
+    return bytes;
+}
+
+static void assert_projection_changed(const X86CPU *first,
+                                      const X86CPU *second,
+                                      X86Projection projection)
+{
+    g_autoptr(GBytes) first_bytes = project_x86_state(first, projection);
+    g_autoptr(GBytes) second_bytes = project_x86_state(second, projection);
+
+    g_assert_false(g_bytes_equal(first_bytes, second_bytes));
+}
+
+static void assert_projection_equal(const X86CPU *first,
+                                    const X86CPU *second,
+                                    X86Projection projection)
+{
+    g_autoptr(GBytes) first_bytes = project_x86_state(first, projection);
+    g_autoptr(GBytes) second_bytes = project_x86_state(second, projection);
+
+    g_assert_true(g_bytes_equal(first_bytes, second_bytes));
+}
+
+static void test_exception_projection(void)
+{
+    X86CPU first = { 0 };
+    X86CPU second = { 0 };
+
+    first.env.exception_nr = 13;
+    first.env.has_error_code = true;
+    first.env.error_code = 0x1122;
+    first.env.exception_has_payload = true;
+    first.env.exception_payload = 0x33445566;
+    second.env.exception_nr = 14;
+    second.env.has_error_code = true;
+    second.env.error_code = 0x7788;
+    second.env.exception_has_payload = true;
+    second.env.exception_payload = 0x99aabbcc;
+    assert_projection_equal(&first, &second,
+                            x86_cpu_fingerprint_exception_projection);
+
+    second.env.exception_pending = true;
+    assert_projection_changed(&first, &second,
+                              x86_cpu_fingerprint_exception_projection);
+
+    first.env.exception_pending = true;
+    assert_projection_changed(&first, &second,
+                              x86_cpu_fingerprint_exception_projection);
+
+    first = (X86CPU){ 0 };
+    second = (X86CPU){ 0 };
+    first.env.exception_injected = true;
+    second.env.exception_injected = true;
+    first.env.exception_nr = second.env.exception_nr = 14;
+    first.env.exception_has_payload = second.env.exception_has_payload = true;
+    first.env.exception_payload = 1;
+    second.env.exception_payload = 2;
+    assert_projection_changed(&first, &second,
+                              x86_cpu_fingerprint_exception_projection);
+}
+
+static void test_nested_projection(void)
+{
+    X86CPU first = { 0 };
+    X86CPU second = { 0 };
+
+    first.env.vm_vmcb = 0x1000;
+    first.env.intercept = 1;
+    first.env.nested_cr3 = 0x2000;
+    second.env.vm_vmcb = 0x3000;
+    second.env.intercept = 2;
+    second.env.nested_cr3 = 0x4000;
+    assert_projection_equal(&first, &second,
+                            x86_cpu_fingerprint_nested_projection);
+
+    second.env.hflags |= HF_GUEST_MASK;
+    assert_projection_changed(&first, &second,
+                              x86_cpu_fingerprint_nested_projection);
+
+    first.env.hflags |= HF_GUEST_MASK;
+    assert_projection_changed(&first, &second,
+                              x86_cpu_fingerprint_nested_projection);
+
+    first = (X86CPU){ 0 };
+    second = (X86CPU){ 0 };
+    first.env.hflags = second.env.hflags = HF_GUEST_MASK;
+    first.env.nested_cr3 = 0x5000;
+    second.env.nested_cr3 = 0x6000;
+    assert_projection_equal(&first, &second,
+                            x86_cpu_fingerprint_nested_projection);
+
+    second.env.hflags2 |= HF2_NPT_MASK;
+    assert_projection_changed(&first, &second,
+                              x86_cpu_fingerprint_nested_projection);
+}
+
+static void test_smm_projection(void)
+{
+    X86CPU first = { 0 };
+    X86CPU second = { 0 };
+
+    second.env.smbase = 0x30000;
+    assert_projection_changed(&first, &second,
+                              x86_cpu_fingerprint_smm_base_projection);
+
+    first.env.msr_smi_count = 1;
+    second.env.msr_smi_count = 2;
+    assert_projection_equal(&first, &second,
+                            x86_cpu_fingerprint_smi_count_projection);
+
+    second.migrate_smi_count = true;
+    assert_projection_changed(&first, &second,
+                              x86_cpu_fingerprint_smi_count_projection);
+
+    first.migrate_smi_count = true;
+    assert_projection_changed(&first, &second,
+                              x86_cpu_fingerprint_smi_count_projection);
+}
+
+static void test_mmx_bytes_are_independent_of_x87_tags(void)
+{
+    X86CPU cpu = { 0 };
+    const uint64_t physical_mmx = UINT64_C(0x0123456789abcdef);
+
+    cpu.env.fptags[0] = 1;
+    cpu.env.fpregs[0].mmx._q_MMXReg[0] = physical_mmx;
+
+    g_assert_cmphex(x86_crucible_mmx_register_value(&cpu.env, 0), ==,
+                    physical_mmx);
+    g_assert_cmphex(x86_crucible_fpu_abridged_tag(&cpu.env), ==, 1);
+}
+
+static void test_tsc_picosecond_range(void)
+{
+    uint64_t result_ps = 0;
+    uint64_t final_tick = UINT64_MAX / 250;
+
+    g_assert_true(x86_crucible_tsc_to_ps(4, 1, 250, &result_ps));
+    g_assert_cmpuint(result_ps, ==, 1250);
+
+    g_assert_true(x86_crucible_tsc_to_ps(final_tick, 0, 250, &result_ps));
+    g_assert_cmpuint(result_ps, ==, final_tick * 250);
+
+    g_assert_false(x86_crucible_tsc_to_ps(final_tick, 1, 250, &result_ps));
+    g_assert_false(x86_crucible_tsc_to_ps(1, UINT64_MAX, 250,
+                                          &result_ps));
+    g_assert_false(x86_crucible_tsc_to_ps(1, 0, 0, &result_ps));
+}
+
+int main(int argc, char **argv)
+{
+    module_call_init(MODULE_INIT_QOM);
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/crucible/x86/exception", test_exception_projection);
+    g_test_add_func("/crucible/x86/nested", test_nested_projection);
+    g_test_add_func("/crucible/x86/smm", test_smm_projection);
+    g_test_add_func("/crucible/x86/mmx-empty-tag",
+                    test_mmx_bytes_are_independent_of_x87_tags);
+    g_test_add_func("/crucible/x86/tsc-picosecond-range",
+                    test_tsc_picosecond_range);
+    return g_test_run();
+}
diff --git a/tests/unit/test-crucible-x86-table-projection.c b/tests/unit/test-crucible-x86-table-projection.c
new file mode 100644
index 0000000000000000000000000000000000000000..1790acff4bd19e2ce48c46b0ee843354c381e48f
--- /dev/null
+++ b/tests/unit/test-crucible-x86-table-projection.c
@@ -0,0 +1,207 @@
+/*
+ * GDTR/IDTR canonical x86 projection regression controls
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+
+#include "io/channel-file.h"
+#include "migration/vmstate.h"
+#include "qapi/error.h"
+#include "qemu/module.h"
+#include "qemu/plugin.h"
+#include "target/i386/crucible-fingerprint.h"
+
+/* The full native projection sees identical modeled register bytes on every
+ * invocation.  This provider does not execute the live CPU/GDB registry. */
+static const uint8_t fixture_register_bytes[] = {
+    0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef,
+    0xfe, 0xdc, 0xba, 0x98, 0x76, 0x54, 0x32, 0x10,
+};
+
+int qemu_crucible_internal_read_vcpu_regs(
+    unsigned int vcpu_index, uint8_t *out_register_bytes,
+    size_t out_register_capacity, size_t *out_register_len,
+    uint64_t *out_retired_instruction_count)
+{
+    g_assert_cmpuint(vcpu_index, ==, 0);
+    g_assert_nonnull(out_register_len);
+    g_assert_nonnull(out_retired_instruction_count);
+    *out_register_len = sizeof(fixture_register_bytes);
+    *out_retired_instruction_count = 0;
+
+    if (!out_register_bytes) {
+        g_assert_cmpuint(out_register_capacity, ==, 0);
+        return -1;
+    }
+
+    g_assert_cmpuint(out_register_capacity, ==, sizeof(fixture_register_bytes));
+    memcpy(out_register_bytes, fixture_register_bytes,
+           sizeof(fixture_register_bytes));
+    return 0;
+}
+
+/* Generated from the exact reviewed machine.c.  The omission reconstruction
+ * hash-matches the native v2 body and descriptor before symbol renaming. */
+#include "crucible-x86-table-projections.h"
+
+static size_t projection_bound(const CPUX86State *env)
+{
+    /* Each conditional native branch is charged at its maximum output. */
+    return 8 + sizeof(fixture_register_bytes) + 12 + 24 + 8 +
+           5 + ARRAY_SIZE(env->fptags) * 11 + 18 + 58 + 45 +
+           ARRAY_SIZE(env->mtrr_fixed) * 8 + 8 +
+           ARRAY_SIZE(env->mtrr_var) * 16 + 32 +
+           ARRAY_SIZE(env->mce_banks) * 8 + 40 + 56 + 68 + 9 +
+           ARRAY_SIZE(env->features) * 4;
+}
+
+static GBytes *project_cpu(const X86CPU *cpu,
+                          const CrucibleFingerprintProjection *projection)
+{
+    g_autofree X86CPU *before = g_memdup2(cpu, sizeof(*cpu));
+    g_autofree char *path = NULL;
+    g_autofree uint8_t *data = NULL;
+    Error *error = NULL;
+    struct stat status;
+    QIOChannelFile *channel;
+    QEMUFile *file;
+    int write_fd;
+    int read_fd;
+
+    write_fd = g_file_open_tmp("qemu-x86-tables-XXXXXX", &path, NULL);
+    g_assert_cmpint(write_fd, >=, 0);
+    read_fd = dup(write_fd);
+    g_assert_cmpint(read_fd, >=, 0);
+    g_assert_cmpint(unlink(path), ==, 0);
+    channel = qio_channel_file_new_fd(write_fd);
+    file = qemu_file_new_output(QIO_CHANNEL(channel));
+
+    g_assert_true(projection->save(file, cpu, &error));
+    g_assert_null(error);
+    g_assert_cmpmem(cpu, sizeof(*cpu), before, sizeof(*before));
+    g_assert_cmpint(qemu_fflush(file), ==, 0);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+    g_assert_cmpint(fstat(read_fd, &status), ==, 0);
+    g_assert_cmpuint(status.st_size, >, 0);
+    g_assert_cmpuint(status.st_size, <=, projection_bound(&cpu->env));
+
+    data = g_malloc(status.st_size);
+    g_assert_cmpint(pread(read_fd, data, status.st_size, 0), ==,
+                    status.st_size);
+    object_unref(OBJECT(channel));
+    g_assert_cmpint(close(read_fd), ==, 0);
+    return g_bytes_new_take(g_steal_pointer(&data), status.st_size);
+}
+
+static void initialize_cpu(X86CPU *cpu)
+{
+    CPU(cpu)->cpu_index = 0;
+    cpu->env.gdt.base = UINT64_C(0x1122334455667788);
+    cpu->env.gdt.limit = UINT32_C(0x99aabbcc);
+    cpu->env.idt.base = UINT64_C(0x0123456789abcdef);
+    cpu->env.idt.limit = UINT32_C(0xfedcba98);
+
+    /* Exercise the existing conditional bodies with fixed fixture state. */
+    cpu->env.hflags = HF_GUEST_MASK;
+    cpu->env.hflags2 = HF2_NPT_MASK;
+    cpu->env.exception_pending = true;
+    cpu->env.exception_injected = true;
+    cpu->env.has_error_code = true;
+    cpu->env.exception_has_payload = true;
+    cpu->migrate_smi_count = true;
+}
+
+static void assert_table_extension(GBytes *current, GBytes *predecessor,
+                                   const uint8_t expected[24])
+{
+    size_t current_size;
+    size_t predecessor_size;
+    const uint8_t *current_data = g_bytes_get_data(current, &current_size);
+    const uint8_t *predecessor_data =
+        g_bytes_get_data(predecessor, &predecessor_size);
+    const size_t table_offset = 8 + sizeof(fixture_register_bytes) + 12;
+
+    g_assert_cmpuint(current_size, ==, predecessor_size + 24);
+    g_assert_cmpmem(current_data, table_offset,
+                    predecessor_data, table_offset);
+    g_assert_cmpmem(current_data + table_offset, 24, expected, 24);
+    g_assert_cmpmem(current_data + table_offset + 24,
+                    current_size - table_offset - 24,
+                    predecessor_data + table_offset,
+                    predecessor_size - table_offset);
+}
+
+static void test_table_scalar_changes(void)
+{
+    static const uint8_t expected_tables[24] = {
+        0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88,
+        0x99, 0xaa, 0xbb, 0xcc,
+        0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef,
+        0xfe, 0xdc, 0xba, 0x98,
+    };
+    static const size_t changed_byte[] = {7, 11, 19, 23};
+    g_autofree X86CPU *baseline = g_new0(X86CPU, 1);
+    g_autofree X86CPU *variant = g_new0(X86CPU, 1);
+    g_autoptr(GBytes) current_baseline = NULL;
+    g_autoptr(GBytes) predecessor_baseline = NULL;
+
+    initialize_cpu(baseline);
+    current_baseline = project_cpu(baseline, &x86_cpu_fingerprint);
+    predecessor_baseline = project_cpu(baseline, &x86_cpu_fingerprint_v2);
+    assert_table_extension(current_baseline, predecessor_baseline,
+                           expected_tables);
+
+    for (size_t field = 0; field < ARRAY_SIZE(changed_byte); field++) {
+        uint8_t expected_variant[24];
+        g_autoptr(GBytes) current_variant = NULL;
+        g_autoptr(GBytes) predecessor_variant = NULL;
+
+        memcpy(variant, baseline, sizeof(*variant));
+        memcpy(expected_variant, expected_tables, sizeof(expected_variant));
+        expected_variant[changed_byte[field]] ^= 1;
+        switch (field) {
+        case 0:
+            variant->env.gdt.base ^= 1;
+            break;
+        case 1:
+            variant->env.gdt.limit ^= 1;
+            break;
+        case 2:
+            variant->env.idt.base ^= 1;
+            break;
+        case 3:
+            variant->env.idt.limit ^= 1;
+            break;
+        default:
+            g_assert_not_reached();
+        }
+
+        current_variant = project_cpu(variant, &x86_cpu_fingerprint);
+        predecessor_variant = project_cpu(variant, &x86_cpu_fingerprint_v2);
+        g_assert_false(g_bytes_equal(current_baseline, current_variant));
+        g_assert_true(g_bytes_equal(predecessor_baseline, predecessor_variant));
+        assert_table_extension(current_variant, predecessor_variant,
+                               expected_variant);
+    }
+}
+
+static void test_table_projection_schema(void)
+{
+    g_assert_cmpstr(x86_cpu_fingerprint.schema, ==, "crucible.qemu.x86-cpu.v3");
+    g_assert_cmpuint(x86_cpu_fingerprint.version, ==, 3);
+    g_assert_cmpstr(x86_cpu_fingerprint_v2.schema, ==,
+                    "crucible.qemu.x86-cpu.v2");
+    g_assert_cmpuint(x86_cpu_fingerprint_v2.version, ==, 2);
+}
+
+int main(int argc, char **argv)
+{
+    module_call_init(MODULE_INIT_QOM);
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/crucible/x86/tables/scalars", test_table_scalar_changes);
+    g_test_add_func("/crucible/x86/tables/schema",
+                    test_table_projection_schema);
+    return g_test_run();
+}
diff --git a/tests/unit/test-crucible-xhci-microframe.c b/tests/unit/test-crucible-xhci-microframe.c
new file mode 100644
index 0000000000000000000000000000000000000000..4d57375fafade2fbf426bb13bf1c9b605a36a38b
--- /dev/null
+++ b/tests/unit/test-crucible-xhci-microframe.c
@@ -0,0 +1,300 @@
+/*
+ * Actual xHCI microframe deadline and phase migration tests.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/main-loop.h"
+#include "system/cpu-timers.h"
+#include "exec/icount.h"
+#include "io/channel-buffer.h"
+#include "../../migration/qemu-file.h"
+
+/* Keep the literal arming bodies without realizing USB hardware. */
+#undef type_init
+#define type_init(function) \
+    static void (*const fixture_##function)(void) G_GNUC_UNUSED = function;
+#include "../../hw/usb/hcd-xhci.c"
+
+#define MICROFRAME_PS INT64_C(125000000)
+#define WRAP_MICROFRAMES UINT64_C(0x4000)
+
+static __int128 observed_ps;
+static unsigned dispatched;
+
+int64_t cpu_get_clock(void)
+{
+    return observed_ps / PICOSECONDS_PER_NANOSECOND;
+}
+
+bool icount_crucible_sim_mode(void)
+{
+    return false;
+}
+
+static __int128 observed_clock_ps(void)
+{
+    return observed_ps;
+}
+
+static void initialize_clock(bool exact)
+{
+    Error *error = NULL;
+
+    module_call_init(MODULE_INIT_QOM);
+    qemu_init_main_loop(&error);
+    g_assert_null(error);
+    if (exact) {
+        qemu_timer_enable_tcg_ps_clock(NULL, observed_clock_ps);
+    }
+    qemu_clock_enable(QEMU_CLOCK_VIRTUAL, true);
+}
+
+static void count_dispatch(void *opaque)
+{
+    unsigned *count = opaque;
+
+    (*count)++;
+}
+
+static void initialize_controller(XHCIState *xhci, __int128 origin_ps)
+{
+    memset(xhci, 0, sizeof(*xhci));
+    observed_ps = origin_ps;
+    xhci_mfindex_reset(xhci);
+    xhci->usbcmd = USBCMD_RS | USBCMD_EWE;
+    xhci->mfwrap_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, count_dispatch,
+                                     &dispatched);
+}
+
+static void assert_deadline(QEMUTimer *timer, __int128 expected_ps)
+{
+    g_assert_true(timer_pending(timer));
+    g_assert_true(timer_expire_time_ps_wide(timer) == expected_ps);
+}
+
+static void test_wrap_fractional(void)
+{
+    XHCIState xhci;
+    const __int128 origin_ps = 999;
+    const __int128 first_wrap = origin_ps +
+                               WRAP_MICROFRAMES * MICROFRAME_PS;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    initialize_controller(&xhci, origin_ps);
+    observed_ps++;
+    xhci_mfwrap_update(&xhci);
+    assert_deadline(xhci.mfwrap_timer, first_wrap);
+
+    observed_ps = first_wrap - 1;
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(dispatched, ==, 0);
+    observed_ps++;
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(dispatched, ==, 1);
+    g_assert_false(timer_pending(xhci.mfwrap_timer));
+    timer_free(xhci.mfwrap_timer);
+}
+
+static void test_wrap_late_rearm(void)
+{
+    XHCIState xhci;
+    const __int128 origin_ps = 123456789;
+    const __int128 wrap_ps = WRAP_MICROFRAMES * MICROFRAME_PS;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    initialize_controller(&xhci, origin_ps);
+    for (unsigned wrap = 0; wrap < 4; wrap++) {
+        observed_ps = origin_ps + wrap * wrap_ps + MICROFRAME_PS - 1;
+        xhci_mfwrap_update(&xhci);
+        assert_deadline(xhci.mfwrap_timer, origin_ps + (wrap + 1) * wrap_ps);
+    }
+    xhci.usbcmd &= ~USBCMD_EWE;
+    xhci_mfwrap_update(&xhci);
+    g_assert_false(timer_pending(xhci.mfwrap_timer));
+    timer_free(xhci.mfwrap_timer);
+}
+
+static void test_kick_fractional(void)
+{
+    XHCIState xhci;
+    XHCIEPContext endpoint = { 0 };
+    XHCITransfer transfer = { 0 };
+    const __int128 origin_ps = 100999;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    initialize_controller(&xhci, origin_ps);
+    endpoint.kick_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, count_dispatch,
+                                       &dispatched);
+    transfer.mfindex_kick = 7;
+    observed_ps = origin_ps + 3 * MICROFRAME_PS + MICROFRAME_PS - 1;
+    xhci_check_intr_iso_kick(&xhci, &transfer, &endpoint,
+                             xhci_mfindex_get(&xhci));
+    assert_deadline(endpoint.kick_timer, origin_ps + 7 * MICROFRAME_PS);
+    g_assert_cmpuint(transfer.running_retry, ==, 1);
+
+    observed_ps = origin_ps + 7 * MICROFRAME_PS;
+    xhci_check_intr_iso_kick(&xhci, &transfer, &endpoint,
+                             xhci_mfindex_get(&xhci));
+    g_assert_false(timer_pending(endpoint.kick_timer));
+    g_assert_cmpuint(endpoint.mfindex_last, ==, 7);
+    g_assert_cmpuint(transfer.running_retry, ==, 0);
+    timer_free(endpoint.kick_timer);
+    timer_free(xhci.mfwrap_timer);
+}
+
+static void test_wide_origin(void)
+{
+    XHCIState xhci;
+    const __int128 origin_ps = (__int128)INT64_MAX + 999;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    initialize_controller(&xhci, origin_ps);
+    observed_ps++;
+    xhci_mfwrap_update(&xhci);
+    assert_deadline(xhci.mfwrap_timer,
+                    origin_ps + WRAP_MICROFRAMES * MICROFRAME_PS);
+    timer_free(xhci.mfwrap_timer);
+}
+
+static void test_legacy_clock(void)
+{
+    XHCIState xhci;
+    XHCIEPContext endpoint = { 0 };
+    XHCITransfer transfer = { .mfindex_kick = 7 };
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(false);
+    initialize_controller(&xhci, 100999);
+    observed_ps = 100999 + 3 * MICROFRAME_PS + 12345;
+    xhci_mfwrap_update(&xhci);
+    g_assert_cmpint(timer_expire_time_ns(xhci.mfwrap_timer), ==,
+                    cpu_get_clock() + (WRAP_MICROFRAMES - 3) * 125000);
+    endpoint.kick_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, count_dispatch,
+                                       &dispatched);
+    xhci_check_intr_iso_kick(&xhci, &transfer, &endpoint, 3);
+    g_assert_cmpint(timer_expire_time_ns(endpoint.kick_timer), ==,
+                    cpu_get_clock() + 4 * 125000);
+    timer_free(endpoint.kick_timer);
+    timer_free(xhci.mfwrap_timer);
+}
+
+/* Retain the parent scalar/timer fields and its actual phase subsection. */
+static const VMStateDescription fixture_vmstate = {
+    .name = "xhci-core",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .pre_save = usb_xhci_pre_save,
+    .pre_load = usb_xhci_pre_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_INT64(mfindex_start, XHCIState),
+        VMSTATE_TIMER_NS_FLOOR_PTR(mfwrap_timer, XHCIState),
+        VMSTATE_END_OF_LIST()
+    },
+    .subsections = (const VMStateDescription * const []) {
+        &vmstate_xhci_ps_clock,
+        NULL
+    },
+};
+
+static void test_migration(void)
+{
+    XHCIState original;
+    XHCIState restored;
+    QIOChannelBuffer *output;
+    QIOChannelBuffer *input;
+    QEMUFile *file;
+    Error *error = NULL;
+    const __int128 origin_ps = 999;
+    const __int128 wrap_ps = WRAP_MICROFRAMES * MICROFRAME_PS;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    initialize_controller(&original, origin_ps);
+    observed_ps++;
+    xhci_mfwrap_update(&original);
+    output = qio_channel_buffer_new(128);
+    file = qemu_file_new_output(QIO_CHANNEL(output));
+    g_assert_cmpint(vmstate_save_state(file, &fixture_vmstate, &original,
+                                      NULL, &error), ==, 0);
+    g_assert_null(error);
+    qemu_put_byte(file, 0);
+    qemu_fflush(file);
+    input = qio_channel_buffer_new(output->usage);
+    input->usage = output->usage;
+    memcpy(input->data, output->data, output->usage);
+    qemu_fclose(file);
+
+    initialize_controller(&restored, observed_ps);
+    file = qemu_file_new_input(QIO_CHANNEL(input));
+    g_assert_cmpint(vmstate_load_state(file, &fixture_vmstate, &restored, 1,
+                                      &error),
+                    ==, 0);
+    g_assert_null(error);
+    g_assert_cmpint(usb_timer_restore_phase(restored.mfwrap_timer,
+                                           restored.mfwrap_timer_phase_ps),
+                    ==, 0);
+    g_assert_cmpuint(restored.ps_clock_unit, ==, 1);
+    g_assert_true(xhci_mfindex_start_ps(&restored) == origin_ps);
+    assert_deadline(restored.mfwrap_timer, origin_ps + wrap_ps);
+    g_assert_cmpint(usb_timer_restore_phase(restored.mfwrap_timer,
+                                           PICOSECONDS_PER_NANOSECOND),
+                    ==, -EINVAL);
+    assert_deadline(restored.mfwrap_timer, origin_ps + wrap_ps);
+
+    observed_ps = origin_ps + wrap_ps + 501;
+    xhci_mfwrap_update(&restored);
+    assert_deadline(restored.mfwrap_timer, origin_ps + 2 * wrap_ps);
+    qemu_fclose(file);
+    object_unref(OBJECT(input));
+    object_unref(OBJECT(output));
+    timer_free(restored.mfwrap_timer);
+    timer_free(original.mfwrap_timer);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/xhci/microframe/fractional-wrap", test_wrap_fractional);
+    g_test_add_func("/xhci/microframe/late-rearm", test_wrap_late_rearm);
+    g_test_add_func("/xhci/microframe/fractional-kick", test_kick_fractional);
+    g_test_add_func("/xhci/microframe/wide-origin", test_wide_origin);
+    g_test_add_func("/xhci/microframe/legacy", test_legacy_clock);
+    g_test_add_func("/xhci/microframe/migration", test_migration);
+    return g_test_run();
+}
diff --git a/tests/unit/test-crucible-xtensa-timer.c b/tests/unit/test-crucible-xtensa-timer.c
new file mode 100644
index 0000000000000000000000000000000000000000..13625df83aa891b407e9dce095ed3d528f5ab74a
--- /dev/null
+++ b/tests/unit/test-crucible-xtensa-timer.c
@@ -0,0 +1,75 @@
+/* Xtensa exact timer arithmetic tests. */
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include "qemu/osdep.h"
+
+#include "target/xtensa/timer.h"
+
+static Clock test_clock(unsigned int frequency)
+{
+    Clock clock = {};
+
+    clock.period = CLOCK_PERIOD_FROM_HZ(frequency);
+    return clock;
+}
+
+static void test_nondivisor_boundary(void)
+{
+    Clock clock = test_clock(38400000);
+    __int128 tick_ps = xtensa_clock_ticks_to_ps(&clock, 1);
+
+    g_assert_true(tick_ps == 26042);
+    g_assert_cmpuint(xtensa_clock_ps_to_ticks(&clock, tick_ps - 1), ==, 0);
+    g_assert_cmpuint(xtensa_clock_ps_to_ticks(&clock, tick_ps), ==, 1);
+
+    g_assert_true(xtensa_ccompare_deadline_ps(&clock, -100, 1) == 25942);
+}
+
+static void test_negative_floor(void)
+{
+    Clock clock = test_clock(38400000);
+
+    g_assert_cmpuint(xtensa_clock_ps_to_ticks(&clock, -1), ==, UINT32_MAX);
+    g_assert_cmpuint(xtensa_clock_ps_to_ticks(&clock, -26042), ==,
+                     UINT32_MAX - 1);
+}
+
+static void test_phase_zero_compatibility(void)
+{
+    Clock clock = test_clock(38400000);
+    uint64_t time_ns = 123456789;
+
+    g_assert_cmpuint(
+        xtensa_clock_ps_to_ticks(&clock,
+                                 (__int128)time_ns *
+                                 PICOSECONDS_PER_NANOSECOND),
+        ==, (uint32_t)clock_ns_to_ticks(&clock, time_ns));
+}
+
+static void test_horizon(void)
+{
+    const __int128 horizon_ps = (__int128)INT64_MAX *
+                                PICOSECONDS_PER_NANOSECOND + 999;
+    Clock clock = test_clock(38400000);
+
+    g_assert_true(xtensa_ccompare_deadline_ps(&clock,
+                                              horizon_ps - 26042, 1) ==
+                  horizon_ps);
+    g_assert_true(xtensa_ccompare_deadline_ps(&clock,
+                                              horizon_ps - 26043, 1) ==
+                  horizon_ps - 1);
+    g_assert_true(xtensa_ccompare_deadline_ps(&clock, horizon_ps, 1) ==
+                  horizon_ps);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/crucible/xtensa/nondivisor-boundary",
+                    test_nondivisor_boundary);
+    g_test_add_func("/crucible/xtensa/negative-floor", test_negative_floor);
+    g_test_add_func("/crucible/xtensa/phase-zero-compatibility",
+                    test_phase_zero_compatibility);
+    g_test_add_func("/crucible/xtensa/horizon", test_horizon);
+    return g_test_run();
+}
