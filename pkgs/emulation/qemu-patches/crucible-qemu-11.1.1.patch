+typedef struct QemuHotForkThreadRecord {
+    int64_t thread_id;
+    char name[QEMU_HOT_FORK_THREAD_NAME_MAX + 1];
+    bool joinable;
+    bool name_valid;
+    bool tracked;
+    QemuThreadHotForkDisposition disposition;
+} QemuHotForkThreadRecord;
+
+static pthread_mutex_t qemu_hot_fork_thread_lock = PTHREAD_MUTEX_INITIALIZER;
+static GList *qemu_hot_fork_threads;
+static size_t qemu_hot_fork_thread_count;
+static size_t qemu_hot_fork_thread_overflow;
+static size_t qemu_hot_fork_thread_starts_in_flight;
+static uint64_t qemu_hot_fork_thread_generation;
+static int64_t qemu_hot_fork_coordinator_thread_id;
+static __thread QemuHotForkThreadRecord *qemu_hot_fork_current_thread;
+
+static QemuHotForkThreadRecord *qemu_hot_fork_thread_register(
+    const char *name, int mode, QemuThreadHotForkDisposition disposition)
+{
+    QemuHotForkThreadRecord *record = g_new0(QemuHotForkThreadRecord, 1);
+    size_t name_length = name ?
+        strnlen(name, QEMU_HOT_FORK_THREAD_NAME_MAX + 1) : 0;
+    int err;
+
+    record->thread_id = qemu_get_thread_id();
+    record->joinable = mode == QEMU_THREAD_JOINABLE;
+    record->disposition = disposition;
+    record->name_valid = name && name_length <= QEMU_HOT_FORK_THREAD_NAME_MAX &&
+                         g_utf8_validate(name, name_length, NULL);
+    g_strlcpy(record->name, record->name_valid ? name : "<invalid>",
+              sizeof(record->name));
+
+    err = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    if (qemu_hot_fork_thread_count == QEMU_HOT_FORK_THREAD_INVENTORY_MAX) {
+        qemu_hot_fork_thread_overflow++;
+    } else {
+        record->tracked = true;
+        qemu_hot_fork_threads = g_list_prepend(qemu_hot_fork_threads, record);
+        qemu_hot_fork_thread_count++;
+    }
+    qemu_hot_fork_thread_generation++;
+    err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    return record;
+}
+
+static void qemu_hot_fork_thread_start_begin(void)
+{
+    int err = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+
+    if (err) {
+        error_exit(err, __func__);
+    }
+    if (qemu_hot_fork_thread_starts_in_flight == SIZE_MAX ||
+        qemu_hot_fork_thread_generation == UINT64_MAX) {
+        error_exit(EOVERFLOW, __func__);
+    }
+    qemu_hot_fork_thread_starts_in_flight++;
+    qemu_hot_fork_thread_generation++;
+    err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+}
+
+static void qemu_hot_fork_thread_start_end(void)
+{
+    int err = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+
+    if (err) {
+        error_exit(err, __func__);
+    }
+    assert(qemu_hot_fork_thread_starts_in_flight > 0);
+    if (qemu_hot_fork_thread_generation == UINT64_MAX) {
+        error_exit(EOVERFLOW, __func__);
+    }
+    qemu_hot_fork_thread_starts_in_flight--;
+    qemu_hot_fork_thread_generation++;
+    err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+}
+
+void qemu_thread_hot_fork_set_current_disposition(
+    QemuThreadHotForkDisposition disposition)
+{
+    QemuHotForkThreadRecord *record = qemu_hot_fork_current_thread;
+    int err;
+
+    assert(record);
+    assert(disposition != QEMU_THREAD_HOT_FORK_COORDINATOR);
+    err = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    if (record->disposition != disposition) {
+        record->disposition = disposition;
+        qemu_hot_fork_thread_generation++;
+    }
+    err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+}
+
+int qemu_thread_hot_fork_bind_monitor_restart(int64_t thread_id)
+{
+    QemuHotForkThreadRecord *match = NULL;
+    GList *node;
+    int err;
+
+    if (thread_id <= 0) {
+        return -EINVAL;
+    }
+    err = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    for (node = qemu_hot_fork_threads; node; node = node->next) {
+        QemuHotForkThreadRecord *record = node->data;
+
+        if (record->thread_id == thread_id) {
+            if (match) {
+                match = NULL;
+                break;
+            }
+            match = record;
+        }
+    }
+    if (!match || !match->tracked ||
+        match->disposition != QEMU_THREAD_HOT_FORK_UNCLASSIFIED_AIO) {
+        err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+        if (err) {
+            error_exit(err, __func__);
+        }
+        return -ESTALE;
+    }
+    match->disposition = QEMU_THREAD_HOT_FORK_MONITOR_RESTART;
+    qemu_hot_fork_thread_generation++;
+    err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    return 0;
+}
+
+static void qemu_hot_fork_thread_unregister(void *opaque)
+{
+    QemuHotForkThreadRecord *record = opaque;
+    int err = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+
+    if (err) {
+        error_exit(err, __func__);
+    }
+    if (record->tracked) {
+        qemu_hot_fork_threads = g_list_remove(qemu_hot_fork_threads, record);
+        assert(qemu_hot_fork_thread_count > 0);
+        qemu_hot_fork_thread_count--;
+    } else {
+        assert(qemu_hot_fork_thread_overflow > 0);
+        qemu_hot_fork_thread_overflow--;
+    }
+    qemu_hot_fork_thread_generation++;
+    err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    qemu_hot_fork_current_thread = NULL;
+    g_free(record);
+}
+
+static int qemu_hot_fork_thread_entry_compare(const void *left,
+                                               const void *right)
+{
+    const QemuThreadHotForkInventoryEntry *a = left;
+    const QemuThreadHotForkInventoryEntry *b = right;
+
+    return (a->thread_id > b->thread_id) - (a->thread_id < b->thread_id);
+}
+
+static QemuHotForkThreadRecord *qemu_hot_fork_register_coordinator(void)
+{
+    int64_t thread_id = qemu_get_thread_id();
+    GList *node;
+    int err = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+
+    if (err) {
+        error_exit(err, __func__);
+    }
+    if (qemu_hot_fork_coordinator_thread_id == thread_id) {
+        QemuHotForkThreadRecord *coordinator = NULL;
+
+        for (node = qemu_hot_fork_threads; node; node = node->next) {
+            QemuHotForkThreadRecord *record = node->data;
+
+            if (record->thread_id == thread_id &&
+                record->disposition == QEMU_THREAD_HOT_FORK_COORDINATOR) {
+                if (coordinator) {
+                    coordinator = NULL;
+                    break;
+                }
+                coordinator = record;
+            }
+        }
+        qemu_hot_fork_current_thread = coordinator;
+        err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+        if (err) {
+            error_exit(err, __func__);
+        }
+        return coordinator;
+    }
+    if (qemu_hot_fork_coordinator_thread_id != 0) {
+        err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+        if (err) {
+            error_exit(err, __func__);
+        }
+        return NULL;
+    }
+    for (node = qemu_hot_fork_threads; node; node = node->next) {
+        QemuHotForkThreadRecord *record = node->data;
+
+        if (record->thread_id == thread_id) {
+            if (record->disposition != QEMU_THREAD_HOT_FORK_COORDINATOR) {
+                record->disposition = QEMU_THREAD_HOT_FORK_COORDINATOR;
+                qemu_hot_fork_thread_generation++;
+            }
+            qemu_hot_fork_coordinator_thread_id = thread_id;
+            err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+            if (err) {
+                error_exit(err, __func__);
+            }
+            qemu_hot_fork_current_thread = record;
+            return record;
+        }
+    }
+    qemu_hot_fork_coordinator_thread_id = thread_id;
+    err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+
+    /* The QMP main-loop thread is process-lifetime authority. */
+    qemu_hot_fork_current_thread = qemu_hot_fork_thread_register(
+        "qemu-main-loop", QEMU_THREAD_DETACHED,
+        QEMU_THREAD_HOT_FORK_COORDINATOR);
+    return qemu_hot_fork_current_thread;
+}
+
+/*
+ * Static description of the basis that last blocked a registry transaction.
+ * Diagnostics only: the coordinator reports it with the errno-style status.
+ */
+static char qemu_hot_fork_registry_blocker[256];
+
+const char *qemu_thread_hot_fork_registry_transaction_blocker(void)
+{
+    return qemu_hot_fork_registry_blocker[0] ?
+        qemu_hot_fork_registry_blocker : NULL;
+}
+
+/*
+ * Threads whose mutex state one fork may carry.  The coordinator continues in
+ * the child and keeps everything it owns; discard-and-restart threads vanish,
+ * so the child reinitializes whatever they were parked on.  Every other owner
+ * or waiter is a fork blocker.
+ */
+typedef struct CrucibleHotForkMutexCarrier {
+    int64_t coordinator_thread_id;
+    int64_t restart_thread_ids[QEMU_HOT_FORK_RESTART_THREAD_MAX];
+    size_t restart_thread_count;
+} CrucibleHotForkMutexCarrier;
+
+typedef enum CrucibleHotForkMutexDisposition {
+    CRUCIBLE_HOT_FORK_MUTEX_QUIESCENT,
+    CRUCIBLE_HOT_FORK_MUTEX_COORDINATOR_OWNED,
+    CRUCIBLE_HOT_FORK_MUTEX_PARKED,
+    CRUCIBLE_HOT_FORK_MUTEX_BLOCKED,
+} CrucibleHotForkMutexDisposition;
+
+static bool crucible_hot_fork_carrier_is_restart_thread(
+    const CrucibleHotForkMutexCarrier *carrier, int64_t thread_id)
+{
+    size_t index;
+
+    if (thread_id <= 0) {
+        return false;
+    }
+    for (index = 0; index < carrier->restart_thread_count; index++) {
+        if (carrier->restart_thread_ids[index] == thread_id) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static CrucibleHotForkMutexDisposition crucible_hot_fork_mutex_disposition(
+    CrucibleHotForkMutexEntry *mutex,
+    const CrucibleHotForkMutexCarrier *carrier)
+{
+    int64_t owner = qatomic_read(&mutex->owner_thread_id);
+    uint32_t depth = qatomic_read(&mutex->recursion_depth);
+    uint32_t condition_waiters = qatomic_read(&mutex->condition_waiters);
+    int64_t waiter = qatomic_read(&mutex->condition_waiter_thread_id);
+    bool parked = false;
+
+    if (!mutex->active || !qatomic_read(&mutex->ownership_valid) ||
+        qatomic_read(&mutex->unlock_active) ||
+        qatomic_read(&mutex->acquisition_waiters) != 0 ||
+        (owner == 0) != (depth == 0) ||
+        (owner == carrier->coordinator_thread_id &&
+         !mutex->recursive && depth != 1)) {
+        return CRUCIBLE_HOT_FORK_MUTEX_BLOCKED;
+    }
+    if (owner != 0 && owner != carrier->coordinator_thread_id) {
+        if (depth != 1 ||
+            !crucible_hot_fork_carrier_is_restart_thread(carrier, owner)) {
+            return CRUCIBLE_HOT_FORK_MUTEX_BLOCKED;
+        }
+        parked = true;
+    }
+    if (condition_waiters != 0) {
+        if (condition_waiters != 1 ||
+            !crucible_hot_fork_carrier_is_restart_thread(carrier, waiter)) {
+            return CRUCIBLE_HOT_FORK_MUTEX_BLOCKED;
+        }
+        parked = true;
+    }
+    if (parked) {
+        return CRUCIBLE_HOT_FORK_MUTEX_PARKED;
+    }
+    return owner != 0 ? CRUCIBLE_HOT_FORK_MUTEX_COORDINATOR_OWNED :
+        CRUCIBLE_HOT_FORK_MUTEX_QUIESCENT;
+}
+
+/*
+ * Classify every registered mutex against @carrier.  Mutexes the fork must
+ * carry are appended to @carried when it is supplied; without it, only
+ * coordinator-owned mutexes are tolerated.  The registry guard is held.
+ */
+static bool qemu_hot_fork_registered_mutexes_carried(
+    const CrucibleHotForkMutexCarrier *carrier,
+    QemuMutexHotForkRegistration *carried,
+    size_t *carried_count)
+{
+    size_t index;
+    size_t count = 0;
+
+    if (crucible_hot_fork_mutex_overflowed ||
+        crucible_hot_fork_mutex_inconsistent) {
+        snprintf(qemu_hot_fork_registry_blocker,
+                 sizeof(qemu_hot_fork_registry_blocker),
+                 "registered mutex inventory is incomplete or inconsistent");
+        return false;
+    }
+
+    for (index = 0; index < QEMU_HOT_FORK_MUTEX_INVENTORY_MAX; index++) {
+        CrucibleHotForkMutexEntry *mutex =
+            &crucible_hot_fork_mutexes[index];
+        CrucibleHotForkMutexDisposition disposition =
+            CRUCIBLE_HOT_FORK_MUTEX_BLOCKED;
+
+        if (!mutex->active) {
+            continue;
+        }
+        count++;
+        disposition = crucible_hot_fork_mutex_disposition(mutex, carrier);
+        if (disposition == CRUCIBLE_HOT_FORK_MUTEX_BLOCKED ||
+            (disposition == CRUCIBLE_HOT_FORK_MUTEX_PARKED && !carried)) {
+            snprintf(qemu_hot_fork_registry_blocker,
+                     sizeof(qemu_hot_fork_registry_blocker),
+                     "registered mutex %zu is not quiescent (owner thread "
+                     "%" PRId64 ", depth %u, waiters %u/%u, condition waiter "
+                     "%" PRId64 ", recursive %u, unlock %u)",
+                     count,
+                     (int64_t)qatomic_read(&mutex->owner_thread_id),
+                     (unsigned)qatomic_read(&mutex->recursion_depth),
+                     (unsigned)qatomic_read(&mutex->acquisition_waiters),
+                     (unsigned)qatomic_read(&mutex->condition_waiters),
+                     (int64_t)qatomic_read(
+                         &mutex->condition_waiter_thread_id),
+                     (unsigned)mutex->recursive,
+                     (unsigned)qatomic_read(&mutex->unlock_active));
+            return false;
+        }
+        if (disposition == CRUCIBLE_HOT_FORK_MUTEX_QUIESCENT || !carried) {
+            continue;
+        }
+        if (*carried_count == QEMU_HOT_FORK_CARRIED_MUTEX_MAX) {
+            snprintf(qemu_hot_fork_registry_blocker,
+                     sizeof(qemu_hot_fork_registry_blocker),
+                     "registered mutex %zu cannot be carried: %zu mutexes "
+                     "are already carried", count, *carried_count);
+            return false;
+        }
+        carried[*carried_count] = (QemuMutexHotForkRegistration) {
+            .registration_id = mutex->registration_id,
+            .slot = index,
+        };
+        (*carried_count)++;
+    }
+    return true;
+}
+
+static CrucibleHotForkMutexEntry *crucible_hot_fork_registered_mutex(
+    QemuMutexHotForkRegistration registration)
+{
+    CrucibleHotForkMutexEntry *entry;
+
+    if (registration.slot >= QEMU_HOT_FORK_MUTEX_INVENTORY_MAX ||
+        registration.registration_id == 0) {
+        return NULL;
+    }
+
+    entry = &crucible_hot_fork_mutexes[registration.slot];
+    if (!entry->active ||
+        entry->registration_id != registration.registration_id ||
+        entry->mutex_address == 0) {
+        return NULL;
+    }
+    return entry;
+}
+
+static bool crucible_hot_fork_registration_equal(
+    QemuMutexHotForkRegistration left,
+    QemuMutexHotForkRegistration right)
+{
+    return left.registration_id == right.registration_id &&
+        left.slot == right.slot;
+}
+
+/*
+ * Verify that the transaction retained every restartable record in the
+ * copied thread list exactly once.  The list and transaction are both sealed
+ * under qemu_hot_fork_thread_lock before fork(), but the child still validates
+ * their correspondence before using the IDs to authorize mutex adoption.
+ */
+static bool qemu_hot_fork_copied_thread_list_matches(
+    const QemuThreadHotForkRegistryTransaction *transaction,
+    const QemuHotForkThreadRecord *coordinator,
+    GList **coordinator_node)
+{
+    int64_t restart_thread_ids[QEMU_HOT_FORK_RESTART_THREAD_MAX] = { 0 };
+    size_t restart_thread_count = 0;
+    size_t copied_count = 0;
+    size_t coordinator_count = 0;
+    size_t rcu_restart_count = 0;
+    size_t monitor_restart_count = 0;
+    size_t vcpu_restart_count = 0;
+    GList *node;
+
+    *coordinator_node = NULL;
+    for (node = qemu_hot_fork_threads; node; node = node->next) {
+        QemuHotForkThreadRecord *record = node->data;
+
+        copied_count++;
+        if (record == coordinator) {
+            coordinator_count++;
+            *coordinator_node = node;
+            continue;
+        }
+        if (!record || !record->tracked || record->thread_id <= 0 ||
+            restart_thread_count == QEMU_HOT_FORK_RESTART_THREAD_MAX) {
+            return false;
+        }
+        switch (record->disposition) {
+        case QEMU_THREAD_HOT_FORK_RCU_RESTART:
+            rcu_restart_count++;
+            break;
+        case QEMU_THREAD_HOT_FORK_MONITOR_RESTART:
+            monitor_restart_count++;
+            break;
+        case QEMU_THREAD_HOT_FORK_VCPU_RESTART:
+            vcpu_restart_count++;
+            break;
+        default:
+            return false;
+        }
+        restart_thread_ids[restart_thread_count++] = record->thread_id;
+    }
+    if (qemu_hot_fork_thread_overflow != 0 ||
+        qemu_hot_fork_thread_starts_in_flight != 0 ||
+        coordinator_count != 1 || rcu_restart_count != 1 ||
+        monitor_restart_count != 1 || vcpu_restart_count > 1 ||
+        copied_count != qemu_hot_fork_thread_count ||
+        copied_count != 3 + vcpu_restart_count ||
+        restart_thread_count != transaction->restart_thread_count ||
+        qemu_hot_fork_coordinator_thread_id !=
+            transaction->parent_thread_id ||
+        qemu_hot_fork_current_thread != coordinator) {
+        return false;
+    }
+    return memcmp(restart_thread_ids, transaction->restart_thread_ids,
+                  restart_thread_count * sizeof(restart_thread_ids[0])) == 0;
+}
+
+/*
+ * Make one carried mutex usable in the immediate fork child.
+ *
+ * A mutex the coordinator owns stays owned by the same thread under its new
+ * process-local ID.  A mutex a discard-and-restart thread held is still
+ * locked by that vanished thread in the copied pthread state, so it is
+ * replaced with a fresh unlocked mutex of the same kind before any child
+ * thread can contend for it.  A vanished condition waiter is forgotten; the
+ * condition variable it waited on is reinitialized by its owning subsystem.
+ */
+static void crucible_hot_fork_mutex_adopt_in_child(
+    CrucibleHotForkMutexEntry *entry,
+    const CrucibleHotForkMutexCarrier *carrier,
+    int64_t child_thread_id)
+{
+    QemuMutex *mutex = (QemuMutex *)entry->mutex_address;
+    int64_t owner = qatomic_read(&entry->owner_thread_id);
+    uint32_t depth = qatomic_read(&entry->recursion_depth);
+    pthread_mutexattr_t attr;
+    uint32_t lock_index;
+    int err;
+
+    err = pthread_mutexattr_init(&attr);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    if (entry->recursive) {
+        err = pthread_mutexattr_settype(&attr, PTHREAD_MUTEX_RECURSIVE);
+        if (err) {
+            error_exit(err, __func__);
+        }
+    }
+    memset(&mutex->lock, 0, sizeof(mutex->lock));
+    err = pthread_mutex_init(&mutex->lock, &attr);
+    pthread_mutexattr_destroy(&attr);
+    if (err) {
+        error_exit(err, __func__);
+    }
+
+    if (owner == carrier->coordinator_thread_id) {
+        for (lock_index = 0; lock_index < depth; lock_index++) {
+            err = pthread_mutex_lock(&mutex->lock);
+            if (err) {
+                error_exit(err, __func__);
+            }
+        }
+        qatomic_set(&entry->owner_thread_id, child_thread_id);
+    } else {
+        qatomic_set(&entry->owner_thread_id, 0);
+        qatomic_set(&entry->recursion_depth, 0);
+    }
+    qatomic_set(&entry->condition_waiters, 0);
+    qatomic_set(&entry->condition_waiter_thread_id, 0);
+}
+
+int qemu_thread_hot_fork_begin_registry_transaction(
+    QemuThreadHotForkRegistryTransaction *transaction)
+{
+    QemuHotForkThreadRecord *coordinator;
+    GList *node;
+    size_t coordinator_count = 0;
+    size_t rcu_restart_count = 0;
+    size_t monitor_restart_count = 0;
+    size_t vcpu_restart_count = 0;
+    int64_t thread_id = qemu_get_thread_id();
+    CrucibleHotForkMutexCarrier carrier = {
+        .coordinator_thread_id = thread_id,
+    };
+    QemuMutexHotForkRegistration
+        carried[QEMU_HOT_FORK_CARRIED_MUTEX_MAX];
+    size_t carried_count = 0;
+    bool restart_overflow = false;
+    int err;
+
+    if (!transaction || transaction->active ||
+        transaction->coordinator_record || getpid() <= 1 || thread_id <= 0) {
+        return -EINVAL;
+    }
+    coordinator = qemu_hot_fork_register_coordinator();
+    if (!coordinator) {
+        return -EPERM;
+    }
+
+    crucible_hot_fork_mutex_registry_lock();
+    err = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    for (node = qemu_hot_fork_threads; node; node = node->next) {
+        QemuHotForkThreadRecord *record = node->data;
+
+        bool restart = false;
+
+        if (record->disposition == QEMU_THREAD_HOT_FORK_COORDINATOR) {
+            coordinator_count++;
+        } else if (record->disposition ==
+                   QEMU_THREAD_HOT_FORK_RCU_RESTART) {
+            rcu_restart_count++;
+            restart = true;
+        } else if (record->disposition ==
+                   QEMU_THREAD_HOT_FORK_MONITOR_RESTART) {
+            monitor_restart_count++;
+            restart = true;
+        } else if (record->disposition ==
+                   QEMU_THREAD_HOT_FORK_VCPU_RESTART) {
+            vcpu_restart_count++;
+            restart = true;
+        }
+        if (restart) {
+            if (carrier.restart_thread_count ==
+                QEMU_HOT_FORK_RESTART_THREAD_MAX) {
+                restart_overflow = true;
+            } else {
+                carrier.restart_thread_ids[carrier.restart_thread_count++] =
+                    record->thread_id;
+            }
+        }
+    }
+    qemu_hot_fork_registry_blocker[0] = '\0';
+    if (qemu_hot_fork_thread_overflow != 0 ||
+        qemu_hot_fork_thread_starts_in_flight != 0 ||
+        qemu_hot_fork_thread_count != 3 + vcpu_restart_count ||
+        coordinator_count != 1 ||
+        rcu_restart_count != 1 ||
+        monitor_restart_count != 1 ||
+        vcpu_restart_count > 1 ||
+        qemu_hot_fork_coordinator_thread_id != thread_id ||
+        qemu_hot_fork_current_thread != coordinator ||
+        coordinator->thread_id != thread_id || !coordinator->tracked ||
+        coordinator->disposition != QEMU_THREAD_HOT_FORK_COORDINATOR ||
+        restart_overflow ||
+        !qemu_hot_fork_registered_mutexes_carried(&carrier, carried,
+                                                  &carried_count) ||
+        qemu_hot_fork_thread_generation == UINT64_MAX) {
+        if (!qemu_hot_fork_registry_blocker[0]) {
+            snprintf(qemu_hot_fork_registry_blocker,
+                     sizeof(qemu_hot_fork_registry_blocker),
+                     "thread registry is not forkable (threads %zu, "
+                     "coordinators %zu, rcu %zu, monitor %zu, vcpu %zu, "
+                     "overflow %zu, starts %zu, caller %" PRId64
