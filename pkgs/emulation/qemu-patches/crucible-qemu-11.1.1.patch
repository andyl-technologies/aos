+        case QNUM_U64: return source_uint(writer, number->u.u64);
+        case QNUM_DOUBLE: return source_format(writer, "%.17g", number->u.dbl);
+        default: return -EPROTO;
+        }
+    }
+    case QTYPE_QDICT: {
+        const QDict *dict = qobject_to(QDict, object);
+        const QDictEntry *entry;
+        bool first = true;
+
+        status = source_byte(writer, '{');
+        for (entry = qdict_first(dict); !status && entry;
+             entry = qdict_next(dict, entry)) {
+            status = source_separator(writer, depth + 1, first);
+            if (!status) {
+                status = source_quoted(writer, qdict_entry_key(entry));
+            }
+            if (!status) {
+                status = source_append(writer, ": ", 2);
+            }
+            if (!status) {
+                status = source_value(writer, qdict_entry_value(entry), depth + 1);
+            }
+            first = false;
+        }
+        if (!status && writer->writer.pretty) {
+            status = source_indent(writer, depth);
+        }
+        return status ? status : source_byte(writer, '}');
+    }
+    case QTYPE_QLIST: {
+        const QList *list = qobject_to(QList, object);
+        const QListEntry *entry;
+        bool first = true;
+
+        status = source_byte(writer, '[');
+        QLIST_FOREACH_ENTRY(list, entry) {
+            if (status) {
+                break;
+            }
+            status = source_separator(writer, depth + 1, first);
+            if (!status) {
+                status = source_value(writer, qlist_entry_obj(entry), depth + 1);
+            }
+            first = false;
+        }
+        if (!status && writer->writer.pretty) {
+            status = source_indent(writer, depth);
+        }
+        return status ? status : source_byte(writer, ']');
+    }
+    default:
+        return -EPROTO;
+    }
+}
+
+int json_writer_write_source(JSONWriter *candidate, const QObject *object)
+{
+    QemuCrucibleQmpAllocationOwner *owner;
+    SourceJSONWriter *writer;
+    int status;
+    int post;
+
+    status = source_writer_observe(candidate, &writer);
+    if (status) {
+        return status;
+    }
+    if (writer->first_status || writer->post_status || writer->wrote) {
+        return writer->first_status ? writer->first_status :
+            writer->post_status ? writer->post_status : -EBUSY;
+    }
+    status = qemu_crucible_qmp_scope_identity_current(&owner);
+    if (!status && owner != writer->owner) {
+        status = -EPERM;
+    }
+    /* The caller retains an immutable graph for this synchronous walk. Every
+     * object, entry, key and escaped string is registry-proven before traversal;
+     * no generic object is accepted after an uncertain classification. */
+    if (!status) {
+        status = qobject_source_graph_current(object);
+    }
+    if (!status) {
+        status = qemu_crucible_qmp_string_mutation_begin(writer->writer.contents,
+                                                         &writer->mutation);
+    }
+    if (!status) {
+        writer->wrote = true;
+        status = source_value(writer, object, 0);
+    }
+    source_writer_fail(writer, status);
+    if (writer->mutation) {
+        /* Mandatory same-context return precedes caller publication or yield.
+         * Its independent post is recorded even after a traversal refusal. */
+        post = qemu_crucible_qmp_string_mutation_end(&writer->mutation);
+        if (post && !writer->post_status) {
+            writer->post_status = post;
+        }
+    }
+    return writer->first_status ? writer->first_status : writer->post_status;
+}
+
+static int source_writer_free_temporary(SourceJSONWriter *writer)
+{
+    void *payload = writer->formatted;
+    int status;
+
+    if (!payload) {
+        return 0;
+    }
+    status = qemu_crucible_qmp_free(&payload);
+    writer->formatted = payload;
+    return status;
+}
+
+int json_writer_get_and_free_source(JSONWriter **holder, GString **output)
+{
+    SourceJSONWriter *writer;
+    void *payload;
+    int status;
+
+    if (!holder || !*holder || !output) {
+        return -EINVAL;
+    }
+    status = source_writer_observe(*holder, &writer);
+    if (status) {
+        return status;
+    }
+    if (*output != writer->writer.contents || writer->mutation || !writer->wrote ||
+        writer->formatted || writer->first_status || writer->post_status) {
+        return -EINPROGRESS;
+    }
+    /* Output remains paid after escaping. Consume only the actual writer body;
+     * an independent negative retirement post never loses the string holder. */
+    payload = writer;
+    status = qemu_crucible_qmp_free(&payload);
+    *holder = payload;
+    return status;
+}
+
+int json_writer_free_source(JSONWriter **holder, GString **output)
+{
+    SourceJSONWriter *writer;
+    void *payload;
+    int status;
+
+    if (!holder || !*holder || !output) {
+        return -EINVAL;
+    }
+    status = source_writer_observe(*holder, &writer);
+    if (status) {
+        return status;
+    }
+    if (*output != writer->writer.contents || writer->mutation) {
+        return -EBUSY;
+    }
+    status = source_writer_free_temporary(writer);
+    if (status) {
+        return status;
+    }
+    if (writer->writer.contents) {
+        status = qemu_crucible_qmp_string_free(&writer->writer.contents, NULL);
+        *output = writer->writer.contents;
+        if (status) {
+            return status;
+        }
+    }
+    payload = writer;
+    status = qemu_crucible_qmp_free(&payload);
+    *holder = payload;
+    return status;
+}
