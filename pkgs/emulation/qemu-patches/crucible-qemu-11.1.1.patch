+    }
+    crucible_hot_fork_timer_unlock();
+
+    /* The real producer allocates raw_limit before deduplication. */
+    return qemu_crucible_park_array_request(
+        out, raw_limit, sizeof(QemuTimerHotForkInventoryEntry),
+        _Alignof(QemuTimerHotForkInventoryEntry), NULL) && complete;
