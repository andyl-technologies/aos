+    }
+
+    if (rr_request_unacknowledged) {
+        g_assert(qatomic_load_acquire(
+            &qemu_plugin_rr_control_schedule_token) != schedule_token);
+        /* Let the settled RR thread claim a fresh epoch before the sole C. */
+        qemu_plugin_release_control_boundary_schedule(schedule_token);
+        return;
+    }
+
+    /*
+     * The x86 PAUSE helper publishes this fence before leaving translated
+     * execution. The serialized RR writer clears it only after committing the
+     * early owner/cursor handoff under the BQL. Relinquish this BH's token so
+     * it cannot acknowledge or snapshot the preceding partial owner while the
+     * RR thread is waiting to acquire the BQL; handoff completion schedules a
+     * fresh two-pass boundary.
+     */
+    if (qatomic_cmpxchg(&qemu_plugin_crucible_guest_pause_handoff, 1, 2) == 1) {
+        qemu_plugin_release_control_boundary_schedule(schedule_token);
+        qatomic_store_release(&qemu_plugin_crucible_guest_pause_handoff, 3);
+        return;
+    }
+    if (qemu_plugin_crucible_guest_pause_handoff_pending()) {
+        /*
+         * Another control request can acquire the scheduling token after the
+         * first colliding BH relinquishes it but before the RR writer acquires
+         * the BQL. Leave the deferred state intact and relinquish that token as
+         * well; handoff completion schedules the one post-commit boundary.
+         */
+        qemu_plugin_release_control_boundary_schedule(schedule_token);
+        return;
+    }
+
+    /*
+     * A control wake can arrive while an idle-time advance is between its
+     * QEMU clock mutation and plugin commit.  Keep yielding through the same
+     * two-pass barrier until that commit clears the RR fence; acknowledging
+     * earlier would expose a raw clock with a stale logical-time offset.
+     */
+    if (qatomic_load_acquire(&qemu_plugin_time_advance_pending)) {
+        /*
+         * One-shot BHs are inserted at the head of the AioContext queue, so a
+         * self-rescheduling waiter would starve the time-advance completion.
+         * Relinquish the coalescing token instead; that completion is already
+         * queued and schedules a fresh control boundary after its commit.
+         */
+        qemu_plugin_release_control_boundary_schedule(schedule_token);
+        return;
+    }
+
+    if (!qemu_plugin_release_control_boundary_schedule(schedule_token)) {
+        return;
+    }
+    if (rr_request_acknowledged) {
+        /*
+         * Complete the claimed generation before the callback. The BQL keeps
+         * RR fenced until the callback returns, while a nested wake can record
+         * a distinct next request without being folded into this claim.
+         */
+        qatomic_store_release(&qemu_plugin_rr_control_complete_generation,
+                              rr_ack_generation);
+        rr_crucible_sim_trace_control_boundary(
+            "complete", rr_request_generation, rr_ack_generation,
+            rr_ack_generation, schedule_token);
+    }
+    qemu_plugin_fire_control_boundary_cb(first_cpu);
+    qatomic_fetch_inc(&qemu_plugin_control_boundary_generation);
+    if (first_cpu && !qemu_plugin_crucible_vmstop_pending()) {
+        qemu_cpu_kick(first_cpu);
+    }
+}
+
+static void qemu_plugin_control_boundary_barrier_bh(void *opaque)
+{
+    uintptr_t schedule_token = (uintptr_t)opaque;
+
+    if (qatomic_load_acquire(&qemu_plugin_control_boundary_scheduled) !=
+        schedule_token) {
+        return;
+    }
+    /*
+     * Wake notifiers can schedule device-coroutine bottom halves. Complete
+     * the control boundary on the following main-loop pass so every bottom
+     * half captured by the wake is visible before the plugin acknowledges it.
+     */
+    aio_bh_schedule_oneshot(qemu_get_aio_context(),
+                            qemu_plugin_control_boundary_complete_bh, opaque);
+}
+
+static uintptr_t qemu_plugin_schedule_control_boundary(void)
+{
+    uintptr_t active_token;
+    uintptr_t schedule_token =
+        qatomic_fetch_inc(&qemu_plugin_control_boundary_schedule_sequence) + 1;
+
+    if (schedule_token == 0) {
+        error_report("Crucible control-boundary schedule token overflow");
+        abort();
+    }
+    active_token = qatomic_cmpxchg(&qemu_plugin_control_boundary_scheduled,
+                                   0, schedule_token);
+    if (active_token != 0) {
+        return active_token;
+    }
+    aio_bh_schedule_oneshot(qemu_get_aio_context(),
+                            qemu_plugin_control_boundary_barrier_bh,
+                            (void *)(uintptr_t)schedule_token);
+    return schedule_token;
+}
+
+bool qemu_plugin_crucible_rr_control_boundary_pending(void)
+{
+    return qatomic_load_acquire(&qemu_plugin_rr_control_request_generation) !=
+           qatomic_load_acquire(&qemu_plugin_rr_control_complete_generation);
+}
+
+void qemu_plugin_crucible_rr_control_boundary_acknowledge(void)
+{
+    uintptr_t schedule_token;
+    uint64_t ack_generation = qatomic_load_acquire(
+        &qemu_plugin_rr_control_ack_generation);
+    uint64_t complete_generation = qatomic_load_acquire(
+        &qemu_plugin_rr_control_complete_generation);
+    uint64_t request_generation = qatomic_load_acquire(
+        &qemu_plugin_rr_control_request_generation);
+
+    if (ack_generation != complete_generation) {
+        return;
+    }
+    if (request_generation == complete_generation) {
+        return;
+    }
+    schedule_token = qemu_plugin_schedule_control_boundary();
+    qatomic_store_release(&qemu_plugin_rr_control_ack_generation,
+                          request_generation);
+    qatomic_store_release(&qemu_plugin_rr_control_schedule_token,
+                          schedule_token);
+    rr_crucible_sim_trace_control_boundary(
+        "ack", request_generation, request_generation,
+        complete_generation, schedule_token);
+}
+
+void qemu_plugin_crucible_rr_control_boundary_cancel(void)
+{
+    uintptr_t schedule_token = qatomic_load_acquire(
+        &qemu_plugin_control_boundary_scheduled);
+    uintptr_t rr_schedule_token = qatomic_load_acquire(
+        &qemu_plugin_rr_control_schedule_token);
+    uint64_t request_generation = qatomic_load_acquire(
+        &qemu_plugin_rr_control_request_generation);
+    uint64_t complete_generation = qatomic_load_acquire(
+        &qemu_plugin_rr_control_complete_generation);
+
+    if (schedule_token != 0) {
+        qatomic_cmpxchg(&qemu_plugin_control_boundary_scheduled,
+                        schedule_token, 0);
+        qatomic_cmpxchg(&qemu_plugin_rr_control_schedule_token,
+                        schedule_token, 0);
+    }
+    qatomic_store_release(&qemu_plugin_rr_control_ack_generation,
+                          request_generation);
+    qatomic_store_release(&qemu_plugin_rr_control_complete_generation,
+                          request_generation);
+    if (request_generation != complete_generation) {
+        rr_crucible_sim_trace_control_boundary(
+            "cancel", request_generation, request_generation,
+            request_generation, rr_schedule_token);
+    }
+}
+
+static void qemu_plugin_request_rr_control_boundary(void)
+{
+    uint64_t acknowledged_generation = qatomic_load_acquire(
+        &qemu_plugin_rr_control_ack_generation);
+    uint64_t request_generation = qatomic_load_acquire(
+        &qemu_plugin_rr_control_request_generation);
+
+    /* Coalesce only while the RR thread has not claimed the prior request. */
+    if (request_generation != acknowledged_generation) {
+        return;
+    }
+    if (request_generation == UINT64_MAX) {
+        error_report("Crucible RR control request generation overflow");
+        abort();
+    }
+    qatomic_store_release(&qemu_plugin_rr_control_request_generation,
+                          request_generation + 1);
+    /*
+     * The durable request must wake a ceiling waiter even if the CPU kick
+     * coalesces with an already-pending RR wake-state transition.
+     */
+    rr_crucible_sim_notify_dispatch_ceiling();
+    rr_crucible_sim_trace_control_boundary(
+        "request", request_generation + 1, acknowledged_generation,
+        qatomic_load_acquire(&qemu_plugin_rr_control_complete_generation),
+        qatomic_load_acquire(&qemu_plugin_rr_control_schedule_token));
+    qemu_cpu_kick(first_cpu);
+}
+
+int qemu_plugin_request_control_boundary(void)
+{
+    if (!qemu_plugin_crucible_exact_boundary_active() || !current_cpu ||
+        icount_enabled() != ICOUNT_PRECISE ||
+        !qemu_plugin_crucible_single_threaded_rr()) {
+        return -EPERM;
+    }
+
+    qemu_plugin_schedule_control_boundary();
+    tcg_kick_vcpu_thread(current_cpu);
+    return 0;
+}
+
+int qemu_plugin_advance_time_ns(int64_t new_time)
+{
+    if (new_time < 0) {
+        return -EINVAL;
+    }
+    if (strcmp(current_accel_name(), "sim") != 0) {
+        return -EPERM;
+    }
+    if (!has_control || !qemu_plugin_time_advance_cb) {
+        return -ENODEV;
+    }
+    if (qatomic_cmpxchg(&qemu_plugin_time_advance_pending, 0,
+                        QEMU_PLUGIN_TIME_ADVANCE_RESERVED) != 0) {
+        return -EBUSY;
+    }
+    if (!first_cpu) {
+        qatomic_store_release(&qemu_plugin_time_advance_pending, 0);
+        return -ENODEV;
+    }
+
+    qatomic_set(&qemu_plugin_time_advance_target, new_time);
+    run_on_cpu(first_cpu, qemu_plugin_time_advance_arm_on_cpu,
+               RUN_ON_CPU_HOST_ULONG(0));
+    aio_bh_schedule_oneshot(qemu_get_aio_context(),
+                            qemu_plugin_advance_time_bh, NULL);
+    if (first_cpu) {
+        qemu_cpu_kick(first_cpu);
+    }
+    return 0;
+}
+
+uint64_t qemu_plugin_icount_raw(void)
+{
+    int64_t raw_icount;
+
+    if (!icount_enabled()) {
+        return 0;
+    }
+
+    /*
+     * Plugin callbacks can run while translated code has temporarily made
+     * I/O unsafe.  Observe the committed count plus the current CPU's local
+     * execution instead of forcing an icount commit from that context.
+     */
+    raw_icount = icount_get_raw_observed();
+    if (raw_icount < 0) {
+        return 0;
+    }
+    return (uint64_t)raw_icount;
+}
+
+uint64_t qemu_crucible_fault_observed_icount(void)
+{
+    int64_t observed;
+
+    if (!icount_enabled()) {
+        return 0;
+    }
+    observed = icount_get_raw_observed();
+    return observed < 0 ? 0 : observed;
+}
+
+int qemu_plugin_icount_at_tb_entry(uint64_t tb_insns,
+                                   uint64_t *entry_icount)
+{
+    int64_t observed_icount;
+
+    if (!entry_icount || tb_insns == 0 || !current_cpu ||
+        !current_cpu->running ||
+        icount_enabled() != ICOUNT_PRECISE ||
+        !qemu_plugin_crucible_single_threaded_rr()) {
+        return -1;
+    }
+
+    observed_icount = icount_get_raw_observed();
+    if (observed_icount < 0 || (uint64_t)observed_icount < tb_insns) {
+        return -1;
+    }
+    *entry_icount = (uint64_t)observed_icount - tb_insns;
+    return 0;
+}
+
+void qemu_plugin_force_vcpu_exit(void)
+{
+    if (current_cpu) {
+        qatomic_set_mb(&current_cpu->exit_request, 1);
+    }
+}
+
+int qemu_plugin_crucible_force_vcpu_tb_exit(void)
+{
+    if (!current_cpu || !current_cpu->running ||
+        icount_enabled() != ICOUNT_PRECISE ||
+        !qemu_plugin_crucible_single_threaded_rr()) {
+        return -EINVAL;
+    }
+
+    tcg_kick_vcpu_thread(current_cpu);
+    return 0;
+}
+
+static __thread unsigned int qemu_plugin_crucible_exact_boundary_depth;
+static __thread unsigned int qemu_plugin_crucible_control_boundary_depth;
+static __thread CPUState *qemu_plugin_crucible_idle_callback_cpu;
+static __thread unsigned int qemu_plugin_crucible_idle_callback_depth;
+static __thread CPUState *qemu_plugin_crucible_resume_callback_cpu;
+static __thread unsigned int qemu_plugin_crucible_resume_callback_depth;
+static __thread bool qemu_plugin_crucible_idle_wait_issued;
+static __thread QemuPluginCrucibleIdleCallbackDisposition
+    qemu_plugin_crucible_idle_callback_disposition;
+static int qemu_plugin_crucible_vmstop_state;
+static int qemu_plugin_crucible_vmstop_flush_result;
+
+enum {
+    QEMU_PLUGIN_CRUCIBLE_VMSTOP_IDLE,
+    QEMU_PLUGIN_CRUCIBLE_VMSTOP_ADMITTED,
+    QEMU_PLUGIN_CRUCIBLE_VMSTOP_STOPPED,
+    QEMU_PLUGIN_CRUCIBLE_VMSTOP_RESUME_PENDING,
+};
+
+static int qemu_plugin_crucible_vmstop_begin(void)
+{
+    if (icount_enabled() != ICOUNT_PRECISE ||
+        !qemu_plugin_crucible_single_threaded_rr()) {
+        return -EPERM;
+    }
+
+    qatomic_set(&qemu_plugin_crucible_vmstop_flush_result, 0);
+    if (qatomic_cmpxchg(&qemu_plugin_crucible_vmstop_state,
+                       QEMU_PLUGIN_CRUCIBLE_VMSTOP_IDLE,
+                       QEMU_PLUGIN_CRUCIBLE_VMSTOP_ADMITTED) !=
+        QEMU_PLUGIN_CRUCIBLE_VMSTOP_IDLE) {
+        return -EALREADY;
+    }
+
+    return 0;
+}
+
+int qemu_plugin_crucible_vmstop_admit_internal(void)
+{
+    int status = qemu_plugin_crucible_vmstop_begin();
+
+    if (status != 0) {
+        return status;
+    }
+
+    /*
+     * Always queue the runstate transition for the main loop.  Exact device
+     * completion callbacks may run without current_cpu even though they are
+     * inside the deterministic sim dispatch boundary; vm_stop() would perform
+     * a synchronous drain there and deadlock against the callback being
+     * completed.  The request pair is the asynchronous half of vm_stop(), and
+     * cpu_stop_current() preserves its vCPU-exit behavior when current_cpu is
+     * available.  QMP query-status remains the completion channel.
+     */
+    qemu_system_vmstop_request_prepare();
+    qemu_system_vmstop_request(RUN_STATE_PAUSED);
+    cpu_stop_current();
+    return 0;
+}
+
+static int qemu_plugin_crucible_vmstop_at_control_boundary(void)
+{
+    int status = qemu_plugin_crucible_vmstop_begin();
+
+    if (status != 0) {
+        return status;
+    }
+
+    /*
+     * A drained control wake runs directly from the main-loop event handler,
+     * outside every device coroutine.  Stop synchronously here so QEMU cannot
+     * dispatch another TCG slice between the plugin's exact publication and
+     * RUN_STATE_PAUSED.  Device-completion callbacks use the asynchronous path
+     * above because a synchronous block drain would recurse into their own
+     * in-flight coroutine.
+     */
+    status = vm_stop(RUN_STATE_PAUSED);
+    if (status != 0) {
+        qatomic_set(&qemu_plugin_crucible_vmstop_state,
+                    QEMU_PLUGIN_CRUCIBLE_VMSTOP_IDLE);
+    }
+    return status;
+}
+
+int qemu_plugin_request_vmstop(void)
+{
+    if (qemu_plugin_crucible_exact_boundary_depth == 0) {
+        return -EPERM;
+    }
+    if (qemu_plugin_crucible_control_boundary_depth > 0) {
+        return qemu_plugin_crucible_vmstop_at_control_boundary();
+    }
+    return qemu_plugin_crucible_vmstop_admit_internal();
+}
+
+void qemu_plugin_crucible_exact_boundary_enter(void)
+{
+    g_assert(qemu_plugin_crucible_exact_boundary_depth < UINT_MAX);
+    qemu_plugin_crucible_exact_boundary_depth++;
+}
+
+void qemu_plugin_crucible_exact_boundary_leave(void)
+{
+    g_assert(qemu_plugin_crucible_exact_boundary_depth > 0);
+    qemu_plugin_crucible_exact_boundary_depth--;
+}
+
+bool qemu_plugin_crucible_exact_boundary_active(void)
+{
+    return qemu_plugin_crucible_exact_boundary_depth > 0;
+}
+
+bool qemu_plugin_crucible_resume_callback_active(CPUState *cpu)
+{
+    return cpu && cpu == qemu_plugin_crucible_resume_callback_cpu &&
+        qemu_plugin_crucible_resume_callback_depth == 1 &&
+        qemu_plugin_crucible_exact_boundary_depth == 1 && bql_locked() &&
+        icount_enabled() == ICOUNT_PRECISE &&
+        qemu_plugin_crucible_single_threaded_rr() && cpu->created &&
+        !cpu->unplug && QTAILQ_IN_USE(cpu, node);
+}
+
+bool qemu_plugin_crucible_control_boundary_active(void)
+{
+    return qemu_plugin_crucible_control_boundary_depth > 0;
+}
+
+bool qemu_plugin_crucible_vmstop_pending(void)
+{
+    return qatomic_read(&qemu_plugin_crucible_vmstop_state) !=
+           QEMU_PLUGIN_CRUCIBLE_VMSTOP_IDLE;
+}
+
+bool qemu_plugin_crucible_vmstop_admission_pending(void)
+{
+    return qatomic_read(&qemu_plugin_crucible_vmstop_state) ==
+           QEMU_PLUGIN_CRUCIBLE_VMSTOP_ADMITTED;
+}
+
+bool qemu_plugin_crucible_vmstop_quiesced(void)
+{
+    return qatomic_read(&qemu_plugin_crucible_vmstop_state) ==
+               QEMU_PLUGIN_CRUCIBLE_VMSTOP_STOPPED &&
+           qatomic_read(&qemu_plugin_crucible_vmstop_flush_result) == 0;
+}
+
+void qemu_plugin_crucible_vmstop_request_stopped(int flush_status)
+{
+    if (qatomic_read(&qemu_plugin_crucible_vmstop_state) ==
+        QEMU_PLUGIN_CRUCIBLE_VMSTOP_ADMITTED) {
+        qatomic_set(&qemu_plugin_crucible_vmstop_flush_result, flush_status);
+        qatomic_cmpxchg(&qemu_plugin_crucible_vmstop_state,
+                        QEMU_PLUGIN_CRUCIBLE_VMSTOP_ADMITTED,
+                        QEMU_PLUGIN_CRUCIBLE_VMSTOP_STOPPED);
+    }
+}
+
+int qemu_plugin_crucible_vmstop_flush_status(void)
+{
+    if (qatomic_read(&qemu_plugin_crucible_vmstop_state) !=
+        QEMU_PLUGIN_CRUCIBLE_VMSTOP_STOPPED) {
+        return 0;
+    }
+    return qatomic_read(&qemu_plugin_crucible_vmstop_flush_result);
+}
+
+void qemu_plugin_crucible_vmstop_request_complete(void)
+{
+    if (qatomic_cmpxchg(&qemu_plugin_crucible_vmstop_state,
+                       QEMU_PLUGIN_CRUCIBLE_VMSTOP_STOPPED,
+                       QEMU_PLUGIN_CRUCIBLE_VMSTOP_RESUME_PENDING) ==
+        QEMU_PLUGIN_CRUCIBLE_VMSTOP_STOPPED) {
+        qatomic_set(&qemu_plugin_crucible_vmstop_flush_result, 0);
+    }
+}
+
+bool qemu_plugin_crucible_vmstop_resume_consume(void)
+{
+    return qatomic_cmpxchg(&qemu_plugin_crucible_vmstop_state,
+                           QEMU_PLUGIN_CRUCIBLE_VMSTOP_RESUME_PENDING,
+                           QEMU_PLUGIN_CRUCIBLE_VMSTOP_IDLE) ==
+           QEMU_PLUGIN_CRUCIBLE_VMSTOP_RESUME_PENDING;
+}
+
+int qemu_plugin_crucible_single_threaded_rr(void)
+{
+    return strcmp(current_accel_name(), "sim") == 0 &&
+           !qemu_tcg_mttcg_enabled();
+}
+
+static void qemu_plugin_unregister_wake_fd(int fd)
+{
+    aio_set_fd_handler(qemu_get_aio_context(), fd, NULL, NULL,
+                       NULL, NULL, NULL);
+    if (qemu_plugin_wake_fd == fd) {
+        qemu_plugin_wake_fd = -1;
+    }
+}
+
+bool qemu_plugin_crucible_wake_fd_readable(void)
+{
+    GPollFD wake_poll = {
+        .fd = qemu_plugin_wake_fd,
+        .events = G_IO_IN,
+    };
+    int poll_status;
+
+    if (wake_poll.fd < 0) {
+        return false;
+    }
+    do {
+        poll_status = qemu_poll_ns(&wake_poll, 1, 0);
+    } while (poll_status < 0 && errno == EINTR);
+    return poll_status > 0 && wake_poll.revents != 0;
+}
