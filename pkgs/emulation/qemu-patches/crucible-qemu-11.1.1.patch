+    if (memcmp(wire, QEMU_PLUGIN_CRUCIBLE_CONTROL_LAYOUT_MAGIC, 8) ||
+        ldl_be_p(wire + 8) != QEMU_PLUGIN_CRUCIBLE_CONTROL_LAYOUT_SCHEMA) {
+        return -EPROTONOSUPPORT;
+    }
+    if (ldl_be_p(wire + 12) != QEMU_PLUGIN_CRUCIBLE_CONTROL_LAYOUT_BYTES ||
+        ldl_be_p(wire + 20) != QEMU_PLUGIN_CRUCIBLE_CONTROL_LAYOUT_ROLE_COUNT) {
+        return -EINVAL;
+    }
+    decoded.artifact_machine = ldl_be_p(wire + 16);
+    if (!decoded.artifact_machine || decoded.artifact_machine > UINT16_MAX) {
+        return -EINVAL;
