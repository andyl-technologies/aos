+static bool capture_valid(uint64_t generation, uint64_t owner_token)
+{
+    return bql_locked() && !inventory_capture.active &&
+        capture_finish_return.phase == RAM_CAPTURE_FINISH_IDLE &&
+        (!logical_capture->active || logical_capture_versions_current()) &&
+        !candidate_capture.active && capture_active &&
+        owner_token == capture_owner_token &&
+        (owner_token ? diagnostic_capture_authorized(owner_token) :
+                       capture_authorized()) &&
+        generation == capture_generation &&
+        capture_topology_generation == qatomic_read(&topology_generation) &&
+        capture_dirty_generation == qatomic_read(&dirty_generation);
+}
