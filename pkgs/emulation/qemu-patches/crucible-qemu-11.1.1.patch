+        binary = output / name
+        c_file.write_text(before + "\n" + body + "\n" + CHECKS)
+        command = [os.environ.get("CC", "cc"), *shlex.split(os.environ.get("CFLAGS", "")),
+                   str(c_file), "-o", str(binary),
+                   *shlex.split(os.environ.get("LDFLAGS", ""))]
+        (output / (name + ".command.json")).write_text(json.dumps(command, indent=2) + "\n")
+        compiled = subprocess.run(command, text=True, stdout=subprocess.PIPE,
+                                  stderr=subprocess.STDOUT)
+        (output / (name + ".compile.log")).write_text(compiled.stdout)
+        compiled.check_returncode()
+        result = subprocess.run([str(binary)], text=True, stdout=subprocess.PIPE,
+                                stderr=subprocess.STDOUT, timeout=30)
+        (output / (name + ".log")).write_text(result.stdout)
+        expected = 0 if name == "positive" else -6
+        if result.returncode != expected:
+            raise RuntimeError(f"{name}: expected {expected}, got {result.returncode}")
+        proof[name] = {"returncode": result.returncode, "output": result.stdout}
+    (output / "proof.json").write_text(json.dumps(proof, indent=2) + "\n")
+    print(proof["positive"]["output"], end="")
+    print(f"PASS {len(controls) - 1} independently rebuilt omissions")
+
+
+if __name__ == "__main__":
+    main()
