+static int fingerprint_root_cleanup_cpu_end(void)
+{
+    struct QemuCrucibleFingerprintCleanupExecution *candidate = &fingerprint_cleanup;
+    int status = 0, returned;
+
+    if (!candidate->held) {
+        return 0;
+    }
+    if (fingerprint_root_operation || fingerprint_root_writer ||
+        logical_capture->source_claim || logical_capture->progress.borrowed ||
+        logical_capture->progress.published || ordinary_fingerprint.operation_borrowed) {
+        return -EBUSY;
+    }
+    status = qemu_crucible_startup_source_fingerprint_cleanup_return_current_v1(
+        candidate->id, candidate->operation, candidate);
+    if (status) {
+        return status;
+    }
+    if (candidate->cpu_closure) {
+        returned = qemu_crucible_observation_cleanup_cpu_identity_return_v1(
+            &candidate->cpu_closure);
+        candidate->closure_return_status = returned;
+        status = returned;
+        if (candidate->cpu_closure) {
+            return status ? status : -EBUSY;
+        }
+    }
+    if (fingerprint_root_execution) {
+        returned = qemu_crucible_observation_root_execution_identity_return_v1(
+            &fingerprint_root_execution);
+        fingerprint_root_outcome.execution_return_status = returned;
+        if (!status) {
+            status = returned;
+        }
+        if (fingerprint_root_execution) {
+            return status ? status : -EBUSY;
+        }
+    }
+    /* This cut is published ONLY after the actual byref physical returns.
+     * The Source borrower keeps the fixed native receipt alive through unbind. */
+    candidate->physically_returned = true;
+    if (candidate->source_execution) {
+        returned = qemu_crucible_startup_source_fingerprint_cleanup_unbind_v1(
+            candidate->operation, candidate, &candidate->source_execution);
+        candidate->source_unbind_status = returned;
+        if (!status) {
+            status = returned;
+        }
+        if (candidate->source_execution) {
+            return status ? status : -EBUSY;
+        }
+    }
+    candidate->held = false;
+    return status;
+}
