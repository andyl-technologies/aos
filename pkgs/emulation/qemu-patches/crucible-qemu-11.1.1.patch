+    g_assert_cmpint(qemu_crucible_hot_fork_merge_child_resource_contribution(
+                        resources, replacements,
+                        QEMU_CRUCIBLE_HOT_FORK_MAX_DESCRIPTOR_REPLACEMENTS - 4,
+                        retained_fds,
+                        QEMU_CRUCIBLE_HOT_FORK_MAX_DESCRIPTOR_REPLACEMENTS - 4,
+                        NULL, 0),
+                    ==, 0);
+    g_assert_cmpuint(resources->replacement_count, ==,
+                     QEMU_CRUCIBLE_HOT_FORK_MAX_DESCRIPTOR_REPLACEMENTS - 1);
+    g_assert_cmpuint(resources->retained_fd_count, ==,
+                     QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS);
+    replacements[0] = (QemuCrucibleHotForkDescriptorReplacement) {
+        .source_fd = 20000,
+        .target_fd = 20001,
+    };
+    retained_fds[0] = replacements[0].target_fd;
+    g_assert_cmpint(qemu_crucible_hot_fork_merge_child_resource_contribution(
+                        resources, replacements, 1,
+                        retained_fds, 1, NULL, 0),
+                    ==, -E2BIG);
+
+    qemu_crucible_hot_fork_reset_child_resource_plan(resources);
+    for (index = 0;
+         index < QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS;
+         index++) {
+        retained_fds[index] = 100 + index;
+    }
+    g_assert_cmpint(qemu_crucible_hot_fork_begin_child_resource_plan(
+                        resources, &plugin),
+                    ==, 0);
+    merge_fake_diagnostics(resources, 40, 41);
+    merge_fake_qmp(resources, 42, 43);
+    merge_fake_console(resources, 44, 45);
+    g_assert_cmpint(qemu_crucible_hot_fork_merge_child_resource_contribution(
+                        resources, NULL, 0, retained_fds,
+                        QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS - 6,
+                        NULL, 0),
+                    ==, 0);
+    g_assert_cmpuint(resources->retained_fd_count, ==,
