+CHECKS = r"""
+static unsigned fetch_cut(CPUState *cpu)
+{
+    void *last_tb = &only_cpu;
+    unsigned iterations = 0;
+
+    for (unsigned attempt = 0; attempt < 2; attempt++) {
+        iterations++;
+        FETCH_CUT
+        break;
+    }
+    assert((iterations == 2) == (last_tb == NULL));
+    return iterations;
+}
+
+static void skipped_cut(CPUState *cpu)
+{
+    SKIPPED_CUT
+}
+
+static void post_cut(CPUState *cpu)
+{
+    void *last_tb = &only_cpu;
+
+    POST_CUT
+    assert(last_tb == &only_cpu);
+}
+
+static void zero(void)
+{
+    only_cpu.crucible_memory_service_ticks = 0;
+    only_cpu.crucible_fetch_service_ticks = 0;
+    CPUState saved = only_cpu;
+
+    assert(fetch_cut(&only_cpu) == 1);
+    skipped_cut(&only_cpu);
+    post_cut(&only_cpu);
+    assert(!memcmp(&saved, &only_cpu, sizeof(saved)));
+    assert(virtual_tick == 0 && advances == 0);
+    assert(fetch_calls == 0 && memory_calls == 0);
+}
+
+static void fetch(void)
+{
+    crucible_memory_transaction.streaming = true;
+    crucible_memory_transaction.actor = only_cpu.cpu_index;
+    rule_linked = true;
+    stage_fetch(7);
+    assert(only_cpu.crucible_fetch_service_ticks == 7);
+    rule_linked = false;
+
+    assert(fetch_cut(&only_cpu) == 2);
+    assert(only_cpu.crucible_fetch_service_ticks == 0);
+    assert(virtual_tick == 7 && advances == 1 && !rule_linked);
+    assert(fetch_cut(&only_cpu) == 1);
+    assert(virtual_tick == 7 && advances == 1 && fetch_calls == 1);
+}
+
+static void ticket(void)
+{
+    setup();
+    only_cpu.crucible_memory_service_ticks = 0;
+    stage_memory(22, true);
+    assert(only_cpu.crucible_memory_service_ticks == 22);
+    assert(qemu_crucible_fault_cpu_memory_ticket_stage(
+        &only_cpu, QEMU_CRUCIBLE_MEMORY_CPU_STORE, 0x2345, 0x1234,
+        0x33, false, 0x9999, 4));
+    assert(only_cpu.crucible_memory_service_ticks == 0);
+    rule_linked = false;
+
+    assert(qemu_crucible_fault_cpu_memory_ticket_pending(&only_cpu));
+    skipped_cut(&only_cpu);
+    post_cut(&only_cpu);
+    now = 76;
+    node_cpu_memory_service_boundary(CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY, 100);
+    assert(current.active && !current.ready && writes == 0);
+    now = 77;
+    node_cpu_memory_service_boundary(CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY, 101);
+    assert(current.active && current.ready && writes == 1 && physical_byte == 0x33);
+    assert(qemu_crucible_fault_cpu_memory_ticket_replay_store(
+        &only_cpu, 0x2345, 0x9999, 4));
+    node_cpu_memory_service_boundary(CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY, 102);
+    assert(!current.active && writes == 1 && publishes == 1 && !rule_linked);
+    assert(memory_calls == 0);
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    if (!strcmp(argv[1], "zero")) {
+        zero();
+    } else if (!strcmp(argv[1], "fetch")) {
+        fetch();
+    } else if (!strcmp(argv[1], "ticket")) {
+        ticket();
+    } else if (!strcmp(argv[1], "skipped-debt")) {
+        stage_memory(1, true);
+        skipped_cut(&only_cpu);
+        assert(!"unclaimed skipped debt must abort");
+    } else if (!strcmp(argv[1], "post-debt")) {
+        stage_memory(1, true);
+        post_cut(&only_cpu);
+        assert(!"unclaimed post debt must abort");
+    } else if (!strcmp(argv[1], "fetch-overflow")) {
+        only_cpu.crucible_fetch_service_ticks = UINT64_MAX;
+        crucible_memory_transaction.streaming = true;
+        crucible_memory_transaction.actor = only_cpu.cpu_index;
+        stage_fetch(1);
+        assert(!"fetch staging overflow must abort");
+    } else if (!strcmp(argv[1], "memory-overflow")) {
+        only_cpu.crucible_memory_service_ticks = UINT64_MAX;
+        stage_memory(1, true);
+        assert(!"memory staging overflow must abort");
+    } else if (!strcmp(argv[1], "current-debt")) {
+        only_cpu.running = true;
+        only_cpu.neg.can_do_io = false;
+        stage_memory(1, false);
+        assert(only_cpu.exit_request && only_cpu.crucible_memory_service_ticks == 1);
+        post_cut(&only_cpu);
+        assert(!"unclaimed current CPU debt must abort");
+    } else if (!strcmp(argv[1], "current-overflow")) {
+        only_cpu.running = true;
+        only_cpu.neg.can_do_io = false;
+        only_cpu.crucible_memory_service_ticks = UINT64_MAX;
+        stage_memory(1, false);
+        assert(!"current CPU staging overflow must abort");
+    } else if (!strcmp(argv[1], "direct-delay")) {
+        only_cpu.running = false;
+        stage_memory(3, false);
+        assert(virtual_tick == 3 && advances == 1);
+        assert(only_cpu.crucible_memory_service_ticks == 0);
+    } else if (!strcmp(argv[1], "null")) {
+        assert(!qemu_crucible_fault_memory_fetch_service_apply(NULL));
+        assert(!qemu_crucible_fault_memory_service_apply(NULL));
+        assert(virtual_tick == 0 && advances == 0);
+    } else if (!strcmp(argv[1], "coordinate-overflow")) {
+        virtual_tick = UINT64_MAX;
+        only_cpu.crucible_fetch_service_ticks = 1;
+        fetch_cut(&only_cpu);
+        assert(!"virtual coordinate overflow must abort");
+    } else {
+        abort();
+    }
+    puts("PASS");
+    return 0;
+}
+"""
+
+
+def generate(root, output, negative=None):
+    fixture = load_ticket_fixture(root)
+    source = (root / "plugins/crucible-fault-node.c").read_text()
+    cpu_source = (root / "accel/tcg/cpu-exec.c").read_text()
+    header = (root / "include/qemu/crucible-fault.h").read_text()
+    fetch, skipped, post = source_cuts(cpu_source, fixture)
+    definitions = [fixture.function(source, name) for name in fixture.FUNCTIONS]
+    for name in ["node_memory_apply_service",
+                 "qemu_crucible_fault_memory_fetch_service_apply",
+                 "qemu_crucible_fault_memory_service_apply"]:
+        definitions.append(fixture.function(source, name))
+    if negative == "force-fetch-call":
+        fetch = fetch.replace("cpu->crucible_fetch_service_ticks &&", "")
+    elif negative == "omit-fetch":
+        fetch = fetch.replace("cpu->crucible_fetch_service_ticks &&", "false &&")
+    elif negative == "omit-memory":
+        skipped = skipped.replace("qemu_crucible_fault_memory_service_apply(cpu);", "(void)cpu;")
+        post = post.replace("qemu_crucible_fault_memory_service_apply(cpu)", "false")
+    declarations = "\n".join((
+        fixture.constant(source, "CRUCIBLE_CPU_MEMORY_REPLAY_ACCESS"),
+        fixture.constant(source, "CRUCIBLE_CPU_MEMORY_REPLAY_LOAD"),
+        fixture.constant(source, "CRUCIBLE_CPU_MEMORY_REPLAY_STORE"),
+        fixture.constant(header, "QEMU_CRUCIBLE_DEFERRED_SERVICE_EVIDENCE_SIZE"),
+        fixture.definition(header, header.index("enum QemuCrucibleMemoryAccessClass {")) + ";",
+        fixture.typedef(header, "QemuCrucibleDeferredMemoryService"),
+        fixture.typedef(source, "CrucibleCpuMemoryTicket"),
+    ))
+    prelude = (fixture.PRELUDE + '\n#include "aos/crucible/crucible_shmem_abi.h"\n').replace(
+        "    uint64_t crucible_memory_service_ticks;",
+        "    uint64_t crucible_memory_service_ticks;\n"
+        "    uint64_t crucible_fetch_service_ticks;\n"
+        "    bool running, exit_request;\n"
+        "    struct { bool can_do_io; } neg;",
+    )
+    writer_fetch = fixture.definition(
+        source, source.index("    if (crucible_memory_transaction.streaming) {",
+                             source.index("static uint64_t node_memory_service_finish_transaction")),
+    )
+    writer_memory = fixture.definition(
+        source, source.index("    if (service_delay != 0 && deferred_cpu_service) {"),
+    )
+    end = source.index("    } else if (service_delay != 0 && current_cpu", source.index(writer_memory))
+    writer_memory += source[end + 5:source.index("\n}", end)]
+    writers = ("static void stage_fetch(uint64_t completion_delay)\n{\n" +
+               writer_fetch + "\n}\n\n" +
+               "static void stage_memory(uint64_t service_delay, bool deferred_cpu_service)\n{\n"
+               "    CPUState *service_cpu = &only_cpu;\n\n" + writer_memory + "\n}\n")
+    checks = CHECKS.replace("FETCH_CUT", fetch).replace("SKIPPED_CUT", skipped).replace("POST_CUT", post)
+    setup = fixture.definition(fixture.CHECKS, fixture.CHECKS.index("static void setup(void)"))
+    prototypes = "\n".join(body[:body.index("{")].strip() + ";" for body in definitions)
+    # Only the test preprocesses function names to count entry; bodies are literal.
+    renames = "\n#define qemu_crucible_fault_memory_fetch_service_apply production_fetch_apply\n" + \
+              "#define qemu_crucible_fault_memory_service_apply production_memory_apply\n"
+    wrappers = r"""
+#undef qemu_crucible_fault_memory_fetch_service_apply
+#undef qemu_crucible_fault_memory_service_apply
+
+static bool qemu_crucible_fault_memory_fetch_service_apply(CPUState *cpu)
+{
+    fetch_calls++;
+    return production_fetch_apply(cpu);
+}
+
+static bool qemu_crucible_fault_memory_service_apply(CPUState *cpu)
+{
+    memory_calls++;
+    return production_memory_apply(cpu);
+}
+"""
+    generated = (prelude + declarations + fixture.PROVIDERS + SUPPORT + renames +
+                 prototypes + "\n" + "\n\n".join(definitions) + wrappers +
+                 writers + "\n" + setup + "\n" + checks)
+    output.mkdir(parents=True, exist_ok=True)
+    (output / "cpu-service-debt.c").write_text(generated)
+    for name, body in [("fetch-cut", fetch), ("skipped-cut", skipped), ("post-cut", post), ("fetch-writer", writer_fetch), ("memory-writer", writer_memory)]:
+        (output / (name + ".txt")).write_text(body + "\n")
+    return generated
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--source-root", type=Path, default=ROOT)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--generate-only", action="store_true")
+    parser.add_argument("--negative-control", choices=["force-fetch-call", "omit-fetch", "omit-memory"])
+    args = parser.parse_args()
+    generate(args.source_root, args.output_dir, args.negative_control)
+    if args.generate_only:
+        return
+    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
+    binary = args.output_dir / "cpu-service-debt"
+    command = shlex.split(os.environ.get("CC", "cc")) + shlex.split(os.environ.get("CFLAGS", ""))
+    command += [str(args.output_dir / "cpu-service-debt.c"), "-o", str(binary)]
+    command += shlex.split(os.environ.get("LDFLAGS", ""))
+    (args.output_dir / "compile-command.json").write_text(json.dumps(command, indent=2) + "\n")
+    subprocess.run(command, check=True)
+    cases = {"zero": None, "fetch": None, "ticket": None,
+             "skipped-debt": "Unclaimed Crucible CPU memory service delay",
+             "post-debt": "Unclaimed Crucible CPU memory service delay",
+             "fetch-overflow": "Crucible fetch service staging overflow",
+             "memory-overflow": "Crucible CPU memory service staging overflow",
+             "current-debt": "Unclaimed Crucible CPU memory service delay",
+             "current-overflow": "Crucible memory service staging overflow",
+             "direct-delay": None, "null": None,
+             "coordinate-overflow": "Crucible memory service coordinate overflow"}
+    witnesses = {"force-fetch-call": "zero", "omit-fetch": "fetch", "omit-memory": "post-debt"}
+    if args.negative_control:
+        cases = {witnesses[args.negative_control]: None}
+    for name, refusal in cases.items():
+        result = subprocess.run([str(binary), name], capture_output=True, timeout=10)
+        (args.output_dir / (name + ".stdout")).write_bytes(result.stdout)
+        (args.output_dir / (name + ".stderr")).write_bytes(result.stderr)
+        if args.negative_control:
+            assert result.returncode == -signal.SIGABRT, name
+            assert b"Assertion" in result.stderr, name
+            assert b"Unclaimed Crucible" not in result.stderr, name
+        elif refusal is None:
+            assert result.returncode == 0 and result.stdout == b"PASS\n", name
+        else:
+            assert result.returncode == -signal.SIGABRT and refusal.encode() in result.stderr, name
+    print("PASS twelve actual-body CPU service-debt controls")
+
+
+if __name__ == "__main__":
+    main()
