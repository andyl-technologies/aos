+static void test_build_poison_with_occurrence(const char *policy,
+                                              const char *occurrence)
+{
+    uint8_t no_device[32] = { 0 };
+    uint8_t zero = 0;
+
+    test_payload_begin(CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM, 16);
+    test_field_u64(CRUCIBLE_NODE_FAULT_FIELD_P1, test_address);
+    test_field_u64(CRUCIBLE_NODE_FAULT_FIELD_P2, test_length);
+    test_field_u32(CRUCIBLE_NODE_FAULT_FIELD_P3, 5);
+    test_field(CRUCIBLE_NODE_FAULT_FIELD_P4,
+               CRUCIBLE_NODE_FAULT_FIELD_TYPE_BYTES, &zero, 1);
+    test_field_bool(CRUCIBLE_NODE_FAULT_FIELD_P5, true);
+    test_field_policy(CRUCIBLE_NODE_FAULT_FIELD_P6, policy);
+    test_field_policy(CRUCIBLE_NODE_FAULT_FIELD_P7, occurrence);
+    test_field_u32(CRUCIBLE_NODE_FAULT_FIELD_P8, test_classes);
+    test_field_bool(CRUCIBLE_NODE_FAULT_FIELD_P9, false);
+    test_field_bool(10, false);
+    test_field(11,
+               CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH,
+               no_device, sizeof(no_device));
+    test_payload_target(test_address, test_length, false);
+}
