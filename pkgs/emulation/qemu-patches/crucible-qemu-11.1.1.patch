+         "static int advance_receiver_drop_read(", "!pending_constructor_closed()"),
+        ("terminal", "plugins/crucible-advance-receiver.inc.h",
+         "static int advance_receiver_observe_no_birth_terminal(", "!pending_constructor_no_birth()"),
+        ("no-birth", "plugins/crucible-advance-receiver.inc.h",
+         "int qemu_crucible_source_advance_no_birth_current_v1(", "!pending_constructor_no_birth()"),
+        ("tail", "plugins/crucible-advance-receiver.inc.h",
+         "int qemu_crucible_source_advance_handoff_v1(", "pending_constructor_no_birth()"),
+        ("receive", "plugins/crucible-advance-receiver.inc.h",
