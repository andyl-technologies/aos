+    qemu_plugin_control_boundary_complete_bh((void *)stale);
+    g_assert_cmpuint(qemu_plugin_control_boundary_scheduled, ==, replacement);
+    g_assert_cmpuint(block_holds, ==, 0);
+    service_events();
+    g_assert_cmpuint(control_calls, ==, 1);
+    g_assert_cmpuint(block_holds, ==, 1);
+    cleanup();
+}
+
+static void test_cancel_before_continuation(void)
+{
+    setup(false);
+    wake(1);
+    begin();
+    crucible_hot_fork_template_complete(CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_ABORTED);
+    service_events();
+    g_assert_cmpuint(block_holds, ==, 0);
+    g_assert_cmpuint(control_calls, ==, 0);
+    cleanup();
+}
+
+static void test_connection_reconnect(void)
+{
+    setup(false);
+    begin();
+    qemu_mutex_lock(&test_monitor.parent_obj.mon_lock);
+    monitor_qmp_connection_changed_locked(&test_monitor, false);
+    monitor_qmp_connection_changed_locked(&test_monitor, true);
+    qemu_mutex_unlock(&test_monitor.parent_obj.mon_lock);
+    service_events();
+    g_assert_cmpuint(block_holds, ==, 0);
+    g_assert_cmpint(crucible_hot_fork_template_completion, ==,
+                    CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_ABORTED);
+    cleanup();
+}
+
+static void test_exact_picosecond_coordinate(void)
+{
+    setup(false);
+    begin();
+    virtual_ps += 50;
+    g_assert_cmpint(virtual_ps / 1000, ==, original_ps / 1000);
+    g_assert_cmpint(raw_icount, ==, original_raw);
+    service_events();
+    g_assert_cmpuint(block_holds, ==, 0);
+    cleanup();
+}
+
+static void test_descriptor_failures(void)
+{
+    Error *error = NULL;
+
+    setup(false);
+    qemu_plugin_unregister_wake_fd(test_fd);
+    g_assert_false(qemu_plugin_crucible_control_drain_settled());
+    g_assert_false(crucible_hot_fork_template_control_begin(&error));
+    g_assert_nonnull(error);
+    error_free(error);
+    cleanup();
+
+    setup(false);
+    begin();
+    close(test_fd);
+    test_fd_closed = true;
+    g_assert_cmpint(qemu_plugin_control_drain_wake_state(), ==, -EBADF);
+    service_events();
+    g_assert_cmpuint(block_holds, ==, 0);
+    cleanup();
+
+    setup(false);
+    begin();
+    poll_failure = EIO;
+    g_assert_false(qemu_plugin_crucible_control_drain_settled());
+    service_events();
+    g_assert_cmpuint(block_holds, ==, 0);
+    poll_failure = 0;
+    cleanup();
+}
+
+static void test_original_scope_and_generation(void)
+{
+    Error *error = NULL;
+
+    setup(false);
+    current_monitor = NULL;
+    g_assert_false(crucible_hot_fork_template_control_begin(&error));
+    g_assert_nonnull(error);
+    error_free(error);
+    current_monitor = &test_monitor.parent_obj;
+    begin();
+    runstate_generation++;
+    service_events();
+    g_assert_cmpuint(block_holds, ==, 0);
+    cleanup();
+}
+
+int main(void)
+{
+#define RUN_CHECK(check) do { check(); printf("PASS %s\n", #check); } while (0)
+    RUN_CHECK(test_unread_and_coalesced);
+    RUN_CHECK(test_new_wake_after_initial_check);
+    RUN_CHECK(test_nested_callback_wake);
+    RUN_CHECK(test_empty_sync_stop);
+    RUN_CHECK(test_async_flush_completion);
+    RUN_CHECK(test_stale_inflight_schedule);
+    RUN_CHECK(test_cancel_before_continuation);
+    RUN_CHECK(test_connection_reconnect);
+    RUN_CHECK(test_exact_picosecond_coordinate);
+    RUN_CHECK(test_descriptor_failures);
+    RUN_CHECK(test_original_scope_and_generation);
+#undef RUN_CHECK
+    g_ptr_array_free(allocated_bhs, true);
+    puts("PASS production template control drain: original FD, callback return, "
+         "connection lifetime, exact coordinate, failure refusal");
+    return 0;
+}
+"""
+
+
+def source_bodies(path, signatures):
+    source = (ROOT / path).read_text()
+    return "\n\n".join(definition(source, signature) for signature in signatures)
+
+
+def fixture_source(production_sources):
+    prelude = BASE["fixture_prelude"]()
+    for signature in ["QEMUBH *qemu_bh_new_full(",
+                      "void qemu_bh_schedule("]:
+        prelude = prelude.replace(definition(prelude, signature), "")
+    prelude = prelude.replace("void *opaque; };", "void *opaque; bool pending, deleted; };")
+    prelude = prelude.replace("(QEMUBH){cb, opaque}",
+                             "(QEMUBH){.callback = cb, .opaque = opaque}")
+    prelude = prelude.replace("(QEMUBH){timer_device_bh, NULL}",
+                             "(QEMUBH){.callback = timer_device_bh}")
+    prelude = prelude.replace("int bdrv_flush_all(void) { flushes++; return 0; }",
+        "static void (*flush_hook)(void);\n"
+        "int bdrv_flush_all(void)\n{\n"
+        "    flushes++;\n"
+        "    if (flush_hook) {\n"
+        "        void (*hook)(void) = flush_hook;\n"
+        "        flush_hook = NULL;\n"
+        "        hook();\n"
+        "    }\n"
+        "    return 0;\n}")
+    extra = SUPPORT["EXTRA"]
+    for signature in ["static int qemu_plugin_control_drain_wake_state("]:
+        extra = extra.replace(definition(extra, signature), "")
+    helper = definition((ROOT / "accel/tcg/tcg-accel-ops-rr.h").read_text(),
+                        "static inline bool rr_crucible_sim_control_boundary_needs_rearm(")
+    prelude = prelude.replace(definition(prelude,
+        "static bool rr_crucible_sim_control_boundary_needs_rearm("), helper)
+
+    native = source_bodies("plugins/api-system.c", [
+        "static int qemu_plugin_control_drain_wake_state(void)\n{",
+    ]) + "\n\n" + SUPPORT["production_bodies"](production_sources)
+    native += "\n\n" + source_bodies("plugins/api-system.c", [
+        "int qemu_plugin_register_wake_fd(int fd)",
+        "int qemu_plugin_crucible_control_drain_watch(",
+        "void qemu_plugin_crucible_control_drain_unwatch(",
+        "int qemu_plugin_crucible_control_drain_service(",
+    ])
+    monitor = source_bodies("monitor/qmp.c", [
+        "static void monitor_qmp_connection_changed_locked(",
+        "Monitor *monitor_qmp_connection_watch_current(",
+        "bool monitor_qmp_connection_watch_valid(",
+        "void monitor_qmp_connection_unwatch(",
+        "bool monitor_qmp_connection_watch_complete(",
+    ])
+    template = (ROOT / "monitor/qmp-cmds.c").read_text()
+    declarations = template[template.index("typedef enum CrucibleHotForkTemplatePhase {"):
+                            template.index("typedef struct CrucibleHotForkGraphReceiptStamp {")]
+    declarations += "static void crucible_hot_fork_template_block_transition(void *opaque);\n"
+    template = source_bodies("monitor/qmp-cmds.c", [
+        "static void crucible_hot_fork_template_complete(",
+        "static void crucible_hot_fork_template_record_failure(",
+        "static void crucible_hot_fork_template_schedule_block_transition(void)\n{",
+        "static void crucible_hot_fork_template_control_release(void)\n{",
+        "static void crucible_hot_fork_template_control_notify(",
+        "static bool crucible_hot_fork_template_control_scope_valid(void)",
+        "static void crucible_hot_fork_template_control_failure(",
+        "static void crucible_hot_fork_template_control_transition(",
+        "static bool crucible_hot_fork_template_control_begin(",
+    ])
+    support_checks = SUPPORT["CHECKS"].split("int main(")[0]
+    support_tests = BASE["TESTS"].split("int main(")[0]
+    return "\n\n".join([prelude, extra, EXTRA, native,
+                          declarations, monitor, template, support_tests,
+                          support_checks, CHECKS])
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--negative-control", choices=["callback-return"])
+    arguments = parser.parse_args()
+    production_sources = SUPPORT["validated_sources"]()
+    arguments.output_dir.mkdir(parents=True, exist_ok=True)
+    source = fixture_source(production_sources)
+    if arguments.negative_control == "callback-return":
+        body = definition(source,
+                          "static void qemu_plugin_control_boundary_complete_bh(void *opaque)\n{")
+        changed = body.replace("    qemu_plugin_control_drain_notify();\n", "")
+        assert changed != body
+        source = source.replace(body, changed)
+    generated = arguments.output_dir / "template-control-drain.c"
+    generated.write_text(source)
+    binary = arguments.output_dir / "template-control-drain"
+    command = [os.environ.get("CC", "cc"),
+               *shlex.split(os.environ.get("CFLAGS", "")),
+               "-Wno-missing-prototypes", "-Wno-unused-function",
+               "-Wno-unused-variable", str(generated),
+               *BASE["SUPPORT"]["utility_sources"](), "-o", str(binary),
+               *shlex.split(os.environ.get("LDFLAGS", ""))]
+    (arguments.output_dir / "compile-command.json").write_text(
+        json.dumps(command, indent=2) + "\n")
+    subprocess.run(command, check=True)
+    subprocess.run([str(binary)], check=True)
+
+
+if __name__ == "__main__":
+    main()
