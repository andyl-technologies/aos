+# Copyright (c) Andyl, Inc.
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Check that icount migration preserves its configured clock model."""
+
+import argparse
+import json
+import os
+import socket
+import struct
+import subprocess
+import tempfile
+import time
+
+
+TIMEOUT_SECONDS = 10
+CASES = (
+    ("fixed-matching", "shift=1,sleep=off,align=off",
+     "shift=1,sleep=off,align=off", None),
+    ("fixed-zero-matching", "shift=0,sleep=off,align=off",
+     "shift=0,sleep=off,align=off", None),
+    ("fixed-mismatch-up", "shift=0,sleep=off,align=off",
+     "shift=1,sleep=off,align=off",
+     "icount migration fixed shift mismatch: source 0, target 1"),
+    ("fixed-mismatch-down", "shift=1,sleep=off,align=off",
+     "shift=0,sleep=off,align=off",
+     "icount migration fixed shift mismatch: source 1, target 0"),
+    ("adaptive-matching", "shift=auto,sleep=on,align=off",
+     "shift=auto,sleep=on,align=off", None),
+    ("adaptive-to-fixed", "shift=auto,sleep=on,align=off",
+     "shift=1,sleep=off,align=off", "icount migration clock model mismatch"),
+)
+
+
+def stop_qemu(process):
+    if process.poll() is None:
+        process.terminate()
+    try:
+        process.wait(timeout=TIMEOUT_SECONDS)
+    except subprocess.TimeoutExpired:
+        process.kill()
+        process.wait(timeout=TIMEOUT_SECONDS)
+    return process.stderr.read().decode(errors="replace")
+
+
+def connect_qmp(path, process):
+    deadline = time.monotonic() + TIMEOUT_SECONDS
+    while time.monotonic() < deadline:
+        if process.poll() is not None:
+            raise RuntimeError("QEMU exited before QMP became available")
+        try:
+            connection = socket.socket(socket.AF_UNIX)
+            connection.settimeout(TIMEOUT_SECONDS)
+            connection.connect(path)
+            stream = connection.makefile("rwb", buffering=0)
+            greeting = json.loads(stream.readline())
+            if "QMP" not in greeting:
+                raise RuntimeError(f"Unexpected QMP greeting: {greeting}")
+            return connection, stream
+        except (FileNotFoundError, ConnectionRefusedError,
+                ConnectionResetError, json.JSONDecodeError):
+            connection.close()
+            time.sleep(0.02)
+    raise RuntimeError("QMP connection timed out")
+
+
+def qmp_call(stream, command, arguments=None):
+    request = {"execute": command}
+    if arguments is not None:
+        request["arguments"] = arguments
+    stream.write(json.dumps(request).encode() + b"\n")
+    while True:
+        line = stream.readline()
+        if not line:
+            raise EOFError("QMP connection closed")
+        response = json.loads(line)
+        if "event" not in response:
+            if "error" in response:
+                raise RuntimeError(f"{command} failed: {response['error']}")
+            return response["return"]
+
+
+def wait_for_migration(stream, process):
+    deadline = time.monotonic() + TIMEOUT_SECONDS
+    while time.monotonic() < deadline:
+        if process.poll() is not None:
+            return "exited"
+        try:
+            status = qmp_call(stream, "query-migrate")["status"]
+        except (BrokenPipeError, EOFError, OSError):
+            return "exited"
+        if status in ("completed", "failed", "cancelled"):
+            return status
+        time.sleep(0.02)
+    raise RuntimeError("migration did not reach a terminal state")
+
+
+def start_qemu(qemu, options, qmp_socket, incoming=None, machine="none"):
+    command = [
+        qemu, "-machine", machine, "-accel", "tcg", "-m", "64M",
+        "-nodefaults", "-display", "none", "-S", "-icount", options,
+        "-qmp", f"unix:{qmp_socket},server=on,wait=off",
+    ]
+    if incoming is not None:
+        command.extend(("-incoming", f"file:{incoming}"))
+    return subprocess.Popen(
+        command, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
+    )
+
+
+def adaptive_virtual_timer(snapshot):
+    name = b"timer/icount/timers"
+    marker = bytes((5, len(name))) + name
+    with open(snapshot, "rb") as stream:
+        data = stream.read()
+    if data.count(marker) != 1:
+        raise AssertionError("expected one adaptive timer subsection")
+
+    offset = data.index(marker) + len(marker)
+    version = struct.unpack_from(">I", data, offset)[0]
+    if version != 2:
+        raise AssertionError(f"expected exact adaptive timer v2, got {version}")
+
+    # The first field is the realtime timer's eight-byte ns deadline.
+    active, expiry_ns, phase_ps = struct.unpack_from(">BqH", data, offset + 12)
+    if active != 1 or phase_ps >= 1000:
+        raise AssertionError("invalid active adaptive virtual timer")
+    return expiry_ns, phase_ps
+
+
+def with_adaptive_timer_phase(source, destination, phase_ps):
+    """Stages a valid subnanosecond deadline in an armed VMState timer."""
+    name = b"timer/icount/timers"
+    marker = bytes((5, len(name))) + name
+    with open(source, "rb") as stream:
+        data = bytearray(stream.read())
+    if data.count(marker) != 1 or not 0 < phase_ps < 1000:
+        raise AssertionError("invalid adaptive timer phase fixture")
+
+    offset = data.index(marker) + len(marker)
+    if struct.unpack_from(">I", data, offset)[0] != 2:
+        raise AssertionError("expected exact adaptive timer v2")
+    timer_offset = offset + 4 + 8
+    if data[timer_offset] != 1:
+        raise AssertionError("adaptive virtual timer is not armed")
+
+    # Preserve the actual ns deadline and encode only its VMState ps phase.
+    struct.pack_into(">H", data, timer_offset + 1 + 8, phase_ps)
+    with open(destination, "wb") as stream:
+        stream.write(data)
+
+
+def check_public_shift_model(snapshot):
+    name = b"timer/icount/model"
+    marker = bytes((5, len(name))) + name
+    with open(snapshot, "rb") as stream:
+        data = stream.read()
+    if data.count(marker) != 1:
+        raise AssertionError("expected one icount clock model subsection")
+
+    offset = data.index(marker) + len(marker)
+    version = struct.unpack_from(">I", data, offset)[0]
+    if version != 2:
+        raise AssertionError(
+            f"expected public nanosecond shift clock model v2, got {version}"
+        )
+
+
+def reorder_timer_before_model(source, destination):
+    with open(source, "rb") as stream:
+        data = stream.read()
+
+    model_name = b"timer/icount/model"
+    timer_name = b"timer/icount/timers"
+    model_marker = bytes((5, len(model_name))) + model_name
+    timer_marker = bytes((5, len(timer_name))) + timer_name
+    if data.count(model_marker) != 1 or data.count(timer_marker) != 1:
+        raise AssertionError("expected one of each icount subsection")
+
+    model_start = data.index(model_marker)
+    timer_start = data.index(timer_marker)
+    timer_end = timer_start + len(timer_marker) + 4 + 8 + 11
+    if model_start >= timer_start:
+        raise AssertionError("source icount subsections are out of order")
+
+    reordered = (data[:model_start] + data[timer_start:timer_end]
+                 + data[model_start:timer_start] + data[timer_end:])
+    with open(destination, "wb") as stream:
+        stream.write(reordered)
+
+
+def run_adaptive_phase_case(qemu):
+    options = "shift=auto,sleep=on,align=off"
+    with tempfile.TemporaryDirectory(prefix="crucible-icount-phase-") as root:
+        source_socket = os.path.join(root, "source.sock")
+        target_socket = os.path.join(root, "target.sock")
+        snapshot = os.path.join(root, "source.bin")
+        fractional_snapshot = os.path.join(root, "fractional.bin")
+        restored = os.path.join(root, "restored.bin")
+        reordered = os.path.join(root, "reordered.bin")
+
+        source = start_qemu(qemu, options, source_socket, machine="pc")
+        try:
+            connection, stream = connect_qmp(source_socket, source)
+            try:
+                qmp_call(stream, "qmp_capabilities")
+                qmp_call(stream, "cont")
+                time.sleep(1)
+                qmp_call(stream, "stop")
+                qmp_call(stream, "migrate", {"uri": f"file:{snapshot}"})
+                source_status = wait_for_migration(stream, source)
+            finally:
+                stream.close()
+                connection.close()
+        finally:
+            source_stderr = stop_qemu(source)
+        if source_status != "completed":
+            raise AssertionError(f"adaptive source {source_status}: {source_stderr}")
+
+        check_public_shift_model(snapshot)
+        with_adaptive_timer_phase(snapshot, fractional_snapshot, 375)
+        source_deadline = adaptive_virtual_timer(fractional_snapshot)
+        if source_deadline[1] != 375:
+            raise AssertionError("fractional adaptive timer fixture changed")
+
+        target = start_qemu(qemu, options, target_socket, fractional_snapshot,
+                            machine="pc")
+        try:
+            connection, stream = connect_qmp(target_socket, target)
+            try:
+                qmp_call(stream, "qmp_capabilities")
+                target_status = wait_for_migration(stream, target)
+                if target_status == "completed":
+                    qmp_call(stream, "migrate", {"uri": f"file:{restored}"})
+                    target_status = wait_for_migration(stream, target)
+            finally:
+                stream.close()
+                connection.close()
+        finally:
+            target_stderr = stop_qemu(target)
+        if target_status != "completed":
+            raise AssertionError(f"adaptive target {target_status}: {target_stderr}")
+        if adaptive_virtual_timer(restored) != source_deadline:
+            raise AssertionError("adaptive virtual timer lost ps phase on restore")
+        print("CRUCIBLE_ICOUNT_MIGRATION_PASS case=adaptive-nonzero-phase",
+              flush=True)
+
+        reorder_timer_before_model(fractional_snapshot, reordered)
+        reordered_target = start_qemu(qemu, options,
+                                      os.path.join(root, "reordered.sock"),
+                                      reordered, machine="pc")
+        try:
+            reordered_target.wait(timeout=TIMEOUT_SECONDS)
+        finally:
+            reordered_stderr = stop_qemu(reordered_target)
+        if "icount migration timer state precedes clock model" not in reordered_stderr:
+            raise AssertionError(
+                f"reordered timer state was not rejected: {reordered_stderr}"
+            )
+        print("CRUCIBLE_ICOUNT_MIGRATION_PASS case=reordered-timer-rejected",
+              flush=True)
+
+
+def run_case(qemu, name, source_options, target_options, rejection):
+    with tempfile.TemporaryDirectory(prefix="crucible-icount-migration-") as root:
+        source_socket = os.path.join(root, "source.sock")
+        target_socket = os.path.join(root, "target.sock")
+        snapshot = os.path.join(root, "state.bin")
+        source = start_qemu(qemu, source_options, source_socket)
+        try:
+            connection, stream = connect_qmp(source_socket, source)
+            try:
+                qmp_call(stream, "qmp_capabilities")
+                qmp_call(stream, "migrate", {"uri": f"file:{snapshot}"})
+                source_status = wait_for_migration(stream, source)
+            finally:
+                stream.close()
+                connection.close()
+        finally:
+            source_stderr = stop_qemu(source)
+        if source_status != "completed":
+            raise AssertionError(
+                f"{name}: source migration {source_status}: {source_stderr}"
+            )
+
+        check_public_shift_model(snapshot)
+
+        target = start_qemu(qemu, target_options, target_socket, snapshot)
+        try:
+            try:
+                connection, stream = connect_qmp(target_socket, target)
+            except RuntimeError:
+                target_status = "exited"
+            else:
+                try:
+                    try:
+                        qmp_call(stream, "qmp_capabilities")
+                        target_status = wait_for_migration(stream, target)
+                    except (BrokenPipeError, EOFError, OSError):
+                        target_status = "exited"
+                finally:
+                    stream.close()
+                    connection.close()
+        finally:
+            target_stderr = stop_qemu(target)
+
+        if rejection is None:
+            if target_status != "completed":
+                raise AssertionError(
+                    f"{name}: expected complete, got {target_status}: "
+                    f"{target_stderr}"
+                )
+        elif target_status == "completed" or rejection not in target_stderr:
+            raise AssertionError(
+                f"{name}: expected {rejection!r}, got {target_status}: "
+                f"{target_stderr}"
+            )
+        print(f"CRUCIBLE_ICOUNT_MIGRATION_PASS case={name}", flush=True)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--qemu", required=True)
+    args = parser.parse_args()
+    for case in CASES:
+        run_case(args.qemu, *case)
+    run_adaptive_phase_case(args.qemu)
+
+
+if __name__ == "__main__":
+    main()
