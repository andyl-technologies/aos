+{
+    int status;
+
+    pthread_mutex_lock(&native_allocations.lock);
+    status = object_native_cpu_tlb_request_identity_locked(request);
+    if (!status && (!account || request->account)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        request->account = account;
+    }
+    pthread_mutex_unlock(&native_allocations.lock);
+    return status;
+}
+
+int object_native_cpu_tlb_request_storage_bind(
+    QemuCrucibleCpuTlbStorageRequest *request, QemuCrucibleCpuTlbStorage *storage)
+{
+    int status;
+
+    pthread_mutex_lock(&native_allocations.lock);
+    status = object_native_cpu_tlb_request_identity_locked(request);
+    if (!status && (!request->account || !storage || request->storage)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        request->storage = storage;
+    }
+    pthread_mutex_unlock(&native_allocations.lock);
+    return status;
+}
+
+int object_native_cpu_tlb_request_storage_identity(
+    QemuCrucibleCpuTlbStorageRequest *request, Object **parent,
+    QemuCrucibleCpuMetadataAccount **account, QemuCrucibleCpuTlbStorage **storage)
+{
+    int status;
+
+    if (!parent || *parent || !account || *account || !storage || *storage) {
+        return -EINVAL;
+    }
+    pthread_mutex_lock(&native_allocations.lock);
+    status = object_native_cpu_tlb_request_identity_locked(request);
+    if (!status && !request->account) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        *parent = request->parent;
+        *account = request->account;
+        *storage = request->storage;
+    }
+    pthread_mutex_unlock(&native_allocations.lock);
