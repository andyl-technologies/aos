+static int ram_control_creator(QemuCrucibleRamControlActor *actor,
+                               qemu_plugin_id_t id)
+{
+    int status = startup_runtime_cleanup_identity(id,
+                                                  &startup_source.runtime_purpose);
+
+    if (status || actor != &startup_source.ram_control_actor ||
+        !actor->attempted || actor->process != getpid() ||
+        !qemu_thread_is_self(&actor->creator)) {
+        return status ? status : -EPERM;
+    }
+    return 0;
+}
+
