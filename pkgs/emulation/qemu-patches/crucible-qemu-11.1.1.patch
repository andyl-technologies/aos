+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercises strict RAM membership with actual pthreads and /proc census.
+
+The fixture extracts the production private schema validator, membership proof,
+thread/descriptor census and initial inventory cleanup. Actors really register
+kernel TIDs and park. The complete native thread provider owns its real registry;
+test-only accessors inject explicit corruption for its negative controls. Plugin
+barrier callbacks and the component BQL predicate remain fixture endpoints.
+Linked QOM support retains its actual callback-drained RCU registration.
+This does not qualify Source
+activation, a translated guest, or a VMStop fence.
+"""
+
+import argparse
+import copy
+import hashlib
+import functools
+import json
+import os
+from pathlib import Path
+import re
+import runpy
+import signal
+import shlex
+import subprocess
+
+ROOT = Path(__file__).resolve().parents[2]
+EXTRACT = runpy.run_path(str(Path(__file__).with_name(
+    "extract-crucible-startup-source-controls.py")))
+
+
+def definition(source, signature):
+    if not signature.endswith("{"):
+        for _, _, _, body in EXTRACT["function_definitions"](source):
+            if body.startswith(signature):
+                return body.rstrip()
+        raise ValueError(f"function definition missing: {signature}")
+    start = source.index(signature)
+    opening = source.index("{", start)
+    depth = 0
+    for index in range(opening, len(source)):
+        depth += (source[index] == "{") - (source[index] == "}")
+        if depth == 0:
+            return source[start:index + 1]
+    raise AssertionError(signature)
+
+
+def selected(source, name):
+    for current, _, _, body in EXTRACT["function_definitions"](source):
+        if current == name:
+            return body
+    raise ValueError(f"function definition missing: {name}")
+
+
+def ordinary_source_dependencies():
+    startup = (ROOT / "plugins/crucible-startup-source.c").read_text()
+    publication = (ROOT / "plugins/crucible-callback-publication.inc.h").read_text()
+    native = (ROOT / "plugins/crucible-native-invocation.c").read_text()
+    actor = (ROOT / "plugins/crucible-ram-control.inc.h").read_text()
+    child = (ROOT / "plugins/crucible-callback-child.inc.h").read_text()
+    receiving = (ROOT / "plugins/crucible-checkpoint-receiving.h").read_text()
+    header = (ROOT / "plugins/crucible-startup-source.h").read_text()
+    declarations = EXTRACT["body_cut"](
+        startup, "static QemuCrucibleStartupSourceControl startup_source = {",
+        "static int startup_failure(")
+    bodies = []
+    # These continuations require selected ownership, absent in this fixture.
+    for text, signature in (
+        (receiving, "int qemu_crucible_checkpoint_request_actor_current_v1("),
+        (header, "int qemu_crucible_ram_control_actor_contract_current("),
+    ):
+        parameters = ("request", "actor") if "request_actor" in signature else ("actor",)
+        consume = "".join(f"    (void){name};\n" for name in parameters)
+        bodies.append(declaration(text, signature)[:-1] +
+                      "\n{\n" + consume + "    g_assert_not_reached();\n}\n")
+    bodies += [selected(publication, name) for name in (
+        "qemu_crucible_startup_source_native_selection_v1",
+        "qemu_crucible_startup_source_native_dispatch_hint_v1",
+    )]
+    bodies += [selected(native, name) for name in (
+        "native_selection", "native_dispatch_hint", "registry_process_current",
+        "registry_identity_locked", "registry_current_locked", "top_locked",
+        "registration_locked", "frame_member_locked", "frame_reclaim_locked",
+        "frame_identity_locked", "frame_cpu_pin_return",
+        "qemu_plugin_crucible_native_enter_v1",
+        "qemu_plugin_crucible_native_mask_v1",
+        "qemu_plugin_crucible_native_exit_v1",
+    )]
+    bodies.append(selected(child, "callback_child_output_overlap"))
+    bodies += [selected(actor, name) for name in (
+        "ram_control_pause_begin",
+        "qemu_plugin_crucible_ram_actor_pause_begin_inventory",
+        "qemu_plugin_crucible_ram_actor_pause_current",
+        "qemu_plugin_crucible_ram_actor_pause_binding",
+        "qemu_plugin_crucible_ram_actor_pause_identity",
+        "ram_control_pause_end_v2", "qemu_plugin_crucible_ram_actor_pause_end_v2",
+    )]
+    return declarations + "\n\n".join(bodies)
+
+
+def declaration(header, signature):
+    start = header.index(signature)
+    return header[start:header.index(";", start) + 1]
+
+
+def aggregate(source, signature):
+    body = definition(source, signature)
+    start = source.index(signature)
+    return source[start:source.index(";", start + len(body)) + 1]
+
+
+@functools.cache
+def configured_command_tokens(command):
+    """Decode an unchanged command once; callers receive their own list."""
+    return tuple(shlex.split(command))
+
+
+_provider_metadata_snapshot = None
+
+
+def provider_metadata(build_dir):
+    """Decode exact configured metadata once and refuse changed bytes."""
+    global _provider_metadata_snapshot
+
+    paths = (build_dir / "compile_commands.json",
+             build_dir / "meson-info/intro-targets.json")
+    metadata = tuple(path.read_bytes() for path in paths)
+    if _provider_metadata_snapshot is None:
+        decoded = tuple(json.loads(value) for value in metadata)
+        _provider_metadata_snapshot = (build_dir, metadata, decoded)
+    saved_build, saved_metadata, decoded = _provider_metadata_snapshot
+    if build_dir != saved_build or metadata != saved_metadata:
+        raise ValueError("configured provider metadata changed in this process")
+    return copy.deepcopy(decoded)
+
+
+def configured_command(entry, build_dir):
+    directory = Path(entry["directory"]).resolve()
+    if directory != build_dir:
+        raise ValueError("compile entry does not belong to the configured build")
+    command = entry.get("arguments")
+    if command is None:
+        command = configured_command_tokens(entry["command"])
+    if not command or not all(isinstance(item, str) for item in command):
+        raise ValueError("invalid configured compiler command")
+    return list(command)
+
+
+def configured_path(value, build_dir):
+    return (build_dir / value).resolve()
+
+
+def configured_output(entry, build_dir):
+    command = configured_command(entry, build_dir)
+    if command.count("-o") != 1:
+        raise ValueError("ambiguous configured object output")
+    output_value = command[command.index("-o") + 1]
+    output = configured_path(output_value, build_dir)
+    if not output.is_relative_to(build_dir):
+        raise ValueError("configured object escapes its build directory")
+    # Identical declarations share this record's authenticated resolution.
+    # Different spellings still require their own canonical identity check.
+    if ("output" in entry and entry["output"] != output_value and
+            configured_path(entry["output"], build_dir) != output):
+        raise ValueError("configured object output mismatch")
+    return output
+
+
+def provider_build(build_dir, component_compiler):
+    """Resolve the owning build's real provider and complete support objects."""
+    commands_path = build_dir / "compile_commands.json"
+    targets_path = build_dir / "meson-info/intro-targets.json"
+    entries, targets = provider_metadata(build_dir)
+
+    def target(name, kind):
+        matches = [item for item in targets
+                   if item["name"] == name and item["type"] == kind]
+        if len(matches) != 1:
+            raise ValueError(f"missing or ambiguous configured target: {name}")
+        return matches[0]
+
+    def archive(item):
+        if len(item["filename"]) != 1:
+            raise ValueError("ambiguous configured library filename")
+        path = configured_path(item["filename"][0], build_dir)
+        if not path.is_relative_to(build_dir):
+            raise ValueError("configured library escapes its build directory")
+        return path
+
+    provider_source = (ROOT / "util/qemu-thread-posix.c").resolve()
+    matches = [item for item in entries
+               if configured_path(item["file"], build_dir) == provider_source]
+    if len(matches) != 1:
+        raise ValueError("missing or ambiguous actual thread provider compile entry")
+    provider_entry = matches[0]
+    provider_command = configured_command(provider_entry, build_dir)
+    if (not component_compiler or
+            provider_command[:len(component_compiler)] != component_compiler):
+        raise ValueError("component/compiler identity differs from configured provider")
+    if (provider_command.count("-c") != 1 or
+            configured_path(provider_command[provider_command.index("-c") + 1],
+                            build_dir) != provider_source):
+        raise ValueError("configured provider source identity changed")
+
+    utility_archive = archive(target("qemuutil", "static library"))
+    provider_object = configured_output(provider_entry, build_dir)
+    if provider_object.parent != Path(str(utility_archive) + ".p"):
+        raise ValueError("thread provider does not belong to actual qemuutil")
+    if not utility_archive.is_file() or not provider_object.is_file():
+        raise ValueError("configured genuine qemuutil/provider was not built")
+
+    # Authenticate every configured output on every invocation.
+    # Both support libraries select from the same checked commands; decoding
+    # the entire compile database again cannot add another provider identity.
+    configured_outputs = [(entry, configured_output(entry, build_dir))
+                          for entry in entries]
+    support_objects = []
+    for name in ("event-loop-base", "qom"):
+        item = target(name, "static library")
+        object_directory = Path(str(archive(item)) + ".p")
+        selected_entries = [(entry, output) for entry, output in configured_outputs
+                            if output.parent == object_directory]
+        required_sources = {
+            configured_path(source, build_dir)
+            for group in item["target_sources"]
+            for key in ("sources", "generated_sources")
+            for source in group.get(key, [])
+            if Path(source).suffix in (".c", ".cc", ".cpp", ".S")
+        }
+        actual_sources = {configured_path(entry["file"], build_dir)
+                          for entry, _ in selected_entries}
+        if not required_sources or actual_sources != required_sources:
+            raise ValueError(f"incomplete configured support object closure: {name}")
+        objects = [output for _, output in selected_entries]
+        if (len(objects) != len(set(objects)) or
+                not all(path.is_file() for path in objects)):
+            raise ValueError(f"missing or duplicate real support objects: {name}")
+        support_objects.extend(objects)
+    if len(support_objects) != len(set(support_objects)):
+        raise ValueError("duplicate event-loop/QOM objects")
+
+    interface = target("check-qom-interface", "executable")
+    link_groups = [item for item in interface["target_sources"] if "linker" in item]
+    if len(link_groups) != 1:
+        raise ValueError("missing or ambiguous configured QOM link group")
+    linker = link_groups[0]["linker"]
+    if (linker[:len(component_compiler)] != component_compiler or
+            provider_command[:len(linker)] != linker):
+        raise ValueError("configured QOM linker/compiler identity mismatch")
+    parameters = link_groups[0]["parameters"]
+    if any("whole-archive" in item for item in parameters):
+        raise ValueError("whole-archive cannot enforce a sole thread provider")
+    if sum(configured_path(item, build_dir) == utility_archive
+           for item in parameters) != 1:
+        raise ValueError("configured QOM link group lacks its unique qemuutil")
+    if any(configured_path(item, build_dir) in support_objects for item in parameters):
+        raise ValueError("configured support objects already appear in link parameters")
+    return {
+        "entry": provider_entry,
+        "provider_object": provider_object,
+        "support_objects": support_objects,
+        "linker": linker,
+        "parameters": parameters,
+        "metadata_hashes": {
+            str(path): hashlib.sha256(path.read_bytes()).hexdigest()
+            for path in (commands_path, targets_path)
+        },
+    }
+
+
+def provider_compile_command(build, build_dir, source, output):
+    original = configured_command(build["entry"], build_dir)
+    command = []
+    removed = []
+    dependency_paths = []
+    index = 0
+    dependency_outputs = ("-MF", "-MQ", "-MT")
+    while index < len(original):
+        argument = original[index]
