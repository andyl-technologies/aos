+static void test_migration(gconstpointer data)
+{
+    unsigned kind = GPOINTER_TO_UINT(data);
+    ARMCPU original = { 0 };
+    ARMCPU restored = { 0 };
+    GByteArray *bytes;
+    __int128 deadline;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+    initialize_clock(true);
+    initialize_timers(&original);
+    initialize_timers(&restored);
+    switch (kind) {
+    case 0:
+        deadline = ((__int128)1 << 120) + 357;
+        break;
+    case 1:
+        deadline = -((__int128)1 << 120) + 357;
+        break;
+    case 2:
+        deadline = -1;
+        break;
+    case 3:
+        deadline = (__int128)(((__uint128_t)-1) >> 1);
+        break;
+    case 4:
+        deadline = -(__int128)(((__uint128_t)-1) >> 1) - 1;
+        break;
+    case 5:
+        deadline = 0;
+        break;
+    default:
+        g_assert_not_reached();
+    }
+    if (kind != 5) {
+        for (unsigned i = 0; i < 3; i++) {
+            timer_mod_ps_wide(arm_migration_timer(&original, i), deadline);
+        }
+    }
+    for (unsigned i = 0; i < NUM_GTIMERS; i++) {
+        timer_mod_ps_wide(restored.gt_timer[i], 5);
+    }
+    timer_mod_ps_wide(restored.pmu_timer, 5);
+    bytes = save_state(&timer_fixture, &original);
+
+    g_assert_cmpint(load_state(&timer_fixture, &restored, bytes), ==, 0);
+    for (unsigned i = 0; i < 3; i++) {
+        QEMUTimer *timer = arm_migration_timer(&restored, i);
+
+        g_assert_cmpint(timer_pending(timer), ==, kind != 5);
+        if (kind != 5) {
+            g_assert_true(timer_expire_time_ps_wide(timer) == deadline);
+        }
+    }
+    g_assert_false(timer_pending(restored.gt_timer[GTIMER_HYP]));
+    g_assert_false(timer_pending(restored.pmu_timer));
+    if (kind == 0 || kind == 1 || kind == 2) {
+        observed_ps = deadline - 1;
+        qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+        g_assert_cmpuint(callbacks, ==, 0);
+        observed_ps = deadline;
+        qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+        g_assert_cmpuint(callbacks, ==, 6);
+    }
+
+    g_byte_array_unref(bytes);
+    destroy_timers(&original);
+    destroy_timers(&restored);
+}
+
+static size_t exact_payload(GByteArray *bytes)
+{
+    const char *name = "cpu/timers-wide";
+    size_t length = strlen(name);
+
+    for (size_t i = 24; i + length + 6 < bytes->len; i++) {
+        if (bytes->data[i] == QEMU_VM_SUBSECTION &&
+            bytes->data[i + 1] == length &&
+            !memcmp(bytes->data + i + 2, name, length)) {
+            return i + length + 6;
+        }
+    }
+    g_assert_not_reached();
+}
