+CrucibleCheckpointRestore *qmp_crucible_checkpoint_restore(
+    CrucibleCheckpointRestoreLayerList *layers,
+    const char *device_fdname,
+    const char *device_sha256,
+    const char *cancellation_fdname,
+    const char *checkpoint_sha256,
+    const char *target_sha256,
+    const char *frontier_sha256,
+    uint64_t maximum_device_bytes,
+    Error **errp)
+{
+    g_autoptr(GArray) inputs = g_array_new(
+        false, true, sizeof(CrucibleCheckpointRestoreInput));
+    CrucibleCheckpointRestoreLayerList *entry;
+    CrucibleCheckpointRestore *report = NULL;
+    int device_fd = -1;
+    int cancellation_fd = -1;
+
+    for (entry = layers; entry; entry = entry->next) {
+        CrucibleCheckpointRestoreInput input = {
+            .fd = monitor_get_fd(monitor_cur(), entry->value->ram_fdname,
+                                 errp),
+            .sha256 = entry->value->ram_sha256,
+            .maximum_bytes = entry->value->maximum_ram_bytes,
+        };
+
+        if (input.fd < 0) {
+            goto out;
+        }
+        g_array_append_val(inputs, input);
+    }
+    device_fd = monitor_get_fd(monitor_cur(), device_fdname, errp);
+    if (device_fd < 0) {
+        goto out;
+    }
+    cancellation_fd = monitor_get_fd(monitor_cur(), cancellation_fdname,
+                                     errp);
+    if (cancellation_fd < 0) {
+        goto out;
+    }
+    report = qemu_crucible_checkpoint_restore(
+        (CrucibleCheckpointRestoreInput *)inputs->data, inputs->len,
+        device_fd, cancellation_fd, device_sha256, checkpoint_sha256,
+        target_sha256, frontier_sha256, maximum_device_bytes, errp);
+    device_fd = -1;
+
+out:
+    for (guint index = 0; index < inputs->len; index++) {
+        CrucibleCheckpointRestoreInput *input = &g_array_index(
+            inputs, CrucibleCheckpointRestoreInput, index);
+
+        if (input->fd >= 0) {
+            close(input->fd);
+        }
+    }
+    if (device_fd >= 0) {
+        close(device_fd);
+    }
+    if (cancellation_fd >= 0) {
+        close(cancellation_fd);
+    }
+    return report;
+}
