+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+    initialize_clock(exact);
+    initialize_cpu(&cpu);
+    initialize_cpu(&restored);
+    deadline = kind == 0 ? ((__int128)1 << 120) + 357 :
+               kind == 1 ? -((__int128)1 << 120) + 357 :
+               kind == 4 ? -1 : 120000;
+    observed_ps = deadline - 4000;
+    if (kind != 2) {
+        if (exact) {
+            timer_mod_ps_wide(cpu.env.timer, deadline);
+        } else {
+            timer_mod_ns(cpu.env.timer, 120);
+        }
+    }
+    bytes = save_state(&mips_vmstate_timer, &cpu);
+    g_assert_cmpint(load_state(&mips_vmstate_timer, &restored, bytes), ==, 0);
+    g_assert_cmpuint(timer_pending(restored.env.timer), ==, kind != 2);
+    if (kind != 2) {
+        if (exact) {
+            g_assert_true(timer_expire_time_ps_wide(restored.env.timer) == deadline);
+        } else {
+            g_assert_cmpint(timer_expire_time_ns(restored.env.timer), ==, 120);
+        }
+    }
+    timer_del(cpu.env.timer);
+    if (kind != 2) {
+        observed_ps = deadline;
+        qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+        g_assert_cmpuint(irqs, ==, 1);
+    }
+    g_byte_array_unref(bytes);
+    destroy_cpu(&cpu);
+    destroy_cpu(&restored);
+}
+
+static void test_malformed(gconstpointer data)
+{
+    unsigned kind = GPOINTER_TO_UINT(data);
+    MIPSCPU cpu = { 0 };
+    MIPSCPU restored = { 0 };
+    GByteArray *bytes;
+    size_t payload;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+    initialize_clock(true);
+    initialize_cpu(&cpu);
+    initialize_cpu(&restored);
+    observed_ps = ((__int128)1 << 120) + 357;
+    timer_mod_ps_wide(cpu.env.timer, observed_ps + 4000);
+    timer_mod_ps_wide(restored.env.timer, observed_ps + 9000);
+    bytes = save_state(&mips_vmstate_timer, &cpu);
+    payload = subsection_payload(bytes, "cpu/timer/clock-wide");
+
+    switch (kind) {
+    case 0:
+        remove_subsection(bytes, "cpu/timer/clock-wide");
+        break;
+    case 1:
+        duplicate_subsection(bytes, "cpu/timer/clock-wide");
+        break;
+    case 2:
+        bytes->data[payload] = 2;
+        break;
+    case 3:
+        bytes->data[payload + 1] = 2;
+        break;
+    case 4:
+        bytes->data[7] ^= 1; /* mismatched parent shadow */
+        break;
+    case 5:
+        bytes->data[payload + 1] = 0;
+        break;
+    case 6:
+        bytes->data[payload - 1] = 0;
+        break;
+    default:
+        g_assert_not_reached();
+    }
+
+    g_assert_cmpint(load_state(&mips_vmstate_timer, &restored, bytes), <, 0);
+    g_assert_false(timer_pending(restored.env.timer));
+    g_assert_cmpuint(irqs, ==, 0);
+
+    g_byte_array_unref(bytes);
+    destroy_cpu(&cpu);
+    destroy_cpu(&restored);
+}
+
+static void test_range(void)
+{
+    MIPSCPU cpu = { 0 };
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_failed();
+        g_test_trap_assert_stderr("*exceeds signed128 picoseconds*");
+        return;
+    }
+    initialize_clock(true);
+    initialize_cpu(&cpu);
+    observed_ps = (__int128)(((__uint128_t)-1) >> 1);
+    cpu_mips_store_compare(&cpu.env, 7);
+    g_assert_not_reached();
+}
+
+static int import_ordinary(const char *path, unsigned kind)
+{
+    MIPSCPU cpu = { 0 };
+    GByteArray *bytes;
+    gchar *contents;
+    gsize length;
+    int status;
+
+    initialize_clock(false);
+    initialize_cpu(&cpu);
+    timer_mod_ns(cpu.env.timer, 42);
+    g_assert_true(g_file_get_contents(path, &contents, &length, NULL));
+    bytes = g_byte_array_new_take((guint8 *)contents, length);
+    status = load_state(&mips_vmstate_timer, &cpu, bytes);
+    if (kind == 0 || kind == 4) {
+        g_assert_cmpint(status, ==, 0);
+        g_assert_cmpint(timer_expire_time_ns(cpu.env.timer), ==,
+                        kind == 0 ? 141 : 0);
+    } else {
+        g_assert_cmpint(status, <, 0);
+        g_assert_false(timer_pending(cpu.env.timer));
+    }
+    destroy_cpu(&cpu);
+    g_byte_array_unref(bytes);
+    return 0;
+}
+
+static void test_cross_mode(gconstpointer data)
+{
+    unsigned kind = GPOINTER_TO_UINT(data);
+    MIPSCPU cpu = { 0 };
+    GByteArray *bytes;
+    __int128 deadline;
+    int descriptor;
+    char *path = NULL;
+    char *output = NULL;
+    char *errors = NULL;
+    char *kind_argument;
+    int status;
+    char *arguments[5];
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+    initialize_clock(true);
+    initialize_cpu(&cpu);
+    deadline = kind == 0 ? 140001 :
+               kind == 1 ? ((__int128)1 << 120) + 357 :
+               kind == 2 ? -((__int128)1 << 120) + 357 :
+               kind == 3 ? (__int128)INT64_MAX * 1000 + 999 : -1001;
+    timer_mod_ps_wide(cpu.env.timer, deadline);
+    bytes = save_state(&mips_vmstate_timer, &cpu);
+    descriptor = g_file_open_tmp("mips-count-wide-XXXXXX", &path, NULL);
+    g_assert_cmpint(descriptor, >=, 0);
+    close(descriptor);
+    g_assert_true(g_file_set_contents(path, (char *)bytes->data, bytes->len, NULL));
+    kind_argument = g_strdup_printf("%u", kind);
+    arguments[0] = (char *)program_path;
+    arguments[1] = (char *)"--import-ordinary";
+    arguments[2] = path;
+    arguments[3] = kind_argument;
+    arguments[4] = NULL;
+    g_assert_true(g_spawn_sync(NULL, arguments, NULL, 0, NULL, NULL,
+                              &output, &errors, &status, NULL));
+    if (status) {
+        g_test_message("ordinary import: %s", errors);
+    }
+    g_assert_true(WIFEXITED(status));
+    g_assert_cmpint(WEXITSTATUS(status), ==, 0);
+    g_assert_cmpint(unlink(path), ==, 0);
+    g_free(kind_argument);
+    g_free(output);
+    g_free(errors);
+    g_free(path);
+    destroy_cpu(&cpu);
+    g_byte_array_unref(bytes);
+}
+
+int main(int argc, char **argv)
+{
+    program_path = argv[0];
+    if (argc == 4 && !strcmp(argv[1], "--import-ordinary")) {
+        return import_ordinary(argv[2], strtoul(argv[3], NULL, 10));
+    }
+    g_test_init(&argc, &argv, NULL);
+    for (unsigned kind = 0; kind < ARRAY_SIZE(counter_vectors); kind++) {
+        char *name = g_strdup_printf("/mips/count/%u", kind);
+        g_test_add_data_func(name, GUINT_TO_POINTER(kind), test_count);
+        g_free(name);
+    }
+    for (unsigned kind = 0; kind < 4; kind++) {
+        char *name = g_strdup_printf("/mips/compare/%u", kind);
+        g_test_add_data_func(name, GUINT_TO_POINTER(kind), test_compare);
+        g_free(name);
+    }
+    for (unsigned kind = 0; kind < 5; kind++) {
+        char *name = g_strdup_printf("/mips/migration/%u", kind);
+        g_test_add_data_func(name, GUINT_TO_POINTER(kind), test_migration);
+        g_free(name);
+    }
+    for (unsigned kind = 0; kind < 7; kind++) {
+        char *name = g_strdup_printf("/mips/malformed/%u", kind);
+        g_test_add_data_func(name, GUINT_TO_POINTER(kind), test_malformed);
+        g_free(name);
+    }
+    for (unsigned kind = 0; kind < 5; kind++) {
+        char *name = g_strdup_printf("/mips/cross-mode/%u", kind);
+        g_test_add_data_func(name, GUINT_TO_POINTER(kind), test_cross_mode);
+        g_free(name);
+    }
+    g_test_add_func("/mips/range", test_range);
+    return g_test_run();
+}
