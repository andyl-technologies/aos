+++ b/tests/unit/crucible-fault-manifest-live-fixture.inc.h
@@ -0,0 +1,259 @@
+/*
+ * Ordinary fixture identities for actual realized manifest rows.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+static void live_manifest_string(GByteArray *bytes, const char *text)
+{
+    size_t length;
+
+    assert(text);
+    length = strlen(text);
+    assert(length <= UINT32_MAX);
+    qemu_crucible_fault_vmstate_put_u32(bytes, length);
+    qemu_crucible_fault_vmstate_put_bytes(bytes, text, length);
+}
+
+static void live_manifest_digest(const GByteArray *bytes, uint8_t out[32])
+{
+    GChecksum *checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    size_t length = 32;
+
+    g_checksum_update(checksum, bytes->data, bytes->len);
+    g_checksum_get_digest(checksum, out, &length);
+    assert(length == 32);
+    g_checksum_free(checksum);
+}
+
+static void live_manifest_identity(const char *family, const char *role,
+                                   const char *name, uint8_t out[32])
+{
+    g_autoptr(GByteArray) bytes = g_byte_array_new();
+
+    live_manifest_string(bytes, "qemu.ordinary.aggregate.identity.v1");
+    live_manifest_string(bytes, family);
+    live_manifest_string(bytes, role);
+    live_manifest_string(bytes, name);
+    live_manifest_digest(bytes, out);
+}
+
+static void live_manifest_record(const char *name, GByteArray *bytes,
+                                 uint8_t digest[32])
+{
+    GError *error = NULL;
+    g_autofree char *hex = g_compute_checksum_for_data(
+        G_CHECKSUM_SHA256, bytes->data, bytes->len);
+
+    live_manifest_digest(bytes, digest);
+    assert(g_file_set_contents(name, (char *)bytes->data, bytes->len, &error));
+    assert(!error);
+    fprintf(stderr, "ordinary manifest %s bytes=%u sha256=%s\n",
+            name, bytes->len, hex);
+}
+
+static void live_register_manifest_bind(void)
+{
+    struct qemu_plugin_crucible_fault_register_capability *rows;
+    g_autoptr(GByteArray) bytes = g_byte_array_new();
+    const char *model = NULL;
+    uint16_t architecture = 0;
+    uint8_t digest[32];
+    size_t count = qemu_plugin_crucible_fault_register_manifest(
+        NULL, 0, &architecture, &model);
+
+    assert(count && count <= UINT32_MAX && count <= G_MAXSIZE / sizeof(*rows));
+    rows = g_new0(struct qemu_plugin_crucible_fault_register_capability, count);
+    assert(qemu_plugin_crucible_fault_register_manifest(
+        rows, count, &architecture, &model) == count);
+    live_manifest_string(bytes, "qemu.ordinary.aggregate.register.v1");
+    qemu_crucible_fault_vmstate_put_u16(bytes, architecture);
+    live_manifest_string(bytes, model);
+    live_manifest_digest(bytes, digest);
+    assert(qemu_plugin_crucible_fault_register_bind_architecture(digest) == 0);
+    qemu_crucible_fault_vmstate_put_bytes(bytes, digest, sizeof(digest));
+    qemu_crucible_fault_vmstate_put_u32(bytes, count);
+    for (size_t i = 0; i < count; i++) {
+        const struct qemu_plugin_crucible_fault_register_capability *row = &rows[i];
+        const uint8_t *masks[] = { row->writable_mask, row->reserved_mask,
+                                   row->ignored_mask, row->read_only_mask };
+        uint8_t id[32];
+
+        assert(!row->reserved);
+        qemu_crucible_fault_vmstate_put_u32(bytes, row->numeric_id);
+        qemu_crucible_fault_vmstate_put_u32(bytes, row->width_bits);
+        qemu_crucible_fault_vmstate_put_u16(bytes, row->group);
+        qemu_crucible_fault_vmstate_put_u64(bytes, row->model_phase_mask);
+        qemu_crucible_fault_vmstate_put_u32(bytes, row->side_effects);
+        qemu_crucible_fault_vmstate_put_u32(bytes, row->capabilities);
+        live_manifest_string(bytes, row->name);
+        assert(row->mask_bytes <= UINT32_MAX);
+        qemu_crucible_fault_vmstate_put_u32(bytes, row->mask_bytes);
+        for (size_t j = 0; j < G_N_ELEMENTS(masks); j++) {
+            assert(masks[j] || !row->mask_bytes);
+            qemu_crucible_fault_vmstate_put_bytes(bytes, masks[j], row->mask_bytes);
+        }
+        live_manifest_identity("register", "name", row->name, id);
+        qemu_crucible_fault_vmstate_put_bytes(bytes, id, sizeof(id));
+        assert(qemu_plugin_crucible_fault_register_bind(id, row->numeric_id) == 0);
+    }
+    live_manifest_record("ordinary-register-manifest.bin", bytes, digest);
+    assert(qemu_plugin_crucible_fault_register_bindings_seal() == 0);
+    g_free(rows);
+}
+
