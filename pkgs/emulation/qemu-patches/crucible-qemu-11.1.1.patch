+static __int128 wide_time(int64_t hi, uint64_t lo)
+{
+    return (__int128)hi * ((__int128)1 << 64) + lo;
+}
+
+typedef struct CounterCase {
+    int64_t origin_hi;
+    uint64_t origin_lo;
+    uint64_t expected;
+} CounterCase;
+
+/* Unbounded floor(time_ps/10000), followed by architectural modulo64. */
+static const CounterCase counter_cases[] = {
+    { INT64_C(0), UINT64_C(0),
+      UINT64_C(0) },
+    { INT64_C(0), UINT64_C(1),
+      UINT64_C(0) },
+    { INT64_C(-1), UINT64_C(18446744073709551615),
+      UINT64_C(18446744073709551615) },
+    { INT64_C(0), UINT64_C(9999),
+      UINT64_C(0) },
+    { INT64_C(0), UINT64_C(10000),
+      UINT64_C(1) },
+    { INT64_C(-1), UINT64_C(18446744073709541616),
+      UINT64_C(18446744073709551615) },
+    { INT64_C(-1), UINT64_C(18446744073709541615),
+      UINT64_C(18446744073709551614) },
+    { INT64_C(72057594037927936), UINT64_C(357),
+      UINT64_C(14639336096895900162) },
+    { INT64_C(-72057594037927936), UINT64_C(357),
+      UINT64_C(3807407976813651453) },
+    { INT64_MIN, UINT64_C(0),
+      UINT64_C(7732875115699044037) },
+    { INT64_C(9223372036854775807), UINT64_C(18446744073709551615),
+      UINT64_C(10713868958010507578) },
+    { INT64_C(9999), UINT64_C(18446744073709531973),
+      UINT64_C(18446744073709551614) },
+};
