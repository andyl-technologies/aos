+        "static uintptr_t qemu_plugin_schedule_control_boundary(void)\n{",
+    ])
+    bodies.append(definition((ROOT / "accel/tcg/tcg-accel-ops-rr.c").read_text(),
+                             "static void rr_crucible_sim_park_vmstop(void)"))
+    production = "\n\n".join(bodies)
+    production = SUPPORT["dependencies"](production) + "\n\n" + production
+    if arguments.negative_control == "callback-scope":
+        scoped = definition(sources["net/net.c"],
+                            "static ssize_t crucible_net_tx_submit(")
+        unscoped = scoped.replace("    qemu_plugin_crucible_exact_boundary_enter();\n", "")
+        unscoped = unscoped.replace("    qemu_plugin_crucible_exact_boundary_leave();\n", "")
+        production = production.replace(scoped, unscoped)
+    elif arguments.negative_control == "queued-advance-guard":
+        guard = """    } else if (qemu_plugin_crucible_vmstop_pending()) {
+        /* An output stop can win after the host reserved this advance. */
+        status = -EBUSY;
+"""
+        assert production.count(guard) == 1
+        production = production.replace(guard, "")
+    elif arguments.negative_control == "reservation-guard":
+        guard = """    if (qemu_plugin_crucible_vmstop_pending()) {
+        return -EBUSY;
+    }
+"""
+        assert production.count(guard) == 1
+        production = production.replace(guard, "")
+    generated = arguments.output_dir / "net-output-stop.c"
+    generated.write_text(SUPPORT["NATIVE_COMPONENT_NAMESPACE"] +
+                         fixture_prelude() + production + TESTS)
+    binary = arguments.output_dir / "net-output-stop"
+    command = [os.environ.get("CC", "cc"), *shlex.split(os.environ.get("CFLAGS", "")),
+               "-Wno-missing-prototypes", "-Wno-unused-function", "-Wno-unused-variable",
+               str(generated), *SUPPORT["native_link_arguments"](), "-o", str(binary),
+               *shlex.split(os.environ.get("LDFLAGS", ""))]
+    (arguments.output_dir / "compile-command.json").write_text(
+        json.dumps({"cwd": os.getcwd(), "argv": command}, indent=2) + "\n")
+    subprocess.run(command, check=True)
+    subprocess.run([str(binary)], cwd=arguments.output_dir, check=True)
+
+
+if __name__ == "__main__":
+    main()
