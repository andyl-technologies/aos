+int qemu_crucible_checkpoint_stop_result_v1(void)
+{
+    if (checkpoint_stop_owner.first_status) {
+        return checkpoint_stop_owner.first_status;
+    }
+    if (checkpoint_stop_owner.post_status) {
+        return checkpoint_stop_owner.post_status;
+    }
+    return checkpoint_stop_receipt_current();
+}
