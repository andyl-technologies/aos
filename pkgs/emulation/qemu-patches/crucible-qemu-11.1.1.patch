+static int ram_control_receive_dispose_locked(
+    qemu_plugin_id_t id, qemu_plugin_crucible_ram_control_actor_v1 *actor,
+    qemu_plugin_crucible_ram_control_receive_v1 *receipt, int disposition_status)
+{
+    size_t index;
+    int status = qemu_crucible_ram_control_actor_current(actor, id);
+
+    if (status || receipt != &actor->receipt || !receipt->active || receipt->moved) {
+        return status ? status : -EPERM;
+    }
+    if (disposition_status > 0) {
+        return -EINVAL;
+    }
+    if (!receipt->frame_extent ||
+        receipt->frame_bytes != receipt->frame_extent ||
+        !receipt->record.held || !receipt->record.acquired ||
+        !receipt->record.owner || receipt->record.callback_active ||
+        !receipt->record.end_attempted || !receipt->record.end_returned ||
+        receipt->record.release_attempted ||
+        receipt->record.terminal_journal !=
+            QEMU_PLUGIN_CRUCIBLE_RAM_RECORD_TERMINAL_COMPLETED ||
+        receipt->record.end_result > 0 || receipt->record.completion_result > 0) {
+        return -EINPROGRESS;
+    }
+    if (disposition_status < 0) {
+        /* A fully known failed record may retire its bank after genuine
+         * operation completion. The endpoint remains permanently poisoned. */
+        ram_control_failure(actor, disposition_status, false);
+    }
+    for (index = 0; index < receipt->alias_count; index++) {
+        if (receipt->aliases[index] < 0) {
+            continue;
+        }
+        if (receipt->close_attempted[index]) {
+            return -EINPROGRESS;
+        }
+        receipt->close_attempted[index] = true;
+        if (close(receipt->aliases[index]) < 0) {
+            receipt->uncertain = true;
+            ram_control_failure(actor, -errno, true);
+            return qatomic_read(&actor->first_status);
+        }
+        receipt->aliases[index] = -1;
+    }
+    if (receipt->uncertain) {
+        return qatomic_read(&actor->first_status) ?
+            qatomic_read(&actor->first_status) : -EINPROGRESS;
+    }
+    actor->record_in_flight = false;
+    receipt->active = false;
+    receipt->frame_bytes = 0;
+    receipt->frame_extent = 0;
+    receipt->alias_count = 0;
+    return 0;
+}
