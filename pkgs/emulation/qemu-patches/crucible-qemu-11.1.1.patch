+static void test_disarm_fields(void)
+{
+    /* Syntax basis only; no authenticated child or alias-closure proof. */
+    struct qemu_plugin_crucible_hot_fork_child_plan plan = {
+        .schema_version = 5,
+        .struct_size = sizeof(plan),
+        .parent_process_generation = 17,
+        .child_process_generation = 18,
+        .template_generation = 19,
+        .plugin_barrier_generation = 23,
+        .reserved_fd = -1,
+    };
+    struct qemu_plugin_crucible_hot_fork_child_status baseline = {
+        .schema_version = 5,
+        .struct_size = sizeof(baseline),
+        .flags = 32,
+        .phase = 0,
+        .parent_process_generation = 17,
+        .child_process_generation = 18,
+        .template_generation = 19,
+        .plugin_barrier_generation = 23,
+        .workspace_fd = -1,
+    };
+    struct qemu_plugin_crucible_hot_fork_child_status changed;
+
+    g_assert_true(qemu_crucible_device_workspace_disarm_status_matches(
+                      &plan, &baseline));
+    g_assert_false(qemu_crucible_device_workspace_disarm_status_matches(
+                       NULL, &baseline));
+    g_assert_false(qemu_crucible_device_workspace_disarm_status_matches(
+                       &plan, NULL));
+
+#define REFUSE_FIELD(field) do { \
+    changed = baseline; \
+    changed.field++; \
+    g_assert_false(qemu_crucible_device_workspace_disarm_status_matches( \
+                       &plan, &changed)); \
+} while (0)
+
+    REFUSE_FIELD(schema_version);
+    REFUSE_FIELD(struct_size);
+    REFUSE_FIELD(flags);
+    REFUSE_FIELD(phase);
+    REFUSE_FIELD(parent_process_generation);
+    REFUSE_FIELD(child_process_generation);
+    REFUSE_FIELD(template_generation);
+    REFUSE_FIELD(private_ring_generation);
+    REFUSE_FIELD(plugin_endpoint_generation);
+    REFUSE_FIELD(plugin_barrier_generation);
+    REFUSE_FIELD(control_socket_cookie);
+    REFUSE_FIELD(wake_eventfd_id);
+    REFUSE_FIELD(source_mapping_start);
+    REFUSE_FIELD(source_mapping_length);
+    REFUSE_FIELD(source_mapping_offset);
+    REFUSE_FIELD(worker_mask);
+    REFUSE_FIELD(parked_worker_mask);
+    REFUSE_FIELD(pending_worker_mask);
+    REFUSE_FIELD(worker_operations_in_flight);
+    REFUSE_FIELD(account_generation);
+    REFUSE_FIELD(workspace_generation);
+    REFUSE_FIELD(workspace_device);
+    REFUSE_FIELD(workspace_inode);
+    REFUSE_FIELD(workspace_length);
+    REFUSE_FIELD(workspace_fd);
+    REFUSE_FIELD(workspace_reserved);
+
+#undef REFUSE_FIELD
+
+    changed = baseline;
+    changed.flags = 7;
+    changed.phase = 2;
+    changed.worker_mask = 3;
+    changed.parked_worker_mask = 3;
+    g_assert_false(qemu_crucible_device_workspace_disarm_status_matches(
+                       &plan, &changed));
+
+    g_assert_cmpuint(QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_DISARM, ==, 4);
+
+    plan.schema_version = 4;
+    g_assert_false(qemu_crucible_device_workspace_disarm_status_matches(
+                       &plan, &baseline));
+    plan.schema_version = 5;
+    plan.struct_size--;
+    g_assert_false(qemu_crucible_device_workspace_disarm_status_matches(
+                       &plan, &baseline));
+    plan.struct_size = sizeof(plan);
+    plan.workspace_reserved = 1;
+    g_assert_false(qemu_crucible_device_workspace_disarm_status_matches(
+                       &plan, &baseline));
+    plan.workspace_reserved = 0;
+    plan.parent_process_generation = UINT64_MAX;
+    g_assert_false(qemu_crucible_device_workspace_disarm_status_matches(
+                       &plan, &baseline));
+}
+
+static void report_layout(void)
+{
