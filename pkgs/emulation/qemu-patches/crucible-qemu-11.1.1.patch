+        SOURCE_CALLBACK_MASKED_INVOKE(
+
+            first, &child->destructor, destructor, NULL,
+
+            id, child, address, extent, alignment);
+        qemu_mutex_lock(&registry->mutex);
+        child->destructor_first_status = first;
+        child->destructor_returned = true;
+        child->destruction_active = false;
+        if (!child->destroyed) {
+            child->destruction_uncertain = true;
+            if (!first) {
+                child->destructor_first_status = first = -EPROTO;
+            }
+        }
+        qemu_mutex_unlock(&registry->mutex);
+
+        post = qemu_crucible_startup_source_fingerprint_context_identity_v1(id);
+        qemu_mutex_lock(&registry->mutex);
