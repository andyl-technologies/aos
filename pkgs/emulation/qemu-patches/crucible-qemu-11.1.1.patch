+    for (receipt = native_allocations.receipts; receipt; receipt = receipt->next) {
+        if (receipt != candidate) {
+            continue;
+        }
+        if (receipt->active && receipt->process == getpid() &&
+            receipt->source_owner == source_owner &&
+            receipt->generation == generation &&
+            receipt->kind == OBJECT_NATIVE_ALLOCATION_INSTANCE &&
+            receipt->allocation_started && !receipt->allocation_abandoned &&
+            !receipt->free_in_flight && !receipt->physical_returned &&
+            receipt->aliases && receipt->payload == instance &&
