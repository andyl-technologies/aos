+
+    initialize_timers(&state);
+    timer_mod_ps_wide(state.update_timer, 1);
+    if (index == 0) {
+        state.cmos_data[RTC_REG_A] = 0x60;
+    } else {
+        state.cmos_data[RTC_REG_C] = REG_C_UF;
+        if (index == 1) {
+            state.cmos_data[RTC_REG_B] |= REG_B_SET;
+        } else {
+            state.cmos_data[RTC_REG_C] |= REG_C_AF;
+        }
+    }
+    rtc_check_update_precise(&state, ((__int128)1 << 120) + 357, 2);
+
+    g_assert_false(timer_pending(state.update_timer));
+    destroy_timers(&state);
+}
