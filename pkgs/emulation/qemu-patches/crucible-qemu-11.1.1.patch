+    qemu_put_be32(f, cpsr_read((CPUARMState *)env));
+    qemu_put_be32(f, env->spsr);
+    for (size_t i = 0; i < ARRAY_SIZE(env->banked_spsr); i++) {
+        qemu_put_be64(f, env->banked_spsr[i]);
+    }
+    for (size_t i = 0; i < ARRAY_SIZE(env->banked_r13); i++) {
+        qemu_put_be32(f, env->banked_r13[i]);
+        qemu_put_be32(f, env->banked_r14[i]);
+    }
+    for (size_t i = 0; i < ARRAY_SIZE(env->usr_regs); i++) {
