+++ b/tests/unit/test-crucible-pending-command.py
@@ -0,0 +1,216 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise actual pending-lender physical/content leaves and refusal-only posts.
+
+Local spans and field consumption never construct an admitted Source, Runtime,
+recipient or Core Original. Every protocol dependency in the post fixture
+refuses. Each causal omission is rebuilt independently with unchanged checks.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import resource
+import runpy
+import shlex
+import subprocess
+
+
+CHECKS = r'''
+int main(void)
+{
+    _Alignas(8) uint8_t storage[256] = { 0 };
+    uintptr_t base = (uintptr_t)storage;
+    void *holder = storage + 16;
+    void *serial_field = storage + 160;
+    void *out = storage + 64;
+
+    assert(pending_runtime_field(base, 256, storage, 8, 8));
+    assert(pending_runtime_field(base, 256, storage + 248, 8, 8));
+    assert(pending_runtime_field(base, 256, storage + 255, 1, 1));
+    assert(!pending_runtime_field(0, 256, (void *)8, 8, 8));
+    assert(!pending_runtime_field(base, 0, storage, 8, 8));
+    assert(!pending_runtime_field(UINTPTR_MAX - 15, 32, (void *)(UINTPTR_MAX - 15), 8, 8));
+    assert(!pending_runtime_field(base, 256, NULL, 8, 8));
