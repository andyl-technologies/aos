+bool qemu_crucible_fault_has_pending_at_or_before(uint16_t phase,
+                                                  uint64_t icount)
+{
+    CruciblePendingFault *pending;
+    bool found = false;
+    int64_t observed_tick;
+
+    if (!qatomic_load_acquire(&crucible_pending_count)) {
+        return false;
+    }
+    observed_tick = qemu_plugin_sim_tick_observed();
+    if (observed_tick < 0 || qemu_plugin_icount_raw() != icount) {
+        return false;
+    }
+
+    g_mutex_lock(&crucible_fault_lock);
+    QTAILQ_FOREACH(pending, &crucible_pending_faults, link) {
+        if (pending->command.phase == phase &&
+            pending->command.target_tick <= (uint64_t)observed_tick) {
+            found = true;
+            break;
+        }
+    }
+    g_mutex_unlock(&crucible_fault_lock);
+    return found;
+}
+
+uint64_t qemu_crucible_fault_next_icount(uint16_t phase)
+{
+    CruciblePendingFault *pending;
+    uint64_t next_tick = UINT64_MAX;
+    uint64_t raw_now;
+    uint64_t remaining_instructions;
+    int64_t observed_tick;
+
+    if (!qatomic_load_acquire(&crucible_pending_count)) {
+        return UINT64_MAX;
+    }
+    raw_now = qemu_plugin_icount_raw();
+    observed_tick = qemu_plugin_sim_tick_observed();
+    if (observed_tick < 0) {
+        return UINT64_MAX;
+    }
+
+    g_mutex_lock(&crucible_fault_lock);
+    QTAILQ_FOREACH(pending, &crucible_pending_faults, link) {
+        if (pending->command.phase == phase) {
+            next_tick = MIN(next_tick, pending->command.target_tick);
+        }
+    }
+    g_mutex_unlock(&crucible_fault_lock);
+    if (next_tick == UINT64_MAX || next_tick > INT64_MAX) {
+        return UINT64_MAX;
+    }
+    if (next_tick <= (uint64_t)observed_tick) {
+        return raw_now;
+    }
+    remaining_instructions = (next_tick - (uint64_t)observed_tick) /
+        CRUCIBLE_SIM_TICKS_PER_INSTRUCTION;
+
+    return remaining_instructions <= UINT64_MAX - raw_now ?
+        raw_now + remaining_instructions : UINT64_MAX;
+}
+
+uint64_t qemu_crucible_fault_next_boundary_deadline(uint16_t phase)
+{
+    uint64_t next = UINT64_MAX;
+    CruciblePendingFault *pending;
+
+    if (qatomic_load_acquire(&crucible_pending_count)) {
+        g_mutex_lock(&crucible_fault_lock);
+        QTAILQ_FOREACH(pending, &crucible_pending_faults, link) {
+            if (pending->command.phase == phase) {
+                next = MIN(next, pending->command.target_tick);
+            }
+        }
+        g_mutex_unlock(&crucible_fault_lock);
+    }
+
+    if (phase == CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY &&
+        qemu_crucible_fault_lifecycle_downtime_pending()) {
+        return MIN(next,
+                   qemu_crucible_fault_lifecycle_downtime_deadline());
+    }
+
+    for (guint i = 0;
+         crucible_boundary_deadlines && i < crucible_boundary_deadlines->len;
+         i++) {
+        QemuCrucibleFaultBoundaryDeadlineFn deadline =
+            g_ptr_array_index(crucible_boundary_deadlines, i);
+
+        next = MIN(next, deadline(phase));
+    }
+    return next;
+}
+
+int64_t qemu_crucible_fault_clamp_budget(uint16_t phase,
+                                         uint64_t current_icount,
+                                         int64_t budget)
+{
+    uint64_t next;
+    uint64_t remaining;
+
+    if (budget <= 0) {
+        return budget;
+    }
+    next = qemu_crucible_fault_next_icount(phase);
+    if (current_icount >= next) {
+        return 0;
+    }
+    remaining = next - current_icount;
+    if (remaining > INT64_MAX || (uint64_t)budget <= remaining) {
+        return budget;
+    }
+    return remaining;
+}
+
+int qemu_plugin_crucible_fault_poll(
+    struct qemu_plugin_crucible_fault_result *result,
+    uint8_t *payload, size_t payload_capacity, size_t *payload_length)
+{
+    CrucibleCompletedFault *completed;
+
+    if (!result || !payload_length) {
+        return -EINVAL;
+    }
+    g_mutex_lock(&crucible_fault_lock);
+    completed = QTAILQ_FIRST(&crucible_completed_faults);
+    if (!completed) {
+        g_mutex_unlock(&crucible_fault_lock);
+        return 0;
+    }
+    *payload_length = completed->payload->len;
+    if (completed->payload->len > payload_capacity ||
+        (completed->payload->len != 0 && !payload)) {
+        g_mutex_unlock(&crucible_fault_lock);
+        return -ENOSPC;
+    }
+    *result = completed->result;
+    if (completed->payload->len != 0) {
+        memcpy(payload, completed->payload->data, completed->payload->len);
+    }
+    QTAILQ_REMOVE(&crucible_completed_faults, completed, link);
+    crucible_completed_count--;
+    g_byte_array_unref(completed->payload);
+    g_free(completed);
+    g_mutex_unlock(&crucible_fault_lock);
+    return 1;
+}
+
+int qemu_plugin_crucible_fault_peek(
+    struct qemu_plugin_crucible_fault_result *result,
+    size_t *payload_length)
+{
+    CrucibleCompletedFault *completed;
+
+    if (!result || !payload_length) {
+        return -EINVAL;
+    }
+    g_mutex_lock(&crucible_fault_lock);
+    completed = QTAILQ_FIRST(&crucible_completed_faults);
+    if (!completed) {
+        g_mutex_unlock(&crucible_fault_lock);
+        return 0;
+    }
+    *result = completed->result;
+    *payload_length = completed->payload->len;
+    g_mutex_unlock(&crucible_fault_lock);
+    return 1;
+}
