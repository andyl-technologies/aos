+static bool initial_register_child_dependency_matches(
+    const QemuCrucibleRegisterCpuDependency *row, Object *child,
+    const QemuCrucibleCpuSourceAllocationOwner *actual, size_t instance_bytes)
+{
+    if (!child) {
+        return !actual && !instance_bytes && !row->child && !row->child_owner &&
+            !row->child_receipt && !row->child_generation &&
+            !row->child_instance_bytes;
+    }
+    return actual && row->child == child && row->child_owner == actual &&
+        row->child_receipt == actual->receipt &&
+        row->child_generation == actual->request_serial &&
+        row->child_instance_bytes == instance_bytes &&
+        actual->payload_bytes == row->child_instance_bytes;
