+     * lifetimes across the unlocked Source allocation identity observation. */
+    if (!registry_identity_locked(registry, getpid()) || registry->revoked ||
+        !main_control_cpu_current_locked(cpu) ||
+        !group_identity_locked(registry, group) || group->terminal ||
+        group->kind != QEMU_CRUCIBLE_NATIVE_GROUP_CONTROL || !group->complete ||
+        group->member_count != 1 || group->members != record ||
+        !group->module_retained || !record->descriptor_retained ||
+        !record->source_authenticated || !record->references ||
+        record->owner != registry || record->ctx != registry->ctx ||
+        record->module != registry->module ||
+        record->kind != QEMU_CRUCIBLE_NATIVE_CONTROL ||
+        record->publication_serial != group->publication_serial ||
+        record->registrar_serial != group->registrar_serial ||
+        record->child_owner != group->child_owner ||
+        record->child_owner != registry->child_owner ||
+        !registry->child_registration_seen || !group_descriptor_current_locked(record)) {
+        status = -ESTALE;
+    } else if (registry->serial == UINT64_MAX || record->references == UINT_MAX) {
+        status = -EOVERFLOW;
+    } else {
+        for (size_t index = 0; index < ARRAY_SIZE(registry->frames); index++) {
+            if (!registry->frames[index].canonical_owner) {
+                frame = &registry->frames[index];
+                break;
+            }
+        }
+        status = frame ? 0 : -ENOSPC;
+    }
+    if (frame) {
+        *frame = (QemuCrucibleNativeInvocation) {
+            .owner = registry,
+            .canonical_owner = frame,
+            .registration = record,
+            .child_owner = record->child_owner,
+            .coordinate = record->coordinate,
+            .function = record->function,
+            .userdata = record->userdata,
+            .ctx = registry->ctx,
+            .module = registry->module,
+            .runtime = registry->runtime,
+            .storage = registry->storage,
+            .storage_holder = registry->storage_holder,
+            .cpu = cpu,
+            .cpu_owner = owner,
+            .cpu_receipt = receipt,
+            .cpu_generation = generation,
+            .main_holder = holder,
+            .process = getpid(),
+            .process_generation = registry->process_generation,
+            .account_generation = registry->account_generation,
+            .serial = ++registry->serial,
