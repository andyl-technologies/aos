+        !receiver->module_membership && !receiver->module_membership_serial &&
+        !receiver->module_cleanup && !receiver->module_cleanup_serial &&
+        !receiver->module_cleanup_guard && !receiver->module_cleanup_guard_serial &&
+        !receiver->module_original && !receiver->module_original_serial &&
+        !receiver->module_advance && !receiver->module_advance_serial;
