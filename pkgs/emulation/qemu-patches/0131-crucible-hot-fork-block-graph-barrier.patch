 }
 
+bool bdrv_graph_hot_fork_barrier(
+    BdrvGraphHotForkBarrierOperation operation,
+    BdrvGraphHotForkBarrierState *state)
+{
+    bool wake_waiters = false;
+
+    *state = (BdrvGraphHotForkBarrierState) { 0 };
+
+    if (operation != BDRV_GRAPH_HOT_FORK_BARRIER_QUERY) {
+        GLOBAL_STATE_CODE();
+        if (qemu_get_current_aio_context() != qemu_get_aio_context() ||
+            qemu_in_coroutine()) {
+            return false;
+        }
+    }
+
+    qemu_mutex_lock(&hot_fork_graph_lock);
+    switch (operation) {
+    case BDRV_GRAPH_HOT_FORK_BARRIER_HOLD:
+        if (!hot_fork_graph_barrier_held) {
+            if (qatomic_read(&has_writer) ||
+                qatomic_read(&hot_fork_graph_waiting_writers) != 0) {
+                qemu_mutex_unlock(&hot_fork_graph_lock);
+                return false;
+            }
+            hot_fork_graph_barrier_owner = qemu_get_thread_id();
+            hot_fork_graph_held_mutation_generation =
+                hot_fork_graph_mutation_generation;
+            qatomic_set(&hot_fork_graph_barrier_held, true);
+            hot_fork_graph_barrier_generation++;
+            assert(hot_fork_graph_barrier_generation != 0);
+        }
+        break;
+    case BDRV_GRAPH_HOT_FORK_BARRIER_QUERY:
+        break;
+    case BDRV_GRAPH_HOT_FORK_BARRIER_RELEASE:
+        if (hot_fork_graph_barrier_held) {
+            qatomic_set(&hot_fork_graph_barrier_held, false);
+            hot_fork_graph_barrier_owner = 0;
+            hot_fork_graph_held_mutation_generation = 0;
+            hot_fork_graph_barrier_generation++;
+            assert(hot_fork_graph_barrier_generation != 0);
+            wake_waiters = true;
+        }
+        break;
+    default:
+        g_assert_not_reached();
+    }
+
+    state->generation = hot_fork_graph_barrier_generation;
+    state->mutation_generation = hot_fork_graph_mutation_generation;
+    state->held_mutation_generation =
+        hot_fork_graph_held_mutation_generation;
+    state->owner_thread_id = hot_fork_graph_barrier_owner;
+    state->waiting_writers =
+        qatomic_read(&hot_fork_graph_waiting_writers);
+    state->held = qatomic_read(&hot_fork_graph_barrier_held);
+    state->writer_active = qatomic_read(&has_writer);
+    state->stable = state->held && !state->writer_active &&
+        state->mutation_generation == state->held_mutation_generation;
+    qemu_mutex_unlock(&hot_fork_graph_lock);
+    if (wake_waiters) {
+        aio_wait_kick();
+    }
+    return true;
+}
