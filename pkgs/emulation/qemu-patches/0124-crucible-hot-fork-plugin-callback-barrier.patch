+/**
+ * qemu_plugin_crucible_register_hot_fork_barrier() - register callback parking
+ * @plugin_id: nonzero identity of the registering Crucible plugin
+ * @cb: process-lifetime callback barrier operation
+ * @userdata: stable opaque pointer passed to @cb
+ *
+ * The callback exposes a reversible admission hold over every live plugin
+ * callback.  Holding the barrier is nonblocking: the returned status reports
+ * callbacks that were admitted before the hold and have not yet returned.
+ *
+ * Returns zero on success or a negative errno-style status on failure.
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_crucible_register_hot_fork_barrier(
+    qemu_plugin_id_t plugin_id,
+    qemu_plugin_crucible_hot_fork_barrier_cb_t cb,
+    void *userdata);
+
