+##
+# @CrucibleHotForkPluginBarrierAction:
+#
+# Operation over the reversible Crucible plugin callback barrier.
+#
+# @hold: reject new callbacks and report callbacks already in flight
+#
+# @query: observe the current held and in-flight state without changing it
+#
+# @release: reopen callback admission unless teardown closed it permanently
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'enum': 'CrucibleHotForkPluginBarrierAction',
+  'data': [ 'hold', 'query', 'release' ] }
+
+##
+# @CrucibleHotForkPluginBarrierState:
+#
+# Exact plugin-owned callback-admission state.  A quiescent response proves
+# only that every callback covered by the sealed callback mask is parked.  It
+# does not freeze host-side ring producers, drain plugin worker threads, or
+# acknowledge hot-fork readiness proof bit 6.
+#
+# @schema-version: barrier contract version, currently 1
+#
+# @generation: process-local barrier registration/hold generation
+#
+# @registered: whether a process-lifetime plugin barrier callback is installed
+#
+# @manifest-consistent: whether the barrier and sealed manifest name one plugin
+#
+# @held: whether new covered callbacks are currently rejected
+#
+# @teardown-closed: whether permanent teardown closure superseded the hold
+#
+# @in-flight: callbacks admitted before the hold that have not yet returned
+#
+# @quiescent: whether the registered, manifest-consistent hold has drained
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'struct': 'CrucibleHotForkPluginBarrierState',
+  'data': { 'schema-version': 'uint32',
+            'generation': 'uint64',
+            'registered': 'bool',
+            'manifest-consistent': 'bool',
+            'held': 'bool',
+            'teardown-closed': 'bool',
+            'in-flight': 'uint64',
+            'quiescent': 'bool' } }
+
+##
+# @crucible-hot-fork-plugin-barrier:
+#
+# Holds, observes, or releases the loaded Crucible plugin's reversible callback
+# barrier. Holding is accepted only at the exact paused/device-flush boundary
+# and returns without waiting for already-admitted callbacks to drain.
+#
+# @action: requested barrier operation
+#
+# Returns: @CrucibleHotForkPluginBarrierState
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'command': 'crucible-hot-fork-plugin-barrier',
+  'data': { 'action': 'CrucibleHotForkPluginBarrierAction' },
+  'returns': 'CrucibleHotForkPluginBarrierState',
+  'allow-oob': true }
+
 ##
 # @CrucibleHotForkMutex:
 #
