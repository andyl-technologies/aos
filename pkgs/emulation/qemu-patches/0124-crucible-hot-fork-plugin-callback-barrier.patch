@@ -1221,6 +1221,47 @@ QEMU_PLUGIN_API
 int qemu_plugin_crucible_register_resource_manifest(
     const struct qemu_plugin_crucible_resource_manifest *manifest);
 
+#define QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_STATUS_VERSION 1
+#define QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_HOLD 1
+#define QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_QUERY 2
+#define QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_RELEASE 3
+#define QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_FLAG_HELD (1U << 0)
+#define QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_FLAG_TEARDOWN (1U << 1)
+#define QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_FLAG_ALL \
+    (QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_FLAG_HELD | \
+     QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_FLAG_TEARDOWN)
+
+struct qemu_plugin_crucible_hot_fork_barrier_status {
+    uint32_t schema_version;
+    uint32_t struct_size;
