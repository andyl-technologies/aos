     return report;
 }
 
+CrucibleHotForkPluginBarrierState *
+qmp_crucible_hot_fork_plugin_barrier(
+    CrucibleHotForkPluginBarrierAction action, Error **errp)
+{
+    CrucibleHotForkPluginBarrierState *report =
+        g_new0(CrucibleHotForkPluginBarrierState, 1);
+    QemuPluginCrucibleHotForkBarrierInventory inventory;
+    uint32_t operation;
+    int status;
+
+    switch (action) {
+    case CRUCIBLE_HOT_FORK_PLUGIN_BARRIER_ACTION_HOLD:
+        if (!crucible_hot_fork_exact_paused_boundary()) {
+            error_setg(errp, "Crucible hot-fork plugin barrier requires "
+                       "an exact paused/device-flush boundary");
+            g_free(report);
+            return NULL;
+        }
+        operation = QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_HOLD;
+        break;
+    case CRUCIBLE_HOT_FORK_PLUGIN_BARRIER_ACTION_QUERY:
+        operation = QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_QUERY;
+        break;
+    case CRUCIBLE_HOT_FORK_PLUGIN_BARRIER_ACTION_RELEASE:
+        operation = QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_RELEASE;
+        break;
+    default:
+        error_setg(errp, "Unknown Crucible hot-fork plugin barrier action");
+        g_free(report);
+        return NULL;
+    }
+
+    status = qemu_plugin_crucible_hot_fork_barrier(operation, &inventory);
+    if (status != 0) {
+        error_setg_errno(errp, -status,
+                         "Crucible hot-fork plugin barrier operation failed");
+        g_free(report);
+        return NULL;
+    }
+
+    report->schema_version =
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_STATUS_VERSION;
+    report->generation = inventory.generation;
+    report->registered = inventory.registered;
+    report->manifest_consistent = inventory.manifest_consistent;
+    report->held = (inventory.status.flags &
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_FLAG_HELD) != 0;
+    report->teardown_closed = (inventory.status.flags &
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_FLAG_TEARDOWN) != 0;
+    report->in_flight = inventory.status.in_flight;
+    report->quiescent = report->registered && report->manifest_consistent &&
+        report->held && !report->teardown_closed && report->in_flight == 0;
+    return report;
+}
