+static QemuMutex qemu_plugin_crucible_barrier_operation_lock;
 static QemuPluginCrucibleHotForkInventory
     qemu_plugin_crucible_resource_inventory;
+static QemuPluginCrucibleHotForkBarrierInventory
+    qemu_plugin_crucible_barrier_inventory;
+static qemu_plugin_crucible_hot_fork_barrier_cb_t
+    qemu_plugin_crucible_barrier_cb;
+static void *qemu_plugin_crucible_barrier_userdata;
 static qemu_plugin_id_t qemu_plugin_crucible_observed_plugin_id;
 static bool qemu_plugin_crucible_callback_plugin_conflict;
 
@@ -128,6 +134,31 @@ static void __attribute__((__constructor__))
 qemu_plugin_crucible_resource_inventory_init(void)
 {
     qemu_mutex_init(&qemu_plugin_crucible_resource_lock);
