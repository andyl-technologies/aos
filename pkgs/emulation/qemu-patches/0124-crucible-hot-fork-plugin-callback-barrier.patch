+
+int qemu_plugin_crucible_register_hot_fork_barrier(
+    qemu_plugin_id_t plugin_id,
+    qemu_plugin_crucible_hot_fork_barrier_cb_t cb,
+    void *userdata)
+{
+    QEMU_LOCK_GUARD(&qemu_plugin_crucible_resource_lock);
+
+    if (plugin_id == 0 || !cb || !userdata) {
+        return -EINVAL;
+    }
+    if (qemu_plugin_crucible_barrier_inventory.registered) {
+        return qemu_plugin_crucible_barrier_inventory.plugin_id == plugin_id &&
+               qemu_plugin_crucible_barrier_cb == cb &&
+               qemu_plugin_crucible_barrier_userdata == userdata ? 0 :
+               -EALREADY;
+    }
+    qemu_plugin_crucible_barrier_inventory.plugin_id = plugin_id;
+    qemu_plugin_crucible_barrier_inventory.registered = true;
+    qemu_plugin_crucible_barrier_inventory.generation++;
+    qemu_plugin_crucible_barrier_cb = cb;
+    qemu_plugin_crucible_barrier_userdata = userdata;
+    return 0;
 }
 
 void qemu_plugin_crucible_callback_registered(qemu_plugin_id_t plugin_id,
@@ -233,6 +264,79 @@ void qemu_plugin_crucible_hot_fork_inventory(
         !qemu_plugin_crucible_callback_plugin_conflict &&
         inventory->manifest.callback_mask == inventory->observed_callback_mask;
 }
+
+int qemu_plugin_crucible_hot_fork_barrier(
+    uint32_t action,
+    QemuPluginCrucibleHotForkBarrierInventory *inventory)
+{
+    struct qemu_plugin_crucible_hot_fork_barrier_status status = { 0 };
+    qemu_plugin_crucible_hot_fork_barrier_cb_t cb;
+    void *userdata;
+    uint32_t previous_flags;
+    int result;
+
+    if (!inventory ||
+        (action != QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_HOLD &&
+         action != QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_QUERY &&
+         action != QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_RELEASE)) {
+        return -EINVAL;
+    }
+
+    qemu_mutex_lock(&qemu_plugin_crucible_barrier_operation_lock);
+    qemu_mutex_lock(&qemu_plugin_crucible_resource_lock);
+    if (!qemu_plugin_crucible_barrier_inventory.registered) {
+        *inventory = qemu_plugin_crucible_barrier_inventory;
+        qemu_mutex_unlock(&qemu_plugin_crucible_resource_lock);
+        qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+        return action == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_QUERY ? 0 :
+               -ENODEV;
+    }
+    cb = qemu_plugin_crucible_barrier_cb;
+    userdata = qemu_plugin_crucible_barrier_userdata;
+    qemu_mutex_unlock(&qemu_plugin_crucible_resource_lock);
+
+    result = cb(action, &status, userdata);
+    if (result != 0) {
+        qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+        return result;
+    }
+    if (status.schema_version !=
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_STATUS_VERSION ||
+        status.struct_size != sizeof(status) || status.reserved != 0 ||
+        (status.flags &
+         ~QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_FLAG_ALL) != 0 ||
+        (action == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_HOLD &&
+         (status.flags &
+          QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_FLAG_HELD) == 0) ||
+        (action == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_RELEASE &&
+         (status.flags &
+          QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_FLAG_HELD) != 0)) {
+        qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+        return -EPROTO;
+    }
+    if (action == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_HOLD &&
+        (status.flags &
+         QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_FLAG_TEARDOWN) != 0) {
+        qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+        return -ESHUTDOWN;
+    }
+
+    qemu_mutex_lock(&qemu_plugin_crucible_resource_lock);
+    previous_flags = qemu_plugin_crucible_barrier_inventory.status.flags;
+    qemu_plugin_crucible_barrier_inventory.status = status;
+    if (previous_flags != status.flags) {
+        qemu_plugin_crucible_barrier_inventory.generation++;
+    }
+    qemu_plugin_crucible_barrier_inventory.manifest_consistent =
+        qemu_plugin_crucible_resource_inventory.registered &&
+        qemu_plugin_crucible_resource_inventory.complete &&
+        qemu_plugin_crucible_resource_inventory.manifest.plugin_id ==
+            qemu_plugin_crucible_barrier_inventory.plugin_id;
+    *inventory = qemu_plugin_crucible_barrier_inventory;
+    qemu_mutex_unlock(&qemu_plugin_crucible_resource_lock);
+    qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+    return 0;
+}
