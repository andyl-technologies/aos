+/**
+ * qemu_plugin_crucible_write_memory_vaddr() - write guest virtual memory
+ * @addr: virtual address at which to begin the write
+ * @data: bytes to write
+ * @len: number of bytes to write
+ *
+ * This Crucible-only helper writes through the current vCPU's debug memory
+ * access path. It is intended for synchronous white-box doorbell replies from
+ * an instruction callback and must not be used as an asynchronous input path.
+ *
+ * Returns true on success and false when @len is zero or the complete write
+ * cannot be performed.
+ */
+QEMU_PLUGIN_API
+bool qemu_plugin_crucible_write_memory_vaddr(uint64_t addr,
+                                             const uint8_t *data,
+                                             size_t len);
+
+/**
+ * qemu_plugin_crucible_write_memory_vaddr_for_vcpu() - write one vCPU's memory
+ * @vcpu_index: exact vCPU whose resume callback authorizes the write
+ * @addr: virtual address at which to begin the write
+ * @data: bytes to write
+ * @len: number of bytes to write
+ *
+ * This Crucible-only helper is restricted to a serialized vCPU resume callback
+ * before guest execution.  It resolves @vcpu_index explicitly because an
+ * RR-wide resume sweep must not depend on ambient current_cpu state.
+ *
+ * Returns true on success and false for an unknown vCPU, zero length, or an
+ * incomplete write.
+ */
+QEMU_PLUGIN_API
+bool qemu_plugin_crucible_write_memory_vaddr_for_vcpu(
+    unsigned int vcpu_index, uint64_t addr, const uint8_t *data, size_t len);
