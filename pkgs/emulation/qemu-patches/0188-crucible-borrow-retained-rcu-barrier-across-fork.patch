+static void *monitor_registry_worker_with_rcu_barrier(void *opaque)
+{
+    RegistryWorker *worker = opaque;
+    QemuRcuHotForkBarrierInventory inventory;
+    int result = 0;
+
+    qemu_thread_hot_fork_set_current_disposition(
+        QEMU_THREAD_HOT_FORK_MONITOR_RESTART);
+    rcu_register_thread();
+    qemu_rcu_hot_fork_barrier(QEMU_RCU_HOT_FORK_BARRIER_HOLD, &inventory);
+    if (!inventory.held || !inventory.quiescent ||
+        inventory.owner_thread_id != qemu_get_thread_id()) {
+        result = -EPROTO;
+    }
+    write_child_result(worker->ready_fd, result);
+    if (result == 0) {
+        (void)read_child_result(worker->release_fd);
+    }
+    if (inventory.held &&
+        inventory.owner_thread_id == qemu_get_thread_id()) {
+        qemu_rcu_hot_fork_barrier(QEMU_RCU_HOT_FORK_BARRIER_RELEASE,
+                                  &inventory);
+    }
+    rcu_unregister_thread();
+    return NULL;
+}
