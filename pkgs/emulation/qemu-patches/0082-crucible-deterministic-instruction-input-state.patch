+int qemu_crucible_fault_execution_and_register_fingerprints(
+    uint64_t observed_icount, uint8_t execution_fingerprint[32],
+    uint8_t register_fingerprint[32])
+{
+    g_autoptr(GChecksum) execution = g_checksum_new(G_CHECKSUM_SHA256);
+    g_autoptr(GChecksum) registers = g_checksum_new(G_CHECKSUM_SHA256);
+    struct qemu_plugin_rr_cursor rr = { 0 };
+    gsize execution_len = 32;
+    gsize register_len = 32;
+    size_t cpu_count;
+    uint8_t coordinate[32];
+
+    if (!execution_fingerprint || !register_fingerprint ||
+        qemu_plugin_rr_cursor(&rr) != 0) {
+        return -EINVAL;
+    }
+    g_checksum_update(
+        execution,
+        (const uint8_t *)"crucible.register-fingerprint.v1\0",
+        strlen("crucible.register-fingerprint.v1") + 1);
+    stq_le_p(coordinate, observed_icount);
+    stq_le_p(coordinate + 8, rr.current_vcpu);
+    stq_le_p(coordinate + 16, rr.cursor_position);
+    stq_le_p(coordinate + 24, rr.rr_switch_quantum);
+    g_checksum_update(execution, coordinate, sizeof(coordinate));
+    g_checksum_update(
+        registers,
+        (const uint8_t *)"crucible.register-state.v1\0",
+        strlen("crucible.register-state.v1") + 1);
+    if (crucible_register_state_update(
+            execution, registers, &cpu_count) != 0 ||
+        rr.current_vcpu >= cpu_count) {
+        return -EIO;
+    }
+    g_checksum_get_digest(
+        execution, execution_fingerprint, &execution_len);
+    g_checksum_get_digest(registers, register_fingerprint, &register_len);
+    return execution_len == 32 && register_len == 32 ? 0 : -EIO;
+}
