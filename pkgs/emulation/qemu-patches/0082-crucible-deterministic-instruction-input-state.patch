+static int crucible_register_execution_fingerprint(
+    uint64_t icount, const struct qemu_plugin_rr_cursor *rr,
+    uint8_t output[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize digest_len = 32;
+    size_t cpu_count;
+    uint8_t coordinate[32];
+
+    g_checksum_update(checksum,
+                      (const uint8_t *)"crucible.register-fingerprint.v1\0",
+                      strlen("crucible.register-fingerprint.v1") + 1);
+    stq_le_p(coordinate, icount);
+    stq_le_p(coordinate + 8, rr->current_vcpu);
+    stq_le_p(coordinate + 16, rr->cursor_position);
+    stq_le_p(coordinate + 24, rr->rr_switch_quantum);
+    g_checksum_update(checksum, coordinate, sizeof(coordinate));
+    if (crucible_register_state_update(checksum, NULL, &cpu_count) != 0 ||
+        rr->current_vcpu >= cpu_count) {
+        return -EIO;
+    }
     g_checksum_get_digest(checksum, output, &digest_len);
     return digest_len == 32 ? 0 : -EIO;
 }
