+static int crucible_hot_fork_authenticate_diagnostics_target(
+    const QemuCrucibleHotForkDiagnosticsChildResourcePlan *diagnostics)
+{
+#ifdef __linux__
+    struct sockaddr_storage peer;
+    socklen_t length;
+    uint64_t socket_cookie = 0;
+    int domain = 0;
+    int type = 0;
+    int flags;
+
+    if (!diagnostics || !diagnostics->prepared ||
+        diagnostics->replacement.target_fd !=
+            QEMU_CRUCIBLE_HOT_FORK_DIAGNOSTIC_TARGET_FD) {
+        return -EINVAL;
+    }
+    length = sizeof(domain);
+    if (getsockopt(diagnostics->replacement.target_fd, SOL_SOCKET, SO_DOMAIN,
+                   &domain, &length) != 0) {
+        return -errno;
+    }
+    if (length != sizeof(domain) || domain != AF_UNIX) {
+        return -EPROTOTYPE;
+    }
+    length = sizeof(type);
+    if (getsockopt(diagnostics->replacement.target_fd, SOL_SOCKET, SO_TYPE,
+                   &type, &length) != 0) {
+        return -errno;
+    }
+    if (length != sizeof(type) || type != SOCK_STREAM) {
+        return -EPROTOTYPE;
+    }
+    length = sizeof(socket_cookie);
+    if (getsockopt(diagnostics->replacement.target_fd, SOL_SOCKET, SO_COOKIE,
+                   &socket_cookie, &length) != 0) {
+        return -errno;
+    }
+    if (length != sizeof(socket_cookie) ||
+        socket_cookie != diagnostics->socket_cookie) {
+        return -ESTALE;
+    }
+    length = sizeof(peer);
+    if (getpeername(diagnostics->replacement.target_fd,
+                    (struct sockaddr *)&peer, &length) != 0) {
+        return -errno;
+    }
+    flags = fcntl(diagnostics->replacement.target_fd, F_GETFL);
+    if (flags < 0) {
+        return -errno;
+    }
+    if ((flags & O_NONBLOCK) == 0) {
+        return -EPROTO;
+    }
+    return 0;
+#else
+    return -ENOTSUP;
+#endif
+}
