+static bool crucible_hot_fork_diagnostic_socket_cookie(
+    int fd, uint64_t *cookie, Error **errp)
+{
+    int flags;
+
+    if (!crucible_hot_fork_control_socket_cookie(fd, cookie, errp)) {
+        return false;
+    }
+    flags = fcntl(fd, F_GETFL);
+    if (flags < 0) {
+        error_setg_errno(errp, errno,
+                         "Could not inspect Crucible diagnostic flags");
+        return false;
+    }
+    if ((flags & O_NONBLOCK) == 0) {
+        if (fcntl(fd, F_SETFL, flags | O_NONBLOCK) < 0) {
+            error_setg_errno(errp, errno,
+                             "Could not make Crucible diagnostics nonblocking");
+            return false;
+        }
+        flags = fcntl(fd, F_GETFL);
+    }
+    if (flags < 0 || (flags & O_NONBLOCK) == 0) {
+        if (flags < 0) {
+            error_setg_errno(errp, errno,
+                             "Could not verify Crucible diagnostic flags");
+        } else {
+            error_setg(errp, "Crucible diagnostics remained blocking");
+        }
+        return false;
+    }
+    return true;
+}
