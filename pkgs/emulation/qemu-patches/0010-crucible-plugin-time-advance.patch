diff --git a/accel/tcg/icount-common.c b/accel/tcg/icount-common.c
index 55e0a1a7f..928eaff3e 100644
--- a/accel/tcg/icount-common.c
+++ b/accel/tcg/icount-common.c
@@ -182,6 +182,31 @@ int64_t icount_get(void)
     return icount;
 }
 
+/*
+ * Crucible: advance the icount-derived QEMU_CLOCK_VIRTUAL to an exact target,
+ * in nanoseconds, while all vCPUs are idle. The upstream plugin time-control
+ * setter and qtest use qemu_clock_advance_virtual_time(), which only moves the
+ * virtual clock when cpus_set_virtual_clock() is wired -- i.e. in non-icount
+ * mode. Under the sim accelerator the clock is icount-derived, so advancement
+ * must add to the icount bias instead. @dest must not precede the current
+ * virtual time; earlier targets leave the clock unchanged.
+ */
+void icount_advance_virtual_time_to_ns(int64_t dest)
+{
+    int64_t now = icount_get();
+
+    if (dest > now) {
+        seqlock_write_lock(&timers_state.vm_clock_seqlock,
+                           &timers_state.vm_clock_lock);
+        qatomic_set_i64(&timers_state.qemu_icount_bias,
+                        timers_state.qemu_icount_bias + (dest - now));
+        seqlock_write_unlock(&timers_state.vm_clock_seqlock,
+                             &timers_state.vm_clock_lock);
+    }
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    qemu_clock_notify(QEMU_CLOCK_VIRTUAL);
+}
+
 int64_t icount_to_ns(int64_t icount)
 {
     return icount << qatomic_read(&timers_state.icount_time_shift);
