diff --git a/plugins/api-system.c b/plugins/api-system.c
index f6ad1d0dc..1e1fe2ea0 100644
--- a/plugins/api-system.c
+++ b/plugins/api-system.c
@@ -102,6 +102,14 @@ const char *qemu_plugin_hwaddr_device_name(const struct qemu_plugin_hwaddr *h)
  * Time control
  */
 static bool has_control;
+static qemu_plugin_time_advance_cb_t qemu_plugin_time_advance_cb;
+static void *qemu_plugin_time_advance_userdata;
+static int qemu_plugin_time_advance_pending;
+static int qemu_plugin_time_advance_status;
+static int64_t qemu_plugin_time_advance_target;
+
+static void qemu_plugin_time_advance_barrier_bh(void *opaque);
+static void qemu_plugin_time_advance_complete_bh(void *opaque);
 
 bool qemu_plugin_has_time_control(void)
 {
@@ -133,6 +141,87 @@ void qemu_plugin_update_ns(const void *handle, int64_t new_time)
     }
 }
 
+int qemu_plugin_register_time_advance_cb(qemu_plugin_time_advance_cb_t cb,
+                                         void *userdata)
+{
+    if (qatomic_read(&qemu_plugin_time_advance_pending)) {
+        return -EBUSY;
+    }
+
+    qemu_plugin_time_advance_userdata = userdata;
+    qemu_plugin_time_advance_cb = cb;
+    return 0;
+}
+
+bool qemu_plugin_time_advance_is_pending(void)
+{
+    return qatomic_load_acquire(&qemu_plugin_time_advance_pending) != 0;
+}
+
+static void qemu_plugin_advance_time_bh(void *opaque)
+{
+    int64_t new_time = qatomic_read(&qemu_plugin_time_advance_target);
+    int status = 0;
+
+    (void)opaque;
+    if (!has_control) {
+        status = -ENODEV;
+    } else {
+        icount_advance_virtual_time_to_ns(new_time);
+    }
+
+    qatomic_set(&qemu_plugin_time_advance_status, status);
+    aio_bh_schedule_oneshot(qemu_get_aio_context(),
+                            qemu_plugin_time_advance_barrier_bh, NULL);
+}
+
+static void qemu_plugin_time_advance_barrier_bh(void *opaque)
+{
+    (void)opaque;
+    /*
+     * AioContext BHs are inserted at the head. Rescheduling completion from
+     * this first main-loop pass makes every timer-produced BH that was already
+     * captured in the current slice run before completion on the next pass.
+     */
+    aio_bh_schedule_oneshot(qemu_get_aio_context(),
+                            qemu_plugin_time_advance_complete_bh, NULL);
+}
+
+static void qemu_plugin_time_advance_complete_bh(void *opaque)
+{
+    qemu_plugin_time_advance_cb_t cb = qemu_plugin_time_advance_cb;
+    void *userdata = qemu_plugin_time_advance_userdata;
+    int status = qatomic_read(&qemu_plugin_time_advance_status);
+    int64_t target = qatomic_read(&qemu_plugin_time_advance_target);
+
+    (void)opaque;
+    qatomic_store_release(&qemu_plugin_time_advance_pending, 0);
+    if (cb) {
+        cb(status, target, userdata);
+    }
+    if (first_cpu) {
+        qemu_cpu_kick(first_cpu);
+    }
+}
+
+int qemu_plugin_advance_time_ns(int64_t new_time)
+{
+    if (new_time < 0) {
+        return -EINVAL;
+    }
+    if (!has_control || !qemu_plugin_time_advance_cb) {
+        return -ENODEV;
+    }
+    if (qatomic_cmpxchg(&qemu_plugin_time_advance_pending, 0, 1) != 0) {
+        return -EBUSY;
+    }
+
+    qatomic_set(&qemu_plugin_time_advance_target, new_time);
+    aio_bh_schedule_oneshot(qemu_get_aio_context(),
+                            qemu_plugin_advance_time_bh, NULL);
+    return 0;
+}
