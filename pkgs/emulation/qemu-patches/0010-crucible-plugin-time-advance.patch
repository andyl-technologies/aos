+/**
+ * qemu_plugin_has_time_control() - report whether a plugin owns virtual time
+ *
+ * Returns true after qemu_plugin_request_time_control() grants ownership to a
+ * plugin. Crucible uses this predicate to suppress realtime icount warp while
+ * the deterministic scheduler owns idle virtual-time advancement.
+ */
+QEMU_PLUGIN_API
+bool qemu_plugin_has_time_control(void);
+
+/**
+ * typedef qemu_plugin_time_advance_cb_t - queued time-advance completion
+ * @status: zero on success or a negative errno-style failure
+ * @time: requested absolute QEMU_CLOCK_VIRTUAL time in nanoseconds
+ * @userdata: opaque pointer supplied at registration
+ *
+ * The callback runs from QEMU's normal main-loop bottom-half context after a
+ * preceding main-loop bottom half has advanced virtual time and dispatched due
+ * virtual timers. It never runs nested inside a vCPU/plugin callback.
+ */
+typedef void (*qemu_plugin_time_advance_cb_t)(int status, int64_t time,
+                                              void *userdata);
+
+/**
+ * qemu_plugin_register_time_advance_cb() - register advance completion
+ * @cb: completion callback, or NULL to clear it
+ * @userdata: opaque pointer passed to @cb
+ *
+ * Returns: zero on success or -EBUSY while an advance is outstanding.
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_register_time_advance_cb(qemu_plugin_time_advance_cb_t cb,
+                                         void *userdata);
+
+/**
+ * qemu_plugin_advance_time_ns() - enqueue an absolute virtual-time advance
+ * @time: absolute QEMU_CLOCK_VIRTUAL time in nanoseconds
+ *
+ * This callback-safe entry point queues work on the normal main-loop
+ * AioContext. The queued bottom half advances the clock and dispatches due
+ * virtual timers while holding BQL, then hands completion to a later main-loop
+ * pass. It never calls main_loop_wait(), aio_poll(), or aio_bh_poll(), and does
+ * not depend on a vCPU being runnable (an I/O-blocked vCPU may request it).
+ *
+ * Returns: zero when queued, -EINVAL for negative time, -ENODEV without time
+ * control or a completion callback, and -EBUSY for overlap.
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_advance_time_ns(int64_t time);
