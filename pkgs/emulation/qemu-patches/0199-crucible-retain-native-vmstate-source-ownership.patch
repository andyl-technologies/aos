+static void test_hot_fork_vmstate_source(void)
+{
+    char path[] = "/tmp/qemu-hot-fork-vmstate-XXXXXX";
+    int fd = mkstemp(path);
+    BlockDriverState *root;
+    QemuBlockBackendHotForkReadOnlySource *source;
+    BdrvCrucibleHotForkFileState original, frozen;
+    BlockBackend *other;
+    uint8_t written[512], observed[512];
+
+    g_assert_cmpint(fd, >=, 0);
+    close(fd);
+    root = test_hot_fork_vmstate_open(path);
+    memset(written, 0x5a, sizeof(written));
+    g_assert_cmpint(bdrv_save_vmstate(root, written, 0, sizeof(written)),
+                    ==, sizeof(written));
+    original = test_hot_fork_file_state(root);
+    g_assert_false(original.read_only);
+
+    source = qemu_block_hot_fork_read_only_node_new(root, &error_abort);
+    g_assert_nonnull(source);
+    other = blk_new(qemu_get_aio_context(), BLK_PERM_CONSISTENT_READ, BLK_PERM_ALL);
+    g_assert_cmpint(blk_insert_bs(other, root, &error_abort), ==, 0);
+    g_assert_false(qemu_block_backend_hot_fork_read_only_source_freeze(source, NULL));
+    g_assert_null(qemu_block_hot_fork_read_only_node_new(root, NULL));
+    blk_unref(other);
+
+    g_assert_true(qemu_block_backend_hot_fork_read_only_source_freeze(
+        source, &error_abort));
+    g_assert_true(qemu_block_backend_hot_fork_read_only_source_is_frozen(source));
+    g_assert_true(qemu_block_hot_fork_all_sources_read_only(&error_abort));
+    frozen = test_hot_fork_file_state(root);
+    g_assert_true(frozen.read_only);
+    g_assert_cmpuint(frozen.device, ==, original.device);
+    g_assert_cmpuint(frozen.inode, ==, original.inode);
+    g_assert_cmpint(bdrv_load_vmstate(root, observed, 0, sizeof(observed)),
+                    ==, sizeof(observed));
+    g_assert_cmpmem(written, sizeof(written), observed, sizeof(observed));
+#ifdef __linux__
+    {
+        pid_t child = fork();
+        int status;
+
+        g_assert_cmpint(child, >=, 0);
+        if (child == 0) {
+            bool rejected =
+                !qemu_block_backend_hot_fork_read_only_source_restore(source, NULL) &&
+                !qemu_block_backend_hot_fork_read_only_source_free(source, NULL);
+            _exit(rejected ? 0 : 1);
+        }
+        g_assert_cmpint(waitpid(child, &status, 0), ==, child);
+        g_assert_true(WIFEXITED(status));
+        g_assert_cmpint(WEXITSTATUS(status), ==, 0);
+    }
+#endif
+    g_assert_true(qemu_block_backend_hot_fork_read_only_source_restore(
+        source, &error_abort));
+    g_assert_false(test_hot_fork_file_state(root).read_only);
+    g_assert_cmpint(bdrv_save_vmstate(root, written, sizeof(written), sizeof(written)),
+                    ==, sizeof(written));
+    g_assert_true(qemu_block_backend_hot_fork_read_only_source_free(
+        source, &error_abort));
+    bdrv_unref(root);
+    unlink(path);
+}
