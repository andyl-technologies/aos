+static BdrvCrucibleHotForkFileState test_hot_fork_file_state(BlockDriverState *root)
+{
+    BdrvCrucibleHotForkFileState file;
+    GRAPH_RDLOCK_GUARD_MAINLOOP();
+    BlockDriverState *node = root->file->bs;
+
+    g_assert_true(node->drv->bdrv_crucible_hot_fork_file(
+        node, BDRV_CRUCIBLE_HOT_FORK_FILE_QUERY, &file, &error_abort));
+    return file;
+}
