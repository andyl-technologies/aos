+static bool GRAPH_RDLOCK raw_crucible_hot_fork_file(
+    BlockDriverState *bs, BdrvCrucibleHotForkFileAction action,
+    BdrvCrucibleHotForkFileState *state, Error **errp)
+{
+    BDRVRawState *s = bs->opaque;
+    struct stat metadata;
+    int flags;
+
+    GLOBAL_STATE_CODE();
+    if (s->fd < 0 || s->reopen_state || s->perm_change_fd ||
+        fstat(s->fd, &metadata) < 0 || !S_ISREG(metadata.st_mode) ||
+        (flags = fcntl(s->fd, F_GETFL)) < 0) {
+        error_setg(errp, "Crucible source requires a settled regular-file descriptor");
+        return false;
+    }
+    switch (action) {
+    case BDRV_CRUCIBLE_HOT_FORK_FILE_PIN:
+        if (s->crucible_source_pins == UINT_MAX) {
+            error_setg(errp, "Crucible file source pin count is exhausted");
+            return false;
+        }
+        s->crucible_source_pins++;
+        break;
+    case BDRV_CRUCIBLE_HOT_FORK_FILE_UNPIN:
+        if (!s->crucible_source_pins) {
+            error_setg(errp, "Crucible file source has no retained pin");
+            return false;
+        }
+        s->crucible_source_pins--;
+        break;
+    case BDRV_CRUCIBLE_HOT_FORK_FILE_QUERY:
+        break;
+    default:
+        error_setg(errp, "Invalid Crucible file source action");
+        return false;
+    }
+    *state = (BdrvCrucibleHotForkFileState) {
+        .device = metadata.st_dev,
+        .inode = metadata.st_ino,
+        .read_only = (flags & O_ACCMODE) == O_RDONLY,
+    };
+    return true;
+}
