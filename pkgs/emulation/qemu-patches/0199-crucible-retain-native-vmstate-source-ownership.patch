+static void test_hot_fork_block_mutex_lifetime(void)
+{
+    QemuMutexHotForkInventory baseline, live, retired;
+    unsigned cycle;
+
+    qemu_mutex_hot_fork_inventory(&baseline);
+    g_assert_false(baseline.overflowed);
+    for (cycle = 0; cycle < 1024; cycle++) {
+        BlockDriverState *node = bdrv_new();
+
+        qemu_mutex_hot_fork_inventory(&live);
+        g_assert_false(live.overflowed);
+        g_assert_cmpuint(live.entry_count, ==, baseline.entry_count + 2);
+        qemu_mutex_hot_fork_inventory_destroy(&live);
+
+        bdrv_unref(node);
+        qemu_mutex_hot_fork_inventory(&retired);
+        g_assert_false(retired.overflowed);
+        g_assert_cmpuint(retired.entry_count, ==, baseline.entry_count);
+        g_assert_cmpuint(retired.generation, ==, baseline.generation + 4 * (cycle + 1));
+        qemu_mutex_hot_fork_inventory_destroy(&retired);
+    }
+    qemu_mutex_hot_fork_inventory_destroy(&baseline);
+}
