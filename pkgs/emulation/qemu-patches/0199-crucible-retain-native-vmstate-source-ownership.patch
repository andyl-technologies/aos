+static void test_hot_fork_source_reopen_identity(void)
+{
+    char path[] = "/tmp/qemu-hot-fork-identity-XXXXXX";
+    char replacement[] = "/tmp/qemu-hot-fork-replacement-XXXXXX";
+    g_autofree char *saved = NULL;
+    int fd = mkstemp(path);
+    int replacement_fd = mkstemp(replacement);
+    BlockDriverState *root;
+    QemuBlockBackendHotForkReadOnlySource *source;
+    BdrvCrucibleHotForkFileState original, rejected;
+    Error *local_err = NULL;
+
+    g_assert_cmpint(fd, >=, 0);
+    g_assert_cmpint(replacement_fd, >=, 0);
+    close(fd);
+    close(replacement_fd);
+    saved = g_strdup_printf("%s.saved", path);
+    root = test_hot_fork_vmstate_open(path);
+    original = test_hot_fork_file_state(root);
+    source = qemu_block_hot_fork_read_only_node_new(root, &error_abort);
+    g_assert_cmpint(rename(path, saved), ==, 0);
+    g_assert_cmpint(rename(replacement, path), ==, 0);
+
+    g_assert_false(qemu_block_backend_hot_fork_read_only_source_freeze(
+        source, &local_err));
+    g_assert_nonnull(local_err);
+    g_assert_nonnull(strstr(error_get_pretty(local_err), "file identity"));
+    error_free(local_err);
+    rejected = test_hot_fork_file_state(root);
+    g_assert_cmpuint(rejected.device, ==, original.device);
+    g_assert_cmpuint(rejected.inode, ==, original.inode);
+    g_assert_false(rejected.read_only);
+    g_assert_false(qemu_block_backend_hot_fork_read_only_source_is_frozen(source));
+
+    g_assert_cmpint(rename(path, replacement), ==, 0);
+    g_assert_cmpint(rename(saved, path), ==, 0);
+    g_assert_true(qemu_block_backend_hot_fork_read_only_source_restore(
+        source, &error_abort));
+    g_assert_true(qemu_block_backend_hot_fork_read_only_source_freeze(
+        source, &error_abort));
+    g_assert_true(qemu_block_backend_hot_fork_read_only_source_restore(
+        source, &error_abort));
+    g_assert_true(qemu_block_backend_hot_fork_read_only_source_free(
+        source, &error_abort));
+    bdrv_unref(root);
+    unlink(path);
+    unlink(replacement);
+}
