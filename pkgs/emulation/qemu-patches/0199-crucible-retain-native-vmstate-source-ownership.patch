+static BlockDriverState *test_hot_fork_vmstate_open(const char *path)
+{
+    QDict *options = qdict_new();
+
+    bdrv_img_create(path, "qcow2", NULL, NULL, NULL,
+                    HOT_FORK_SNAPSHOT_SIZE, BDRV_O_RDWR, true, &error_abort);
+    qdict_put_str(options, "driver", "qcow2");
+    qdict_put_str(options, "node-name", "vmstate");
+    qdict_put_str(options, "file.driver", "file");
+    qdict_put_str(options, "file.filename", path);
+    return bdrv_open(NULL, NULL, options, BDRV_O_RDWR, &error_abort);
