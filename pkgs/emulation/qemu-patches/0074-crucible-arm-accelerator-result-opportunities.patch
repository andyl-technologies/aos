+static int accelerator_result_rule_compare(gconstpointer left,
+                                           gconstpointer right)
+{
+    const QemuCrucibleFaultRule *a = *(const void * const *)left;
+    const QemuCrucibleFaultRule *b = *(const void * const *)right;
+    uint64_t a_sequence;
+    uint64_t b_sequence;
+    int order = memcmp(qemu_crucible_fault_rule_binding_hash(a),
+                       qemu_crucible_fault_rule_binding_hash(b), 32);
+
+    if (order == 0) {
+        order = memcmp(qemu_crucible_fault_rule_action_hash(a),
+                       qemu_crucible_fault_rule_action_hash(b), 32);
+    }
+    if (order != 0) {
+        return order;
+    }
+    a_sequence = qemu_crucible_fault_rule_command_sequence(a);
+    b_sequence = qemu_crucible_fault_rule_command_sequence(b);
+
+    return a_sequence == b_sequence ? 0 : (a_sequence < b_sequence ? -1 : 1);
+}
+
+static int accelerator_result_impulse_compare(gconstpointer left,
+                                              gconstpointer right)
+{
+    const CrucibleAcceleratorResultImpulse *a = *(const void * const *)left;
+    const CrucibleAcceleratorResultImpulse *b = *(const void * const *)right;
+
+    return accelerator_result_rule_compare(&a->rule, &b->rule);
+}
+
+static int accelerator_result_mutation_compare(gconstpointer left,
+                                               gconstpointer right)
+{
+    const CrucibleAcceleratorResultMutation *a = *(const void * const *)left;
+    const CrucibleAcceleratorResultMutation *b = *(const void * const *)right;
+
+    return accelerator_result_rule_compare(&a->rule, &b->rule);
+}
