diff --git a/monitor/qmp-cmds.c b/monitor/qmp-cmds.c
index 387bba11b..e34d25dc4 100644
--- a/monitor/qmp-cmds.c
+++ b/monitor/qmp-cmds.c
@@ -4602,10 +4602,28 @@ static int crucible_hot_fork_apply_child_process_contract(
 #define CRUCIBLE_HOT_FORK_CHILD_STEP_EXIT_BASE 64
 #define CRUCIBLE_HOT_FORK_CHILD_DETAIL_EXIT_BASE 96
 
-static void G_NORETURN crucible_hot_fork_child_exit_at(unsigned int step)
+static void G_NORETURN crucible_hot_fork_child_exit_at(unsigned int step,
+                                                       int result)
 {
     unsigned int detail = qemu_crucible_hot_fork_child_detail();
+    char report[96];
+    int length;
 
+    /*
+     * The exit status names the failing step or detail, but not the result
+     * that failed it.  Once descriptor application has routed this process's
+     * stderr to the branch-private diagnostics stream, the host reads the
+     * exact result there; before that the line goes wherever the source's
+     * stderr went.
+     */
+    length = snprintf(report, sizeof(report),
+                      "crucible hot-fork child failed: step %u detail %u "
+                      "result %d\n", step, detail, result);
+    if (length > 0 && length < (int)sizeof(report)) {
+        ssize_t written = write(STDERR_FILENO, report, (size_t)length);
+
+        (void)written;
+    }
     if (step == 9 && detail != 0) {
         _exit(CRUCIBLE_HOT_FORK_CHILD_DETAIL_EXIT_BASE + detail);
     }
@@ -4696,19 +4714,19 @@ static int crucible_hot_fork_finish_child_operation(void *opaque)
     }
     qemu_block_backend_hot_fork_barrier_inventory_destroy(&block);
     if (result != 0) {
-        crucible_hot_fork_child_exit_at(step);
+        crucible_hot_fork_child_exit_at(step, result);
     }
     if (crucible_hot_fork_child_files_plan) {
         /* Adoption consumes both the inherited plan and the source set. */
         if (!qemu_block_hot_fork_child_files_install(
                 crucible_hot_fork_child_files_plan, NULL)) {
-            crucible_hot_fork_child_exit_at(13);
+            crucible_hot_fork_child_exit_at(13, -EPROTO);
         }
         crucible_hot_fork_child_files_plan = NULL;
         operation->child_files = NULL;
     } else if (!qemu_block_hot_fork_source_set_release_empty_child(
                    crucible_hot_fork_template_sources, NULL)) {
-        crucible_hot_fork_child_exit_at(14);
+        crucible_hot_fork_child_exit_at(14, -EPROTO);
     }
     crucible_hot_fork_template_sources = NULL;
     /* Inherited destination duplicates were closed by descriptor disposition. */
@@ -4741,7 +4759,7 @@ static int crucible_hot_fork_finish_child_operation(void *opaque)
     result = monitor_hot_fork_release_child_protocol_input(
         &crucible_hot_fork_qmp_child_basis);
     if (result != 0) {
-        crucible_hot_fork_child_exit_at(15);
+        crucible_hot_fork_child_exit_at(15, result);
     }
     return 0;
 }
