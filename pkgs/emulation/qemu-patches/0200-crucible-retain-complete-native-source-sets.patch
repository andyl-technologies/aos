+
+static AioContext *test_hot_fork_foreign_consumer_context(BdrvChild *child)
+{
+    return qemu_get_aio_context();
+}
+
+static const BdrvChildClass test_hot_fork_foreign_consumer = {
+    .get_parent_desc = test_hot_fork_foreign_consumer_description,
+    .get_parent_aio_context = test_hot_fork_foreign_consumer_context,
+};
+
+static void test_hot_fork_source_set(void)
+{
+    HotForkSourceSetFixture fixture;
+    QemuBlockHotForkSourceSet *set;
+    QemuBlockHotForkSourceSetInventory inventory;
+    QemuBlockBackendHotForkBarrierInventory barrier;
+    BlockDriverState *extra;
+    BlockBackend *consumer;
+    uint8_t written[512], observed[512];
+
+    test_hot_fork_source_set_setup(&fixture, false);
+    memset(written, 0xa7, sizeof(written));
+    g_assert_cmpint(bdrv_save_vmstate(fixture.roots[0].root, written, 0,
+                                     sizeof(written)), ==, sizeof(written));
+    g_assert_cmpint(blk_pwrite(fixture.roots[1].backend, 0, sizeof(written),
+                               written, 0), ==, 0);
+    g_assert_null(qemu_block_hot_fork_source_set_new(fixture.roots, 2, NULL));
+    g_assert_null(qemu_block_hot_fork_source_set_new(fixture.roots + 1, 2, NULL));
+    {
+        QemuBlockHotForkSourceRoot duplicate[] = {
+            fixture.roots[0], fixture.roots[0], fixture.roots[1], fixture.roots[2],
+        };
+
+        g_assert_null(qemu_block_hot_fork_source_set_new(
+            duplicate, G_N_ELEMENTS(duplicate), NULL));
+    }
+    set = qemu_block_hot_fork_source_set_new(fixture.roots, 3, &error_abort);
+    g_assert_nonnull(set);
+    g_assert_true(qemu_block_hot_fork_source_set_query(set, &inventory,
+                                                     &error_abort));
+    g_assert_cmpuint(inventory.roots, ==, 3);
+    g_assert_cmpuint(inventory.nodes, ==, 6);
+    g_assert_cmpuint(inventory.originally_writable_roots, ==, 2);
+    g_assert_false(inventory.frozen);
+
+    /* Complete coverage includes empty backends and unowned raw BDS objects. */
+    consumer = blk_new(qemu_get_aio_context(), 0, BLK_PERM_ALL);
+    g_assert_false(qemu_block_hot_fork_source_set_freeze(set, NULL));
+    g_assert_false(bdrv_is_read_only(fixture.roots[0].root));
+    g_assert_false(bdrv_is_read_only(fixture.roots[1].root));
+    blk_unref(consumer);
+    extra = bdrv_new();
+    g_assert_false(qemu_block_hot_fork_source_set_query(set, &inventory, NULL));
+    g_assert_cmpuint(inventory.roots, ==, 0);
+    g_assert_false(qemu_block_hot_fork_source_set_freeze(set, NULL));
+    bdrv_unref(extra);
+
+    /* A second consumer of a file leaf cannot slip through root-only checks. */
+    consumer = blk_new(qemu_get_aio_context(), 0, BLK_PERM_ALL);
+    g_assert_cmpint(blk_insert_bs(consumer, fixture.roots[1].root->file->bs,
+                                  &error_abort), ==, 0);
+    g_assert_false(qemu_block_hot_fork_source_set_freeze(set, NULL));
+    blk_unref(consumer);
+    {
+        BdrvChild *foreign;
+        BlockDriverState *leaf = fixture.roots[1].root->file->bs;
+        Error *local_err = NULL;
+
+        bdrv_ref(leaf);
+        bdrv_graph_wrlock();
+        foreign = bdrv_root_attach_child(
+            leaf, "unowned", &test_hot_fork_foreign_consumer,
+            BDRV_CHILD_DATA, 0, BLK_PERM_ALL, NULL, &error_abort);
+        bdrv_graph_wrunlock();
+        g_assert_nonnull(foreign);
+        g_assert_false(qemu_block_hot_fork_source_set_query(
+            set, &inventory, &local_err));
+        g_assert_nonnull(local_err);
+        g_assert_nonnull(strstr(error_get_pretty(local_err), "unowned graph consumer"));
+        error_free(local_err);
+        g_assert_false(qemu_block_hot_fork_source_set_freeze(set, NULL));
+        bdrv_graph_wrlock();
+        bdrv_root_unref_child(foreign);
+        bdrv_graph_wrunlock();
+    }
+    g_assert_true(qemu_block_hot_fork_source_set_freeze(set, &error_abort));
+    g_assert_true(qemu_block_hot_fork_source_set_query(set, &inventory,
+                                                     &error_abort));
+    g_assert_true(inventory.frozen);
+    g_assert_cmpuint(inventory.originally_writable_roots, ==, 2);
