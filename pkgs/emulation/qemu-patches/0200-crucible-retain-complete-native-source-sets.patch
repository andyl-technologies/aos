+} HotForkSourceSetFixture;
+
+static void test_hot_fork_source_set_setup(HotForkSourceSetFixture *fixture,
+                                          bool writable_file)
+{
+    size_t index;
+
+    memset(fixture, 0, sizeof(*fixture));
+    for (index = 0; index < G_N_ELEMENTS(fixture->paths); index++) {
+        int fd;
+        QDict *options;
+        BlockBackend *backend;
+
+        g_snprintf(fixture->paths[index], sizeof(fixture->paths[index]),
+                    "/tmp/qemu-hot-fork-source-set-%zu-XXXXXX", index);
+        fd = mkstemp(fixture->paths[index]);
+        g_assert_cmpint(fd, >=, 0);
+        close(fd);
+        if (index == 0) {
+            fixture->roots[index].root =
+                test_hot_fork_vmstate_open(fixture->paths[index]);
+            continue;
+        }
+        bdrv_img_create(fixture->paths[index], "qcow2", NULL, NULL, NULL,
+                        HOT_FORK_SNAPSHOT_SIZE, BDRV_O_RDWR, true, &error_abort);
+        options = qdict_new();
+        qdict_put_str(options, "driver", "qcow2");
+        qdict_put_str(options, "node-name",
+                       index == 1 ? "set-disk" : "set-readonly");
+        qdict_put_str(options, "file.driver", "file");
+        qdict_put_str(options, "file.filename", fixture->paths[index]);
+        if (index == 1 && writable_file) {
+            qdict_put_bool(options, "file.read-only", false);
+        }
+        backend = blk_new_open(NULL, NULL, options,
+                                index == 1 ? BDRV_O_RDWR : 0, &error_abort);
+        fixture->roots[index].backend = backend;
+        fixture->roots[index].root = blk_bs(backend);
+    }
+}
+
+static void test_hot_fork_source_set_cleanup(HotForkSourceSetFixture *fixture)
+{
+    size_t index;
+
+    bdrv_unref(fixture->roots[0].root);
+    for (index = 1; index < G_N_ELEMENTS(fixture->roots); index++) {
+        blk_unref(fixture->roots[index].backend);
+    }
+    for (index = 0; index < G_N_ELEMENTS(fixture->paths); index++) {
+        unlink(fixture->paths[index]);
+    }
