+static void test_hot_fork_source_set_partial_restore(void)
+{
+    HotForkSourceSetFixture fixture;
+    QemuBlockHotForkSourceSet *set;
+    QemuBlockHotForkSourceSetInventory inventory;
+    Error *local_err = NULL;
+
+    test_hot_fork_source_set_setup(&fixture, true);
+    set = qemu_block_hot_fork_source_set_new(fixture.roots, 3, &error_abort);
+    g_assert_false(qemu_block_hot_fork_source_set_freeze(set, &local_err));
+    g_assert_nonnull(local_err);
+    g_assert_nonnull(strstr(error_get_pretty(local_err), "writable node"));
+    error_free(local_err);
+    g_assert_true(qemu_block_hot_fork_source_set_query(set, &inventory,
+                                                     &error_abort));
+    g_assert_false(inventory.frozen);
+    g_assert_cmpuint(inventory.originally_writable_roots, ==, 2);
+    g_assert_true(test_hot_fork_file_state(fixture.roots[0].root).read_only);
+    g_assert_true(bdrv_is_read_only(fixture.roots[1].root));
+    g_assert_false(test_hot_fork_file_state(fixture.roots[1].root).read_only);
+    g_assert_false(qemu_block_hot_fork_source_set_free(set, NULL));
+    g_assert_true(qemu_block_hot_fork_source_set_restore(set, &error_abort));
+    g_assert_true(qemu_block_hot_fork_source_set_restore(set, &error_abort));
+    g_assert_false(test_hot_fork_file_state(fixture.roots[0].root).read_only);
+    g_assert_false(test_hot_fork_file_state(fixture.roots[1].root).read_only);
+    g_assert_true(test_hot_fork_file_state(fixture.roots[2].root).read_only);
+    g_assert_true(qemu_block_hot_fork_source_set_free(set, &error_abort));
+    test_hot_fork_source_set_cleanup(&fixture);
+}
