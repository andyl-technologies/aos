+struct QemuBlockHotForkSourceSet {
+    pid_t owner;
+    GPtrArray *sources;
+    GHashTable *nodes;
+    GHashTable *backends;
+    size_t originally_writable_roots;
+};
+
+static bool source_set_owned(const QemuBlockHotForkSourceSet *set, Error **errp)
+{
+    size_t index;
+
+    if (!set || set->owner != getpid()) {
+        error_setg(errp, "Crucible source set lost its owning process");
+        return false;
+    }
+    for (index = 0; index < set->sources->len; index++) {
+        if (!source_matches(g_ptr_array_index(set->sources, index), errp)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool source_set_complete(const QemuBlockHotForkSourceSet *set, Error **errp)
+{
+    g_autoptr(GHashTable) consumers =
+        g_hash_table_new(g_direct_hash, g_direct_equal);
+    BlockDriverState *node = NULL;
+    BlockBackend *backend = NULL;
+    GHashTableIter iter;
+    gpointer key;
+    size_t nodes = 0, backends = 0;
+
+    if (!source_set_owned(set, errp)) {
+        return false;
+    }
+    GRAPH_RDLOCK_GUARD_MAINLOOP();
+    g_hash_table_iter_init(&iter, set->nodes);
+    while (g_hash_table_iter_next(&iter, &key, NULL)) {
+        BdrvChild *child;
+
+        QLIST_FOREACH(child, &((BlockDriverState *)key)->children, next) {
+            g_hash_table_add(consumers, child);
+        }
+    }
+    while ((backend = blk_all_next(backend))) {
+        if (++backends > HOT_FORK_SOURCE_MAX_VISITS ||
+            !g_hash_table_contains(set->backends, backend)) {
+            error_setg(errp, "Crucible source set has an unowned block backend");
+            return false;
+        }
+        g_hash_table_add(consumers, (gpointer)blk_root(backend));
+    }
+    while ((node = bdrv_next_all_states(node))) {
+        BdrvChild *parent;
+
+        if (++nodes > HOT_FORK_SOURCE_MAX_VISITS ||
+            !g_hash_table_contains(set->nodes, node)) {
+            error_setg(errp, "Crucible source set has an unowned native node");
+            return false;
+        }
+        /* Node coverage alone misses non-backend consumers of descendants. */
+        QLIST_FOREACH(parent, &node->parents, next_parent) {
+            if (!g_hash_table_contains(consumers, parent)) {
+                error_setg(errp, "Crucible source set has an unowned graph consumer");
+                return false;
+            }
+        }
+    }
+    if (nodes != g_hash_table_size(set->nodes) ||
+        backends != g_hash_table_size(set->backends)) {
+        error_setg(errp, "Crucible source set lost a retained native resource");
+        return false;
+    }
+    return true;
+}
+
+/* Only called after all release preconditions have been checked under BQL. */
+static void source_set_destroy(QemuBlockHotForkSourceSet *set)
+{
+    size_t index;
+
+    for (index = 0; index < set->sources->len; index++) {
+        bool released = qemu_block_backend_hot_fork_read_only_source_free(
+            g_ptr_array_index(set->sources, index), &error_abort);
+
+        assert(released);
+    }
+    g_ptr_array_free(set->sources, true);
+    g_hash_table_destroy(set->nodes);
+    g_hash_table_destroy(set->backends);
+    g_free(set);
+}
+
+QemuBlockHotForkSourceSet *qemu_block_hot_fork_source_set_new(
+    const QemuBlockHotForkSourceRoot *roots, size_t count, Error **errp)
+{
+    QemuBlockHotForkSourceSet *set;
+    g_autoptr(GHashTable) seen = g_hash_table_new(g_direct_hash, g_direct_equal);
+    size_t index, visit, visits = 0;
+
+    GLOBAL_STATE_CODE();
+    if (count > HOT_FORK_SOURCE_MAX_VISITS || (count && !roots)) {
+        error_setg(errp, "Crucible source set exceeds root bounds");
+        return NULL;
+    }
+    /* Reject duplicate/mismatched owners before retaining any native graph. */
+    for (index = 0; index < count; index++) {
+        if (!roots[index].root ||
+            (roots[index].backend &&
+             blk_bs(roots[index].backend) != roots[index].root) ||
+            !g_hash_table_add(seen, roots[index].root)) {
+            error_setg(errp, "Crucible source set requires unique exact roots");
+            return NULL;
+        }
+    }
+    set = g_new0(QemuBlockHotForkSourceSet, 1);
+    set->owner = getpid();
+    set->sources = g_ptr_array_new();
+    set->nodes = g_hash_table_new(g_direct_hash, g_direct_equal);
+    set->backends = g_hash_table_new(g_direct_hash, g_direct_equal);
+    for (index = 0; index < count; index++) {
+        QemuBlockBackendHotForkReadOnlySource *source =
+            source_new(roots[index].backend, roots[index].root, errp);
+
+        if (!source) {
+            goto fail;
+        }
+        g_ptr_array_add(set->sources, source);
+        if (source->graph->len > HOT_FORK_SOURCE_MAX_VISITS - visits) {
+            error_setg(errp, "Crucible source set exceeds graph visit bounds");
+            goto fail;
+        }
+        visits += source->graph->len;
+        set->originally_writable_roots += !source->original_read_only;
+        if (source->backend) {
+            g_hash_table_add(set->backends, source->backend);
+        }
+        for (visit = 0; visit < source->graph->len; visit++) {
+            g_hash_table_add(set->nodes,
+                g_array_index(source->graph, ReadOnlySourceNode, visit).node);
+        }
+    }
+    if (!source_set_complete(set, errp)) {
+        goto fail;
+    }
+    return set;
+fail:
+    /* Construction only retains references/file pins, never changes access. */
+    source_set_destroy(set);
+    return NULL;
+}
+
+bool qemu_block_hot_fork_source_set_query(
+    const QemuBlockHotForkSourceSet *set,
+    QemuBlockHotForkSourceSetInventory *inventory, Error **errp)
+{
+    size_t index;
+
+    GLOBAL_STATE_CODE();
+    if (!inventory) {
+        error_setg(errp, "Crucible source set query requires an inventory");
+        return false;
+    }
+    memset(inventory, 0, sizeof(*inventory));
+    if (!source_set_complete(set, errp)) {
+        return false;
+    }
+    *inventory = (QemuBlockHotForkSourceSetInventory) {
+        .roots = set->sources->len,
+        .nodes = g_hash_table_size(set->nodes),
+        .originally_writable_roots = set->originally_writable_roots,
+        .frozen = true,
+    };
+    for (index = 0; index < set->sources->len; index++) {
+        inventory->frozen &=
+            qemu_block_backend_hot_fork_read_only_source_is_frozen(
+                g_ptr_array_index(set->sources, index));
+    }
+    return true;
+}
+
+bool qemu_block_hot_fork_source_set_freeze(QemuBlockHotForkSourceSet *set,
+                                         Error **errp)
+{
+    QemuBlockHotForkSourceSetInventory inventory;
+    size_t index;
+
+    GLOBAL_STATE_CODE();
+    if (!source_set_complete(set, errp)) {
+        return false;
+    }
+    for (index = 0; index < set->sources->len; index++) {
+        if (!qemu_block_backend_hot_fork_read_only_source_freeze(
+                g_ptr_array_index(set->sources, index), errp)) {
+            return false;
+        }
+    }
+    return qemu_block_hot_fork_source_set_query(set, &inventory, errp) &&
+           inventory.frozen;
+}
+
+bool qemu_block_hot_fork_source_set_restore(QemuBlockHotForkSourceSet *set,
+                                          Error **errp)
+{
+    size_t index;
+
+    GLOBAL_STATE_CODE();
+    if (!source_set_owned(set, errp)) {
+        return false;
+    }
+    /* Recover in reverse transition order; failure retains all capabilities. */
+    for (index = set->sources->len; index > 0; index--) {
+        if (!qemu_block_backend_hot_fork_read_only_source_restore(
+                g_ptr_array_index(set->sources, index - 1), errp)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool qemu_block_hot_fork_source_set_free(QemuBlockHotForkSourceSet *set,
+                                       Error **errp)
+{
+    size_t index;
+
+    GLOBAL_STATE_CODE();
+    if (!source_set_owned(set, errp)) {
+        return false;
+    }
+    for (index = 0; index < set->sources->len; index++) {
+        QemuBlockBackendHotForkReadOnlySource *source =
+            g_ptr_array_index(set->sources, index);
+
+        if (source->phase != SOURCE_ORIGINAL) {
+            error_setg(errp, "Crucible source set must be restored before release");
+            return false;
+        }
+    }
+    source_set_destroy(set);
+    return true;
+}
diff --git a/include/system/block-backend-global-state.h b/include/system/block-backend-global-state.h
index eb94fc23d..69465c7eb 100644
--- a/include/system/block-backend-global-state.h
+++ b/include/system/block-backend-global-state.h
@@ -183,6 +183,54 @@ bool qemu_block_backend_hot_fork_read_only_source_is_frozen(
 bool qemu_block_backend_hot_fork_read_only_source_free(
     QemuBlockBackendHotForkReadOnlySource *source, Error **errp);
 
+typedef struct QemuBlockHotForkSourceSet QemuBlockHotForkSourceSet;
+
+/* Explicit process-local ownership, never a wire representation. */
+typedef struct QemuBlockHotForkSourceRoot {
+    BlockBackend *backend; /* NULL only for a named, parentless native root. */
+    BlockDriverState *root;
+} QemuBlockHotForkSourceRoot;
+
+typedef struct QemuBlockHotForkSourceSetInventory {
+    size_t roots;
+    size_t nodes;
+    size_t originally_writable_roots;
+    bool frozen;
+} QemuBlockHotForkSourceSetInventory;
+
+/*
+ * Retains an explicitly supplied, complete native source closure under BQL.
+ * The caller has stopped guest execution and owns all supplied lifecycles.
+ * Every allocated block node, backend, and graph consumer must belong to the
+ * supplied roots. Already read-only roots retain that access on restoration.
+ * Unknown drivers, missing roots, and duplicate owners fail without effects.
+ * This does not validate external snapshot content or install child graphs.
+ */
+QemuBlockHotForkSourceSet *qemu_block_hot_fork_source_set_new(
+    const QemuBlockHotForkSourceRoot *roots, size_t count, Error **errp);
+
+/*
+ * Revalidates closure before any transition and retains partial failure for
+ * explicit recovery. Freeze precedes block/AIO barriers. Original root counts
+ * are provenance, not replacements for the live backend permission inventory.
+ */
+bool qemu_block_hot_fork_source_set_freeze(QemuBlockHotForkSourceSet *set,
+                                         Error **errp);
+bool qemu_block_hot_fork_source_set_query(
+    const QemuBlockHotForkSourceSet *set,
+    QemuBlockHotForkSourceSetInventory *inventory, Error **errp);
+
+/*
+ * Restores all owned sources after barriers are released, even when an extra
+ * unowned node has invalidated closure. A changed owned graph fails closed.
+ * Both operations reject inherited parent tokens in a forked child. Release
+ * requires every source to have returned to its original access state.
+ */
+bool qemu_block_hot_fork_source_set_restore(QemuBlockHotForkSourceSet *set,
+                                          Error **errp);
+bool qemu_block_hot_fork_source_set_free(QemuBlockHotForkSourceSet *set,
+                                       Error **errp);
+
 /*
  * Global state (GS) API. These functions run under the BQL.
  *
