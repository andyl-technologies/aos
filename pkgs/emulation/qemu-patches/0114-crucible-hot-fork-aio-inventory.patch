+##
+# @CrucibleHotForkAioContext:
+#
+# One process-local AioContext and its instantaneous activity counters.
+#
+# @context-id: positive process-local context identifier
+#
+# @home-thread-id: operating-system thread identifier, or zero until the
+#     context first runs on its home thread
+#
+# @active-polls: currently active aio_poll() calls
+#
+# @active-dispatches: currently active GLib AIO dispatch calls
+#
+# @pending-bottom-halves: enqueued bottom halves not yet dequeued
+#
+# @active-bottom-halves: bottom-half callbacks currently executing
+#
+# @queued-coroutines: coroutines queued through the context scheduling BH
+#
+# @notify-pending: whether the context has an unaccepted notification
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'struct': 'CrucibleHotForkAioContext',
+  'data': { 'context-id': 'uint64',
+            'home-thread-id': 'int64',
+            'active-polls': 'uint32',
+            'active-dispatches': 'uint32',
+            'pending-bottom-halves': 'uint32',
+            'active-bottom-halves': 'uint32',
+            'queued-coroutines': 'uint32',
+            'notify-pending': 'bool' } }
+
+##
+# @CrucibleHotForkAioInventory:
+#
+# Bounded observational snapshot of every registered AioContext and selected
+# AIO/BH activity.  This report does not drain or park any context, enumerate
+# timers or handlers, acknowledge readiness proof bit 3, or authorize a fork.
+#
+# @schema-version: inventory contract version, currently 1
+#
+# @generation: monotonic process-local context create/destroy/home-assignment
+#     counter
+#
+# @complete: true exactly when the registry did not overflow, identifiers are
+#     valid, and every context has an assigned home thread
+#
+# @overflowed: whether one or more contexts exceeded the retained bound
+#
+# @context-count: number of retained contexts
+#
+# @assigned-contexts: retained contexts with a positive home thread identifier
+#
+# @active-polls: sum of context @active-polls values
+#
+# @active-dispatches: sum of context @active-dispatches values
+#
+# @pending-bottom-halves: sum of context @pending-bottom-halves values
+#
+# @active-bottom-halves: sum of context @active-bottom-halves values
+#
+# @queued-coroutines: sum of context @queued-coroutines values
+#
+# @contexts: every retained context, sorted by @context-id and bounded to
+#     65536 entries
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'struct': 'CrucibleHotForkAioInventory',
+  'data': { 'schema-version': 'uint32',
+            'generation': 'uint64',
+            'complete': 'bool',
+            'overflowed': 'bool',
+            'context-count': 'uint32',
+            'assigned-contexts': 'uint32',
+            'active-polls': 'uint64',
+            'active-dispatches': 'uint64',
+            'pending-bottom-halves': 'uint64',
+            'active-bottom-halves': 'uint64',
+            'queued-coroutines': 'uint64',
+            'contexts': [ 'CrucibleHotForkAioContext' ] } }
+
+##
+# @query-crucible-hot-fork-aio-inventory:
+#
+# Query one bounded AioContext activity snapshot.  This command does not hold
+# an AIO/BH/timer barrier, advance readiness proof bit 3, or authorize a fork.
+#
+# Returns: @CrucibleHotForkAioInventory
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'command': 'query-crucible-hot-fork-aio-inventory',
+  'returns': 'CrucibleHotForkAioInventory' }
+
 ##
