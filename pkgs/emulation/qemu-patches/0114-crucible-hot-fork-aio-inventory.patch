+CrucibleHotForkAioInventory *
+qmp_query_crucible_hot_fork_aio_inventory(Error **errp)
+{
+    CrucibleHotForkAioInventory *report =
+        g_new0(CrucibleHotForkAioInventory, 1);
+    QemuAioHotForkInventory inventory;
+    CrucibleHotForkAioContextList **tail = &report->contexts;
+    uint64_t previous_context_id = 0;
+    bool valid_identifiers = true;
+    size_t index;
+
+    (void)errp;
+    report->schema_version = 1;
+    qemu_aio_hot_fork_inventory(&inventory);
+    report->generation = inventory.generation;
+    for (index = 0; index < inventory.entry_count; index++) {
+        QemuAioHotForkInventoryEntry *source = &inventory.entries[index];
+        CrucibleHotForkAioContext *context =
+            g_new0(CrucibleHotForkAioContext, 1);
+        CrucibleHotForkAioContextList *node =
+            g_new0(CrucibleHotForkAioContextList, 1);
+
+        context->context_id = source->context_id;
+        context->home_thread_id = source->home_thread_id;
+        context->active_polls = source->active_polls;
+        context->active_dispatches = source->active_dispatches;
+        context->pending_bottom_halves = source->pending_bhs;
+        context->active_bottom_halves = source->active_bhs;
+        context->queued_coroutines = source->queued_coroutines;
+        context->notify_pending = source->notify_pending;
+        if (source->context_id == 0 ||
+            (index != 0 && source->context_id <= previous_context_id) ||
+            source->home_thread_id < 0) {
+            valid_identifiers = false;
+        }
+        previous_context_id = source->context_id;
+        if (source->home_thread_id > 0) {
+            report->assigned_contexts++;
+        }
+        report->active_polls += source->active_polls;
+        report->active_dispatches += source->active_dispatches;
+        report->pending_bottom_halves += source->pending_bhs;
+        report->active_bottom_halves += source->active_bhs;
+        report->queued_coroutines += source->queued_coroutines;
+        node->value = context;
+        *tail = node;
+        tail = &node->next;
+    }
+    report->context_count = inventory.entry_count;
+    report->overflowed = inventory.overflowed;
+    report->complete = !inventory.overflowed && valid_identifiers &&
+        report->assigned_contexts == report->context_count;
+    qemu_aio_hot_fork_inventory_destroy(&inventory);
+    return report;
+}
