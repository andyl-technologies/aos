+static QemuMutex crucible_hot_fork_aio_lock;
+static QTAILQ_HEAD(, AioContext) crucible_hot_fork_aio_contexts =
+    QTAILQ_HEAD_INITIALIZER(crucible_hot_fork_aio_contexts);
+static uint64_t crucible_hot_fork_aio_next_id = 1;
+static uint64_t crucible_hot_fork_aio_generation;
+
+static void __attribute__((__constructor__))
+crucible_hot_fork_aio_inventory_init(void)
+{
+    qemu_mutex_init(&crucible_hot_fork_aio_lock);
+}
+
+static void crucible_hot_fork_aio_register(AioContext *ctx)
+{
+    QEMU_LOCK_GUARD(&crucible_hot_fork_aio_lock);
+
+    ctx->crucible_hot_fork_id = crucible_hot_fork_aio_next_id++;
+    assert(ctx->crucible_hot_fork_id != 0);
+    QTAILQ_INSERT_TAIL(&crucible_hot_fork_aio_contexts, ctx,
+                       crucible_hot_fork_node);
+    crucible_hot_fork_aio_generation++;
+}
+
+static void crucible_hot_fork_aio_unregister(AioContext *ctx)
+{
+    QEMU_LOCK_GUARD(&crucible_hot_fork_aio_lock);
+
+    QTAILQ_REMOVE(&crucible_hot_fork_aio_contexts, ctx,
+                  crucible_hot_fork_node);
+    crucible_hot_fork_aio_generation++;
+}
+
+void qemu_aio_hot_fork_mark_home(AioContext *ctx)
+{
+    int64_t thread_id = qemu_get_thread_id();
+
+    if (qatomic_read(&ctx->crucible_hot_fork_home_thread_id) == thread_id) {
+        return;
+    }
+
+    QEMU_LOCK_GUARD(&crucible_hot_fork_aio_lock);
+    if (ctx->crucible_hot_fork_home_thread_id != thread_id) {
+        qatomic_set(&ctx->crucible_hot_fork_home_thread_id, thread_id);
+        crucible_hot_fork_aio_generation++;
+    }
+}
+
+void qemu_aio_hot_fork_inventory(QemuAioHotForkInventory *inventory)
+{
+    AioContext *ctx;
+    size_t count = 0;
+
+    *inventory = (QemuAioHotForkInventory) { 0 };
+    QEMU_LOCK_GUARD(&crucible_hot_fork_aio_lock);
+    inventory->generation = crucible_hot_fork_aio_generation;
+    QTAILQ_FOREACH(ctx, &crucible_hot_fork_aio_contexts,
+                   crucible_hot_fork_node) {
+        if (count == QEMU_AIO_HOT_FORK_INVENTORY_MAX) {
+            inventory->overflowed = true;
+            break;
+        }
+        count++;
+    }
+
+    inventory->entries = g_new0(QemuAioHotForkInventoryEntry, count);
+    inventory->entry_count = count;
+    count = 0;
+    QTAILQ_FOREACH(ctx, &crucible_hot_fork_aio_contexts,
+                   crucible_hot_fork_node) {
+        QemuAioHotForkInventoryEntry *entry;
+
+        if (count == inventory->entry_count) {
+            break;
+        }
+        entry = &inventory->entries[count++];
+        entry->context_id = ctx->crucible_hot_fork_id;
+        entry->home_thread_id =
+            qatomic_read(&ctx->crucible_hot_fork_home_thread_id);
+        entry->active_polls =
+            qatomic_read(&ctx->crucible_hot_fork_active_polls);
+        entry->active_dispatches =
+            qatomic_read(&ctx->crucible_hot_fork_active_dispatches);
+        entry->pending_bhs =
+            qatomic_read(&ctx->crucible_hot_fork_pending_bhs);
+        entry->active_bhs =
+            qatomic_read(&ctx->crucible_hot_fork_active_bhs);
+        entry->queued_coroutines =
+            qatomic_read(&ctx->crucible_hot_fork_queued_coroutines);
+        entry->notify_pending = qatomic_read(&ctx->notified);
+    }
+}
+
+void qemu_aio_hot_fork_inventory_destroy(QemuAioHotForkInventory *inventory)
+{
+    g_free(inventory->entries);
+    *inventory = (QemuAioHotForkInventory) { 0 };
+}
