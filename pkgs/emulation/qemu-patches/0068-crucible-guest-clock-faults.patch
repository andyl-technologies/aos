+static CrucibleClockSource *crucible_clock_source_by_id(
+    const uint8_t id[32])
+{
+    if (!crucible_clock_sources || !crucible_clock_bindings_sealed) {
+        return NULL;
+    }
+    for (guint i = 0; i < crucible_clock_sources->len; i++) {
+        CrucibleClockSource *source = &g_array_index(
+            crucible_clock_sources, CrucibleClockSource, i);
+
+        if (memcmp(source->binding.id, id, 32) == 0) {
+            return source;
+        }
+    }
+    return NULL;
+}
