+static bool crucible_clock_vmstate_get_source(
+    QemuCrucibleFaultVmstateReader *reader, CrucibleClockSource *source)
+{
+    uint64_t additive, impulse_additive, synchronization;
+    uint32_t freeze_release, monotonicity, overdue, source_state;
+    uint32_t timer_role, timer_index, timer_action;
+    uint8_t has_last, frozen, synchronizing, terminal, previous_source_state;
+
+    if (!qemu_crucible_fault_vmstate_get_u64(
+            reader, &source->anchor_raw_ns) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &source->anchor_value_ns) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &source->last_value_ns) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &source->read_sequence) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &source->transform_generation) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &source->drift_numerator) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &source->drift_denominator) ||
+        !qemu_crucible_fault_vmstate_get_u64(reader, &additive) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &source->impulse_drift_numerator) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &source->impulse_drift_denominator) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &impulse_additive) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &source->frozen_value_ns) ||
+        !qemu_crucible_fault_vmstate_get_u64(reader, &synchronization) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &source->synchronization_anchor_raw_ns) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &source->synchronization_numerator) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &source->synchronization_denominator) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &source->synchronization_threshold_ns) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &source->source_transition_generation) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &source->timer_transition_sequence) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &source->timer_old_guest_deadline_ns) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &source->timer_old_scheduler_deadline_ns) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &source->timer_old_transform_generation) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &source->timer_new_guest_deadline_ns) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &source->timer_new_scheduler_deadline_ns) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &source->timer_new_transform_generation) ||
+        !qemu_crucible_fault_vmstate_get_u32(reader, &freeze_release) ||
+        !qemu_crucible_fault_vmstate_get_u32(reader, &monotonicity) ||
+        !qemu_crucible_fault_vmstate_get_u32(reader, &overdue) ||
+        !qemu_crucible_fault_vmstate_get_u32(reader, &source_state) ||
+        !qemu_crucible_fault_vmstate_get_u32(reader, &timer_role) ||
+        !qemu_crucible_fault_vmstate_get_u32(reader, &timer_index) ||
+        !qemu_crucible_fault_vmstate_get_u32(reader, &timer_action) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &has_last) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &frozen) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &synchronizing) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &terminal) ||
+        !qemu_crucible_fault_vmstate_get_u8(
+            reader, &previous_source_state) ||
+        !qemu_crucible_fault_vmstate_get_bytes(
+            reader, source->fallback_id, 32) ||
+        !qemu_crucible_fault_vmstate_get_bytes(
+            reader, source->previous_fallback_id, 32) ||
+        source->transform_generation == 0 ||
+        source->drift_numerator == 0 || source->drift_denominator == 0 ||
+        source->impulse_drift_numerator == 0 ||
+        source->impulse_drift_denominator == 0 ||
+        freeze_release > 2 || monotonicity < 1 || monotonicity > 3 ||
+        overdue < 1 || overdue > 3 ||
+        source_state < CRUCIBLE_CLOCK_HEALTHY ||
+        source_state > CRUCIBLE_CLOCK_FALLBACK ||
+        previous_source_state < CRUCIBLE_CLOCK_HEALTHY ||
+        previous_source_state > CRUCIBLE_CLOCK_FALLBACK ||
+        timer_role > QEMU_CRUCIBLE_CLOCK_TIMER_COALESCED ||
+        timer_action > QEMU_CRUCIBLE_CLOCK_TIMER_UNREACHABLE ||
+        (source->timer_transition_sequence == 0 &&
+         (timer_role != 0 || timer_index != 0 || timer_action != 0 ||
+          source->timer_old_guest_deadline_ns != 0 ||
+          source->timer_old_scheduler_deadline_ns != 0 ||
+          source->timer_old_transform_generation != 0 ||
+          source->timer_new_guest_deadline_ns != 0 ||
+          source->timer_new_scheduler_deadline_ns != 0 ||
+          source->timer_new_transform_generation != 0)) ||
+        (source->timer_transition_sequence != 0 &&
+         (timer_role == 0 || timer_action == 0)) ||
+        (source->capability.timer_relationship == 0 &&
+         source->timer_transition_sequence != 0) ||
+        (source->timer_transition_sequence != 0 &&
+         ((source->capability.source_kind == QEMU_CRUCIBLE_CLOCK_X86_RTC &&
+           (timer_role < QEMU_CRUCIBLE_CLOCK_TIMER_PERIODIC ||
+            timer_role > QEMU_CRUCIBLE_CLOCK_TIMER_COALESCED)) ||
+          (source->capability.source_kind == QEMU_CRUCIBLE_CLOCK_ARM_RTC &&
+           timer_role != QEMU_CRUCIBLE_CLOCK_TIMER_ALARM) ||
+          (source->capability.source_kind != QEMU_CRUCIBLE_CLOCK_X86_RTC &&
+           source->capability.source_kind != QEMU_CRUCIBLE_CLOCK_ARM_RTC &&
+           timer_role != QEMU_CRUCIBLE_CLOCK_TIMER_PRIMARY))) ||
+        (source->timer_old_scheduler_deadline_ns != UINT64_MAX &&
+         source->timer_old_scheduler_deadline_ns > INT64_MAX) ||
+        (source->timer_new_scheduler_deadline_ns != UINT64_MAX &&
+         source->timer_new_scheduler_deadline_ns > INT64_MAX) ||
+        (source->timer_transition_sequence != 0 &&
+         source->timer_old_transform_generation == 0 &&
+         (source->timer_old_guest_deadline_ns != 0 ||
+          source->timer_old_scheduler_deadline_ns != UINT64_MAX)) ||
+        source->timer_old_transform_generation >
+            source->transform_generation ||
+        ((timer_action == QEMU_CRUCIBLE_CLOCK_TIMER_DROP ||
+          timer_action == QEMU_CRUCIBLE_CLOCK_TIMER_UNREACHABLE) &&
+         (source->timer_new_guest_deadline_ns != 0 ||
+          source->timer_new_scheduler_deadline_ns != UINT64_MAX ||
+          source->timer_new_transform_generation != 0)) ||
+        ((timer_action == QEMU_CRUCIBLE_CLOCK_TIMER_FIRE_AT_BOUNDARY ||
+          timer_action == QEMU_CRUCIBLE_CLOCK_TIMER_RESCHEDULE_PERIODIC) &&
+         (source->timer_new_scheduler_deadline_ns == UINT64_MAX ||
+          source->timer_new_transform_generation == 0 ||
+          source->timer_new_transform_generation >
+              source->transform_generation)) ||
+        has_last > 1 || frozen > 1 || synchronizing > 1 || terminal > 1 ||
+        (frozen && freeze_release == 0) || (!frozen && freeze_release != 0) ||
+        (synchronizing &&
+         (source->synchronization_numerator == 0 ||
+          source->synchronization_denominator == 0 ||
+          source->synchronization_threshold_ns == 0))) {
+        return false;
+    }
+    source->additive_nanos = (int64_t)additive;
+    source->impulse_additive_nanos = (int64_t)impulse_additive;
+    source->synchronization_remaining_ns = (int64_t)synchronization;
+    source->freeze_release = freeze_release;
+    source->monotonicity = monotonicity;
+    source->overdue_policy = overdue;
+    source->source_state = source_state;
+    source->timer_role = timer_role;
+    source->timer_index = timer_index;
+    source->timer_action = timer_action;
+    source->has_last_value = has_last;
+    source->frozen = frozen;
+    source->synchronizing = synchronizing;
+    source->terminal = terminal;
+    source->previous_source_state = previous_source_state;
+    return true;
+}
+
+static bool crucible_clock_vmstate_runtime_valid(
+    const CrucibleClockSource *source)
+{
+    uint64_t numerator = source->impulse_drift_numerator;
+    uint64_t denominator = source->impulse_drift_denominator;
+    int64_t additive = source->impulse_additive_nanos;
+    uint8_t monotonicity = source->capability.monotonicity, overdue = 1;
+    bool frozen = false;
+    uint64_t frozen_value = 0;
+    uint8_t freeze_release = 0;
+    uint8_t zero[32] = { 0 };
+
+    if ((source->source_transition_generation == 0 &&
+         (source->previous_source_state != CRUCIBLE_CLOCK_HEALTHY ||
+          memcmp(source->previous_fallback_id, zero, 32) != 0)) ||
+        (source->previous_source_state == CRUCIBLE_CLOCK_FALLBACK ?
+             !crucible_clock_source_by_id(source->previous_fallback_id) :
+             memcmp(source->previous_fallback_id, zero, 32) != 0)) {
+        return false;
+    }
+
+    for (guint i = 0; source->rules && i < source->rules->len; i++) {
+        const CrucibleClockRuleState *state = &g_array_index(
+            source->rules, CrucibleClockRuleState, i);
+        const CrucibleClockRuleState *previous = i == 0 ? NULL :
+            &g_array_index(source->rules, CrucibleClockRuleState, i - 1);
+        uint32_t kind, policy;
+        int64_t signed_value;
+        uint64_t ratio_numerator, ratio_denominator, unsigned_value;
+
+        if ((previous && memcmp(
+                qemu_crucible_fault_rule_binding_hash(previous->rule),
+                qemu_crucible_fault_rule_binding_hash(state->rule), 32) >= 0) ||
+            !crucible_clock_u32(state->rule,
+                                CRUCIBLE_NODE_FAULT_FIELD_P2, &kind) ||
+            !crucible_clock_i64(state->rule,
+                                CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                &signed_value) ||
+            !crucible_clock_ratio(state->rule,
+                                  CRUCIBLE_NODE_FAULT_FIELD_P4,
+                                  &ratio_numerator, &ratio_denominator) ||
+            !crucible_clock_u64(state->rule,
+                                CRUCIBLE_NODE_FAULT_FIELD_P5,
+                                &unsigned_value) ||
+            !crucible_clock_u32(state->rule,
+                                CRUCIBLE_NODE_FAULT_FIELD_P7, &policy)) {
+            return false;
+        }
+        monotonicity = MAX(monotonicity, policy);
+        if (!crucible_clock_u32(state->rule,
+                                CRUCIBLE_NODE_FAULT_FIELD_P8, &policy)) {
+            return false;
+        }
+        overdue = MAX(overdue, policy);
+        if ((kind == 1 || kind == 3) &&
+            !crucible_clock_add_i64(&additive, signed_value)) {
+            return false;
+        }
+        if (kind == 2 && !crucible_clock_multiply_ratio(
+                &numerator, &denominator,
+                ratio_numerator, ratio_denominator)) {
+            return false;
+        }
+        if (kind == 4) {
+            QString *release = qobject_to(
+                QString, qemu_crucible_fault_rule_json(
+                    state->rule, CRUCIBLE_NODE_FAULT_FIELD_P6));
+            uint8_t policy_value = release && strcmp(
+                qstring_get_str(release), "resume_from_frozen") == 0 ? 1 : 2;
+
+            if (frozen && (frozen_value != unsigned_value ||
+                           freeze_release != policy_value)) {
+                return false;
+            }
+            frozen = true;
+            frozen_value = unsigned_value;
+            freeze_release = policy_value;
+        }
+        if (kind == 6) {
+            g_autoptr(GArray) increments = NULL;
+            uint64_t step, maximum_offset, maximum_rate;
+            uint64_t offset_magnitude = state->wander_offset < 0 ?
+                (uint64_t)(-(state->wander_offset + 1)) + 1 :
+                (uint64_t)state->wander_offset;
+            uint64_t rate_magnitude = state->wander_rate_ppb < 0 ?
+                (uint64_t)(-(state->wander_rate_ppb + 1)) + 1 :
+                (uint64_t)state->wander_rate_ppb;
+
+            if (!crucible_clock_wander_step_representable(
+                    source, state->rule) ||
+                !crucible_clock_wander_policy(
+                    state->rule, &step, &maximum_offset, &maximum_rate,
+                    &increments) || offset_magnitude > maximum_offset ||
+                rate_magnitude > maximum_rate || state->wander_next_ns == 0) {
+                return false;
+            }
+        } else if (state->wander_offset != 0 ||
+                   state->wander_rate_ppb != 0 ||
+                   state->wander_next_ns != 0 ||
+                   state->wander_sequence != 0) {
+            return false;
+        }
+    }
+    if (source->drift_numerator != numerator ||
+        source->drift_denominator != denominator ||
+        source->additive_nanos != additive ||
+        source->monotonicity != monotonicity ||
+        source->overdue_policy != overdue || source->frozen != frozen ||
+        (frozen && (source->frozen_value_ns != frozen_value ||
+                    source->freeze_release != freeze_release)) ||
+        (!frozen && (source->frozen_value_ns != 0 ||
+                     source->freeze_release != 0))) {
+        return false;
+    }
+    if (!source->source_rule) {
+        return source->source_state == CRUCIBLE_CLOCK_HEALTHY &&
+               !source->synchronizing &&
+               source->synchronization_remaining_ns == 0 &&
+               source->synchronization_anchor_raw_ns == 0 &&
+               source->synchronization_numerator == 0 &&
+               source->synchronization_denominator == 0 &&
+               source->synchronization_threshold_ns == 0 &&
+               memcmp(source->fallback_id, zero, 32) == 0;
+    }
+    CrucibleClockSource derived = { 0 };
+
+    if (!crucible_clock_source_transition(
+            &derived, source->source_rule) ||
+        source->source_state != derived.source_state ||
+        memcmp(source->fallback_id, derived.fallback_id, 32) != 0 ||
+        source->synchronization_numerator !=
+            derived.synchronization_numerator ||
+        source->synchronization_denominator !=
+            derived.synchronization_denominator ||
+        source->synchronization_threshold_ns !=
+            derived.synchronization_threshold_ns ||
+        (!derived.synchronizing && source->synchronizing) ||
+        (source->synchronizing &&
+         source->synchronization_remaining_ns == 0) ||
+        (!source->synchronizing &&
+         source->synchronization_remaining_ns != 0)) {
+        return false;
+    }
+    return true;
+}
+
+static bool crucible_clock_vmstate_fallback_graph_valid(GArray *sources)
+{
+    for (guint i = 0; i < sources->len; i++) {
+        const CrucibleClockSource *origin = &g_array_index(
+            sources, CrucibleClockSource, i);
+        const CrucibleClockSource *cursor = origin;
+
+        for (guint depth = 0;
+             cursor->source_state == CRUCIBLE_CLOCK_FALLBACK;
+             depth++) {
+            const CrucibleClockSource *next = NULL;
+
+            if (depth >= sources->len) {
+                return false;
+            }
+            for (guint candidate_index = 0;
+                 candidate_index < sources->len; candidate_index++) {
+                const CrucibleClockSource *candidate = &g_array_index(
+                    sources, CrucibleClockSource, candidate_index);
+
+                if (memcmp(candidate->binding.id,
+                           cursor->fallback_id, 32) == 0) {
+                    next = candidate;
+                    break;
+                }
+            }
+            if (!next || next == origin) {
+                return false;
+            }
+            cursor = next;
+        }
+    }
+    return true;
+}
+
+static int crucible_clock_vmstate_save(GByteArray *payload)
+{
+    if (!crucible_clock_sources || !crucible_clock_bindings_sealed ||
+        crucible_clock_sources->len == 0 ||
+        crucible_clock_sources->len > CRUCIBLE_CLOCK_MAX_SOURCES) {
+        return -EINVAL;
+    }
+    qemu_crucible_fault_vmstate_put_bytes(payload, "CRUCCVS3", 8);
+    qemu_crucible_fault_vmstate_put_u32(
+        payload, crucible_clock_sources->len);
+    qemu_crucible_fault_vmstate_put_u8(payload, crucible_clock_terminal);
+    qemu_crucible_fault_vmstate_put_u8(payload, 0);
+    qemu_crucible_fault_vmstate_put_u16(payload, 0);
+    qemu_crucible_fault_vmstate_put_bytes(
+        payload, crucible_clock_manifest_digest, 32);
+    for (guint i = 0; i < crucible_clock_sources->len; i++) {
+        const CrucibleClockSource *source = &g_array_index(
+            crucible_clock_sources, CrucibleClockSource, i);
+
+        if (!source->rules || source->rules->len > CRUCIBLE_CLOCK_MAX_RULES) {
+            return -EINVAL;
+        }
+        qemu_crucible_fault_vmstate_put_u16(
+            payload, source->capability.source_kind);
+        qemu_crucible_fault_vmstate_put_u16(payload, 0);
+        qemu_crucible_fault_vmstate_put_bytes(
+            payload, source->binding.id, 32);
+        crucible_clock_vmstate_put_source(payload, source);
+        qemu_crucible_fault_vmstate_put_u32(payload, source->rules->len);
+        qemu_crucible_fault_vmstate_put_u8(
+            payload, source->source_rule != NULL);
+        qemu_crucible_fault_vmstate_put_u8(payload, 0);
+        qemu_crucible_fault_vmstate_put_u16(payload, 0);
+        for (guint rule_index = 0; rule_index < source->rules->len;
+             rule_index++) {
+            const CrucibleClockRuleState *rule_state = &g_array_index(
+                source->rules, CrucibleClockRuleState, rule_index);
+
+            qemu_crucible_fault_rule_reference_vmstate_save(
+                payload, rule_state->rule);
+            qemu_crucible_fault_vmstate_put_u64(
+                payload, (uint64_t)rule_state->wander_offset);
+            qemu_crucible_fault_vmstate_put_u64(
+                payload, (uint64_t)rule_state->wander_rate_ppb);
+            qemu_crucible_fault_vmstate_put_u64(
+                payload, rule_state->wander_next_ns);
+            qemu_crucible_fault_vmstate_put_u64(
+                payload, rule_state->wander_sequence);
+        }
+        if (source->source_rule) {
+            qemu_crucible_fault_rule_reference_vmstate_save(
+                payload, source->source_rule);
+        }
+    }
+    return 0;
+}
+
+static int crucible_clock_vmstate_prepare(const uint8_t *payload,
+                                          size_t payload_len,
+                                          void **staged_out)
+{
+    QemuCrucibleFaultVmstateReader reader = {
+        .data = payload,
+        .length = payload_len,
+    };
+    CrucibleClockVmstate *state = g_new0(CrucibleClockVmstate, 1);
+    uint8_t magic[8], terminal, reserved8;
+    uint8_t manifest_digest[32];
+    uint16_t reserved16;
+    uint32_t count;
+
+    if (!crucible_clock_sources || !crucible_clock_bindings_sealed ||
+        !qemu_crucible_fault_vmstate_get_bytes(&reader, magic, 8) ||
+        memcmp(magic, "CRUCCVS3", 8) != 0 ||
+        !qemu_crucible_fault_vmstate_get_u32(&reader, &count) ||
+        !qemu_crucible_fault_vmstate_get_u8(&reader, &terminal) ||
+        !qemu_crucible_fault_vmstate_get_u8(&reader, &reserved8) ||
+        !qemu_crucible_fault_vmstate_get_u16(&reader, &reserved16) ||
+        !qemu_crucible_fault_vmstate_get_bytes(
+            &reader, manifest_digest, sizeof(manifest_digest)) ||
+        count != crucible_clock_sources->len || terminal > 1 ||
+        reserved8 != 0 || reserved16 != 0 ||
+        memcmp(manifest_digest, crucible_clock_manifest_digest,
+               sizeof(manifest_digest)) != 0) {
+        goto fail;
+    }
+    state->terminal = terminal;
+    state->sources = g_array_sized_new(
+        false, true, sizeof(CrucibleClockSource), count);
+    g_array_set_size(state->sources, count);
+    for (uint32_t i = 0; i < count; i++) {
+        CrucibleClockSource *source = &g_array_index(
+            state->sources, CrucibleClockSource, i);
+        const CrucibleClockSource *live = &g_array_index(
+            crucible_clock_sources, CrucibleClockSource, i);
+        uint8_t identity[32], has_source_rule, reserved;
+        uint16_t source_kind, reserved_source, reserved_rule;
+        uint32_t rule_count;
+
+        *source = *live;
+        source->rules = g_array_new(
+            false, true, sizeof(CrucibleClockRuleState));
+        source->source_rule = NULL;
+        if (!qemu_crucible_fault_vmstate_get_u16(
+                &reader, &source_kind) ||
+            !qemu_crucible_fault_vmstate_get_u16(
+                &reader, &reserved_source) ||
+            !qemu_crucible_fault_vmstate_get_bytes(
+                &reader, identity, 32) ||
+            source_kind != live->capability.source_kind ||
+            reserved_source != 0 ||
+            memcmp(identity, live->binding.id, 32) != 0 ||
+            !crucible_clock_vmstate_get_source(&reader, source) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &rule_count) ||
+            !qemu_crucible_fault_vmstate_get_u8(
+                &reader, &has_source_rule) ||
+            !qemu_crucible_fault_vmstate_get_u8(&reader, &reserved) ||
+            !qemu_crucible_fault_vmstate_get_u16(
+                &reader, &reserved_rule) ||
+            rule_count > CRUCIBLE_CLOCK_MAX_RULES ||
+            has_source_rule > 1 || reserved != 0 || reserved_rule != 0 ||
+            source->terminal != state->terminal) {
+            goto fail;
+        }
+        for (uint32_t rule_index = 0; rule_index < rule_count;
+             rule_index++) {
+            CrucibleClockRuleState rule_state = { 0 };
+            uint64_t wander_offset, wander_rate;
+
+            rule_state.rule =
+                qemu_crucible_fault_rule_reference_vmstate_load(&reader);
+            if (!rule_state.rule ||
+                qemu_crucible_fault_rule_command_kind(rule_state.rule) !=
+                    CRUCIBLE_FAULT_COMMAND_CLOCK_TRANSFORM ||
+                !crucible_clock_rule_selects(rule_state.rule, live) ||
+                !crucible_clock_rule_payload_valid(rule_state.rule) ||
+                !qemu_crucible_fault_vmstate_get_u64(
+                    &reader, &wander_offset) ||
+                !qemu_crucible_fault_vmstate_get_u64(
+                    &reader, &wander_rate) ||
+                !qemu_crucible_fault_vmstate_get_u64(
+                    &reader, &rule_state.wander_next_ns) ||
+                !qemu_crucible_fault_vmstate_get_u64(
+                    &reader, &rule_state.wander_sequence)) {
+                qemu_crucible_fault_rule_unref(rule_state.rule);
+                goto fail;
+            }
+            rule_state.wander_offset = (int64_t)wander_offset;
+            rule_state.wander_rate_ppb = (int64_t)wander_rate;
+            g_array_append_val(source->rules, rule_state);
+        }
+        if (has_source_rule) {
+            source->source_rule =
+                qemu_crucible_fault_rule_reference_vmstate_load(&reader);
+            if (!source->source_rule ||
+                qemu_crucible_fault_rule_command_kind(
+                    source->source_rule) !=
+                    CRUCIBLE_FAULT_COMMAND_CLOCK_SOURCE_STATE ||
+                !crucible_clock_hash_set_contains(
+                    source->source_rule, CRUCIBLE_NODE_FAULT_FIELD_P1,
+                    live->binding.id) ||
+                !crucible_clock_source_rule_valid(source->source_rule)) {
+                goto fail;
+            }
+        }
+    }
+    for (guint i = 0; i < state->sources->len; i++) {
+        if (!crucible_clock_vmstate_runtime_valid(&g_array_index(
+                state->sources, CrucibleClockSource, i))) {
+            goto fail;
+        }
+    }
+    if (!crucible_clock_vmstate_fallback_graph_valid(state->sources)) {
+        goto fail;
+    }
+    if (!qemu_crucible_fault_vmstate_reader_finished(&reader)) {
+        goto fail;
+    }
+    *staged_out = state;
+    return 0;
+
+fail:
+    crucible_clock_vmstate_free(state);
+    return -EINVAL;
+}
+
+static void crucible_clock_vmstate_commit(void *opaque)
+{
+    CrucibleClockVmstate *state = opaque;
+
+    for (guint i = 0; i < crucible_clock_sources->len; i++) {
+        CrucibleClockSource *live = &g_array_index(
+            crucible_clock_sources, CrucibleClockSource, i);
+        CrucibleClockSource *restored = &g_array_index(
+            state->sources, CrucibleClockSource, i);
+        GArray *rules = restored->rules;
+        QemuCrucibleFaultRule *source_rule = restored->source_rule;
+
+        restored->rules = NULL;
+        restored->source_rule = NULL;
+        crucible_clock_source_clear_rules(live);
+#define RESTORE(field) do { live->field = restored->field; } while (0)
+        RESTORE(anchor_raw_ns);
+        RESTORE(anchor_value_ns);
+        RESTORE(last_value_ns);
+        RESTORE(read_sequence);
+        RESTORE(transform_generation);
+        RESTORE(drift_numerator);
+        RESTORE(drift_denominator);
+        RESTORE(additive_nanos);
+        RESTORE(impulse_drift_numerator);
+        RESTORE(impulse_drift_denominator);
+        RESTORE(impulse_additive_nanos);
+        RESTORE(frozen_value_ns);
+        RESTORE(freeze_release);
+        RESTORE(monotonicity);
+        RESTORE(overdue_policy);
+        RESTORE(source_state);
+        RESTORE(synchronization_remaining_ns);
+        RESTORE(synchronization_anchor_raw_ns);
+        RESTORE(synchronization_numerator);
+        RESTORE(synchronization_denominator);
+        RESTORE(synchronization_threshold_ns);
+        RESTORE(source_transition_generation);
+        RESTORE(previous_source_state);
+        RESTORE(timer_transition_sequence);
+        RESTORE(timer_old_guest_deadline_ns);
+        RESTORE(timer_old_scheduler_deadline_ns);
+        RESTORE(timer_old_transform_generation);
+        RESTORE(timer_new_guest_deadline_ns);
+        RESTORE(timer_new_scheduler_deadline_ns);
+        RESTORE(timer_new_transform_generation);
+        RESTORE(timer_role);
+        RESTORE(timer_index);
+        RESTORE(timer_action);
+        RESTORE(has_last_value);
+        RESTORE(frozen);
+        RESTORE(synchronizing);
+        RESTORE(terminal);
+#undef RESTORE
+        memcpy(live->fallback_id, restored->fallback_id, 32);
+        memcpy(live->previous_fallback_id,
+               restored->previous_fallback_id, 32);
+        live->rules = rules;
+        live->source_rule = source_rule;
+    }
+    crucible_clock_terminal = state->terminal;
+    crucible_clock_restoring = true;
+    for (guint i = 0; i < crucible_clock_sources->len; i++) {
+        CrucibleClockSource *source = &g_array_index(
+            crucible_clock_sources, CrucibleClockSource, i);
+
+        crucible_clock_rearm_source(source);
+        crucible_clock_wander_timer_rearm(source);
+    }
+    crucible_clock_restoring = false;
+    crucible_clock_vmstate_free(state);
+}
+
+static const QemuCrucibleFaultVmstateSection
+crucible_clock_vmstate_section = {
+    .name = "clock",
+    .version = 3,
+    .save = crucible_clock_vmstate_save,
+    .prepare = crucible_clock_vmstate_prepare,
+    .commit = crucible_clock_vmstate_commit,
+    .free_staged = crucible_clock_vmstate_free,
+};
