diff --git a/hw/intc/apic.c b/hw/intc/apic.c
index 4406617..e873a02 100644
--- a/hw/intc/apic.c
+++ b/hw/intc/apic.c
@@ -43,6 +43,34 @@
 #define SYNC_ISR_IRR_TO_VAPIC           0x4
 
 static APICCommonState **local_apics;
+
+static int64_t apic_crucible_clock_ns(
+    APICCommonState *s, bool guest_read)
+{
+    uint64_t raw = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    uint64_t transformed = raw;
+    bool read_error = false;
+
+    if (qemu_crucible_fault_clock_source_active(
+            QEMU_CRUCIBLE_CLOCK_X86_APIC_TIMER,
+            CPU(s->cpu)->cpu_index) &&
+        !(guest_read ? qemu_crucible_fault_clock_read_ns(
+              QEMU_CRUCIBLE_CLOCK_X86_APIC_TIMER,
+              CPU(s->cpu)->cpu_index, raw, 0,
+              &transformed, &read_error) :
+          qemu_crucible_fault_clock_project_ns(
+              QEMU_CRUCIBLE_CLOCK_X86_APIC_TIMER,
+              CPU(s->cpu)->cpu_index, raw,
+              &transformed, &read_error))) {
+        error_report("Crucible local APIC clock transform failed");
