+static bool crucible_clock_mode(void)
+{
+    return strcmp(current_accel_name(), "sim") == 0 &&
+           icount_enabled() == ICOUNT_PRECISE;
+}
+
+static void crucible_clock_sha256(const uint8_t *data, size_t length,
+                                  uint8_t digest[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize digest_len = 32;
+
+    g_checksum_update(checksum, data, length);
+    g_checksum_get_digest(checksum, digest, &digest_len);
+    g_assert(digest_len == 32);
+}
+
+static bool crucible_clock_field(
+    const QemuCrucibleFaultRule *rule, uint16_t tag, uint16_t type,
+    const uint8_t **data, uint32_t *length)
+{
+    return qemu_crucible_fault_rule_field(rule, tag, type, data, length);
+}
+
+static bool crucible_clock_u32(const QemuCrucibleFaultRule *rule,
+                               uint16_t tag, uint32_t *value)
+{
+    const uint8_t *data;
+    uint32_t length;
+
+    if (!crucible_clock_field(rule, tag,
+            CRUCIBLE_NODE_FAULT_FIELD_TYPE_U32, &data, &length) ||
+        length != sizeof(*value)) {
+        return false;
+    }
+    *value = ldl_le_p(data);
+    return true;
+}
+
+static bool crucible_clock_rule_contribution(
+    CrucibleClockSource *source, GArray *rules, uint64_t raw_ns,
+    __int128 *contribution)
+{
+    __int128 total = source->impulse_additive_nanos;
+
+    for (guint i = 0; rules && i < rules->len; i++) {
+        CrucibleClockRuleState *state = &g_array_index(
+            rules, CrucibleClockRuleState, i);
+        uint32_t kind;
+
+        if (!crucible_clock_u32(
+                state->rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &kind)) {
+            return false;
+        }
+        if (kind == 1 || kind == 3) {
+            int64_t value;
+
+            if (!crucible_clock_i64(
+                    state->rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &value)) {
+                return false;
+            }
+            total += value;
+        } else if (kind == 6) {
+            CrucibleClockRuleState projected = *state;
+
+            if (!crucible_clock_wander_advance(
+                    source, &projected, raw_ns)) {
+                return false;
+            }
+            total += projected.wander_offset;
+        }
+    }
+    *contribution = total;
+    return true;
+}
+
+static bool crucible_clock_remove_contribution(
+    uint64_t value, __int128 contribution, uint64_t *result)
+{
+    __int128 adjusted = (__int128)value - contribution;
+
+    if (adjusted < 0 || adjusted > UINT64_MAX) {
+        return false;
+    }
+    *result = adjusted;
+    return true;
+}
+
+static bool crucible_clock_u64(const QemuCrucibleFaultRule *rule,
+                               uint16_t tag, uint64_t *value)
+{
+    const uint8_t *data;
+    uint32_t length;
+
+    if (!crucible_clock_field(rule, tag,
+            CRUCIBLE_NODE_FAULT_FIELD_TYPE_U64, &data, &length) ||
+        length != sizeof(*value)) {
+        return false;
+    }
+    *value = ldq_le_p(data);
+    return true;
+}
+
+static bool crucible_clock_i64(const QemuCrucibleFaultRule *rule,
+                               uint16_t tag, int64_t *value)
+{
+    const uint8_t *data;
+    uint32_t length;
+
+    if (!crucible_clock_field(rule, tag,
+            CRUCIBLE_NODE_FAULT_FIELD_TYPE_I64, &data, &length) ||
+        length != sizeof(*value)) {
+        return false;
+    }
+    *value = (int64_t)ldq_le_p(data);
+    return true;
+}
+
+static bool crucible_clock_transform_observed_at(
+    const QemuCrucibleFaultRule *rule, uint16_t opportunity_phase)
+{
+    uint32_t kind = 0;
+    uint16_t phase;
+
+    if (!crucible_clock_u32(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &kind)) {
+        return false;
+    }
+    if (kind != 5) {
+        return true;
+    }
+    phase = qemu_crucible_fault_rule_model_phase(rule);
+    return phase == opportunity_phase;
+}
+
+static bool crucible_clock_ratio(const QemuCrucibleFaultRule *rule,
+                                 uint16_t tag, uint64_t *numerator,
+                                 uint64_t *denominator)
+{
+    const uint8_t *data;
+    uint32_t length;
+
+    if (!crucible_clock_field(rule, tag,
+            CRUCIBLE_NODE_FAULT_FIELD_TYPE_RATIO, &data, &length) ||
+        length != 16) {
+        return false;
+    }
+    *numerator = ldq_le_p(data);
+    *denominator = ldq_le_p(data + 8);
+    return *numerator != 0 && *denominator != 0;
+}
+
+static bool crucible_clock_hash(const QemuCrucibleFaultRule *rule,
+                                uint16_t tag, const uint8_t **hash)
+{
+    uint32_t length;
+
+    return crucible_clock_field(rule, tag,
+        CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH, hash, &length) && length == 32;
+}
+
+static uint64_t crucible_clock_gcd(uint64_t left, uint64_t right)
+{
+    while (right != 0) {
+        uint64_t remainder = left % right;
+
+        left = right;
+        right = remainder;
+    }
+    return left;
+}
+
+static bool crucible_clock_add_i64(int64_t *total, int64_t value)
+{
+    if ((value > 0 && *total > INT64_MAX - value) ||
+        (value < 0 && *total < INT64_MIN - value)) {
+        return false;
+    }
+    *total += value;
+    return true;
+}
+
+static bool crucible_clock_multiply_ratio(
+    uint64_t *numerator, uint64_t *denominator,
+    uint64_t next_numerator, uint64_t next_denominator)
+{
+    uint64_t common;
+
+    common = crucible_clock_gcd(*numerator, next_denominator);
+    *numerator /= common;
+    next_denominator /= common;
+    common = crucible_clock_gcd(next_numerator, *denominator);
+    next_numerator /= common;
+    *denominator /= common;
+    if (*numerator > UINT64_MAX / next_numerator ||
+        *denominator > UINT64_MAX / next_denominator) {
+        return false;
+    }
+    *numerator *= next_numerator;
+    *denominator *= next_denominator;
+    return true;
+}
