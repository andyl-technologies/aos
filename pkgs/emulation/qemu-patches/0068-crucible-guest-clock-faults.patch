+static void crucible_clock_register(void)
+{
+    const uint32_t boundary =
+        1U << (CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY - 1);
+
+    qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_CLOCK_TRANSFORM,
+        QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_ALL, boundary,
+        "qemu.clock.transform.v1", qemu_crucible_fault_clock_impulse);
+    qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_CLOCK_SOURCE_STATE,
+        QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_ALL, boundary,
+        "qemu.clock.source-state.v1", NULL);
+    qemu_crucible_fault_vmstate_register(&crucible_clock_vmstate_section);
+    crucible_clock_registered = true;
+}
