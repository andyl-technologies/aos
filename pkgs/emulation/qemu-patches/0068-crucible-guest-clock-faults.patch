+static void crucible_clock_source_clear_rules(CrucibleClockSource *source)
+{
+    if (source->rules) {
+        for (guint i = 0; i < source->rules->len; i++) {
+            crucible_clock_rule_state_clear(&g_array_index(
+                source->rules, CrucibleClockRuleState, i));
+        }
+        g_array_unref(source->rules);
+    }
+    source->rules = NULL;
+    qemu_crucible_fault_rule_unref(source->source_rule);
+    source->source_rule = NULL;
+}
+
+static gint crucible_clock_source_compare(gconstpointer left,
+                                          gconstpointer right)
+{
+    const CrucibleClockSource *left_source = left;
+    const CrucibleClockSource *right_source = right;
+
+    return strcmp(left_source->capability.id, right_source->capability.id);
+}
+
+static bool crucible_clock_manifest_finalize(void)
+{
+    uint16_t architecture = 0;
+
+    if (crucible_clock_manifest_finalized) {
+        return true;
+    }
+    if (!crucible_clock_sources || crucible_clock_sources->len == 0) {
+        return false;
+    }
+    g_array_sort(crucible_clock_sources, crucible_clock_source_compare);
+    for (guint i = 0; i < crucible_clock_sources->len; i++) {
+        const CrucibleClockSource *source = &g_array_index(
+            crucible_clock_sources, CrucibleClockSource, i);
+
+        if (i != 0) {
+            const CrucibleClockSource *previous = &g_array_index(
+                crucible_clock_sources, CrucibleClockSource, i - 1);
+
+            if (strcmp(previous->capability.id,
+                       source->capability.id) == 0) {
+                return false;
+            }
+        }
+        if (architecture == 0) {
+            architecture = source->capability.architecture;
+        } else if (architecture != source->capability.architecture) {
+            return false;
+        }
+    }
+    crucible_clock_manifest_finalized = true;
+    return true;
+}
+
+int qemu_crucible_fault_clock_source_register(
+    const QemuCrucibleClockSourceDescriptor *descriptor)
+{
+    CrucibleClockSource source = { 0 };
+
+    if (!crucible_clock_mode()) {
+        return 0;
+    }
+    if (!descriptor || !descriptor->id || !descriptor->implementation ||
+        descriptor->source_kind == 0 ||
+        (descriptor->architecture !=
+             QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_X86_64 &&
+         descriptor->architecture !=
+             QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_AARCH64) ||
+        descriptor->source_kind > QEMU_CRUCIBLE_CLOCK_DEVICE ||
+        descriptor->base_domain == 0 || descriptor->base_domain > 2 ||
+        descriptor->timer_relationship > 1 ||
+        descriptor->monotonicity < QEMU_CRUCIBLE_CLOCK_ALLOW_BACKWARD ||
+        descriptor->monotonicity > QEMU_CRUCIBLE_CLOCK_FAULT_ON_BACKWARD ||
+        descriptor->width_bits == 0 || descriptor->width_bits > 64 ||
+        descriptor->frequency_numerator == 0 ||
+        descriptor->frequency_denominator == 0 ||
+        descriptor->model_phase_mask == 0 ||
+        descriptor->model_phase_mask & ~((UINT64_C(1) <<
+            QEMU_CRUCIBLE_MODEL_PHASE_SOURCE_SWITCH) - 1) ||
+        descriptor->flags & ~(QEMU_CRUCIBLE_CLOCK_SOURCE_WRAPS |
+                              QEMU_CRUCIBLE_CLOCK_SOURCE_READ_ERROR) ||
+        !(descriptor->model_phase_mask &
+          (UINT64_C(1) <<
+           (QEMU_CRUCIBLE_MODEL_PHASE_CLOCK_READ - 1))) ||
+        ((descriptor->timer_relationship == 1) !=
+         ((descriptor->model_phase_mask &
+           (UINT64_C(1) << (QEMU_CRUCIBLE_MODEL_PHASE_ARM - 1))) &&
+          (descriptor->model_phase_mask &
+           (UINT64_C(1) << (QEMU_CRUCIBLE_MODEL_PHASE_FIRE - 1))))) ||
+        strlen(descriptor->id) == 0 || strlen(descriptor->id) > 96 ||
+        strlen(descriptor->implementation) == 0 ||
+        strlen(descriptor->implementation) > 96 ||
+        (descriptor->architecture ==
+             QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_X86_64 &&
+         descriptor->source_kind >= QEMU_CRUCIBLE_CLOCK_ARM_COUNTER &&
+         descriptor->source_kind != QEMU_CRUCIBLE_CLOCK_DEVICE) ||
+        (descriptor->architecture ==
+             QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_AARCH64 &&
+         descriptor->source_kind <= QEMU_CRUCIBLE_CLOCK_X86_ACPI_PM_TIMER) ||
+        crucible_clock_manifest_finalized || crucible_clock_bindings_sealed) {
+        return -EINVAL;
+    }
+    if (!crucible_clock_sources) {
+        crucible_clock_sources = g_array_new(
+            false, true, sizeof(CrucibleClockSource));
+    }
+    if (crucible_clock_sources->len == CRUCIBLE_CLOCK_MAX_SOURCES ||
+        crucible_clock_source_by_kind(
+            descriptor->source_kind, descriptor->instance)) {
+        return -EEXIST;
+    }
+    source.capability.source_kind = descriptor->source_kind;
+    source.instance = descriptor->instance;
+    source.capability.architecture = descriptor->architecture;
+    source.capability.base_domain = descriptor->base_domain;
+    source.capability.timer_relationship = descriptor->timer_relationship;
+    source.capability.width_bits = descriptor->width_bits;
+    source.capability.flags = descriptor->flags;
+    source.capability.frequency_numerator =
+        descriptor->frequency_numerator;
+    source.capability.frequency_denominator =
+        descriptor->frequency_denominator;
+    source.capability.model_phase_mask = descriptor->model_phase_mask;
+    source.capability.vmstate = 1;
+    source.capability.monotonicity = descriptor->monotonicity;
+    source.capability.id = g_strdup(descriptor->id);
+    source.capability.implementation = g_strdup(
+        descriptor->implementation);
+    source.rearm_timers = descriptor->rearm_timers;
+    source.read_raw_ns = descriptor->read_raw_ns;
+    source.scheduler_to_raw_ns = descriptor->scheduler_to_raw_ns;
+    source.raw_advances = descriptor->raw_advances;
+    source.timer_opaque = descriptor->opaque;
+    source.drift_numerator = 1;
+    source.drift_denominator = 1;
+    source.impulse_drift_numerator = 1;
+    source.impulse_drift_denominator = 1;
+    source.monotonicity = descriptor->monotonicity;
+    source.overdue_policy = 1;
+    source.source_state = CRUCIBLE_CLOCK_HEALTHY;
+    source.previous_source_state = CRUCIBLE_CLOCK_HEALTHY;
+    source.rules = g_array_new(false, true, sizeof(CrucibleClockRuleState));
+    g_array_append_val(crucible_clock_sources, source);
+    return 0;
+}
+
+size_t qemu_plugin_crucible_fault_clock_manifest(
+    struct qemu_plugin_crucible_fault_clock_capability *out,
+    size_t capacity, uint16_t *architecture)
+{
+    uint16_t scope = 0;
+
+    if (!architecture || !crucible_clock_mode() ||
+        !crucible_clock_manifest_finalize()) {
+        return 0;
+    }
+    for (guint i = 0; i < crucible_clock_sources->len; i++) {
+        const CrucibleClockSource *source = &g_array_index(
+            crucible_clock_sources, CrucibleClockSource, i);
+
+        if (scope == 0) {
+            scope = source->capability.architecture;
+        } else if (scope != source->capability.architecture) {
+            return 0;
+        }
+        if (out && capacity >= crucible_clock_sources->len) {
+            out[i] = source->capability;
+        }
+    }
+    *architecture = scope;
+    return crucible_clock_sources->len;
+}
+
+int qemu_plugin_crucible_fault_clock_bind(
+    uint32_t row_index, const uint8_t id[32])
+{
+    uint8_t zero[32] = { 0 };
+    CrucibleClockSource *source;
+
+    if (!id || !crucible_clock_sources ||
+        !crucible_clock_manifest_finalized ||
+        crucible_clock_bindings_sealed ||
+        row_index >= crucible_clock_sources->len ||
+        memcmp(id, zero, sizeof(zero)) == 0) {
+        return -EINVAL;
+    }
+    source = &g_array_index(
+        crucible_clock_sources, CrucibleClockSource, row_index);
+    if (source->binding.bound) {
+        return -EEXIST;
+    }
+    for (guint i = 0; i < crucible_clock_sources->len; i++) {
+        const CrucibleClockSource *other = &g_array_index(
+            crucible_clock_sources, CrucibleClockSource, i);
+
+        if (other->binding.bound && memcmp(other->binding.id, id, 32) == 0) {
+            return -EEXIST;
+        }
+    }
+    memcpy(source->binding.id, id, 32);
+    source->binding.bound = true;
+    return 0;
+}
+
+int qemu_plugin_crucible_fault_clock_bindings_seal(
+    const uint8_t manifest_sha256[32])
+{
+    uint8_t zero[32] = { 0 };
+    int64_t signed_now;
+    uint64_t now;
+
+    if (!manifest_sha256 || memcmp(manifest_sha256, zero, 32) == 0 ||
+        !crucible_clock_sources || !crucible_clock_manifest_finalized ||
+        crucible_clock_bindings_sealed) {
+        return -EINVAL;
+    }
+    for (guint i = 0; i < crucible_clock_sources->len; i++) {
+        if (!g_array_index(crucible_clock_sources,
+                           CrucibleClockSource, i).binding.bound) {
+            return -EINVAL;
+        }
+    }
+    signed_now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (signed_now < 0) {
+        return -ERANGE;
+    }
+    memcpy(crucible_clock_manifest_digest, manifest_sha256, 32);
+    now = signed_now;
+    for (guint i = 0; i < crucible_clock_sources->len; i++) {
+        CrucibleClockSource *source = &g_array_index(
+            crucible_clock_sources, CrucibleClockSource, i);
+
+        uint64_t raw_ns = now;
+
+        if (source->read_raw_ns &&
+            !source->read_raw_ns(source->timer_opaque, &raw_ns)) {
+            return -ERANGE;
+        }
+        source->anchor_raw_ns = raw_ns;
+        source->anchor_value_ns = raw_ns;
+        source->last_value_ns = raw_ns;
+        source->has_last_value = true;
+        source->transform_generation = 1;
+        source->wander_timer = timer_new_ns(
+            QEMU_CLOCK_VIRTUAL, crucible_clock_wander_timer, source);
+    }
+    crucible_clock_bindings_sealed = true;
+    for (guint i = 0; i < crucible_clock_sources->len; i++) {
+        crucible_clock_wander_timer_rearm(&g_array_index(
+            crucible_clock_sources, CrucibleClockSource, i));
+    }
+    return 0;
+}
+
+static bool crucible_clock_rule_selects(
+    const QemuCrucibleFaultRule *rule, const CrucibleClockSource *source)
+{
+    const uint8_t *id;
+
+    if (qemu_crucible_fault_rule_target_kind(rule) !=
+            CRUCIBLE_NODE_FAULT_TARGET_CLOCK ||
+        !crucible_clock_hash(rule, CRUCIBLE_NODE_FAULT_FIELD_T1, &id)) {
+        return false;
+    }
+    return memcmp(id, source->binding.id, 32) == 0;
+}
+
+static bool crucible_clock_hash_set_contains(
+    const QemuCrucibleFaultRule *rule, uint16_t tag,
+    const uint8_t id[32])
+{
+    const uint8_t *data;
+    uint32_t length;
+
+    if (!crucible_clock_field(rule, tag,
+            CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH_SET, &data, &length) ||
+        length == 0 || length % 32 != 0) {
+        return false;
+    }
+    for (uint32_t offset = 0; offset < length; offset += 32) {
+        if (memcmp(data + offset, id, 32) == 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool crucible_clock_json_i64_array(
+    const QObject *object, GArray **values_out)
+{
+    QList *list = qobject_to(QList, object);
+    QListEntry *entry;
+    g_autoptr(GArray) values = g_array_new(false, false, sizeof(int64_t));
+
+    if (!list || qlist_size(list) == 0 ||
+        qlist_size(list) > CRUCIBLE_CLOCK_MAX_TABLE) {
+        return false;
+    }
+    QLIST_FOREACH_ENTRY(list, entry) {
+        QNum *number = qobject_to(QNum, qlist_entry_obj(entry));
+        int64_t value;
+
+        if (!number || number->kind == QNUM_DOUBLE ||
+            !qnum_get_try_int(number, &value)) {
+            return false;
+        }
+        g_array_append_val(values, value);
+    }
+    *values_out = g_steal_pointer(&values);
+    return true;
+}
+
+static bool crucible_clock_wander_policy(
+    const QemuCrucibleFaultRule *rule, uint64_t *step,
+    uint64_t *maximum_offset, uint64_t *maximum_rate, GArray **increments)
+{
+    QDict *dict = qobject_to(QDict, qemu_crucible_fault_rule_json(
+        rule, CRUCIBLE_NODE_FAULT_FIELD_P6));
+    QNum *step_number, *offset_number, *rate_number;
+
+    if (!dict) {
+        return false;
+    }
+    step_number = qobject_to(QNum, qdict_get(dict, "step_nanos"));
+    offset_number = qobject_to(
+        QNum, qdict_get(dict, "maximum_offset_nanos"));
+    rate_number = qobject_to(
+        QNum, qdict_get(dict, "maximum_rate_ppb"));
+    return step_number && offset_number && rate_number &&
+           qnum_get_try_uint(step_number, step) && *step != 0 &&
+           qnum_get_try_uint(offset_number, maximum_offset) &&
+           *maximum_offset != 0 &&
+           qnum_get_try_uint(rate_number, maximum_rate) &&
+           *maximum_rate != 0 &&
+           crucible_clock_json_i64_array(
+               qdict_get(dict, "increments_ppb"), increments);
+}
+
+static uint64_t crucible_clock_keyed_index(
+    const QemuCrucibleFaultRule *rule, const CrucibleClockSource *source,
+    uint64_t sequence, size_t count)
+{
+    uint8_t material[80] = { 0 };
+    uint8_t digest[32];
+
+    memcpy(material, "CRUCKEY1", 8);
+    memcpy(material + 8,
+           qemu_crucible_fault_rule_binding_hash(rule), 32);
+    memcpy(material + 40, source->binding.id, 32);
+    stq_le_p(material + 72, sequence);
+    crucible_clock_sha256(material, sizeof(material), digest);
+    return ldq_le_p(digest) % count;
+}
+
+static uint64_t crucible_clock_timer_opportunity(
+    const CrucibleClockSource *source, uint64_t transition_sequence,
+    uint16_t model_phase,
+    uint16_t timer_role, uint32_t timer_index)
+{
+    uint8_t material[64] = { 0 };
+    uint8_t digest[32];
+
+    memcpy(material, "CRUCTMR1", 8);
+    memcpy(material + 8, source->binding.id, 32);
+    stq_le_p(material + 40, transition_sequence);
+    stw_le_p(material + 48, model_phase);
+    stw_le_p(material + 50, timer_role);
+    stl_le_p(material + 52, timer_index);
+    stq_le_p(material + 56, source->transform_generation);
+    crucible_clock_sha256(material, sizeof(material), digest);
+    return ldq_le_p(digest) == 0 ? UINT64_MAX : ldq_le_p(digest);
+}
+
+static bool crucible_clock_apply_timer_jitter(
+    CrucibleClockSource *source, uint16_t model_phase,
+    uint16_t timer_role, uint32_t timer_index, uint64_t timer_arm_sequence,
+    uint64_t *deadline)
+{
+    for (guint i = 0; source->rules && i < source->rules->len; i++) {
+        CrucibleClockRuleState *state = &g_array_index(
+            source->rules, CrucibleClockRuleState, i);
+        g_autoptr(GArray) distribution = NULL;
+        uint64_t maximum;
+        uint64_t opportunity;
+        int64_t jitter;
+        uint32_t kind;
+
+        if (!crucible_clock_u32(
+                state->rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &kind)) {
+            return false;
+        }
+        if (kind != 5 ||
+            qemu_crucible_fault_rule_model_phase(state->rule) !=
+                model_phase) {
+            continue;
+        }
+        if (!crucible_clock_u64(state->rule,
+                                CRUCIBLE_NODE_FAULT_FIELD_P5,
+                                &maximum) ||
+            !crucible_clock_json_i64_array(
+                qemu_crucible_fault_rule_json(
+                    state->rule, CRUCIBLE_NODE_FAULT_FIELD_P6),
+                &distribution)) {
+            return false;
+        }
+        opportunity = crucible_clock_timer_opportunity(
+            source, timer_arm_sequence,
+            model_phase, timer_role, timer_index);
+        jitter = g_array_index(
+            distribution, int64_t,
+            crucible_clock_keyed_index(
+                state->rule, source, opportunity, distribution->len));
+        if ((jitter < 0 && (uint64_t)(-(jitter + 1)) + 1 > maximum) ||
+            (jitter >= 0 && (uint64_t)jitter > maximum) ||
+            !crucible_clock_apply_signed(*deadline, jitter, deadline)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool crucible_clock_apply_signed(uint64_t value, int64_t delta,
+                                        uint64_t *result)
+{
+    if (delta >= 0) {
+        if (value > UINT64_MAX - (uint64_t)delta) {
+            return false;
+        }
+        *result = value + delta;
+        return true;
+    }
+    uint64_t magnitude = (uint64_t)(-(delta + 1)) + 1;
+
+    if (value < magnitude) {
+        return false;
+    }
+    *result = value - magnitude;
+    return true;
+}
+
+static bool crucible_clock_scaled_delta(
+    uint64_t raw, uint64_t anchor, uint64_t numerator,
+    uint64_t denominator, uint64_t *scaled)
+{
+    __uint128_t product;
+
+    if (raw < anchor || denominator == 0) {
+        return false;
+    }
+    product = (__uint128_t)(raw - anchor) * numerator;
+    product = (product + denominator / 2) / denominator;
+    if (product > UINT64_MAX) {
+        return false;
+    }
+    *scaled = product;
+    return true;
+}
+
+static bool crucible_clock_source_raw_at(
+    CrucibleClockSource *source, uint64_t scheduler_ns, uint64_t *raw_ns)
+{
+    if (source->scheduler_to_raw_ns) {
+        return source->scheduler_to_raw_ns(
+            source->timer_opaque, scheduler_ns, raw_ns);
+    }
+    *raw_ns = scheduler_ns;
+    return true;
+}
+
+static bool crucible_clock_scheduler_for_raw(
+    CrucibleClockSource *source, uint64_t target_raw_ns,
+    int64_t *scheduler_ns)
+{
+    int64_t signed_now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    uint64_t lower, upper, step, raw_ns;
+
+    if (!scheduler_ns || signed_now < 0) {
+        return false;
+    }
+    lower = signed_now;
+    if (!crucible_clock_source_raw_at(source, lower, &raw_ns)) {
+        return false;
+    }
+    if (raw_ns >= target_raw_ns) {
+        *scheduler_ns = signed_now;
+        return true;
+    }
+    upper = lower;
+    step = 1;
+    for (;;) {
+        uint64_t candidate = upper > INT64_MAX - step ?
+            INT64_MAX : upper + step;
+
+        if (!crucible_clock_source_raw_at(source, candidate, &raw_ns)) {
+            return false;
+        }
+        if (raw_ns >= target_raw_ns) {
+            upper = candidate;
+            break;
+        }
+        if (candidate == INT64_MAX) {
+            return false;
+        }
+        lower = candidate;
+        upper = candidate;
+        step = MIN(step, (uint64_t)INT64_MAX / 2);
+        step *= 2;
+    }
+    while (lower + 1 < upper) {
+        uint64_t middle = lower + (upper - lower) / 2;
+
+        if (!crucible_clock_source_raw_at(source, middle, &raw_ns)) {
+            return false;
+        }
+        if (raw_ns >= target_raw_ns) {
+            upper = middle;
+        } else {
+            lower = middle;
+        }
+    }
+    *scheduler_ns = upper;
+    return true;
+}
+
+static bool crucible_clock_source_value_internal(
+    CrucibleClockSource *source, uint64_t raw_ns, uint64_t scheduler_ns,
+    uint64_t opportunity, bool include_opportunity, uint32_t depth,
+    uint64_t *value_out, bool *read_error)
+{
+    uint64_t scaled, value;
+
+    *read_error = false;
+    if (!crucible_clock_sources || depth >= crucible_clock_sources->len) {
+        return false;
+    }
+    if (source->source_state == CRUCIBLE_CLOCK_FAILED_READ_ERROR) {
+        *read_error = true;
+        return true;
+    }
+    if (source->source_state == CRUCIBLE_CLOCK_FAILED_STOP) {
+        *value_out = source->has_last_value ? source->last_value_ns :
+                                              source->anchor_value_ns;
+        return true;
+    }
+    if (source->source_state == CRUCIBLE_CLOCK_FALLBACK) {
+        CrucibleClockSource *fallback = crucible_clock_source_by_id(
+            source->fallback_id);
+        uint64_t fallback_raw;
+
+        if (!fallback || fallback == source ||
+            !crucible_clock_source_raw_at(
+                fallback, scheduler_ns, &fallback_raw) ||
+            !crucible_clock_source_value_internal(
+                fallback, fallback_raw, scheduler_ns, opportunity,
+                include_opportunity, depth + 1, &raw_ns,
+                read_error) || *read_error) {
+            return false;
+        }
+    }
+    if (!crucible_clock_scaled_delta(
+            raw_ns, source->anchor_raw_ns, source->drift_numerator,
+            source->drift_denominator, &scaled) ||
+        source->anchor_value_ns > UINT64_MAX - scaled) {
+        return false;
+    }
+    value = source->anchor_value_ns + scaled;
+    if (!crucible_clock_apply_signed(value, source->additive_nanos, &value)) {
+        return false;
+    }
+    for (guint i = 0; source->rules && i < source->rules->len; i++) {
+        CrucibleClockRuleState *rule_state = &g_array_index(
+            source->rules, CrucibleClockRuleState, i);
+        uint32_t kind;
+
+        if (!crucible_clock_u32(rule_state->rule,
+                                CRUCIBLE_NODE_FAULT_FIELD_P2, &kind)) {
+            return false;
+        }
+        if (kind == 5 && include_opportunity &&
+            qemu_crucible_fault_rule_model_phase(rule_state->rule) ==
+                QEMU_CRUCIBLE_MODEL_PHASE_CLOCK_READ) {
+            g_autoptr(GArray) distribution = NULL;
+            uint64_t maximum;
+            int64_t jitter;
+
+            if (!crucible_clock_u64(rule_state->rule,
+                                    CRUCIBLE_NODE_FAULT_FIELD_P5,
+                                    &maximum) ||
+                !crucible_clock_json_i64_array(
+                    qemu_crucible_fault_rule_json(
+                        rule_state->rule, CRUCIBLE_NODE_FAULT_FIELD_P6),
+                    &distribution)) {
+                return false;
+            }
+            jitter = g_array_index(
+                distribution, int64_t,
+                crucible_clock_keyed_index(
+                    rule_state->rule, source, opportunity,
+                    distribution->len));
+            if ((jitter < 0 && (uint64_t)(-(jitter + 1)) + 1 > maximum) ||
+                (jitter >= 0 && (uint64_t)jitter > maximum) ||
+                !crucible_clock_apply_signed(value, jitter, &value)) {
+                return false;
+            }
+        } else if (kind == 6) {
+            CrucibleClockRuleState projected = *rule_state;
+
+            if (!crucible_clock_wander_advance(
+                    source, &projected, raw_ns)) {
+                return false;
+            }
+            if (!crucible_clock_apply_signed(
+                    value, projected.wander_offset, &value)) {
+                return false;
+            }
+        }
+    }
+    if (source->frozen) {
+        value = source->frozen_value_ns;
+    }
+    if (source->synchronizing) {
+        int64_t remaining = source->synchronization_remaining_ns;
+        uint64_t magnitude = remaining < 0 ?
+            (uint64_t)(-(remaining + 1)) + 1 : (uint64_t)remaining;
+        uint64_t elapsed = raw_ns >= source->synchronization_anchor_raw_ns ?
+            raw_ns - source->synchronization_anchor_raw_ns : 0;
+        __uint128_t progress = (__uint128_t)elapsed *
+            source->synchronization_numerator /
+            source->synchronization_denominator;
+        uint64_t correction = progress >= magnitude ? 0 :
+            magnitude - (uint64_t)progress;
+        int64_t signed_correction;
+
+        if (correction <= source->synchronization_threshold_ns) {
+            correction = 0;
+        }
+        signed_correction = remaining < 0 ?
+            (correction == (UINT64_C(1) << 63) ? INT64_MIN :
+             -(int64_t)correction) : (int64_t)correction;
+        if (!crucible_clock_apply_signed(value, signed_correction, &value)) {
+            return false;
+        }
+        if (include_opportunity && correction == 0) {
+            source->synchronizing = false;
+            source->synchronization_remaining_ns = 0;
+        }
+    }
+    if (source->has_last_value && value < source->last_value_ns) {
+        if (source->monotonicity == 2) {
+            value = source->last_value_ns;
+        } else if (source->monotonicity == 3) {
+            return false;
+        }
+    }
+    *value_out = value;
+    return true;
+}
+
+static bool crucible_clock_source_value(
+    CrucibleClockSource *source, uint64_t raw_ns, uint64_t scheduler_ns,
+    uint64_t opportunity, bool include_opportunity,
+    uint64_t *value_out, bool *read_error)
+{
+    return crucible_clock_source_value_internal(
+        source, raw_ns, scheduler_ns, opportunity, include_opportunity, 0,
+        value_out, read_error);
+}
+
+static bool crucible_clock_wander_advance_one(
+    CrucibleClockSource *source, CrucibleClockRuleState *state,
+    uint64_t raw_ns)
+{
+    g_autoptr(GArray) increments = NULL;
+    uint64_t step, maximum_offset, maximum_rate;
+
+    if (!crucible_clock_wander_policy(state->rule, &step,
+                                      &maximum_offset, &maximum_rate,
+                                      &increments)) {
+        return false;
+    }
+    if (state->wander_next_ns == 0) {
+        state->wander_next_ns = raw_ns > UINT64_MAX - step ?
+            UINT64_MAX : raw_ns + step;
+        return true;
+    }
+    if (state->wander_next_ns != UINT64_MAX &&
+        raw_ns >= state->wander_next_ns) {
+        int64_t increment = g_array_index(
+            increments, int64_t,
+            crucible_clock_keyed_index(state->rule, source,
+                                        state->wander_sequence,
+                                        increments->len));
+        int64_t next_rate;
+        __int128 offset_delta;
+        __int128 next_offset;
+
+        if (state->wander_sequence == UINT64_MAX ||
+            !crucible_clock_add_i64(&state->wander_rate_ppb, increment)) {
+            return false;
+        }
+        next_rate = state->wander_rate_ppb;
+        if (next_rate > (int64_t)maximum_rate) {
+            next_rate = maximum_rate;
+        } else if (next_rate < -(int64_t)maximum_rate) {
+            next_rate = -(int64_t)maximum_rate;
+        }
+        state->wander_rate_ppb = next_rate;
+        offset_delta = (__int128)next_rate * step / 1000000000;
+        next_offset = (__int128)state->wander_offset + offset_delta;
+        if (next_offset > maximum_offset) {
+            next_offset = maximum_offset;
+        } else if (next_offset < -(__int128)maximum_offset) {
+            next_offset = -(__int128)maximum_offset;
+        }
+        state->wander_offset = next_offset;
+        state->wander_sequence++;
+        if (state->wander_next_ns > UINT64_MAX - step) {
+            state->wander_next_ns = UINT64_MAX;
+        } else {
+            state->wander_next_ns += step;
+        }
+    }
+    return true;
+}
+
+static bool crucible_clock_wander_advance(
+    CrucibleClockSource *source, CrucibleClockRuleState *state,
+    uint64_t raw_ns)
+{
+    size_t advances = 0;
+
+    do {
+        if (advances++ == CRUCIBLE_CLOCK_MAX_TABLE) {
+            return false;
+        }
+        if (!crucible_clock_wander_advance_one(source, state, raw_ns)) {
+            return false;
+        }
+    } while (state->wander_next_ns != UINT64_MAX &&
+             raw_ns >= state->wander_next_ns);
+    return true;
+}
+
+static void crucible_clock_wander_timer_rearm(CrucibleClockSource *source)
+{
+    uint64_t next_raw_ns = UINT64_MAX;
+    int64_t scheduler_ns;
+
+    if (!source->wander_timer) {
+        return;
+    }
+    if (source->raw_advances &&
+        !source->raw_advances(source->timer_opaque)) {
+        timer_del(source->wander_timer);
+        return;
+    }
+    for (guint i = 0; source->rules && i < source->rules->len; i++) {
+        CrucibleClockRuleState *state = &g_array_index(
+            source->rules, CrucibleClockRuleState, i);
+        uint32_t kind;
+
+        if (!crucible_clock_u32(state->rule,
+                                CRUCIBLE_NODE_FAULT_FIELD_P2, &kind)) {
+            qemu_crucible_fault_clock_event_terminal();
+            timer_del(source->wander_timer);
+            return;
+        }
+        if (kind == 6) {
+            next_raw_ns = MIN(next_raw_ns, state->wander_next_ns);
+        }
+    }
+    if (next_raw_ns == UINT64_MAX) {
+        timer_del(source->wander_timer);
+        return;
+    }
+    if (!crucible_clock_scheduler_for_raw(
+            source, next_raw_ns, &scheduler_ns)) {
+        qemu_crucible_fault_clock_event_terminal();
+        timer_del(source->wander_timer);
+        return;
+    }
+    timer_mod(source->wander_timer, scheduler_ns);
+}
+
+static bool crucible_clock_emit_wander_transition(
+    CrucibleClockSource *source,
+    const CrucibleClockWanderTransition *transition,
+    uint64_t scheduler_ns, uint64_t raw_ns,
+    const uint8_t before_hash[32], const uint8_t after_hash[32],
+    QemuCrucibleFaultEventReservation *reservation)
+{
+    uint8_t opportunity_hash[32], identity[80] = { 0 };
+    uint8_t evidence[CRUCIBLE_CLOCK_EVIDENCE_BYTES] = { 0 };
+    uint64_t opportunity;
+
+    if (!qemu_crucible_fault_rule_count_applied(
+            transition->state->rule, &opportunity)) {
+        return false;
+    }
+    memcpy(identity, "CRUCCWA1", 8);
+    memcpy(identity + 8, qemu_crucible_fault_rule_binding_hash(
+               transition->state->rule), 32);
+    memcpy(identity + 40, source->binding.id, 32);
+    stq_le_p(identity + 72, opportunity);
+    crucible_clock_sha256(identity, sizeof(identity), opportunity_hash);
+    memcpy(evidence, "CRUCCWE1", 8);
+    stw_le_p(evidence + 8, 1);
+    stw_le_p(evidence + 10, source->capability.source_kind);
+    stq_le_p(evidence + 16, scheduler_ns);
+    stq_le_p(evidence + 24, raw_ns);
+    stq_le_p(evidence + 32, (uint64_t)transition->old_offset);
+    stq_le_p(evidence + 40, (uint64_t)transition->new_offset);
+    stq_le_p(evidence + 48, (uint64_t)transition->old_rate);
+    stq_le_p(evidence + 56, (uint64_t)transition->new_rate);
+    stq_le_p(evidence + 64, transition->old_next_ns);
+    stq_le_p(evidence + 72, transition->new_next_ns);
+    stq_le_p(evidence + 80, transition->old_sequence);
+    stq_le_p(evidence + 88, transition->new_sequence);
+    stq_le_p(evidence + 96, source->transform_generation);
+    memcpy(evidence + 104, source->binding.id, 32);
+    memcpy(evidence + 136,
+           qemu_crucible_fault_rule_binding_hash(
+               transition->state->rule), 32);
+    memcpy(evidence + 168, before_hash, 32);
+    memcpy(evidence + 200, after_hash, 32);
+    stq_le_p(evidence + 232, opportunity);
+    qemu_crucible_fault_event_reservation_consume(reservation);
+    qemu_crucible_fault_rule_event(
+        transition->state->rule, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+        qemu_crucible_fault_observed_icount(), opportunity_hash,
+        before_hash, after_hash, evidence, sizeof(evidence));
+    return true;
+}
+
+static void crucible_clock_wander_timer(void *opaque)
+{
+    CrucibleClockSource *source = opaque;
+    int64_t scheduler_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    g_autoptr(GArray) transitions = g_array_new(
+        false, false, sizeof(CrucibleClockWanderTransition));
+    QemuCrucibleFaultEventReservation *reservation = NULL;
+    uint8_t before_hash[32], after_hash[32];
+    uint64_t raw_ns;
+    size_t transition_count = 0;
+
+    if (scheduler_ns < 0 ||
+        !crucible_clock_source_raw_at(source, scheduler_ns, &raw_ns)) {
+        qemu_crucible_fault_clock_event_terminal();
+        return;
+    }
+    crucible_clock_source_digest(source, before_hash);
+    for (guint i = 0; source->rules && i < source->rules->len; i++) {
+        CrucibleClockRuleState *state = &g_array_index(
+            source->rules, CrucibleClockRuleState, i);
+        uint32_t kind;
+
+        if (!crucible_clock_u32(state->rule,
+                                CRUCIBLE_NODE_FAULT_FIELD_P2, &kind)) {
+            qemu_crucible_fault_clock_event_terminal();
+            return;
+        }
+        if (kind == 6 && state->wander_next_ns != UINT64_MAX &&
+            raw_ns >= state->wander_next_ns) {
+            g_autoptr(GArray) increments = NULL;
+            uint64_t step, maximum_offset, maximum_rate;
+            uint64_t due;
+
+            if (!crucible_clock_wander_policy(
+                    state->rule, &step, &maximum_offset, &maximum_rate,
+                    &increments)) {
+                qemu_crucible_fault_clock_event_terminal();
+                return;
+            }
+            due = (raw_ns - state->wander_next_ns) / step + 1;
+            if (due > CRUCIBLE_CLOCK_MAX_TABLE ||
+                due > SIZE_MAX - transition_count ||
+                transition_count + due > CRUCIBLE_CLOCK_MAX_TABLE) {
+                qemu_crucible_fault_clock_event_terminal();
+                return;
+            }
+            transition_count += due;
+        }
+    }
+    if (transition_count != 0) {
+        reservation = qemu_crucible_fault_event_reserve(transition_count);
+        if (!reservation) {
+            qemu_crucible_fault_clock_event_terminal();
+            return;
+        }
+        for (guint i = 0; source->rules && i < source->rules->len; i++) {
+            CrucibleClockRuleState *state = &g_array_index(
+                source->rules, CrucibleClockRuleState, i);
+            uint32_t kind;
+
+            if (!crucible_clock_u32(
+                    state->rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &kind)) {
+                crucible_clock_release_events(reservation);
+                qemu_crucible_fault_clock_event_terminal();
+                return;
+            }
+            while (kind == 6 && state->wander_next_ns != UINT64_MAX &&
+                   raw_ns >= state->wander_next_ns) {
+                CrucibleClockWanderTransition transition = {
+                    .state = state,
+                    .old_offset = state->wander_offset,
+                    .old_rate = state->wander_rate_ppb,
+                    .old_next_ns = state->wander_next_ns,
+                    .old_sequence = state->wander_sequence,
+                };
+
+                if (!crucible_clock_wander_advance_one(
+                        source, state, raw_ns)) {
+                    crucible_clock_release_events(reservation);
+                    qemu_crucible_fault_clock_event_terminal();
+                    return;
+                }
+                transition.new_offset = state->wander_offset;
+                transition.new_rate = state->wander_rate_ppb;
+                transition.new_next_ns = state->wander_next_ns;
+                transition.new_sequence = state->wander_sequence;
+                g_array_append_val(transitions, transition);
+            }
+        }
+        g_assert(transitions->len == transition_count);
+        if (source->transform_generation == UINT64_MAX) {
+            crucible_clock_release_events(reservation);
+            qemu_crucible_fault_clock_event_terminal();
+            return;
+        }
+        source->transform_generation++;
+        crucible_clock_rearm_source(source);
+        crucible_clock_source_digest(source, after_hash);
+        for (guint i = 0; i < transitions->len; i++) {
+            if (!crucible_clock_emit_wander_transition(
+                    source, &g_array_index(
+                        transitions, CrucibleClockWanderTransition, i),
+                    scheduler_ns, raw_ns, before_hash, after_hash,
+                    reservation)) {
+                crucible_clock_release_events(reservation);
+                qemu_crucible_fault_clock_event_terminal();
+                return;
+            }
+        }
+        crucible_clock_release_events(reservation);
+    }
+    crucible_clock_wander_timer_rearm(source);
+}
+
+static CrucibleClockRuleState *crucible_clock_find_old_rule(
+    GArray *rules, const QemuCrucibleFaultRule *rule)
+{
+    if (!rules) {
+        return NULL;
+    }
+    for (guint i = 0; i < rules->len; i++) {
+        CrucibleClockRuleState *state = &g_array_index(
+            rules, CrucibleClockRuleState, i);
+
+        if (qemu_crucible_fault_rule_generation(state->rule) ==
+                qemu_crucible_fault_rule_generation(rule) &&
+            memcmp(qemu_crucible_fault_rule_binding_hash(state->rule),
+                   qemu_crucible_fault_rule_binding_hash(rule), 32) == 0) {
+            return state;
+        }
+    }
+    return NULL;
+}
+
+typedef struct CrucibleClockCollect {
+    CrucibleClockSource *source;
+    GArray *old_rules;
+    bool source_state;
+    bool valid;
+} CrucibleClockCollect;
+
+static void crucible_clock_collect_rule(
+    const QemuCrucibleFaultRule *rule, void *opaque)
+{
+    CrucibleClockCollect *collect = opaque;
+    CrucibleClockRuleState state = { 0 };
+    CrucibleClockRuleState *old;
+
+    if (!crucible_clock_rule_selects(rule, collect->source)) {
+        return;
+    }
+    if (collect->source->rules->len == CRUCIBLE_CLOCK_MAX_RULES) {
+        collect->valid = false;
+        return;
+    }
+    state.rule = qemu_crucible_fault_rule_ref((QemuCrucibleFaultRule *)rule);
+    old = crucible_clock_find_old_rule(collect->old_rules, rule);
+    if (old) {
+        state.wander_offset = old->wander_offset;
+        state.wander_rate_ppb = old->wander_rate_ppb;
+        state.wander_next_ns = old->wander_next_ns;
+        state.wander_sequence = old->wander_sequence;
+    }
+    g_array_append_val(collect->source->rules, state);
+}
+
+static void crucible_clock_collect_source_rule(
+    const QemuCrucibleFaultRule *rule, void *opaque)
+{
+    CrucibleClockCollect *collect = opaque;
+
+    if (!crucible_clock_hash_set_contains(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P1,
+            collect->source->binding.id)) {
+        return;
+    }
+    if (collect->source->source_rule) {
+        collect->valid = false;
+        return;
+    }
+    collect->source->source_rule = qemu_crucible_fault_rule_ref(
+        (QemuCrucibleFaultRule *)rule);
+}
+
+static gint crucible_clock_rule_state_compare(gconstpointer left,
+                                               gconstpointer right)
+{
+    const CrucibleClockRuleState *a = left;
+    const CrucibleClockRuleState *b = right;
+
+    return memcmp(qemu_crucible_fault_rule_binding_hash(a->rule),
+                  qemu_crucible_fault_rule_binding_hash(b->rule), 32);
+}
+
+static bool crucible_clock_rule_identity_equal(
+    const QemuCrucibleFaultRule *left,
+    const QemuCrucibleFaultRule *right)
+{
+    return (!left && !right) ||
+        (left && right &&
+         qemu_crucible_fault_rule_generation(left) ==
+             qemu_crucible_fault_rule_generation(right) &&
+         memcmp(qemu_crucible_fault_rule_binding_hash(left),
+                qemu_crucible_fault_rule_binding_hash(right), 32) == 0);
+}
+
+static bool crucible_clock_rule_sets_equal(
+    const GArray *left, const GArray *right)
+{
+    if (!left || !right || left->len != right->len) {
+        return left == right;
+    }
+    for (guint i = 0; i < left->len; i++) {
+        const CrucibleClockRuleState *left_state = &g_array_index(
+            left, CrucibleClockRuleState, i);
+        const CrucibleClockRuleState *right_state = &g_array_index(
+            right, CrucibleClockRuleState, i);
+
+        if (!crucible_clock_rule_identity_equal(
+                left_state->rule, right_state->rule)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool crucible_clock_source_base(
+    CrucibleClockSource *source, uint64_t raw_ns, uint64_t scheduler_ns,
+    uint64_t *base, bool *read_error)
+{
+    if (source->source_state != CRUCIBLE_CLOCK_FALLBACK) {
+        *base = raw_ns;
+        *read_error = false;
+        return true;
+    }
+    CrucibleClockSource *fallback = crucible_clock_source_by_id(
+        source->fallback_id);
+    uint64_t fallback_raw;
+
+    return fallback && fallback != source &&
+           crucible_clock_source_raw_at(
+               fallback, scheduler_ns, &fallback_raw) &&
+           crucible_clock_source_value_internal(
+               fallback, fallback_raw, scheduler_ns, 0, false, 1,
+               base, read_error);
+}
+
+static bool crucible_clock_emit_source_transition(
+    const CrucibleClockSource *old_source, CrucibleClockSource *new_source,
+    QemuCrucibleFaultRule *rule, uint64_t scheduler_ns, uint64_t raw_ns,
+    uint64_t old_value, QemuCrucibleFaultEventReservation *reservation)
+{
+    uint8_t before_hash[32], after_hash[32], opportunity_hash[32];
+    uint8_t identity[80] = { 0 };
+    uint8_t evidence[CRUCIBLE_CLOCK_EVIDENCE_BYTES] = { 0 };
+    uint64_t opportunity;
+
+    if (!rule || !reservation ||
+        !qemu_crucible_fault_rule_count_applied(rule, &opportunity)) {
+        return false;
+    }
+    crucible_clock_source_digest(old_source, before_hash);
+    crucible_clock_source_digest(new_source, after_hash);
+    memcpy(identity, "CRUCCST2", 8);
+    memcpy(identity + 8, qemu_crucible_fault_rule_binding_hash(rule), 32);
+    memcpy(identity + 40, new_source->binding.id, 32);
+    stq_le_p(identity + 72, opportunity);
+    crucible_clock_sha256(identity, sizeof(identity), opportunity_hash);
+    memcpy(evidence, "CRUCCSE1", 8);
+    stw_le_p(evidence + 8, 1);
+    stw_le_p(evidence + 10, new_source->capability.source_kind);
+    stl_le_p(evidence + 12, old_source->source_state);
+    stl_le_p(evidence + 16, new_source->source_state);
+    stq_le_p(evidence + 24, scheduler_ns);
+    stq_le_p(evidence + 32, raw_ns);
+    stq_le_p(evidence + 40, old_value);
+    stq_le_p(evidence + 48, new_source->anchor_value_ns);
+    stq_le_p(evidence + 56, new_source->source_transition_generation);
+    memcpy(evidence + 64, new_source->binding.id, 32);
+    memcpy(evidence + 96, old_source->fallback_id, 32);
+    memcpy(evidence + 128, new_source->fallback_id, 32);
+    memcpy(evidence + 160,
+           qemu_crucible_fault_rule_binding_hash(rule), 32);
+    memcpy(evidence + 192, before_hash, 32);
+    memcpy(evidence + 224, after_hash, 32);
+    stq_le_p(evidence + 256, old_source->synchronization_remaining_ns);
+    stq_le_p(evidence + 264, new_source->synchronization_remaining_ns);
+    stq_le_p(evidence + 272, new_source->synchronization_numerator);
+    stq_le_p(evidence + 280, new_source->synchronization_denominator);
+    stq_le_p(evidence + 288, new_source->synchronization_threshold_ns);
+    stq_le_p(evidence + 296, opportunity);
+    stq_le_p(evidence + 304, new_source->transform_generation);
+    qemu_crucible_fault_event_reservation_consume(reservation);
+    qemu_crucible_fault_rule_event(
+        rule, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+        qemu_crucible_fault_observed_icount(), opportunity_hash,
+        before_hash, after_hash, evidence, sizeof(evidence));
+    return true;
+}
+
+static bool crucible_clock_source_transition(
+    CrucibleClockSource *source, const QemuCrucibleFaultRule *rule)
+{
+    QDict *transition = qobject_to(
+        QDict, qemu_crucible_fault_rule_json(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P2));
+    QDict *synchronization = qobject_to(
+        QDict, qemu_crucible_fault_rule_json(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P3));
+    const char *kind, *sync_kind;
+
+    if (!transition || !synchronization) {
+        return false;
+    }
+    kind = qdict_get_try_str(transition, "kind");
+    sync_kind = qdict_get_try_str(synchronization, "kind");
+    if (!kind || !sync_kind) {
+        return false;
+    }
+    source->source_state = CRUCIBLE_CLOCK_HEALTHY;
+    memset(source->fallback_id, 0, sizeof(source->fallback_id));
+    source->synchronizing = false;
+    source->synchronization_remaining_ns = 0;
+    source->synchronization_anchor_raw_ns = 0;
+    source->synchronization_numerator = 0;
+    source->synchronization_denominator = 0;
+    source->synchronization_threshold_ns = 0;
+    if (strcmp(kind, "degraded") == 0) {
+        source->source_state = CRUCIBLE_CLOCK_DEGRADED;
+    } else if (strcmp(kind, "failed") == 0) {
+        QDict *parameters = qdict_get_qdict(transition, "parameters");
+        const char *behavior = parameters ?
+            qdict_get_try_str(parameters, "behavior") : NULL;
+
+        if (!behavior) {
+            return false;
+        }
+        source->source_state = strcmp(behavior, "stop") == 0 ?
+            CRUCIBLE_CLOCK_FAILED_STOP :
+            (strcmp(behavior, "read_error") == 0 ?
+             CRUCIBLE_CLOCK_FAILED_READ_ERROR : 0);
+        if (source->source_state == 0) {
+            return false;
+        }
+    } else if (strcmp(kind, "fallback") == 0) {
+        QDict *parameters = qdict_get_qdict(transition, "parameters");
+        const char *fallback_name = parameters ?
+            qdict_get_try_str(parameters, "source") : NULL;
+        CrucibleClockSource *fallback = NULL;
+
+        for (guint i = 0; fallback_name && crucible_clock_sources &&
+             i < crucible_clock_sources->len; i++) {
+            CrucibleClockSource *candidate = &g_array_index(
+                crucible_clock_sources, CrucibleClockSource, i);
+
+            if (strcmp(candidate->capability.id, fallback_name) == 0) {
+                fallback = candidate;
+                break;
+            }
+        }
+        if (!fallback || fallback == source) {
+            return false;
+        }
+        source->source_state = CRUCIBLE_CLOCK_FALLBACK;
+        memcpy(source->fallback_id, fallback->binding.id, 32);
+    } else if (strcmp(kind, "healthy") != 0) {
+        return false;
+    }
+    if (strcmp(sync_kind, "slew") == 0) {
+        QDict *parameters = qdict_get_qdict(synchronization, "parameters");
+        QDict *ratio = parameters ?
+            qdict_get_qdict(parameters, "rate") : NULL;
+        QNum *numerator = ratio ?
+            qobject_to(QNum, qdict_get(ratio, "numerator")) : NULL;
+        QNum *denominator = ratio ?
+            qobject_to(QNum, qdict_get(ratio, "denominator")) : NULL;
+        QNum *threshold = parameters ? qobject_to(
+            QNum, qdict_get(parameters, "threshold_nanos")) : NULL;
+
+        if (!numerator || !denominator || !threshold ||
+            !qnum_get_try_uint(numerator,
+                              &source->synchronization_numerator) ||
+            !qnum_get_try_uint(denominator,
+                              &source->synchronization_denominator) ||
+            !qnum_get_try_uint(threshold,
+                              &source->synchronization_threshold_ns) ||
+            source->synchronization_numerator == 0 ||
+            source->synchronization_denominator == 0 ||
+            source->synchronization_threshold_ns == 0) {
+            return false;
+        }
+        source->synchronizing = true;
+    } else if (strcmp(sync_kind, "step") != 0) {
+        return false;
+    }
+    return true;
+}
+
+static bool crucible_clock_source_compile(CrucibleClockSource *source,
+    uint64_t scheduler_ns,
+    QemuCrucibleFaultEventReservation *transition_reservation)
+{
+    CrucibleClockSource old_state = *source;
+    GArray *old_rules = source->rules;
+    QemuCrucibleFaultRule *old_source_rule = source->source_rule;
+    bool old_frozen = source->frozen;
+    uint8_t old_freeze_release = source->freeze_release;
+    uint64_t raw_ns;
+    uint64_t old_value;
+    uint64_t old_base_value;
+    uint64_t base_value;
+    __int128 old_contribution;
+    bool read_error = false;
+    bool source_rule_changed;
+    CrucibleClockCollect collect = {
+        .source = source,
+        .old_rules = old_rules,
+        .valid = true,
+    };
+
+    if (!crucible_clock_source_raw_at(source, scheduler_ns, &raw_ns)) {
+        return false;
+    }
+    old_value = raw_ns;
+    old_base_value = raw_ns;
+    base_value = raw_ns;
+
+    if (source->transform_generation != 0 &&
+        !crucible_clock_source_value(
+            source, raw_ns, scheduler_ns, source->read_sequence,
+            false, &old_value, &read_error)) {
+        return false;
+    }
+    if (!crucible_clock_source_base(
+            source, raw_ns, scheduler_ns,
+            &old_base_value, &read_error) || read_error ||
+        !crucible_clock_rule_contribution(
+            source, old_rules, old_base_value, &old_contribution)) {
+        return false;
+    }
+    source->rules = g_array_new(
+        false, true, sizeof(CrucibleClockRuleState));
+    source->source_rule = NULL;
+    source->drift_numerator = source->impulse_drift_numerator;
+    source->drift_denominator = source->impulse_drift_denominator;
+    source->additive_nanos = source->impulse_additive_nanos;
+    source->frozen = false;
+    source->frozen_value_ns = 0;
+    source->freeze_release = 0;
+    source->monotonicity = source->capability.monotonicity;
+    source->overdue_policy = 1;
+    source->source_state = CRUCIBLE_CLOCK_HEALTHY;
+    source->synchronizing = false;
+    memset(source->fallback_id, 0, sizeof(source->fallback_id));
+    source->synchronization_remaining_ns = 0;
+    source->synchronization_anchor_raw_ns = 0;
+    source->synchronization_numerator = 0;
+    source->synchronization_denominator = 0;
+    source->synchronization_threshold_ns = 0;
+    qemu_crucible_fault_rule_foreach(
+        CRUCIBLE_FAULT_COMMAND_CLOCK_TRANSFORM,
+        crucible_clock_collect_rule, &collect);
+    qemu_crucible_fault_rule_foreach(
+        CRUCIBLE_FAULT_COMMAND_CLOCK_SOURCE_STATE,
+        crucible_clock_collect_source_rule, &collect);
+    if (!collect.valid) {
+        goto fail;
+    }
+    g_array_sort(source->rules, crucible_clock_rule_state_compare);
+    if (crucible_clock_rule_sets_equal(source->rules, old_rules) &&
+        crucible_clock_rule_identity_equal(
+            source->source_rule, old_source_rule)) {
+        crucible_clock_source_clear_rules(source);
+        *source = old_state;
+        return true;
+    }
+    source_rule_changed = !crucible_clock_rule_identity_equal(
+        source->source_rule, old_source_rule);
+    if (source_rule_changed && !transition_reservation) {
+        goto fail;
+    }
+    for (guint i = 0; i < source->rules->len; i++) {
+        CrucibleClockRuleState *state = &g_array_index(
+            source->rules, CrucibleClockRuleState, i);
+        uint32_t kind, policy;
+        int64_t signed_value;
+        uint64_t numerator, denominator, unsigned_value;
+
+        if (!crucible_clock_u32(state->rule,
+                                CRUCIBLE_NODE_FAULT_FIELD_P2, &kind) ||
+            !crucible_clock_i64(state->rule,
+                                CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                &signed_value) ||
+            !crucible_clock_ratio(state->rule,
+                                  CRUCIBLE_NODE_FAULT_FIELD_P4,
+                                  &numerator, &denominator) ||
+            !crucible_clock_u64(state->rule,
+                                CRUCIBLE_NODE_FAULT_FIELD_P5,
+                                &unsigned_value) ||
+            !crucible_clock_u32(state->rule,
+                                CRUCIBLE_NODE_FAULT_FIELD_P7, &policy)) {
+            goto fail;
+        }
+        source->monotonicity = MAX(source->monotonicity, policy);
+        if (!crucible_clock_u32(state->rule,
+                                CRUCIBLE_NODE_FAULT_FIELD_P8, &policy)) {
+            goto fail;
+        }
+        source->overdue_policy = MAX(source->overdue_policy, policy);
+        if ((kind == 1 || kind == 3) &&
+            !crucible_clock_add_i64(&source->additive_nanos,
+                                    signed_value)) {
+            goto fail;
+        }
+        if (kind == 2 && !crucible_clock_multiply_ratio(
+                &source->drift_numerator, &source->drift_denominator,
+                numerator, denominator)) {
+            goto fail;
+        }
+        if (kind == 4) {
+            if (source->frozen && source->frozen_value_ns != unsigned_value) {
+                goto fail;
+            }
+            source->frozen = true;
+            source->frozen_value_ns = unsigned_value;
+            QString *release = qobject_to(
+                QString, qemu_crucible_fault_rule_json(
+                    state->rule, CRUCIBLE_NODE_FAULT_FIELD_P6));
+            const char *release_name = release ?
+                qstring_get_str(release) : NULL;
+
+            if (!release_name) {
+                goto fail;
+            }
+            source->freeze_release =
+                strcmp(release_name, "resume_from_frozen") == 0 ? 1 :
+                (strcmp(release_name, "catch_up_jump") == 0 ? 2 : 0);
+            if (source->freeze_release == 0) {
+                goto fail;
+            }
+        }
+        if (kind == 6 && !crucible_clock_wander_advance(
+                source, state, raw_ns)) {
+            goto fail;
+        }
+    }
+    if (source->source_rule &&
+        !crucible_clock_source_transition(source, source->source_rule)) {
+        goto fail;
+    }
+    if (source_rule_changed) {
+        if (source->source_transition_generation == UINT64_MAX) {
+            goto fail;
+        }
+        source->source_transition_generation++;
+        source->previous_source_state = old_state.source_state;
+        memcpy(source->previous_fallback_id,
+               old_state.fallback_id, sizeof(source->previous_fallback_id));
+    }
+    if (!crucible_clock_source_base(
+            source, raw_ns, scheduler_ns,
+            &base_value, &read_error) || read_error) {
+        goto fail;
+    }
+    if (source->source_rule) {
+        bool slew = source->synchronizing;
+        uint64_t natural;
+
+        source->anchor_raw_ns = base_value;
+        source->anchor_value_ns = base_value;
+        source->synchronizing = false;
+        if (!crucible_clock_source_value(
+                source, raw_ns, scheduler_ns,
+                source->read_sequence, false,
+                &natural, &read_error) || read_error) {
+            goto fail;
+        }
+        if (slew && natural != old_value) {
+            if ((old_value > natural && old_value - natural > INT64_MAX) ||
+                (natural > old_value && natural - old_value >
+                                           (UINT64_C(1) << 63))) {
+                goto fail;
+            }
+            source->synchronization_remaining_ns = old_value >= natural ?
+                (int64_t)(old_value - natural) :
+                (natural - old_value == (UINT64_C(1) << 63) ? INT64_MIN :
+                 -(int64_t)(natural - old_value));
+            source->synchronization_anchor_raw_ns = base_value;
+            source->synchronizing = true;
+        }
+        if (source->synchronizing &&
+            source->synchronization_remaining_ns > 0 &&
+            (__uint128_t)source->synchronization_numerator *
+                    source->drift_denominator >=
+                (__uint128_t)source->drift_numerator *
+                    source->synchronization_denominator) {
+            /* A catch-down slew must not reverse the projected clock. */
+            goto fail;
+        }
+    } else {
+        source->anchor_raw_ns = base_value;
+        if (old_frozen && !source->frozen && old_freeze_release == 2) {
+            source->anchor_value_ns = base_value;
+        } else if (!crucible_clock_remove_contribution(
+                       old_value, old_contribution,
+                       &source->anchor_value_ns)) {
+            goto fail;
+        }
+    }
+    if (source->transform_generation == UINT64_MAX) {
+        goto fail;
+    }
+    source->transform_generation++;
+    if (source_rule_changed && !crucible_clock_emit_source_transition(
+            &old_state, source,
+            source->source_rule ? source->source_rule : old_source_rule,
+            scheduler_ns, raw_ns, old_value, transition_reservation)) {
+        goto fail;
+    }
+    if (old_rules) {
+        for (guint i = 0; i < old_rules->len; i++) {
+            crucible_clock_rule_state_clear(&g_array_index(
+                old_rules, CrucibleClockRuleState, i));
+        }
+        g_array_unref(old_rules);
+    }
+    qemu_crucible_fault_rule_unref(old_source_rule);
+    return true;
+
+fail:
+    crucible_clock_source_clear_rules(source);
+    *source = old_state;
+    return false;
+}
+
+void qemu_crucible_fault_clock_rules_changed(
+    QemuCrucibleFaultEventReservation **event_reservation)
+{
+    int64_t scheduler_ns;
+
+    if (!crucible_clock_mode() || !crucible_clock_bindings_sealed ||
+        !crucible_clock_sources) {
+        return;
+    }
+    scheduler_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (scheduler_ns < 0) {
+        error_report("Crucible clock rule compilation observed negative "
+                     "scheduler time");
+        abort();
+    }
+    for (guint i = 0; i < crucible_clock_sources->len; i++) {
+        if (!crucible_clock_source_compile(&g_array_index(
+                crucible_clock_sources, CrucibleClockSource, i),
+                scheduler_ns,
+                event_reservation ? *event_reservation : NULL)) {
+            error_report("Crucible clock rule compilation failed after "
+                         "prepared commit");
+            abort();
+        }
+        CrucibleClockSource *source = &g_array_index(
+            crucible_clock_sources, CrucibleClockSource, i);
+
+        crucible_clock_rearm_source(source);
+        crucible_clock_wander_timer_rearm(source);
+    }
+}
+
+static bool crucible_clock_read(
+    uint16_t source_kind, uint32_t instance, uint64_t raw_ns,
+    uint64_t opportunity,
+    bool tick_domain, uint64_t raw_architectural,
+    uint64_t *value_ns, uint64_t *value_architectural,
+    bool *read_error)
+{
+    CrucibleClockSource *source;
+    QemuCrucibleFaultEventReservation *reservation = NULL;
+    uint8_t before_hash[32];
+    uint64_t selected_opportunity;
+    size_t event_count;
+    uint16_t wrap_action = 0;
+
+    if (!value_ns || !value_architectural || !read_error) {
+        return false;
+    }
+    (void)opportunity;
+    *value_ns = raw_ns;
+    *value_architectural = raw_architectural;
+    *read_error = false;
+    if (!crucible_clock_mode()) {
+        return true;
+    }
+    if (crucible_clock_terminal) {
+        return false;
+    }
+    source = crucible_clock_source_by_kind(source_kind, instance);
+    if (!source || !crucible_clock_bindings_sealed) {
+        return false;
+    }
+    event_count = source->source_rule ? 1 : 0;
+    for (guint i = 0; source->rules && i < source->rules->len; i++) {
+        CrucibleClockRuleState *state = &g_array_index(
+            source->rules, CrucibleClockRuleState, i);
+
+        event_count += crucible_clock_transform_observed_at(
+            state->rule, QEMU_CRUCIBLE_MODEL_PHASE_CLOCK_READ);
+    }
+    if (event_count != 0) {
+        reservation = qemu_crucible_fault_event_reserve(event_count);
+        if (!reservation) {
+            qemu_crucible_fault_clock_event_terminal();
+            return false;
+        }
+    }
+    crucible_clock_source_digest(source, before_hash);
+    /*
+     * The dedicated virtual-time wander timer is the sole mutation and
+     * evidence path.  A read at or beyond a pending boundary means timer
+     * dispatch ordering was violated; silently catching up here would mutate
+     * an unbounded number of transitions without reserving or emitting their
+     * evidence.
+     */
+    for (guint i = 0; source->rules && i < source->rules->len; i++) {
+        CrucibleClockRuleState *state = &g_array_index(
+            source->rules, CrucibleClockRuleState, i);
+        uint32_t kind;
+
+        if (!crucible_clock_u32(state->rule,
+                                CRUCIBLE_NODE_FAULT_FIELD_P2, &kind)) {
+            crucible_clock_release_events(reservation);
+            return false;
+        }
+        if (kind == 6 && state->wander_next_ns != UINT64_MAX &&
+            raw_ns >= state->wander_next_ns) {
+            crucible_clock_release_events(reservation);
+            qemu_crucible_fault_clock_event_terminal();
+            return false;
+        }
+    }
+    if (source->read_sequence == UINT64_MAX) {
+        crucible_clock_release_events(reservation);
+        return false;
+    }
+    selected_opportunity = source->read_sequence + 1;
+    if (!crucible_clock_source_value(
+            source, raw_ns, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL),
+            selected_opportunity, true, value_ns, read_error)) {
+        crucible_clock_release_events(reservation);
+        return false;
+    }
+    if (tick_domain && !*read_error) {
+        __uint128_t transformed_ticks = (__uint128_t)*value_ns *
+            source->capability.frequency_numerator;
+
+        transformed_ticks /= (__uint128_t)NANOSECONDS_PER_SECOND *
+            source->capability.frequency_denominator;
+        if (transformed_ticks > UINT64_MAX) {
+            crucible_clock_release_events(reservation);
+            return false;
+        }
+        *value_architectural = transformed_ticks;
+        if (source->capability.width_bits < 64) {
+            uint64_t mask = (UINT64_C(1) <<
+                             source->capability.width_bits) - 1;
+
+            if (!(source->capability.flags &
+                  QEMU_CRUCIBLE_CLOCK_SOURCE_WRAPS) &&
+                (*value_architectural & ~mask) != 0) {
+                crucible_clock_release_events(reservation);
+                return false;
+            }
+            wrap_action = (*value_architectural & ~mask) != 0;
+            *value_architectural &= mask;
+        }
+    } else if (!tick_domain) {
+        *value_architectural = *value_ns;
+    }
+    source->read_sequence++;
+    if (!*read_error) {
+        source->last_value_ns = *value_ns;
+        source->has_last_value = true;
+    }
+    if (!crucible_clock_emit_read_events(
+            source, raw_ns, *value_ns,
+            raw_architectural, *value_architectural,
+            tick_domain ? source->capability.width_bits : 64,
+            wrap_action, *read_error,
+            qemu_crucible_fault_observed_icount(), selected_opportunity,
+            before_hash,
+            reservation)) {
+        crucible_clock_release_events(reservation);
+        qemu_crucible_fault_clock_event_terminal();
+        return false;
+    }
+    crucible_clock_release_events(reservation);
+    return true;
+}
+
+bool qemu_crucible_fault_clock_read_ns(
+    uint16_t source_kind, uint32_t instance, uint64_t raw_ns,
+    uint64_t opportunity, uint64_t *value_ns, bool *read_error)
+{
+    uint64_t architectural;
+
+    return crucible_clock_read(
+        source_kind, instance, raw_ns, opportunity, false, raw_ns,
+        value_ns, &architectural, read_error);
+}
+
+bool qemu_crucible_fault_clock_source_active(
+    uint16_t source_kind, uint32_t instance)
+{
+    CrucibleClockSource *source = crucible_clock_source_by_kind(
+        source_kind, instance);
+
+    return crucible_clock_mode() && source &&
+           crucible_clock_bindings_sealed &&
+           (crucible_clock_terminal ||
+           ((source->rules && source->rules->len != 0) ||
+            source->source_rule || source->additive_nanos != 0 ||
+            source->drift_numerator != source->drift_denominator ||
+            source->frozen || source->source_state != CRUCIBLE_CLOCK_HEALTHY ||
+            source->synchronizing));
+}
+
+bool qemu_crucible_fault_clock_source_rebase(
+    uint16_t source_kind, uint32_t instance, uint64_t raw_ns)
+{
+    CrucibleClockSource *source =
+        crucible_clock_source_by_kind(source_kind, instance);
+    uint64_t base;
+    bool read_error;
+
+    if (!qemu_crucible_fault_clock_source_active(source_kind, instance)) {
+        return true;
+    }
+    if (!source || source->transform_generation == UINT64_MAX ||
+        !crucible_clock_source_base(
+            source, raw_ns, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL),
+            &base, &read_error) || read_error) {
+        return false;
+    }
+    source->anchor_raw_ns = base;
+    source->anchor_value_ns = base;
+    source->has_last_value = false;
+    source->synchronizing = false;
+    source->synchronization_remaining_ns = 0;
+    source->transform_generation++;
+    crucible_clock_rearm_source(source);
+    return true;
+}
+
+bool qemu_crucible_fault_clock_source_discontinuity(
+    uint16_t source_kind, uint32_t instance,
+    uint64_t old_raw_ns, uint64_t new_raw_ns)
+{
+    CrucibleClockSource *source =
+        crucible_clock_source_by_kind(source_kind, instance);
+    uint64_t old_value;
+    bool read_error;
+
+    if (!qemu_crucible_fault_clock_source_active(source_kind, instance)) {
+        return true;
+    }
+    if (!source || source->transform_generation == UINT64_MAX ||
+        !crucible_clock_source_value(
+            source, old_raw_ns, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL),
+            0, false, &old_value, &read_error) || read_error) {
+        return false;
+    }
+    source->anchor_raw_ns = new_raw_ns;
+    source->anchor_value_ns = old_value;
+    source->has_last_value = false;
+    source->synchronizing = false;
+    source->synchronization_remaining_ns = 0;
+    source->transform_generation++;
+    crucible_clock_rearm_source(source);
+    return true;
+}
+
+bool qemu_crucible_fault_clock_project_ns(
+    uint16_t source_kind, uint32_t instance, uint64_t raw_ns,
+    uint64_t *value_ns, bool *read_error)
+{
+    CrucibleClockSource *source;
+
+    if (!value_ns || !read_error) {
+        return false;
+    }
+    *value_ns = raw_ns;
+    *read_error = false;
+    if (crucible_clock_terminal) {
+        return false;
+    }
+    if (!qemu_crucible_fault_clock_source_active(source_kind, instance)) {
+        return true;
+    }
+    source = crucible_clock_source_by_kind(source_kind, instance);
+    return crucible_clock_source_value(
+        source, raw_ns, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL),
+        0, false, value_ns, read_error);
+}
+
+static bool crucible_clock_transform_ticks(
+    uint16_t source_kind, uint32_t instance, uint64_t raw_ticks,
+    uint64_t opportunity,
+    bool is_read, uint64_t *value_ticks, bool *read_error)
+{
+    CrucibleClockSource *source;
+    __uint128_t raw_ns, transformed_ticks;
+    uint64_t value_ns;
+
+    if (!value_ticks || !read_error) {
+        return false;
+    }
+    *value_ticks = raw_ticks;
+    *read_error = false;
+    if (!qemu_crucible_fault_clock_source_active(source_kind, instance)) {
+        return true;
+    }
+    source = crucible_clock_source_by_kind(source_kind, instance);
+    raw_ns = (__uint128_t)raw_ticks * NANOSECONDS_PER_SECOND *
+             source->capability.frequency_denominator;
+    raw_ns /= source->capability.frequency_numerator;
+    if (raw_ns > UINT64_MAX) {
+        return false;
+    }
+    if (is_read) {
+        return crucible_clock_read(
+            source_kind, instance, (uint64_t)raw_ns, opportunity,
+            true, raw_ticks,
+            &value_ns, value_ticks, read_error);
+    }
+    if (!crucible_clock_source_value(
+            source, raw_ns, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL),
+            opportunity, false, &value_ns, read_error) || *read_error) {
+        return raw_ns <= UINT64_MAX && *read_error;
+    }
+    transformed_ticks = (__uint128_t)value_ns *
+                        source->capability.frequency_numerator;
+    transformed_ticks /= (__uint128_t)NANOSECONDS_PER_SECOND *
+                         source->capability.frequency_denominator;
+    if (transformed_ticks > UINT64_MAX ||
+        (source->capability.width_bits < 64 &&
+         !(source->capability.flags & QEMU_CRUCIBLE_CLOCK_SOURCE_WRAPS) &&
+         transformed_ticks >=
+             ((__uint128_t)1 << source->capability.width_bits))) {
+        return false;
+    }
+    *value_ticks = transformed_ticks;
+    if (source->capability.width_bits < 64) {
+        *value_ticks &= (UINT64_C(1) << source->capability.width_bits) - 1;
+    }
+    return true;
+}
+
+bool qemu_crucible_fault_clock_read_ticks(
+    uint16_t source_kind, uint32_t instance, uint64_t raw_ticks,
+    uint64_t opportunity,
+    uint64_t *value_ticks, bool *read_error)
+{
+    return crucible_clock_transform_ticks(
+        source_kind, instance, raw_ticks, opportunity, true,
+        value_ticks, read_error);
+}
+
+bool qemu_crucible_fault_clock_project_ticks(
+    uint16_t source_kind, uint32_t instance, uint64_t raw_ticks,
+    uint64_t *value_ticks,
+    bool *read_error)
+{
+    return crucible_clock_transform_ticks(
+        source_kind, instance, raw_ticks, 0, false,
+        value_ticks, read_error);
+}
+
+static bool crucible_clock_sync_boundary(
+    CrucibleClockSource *source, int64_t *scheduler_ns, bool *has_boundary)
+{
+    uint64_t magnitude, required, elapsed, raw_ns;
+    __uint128_t scaled;
+
+    *has_boundary = false;
+    if (!source->synchronizing) {
+        return true;
+    }
+    if (source->synchronization_numerator == 0 ||
+        source->synchronization_denominator == 0) {
+        return false;
+    }
+    magnitude = source->synchronization_remaining_ns < 0 ?
+        (uint64_t)(-(source->synchronization_remaining_ns + 1)) + 1 :
+        (uint64_t)source->synchronization_remaining_ns;
+    if (magnitude <= source->synchronization_threshold_ns) {
+        raw_ns = source->synchronization_anchor_raw_ns;
+    } else {
+        required = magnitude - source->synchronization_threshold_ns;
+        scaled = (__uint128_t)required *
+            source->synchronization_denominator;
+        elapsed = scaled / source->synchronization_numerator;
+        if (scaled % source->synchronization_numerator != 0) {
+            elapsed++;
+        }
+        if (elapsed > UINT64_MAX -
+                source->synchronization_anchor_raw_ns) {
+            return false;
+        }
+        raw_ns = source->synchronization_anchor_raw_ns + elapsed;
+    }
+    if (!crucible_clock_scheduler_for_raw(source, raw_ns, scheduler_ns)) {
+        return false;
+    }
+    *has_boundary = true;
+    return true;
+}
+
+static bool crucible_clock_first_crossing(
+    CrucibleClockSource *source, uint64_t lower, uint64_t upper,
+    uint64_t target, uint64_t *crossing, bool *found)
+{
+    uint64_t raw_ns, projected;
+    bool read_error;
+
+    *found = false;
+    if (upper < lower ||
+        !crucible_clock_source_raw_at(source, upper, &raw_ns) ||
+        !crucible_clock_source_value(
+            source, raw_ns, upper, 0, false, &projected, &read_error) ||
+        read_error) {
+        return false;
+    }
+    if (projected < target) {
+        return true;
+    }
+    while (lower + 1 < upper) {
+        uint64_t middle = lower + (upper - lower) / 2;
+
+        if (!crucible_clock_source_raw_at(source, middle, &raw_ns) ||
+            !crucible_clock_source_value(
+                source, raw_ns, middle, 0, false,
+                &projected, &read_error) || read_error) {
+            return false;
+        }
+        if (projected >= target) {
+            upper = middle;
+        } else {
+            lower = middle;
+        }
+    }
+    *crossing = upper;
+    *found = true;
+    return true;
+}
+
+bool qemu_crucible_fault_clock_deadline_ns(
+    uint16_t source_kind, uint32_t instance, uint64_t guest_deadline_ns,
+    uint16_t timer_role, uint32_t timer_index, uint64_t period_ns,
+    uint64_t *timer_arm_sequence,
+    int64_t *scheduler_deadline_ns,
+    uint32_t *overdue_action, uint64_t *transform_generation,
+    uint64_t *effective_guest_deadline_ns)
+{
+    CrucibleClockSource *source;
+    uint64_t guest_now, lower, upper, upper_limit, target, step, raw_ns;
+    int64_t sync_scheduler_ns;
+    int64_t signed_now;
+    uint64_t now;
+    bool read_error;
+    bool has_sync_boundary;
+
+    if (!timer_arm_sequence || !scheduler_deadline_ns || !overdue_action ||
+        !transform_generation || !effective_guest_deadline_ns) {
+        return false;
+    }
+    *overdue_action = QEMU_CRUCIBLE_CLOCK_TIMER_UNREACHABLE;
+    source = crucible_clock_source_by_kind(source_kind, instance);
+    if (!crucible_clock_mode() || crucible_clock_terminal || !source ||
+        !crucible_clock_bindings_sealed ||
+        timer_role < QEMU_CRUCIBLE_CLOCK_TIMER_PRIMARY ||
+        timer_role > QEMU_CRUCIBLE_CLOCK_TIMER_COALESCED ||
+        source->source_state == CRUCIBLE_CLOCK_FAILED_READ_ERROR) {
+        return false;
+    }
+    signed_now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (signed_now < 0) {
+        return false;
+    }
+    now = signed_now;
+    if (!crucible_clock_source_raw_at(source, now, &raw_ns) ||
+        !crucible_clock_source_value(
+            source, raw_ns, now, 0, false,
+            &guest_now, &read_error) || read_error) {
+        return false;
+    }
+    if (!qemu_crucible_fault_clock_timer_arm(timer_arm_sequence)) {
+        return false;
+    }
+    target = guest_deadline_ns;
+    if (
+        !crucible_clock_apply_timer_jitter(
+            source, QEMU_CRUCIBLE_MODEL_PHASE_ARM,
+            timer_role, timer_index, *timer_arm_sequence, &target) ||
+        !crucible_clock_apply_timer_jitter(
+            source, QEMU_CRUCIBLE_MODEL_PHASE_FIRE,
+            timer_role, timer_index, *timer_arm_sequence, &target)) {
+        return false;
+    }
+    *overdue_action = QEMU_CRUCIBLE_CLOCK_TIMER_FIRE_AT_BOUNDARY;
+    if (target <= guest_now) {
+        if (source->overdue_policy == 2) {
+            *overdue_action = QEMU_CRUCIBLE_CLOCK_TIMER_DROP;
+            return false;
+        }
+        if (source->overdue_policy == 3) {
+            uint64_t periods;
+
+            *overdue_action =
+                QEMU_CRUCIBLE_CLOCK_TIMER_RESCHEDULE_PERIODIC;
+            if (period_ns == 0) {
+                *overdue_action = QEMU_CRUCIBLE_CLOCK_TIMER_UNREACHABLE;
+                return false;
+            }
+            periods = (guest_now - target) / period_ns + 1;
+            if (periods > (UINT64_MAX - target) / period_ns) {
+                *overdue_action = QEMU_CRUCIBLE_CLOCK_TIMER_UNREACHABLE;
+                return false;
+            }
+            target += periods * period_ns;
+        } else {
+            upper = now;
+            goto found;
+        }
+    }
+    if (source->frozen ||
+        source->source_state == CRUCIBLE_CLOCK_FAILED_STOP) {
+        return false;
+    }
+    lower = now;
+    upper = now;
+    upper_limit = INT64_MAX;
+    for (guint i = 0; source->rules && i < source->rules->len; i++) {
+        CrucibleClockRuleState *state = &g_array_index(
+            source->rules, CrucibleClockRuleState, i);
+        int64_t wander_scheduler_ns;
+        uint32_t kind;
+
+        if (!crucible_clock_u32(state->rule,
+                                CRUCIBLE_NODE_FAULT_FIELD_P2, &kind)) {
+            return false;
+        }
+        if (kind == 6 && state->wander_next_ns != UINT64_MAX &&
+            crucible_clock_scheduler_for_raw(
+                source, state->wander_next_ns, &wander_scheduler_ns)) {
+            upper_limit = MIN(upper_limit,
+                              (uint64_t)wander_scheduler_ns);
+        }
+    }
+    if (!crucible_clock_sync_boundary(
+            source, &sync_scheduler_ns, &has_sync_boundary)) {
+        qemu_crucible_fault_clock_event_terminal();
+        return false;
+    }
+    if (has_sync_boundary &&
+        sync_scheduler_ns > (int64_t)now &&
+        (uint64_t)sync_scheduler_ns < upper_limit) {
+        bool found_crossing;
+
+        if (!crucible_clock_first_crossing(
+                source, now, (uint64_t)sync_scheduler_ns - 1,
+                target, &upper, &found_crossing)) {
+            return false;
+        }
+        if (found_crossing) {
+            goto found;
+        }
+        if (!crucible_clock_first_crossing(
+                source, (uint64_t)sync_scheduler_ns - 1,
+                sync_scheduler_ns, target, &upper, &found_crossing)) {
+            return false;
+        }
+        if (found_crossing) {
+            goto found;
+        }
+        lower = sync_scheduler_ns;
+        upper = sync_scheduler_ns;
+    }
+    step = 1;
+    for (;;) {
+        uint64_t projected;
+        uint64_t remaining;
+
+        if (upper >= upper_limit) {
+            return false;
+        }
+        remaining = upper_limit - upper;
+
+        upper += MIN(step, remaining);
+        if (!crucible_clock_source_raw_at(source, upper, &raw_ns) ||
+            !crucible_clock_source_value(
+                source, raw_ns, upper, 0, false,
+                &projected, &read_error) ||
+            read_error) {
+            return false;
+        }
+        if (projected >= target) {
+            break;
+        }
+        if (upper == upper_limit) {
+            return false;
+        }
+        lower = upper;
+        step = MIN(step, (uint64_t)INT64_MAX / 2);
+        step *= 2;
+    }
+    while (lower + 1 < upper) {
+        uint64_t middle = lower + (upper - lower) / 2;
+        uint64_t projected;
+
+        if (!crucible_clock_source_raw_at(source, middle, &raw_ns) ||
+            !crucible_clock_source_value(
+                source, raw_ns, middle, 0, false,
+                &projected, &read_error) ||
+            read_error) {
+            return false;
+        }
+        if (projected >= target) {
+            upper = middle;
+        } else {
+            lower = middle;
+        }
+    }
+found:
+    *scheduler_deadline_ns = upper;
+    *transform_generation = source->transform_generation;
+    *effective_guest_deadline_ns = target;
+    return true;
+}
+
+bool qemu_crucible_fault_clock_timer_arm(uint64_t *timer_arm_sequence)
+{
+    if (!timer_arm_sequence) {
+        return false;
+    }
+    if (crucible_clock_rearming_timers) {
+        if (*timer_arm_sequence != 0) {
+            return true;
+        }
+        if (crucible_clock_restoring) {
+            return false;
+        }
+        *timer_arm_sequence = 1;
+        return true;
+    }
+    if (*timer_arm_sequence == UINT64_MAX) {
+        qemu_crucible_fault_clock_event_terminal();
+        return false;
+    }
+    (*timer_arm_sequence)++;
+    return true;
+}
+
+static bool crucible_clock_emit_timer_transition(
+    CrucibleClockSource *source, QemuCrucibleFaultRule *rule,
+    const uint8_t before_hash[32], const uint8_t after_hash[32],
+    uint16_t opportunity_phase, uint64_t timer_arm_sequence,
+    QemuCrucibleFaultEventReservation *reservation)
+{
+    uint8_t opportunity_hash[32], identity[80] = { 0 };
+    uint8_t evidence[CRUCIBLE_CLOCK_EVIDENCE_BYTES] = { 0 };
+    g_autoptr(GArray) distribution = NULL;
+    uint64_t timer_opportunity;
+    uint64_t opportunity;
+    uint64_t maximum;
+    int64_t jitter = 0;
+    uint32_t kind = 0;
+
+    timer_opportunity = crucible_clock_timer_opportunity(
+        source, timer_arm_sequence, opportunity_phase,
+        source->timer_role, source->timer_index);
+    if (qemu_crucible_fault_rule_command_kind(rule) ==
+        CRUCIBLE_FAULT_COMMAND_CLOCK_TRANSFORM) {
+        if (!crucible_clock_u32(
+                rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &kind)) {
+            return false;
+        }
+    }
+    if (qemu_crucible_fault_rule_command_kind(rule) ==
+            CRUCIBLE_FAULT_COMMAND_CLOCK_TRANSFORM && kind == 5) {
+        if (!crucible_clock_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P5,
+                                &maximum) ||
+            !crucible_clock_json_i64_array(
+                qemu_crucible_fault_rule_json(
+                    rule, CRUCIBLE_NODE_FAULT_FIELD_P6),
+                &distribution)) {
+            return false;
+        }
+        jitter = g_array_index(
+            distribution, int64_t,
+            crucible_clock_keyed_index(
+                rule, source, timer_opportunity, distribution->len));
+        if ((jitter < 0 && (uint64_t)(-(jitter + 1)) + 1 > maximum) ||
+            (jitter >= 0 && (uint64_t)jitter > maximum)) {
+            return false;
+        }
+    }
+    if (!qemu_crucible_fault_rule_count_applied(rule, &opportunity)) {
+        return false;
+    }
+    memcpy(identity, "CRUCCTA1", 8);
+    memcpy(identity + 8, qemu_crucible_fault_rule_binding_hash(rule), 32);
+    memcpy(identity + 40, source->binding.id, 32);
+    stq_le_p(identity + 72, opportunity);
+    crucible_clock_sha256(identity, sizeof(identity), opportunity_hash);
+    memcpy(evidence, "CRUCCTE1", 8);
+    stw_le_p(evidence + 8, 1);
+    stw_le_p(evidence + 10, source->capability.source_kind);
+    stw_le_p(evidence + 12, source->timer_role);
+    stl_le_p(evidence + 16, source->timer_index);
+    stl_le_p(evidence + 20, source->timer_action);
+    stq_le_p(evidence + 24, source->timer_transition_sequence);
+    stq_le_p(evidence + 32, source->timer_old_guest_deadline_ns);
+    stq_le_p(evidence + 40, source->timer_old_scheduler_deadline_ns);
+    stq_le_p(evidence + 48, source->timer_old_transform_generation);
+    stq_le_p(evidence + 56, source->timer_new_guest_deadline_ns);
+    stq_le_p(evidence + 64, source->timer_new_scheduler_deadline_ns);
+    stq_le_p(evidence + 72, source->timer_new_transform_generation);
+    stq_le_p(evidence + 80, source->transform_generation);
+    memcpy(evidence + 88, source->binding.id, 32);
+    memcpy(evidence + 120,
+           qemu_crucible_fault_rule_binding_hash(rule), 32);
+    memcpy(evidence + 152, before_hash, 32);
+    memcpy(evidence + 184, after_hash, 32);
+    stq_le_p(evidence + 216, opportunity);
+    stw_le_p(evidence + 224, opportunity_phase);
+    stq_le_p(evidence + 232, (uint64_t)jitter);
+    stq_le_p(evidence + 240, timer_opportunity);
+    stq_le_p(evidence + 248, timer_arm_sequence);
+    qemu_crucible_fault_event_reservation_consume(reservation);
+    qemu_crucible_fault_rule_event(
+        rule, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+        qemu_crucible_fault_observed_icount(), opportunity_hash,
+        before_hash, after_hash, evidence, sizeof(evidence));
+    return true;
+}
+
+static bool crucible_clock_timer_transition_phase(
+    uint16_t source_kind, uint32_t instance, uint16_t timer_role,
+    uint32_t timer_index, uint64_t timer_arm_sequence,
+    uint64_t old_guest_deadline_ns,
+    uint64_t old_scheduler_deadline_ns, uint64_t old_transform_generation,
+    uint64_t new_guest_deadline_ns, uint64_t new_scheduler_deadline_ns,
+    uint64_t new_transform_generation, uint32_t action,
+    uint16_t opportunity_phase)
+{
+    CrucibleClockSource *source = crucible_clock_source_by_kind(
+        source_kind, instance);
+    QemuCrucibleFaultEventReservation *reservation;
+    uint8_t before_hash[32], after_hash[32];
+    size_t event_count;
+
+    if (!source || !qemu_crucible_fault_clock_source_active(
+            source_kind, instance) || timer_role < 1 || timer_role > 5 ||
+        timer_arm_sequence == 0 ||
+        action < QEMU_CRUCIBLE_CLOCK_TIMER_FIRE_AT_BOUNDARY ||
+        action > QEMU_CRUCIBLE_CLOCK_TIMER_UNREACHABLE ||
+        source->timer_transition_sequence == UINT64_MAX) {
+        return false;
+    }
+    if (crucible_clock_restoring) {
+        return true;
+    }
+    event_count = source->source_rule ? 1 : 0;
+    for (guint i = 0; i < source->rules->len; i++) {
+        CrucibleClockRuleState *state = &g_array_index(
+            source->rules, CrucibleClockRuleState, i);
+
+        event_count += crucible_clock_transform_observed_at(
+            state->rule, opportunity_phase);
+    }
+    reservation = event_count == 0 ? NULL :
+        qemu_crucible_fault_event_reserve(event_count);
+    if (event_count != 0 && !reservation) {
+        return false;
+    }
+    crucible_clock_source_digest(source, before_hash);
+    source->timer_transition_sequence++;
+    source->timer_old_guest_deadline_ns = old_guest_deadline_ns;
+    source->timer_old_scheduler_deadline_ns = old_scheduler_deadline_ns;
+    source->timer_old_transform_generation = old_transform_generation;
+    source->timer_new_guest_deadline_ns = new_guest_deadline_ns;
+    source->timer_new_scheduler_deadline_ns = new_scheduler_deadline_ns;
+    source->timer_new_transform_generation = new_transform_generation;
+    source->timer_role = timer_role;
+    source->timer_index = timer_index;
+    source->timer_action = action;
+    crucible_clock_source_digest(source, after_hash);
+    for (guint i = 0; i < source->rules->len; i++) {
+        CrucibleClockRuleState *state = &g_array_index(
+            source->rules, CrucibleClockRuleState, i);
+
+        if (!crucible_clock_transform_observed_at(
+                state->rule, opportunity_phase)) {
+            continue;
+        }
+        if (!crucible_clock_emit_timer_transition(
+                source, state->rule, before_hash, after_hash,
+                opportunity_phase, timer_arm_sequence,
+                reservation)) {
+            crucible_clock_release_events(reservation);
+            return false;
+        }
+    }
+    if (source->source_rule && !crucible_clock_emit_timer_transition(
+            source, source->source_rule, before_hash, after_hash,
+            opportunity_phase, timer_arm_sequence,
+            reservation)) {
+        crucible_clock_release_events(reservation);
+        return false;
+    }
+    crucible_clock_release_events(reservation);
+    return true;
+}
+
+bool qemu_crucible_fault_clock_timer_transition(
+    uint16_t source_kind, uint32_t instance, uint16_t timer_role,
+    uint32_t timer_index, uint64_t timer_arm_sequence,
+    uint64_t old_guest_deadline_ns,
+    uint64_t old_scheduler_deadline_ns, uint64_t old_transform_generation,
+    uint64_t new_guest_deadline_ns, uint64_t new_scheduler_deadline_ns,
+    uint64_t new_transform_generation, uint32_t action)
+{
+    return crucible_clock_timer_transition_phase(
+        source_kind, instance, timer_role, timer_index, timer_arm_sequence,
+        old_guest_deadline_ns, old_scheduler_deadline_ns,
+        old_transform_generation, new_guest_deadline_ns,
+        new_scheduler_deadline_ns, new_transform_generation, action,
+        QEMU_CRUCIBLE_MODEL_PHASE_ARM);
+}
+
+bool qemu_crucible_fault_clock_timer_fire(
+    uint16_t source_kind, uint32_t instance, uint16_t timer_role,
+    uint32_t timer_index, uint64_t timer_arm_sequence,
+    uint64_t guest_deadline_ns,
+    uint64_t scheduler_deadline_ns, uint64_t transform_generation)
+{
+    if (transform_generation == 0 ||
+        !qemu_crucible_fault_clock_source_active(source_kind, instance)) {
+        return true;
+    }
+    return crucible_clock_timer_transition_phase(
+        source_kind, instance, timer_role, timer_index, timer_arm_sequence,
+        guest_deadline_ns, scheduler_deadline_ns, transform_generation,
+        guest_deadline_ns, scheduler_deadline_ns, transform_generation,
+        QEMU_CRUCIBLE_CLOCK_TIMER_FIRE_AT_BOUNDARY,
+        QEMU_CRUCIBLE_MODEL_PHASE_FIRE);
+}
+
+typedef struct CrucibleClockValidation {
+    const CrucibleClockSource *source;
+    const QemuCrucibleFaultRule *candidate;
+    uint64_t numerator;
+    uint64_t denominator;
+    int64_t additive;
+    uint64_t frozen_value;
+    size_t freeze_count;
+    size_t rule_count;
+    bool valid;
+} CrucibleClockValidation;
+
+static bool crucible_clock_rule_payload_valid(
+    const QemuCrucibleFaultRule *rule)
+{
+    uint32_t kind, monotonicity, overdue;
+    int64_t signed_value;
+    uint64_t numerator, denominator, unsigned_value;
+
+    if (!crucible_clock_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &kind) ||
+        kind < 1 || kind > 6 ||
+        !crucible_clock_i64(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                            &signed_value) ||
+        !crucible_clock_ratio(rule, CRUCIBLE_NODE_FAULT_FIELD_P4,
+                              &numerator, &denominator) ||
+        !crucible_clock_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P5,
+                            &unsigned_value) ||
+        !crucible_clock_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P7,
+                            &monotonicity) || monotonicity < 1 ||
+        monotonicity > 3 ||
+        !crucible_clock_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P8, &overdue) ||
+        overdue < 1 || overdue > 3) {
+        return false;
+    }
+    if ((kind == 1 || kind == 3) && signed_value == 0) {
+        return false;
+    }
+    if (kind != 2 && (numerator != 1 || denominator != 1)) {
+        return false;
+    }
+    if (kind == 2 && numerator == denominator) {
+        return false;
+    }
+    if (kind == 2 && (signed_value != 0 || unsigned_value != 0)) {
+        return false;
+    }
+    if (kind == 4) {
+        QString *release = qobject_to(
+            QString, qemu_crucible_fault_rule_json(
+                rule, CRUCIBLE_NODE_FAULT_FIELD_P6));
+        const char *name = release ? qstring_get_str(release) : NULL;
+
+        return signed_value == 0 &&
+               (name && (strcmp(name, "resume_from_frozen") == 0 ||
+                         strcmp(name, "catch_up_jump") == 0));
+    }
+    if (kind == 5) {
+        g_autoptr(GArray) distribution = NULL;
+
+        if (signed_value != 0 || unsigned_value == 0 ||
+            !crucible_clock_json_i64_array(
+                qemu_crucible_fault_rule_json(
+                    rule, CRUCIBLE_NODE_FAULT_FIELD_P6),
+                &distribution)) {
+            return false;
+        }
+        for (guint i = 0; i < distribution->len; i++) {
+            int64_t value = g_array_index(distribution, int64_t, i);
+            uint64_t magnitude = value < 0 ?
+                (uint64_t)(-(value + 1)) + 1 : (uint64_t)value;
+
+            if (magnitude > unsigned_value) {
+                return false;
+            }
+        }
+        return true;
+    }
+    if (kind == 6) {
+        g_autoptr(GArray) increments = NULL;
+        uint64_t step, maximum_offset, maximum_rate;
+
+        if (signed_value != 0 || unsigned_value != 0 ||
+            !crucible_clock_wander_policy(
+                rule, &step, &maximum_offset, &maximum_rate,
+                &increments) || maximum_offset > INT64_MAX ||
+            maximum_rate > INT64_MAX) {
+            return false;
+        }
+        for (guint i = 0; i < increments->len; i++) {
+            int64_t value = g_array_index(increments, int64_t, i);
+            uint64_t magnitude = value < 0 ?
+                (uint64_t)(-(value + 1)) + 1 : (uint64_t)value;
+
+            if (magnitude > maximum_rate) {
+                return false;
+            }
+        }
+    }
+    return kind >= 4 || unsigned_value == 0;
+}
+
+static bool crucible_clock_wander_step_representable(
+    const CrucibleClockSource *source, const QemuCrucibleFaultRule *rule)
+{
+    g_autoptr(GArray) increments = NULL;
+    uint64_t step, maximum_offset, maximum_rate;
+
+    return crucible_clock_wander_policy(
+               rule, &step, &maximum_offset, &maximum_rate, &increments) &&
+           (__uint128_t)step * source->capability.frequency_numerator >=
+               (__uint128_t)NANOSECONDS_PER_SECOND *
+               source->capability.frequency_denominator;
+}
+
+static void crucible_clock_validation_visit(
+    const QemuCrucibleFaultRule *rule, void *opaque)
+{
+    CrucibleClockValidation *validation = opaque;
+    uint32_t kind;
+    int64_t signed_value;
+    uint64_t numerator, denominator, frozen_value;
+
+    if (!validation->valid ||
+        !crucible_clock_rule_selects(rule, validation->source) ||
+        (validation->candidate && rule != validation->candidate &&
+         memcmp(qemu_crucible_fault_rule_binding_hash(rule),
+                qemu_crucible_fault_rule_binding_hash(
+                    validation->candidate), 32) == 0)) {
+        return;
+    }
+    validation->rule_count++;
+    if (validation->rule_count > CRUCIBLE_CLOCK_MAX_RULES ||
+        !crucible_clock_rule_payload_valid(rule) ||
+        !crucible_clock_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &kind) ||
+        !crucible_clock_i64(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                            &signed_value) ||
+        !crucible_clock_ratio(rule, CRUCIBLE_NODE_FAULT_FIELD_P4,
+                              &numerator, &denominator) ||
+        !crucible_clock_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P5,
+                            &frozen_value)) {
+        validation->valid = false;
+        return;
+    }
+    if ((kind == 1 || kind == 3) && !crucible_clock_add_i64(
+            &validation->additive, signed_value)) {
+        validation->valid = false;
+    } else if (kind == 2 && !crucible_clock_multiply_ratio(
+                   &validation->numerator, &validation->denominator,
+                   numerator, denominator)) {
+        validation->valid = false;
+    } else if (kind == 4 && validation->freeze_count++ != 0 &&
+               validation->frozen_value != frozen_value) {
+        validation->valid = false;
+    } else if (kind == 4) {
+        validation->frozen_value = frozen_value;
+    } else if (kind == 6 && !crucible_clock_wander_step_representable(
+                   validation->source, rule)) {
+        validation->valid = false;
+    }
+}
+
+static bool crucible_clock_source_rule_valid(
+    const QemuCrucibleFaultRule *rule)
+{
+    const uint8_t *hashes;
+    uint32_t length;
+    QDict *transition = qobject_to(
+        QDict, qemu_crucible_fault_rule_json(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P2));
+    QDict *synchronization = qobject_to(
+        QDict, qemu_crucible_fault_rule_json(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P3));
+    const char *kind = transition ?
+        qdict_get_try_str(transition, "kind") : NULL;
+    const char *sync_kind = synchronization ?
+        qdict_get_try_str(synchronization, "kind") : NULL;
+
+    if (!transition || !synchronization || !kind || !sync_kind ||
+        !crucible_clock_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P1,
+            CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH_SET, &hashes, &length) ||
+        length == 0 || length % 32 != 0 ||
+        length / 32 > CRUCIBLE_CLOCK_MAX_SOURCES) {
+        return false;
+    }
+    for (uint32_t offset = 0; offset < length; offset += 32) {
+        if (!crucible_clock_source_by_id(hashes + offset)) {
+            return false;
+        }
+    }
+    if (strcmp(kind, "healthy") == 0 || strcmp(kind, "degraded") == 0) {
+        if (qdict_size(transition) != 1) {
+            return false;
+        }
+    } else if (strcmp(kind, "failed") == 0) {
+        QDict *parameters = qdict_get_qdict(transition, "parameters");
+        const char *behavior = parameters ?
+            qdict_get_try_str(parameters, "behavior") : NULL;
+
+        if (qdict_size(transition) != 2 || !parameters ||
+            qdict_size(parameters) != 1 || !behavior ||
+            (strcmp(behavior, "stop") != 0 &&
+                          strcmp(behavior, "read_error") != 0)) {
+            return false;
+        }
+        if (strcmp(behavior, "read_error") == 0) {
+            for (uint32_t offset = 0; offset < length; offset += 32) {
+                CrucibleClockSource *source =
+                    crucible_clock_source_by_id(hashes + offset);
+
+                if (!source || !(source->capability.flags &
+                        QEMU_CRUCIBLE_CLOCK_SOURCE_READ_ERROR)) {
+                    return false;
+                }
+            }
+        }
+    } else if (strcmp(kind, "fallback") == 0) {
+        QDict *parameters = qdict_get_qdict(transition, "parameters");
+        const char *fallback = parameters ?
+            qdict_get_try_str(parameters, "source") : NULL;
+        bool found = false;
+
+        for (guint i = 0; fallback && crucible_clock_sources &&
+             i < crucible_clock_sources->len; i++) {
+            const CrucibleClockSource *source = &g_array_index(
+                crucible_clock_sources, CrucibleClockSource, i);
+
+            found |= strcmp(source->capability.id, fallback) == 0;
+        }
+        if (qdict_size(transition) != 2 || !parameters ||
+            qdict_size(parameters) != 1 || !found) {
+            return false;
+        }
+    } else {
+        return false;
+    }
+    if (strcmp(sync_kind, "step") == 0) {
+        return qdict_size(synchronization) == 1;
+    }
+    if (strcmp(sync_kind, "slew") == 0) {
+        QDict *parameters = qdict_get_qdict(synchronization, "parameters");
+        QDict *ratio = parameters ?
+            qdict_get_qdict(parameters, "rate") : NULL;
+        QNum *numerator = ratio ?
+            qobject_to(QNum, qdict_get(ratio, "numerator")) : NULL;
+        QNum *denominator = ratio ?
+            qobject_to(QNum, qdict_get(ratio, "denominator")) : NULL;
+        QNum *threshold = parameters ? qobject_to(
+            QNum, qdict_get(parameters, "threshold_nanos")) : NULL;
+        uint64_t numerator_value, denominator_value, threshold_value;
+
+        return qdict_size(synchronization) == 2 && parameters &&
+               qdict_size(parameters) == 2 && ratio &&
+               qdict_size(ratio) == 2 && numerator && denominator &&
+               threshold && qnum_get_try_uint(numerator, &numerator_value) &&
+               numerator_value != 0 &&
+               qnum_get_try_uint(denominator, &denominator_value) &&
+               denominator_value != 0 &&
+               qnum_get_try_uint(threshold, &threshold_value) &&
+               threshold_value != 0;
+    }
+    return false;
+}
+
+static const QemuCrucibleFaultRule *crucible_clock_effective_source_rule(
+    const CrucibleClockSource *source,
+    const QemuCrucibleFaultRule *candidate)
+{
+    bool replaces_live = source->source_rule &&
+        memcmp(qemu_crucible_fault_rule_binding_hash(source->source_rule),
+               qemu_crucible_fault_rule_binding_hash(candidate), 32) == 0;
+    bool remove = qemu_crucible_fault_rule_operation(candidate) ==
+        CRUCIBLE_NODE_FAULT_OPERATION_REMOVE;
+    bool candidate_selects = !remove && crucible_clock_hash_set_contains(
+        candidate, CRUCIBLE_NODE_FAULT_FIELD_P1, source->binding.id);
+
+    return candidate_selects ? candidate :
+        (replaces_live ? NULL : source->source_rule);
+}
+
+size_t qemu_crucible_fault_clock_event_budget(
+    const QemuCrucibleFaultRule *rule)
+{
+    size_t budget = 0;
+
+    if (!rule || qemu_crucible_fault_rule_command_kind(rule) !=
+            CRUCIBLE_FAULT_COMMAND_CLOCK_SOURCE_STATE ||
+        qemu_crucible_fault_rule_operation(rule) ==
+            CRUCIBLE_NODE_FAULT_OPERATION_APPLY ||
+        !crucible_clock_sources) {
+        return 0;
+    }
+    for (guint i = 0; i < crucible_clock_sources->len; i++) {
+        const CrucibleClockSource *source = &g_array_index(
+            crucible_clock_sources, CrucibleClockSource, i);
+        const QemuCrucibleFaultRule *effective =
+            crucible_clock_effective_source_rule(source, rule);
+
+        budget += !crucible_clock_rule_identity_equal(
+            source->source_rule, effective);
+    }
+    return budget;
+}
+
+static CrucibleClockSource *crucible_clock_fallback_target(
+    const QemuCrucibleFaultRule *rule)
+{
+    QDict *transition;
+    QDict *parameters;
+    const char *kind;
+    const char *name;
+
+    if (!rule) {
+        return NULL;
+    }
+    transition = qobject_to(QDict, qemu_crucible_fault_rule_json(
+        rule, CRUCIBLE_NODE_FAULT_FIELD_P2));
+    kind = transition ? qdict_get_try_str(transition, "kind") : NULL;
+    if (!kind || strcmp(kind, "fallback") != 0) {
+        return NULL;
+    }
+    parameters = qdict_get_qdict(transition, "parameters");
+    name = parameters ? qdict_get_try_str(parameters, "source") : NULL;
+    for (guint i = 0; name && i < crucible_clock_sources->len; i++) {
+        CrucibleClockSource *source = &g_array_index(
+            crucible_clock_sources, CrucibleClockSource, i);
+
+        if (strcmp(source->capability.id, name) == 0) {
+            return source;
+        }
+    }
+    return NULL;
+}
+
+static bool crucible_clock_source_candidate_valid(
+    const QemuCrucibleFaultRule *candidate)
+{
+    for (guint i = 0; i < crucible_clock_sources->len; i++) {
+        CrucibleClockSource *source = &g_array_index(
+            crucible_clock_sources, CrucibleClockSource, i);
+
+        if (crucible_clock_hash_set_contains(
+                candidate, CRUCIBLE_NODE_FAULT_FIELD_P1,
+                source->binding.id) && source->source_rule &&
+            memcmp(qemu_crucible_fault_rule_binding_hash(source->source_rule),
+                   qemu_crucible_fault_rule_binding_hash(candidate), 32) != 0) {
+            return false;
+        }
+        CrucibleClockSource *cursor = source;
+
+        for (guint depth = 0; depth < crucible_clock_sources->len; depth++) {
+            const QemuCrucibleFaultRule *rule =
+                crucible_clock_effective_source_rule(cursor, candidate);
+
+            cursor = crucible_clock_fallback_target(rule);
+            if (!cursor) {
+                break;
+            }
+            if (cursor == source) {
+                return false;
+            }
+        }
+        if (cursor) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool crucible_clock_source_transition_candidate_valid(
+    const QemuCrucibleFaultRule *candidate)
+{
+    int64_t scheduler_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    if (scheduler_ns < 0) {
+        return false;
+    }
+    for (guint i = 0; i < crucible_clock_sources->len; i++) {
+        CrucibleClockSource *source = &g_array_index(
+            crucible_clock_sources, CrucibleClockSource, i);
+        const QemuCrucibleFaultRule *effective =
+            crucible_clock_effective_source_rule(source, candidate);
+        CrucibleClockSource derived;
+        uint64_t raw_ns, old_value, base_value, natural;
+        bool read_error = false;
+
+        if (crucible_clock_rule_identity_equal(
+                source->source_rule, effective)) {
+            continue;
+        }
+        if (source->transform_generation == UINT64_MAX ||
+            source->source_transition_generation == UINT64_MAX ||
+            !crucible_clock_source_raw_at(
+                source, scheduler_ns, &raw_ns) ||
+            !crucible_clock_source_value(
+                source, raw_ns, scheduler_ns, source->read_sequence,
+                false, &old_value, &read_error) || read_error) {
+            return false;
+        }
+        if (!effective) {
+            continue;
+        }
+        derived = *source;
+        if (!crucible_clock_source_transition(&derived, effective) ||
+            !crucible_clock_source_base(
+                &derived, raw_ns, scheduler_ns,
+                &base_value, &read_error) || read_error) {
+            return false;
+        }
+        derived.anchor_raw_ns = base_value;
+        derived.anchor_value_ns = base_value;
+        derived.synchronizing = false;
+        if (!crucible_clock_source_value(
+                &derived, raw_ns, scheduler_ns,
+                source->read_sequence, false,
+                &natural, &read_error) || read_error) {
+            return false;
+        }
+        if (derived.synchronization_numerator != 0 && natural != old_value) {
+            uint64_t difference = old_value >= natural ?
+                old_value - natural : natural - old_value;
+
+            if ((old_value > natural && difference > INT64_MAX) ||
+                (natural > old_value && difference >
+                    (UINT64_C(1) << 63)) ||
+                (old_value > natural &&
+                 (__uint128_t)derived.synchronization_numerator *
+                         derived.drift_denominator >=
+                     (__uint128_t)derived.drift_numerator *
+                         derived.synchronization_denominator)) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+int qemu_crucible_fault_clock_validate(const QemuCrucibleFaultRule *rule)
+{
+    const uint8_t *target;
+    CrucibleClockSource *source;
+    uint16_t model_phase;
+
+    if (!rule || !crucible_clock_mode() ||
+        !crucible_clock_bindings_sealed) {
+        return -ENOTSUP;
+    }
+    model_phase = qemu_crucible_fault_rule_model_phase(rule);
+    if (model_phase == 0 || model_phase > 64) {
+        return -EINVAL;
+    }
+    if (qemu_crucible_fault_rule_command_kind(rule) ==
+            CRUCIBLE_FAULT_COMMAND_CLOCK_SOURCE_STATE) {
+        bool selected = false;
+
+        if (qemu_crucible_fault_rule_operation(rule) ==
+                CRUCIBLE_NODE_FAULT_OPERATION_REMOVE) {
+            return crucible_clock_source_candidate_valid(rule) &&
+                   crucible_clock_source_transition_candidate_valid(rule) ?
+                       0 : -EINVAL;
+        }
+
+        for (guint i = 0; crucible_clock_sources &&
+             i < crucible_clock_sources->len; i++) {
+            CrucibleClockSource *candidate = &g_array_index(
+                crucible_clock_sources, CrucibleClockSource, i);
+
+            if (crucible_clock_hash_set_contains(
+                    rule, CRUCIBLE_NODE_FAULT_FIELD_P1,
+                    candidate->binding.id)) {
+                selected = true;
+                if (!(candidate->capability.model_phase_mask &
+                      (UINT64_C(1) << (model_phase - 1)))) {
+                    return -EINVAL;
+                }
+            }
+        }
+        return crucible_clock_source_rule_valid(rule) &&
+               crucible_clock_source_candidate_valid(rule) &&
+               crucible_clock_source_transition_candidate_valid(rule) &&
+               selected ?
+                   0 : -EINVAL;
+    }
+    if (qemu_crucible_fault_rule_operation(rule) !=
+            CRUCIBLE_NODE_FAULT_OPERATION_REMOVE) {
+        if (!crucible_clock_hash(
+                rule, CRUCIBLE_NODE_FAULT_FIELD_T1, &target)) {
+            return -EINVAL;
+        }
+        source = crucible_clock_source_by_id(target);
+        if (!source ||
+            !(source->capability.model_phase_mask &
+              (UINT64_C(1) << (model_phase - 1))) ||
+            !crucible_clock_rule_payload_valid(rule)) {
+            return -EINVAL;
+        }
+    }
+    if (qemu_crucible_fault_rule_operation(rule) ==
+            CRUCIBLE_NODE_FAULT_OPERATION_APPLY) {
+        uint32_t kind;
+
+        return crucible_clock_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P2,
+                                  &kind) && kind <= 3 ? 0 : -EINVAL;
+    }
+    for (guint i = 0; i < crucible_clock_sources->len; i++) {
+        CrucibleClockSource *candidate_source = &g_array_index(
+            crucible_clock_sources, CrucibleClockSource, i);
+        CrucibleClockValidation validation = {
+            .source = candidate_source,
+            .candidate = rule,
+            .numerator = candidate_source->impulse_drift_numerator,
+            .denominator = candidate_source->impulse_drift_denominator,
+            .additive = candidate_source->impulse_additive_nanos,
+            .valid = true,
+        };
+
+        qemu_crucible_fault_rule_foreach(
+            CRUCIBLE_FAULT_COMMAND_CLOCK_TRANSFORM,
+            crucible_clock_validation_visit, &validation);
+        crucible_clock_validation_visit(rule, &validation);
+        if (!validation.valid ||
+            candidate_source->transform_generation == UINT64_MAX ||
+            (candidate_source->synchronizing &&
+             candidate_source->synchronization_remaining_ns > 0 &&
+             (__uint128_t)candidate_source->synchronization_numerator *
+                     validation.denominator >=
+                 (__uint128_t)validation.numerator *
+                     candidate_source->synchronization_denominator)) {
+            return -EINVAL;
+        }
+    }
+    return 0;
+}
+
+static void crucible_clock_source_digest(
+    const CrucibleClockSource *source, uint8_t digest[32])
+{
+    uint8_t state[336] = { 0 };
+    uint8_t impulse_state[24] = { 0 };
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize digest_len = 32;
+
+    memcpy(state, "CRUCCST2", 8);
+    memcpy(state + 8, source->binding.id, 32);
+    stq_le_p(state + 40, source->anchor_raw_ns);
+    stq_le_p(state + 48, source->anchor_value_ns);
+    stq_le_p(state + 56, source->last_value_ns);
+    stq_le_p(state + 64, source->read_sequence);
+    stq_le_p(state + 72, source->transform_generation);
+    stq_le_p(state + 80, source->drift_numerator);
+    stq_le_p(state + 88, source->drift_denominator);
+    stq_le_p(state + 96, source->additive_nanos);
+    stq_le_p(state + 104, source->frozen_value_ns);
+    stl_le_p(state + 112, source->freeze_release);
+    stl_le_p(state + 116, source->monotonicity);
+    stl_le_p(state + 120, source->overdue_policy);
+    stl_le_p(state + 124, source->source_state);
+    memcpy(state + 128, source->fallback_id, 32);
+    stq_le_p(state + 160, source->synchronization_remaining_ns);
+    stq_le_p(state + 168, source->synchronization_numerator);
+    stq_le_p(state + 176, source->synchronization_denominator);
+    stq_le_p(state + 184, source->synchronization_threshold_ns);
+    stq_le_p(state + 200, source->synchronization_anchor_raw_ns);
+    stq_le_p(state + 208, source->source_transition_generation);
+    stl_le_p(state + 216, source->previous_source_state);
+    memcpy(state + 224, source->previous_fallback_id, 32);
+    stq_le_p(state + 256, source->timer_transition_sequence);
+    stq_le_p(state + 264, source->timer_old_guest_deadline_ns);
+    stq_le_p(state + 272, source->timer_old_scheduler_deadline_ns);
+    stq_le_p(state + 280, source->timer_old_transform_generation);
+    stq_le_p(state + 288, source->timer_new_guest_deadline_ns);
+    stq_le_p(state + 296, source->timer_new_scheduler_deadline_ns);
+    stq_le_p(state + 304, source->timer_new_transform_generation);
+    stw_le_p(state + 312, source->timer_role);
+    stl_le_p(state + 316, source->timer_index);
+    stl_le_p(state + 320, source->timer_action);
+    state[192] = source->has_last_value;
+    state[193] = source->frozen;
+    state[194] = source->synchronizing;
+    state[195] = source->terminal;
+    stl_le_p(state + 196, source->rules ? source->rules->len : 0);
+    g_checksum_update(checksum, state, sizeof(state));
+    stq_le_p(impulse_state, source->impulse_drift_numerator);
+    stq_le_p(impulse_state + 8, source->impulse_drift_denominator);
+    stq_le_p(impulse_state + 16, source->impulse_additive_nanos);
+    g_checksum_update(checksum, impulse_state, sizeof(impulse_state));
+    for (guint i = 0; source->rules && i < source->rules->len; i++) {
+        const CrucibleClockRuleState *rule_state = &g_array_index(
+            source->rules, CrucibleClockRuleState, i);
+        uint8_t evolving[64] = { 0 };
+
+        memcpy(evolving,
+               qemu_crucible_fault_rule_binding_hash(rule_state->rule), 32);
+        stq_le_p(evolving + 32, (uint64_t)rule_state->wander_offset);
+        stq_le_p(evolving + 40, (uint64_t)rule_state->wander_rate_ppb);
+        stq_le_p(evolving + 48, rule_state->wander_next_ns);
+        stq_le_p(evolving + 56, rule_state->wander_sequence);
+        g_checksum_update(checksum, evolving, sizeof(evolving));
+    }
+    if (source->source_rule) {
+        g_checksum_update(
+            checksum,
+            qemu_crucible_fault_rule_binding_hash(source->source_rule), 32);
+    }
+    g_checksum_get_digest(checksum, digest, &digest_len);
+    g_assert(digest_len == 32);
+}
+
+static bool crucible_clock_emit_one_read_event(
+    CrucibleClockSource *source, QemuCrucibleFaultRule *rule,
+    uint64_t raw_ns, uint64_t final_ns, bool read_error,
+    uint64_t raw_architectural, uint64_t final_architectural,
+    uint16_t width_bits, uint16_t wrap_action,
+    uint64_t observed_icount, uint64_t read_opportunity,
+    const uint8_t before_hash[32],
+    QemuCrucibleFaultEventReservation *reservation)
+{
+    uint8_t after_hash[32], opportunity_hash[32];
+    uint8_t identity[80] = { 0 };
+    uint8_t evidence[CRUCIBLE_CLOCK_READ_EVIDENCE_BYTES] = { 0 };
+    uint64_t opportunity;
+    uint32_t transform_kind = 0;
+    int64_t contributor = 0;
+    int64_t wander_rate = 0;
+    uint64_t wander_next = 0;
+    uint64_t wander_sequence = 0;
+
+    if (!reservation ||
+        !qemu_crucible_fault_rule_count_applied(rule, &opportunity)) {
+        return false;
+    }
+    memcpy(identity, "CRUCCRD1", 8);
+    memcpy(identity + 8, qemu_crucible_fault_rule_binding_hash(rule), 32);
+    memcpy(identity + 40, source->binding.id, 32);
+    stq_le_p(identity + 72, opportunity);
+    crucible_clock_sha256(identity, sizeof(identity), opportunity_hash);
+    crucible_clock_source_digest(source, after_hash);
+    for (guint i = 0; source->rules && i < source->rules->len; i++) {
+        CrucibleClockRuleState *state = &g_array_index(
+            source->rules, CrucibleClockRuleState, i);
+
+        if (!crucible_clock_rule_identity_equal(state->rule, rule)) {
+            continue;
+        }
+        if (!crucible_clock_u32(
+                rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &transform_kind)) {
+            return false;
+        }
+        if (transform_kind == 5) {
+            g_autoptr(GArray) distribution = NULL;
+
+            if (!crucible_clock_json_i64_array(
+                    qemu_crucible_fault_rule_json(
+                        rule, CRUCIBLE_NODE_FAULT_FIELD_P6),
+                    &distribution)) {
+                return false;
+            }
+            contributor = g_array_index(
+                distribution, int64_t,
+                crucible_clock_keyed_index(
+                    rule, source, read_opportunity, distribution->len));
+        } else if (transform_kind == 6) {
+            contributor = state->wander_offset;
+            wander_rate = state->wander_rate_ppb;
+            wander_next = state->wander_next_ns;
+            wander_sequence = state->wander_sequence;
+        }
+        break;
+    }
+    memcpy(evidence, "CRUCCRE1", 8);
+    stw_le_p(evidence + 8, 1);
+    stw_le_p(evidence + 10, source->capability.source_kind);
+    stl_le_p(evidence + 12, read_error ? 1 : 0);
+    stq_le_p(evidence + 16, observed_icount);
+    stq_le_p(evidence + 24, opportunity);
+    stq_le_p(evidence + 32, raw_ns);
+    stq_le_p(evidence + 40, final_ns);
+    stq_le_p(evidence + 48, source->anchor_raw_ns);
+    stq_le_p(evidence + 56, source->anchor_value_ns);
+    stq_le_p(evidence + 64, source->drift_numerator);
+    stq_le_p(evidence + 72, source->drift_denominator);
+    stq_le_p(evidence + 80, source->additive_nanos);
+    stq_le_p(evidence + 88, source->frozen_value_ns);
+    stq_le_p(evidence + 96, source->transform_generation);
+    stl_le_p(evidence + 104, source->monotonicity);
+    stl_le_p(evidence + 108, source->overdue_policy);
+    stl_le_p(evidence + 112, source->source_state);
+    stl_le_p(evidence + 116, source->freeze_release);
+    stq_le_p(evidence + 120, source->synchronization_remaining_ns);
+    memcpy(evidence + 128, source->binding.id, 32);
+    memcpy(evidence + 160,
+           qemu_crucible_fault_rule_binding_hash(rule), 32);
+    memcpy(evidence + 192, before_hash, 32);
+    memcpy(evidence + 224, after_hash, 32);
+    stl_le_p(evidence + 256, transform_kind);
+    stq_le_p(evidence + 264, read_opportunity);
+    stq_le_p(evidence + 272, (uint64_t)contributor);
+    stq_le_p(evidence + 280, (uint64_t)wander_rate);
+    stq_le_p(evidence + 288, wander_next);
+    stq_le_p(evidence + 296, wander_sequence);
+    stq_le_p(evidence + 304, source->source_transition_generation);
+    stl_le_p(evidence + 312, source->previous_source_state);
+    stl_le_p(evidence + 316, source->source_state);
+    memcpy(evidence + 320, source->previous_fallback_id, 32);
+    memcpy(evidence + 352, source->fallback_id, 32);
+    stq_le_p(evidence + 384, raw_architectural);
+    stq_le_p(evidence + 392, final_architectural);
+    stw_le_p(evidence + 400, width_bits);
+    stw_le_p(evidence + 402, wrap_action);
+    qemu_crucible_fault_event_reservation_consume(reservation);
+    qemu_crucible_fault_rule_event(
+        rule, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED, observed_icount,
+        opportunity_hash, before_hash, after_hash, evidence,
+        sizeof(evidence));
+    return true;
+}
+
+static bool crucible_clock_emit_read_events(
+    CrucibleClockSource *source, uint64_t raw_ns, uint64_t final_ns,
+    uint64_t raw_architectural, uint64_t final_architectural,
+    uint16_t width_bits, uint16_t wrap_action,
+    bool read_error, uint64_t observed_icount, uint64_t read_opportunity,
+    const uint8_t before_hash[32],
+    QemuCrucibleFaultEventReservation *reservation)
+{
+    for (guint i = 0; source->rules && i < source->rules->len; i++) {
+        CrucibleClockRuleState *state = &g_array_index(
+            source->rules, CrucibleClockRuleState, i);
+
+        if (!crucible_clock_transform_observed_at(
+                state->rule, QEMU_CRUCIBLE_MODEL_PHASE_CLOCK_READ)) {
+            continue;
+        }
+        if (!crucible_clock_emit_one_read_event(
+                source, state->rule, raw_ns, final_ns, read_error,
+                raw_architectural, final_architectural,
+                width_bits, wrap_action,
+                observed_icount, read_opportunity, before_hash,
+                reservation)) {
+            return false;
+        }
+    }
+    return !source->source_rule || crucible_clock_emit_one_read_event(
+        source, source->source_rule, raw_ns, final_ns, read_error,
+        raw_architectural, final_architectural, width_bits, wrap_action,
+        observed_icount, read_opportunity, before_hash, reservation);
+}
+
+int qemu_crucible_fault_clock_impulse(
+    const QemuCrucibleFaultRule *rule, uint64_t observed_icount,
+    uint8_t before_hash[32], uint8_t after_hash[32], GByteArray *evidence,
+    uint16_t *outcome,
+    QemuCrucibleFaultEventReservation **event_reservation)
+{
+    const uint8_t *target;
+    CrucibleClockSource *source;
+    uint32_t kind;
+    int64_t signed_value;
+    uint64_t numerator, denominator, unsigned_value;
+    uint64_t scheduler_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    uint64_t raw_ns;
+    uint64_t current, base_value, scaled, rate_value;
+    uint64_t next_drift_numerator, next_drift_denominator;
+    uint64_t next_impulse_numerator, next_impulse_denominator;
+    int64_t next_additive, next_impulse_additive;
+    bool read_error;
+    uint8_t record[CRUCIBLE_CLOCK_EVIDENCE_BYTES] = { 0 };
+
+    if (!rule || !before_hash || !after_hash || !evidence || !outcome ||
+        !event_reservation || !*event_reservation ||
+        !crucible_clock_hash(rule, CRUCIBLE_NODE_FAULT_FIELD_T1, &target)) {
+        return -EINVAL;
+    }
+    source = crucible_clock_source_by_id(target);
+    if (!source || !crucible_clock_source_raw_at(
+            source, scheduler_ns, &raw_ns) ||
+        !crucible_clock_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &kind) ||
+        !crucible_clock_i64(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                            &signed_value) ||
+        !crucible_clock_ratio(rule, CRUCIBLE_NODE_FAULT_FIELD_P4,
+                              &numerator, &denominator) ||
+        !crucible_clock_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P5,
+                            &unsigned_value) ||
+        kind > 3 ||
+        !crucible_clock_source_value(
+            source, raw_ns, scheduler_ns, source->read_sequence,
+            false, &current, &read_error) ||
+        read_error) {
+        return -EINVAL;
+    }
+    if (source->transform_generation == UINT64_MAX) {
+        return -ERANGE;
+    }
+    if (!crucible_clock_source_base(
+            source, raw_ns, scheduler_ns,
+            &base_value, &read_error) || read_error ||
+        !crucible_clock_scaled_delta(
+            base_value, source->anchor_raw_ns,
+            source->drift_numerator, source->drift_denominator, &scaled) ||
+        source->anchor_value_ns > UINT64_MAX - scaled) {
+        return -ERANGE;
+    }
+    rate_value = source->anchor_value_ns + scaled;
+    next_additive = source->additive_nanos;
+    next_impulse_additive = source->impulse_additive_nanos;
+    next_drift_numerator = source->drift_numerator;
+    next_drift_denominator = source->drift_denominator;
+    next_impulse_numerator = source->impulse_drift_numerator;
+    next_impulse_denominator = source->impulse_drift_denominator;
+    if ((kind == 1 || kind == 3) &&
+        (!crucible_clock_add_i64(&next_additive, signed_value) ||
+         !crucible_clock_add_i64(
+             &next_impulse_additive, signed_value))) {
+        return -ERANGE;
+    }
+    if (kind == 2 &&
+        (!crucible_clock_multiply_ratio(
+             &next_drift_numerator, &next_drift_denominator,
+             numerator, denominator) ||
+         !crucible_clock_multiply_ratio(
+             &next_impulse_numerator, &next_impulse_denominator,
+             numerator, denominator))) {
+        return -ERANGE;
+    }
+    crucible_clock_source_digest(source, before_hash);
+    if (kind == 1 || kind == 3) {
+        source->additive_nanos = next_additive;
+        source->impulse_additive_nanos = next_impulse_additive;
+    } else if (kind == 2) {
+        source->anchor_raw_ns = base_value;
+        source->anchor_value_ns = rate_value;
+        source->drift_numerator = next_drift_numerator;
+        source->drift_denominator = next_drift_denominator;
+        source->impulse_drift_numerator = next_impulse_numerator;
+        source->impulse_drift_denominator = next_impulse_denominator;
+    }
+    source->transform_generation++;
+    crucible_clock_rearm_source(source);
+    crucible_clock_source_digest(source, after_hash);
+    memcpy(record, "CRUCCIM1", 8);
+    stw_le_p(record + 8, 1);
+    stw_le_p(record + 10, kind);
+    stq_le_p(record + 16, observed_icount);
+    stq_le_p(record + 24, raw_ns);
+    stq_le_p(record + 32, current);
+    stq_le_p(record + 40, signed_value);
+    stq_le_p(record + 48, numerator);
+    stq_le_p(record + 56, denominator);
+    stq_le_p(record + 64, unsigned_value);
+    stq_le_p(record + 72, source->transform_generation);
+    memcpy(record + 80, source->binding.id, 32);
+    memcpy(record + 112,
+           qemu_crucible_fault_rule_binding_hash(rule), 32);
+    memcpy(record + 144, before_hash, 32);
+    memcpy(record + 176, after_hash, 32);
+    stw_le_p(record + 208,
+             qemu_crucible_fault_rule_model_phase(rule));
+    stw_le_p(record + 210, source->capability.source_kind);
+    stq_le_p(record + 212, source->anchor_raw_ns);
+    stq_le_p(record + 220, source->anchor_value_ns);
+    stq_le_p(record + 228, source->drift_numerator);
+    stq_le_p(record + 236, source->drift_denominator);
+    stq_le_p(record + 244, source->additive_nanos);
+    stq_le_p(record + 252, source->frozen_value_ns);
+    stl_le_p(record + 260, source->freeze_release);
+    stl_le_p(record + 264, source->monotonicity);
+    stl_le_p(record + 268, source->overdue_policy);
+    stl_le_p(record + 272, source->source_state);
+    g_byte_array_append(evidence, record, sizeof(record));
+    *outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED;
+    return 0;
+}
+
+void qemu_crucible_fault_clock_event_terminal(void)
+{
+    const QemuCrucibleFaultRule *terminal_rule = NULL;
+
+    if (crucible_clock_terminal) {
+        return;
+    }
+    crucible_clock_terminal = true;
+    for (guint i = 0; crucible_clock_sources &&
+         i < crucible_clock_sources->len; i++) {
+        CrucibleClockSource *source = &g_array_index(
+            crucible_clock_sources, CrucibleClockSource, i);
+
+        source->terminal = true;
+        if (!terminal_rule && source->rules && source->rules->len != 0) {
+            terminal_rule = g_array_index(
+                source->rules, CrucibleClockRuleState, 0).rule;
+        }
+        if (!terminal_rule && source->source_rule) {
+            terminal_rule = source->source_rule;
+        }
+        if (source->wander_timer) {
+            timer_del(source->wander_timer);
+        }
+    }
+    if (terminal_rule) {
+        qemu_crucible_fault_internal_terminal(terminal_rule, 1);
+    } else {
+        qemu_system_vmstop_request_prepare();
+        qemu_system_vmstop_request(RUN_STATE_INTERNAL_ERROR);
+    }
+}
+
+static void crucible_clock_runtime_clear(CrucibleClockSource *source)
+{
+    crucible_clock_source_clear_rules(source);
+    memset(source, 0, sizeof(*source));
+}
+
+static void crucible_clock_vmstate_free(void *opaque)
+{
+    CrucibleClockVmstate *state = opaque;
+
+    if (!state) {
+        return;
+    }
+    if (state->sources) {
+        for (guint i = 0; i < state->sources->len; i++) {
+            crucible_clock_runtime_clear(&g_array_index(
+                state->sources, CrucibleClockSource, i));
+        }
+        g_array_unref(state->sources);
+    }
+    g_free(state);
+}
+
+static void crucible_clock_vmstate_put_source(
+    GByteArray *payload, const CrucibleClockSource *source)
+{
+    qemu_crucible_fault_vmstate_put_u64(payload, source->anchor_raw_ns);
+    qemu_crucible_fault_vmstate_put_u64(payload, source->anchor_value_ns);
+    qemu_crucible_fault_vmstate_put_u64(payload, source->last_value_ns);
+    qemu_crucible_fault_vmstate_put_u64(payload, source->read_sequence);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, source->transform_generation);
+    qemu_crucible_fault_vmstate_put_u64(payload, source->drift_numerator);
+    qemu_crucible_fault_vmstate_put_u64(payload, source->drift_denominator);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, (uint64_t)source->additive_nanos);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, source->impulse_drift_numerator);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, source->impulse_drift_denominator);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, (uint64_t)source->impulse_additive_nanos);
+    qemu_crucible_fault_vmstate_put_u64(payload, source->frozen_value_ns);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, (uint64_t)source->synchronization_remaining_ns);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, source->synchronization_anchor_raw_ns);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, source->synchronization_numerator);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, source->synchronization_denominator);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, source->synchronization_threshold_ns);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, source->source_transition_generation);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, source->timer_transition_sequence);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, source->timer_old_guest_deadline_ns);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, source->timer_old_scheduler_deadline_ns);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, source->timer_old_transform_generation);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, source->timer_new_guest_deadline_ns);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, source->timer_new_scheduler_deadline_ns);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, source->timer_new_transform_generation);
+    qemu_crucible_fault_vmstate_put_u32(payload, source->freeze_release);
+    qemu_crucible_fault_vmstate_put_u32(payload, source->monotonicity);
+    qemu_crucible_fault_vmstate_put_u32(payload, source->overdue_policy);
+    qemu_crucible_fault_vmstate_put_u32(payload, source->source_state);
+    qemu_crucible_fault_vmstate_put_u32(payload, source->timer_role);
+    qemu_crucible_fault_vmstate_put_u32(payload, source->timer_index);
+    qemu_crucible_fault_vmstate_put_u32(payload, source->timer_action);
+    qemu_crucible_fault_vmstate_put_u8(payload, source->has_last_value);
+    qemu_crucible_fault_vmstate_put_u8(payload, source->frozen);
+    qemu_crucible_fault_vmstate_put_u8(payload, source->synchronizing);
+    qemu_crucible_fault_vmstate_put_u8(payload, source->terminal);
+    qemu_crucible_fault_vmstate_put_u8(
+        payload, source->previous_source_state);
+    qemu_crucible_fault_vmstate_put_bytes(
+        payload, source->fallback_id, 32);
+    qemu_crucible_fault_vmstate_put_bytes(
+        payload, source->previous_fallback_id, 32);
+}
