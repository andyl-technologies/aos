diff --git a/accel/tcg/tcg-accel-ops-rr.c b/accel/tcg/tcg-accel-ops-rr.c
index 5617692..a47e73e 100644
--- a/accel/tcg/tcg-accel-ops-rr.c
+++ b/accel/tcg/tcg-accel-ops-rr.c
@@ -218,6 +218,21 @@ static bool rr_crucible_sim_all_vcpus_halted(void)
     return true;
 }
 
+static bool rr_crucible_sim_stop_or_unplug_pending(void)
+{
+    CPUState *cpu;
+
+    if (!rr_crucible_sim_mode()) {
+        return false;
+    }
+    CPU_FOREACH(cpu) {
+        if (cpu->stop || cpu->unplug) {
+            return true;
+        }
+    }
+    return false;
+}
+
 static void rr_crucible_sim_sync_vcpu_halt_callbacks(void)
 {
     CPUState *cpu;
@@ -405,6 +420,24 @@ static bool rr_crucible_sim_run_tcg_batch(CPUState **cpu_ptr,
                     qemu_cond_wait_bql(first_cpu->halt_cond);
                     return true;
                 }
+                /*
+                 * A completion callback may enqueue the commit half of a
+                 * prepared transaction at a later instruction boundary.  The
+                 * budget that brought us to the prepare boundary is zero, so
+                 * replenish it before looking at the new deadline.  Falling
+                 * out to rr_wait_io_event() here would strand an otherwise
+                 * runnable guest: no external event is required to reach the
+                 * newly queued boundary.
+                 */
+                if (!crucible_sim_shmem_dispatch_registered() &&
+                    !crucible_sim_observer_registered() &&
+                    qemu_crucible_fault_next_icount(
+                        CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY) >
+                        current_icount &&
+                    !rr_crucible_sim_boundary_deadline_due()) {
+                    rr_crucible_sim_refresh_batch_budget(cpu_budget);
+                    continue;
+                }
                 return false;
             }
         }
@@ -558,10 +591,11 @@ static void rr_wait_io_event(void)
         return;
     }
 
-    while (all_cpu_threads_idle() ||
-           (rr_crucible_sim_mode() &&
-            (rr_crucible_sim_all_vcpus_halted() ||
-             qemu_plugin_time_advance_is_pending()))) {
+    while (!rr_crucible_sim_stop_or_unplug_pending() &&
+           (all_cpu_threads_idle() ||
+            (rr_crucible_sim_mode() &&
+             (rr_crucible_sim_all_vcpus_halted() ||
+              qemu_plugin_time_advance_is_pending())))) {
 
         rr_stop_kick_timer();
         if (qemu_plugin_time_advance_is_pending()) {
@@ -578,6 +612,9 @@ static void rr_wait_io_event(void)
             if (qemu_plugin_crucible_vmstop_pending()) {
                 return;
             }
+            if (rr_crucible_sim_stop_or_unplug_pending()) {
+                break;
+            }
             qemu_cond_wait_bql(first_cpu->halt_cond);
             continue;
         }
@@ -596,6 +633,9 @@ static void rr_wait_io_event(void)
             if (qemu_plugin_crucible_vmstop_pending()) {
                 return;
             }
+            if (rr_crucible_sim_stop_or_unplug_pending()) {
+                break;
+            }
             if (!rr_crucible_sim_all_vcpus_halted()) {
                 break;
             }
@@ -757,6 +797,16 @@ static void *rr_cpu_thread_fn(void *arg)
             cpu = first_cpu;
         }
         cpu = rr_crucible_sim_loop_cpu(cpu);
+        if (rr_crucible_sim_mode() && cpu && cpu->exit_request &&
+            cpu_work_list_empty(cpu) && !cpu->stop && !cpu->unplug &&
+            cpu_can_run(cpu) &&
+            qemu_crucible_fault_next_icount(
+                CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY) >
+                qemu_plugin_icount_raw() &&
+            qemu_crucible_fault_next_icount(
+                CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY) != UINT64_MAX) {
+            rr_crucible_sim_reset_exit_request(cpu);
+        }
 
         while (cpu && cpu_work_list_empty(cpu) && !cpu->exit_request) {
             /* Store rr_current_cpu before evaluating cpu_can_run().  */
@@ -835,6 +885,18 @@ static void *rr_cpu_thread_fn(void *arg)
                         (dispatch_due || !observer_due)) {
                         qemu_cond_wait_bql(first_cpu->halt_cond);
                     }
+                    if (!crucible_sim_shmem_dispatch_registered() &&
+                        !crucible_sim_observer_registered() &&
+                        qemu_crucible_fault_next_icount(
+                            CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY) >
+                            current_icount &&
+                        qemu_crucible_fault_next_icount(
+                            CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY) != UINT64_MAX) {
+                        rr_crucible_sim_refresh_batch_budget(&cpu_budget);
+                        if (cpu_budget > 0) {
+                            continue;
+                        }
+                    }
                     break;
                 }
             }
@@ -883,6 +945,27 @@ static void *rr_cpu_thread_fn(void *arg)
          */
         rr_crucible_sim_advance_stalled_deadline();
 
+        /*
+         * Re-enter the run loop when a boundary callback queued later work
+         * for a runnable guest.  Reaching an exact icount boundary may leave
+         * CPUState::exit_request set and exhaust the current CPU iterator;
+         * after clearing that request above, rr_wait_io_event() would wait
+         * forever because advancing to the next fault is itself the only
+         * remaining source of progress.
+         */
+        if (rr_crucible_sim_mode() &&
+            !rr_crucible_sim_stop_or_unplug_pending() &&
+            cpu && cpu_work_list_empty(cpu) &&
+            !rr_crucible_sim_all_vcpus_halted() &&
+            qemu_crucible_fault_next_icount(
+                CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY) >
+                qemu_plugin_icount_raw() &&
+            qemu_crucible_fault_next_icount(
+                CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY) != UINT64_MAX) {
+            cpu = first_cpu;
+            continue;
+        }
+
         if (icount_enabled() && all_cpu_threads_idle()) {
             /*
              * When all cpus are sleeping (e.g in WFI), to avoid a deadlock
diff --git a/hw/acpi/core.c b/hw/acpi/core.c
index 58f8964..41fe09c 100644
--- a/hw/acpi/core.c
+++ b/hw/acpi/core.c
@@ -20,6 +20,8 @@
  */
 
 #include "qemu/osdep.h"
+#include "qemu/crucible-fault.h"
+#include "qemu/error-report.h"
 #include "hw/irq.h"
 #include "hw/acpi/acpi.h"
 #include "hw/nvram/fw_cfg.h"
@@ -34,6 +36,8 @@
 #include "system/runstate.h"
 #include "trace.h"
 
+static inline int64_t acpi_pm_tmr_get_clock(bool guest_read);
+
 struct acpi_table_header {
     uint16_t _length;         /* our length, not actual part of the hdr */
                               /* allows easier parsing for fw_cfg clients */
@@ -387,11 +391,9 @@ static void acpi_notify_wakeup(Notifier *notifier, void *data)
 /* ACPI PM1a EVT */
 uint16_t acpi_pm1_evt_get_sts(ACPIREGS *ar)
 {
-    /* Compare ns-clock, not PM timer ticks, because
-       acpi_pm_tmr_update function uses ns for setting the timer. */
-    int64_t d = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
-    if (d >= muldiv64(ar->tmr.overflow_time,
-                      NANOSECONDS_PER_SECOND, PM_TIMER_FREQUENCY)) {
+    int64_t d = acpi_pm_tmr_get_clock(false);
+
+    if (d >= ar->tmr.overflow_time) {
         ar->pm1.evt.sts |= ACPI_BITMASK_TIMER_STATUS;
     }
     return ar->pm1.evt.sts;
@@ -483,32 +485,111 @@ void acpi_pm1_evt_init(ACPIREGS *ar, acpi_update_sci_fn update_sci,
 void acpi_pm_tmr_update(ACPIREGS *ar, bool enable)
 {
     int64_t expire_time;
+    bool fault_active = qemu_crucible_fault_clock_source_active(
+        QEMU_CRUCIBLE_CLOCK_X86_ACPI_PM_TIMER, 0);
+    uint64_t old_guest_deadline = ar->tmr.crucible_guest_deadline_ns;
+    uint64_t old_generation = ar->tmr.crucible_transform_generation;
+    uint64_t old_scheduler_deadline = timer_pending(ar->tmr.timer) ?
+        timer_expire_time_ns(ar->tmr.timer) : UINT64_MAX;
 
     /* schedule a timer interruption if needed */
     if (enable) {
+        uint32_t overdue = QEMU_CRUCIBLE_CLOCK_TIMER_UNREACHABLE;
+
         expire_time = muldiv64(ar->tmr.overflow_time, NANOSECONDS_PER_SECOND,
                                PM_TIMER_FREQUENCY);
+        if (fault_active) {
+            uint64_t generation;
+            uint64_t guest_deadline = expire_time;
+            if (expire_time < 0 ||
+                !qemu_crucible_fault_clock_deadline_ns(
+                    QEMU_CRUCIBLE_CLOCK_X86_ACPI_PM_TIMER, 0,
+                    guest_deadline, QEMU_CRUCIBLE_CLOCK_TIMER_PRIMARY, 0,
+                    0, &ar->tmr.crucible_timer_arm_sequence,
+                    &expire_time, &overdue,
+                    &generation, &guest_deadline)) {
+                ar->tmr.crucible_guest_deadline_ns = 0;
+                ar->tmr.crucible_transform_generation = 0;
+                timer_del(ar->tmr.timer);
+                if (!qemu_crucible_fault_clock_timer_transition(
+                        QEMU_CRUCIBLE_CLOCK_X86_ACPI_PM_TIMER, 0,
+                        QEMU_CRUCIBLE_CLOCK_TIMER_PRIMARY, 0,
+                        ar->tmr.crucible_timer_arm_sequence,
+                        old_guest_deadline, old_scheduler_deadline,
+                        old_generation, 0, UINT64_MAX, 0,
+                        overdue == QEMU_CRUCIBLE_CLOCK_TIMER_DROP ?
+                            overdue :
+                            QEMU_CRUCIBLE_CLOCK_TIMER_UNREACHABLE)) {
+                    qemu_crucible_fault_clock_event_terminal();
+                }
+                return;
+            }
+            ar->tmr.crucible_guest_deadline_ns = guest_deadline;
+            ar->tmr.crucible_transform_generation = generation;
+        } else {
+            ar->tmr.crucible_guest_deadline_ns = 0;
+            ar->tmr.crucible_transform_generation = 0;
+        }
         timer_mod(ar->tmr.timer, expire_time);
+        if (fault_active && !qemu_crucible_fault_clock_timer_transition(
+                QEMU_CRUCIBLE_CLOCK_X86_ACPI_PM_TIMER, 0,
+                QEMU_CRUCIBLE_CLOCK_TIMER_PRIMARY, 0,
+                ar->tmr.crucible_timer_arm_sequence,
+                old_guest_deadline, old_scheduler_deadline, old_generation,
+                ar->tmr.crucible_guest_deadline_ns, expire_time,
+                ar->tmr.crucible_transform_generation, overdue)) {
+            qemu_crucible_fault_clock_event_terminal();
+        }
     } else {
+        ar->tmr.crucible_guest_deadline_ns = 0;
+        ar->tmr.crucible_transform_generation = 0;
         timer_del(ar->tmr.timer);
+        if (fault_active && old_generation != 0 &&
+            !qemu_crucible_fault_clock_timer_transition(
+                QEMU_CRUCIBLE_CLOCK_X86_ACPI_PM_TIMER, 0,
+                QEMU_CRUCIBLE_CLOCK_TIMER_PRIMARY, 0,
+                ar->tmr.crucible_timer_arm_sequence,
+                old_guest_deadline, old_scheduler_deadline, old_generation,
+                0, UINT64_MAX, 0, QEMU_CRUCIBLE_CLOCK_TIMER_DROP)) {
+            qemu_crucible_fault_clock_event_terminal();
+        }
     }
 }
 
-static inline int64_t acpi_pm_tmr_get_clock(void)
+static inline int64_t acpi_pm_tmr_get_clock(bool guest_read)
 {
-    return muldiv64(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), PM_TIMER_FREQUENCY,
-                    NANOSECONDS_PER_SECOND);
+    uint64_t raw = muldiv64(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL),
+                            PM_TIMER_FREQUENCY, NANOSECONDS_PER_SECOND);
+    uint64_t transformed = raw;
+    bool read_error = false;
+
+    if (qemu_crucible_fault_clock_source_active(
+            QEMU_CRUCIBLE_CLOCK_X86_ACPI_PM_TIMER, 0) &&
+        !(guest_read ? qemu_crucible_fault_clock_read_ticks(
+              QEMU_CRUCIBLE_CLOCK_X86_ACPI_PM_TIMER, 0, raw, 0,
+              &transformed, &read_error) :
+          qemu_crucible_fault_clock_project_ticks(
+              QEMU_CRUCIBLE_CLOCK_X86_ACPI_PM_TIMER, 0, raw,
+              &transformed, &read_error))) {
+        error_report("Crucible ACPI PM timer transform failed");
+        abort();
+    }
+    if (read_error || transformed > INT64_MAX) {
+        error_report("Crucible ACPI PM timer source is unreadable");
+        abort();
+    }
+    return transformed;
 }
 
 void acpi_pm_tmr_calc_overflow_time(ACPIREGS *ar)
 {
-    int64_t d = acpi_pm_tmr_get_clock();
+    int64_t d = acpi_pm_tmr_get_clock(false);
     ar->tmr.overflow_time = (d + 0x800000LL) & ~0x7fffffLL;
 }
 
 static uint32_t acpi_pm_tmr_get(ACPIREGS *ar)
 {
-    uint32_t d = acpi_pm_tmr_get_clock();
+    uint32_t d = acpi_pm_tmr_get_clock(true);
     return d & 0xffffff;
 }
 
@@ -516,6 +597,19 @@ static void acpi_pm_tmr_timer(void *opaque)
 {
     ACPIREGS *ar = opaque;
 
+    if (!qemu_crucible_fault_clock_timer_fire(
+            QEMU_CRUCIBLE_CLOCK_X86_ACPI_PM_TIMER, 0,
+            QEMU_CRUCIBLE_CLOCK_TIMER_PRIMARY, 0,
+            ar->tmr.crucible_timer_arm_sequence,
+            ar->tmr.crucible_guest_deadline_ns,
+            timer_expire_time_ns(ar->tmr.timer),
+            ar->tmr.crucible_transform_generation)) {
+        qemu_crucible_fault_clock_event_terminal();
+        return;
+    }
+
+    ar->tmr.crucible_guest_deadline_ns = 0;
+    ar->tmr.crucible_transform_generation = 0;
     qemu_system_wakeup_request(QEMU_WAKEUP_REASON_PMTIMER, NULL);
     ar->tmr.update_sci(ar);
 }
@@ -540,6 +634,14 @@ static const MemoryRegionOps acpi_pm_tmr_ops = {
     .endianness = DEVICE_LITTLE_ENDIAN,
 };
 
+static void acpi_pm_tmr_crucible_rearm(void *opaque)
+{
+    ACPIREGS *ar = opaque;
+
+    acpi_pm_tmr_update(
+        ar, ar->pm1.evt.en & ACPI_BITMASK_TIMER_ENABLE);
+}
+
 void acpi_pm_tmr_init(ACPIREGS *ar, acpi_update_sci_fn update_sci,
                       MemoryRegion *parent)
 {
@@ -548,11 +650,40 @@ void acpi_pm_tmr_init(ACPIREGS *ar, acpi_update_sci_fn update_sci,
     memory_region_init_io(&ar->tmr.io, memory_region_owner(parent),
                           &acpi_pm_tmr_ops, ar, "acpi-tmr", 4);
     memory_region_add_subregion(parent, 8, &ar->tmr.io);
+    const QemuCrucibleClockSourceDescriptor clock = {
+        .source_kind = QEMU_CRUCIBLE_CLOCK_X86_ACPI_PM_TIMER,
+        .architecture = QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_X86_64,
+        .base_domain = 1,
+        .timer_relationship = 1,
+        .monotonicity = QEMU_CRUCIBLE_CLOCK_ALLOW_BACKWARD,
+        .width_bits = 24,
+        .flags = QEMU_CRUCIBLE_CLOCK_SOURCE_WRAPS,
+        .frequency_numerator = PM_TIMER_FREQUENCY,
+        .frequency_denominator = 1,
+        .model_phase_mask =
+            UINT64_C(1) << (QEMU_CRUCIBLE_MODEL_PHASE_CLOCK_READ - 1) |
+            UINT64_C(1) << (QEMU_CRUCIBLE_MODEL_PHASE_ARM - 1) |
+            UINT64_C(1) << (QEMU_CRUCIBLE_MODEL_PHASE_FIRE - 1) |
+            UINT64_C(1) << (QEMU_CRUCIBLE_MODEL_PHASE_SYNCHRONIZE - 1) |
+            UINT64_C(1) << (QEMU_CRUCIBLE_MODEL_PHASE_SOURCE_SWITCH - 1),
+        .id = "x86-acpi-pm-timer",
+        .implementation = "hw/acpi/core",
+        .rearm_timers = acpi_pm_tmr_crucible_rearm,
+        .opaque = ar,
+    };
+    int status = qemu_crucible_fault_clock_source_register(&clock);
+
+    if (status != 0) {
+        error_report("failed to register Crucible ACPI PM timer source");
+        abort();
+    }
 }
 
 void acpi_pm_tmr_reset(ACPIREGS *ar)
 {
     ar->tmr.overflow_time = 0;
+    ar->tmr.crucible_guest_deadline_ns = 0;
+    ar->tmr.crucible_transform_generation = 0;
     timer_del(ar->tmr.timer);
 }
 
