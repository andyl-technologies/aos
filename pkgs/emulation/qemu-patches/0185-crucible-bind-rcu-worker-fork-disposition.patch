+static void assert_runtime_transaction_rejects_worker(
+    const char *name, void *(*start_routine)(void *))
+{
+    QemuCrucibleHotForkRuntimeTransaction transaction = { 0 };
+    QemuRcuHotForkBarrierInventory barrier;
+    RegistryWorker worker;
+    QemuThread thread;
+    int ready[2];
+    int release[2];
+
+    g_assert_cmpint(pipe2(ready, O_CLOEXEC), ==, 0);
+    g_assert_cmpint(pipe2(release, O_CLOEXEC), ==, 0);
+    worker = (RegistryWorker) {
+        .ready_fd = ready[1],
+        .release_fd = release[0],
+    };
+    qemu_thread_create(&thread, name, start_routine, &worker,
+                       QEMU_THREAD_JOINABLE);
+    g_assert_cmpint(read_child_result(ready[0]), ==, 0);
+
+    g_assert_cmpint(qemu_crucible_hot_fork_begin_runtime_transaction(
+                        &transaction),
+                    ==, -EBUSY);
+    g_assert_false(transaction.active);
+    g_assert_false(transaction.rcu.active);
+    g_assert_false(transaction.registry.active);
+    qemu_rcu_hot_fork_barrier(QEMU_RCU_HOT_FORK_BARRIER_QUERY, &barrier);
+    g_assert_false(barrier.held);
+
+    write_child_result(release[1], 0);
+    qemu_thread_join(&thread);
     close(release[0]);
     close(release[1]);
     close(ready[0]);
     close(ready[1]);
 }
 
+static void test_runtime_transaction_rejects_unsupported_threads(void)
+{
+    assert_runtime_transaction_rejects_worker("fork-unclassified-test",
+                                              registry_worker);
+    assert_runtime_transaction_rejects_worker("fork-aio-test",
+                                              aio_registry_worker);
+}
