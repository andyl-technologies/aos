+static int crucible_shmem_decode_poll_result(int64_t poll_ret,
+                                             size_t in_capacity)
+{
+    int64_t typed_error_min = QEMU_PLUGIN_BLK_POLL_ERROR(
+        QEMU_PLUGIN_BLK_POLL_ERROR_MAX);
+    int64_t typed_error_max = QEMU_PLUGIN_BLK_POLL_ERROR(1);
+
+    if (poll_ret == -1) {
+        return -EIO;
+    }
+    if (poll_ret >= typed_error_min && poll_ret <= typed_error_max) {
+        return (int)(poll_ret + QEMU_PLUGIN_BLK_POLL_ERROR_BASE);
+    }
+    if (poll_ret < -1 || (uint64_t)poll_ret > in_capacity) {
+        return -EOVERFLOW;
+    }
+    return (int)poll_ret;
+}
