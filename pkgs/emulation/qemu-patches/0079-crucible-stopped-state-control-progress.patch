diff --git a/accel/tcg/tcg-accel-ops-rr.c b/accel/tcg/tcg-accel-ops-rr.c
index acd85e050..a181beba6 100644
--- a/accel/tcg/tcg-accel-ops-rr.c
+++ b/accel/tcg/tcg-accel-ops-rr.c
@@ -262,6 +262,18 @@ static void rr_crucible_sim_drain_vcpu_work(void)
     }
 }
 
+static bool rr_crucible_sim_vcpu_work_pending(void)
+{
+    CPUState *cpu;
+
+    CPU_FOREACH(cpu) {
+        if (!cpu_work_list_empty(cpu)) {
+            return true;
+        }
+    }
+    return false;
+}
+
 static void rr_crucible_sim_park_vmstop(void)
 {
     while (qemu_plugin_crucible_vmstop_pending()) {
@@ -272,8 +284,20 @@ static void rr_crucible_sim_park_vmstop(void)
          * converts those stop requests into CPUState::stopped before we park.
          */
         rr_crucible_sim_drain_vcpu_work();
-        if (qemu_plugin_crucible_vmstop_pending()) {
-            qemu_cond_wait_bql(first_cpu->halt_cond);
+        /*
+         * Close the lost-kick window between draining vCPU work and sleeping.
+         * The main loop may set CPUState::stop or queue vCPU work and signal
+         * halt_cond in that interval.  Rechecking both level-triggered
+         * predicates under the BQL prevents us from sleeping after that signal
+         * has already been consumed.  A bounded wait is still required because
+         * non-BQL producers may enqueue work concurrently with the predicate
+         * check; the condition signal is a latency hint, never the sole source
+         * of forward progress for the native stop handshake.
+         */
+        if (qemu_plugin_crucible_vmstop_pending() &&
+            !rr_crucible_sim_stop_or_unplug_pending() &&
+            !rr_crucible_sim_vcpu_work_pending()) {
+            qemu_cond_timedwait_bql(first_cpu->halt_cond, 1);
         }
     }
 }
