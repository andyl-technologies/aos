+static void test_source_mapping_binding_is_exact(void)
+{
+    QemuCrucibleHotForkSourceMapping mapping = { 0 };
+    struct stat metadata;
+    uint64_t page_size = qemu_real_host_page_size();
+    void *source;
+    void *alias;
+    int backing;
+
+    backing = memfd_create(
+        "crucible-hot-fork-source-mapping", MFD_CLOEXEC);
+    g_assert_cmpint(backing, >=, 0);
+    g_assert_cmpint(ftruncate(backing, page_size), ==, 0);
+    source = mmap(NULL, page_size, PROT_READ | PROT_WRITE, MAP_SHARED,
+                  backing, 0);
+    g_assert_true(source != MAP_FAILED);
+    g_assert_cmpint(fstat(backing, &metadata), ==, 0);
+
+    g_assert_cmpint(qemu_crucible_hot_fork_find_source_mapping(
+                        metadata.st_dev, metadata.st_ino, page_size, &mapping),
+                    ==, 0);
+    g_assert_cmpuint(mapping.start, ==, (uintptr_t)source);
+    g_assert_cmpuint(mapping.length, ==, page_size);
+    g_assert_cmpuint(mapping.offset, ==, 0);
+
+    alias = mmap(NULL, page_size, PROT_READ | PROT_WRITE, MAP_SHARED,
+                 backing, 0);
+    g_assert_true(alias != MAP_FAILED);
+    g_assert_cmpint(qemu_crucible_hot_fork_find_source_mapping(
+                        metadata.st_dev, metadata.st_ino, page_size, &mapping),
+                    ==, -EPERM);
+    g_assert_cmpint(munmap(alias, page_size), ==, 0);
+    g_assert_cmpint(qemu_crucible_hot_fork_find_source_mapping(
+                        metadata.st_dev, metadata.st_ino + 1, page_size,
+                        &mapping),
+                    ==, -EPERM);
+
+    g_assert_cmpint(munmap(source, page_size), ==, 0);
+    close(backing);
+}
