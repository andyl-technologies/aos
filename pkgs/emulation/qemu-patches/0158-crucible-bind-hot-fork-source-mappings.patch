+typedef struct QemuCrucibleHotForkSourceMappingSearch {
+    uint64_t device_major;
+    uint64_t device_minor;
+    uint64_t inode;
+    uint64_t length;
+    QemuCrucibleHotForkSourceMapping mapping;
+    bool found;
+} QemuCrucibleHotForkSourceMappingSearch;
+
+static int crucible_hot_fork_match_source_mapping(
+    const char *record,
+    size_t record_length,
+    QemuCrucibleHotForkSourceMappingSearch *search)
+{
+    uint64_t start;
+    uint64_t mapping_length;
+    uint64_t offset;
+    uint64_t device_major;
+    uint64_t device_minor;
+    uint64_t inode;
+    bool writable_shared;
+    int result = crucible_hot_fork_parse_mapping_record(
+        record, record_length, &start, &mapping_length, &offset,
+        &device_major, &device_minor, &inode, &writable_shared);
+
+    if (result != 0 || !writable_shared ||
+        device_major != search->device_major ||
+        device_minor != search->device_minor || inode != search->inode) {
+        return result;
+    }
+    if (search->found || offset != 0 || mapping_length != search->length) {
+        return -EPERM;
+    }
+    search->mapping.start = start;
+    search->mapping.length = mapping_length;
+    search->mapping.offset = offset;
+    search->found = true;
+    return 0;
+}
+
+int qemu_crucible_hot_fork_find_source_mapping(
+    uint64_t device,
+    uint64_t inode,
+    uint64_t length,
+    QemuCrucibleHotForkSourceMapping *mapping)
+{
+    char input[4096];
+    char record[QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_RECORD_BYTES];
+    QemuCrucibleHotForkSourceMappingSearch search = {
+        .inode = inode,
+        .length = length,
+    };
+    size_t record_count = 0;
+    size_t record_length = 0;
+    size_t total_bytes = 0;
+    uint64_t page_size = qemu_real_host_page_size();
+    int maps_fd;
+    int result = 0;
+
+    if (!mapping || (uint64_t)(dev_t)device != device || inode == 0 ||
+        length == 0 || page_size == 0 ||
+        length % page_size != 0) {
+        return -EINVAL;
+    }
+    search.device_major = major((dev_t)device);
+    search.device_minor = minor((dev_t)device);
+    memset(mapping, 0, sizeof(*mapping));
+
+    maps_fd = open("/proc/self/maps", O_RDONLY | O_CLOEXEC);
+    if (maps_fd < 0) {
+        return -errno;
+    }
+    for (;;) {
+        ssize_t input_length = read(maps_fd, input, sizeof(input));
+
+        if (input_length < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            result = -errno;
+            break;
+        }
+        if (input_length == 0) {
+            if (record_length != 0) {
+                record_count++;
+                if (record_count >
+                    QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_RECORDS) {
+                    result = -E2BIG;
+                } else {
+                    result = crucible_hot_fork_match_source_mapping(
+                        record, record_length, &search);
+                }
+            }
+            break;
+        }
+        if ((size_t)input_length >
+            QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_BYTES - total_bytes) {
+            result = -E2BIG;
+            break;
+        }
+        total_bytes += input_length;
+
+        for (ssize_t index = 0; index < input_length; index++) {
+            if (input[index] == '\n') {
+                record_count++;
+                if (record_count >
+                    QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_RECORDS) {
+                    result = -E2BIG;
+                    break;
+                }
+                result = crucible_hot_fork_match_source_mapping(
+                    record, record_length, &search);
+                record_length = 0;
+                if (result != 0) {
+                    break;
+                }
+            } else {
+                if (record_length == sizeof(record)) {
+                    result = -E2BIG;
+                    break;
+                }
+                record[record_length++] = input[index];
+            }
+        }
+        if (result != 0) {
+            break;
+        }
+    }
+    if (close(maps_fd) < 0 && result == 0) {
+        result = -errno;
+    }
+    if (result == 0 && !search.found) {
+        result = -EPERM;
+    }
+    if (result == 0) {
+        *mapping = search.mapping;
+    }
+    return result;
+}
