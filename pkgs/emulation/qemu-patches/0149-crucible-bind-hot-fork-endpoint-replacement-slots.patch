--- a/qapi/run-state.json
+++ b/qapi/run-state.json
@@ -1724,14 +1724,15 @@
 # @CrucibleHotForkPluginEndpointState:
 #
 # Exact QEMU-owned state for one authenticated branch-private plugin endpoint
-# pair. For a template-bound stage, version 3 records the exact quiescent
-# plugin-barrier generation and the complete worker masks that the parent must
-# resume and the child must reinitialize. It rejects nonempty worker-local
-# state. This is still a plan: it neither installs the endpoints in a fork
-# child nor recreates plugin workers, so readiness proof bits 6 through 8
-# remain clear.
+# pair. For a template-bound stage, version 4 records the exact quiescent
+# plugin-barrier generation, complete worker masks, retained source descriptor
+# slots, and distinct manifest-owned destination slots. The future child must
+# atomically replace both destination file descriptions before it invokes the
+# registered plugin reinitializer. It rejects nonempty worker-local state.
+# This is still a plan: it neither applies the descriptor replacement nor
+# recreates plugin workers, so readiness proof bits 6 through 8 remain clear.
 #
-# @schema-version: retained-endpoint contract version, currently 3
+# @schema-version: retained-endpoint contract version, currently 4
 #
 # @generation: process-local positive mutation generation, or zero initially
 #
@@ -1749,6 +1750,18 @@
 # @wake-eventfd-id: authenticated Linux `/proc/self/fdinfo` eventfd identity,
 #     or zero when absent
 #
+# @control-source-fd: QEMU-owned descriptor carrying the replacement control
+#     file description while staged, otherwise -1
+#
+# @wake-source-fd: QEMU-owned descriptor carrying the replacement wake file
+#     description while staged, otherwise -1
+#
+# @control-target-fd: exact manifest-owned control descriptor slot the child
+#     must replace, or -1 until a template-bound plan is accepted
+#
+# @wake-target-fd: exact manifest-owned wake descriptor slot the child must
+#     replace, or -1 until a template-bound plan is accepted
+#
 # @private-ring-generation: exact retained private-ring generation captured at
 #     staging, or zero when absent
 #
@@ -1770,6 +1783,10 @@
 # @worker-disposition-planned: whether the complete parent/child worker plan
 #     is retained under a nonzero template and plugin-barrier generation
 #
+# @replacement-plan-bound: whether the retained source and target descriptor
+#     pairs are exact, pairwise distinct, and bound to the sealed plugin
+#     manifest under the worker plan
+#
