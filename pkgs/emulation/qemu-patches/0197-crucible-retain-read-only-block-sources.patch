+typedef struct QemuBlockBackendHotForkReadOnlySource
+    QemuBlockBackendHotForkReadOnlySource;
+
+/*
+ * Retain one exact backend/root pair before preparing an immutable template.
+ * The caller has already stopped guest execution and owns that backend's
+ * complete lifecycle.  This process-local capability may not be serialized.
+ * Preparation does not change permissions or take the template barriers.
+ */
+QemuBlockBackendHotForkReadOnlySource *
+qemu_block_backend_hot_fork_read_only_source_new(BlockBackend *blk,
+                                               Error **errp);
+/*
+ * Flush and reopen the retained root read-only through its native driver.
+ * Success requires every reachable child (including backing and file nodes)
+ * to be read-only. Explicit writable child options fail closed; callers must
+ * restore a partially frozen root before resuming or releasing it.
+ * Calls run under the BQL/main AioContext before template barriers are held.
+ * Failure retains the exact partial transition for freeze or restore; it
+ * neither drops the owner nor permits source execution to resume.
+ */
+bool qemu_block_backend_hot_fork_read_only_source_freeze(
+    QemuBlockBackendHotForkReadOnlySource *source, Error **errp);
+/* Restore original access before source execution or ordinary destruction. */
+bool qemu_block_backend_hot_fork_read_only_source_restore(
+    QemuBlockBackendHotForkReadOnlySource *source, Error **errp);
+/* Report a freeze only while the exact root and all children stay read-only. */
+bool qemu_block_backend_hot_fork_read_only_source_is_frozen(
+    const QemuBlockBackendHotForkReadOnlySource *source);
+/*
+ * Release only a completely restored capability in its creating process.
+ * A rejected release leaves the capability and native references unchanged.
+ * An inherited child must use a separate explicit graph handoff, not restore
+ * or destroy its parent's writable root through this interface.
+ */
+bool qemu_block_backend_hot_fork_read_only_source_free(
+    QemuBlockBackendHotForkReadOnlySource *source, Error **errp);
+
 /*
  * Global state (GS) API. These functions run under the BQL.
  *
