@@ -0,0 +1,248 @@
+/*
+ * Crucible native read-only block source ownership
+ *
+ * Copyright (c) Andyl, Inc.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "block/block.h"
+#include "block/block_int.h"
+#include "block/graph-lock.h"
+#include "qapi/error.h"
+#include "qemu/main-loop.h"
+#include "system/block-backend.h"
+
+#define HOT_FORK_WRITE_PERMISSIONS \
+    (BLK_PERM_WRITE | BLK_PERM_WRITE_UNCHANGED | BLK_PERM_RESIZE)
+
+/* Bound validation of the supported hot-fork profile, not ordinary QEMU I/O. */
+#define HOT_FORK_SOURCE_MAX_DEPTH 256
+#define HOT_FORK_SOURCE_MAX_VISITS 65536
+
+typedef enum ReadOnlySourcePhase {
+    SOURCE_ORIGINAL,
+    SOURCE_PERMISSIONS_REDUCED,
+    SOURCE_FROZEN,
+} ReadOnlySourcePhase;
+
+struct QemuBlockBackendHotForkReadOnlySource {
+    BlockBackend *backend;
+    BlockDriverState *root;
+    uint64_t permissions;
+    uint64_t shared_permissions;
+    pid_t owner;
+    ReadOnlySourcePhase phase;
+};
+
+static bool GRAPH_RDLOCK source_graph_read_only(BlockDriverState *node,
+                                               unsigned depth,
+                                               size_t *remaining,
+                                               Error **errp)
+{
+    BdrvChild *child;
+
+    if (depth == HOT_FORK_SOURCE_MAX_DEPTH || !*remaining) {
+        error_setg(errp, "Crucible source graph exceeds hot-fork validation bounds");
+        return false;
+    }
+    --*remaining;
+    if (!bdrv_is_read_only(node)) {
+        error_setg(errp, "Crucible source graph retains a writable node");
+        return false;
+    }
+    QLIST_FOREACH(child, &node->children, next) {
+        if (!source_graph_read_only(child->bs, depth + 1, remaining, errp)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool source_graph_frozen(
+    const QemuBlockBackendHotForkReadOnlySource *source, Error **errp)
+{
+    size_t remaining = HOT_FORK_SOURCE_MAX_VISITS;
+    GRAPH_RDLOCK_GUARD_MAINLOOP();
+
+    /* Explicit child options can keep a file writable after its root reopens. */
+    return source_graph_read_only(source->root, 0, &remaining, errp);
+}
+
+static bool source_matches(const QemuBlockBackendHotForkReadOnlySource *source,
+                           Error **errp)
+{
+    uint64_t permissions, shared_permissions;
+    uint64_t expected_permissions, expected_shared;
+
+    if (!source || source->owner != getpid() ||
+        blk_bs(source->backend) != source->root) {
+        error_setg(errp, "Crucible read-only source lost its process or root");
+        return false;
+    }
+    blk_get_perm(source->backend, &permissions, &shared_permissions);
+    expected_permissions = source->permissions;
+    expected_shared = source->shared_permissions;
+    if (source->phase != SOURCE_ORIGINAL) {
+        expected_permissions &= ~HOT_FORK_WRITE_PERMISSIONS;
+        expected_shared |= HOT_FORK_WRITE_PERMISSIONS;
+    }
+    if (permissions != expected_permissions ||
+        shared_permissions != expected_shared ||
+        bdrv_is_read_only(source->root) != (source->phase == SOURCE_FROZEN)) {
+        error_setg(errp, "Crucible read-only source access changed externally");
+        return false;
+    }
+    return true;
+}
+
+static bool source_transition_allowed(
+    const QemuBlockBackendHotForkReadOnlySource *source, Error **errp)
+{
+    QemuBlockBackendHotForkBarrierInventory barrier;
+    bool held;
+
+    if (!source_matches(source, errp)) {
+        return false;
+    }
+    if (qemu_get_current_aio_context() != qemu_get_aio_context()) {
+        error_setg(errp, "Crucible source transition requires the main AioContext");
+        return false;
+    }
+    if (!qemu_block_backend_hot_fork_barrier(
+            QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY, &barrier)) {
+        error_setg(errp, "Cannot inspect Crucible source transition barriers");
+        return false;
+    }
+    held = barrier.held || barrier.graph_held;
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&barrier);
+    if (held) {
+        error_setg(errp, "Crucible source transition must precede fork barriers");
+        return false;
+    }
+    return true;
+}
+
+QemuBlockBackendHotForkReadOnlySource *
+qemu_block_backend_hot_fork_read_only_source_new(BlockBackend *blk,
+                                               Error **errp)
+{
+    QemuBlockBackendHotForkReadOnlySource *source;
+    BlockDriverState *root;
+    BdrvChild *parent;
+    size_t parents = 0;
+    uint64_t permissions, shared_permissions;
+
+    GLOBAL_STATE_CODE();
+    if (!blk || !(root = blk_bs(blk)) || !bdrv_is_writable(root)) {
+        error_setg(errp, "Crucible read-only source requires a writable root");
+        return NULL;
+    }
+    /* Other graph consumers must not have their access changed by this owner. */
+    QLIST_FOREACH(parent, &root->parents, next_parent) {
+        parents++;
+    }
+    blk_get_perm(blk, &permissions, &shared_permissions);
+    if (parents != 1 || !(permissions & HOT_FORK_WRITE_PERMISSIONS)) {
+        error_setg(errp, "Crucible read-only source requires one writable owner");
+        return NULL;
+    }
+    source = g_new0(QemuBlockBackendHotForkReadOnlySource, 1);
+    *source = (QemuBlockBackendHotForkReadOnlySource) {
+        .backend = blk,
+        .root = root,
+        .permissions = permissions,
+        .shared_permissions = shared_permissions,
+        .owner = getpid(),
+        .phase = SOURCE_ORIGINAL,
+    };
+    blk_ref(blk);
+    bdrv_ref(root);
+    return source;
+}
+
+bool qemu_block_backend_hot_fork_read_only_source_freeze(
+    QemuBlockBackendHotForkReadOnlySource *source, Error **errp)
+{
+    bool frozen = false;
+
+    GLOBAL_STATE_CODE();
+    if (!source_transition_allowed(source, errp)) {
+        return false;
+    }
+    bdrv_drained_begin(source->root);
+    if (source->phase == SOURCE_ORIGINAL) {
+        if (blk_set_perm(source->backend,
+                         source->permissions & ~HOT_FORK_WRITE_PERMISSIONS,
+                         source->shared_permissions | HOT_FORK_WRITE_PERMISSIONS,
+                         errp) < 0) {
+            goto out;
+        }
+        source->phase = SOURCE_PERMISSIONS_REDUCED;
+    }
+    if (source->phase == SOURCE_PERMISSIONS_REDUCED) {
+        /* Native reopen flushes caches before any child can inherit them. */
+        if (bdrv_reopen_set_read_only(source->root, true, errp) < 0) {
+            goto out;
+        }
+        source->phase = SOURCE_FROZEN;
+    }
+    frozen = source_matches(source, errp) && source_graph_frozen(source, errp);
+out:
+    bdrv_drained_end(source->root);
+    return frozen;
+}
+
+bool qemu_block_backend_hot_fork_read_only_source_restore(
+    QemuBlockBackendHotForkReadOnlySource *source, Error **errp)
+{
+    bool restored = false;
+
+    GLOBAL_STATE_CODE();
+    if (!source_transition_allowed(source, errp)) {
+        return false;
+    }
+    bdrv_drained_begin(source->root);
+    if (source->phase == SOURCE_FROZEN) {
+        if (bdrv_reopen_set_read_only(source->root, false, errp) < 0) {
+            goto out;
+        }
+        source->phase = SOURCE_PERMISSIONS_REDUCED;
+    }
+    if (source->phase == SOURCE_PERMISSIONS_REDUCED) {
+        if (blk_set_perm(source->backend, source->permissions,
+                         source->shared_permissions, errp) < 0) {
+            goto out;
+        }
+        source->phase = SOURCE_ORIGINAL;
+    }
+    restored = source_matches(source, errp);
+out:
+    bdrv_drained_end(source->root);
+    return restored;
+}
+
+bool qemu_block_backend_hot_fork_read_only_source_is_frozen(
+    const QemuBlockBackendHotForkReadOnlySource *source)
+{
+    GLOBAL_STATE_CODE();
+    return source && source->phase == SOURCE_FROZEN &&
+           source_matches(source, NULL) && source_graph_frozen(source, NULL);
+}
+
+bool qemu_block_backend_hot_fork_read_only_source_free(
+    QemuBlockBackendHotForkReadOnlySource *source, Error **errp)
+{
+    GLOBAL_STATE_CODE();
+    if (!source_matches(source, errp)) {
+        return false;
+    }
+    if (source->phase != SOURCE_ORIGINAL) {
+        error_setg(errp, "Crucible read-only source must be restored before release");
+        return false;
+    }
+    bdrv_unref(source->root);
+    blk_unref(source->backend);
+    g_free(source);
+    return true;
+}
