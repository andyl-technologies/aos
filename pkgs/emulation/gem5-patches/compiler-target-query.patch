+bin_target_arch = readCommand([main['CXX'], '-dumpmachine'])
 main["BIN_TARGET_ARCH"] = (
     "x86_64"
-    if bin_target_arch.find("Target: x86_64") != -1
+    if bin_target_arch.startswith("x86_64")
     else "aarch64"
-    if bin_target_arch.find("Target: aarch64") != -1
+    if bin_target_arch.startswith("aarch64")
     else "unknown"
 )
 
