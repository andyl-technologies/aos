+EventBoundaryResult
+simulateUntilBoundary(Tick exclusive_tick, uint64_t max_events)
+{
+    fatal_if(numMainEventQueues != 1 || inParallelMode,
+             "Pre-event boundaries require one native event queue");
+    fatal_if(simulate_limit_event != nullptr,
+             "Pre-event boundaries cannot mix with stock limit events");
+    fatal_if(async_event,
+             "Pre-event boundaries do not admit asynchronous host inputs");
+
+    EventQueue *eventq = getEventQueue(0);
+    curEventQueue(eventq);
+    fatal_if(exclusive_tick < curTick(),
+             "Pre-event boundary precedes the current native tick");
+
+    // An actual modeled exit has already been acknowledged by the caller.
+    // Its bookkeeping cleanup does not introduce a new modeled exit event.
+    if (global_exit_event) {
+        global_exit_event->clean();
+        global_exit_event = nullptr;
+    }
+
+    EventBoundaryResult result;
+    while (!eventq->empty() && result.processedEvents < max_events &&
+           eventq->nextTick() < exclusive_tick) {
+        fatal_if(async_event,
+                 "Asynchronous input appeared during bounded execution");
+        fatal_if(curTick() > eventq->nextTick(),
+                 "Native event is scheduled before the current tick");
+
+        Event *local_exit = eventq->serviceOne();
+        ++result.processedEvents;
+        if (local_exit) {
+            global_exit_event = dynamic_cast<GlobalSimLoopExitEvent *>(
+                local_exit->globalEvent());
+            fatal_if(!global_exit_event,
+                     "Bounded execution encountered a non-global exit");
+            result.exitEvent = global_exit_event;
+            break;
+        }
+    }
+
+    result.currentTick = curTick();
+    result.hasNextEvent = !eventq->empty();
+    if (result.hasNextEvent) {
+        result.nextTick = eventq->getHead()->when();
+        result.nextPriority = eventq->getHead()->priority();
+    }
+    return result;
+}
