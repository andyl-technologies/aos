+// SPDX-License-Identifier: BSD-3-Clause
+#ifndef __SIM_CRUCIBLE_OUTPUT_HH__
+#define __SIM_CRUCIBLE_OUTPUT_HH__
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+#include "base/types.hh"
+
+namespace gem5
+{
+
+/** Stable callback birth, never the time at which a controller reads output. */
+struct CrucibleNativeEventPosition
+{
+    Tick tick = 0;
+    uint64_t ordinal = 0;
+    uint64_t tickOrdinal = 0;
+    bool active = false;
+};
+
+CrucibleNativeEventPosition crucibleNativeEventPosition();
+
+struct CrucibleConsolePublication
+{
+    uint64_t outputId = 0;
+    Tick tick = 0;
+    uint64_t eventOrdinal = 0;
+    uint64_t tickOrdinal = 0;
+    uint64_t guestPid = 0;
+    uint64_t contextId = 0;
+    int guestFd = -1;
+    uint64_t causalParent = 0;
+    std::vector<uint8_t> payload;
+};
+
+void crucibleConfigureConsole(uint64_t guest_pid, int guest_fd);
+bool crucibleConsoleOwns(uint64_t guest_pid, int guest_fd);
+int64_t crucibleCaptureConsoleWrite(uint64_t guest_pid, uint64_t context_id,
+                                   int guest_fd, const void *bytes, size_t length);
+std::vector<CrucibleConsolePublication> crucibleConsolePublications();
+void crucibleAcknowledgeConsole(uint64_t original_output_id);
+void crucibleSetConsoleParent(uint64_t original_parent);
+
+} // namespace gem5
+
+#endif
