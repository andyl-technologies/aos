+// SPDX-License-Identifier: BSD-3-Clause
+#include "sim/crucible_output.hh"
+
+#include <deque>
+#include <limits>
+#include <utility>
+
+#include "base/logging.hh"
+#include "sim/simulate.hh"
+
+namespace gem5
+{
+
+namespace
+{
+constexpr size_t MaximumPayload = 65536;
+constexpr size_t MaximumPublications = 4096;
+constexpr size_t MaximumRetainedBytes = 16 * 1024 * 1024;
+
+bool configured = false;
+uint64_t configuredPid = 0;
+int configuredFd = -1;
+uint64_t nextOutputId = 1;
+uint64_t acknowledgedThrough = 0;
+uint64_t causalParent = 0;
+size_t retainedBytes = 0;
+std::deque<CrucibleConsolePublication> retained;
+}
+
+void
+crucibleConfigureConsole(uint64_t guest_pid, int guest_fd)
+{
+    fatal_if(configured || crucibleModelIsExecuting() ||
+             crucibleNativeEventPosition().ordinal != 0 || guest_fd != 1,
+             "Console ownership must be installed once before native events");
+    configuredPid = guest_pid;
+    configuredFd = guest_fd;
+    configured = true;
+}
+
+bool
+crucibleConsoleOwns(uint64_t guest_pid, int guest_fd)
+{
+    return configured && guest_pid == configuredPid && guest_fd == configuredFd;
+}
+
+int64_t
+crucibleCaptureConsoleWrite(uint64_t guest_pid, uint64_t context_id,
+                           int guest_fd, const void *bytes, size_t length)
+{
+    const auto birth = crucibleNativeEventPosition();
+    fatal_if(!crucibleConsoleOwns(guest_pid, guest_fd) || !birth.active,
+             "Console publication has no actual native event birth");
+    if (length == 0)
+        return 0;
+    fatal_if(length > MaximumPayload || retained.size() >= MaximumPublications ||
+             length > MaximumRetainedBytes - retainedBytes ||
+             nextOutputId == std::numeric_limits<uint64_t>::max(),
+             "Original native console publication credit exhausted");
+    CrucibleConsolePublication output;
+    output.outputId = nextOutputId;
+    output.tick = birth.tick;
+    output.eventOrdinal = birth.ordinal;
+    output.tickOrdinal = birth.tickOrdinal;
+    output.guestPid = guest_pid;
+    output.contextId = context_id;
+    output.guestFd = guest_fd;
+    output.causalParent = causalParent;
+    const auto *begin = static_cast<const uint8_t *>(bytes);
+    output.payload.assign(begin, begin + length);
+    retained.push_back(std::move(output));
+    ++nextOutputId;
+    retainedBytes += length;
+    return static_cast<int64_t>(length);
+}
+
+std::vector<CrucibleConsolePublication>
+crucibleConsolePublications()
+{
+    fatal_if(crucibleModelIsExecuting(),
+             "Native console inventory requires a stopped event boundary");
+    return std::vector<CrucibleConsolePublication>(retained.begin(), retained.end());
+}
+
+void
+crucibleAcknowledgeConsole(uint64_t original_output_id)
+{
+    fatal_if(crucibleModelIsExecuting() || original_output_id == 0,
+             "Native console ACK requires original stopped custody");
+    if (original_output_id <= acknowledgedThrough)
+        return;
+    fatal_if(retained.empty() || retained.front().outputId != original_output_id,
+             "Native console ACK does not match the original FIFO head");
+    retainedBytes -= retained.front().payload.size();
+    retained.pop_front();
+    acknowledgedThrough = original_output_id;
+}
+
+void
+crucibleSetConsoleParent(uint64_t original_parent)
+{
+    fatal_if(!configured || crucibleModelIsExecuting() || !retained.empty(),
+             "Native input parent may change only beneath stopped output custody");
+    causalParent = original_parent;
+}
+
+} // namespace gem5
