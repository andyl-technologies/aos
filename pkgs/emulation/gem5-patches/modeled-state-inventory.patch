+std::vector<CrucibleQueuedEvent>
+EventQueue::crucibleEventInventory()
+{
+    std::lock_guard<UncontendedMutex> service_lock(service_mutex);
+    std::lock_guard<UncontendedMutex> async_lock(async_queue_mutex);
+    if (!async_queue.empty()) {
+        throw std::runtime_error("pending asynchronous event insertion");
+    }
+
+    std::vector<CrucibleQueuedEvent> result;
+    for (Event *bin = head; bin; bin = bin->nextBin) {
+        for (Event *event = bin; event; event = event->nextInBin) {
+            if (result.size() >= 65536) {
+                throw std::runtime_error("native event inventory limit exceeded");
+            }
+#ifndef NDEBUG
+            result.push_back({std::to_string(event->instance), event->when(),
+                              event->priority(), unsigned(event->flags),
+                              typeid(*event).name(), event->description()});
+#else
+            // Fast builds lack stable native event identities. Never expose
+            // allocator addresses as public or canonical object references.
+            throw std::runtime_error("stable event identities are unavailable");
+#endif
+        }
+    }
+    return result;
 }
 
