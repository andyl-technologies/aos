+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Andyl, Inc.
+
+from m5.objects.Device import BasicPioDevice
+from m5.SimObject import SimObject
+from m5.params import Param
+from m5.util.pybind import PyBindMethod
+
+
+class AbsentFchResetStatus(BasicPioDevice):
+    """Declares an absent optional AMD FCH reset-status register.
+
+    A board without FCH returns the explicitly recognized error response.
+    No reset reason, write behavior or other chipset register is fabricated.
+    """
+    type = "AbsentFchResetStatus"
+    cxx_header = "dev/absent_fch_reset_status.hh"
+    cxx_class = "gem5::AbsentFchResetStatus"
+    pio_addr = 0xFED803C0
+
+
+class AbsentFchResetStatusWitness(SimObject):
+    """Exercises real native request/response bounds without guest admission."""
+    type = "AbsentFchResetStatusWitness"
+    cxx_header = "dev/absent_fch_reset_status.hh"
+    cxx_class = "gem5::AbsentFchResetStatusWitness"
+    cxx_exports = [PyBindMethod("run")]
+    device = Param.AbsentFchResetStatus("Actual native absent-register model")
