+#include "dev/absent_fch_reset_status.hh"
+
+#include <algorithm>
+#include <array>
+#include <limits>
+#include <memory>
+
+#include "base/logging.hh"
+#include "mem/packet.hh"
+#include "mem/packet_access.hh"
+#include "params/AbsentFchResetStatus.hh"
+#include "params/AbsentFchResetStatusWitness.hh"
+
+namespace gem5
+{
+
+AbsentFchResetStatus::AbsentFchResetStatus(
+    const AbsentFchResetStatusParams &params)
+    : BasicPioDevice(params, RegisterBytes)
+{
+    fatal_if(params.pio_addr != RegisterAddress,
+        "Optional absent FCH reset-status model has an immutable address");
+}
+
+Tick
+AbsentFchResetStatus::read(PacketPtr packet)
+{
+    const bool admitted = packet->isRead() &&
+        packet->getAddr() == RegisterAddress &&
+        packet->getSize() == RegisterBytes;
+    packet->makeAtomicResponse();
+    if (!admitted) {
+        packet->setBadAddress();
+        return pioDelay;
+    }
+
+    // Linux's AMD reset-status probe explicitly treats all bits set as the
+    // error response. This board has no FCH and therefore no reset state.
+    packet->setLE<uint32_t>(std::numeric_limits<uint32_t>::max());
+    return pioDelay;
+}
+
+Tick
+AbsentFchResetStatus::write(PacketPtr packet)
+{
+    // Absence cannot gain mutable reset-reason state through guest writes.
+    packet->makeAtomicResponse();
+    packet->setBadAddress();
+    return pioDelay;
+}
+
+AbsentFchResetStatusWitness::AbsentFchResetStatusWitness(
+    const AbsentFchResetStatusWitnessParams &params)
+    : SimObject(params), device(*params.device)
+{
+}
+
+unsigned
+AbsentFchResetStatusWitness::run()
+{
+    struct Case
+    {
+        Addr address;
+        unsigned size;
+        bool write;
+        bool accepted;
+    };
+    const std::array<Case, 10> cases{{
+        {AbsentFchResetStatus::RegisterAddress, 4, false, true},
+        {AbsentFchResetStatus::RegisterAddress, 1, false, false},
+        {AbsentFchResetStatus::RegisterAddress, 2, false, false},
+        {AbsentFchResetStatus::RegisterAddress, 8, false, false},
+        {AbsentFchResetStatus::RegisterAddress - 1, 4, false, false},
+        {AbsentFchResetStatus::RegisterAddress + 1, 4, false, false},
+        {std::numeric_limits<Addr>::max(), 4, false, false},
+        {AbsentFchResetStatus::RegisterAddress, 4, true, false},
+        {AbsentFchResetStatus::RegisterAddress, 1, true, false},
+        {AbsentFchResetStatus::RegisterAddress, 4, false, true},
+    }};
+
+    for (const Case &test : cases) {
+        auto request = std::make_shared<Request>(
+            test.address, test.size, Request::Flags(0), Request::funcRequestorId);
+        Packet packet(request, test.write ? MemCmd::WriteReq : MemCmd::ReadReq);
+        packet.allocate();
+        std::fill_n(packet.getPtr<uint8_t>(), test.size, uint8_t(0x55));
+        if (test.write)
+            device.write(&packet);
+        else
+            device.read(&packet);
+        panic_if(!packet.isResponse() || packet.isError() == test.accepted,
+            "Absent-register witness observed the wrong native response");
+        if (test.accepted) {
+            panic_if(packet.getLE<uint32_t>() != 0xffffffff,
+                "Absent-register witness fabricated a reset status");
+        } else {
+            panic_if(packet.cmd != MemCmd::BadAddressError,
+                "Absent-register witness accepted an invalid address/width/write");
+            for (unsigned index = 0; index < test.size; ++index)
+                panic_if(packet.getPtr<uint8_t>()[index] != 0x55,
+                    "Invalid optional-register request changed payload bytes");
+        }
+    }
+    return cases.size();
+}
+
+} // namespace gem5
