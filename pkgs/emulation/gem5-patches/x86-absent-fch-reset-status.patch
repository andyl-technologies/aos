+#ifndef __DEV_ABSENT_FCH_RESET_STATUS_HH__
+#define __DEV_ABSENT_FCH_RESET_STATUS_HH__
+
+#include "dev/io_device.hh"
+#include "sim/sim_object.hh"
+
+namespace gem5
+{
+
+struct AbsentFchResetStatusParams;
+struct AbsentFchResetStatusWitnessParams;
+
+/** Explicit absence response, not an implementation of AMD FCH hardware. */
+class AbsentFchResetStatus : public BasicPioDevice
+{
+  public:
+    static constexpr Addr RegisterAddress = 0xfed803c0;
+    static constexpr unsigned RegisterBytes = 4;
+
+    explicit AbsentFchResetStatus(const AbsentFchResetStatusParams &params);
+    Tick read(PacketPtr packet) override;
+    Tick write(PacketPtr packet) override;
+};
+
+/** Native Packet mechanism witness; it carries no capture authority. */
+class AbsentFchResetStatusWitness : public SimObject
+{
+  public:
+    explicit AbsentFchResetStatusWitness(
+        const AbsentFchResetStatusWitnessParams &params);
+    unsigned run();
+
+  private:
+    AbsentFchResetStatus &device;
+};
+
+} // namespace gem5
