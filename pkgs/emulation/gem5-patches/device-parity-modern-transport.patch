+unsigned
+PciVirtIO::modernAccessWidth(Addr offset, unsigned size) const
+{
+    switch (offset) {
+      case 0: case 4: case 8: case 12:
+        return 4;
+      case 16: case 18: case 22: case 24: case 26: case 28: case 30:
+      case MODERN_NOTIFY:
+        return 2;
+      case 20: case 21: case MODERN_ISR:
+        return 1;
+      case 32: case 40: case 48:
+        return size == 8 ? 8 : 4;
+      case 36: case 44: case 52:
+        return 4;
+      default:
+        return 0;
+    }
+}
+
+Tick
+PciVirtIO::readConfig(PacketPtr pkt)
+{
+    const unsigned offset = pkt->getAddr() & PCI_CONFIG_SIZE;
+    if (!modern || offset < 0x40)
+        return PciEndpoint::readConfig(pkt);
+
+    // Four vendor capabilities point to disjoint BAR1 regions. The notify
+    // multiplier is zero: every queue writes its index at the same port.
+    std::array<uint8_t, 0x84> caps{};
+    auto capability = [&](unsigned base, uint8_t next, uint8_t type,
+                          uint32_t region, uint32_t length, bool notify) {
+        caps[base] = 0x09;
+        caps[base + 1] = next;
+        caps[base + 2] = notify ? 20 : 16;
+        caps[base + 3] = type;
+        caps[base + 4] = 1;
+        for (unsigned byte = 0; byte < 4; ++byte) {
+            caps[base + 8 + byte] = region >> (8 * byte);
+            caps[base + 12 + byte] = length >> (8 * byte);
+        }
+    };
+    capability(0x40, 0x50, 1, 0, 56, false);
+    capability(0x50, 0x64, 2, MODERN_NOTIFY, 2, true);
+    capability(0x64, 0x74, 3, MODERN_ISR, 1, false);
+    capability(0x74, 0, 4, MODERN_DEVICE, vio.configSize, false);
+
+    const unsigned size = pkt->getSize();
+    panic_if(size != 1 && size != 2 && size != 4, "Invalid PCI config read");
+    uint32_t value = 0;
+    for (unsigned byte = 0; byte < size; ++byte) {
+        if (offset + byte < caps.size())
+            value |= uint32_t(caps[offset + byte]) << (8 * byte);
+    }
+    pkt->makeAtomicResponse();
+    if (size == 1) pkt->setLE<uint8_t>(value);
+    if (size == 2) pkt->setLE<uint16_t>(value);
+    if (size == 4) pkt->setLE<uint32_t>(value);
+    return configDelay;
+}
+
+Tick
+PciVirtIO::writeConfig(PacketPtr pkt)
+{
+    const unsigned offset = pkt->getAddr() & PCI_CONFIG_SIZE;
+    if (!modern || offset < 0x40)
+        return PciEndpoint::writeConfig(pkt);
+    pkt->makeAtomicResponse();
+    return configDelay;
+}
+
+Tick
+PciVirtIO::readModern(PacketPtr pkt, Addr offset)
+{
+    const unsigned size = pkt->getSize();
+    if (offset >= MODERN_DEVICE) {
+        vio.readConfig(pkt, offset - MODERN_DEVICE);
+        return 0;
+    }
+    panic_if(size != modernAccessWidth(offset, size),
+             "Invalid modern VirtIO PCI read width or offset");
+    uint64_t value = 0;
+    unsigned required = 0;
+    switch (offset) {
+      case 0: value = deviceFeatureSelect; required = 4; break;
+      case 4:
+        value = deviceFeatureSelect < 2 ?
+            vio.offeredFeatures(true) >> (deviceFeatureSelect * 32) : 0;
+        required = 4; break;
+      case 8: value = driverFeatureSelect; required = 4; break;
+      case 12:
+        value = driverFeatureSelect < 2 ?
+            vio.getGuestFeatures() >> (driverFeatureSelect * 32) : 0;
+        required = 4; break;
+      case 16: value = 0xffff; required = 2; break;
+      case 18: value = vio.getQueueCount(); required = 2; break;
+      case 20: value = vio.getDeviceStatus(); required = 1; break;
+      case 21: required = 1; break;
+      case 22: value = vio.getQueueSelect(); required = 2; break;
+      case 24: value = vio.getQueueSize(); required = 2; break;
+      case 26: value = 0xffff; required = 2; break;
+      case 28: value = vio.getQueueReady(); required = 2; break;
+      case 30: required = 2; break;
+      case 32: case 36: case 40: case 44: case 48: case 52: {
+          const unsigned area = (offset - 32) / 8;
+          const bool high = offset & 4;
+          value = vio.getModernQueueAddress(area) >> (high ? 32 : 0);
+          required = !high && size == 8 ? 8 : 4;
+          break;
+      }
+      case MODERN_ISR:
+        required = 1;
+        value = interruptDeliveryPending ? 1 : 0;
+        interruptDeliveryPending = false;
+        intrClear();
+        break;
+      default: panic("Invalid modern VirtIO PCI read at %#x", offset);
+    }
+    panic_if(size != required, "Invalid modern VirtIO PCI read width");
+    pkt->makeResponse();
+    if (size == 1) pkt->setLE<uint8_t>(value);
+    if (size == 2) pkt->setLE<uint16_t>(value);
+    if (size == 4) pkt->setLE<uint32_t>(value);
+    if (size == 8) pkt->setLE<uint64_t>(value);
+    return 0;
+}
+
+Tick
+PciVirtIO::writeModern(PacketPtr pkt, Addr offset)
+{
+    const unsigned size = pkt->getSize();
+    if (offset >= MODERN_DEVICE) {
+        vio.writeConfig(pkt, offset - MODERN_DEVICE);
+        return 0;
+    }
+    panic_if(size != modernAccessWidth(offset, size),
+             "Invalid modern VirtIO PCI write width or offset");
+    const uint64_t value = size == 1 ? pkt->getLE<uint8_t>() :
+        size == 2 ? pkt->getLE<uint16_t>() :
+        size == 4 ? pkt->getLE<uint32_t>() : pkt->getLE<uint64_t>();
+    unsigned required = 0;
+    switch (offset) {
+      case 0: deviceFeatureSelect = value; required = 4; break;
+      case 8: driverFeatureSelect = value; required = 4; break;
+      case 12:
+        vio.setGuestFeatureWord(driverFeatureSelect, value);
+        required = 4; break;
+      case 16: required = 2; break;
+      case 20:
+        vio.setDeviceStatus(value);
+        if (!value) {
+            deviceFeatureSelect = 0;
+            driverFeatureSelect = 0;
+            interruptDeliveryPending = false;
+            intrClear();
+        }
+        required = 1; break;
+      case 22: vio.setQueueSelect(value); required = 2; break;
+      case 24: vio.setQueueSize(value); required = 2; break;
+      case 26: required = 2; break;
+      case 28:
+        panic_if(value != 1, "Invalid PCI queue-enable value");
+        vio.setQueueReady(true);
+        required = 2; break;
+      case 32: case 36: case 40: case 44: case 48: case 52: {
+          const unsigned area = (offset - 32) / 8;
+          const bool high = offset & 4;
+          required = !high && size == 8 ? 8 : 4;
+          const Addr old = vio.getModernQueueAddress(area);
+          const Addr address = size == 8 ? value : high ?
+              (old & 0xffffffffULL) | (value << 32) :
+              (old & 0xffffffff00000000ULL) | value;
+          vio.setModernQueueAddress(area, address);
+          break;
+      }
+      case MODERN_NOTIFY:
+        vio.onNotify(value);
+        required = 2; break;
+      default: panic("Invalid modern VirtIO PCI write at %#x", offset);
+    }
+    panic_if(size != required, "Invalid modern VirtIO PCI write width");
+    pkt->makeResponse();
+    return 0;
+}
+
+void
+PciVirtIO::serialize(CheckpointOut &cp) const
+{
+    PciEndpoint::serialize(cp);
+    SERIALIZE_SCALAR(deviceFeatureSelect);
+    SERIALIZE_SCALAR(driverFeatureSelect);
+    SERIALIZE_SCALAR(queueNotify);
+    SERIALIZE_SCALAR(interruptDeliveryPending);
+}
+
+void
+PciVirtIO::unserialize(CheckpointIn &cp)
+{
+    PciEndpoint::unserialize(cp);
+    UNSERIALIZE_SCALAR(deviceFeatureSelect);
+    UNSERIALIZE_SCALAR(driverFeatureSelect);
+    UNSERIALIZE_SCALAR(queueNotify);
+    UNSERIALIZE_SCALAR(interruptDeliveryPending);
+    if (interruptDeliveryPending)
+        intrPost();
+    else
+        intrClear();
+}
