+void
+VirtIODeviceBase::setGuestFeatureWord(uint32_t select, uint32_t word)
+{
+    if (select > 1) {
+        panic_if(word, "Unimplemented VirtIO feature word");
+        return;
+    }
+    const unsigned shift = select * 32;
+    const FeatureBits mask = FeatureBits(0xffffffff) << shift;
+    const FeatureBits proposed =
+        (guestFeatures & ~mask) | (FeatureBits(word) << shift);
+    panic_if(_featuresFinalized && guestFeatures != proposed,
+             "Guest changed finalized VirtIO features without reset");
+    guestFeatures = proposed;
+}
