+Addr
+VirtIODeviceBase::getModernQueueAddress(unsigned area) const
+{
+    if (_queueSelect >= _queues.size())
+        return 0;
+    const VirtQueue &queue = getCurrentQueue();
+    switch (area) {
+      case 0: return queue.getAddress();
+      case 1: return queue.driverAddress();
+      case 2: return queue.deviceAddress();
+      default: panic("Invalid split ring area");
+    }
+}
