+}
+
+bool
+EventQueue::crucibleDiagnosticDirectQueueOwnership(
+    crucible::OriginalNodeScope &scope)
+{
+    // Reject inherited foreign custody before checking phase or touching the
+    // original queue. A direct original caller also cannot index an unbuilt
+    // System or manufacture a private ownership walk from diagnostic input.
+    if (!scope.current()) return false;
+    if (scope.phase != crucible::OriginalNodeScope::State::Walking)
+        return scope.refuse(crucible::OriginalNodeScope::Refusal::InvalidPhase);
+    return crucibleNativeClosure(scope);
+}
+
+bool
+EventQueue::crucibleNativeClosure(crucible::OriginalNodeScope &scope)
+{
+    // This helper is callable independently of the guarded scope walk. Reject
+    // foreign custody before touching inherited mutexes or native owner state.
+    if (!scope.current()) return false;
+
+    using Refusal = crucible::OriginalNodeScope::Refusal;
+    std::unique_lock<UncontendedMutex> service(service_mutex, std::try_to_lock);
+    if (!service.owns_lock()) return scope.refuse(Refusal::QueueOwnership);
+    std::unique_lock<UncontendedMutex> asynchronous(async_queue_mutex, std::try_to_lock);
+    if (!asynchronous.owns_lock()) return scope.refuse(Refusal::QueueOwnership);
+    if (!async_queue.empty()) return scope.refuse(Refusal::PendingAsync);
+
+    // Follow the actual constructor-registered system first. Native dependent
+    // objects (for example indexing tables born before their TLB) must be
+    // verified through the owning object's source edges, not registry order.
+    if (!scope.visit(System::systemList[0])) return false;
+    for (std::size_t index = 0; index < scope.objectsUsed; ++index) {
+        if (!scope.visit(scope.objects[index].object)) return false;
+    }
+    if (!scope.portsClosed()) return false;
+
+    // Preserve actual bin/stack order without sorting, draining or servicing
+    // callbacks. Duplicate links and unknown callbacks refuse the finite walk.
+    for (const Event *bin = head; bin; bin = bin->nextBin) {
+        for (const Event *event = bin; event; event = event->nextInBin) {
+            if (!event->initialized() || !event->scheduled() ||
+                event->when() < _curTick || !scope.queued(event))
+                return scope.refuse(Refusal::InvalidCallback);
+        }
+    }
+    for (std::size_t index = 0; index < scope.callbacksUsed; ++index) {
+        const auto &callback = scope.callbacks[index];
+        if (callback.event->scheduled() != callback.queued)
+            return scope.refuse(Refusal::InvalidCallback);
+    }
+    return true;
 }
 
