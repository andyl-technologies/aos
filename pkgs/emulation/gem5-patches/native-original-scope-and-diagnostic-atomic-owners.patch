+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026 Andyl, Inc.
+#ifndef GEM5_SIM_CRUCIBLE_NATIVE_CUT_HH
+#define GEM5_SIM_CRUCIBLE_NATIVE_CUT_HH
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace gem5::crucible
+{
+
+class ArmAtomicClosedScope;
+class SourceCheckpointIssuer;
+class EarlyRestoreAdopter;
+class OriginalCutAccount;
+
+using Digest = std::array<unsigned char, 32>;
+using ReadyBody = std::array<unsigned char, 344>;
+using ReadyAckBody = std::array<unsigned char, 128>;
+
+/** Correlations selected before the original native object graph is realized. */
+struct OriginalScopeBinding
+{
+    Digest scope{};
+    Digest setup{};
+    Digest profile{};
+    Digest implementation{};
+    Digest queuePlan{};
+    std::uint64_t nativeEpoch = 0;
+    std::uint64_t sourceProcessGeneration = 0;
+};
+
+/** An original source cut which cannot be reconstructed from a wire receipt.
+ *
+ * Only the concrete source verifier can seal its owning account. The token is
+ * tied to that exact account address and cut; a byte-identical unrelated
+ * account, parser result or diagnostic census cannot consume it.
+ */
+class NativeCutPermit
+{
+  public:
+    NativeCutPermit(const NativeCutPermit &) = delete;
+    NativeCutPermit &operator=(const NativeCutPermit &) = delete;
+    NativeCutPermit(NativeCutPermit &&) = delete;
+    NativeCutPermit &operator=(NativeCutPermit &&) = delete;
+
+  private:
+    friend class OriginalCutAccount;
+    NativeCutPermit() = default;
+
+    const OriginalCutAccount *owner = nullptr;
+    std::uint64_t cut = 0;
+    bool consumed = false;
+};
+
+/** A branch ordinal born in the original source account, before capture.
+ *
+ * This process-private token is not an on-disk authorization format. An
+ * opaque image's copy of this account is insufficient for fresh-process
+ * adoption: the adopter must retain authentic original issuer custody.
+ */
+class NativeBranchPermit
+{
+  public:
+    NativeBranchPermit(const NativeBranchPermit &) = delete;
+    NativeBranchPermit &operator=(const NativeBranchPermit &) = delete;
+    NativeBranchPermit(NativeBranchPermit &&) = delete;
+    NativeBranchPermit &operator=(NativeBranchPermit &&) = delete;
+
+  private:
+    friend class OriginalCutAccount;
+    NativeBranchPermit() = default;
+
+    const OriginalCutAccount *owner = nullptr;
+    std::uint64_t cut = 0;
+    std::uint64_t ordinal = 0;
+    bool consumed = false;
+};
+
+/** Retains one finite original source-cut and its two branch lifecycles.
+ *
+ * The account owns all permit, Ready, ACK, cursor and attempt storage from
+ * construction. It exposes no public sealing, issuance or adoption method.
+ * The friend owners must perform actual native graph/resource checks and
+ * full original final-account authentication before these private transitions.
+ * Those source implementations, not this component or its model controls,
+ * determine whether a production profile can issue execution authority.
+ */
+class OriginalCutAccount
+{
+  public:
+    static constexpr std::size_t BranchCount = 2;
+
+    enum class CutState : unsigned char {
+        Constructed, Walking, Refused, Sealed, Finalized
+    };
+
+    enum class BranchState : unsigned char {
+        Reserved, Issued, Adopting, Refused, Adopted, ReadyOffered,
+        AckRetained, Consumed, Retired
+    };
+
+    OriginalCutAccount(const OriginalScopeBinding &selected,
+                       std::uint64_t originalProcess,
+                       std::uint64_t originalUid)
+        : binding(selected), sourceProcess(originalProcess), sourceUid(originalUid)
+    {
+        cutPermit.owner = this;
+        for (std::size_t index = 0; index < BranchCount; ++index) {
+            branches[index].permit.owner = this;
+            branches[index].permit.ordinal = index + 1;
+        }
+    }
+
+    OriginalCutAccount(const OriginalCutAccount &) = delete;
+    OriginalCutAccount &operator=(const OriginalCutAccount &) = delete;
+    OriginalCutAccount(OriginalCutAccount &&) = delete;
+    OriginalCutAccount &operator=(OriginalCutAccount &&) = delete;
+
+    /** Reports the complete constructor-owned storage, including all banks. */
+    static constexpr std::size_t storageBytes() { return sizeof(OriginalCutAccount); }
+
+    /** Reads preservation data; it does not confer a source permit. */
+    const OriginalScopeBinding &originalBinding() const { return binding; }
+    CutState state() const { return cutState; }
+    std::uint64_t attempts() const { return cutAttempts; }
+    std::uint64_t originalPid() const { return sourceProcess; }
+    std::uint64_t originalUser() const { return sourceUid; }
+
+  private:
+    friend class ArmAtomicClosedScope;
+    friend class SourceCheckpointIssuer;
+    friend class EarlyRestoreAdopter;
+
+    struct BranchStorage
+    {
+        NativeBranchPermit permit;
+        BranchState state = BranchState::Reserved;
+        std::uint64_t attempts = 0;
+        std::uint64_t operativeProcess = 0;
+        std::uint64_t operativeUid = 0;
+        std::uint64_t operativeGeneration = 0;
+        ReadyBody ready{};
+        ReadyAckBody offeredAck{};
+        ReadyAckBody consumedAck{};
+        std::size_t readyWritten = 0;
+        std::size_t offeredAckRead = 0;
+        std::size_t consumedAckWritten = 0;
+    };
+
+    static bool nonzero(const Digest &digest)
+    {
+        unsigned char value = 0;
+        for (const auto byte : digest) value |= byte;
+        return value != 0;
+    }
+
+    bool selectedBinding() const
+    {
+        return nonzero(binding.scope) && nonzero(binding.setup) &&
+            nonzero(binding.profile) && nonzero(binding.implementation) &&
+            nonzero(binding.queuePlan) && binding.nativeEpoch &&
+            binding.sourceProcessGeneration && sourceProcess;
+    }
+
+    bool beginWalk(std::uint64_t actualProcess, std::uint64_t actualUid,
+                   std::uint64_t actualGeneration, std::uint64_t barrier)
+    {
+        if (cutState != CutState::Constructed) return false;
+
+        // Charge the one source attempt before any potentially failing check.
+        ++cutAttempts;
+        cutState = CutState::Refused;
+        if (!selectedBinding() || actualProcess != sourceProcess ||
+            actualUid != sourceUid ||
+            actualGeneration != binding.sourceProcessGeneration || !barrier)
+            return false;
+
+        barrierGeneration = barrier;
+        cutState = CutState::Walking;
+        return true;
+    }
+
+    const NativeCutPermit *finishWalk(const Digest &actualClosure,
+                                     std::uint64_t actualObjects,
+                                     std::uint64_t actualEdges,
+                                     std::uint64_t actualTick)
+    {
+        if (cutState != CutState::Walking) return nullptr;
+        cutState = CutState::Refused;
+        if (!nonzero(actualClosure) || !actualObjects) return nullptr;
+
+        closure = actualClosure;
+        objects = actualObjects;
+        edges = actualEdges;
+        stoppedTick = actualTick;
+        cutPermit.cut = 1;
+        cutState = CutState::Sealed;
+        return &cutPermit;
+    }
+
+    bool owns(const NativeCutPermit &permit) const
+    {
+        return &permit == &cutPermit && permit.owner == this &&
+            permit.cut == 1 && !permit.consumed && cutState == CutState::Sealed;
+    }
+
+    bool finalize(const NativeCutPermit &permit, const Digest &originalPrefix,
+                  const Digest &fullFinalAccount, const Digest &fullImage,
+                  const Digest &originalFinalDelivery)
+    {
+        if (!owns(permit)) return false;
+
+        // Failure consumes the genuine original cut too; there is no retry
+        // which substitutes another final body or recreates writer credit.
+        cutPermit.consumed = true;
+        cutState = CutState::Refused;
+        if (!nonzero(originalPrefix) || !nonzero(fullFinalAccount) ||
+            !nonzero(fullImage) || !nonzero(originalFinalDelivery))
+            return false;
+
+        prefix = originalPrefix;
+        finalAccount = fullFinalAccount;
+        image = fullImage;
+        finalDelivery = originalFinalDelivery;
+        cutState = CutState::Finalized;
+        return true;
+    }
+
+    NativeBranchPermit *issue(std::size_t index)
+    {
+        if (cutState != CutState::Finalized || index >= BranchCount) return nullptr;
+        auto &branch = branches[index];
+        if (branch.state != BranchState::Reserved) return nullptr;
+
+        branch.permit.cut = cutPermit.cut;
+        branch.state = BranchState::Issued;
+        return &branch.permit;
+    }
+
+    BranchStorage *beginAdoption(NativeBranchPermit &permit)
+    {
+        if (cutState != CutState::Finalized || permit.owner != this ||
+            permit.ordinal == 0 || permit.ordinal > BranchCount ||
+            permit.cut != cutPermit.cut || permit.consumed)
+            return nullptr;
+        auto &branch = branches[permit.ordinal - 1];
+        if (&permit != &branch.permit || branch.state != BranchState::Issued)
+            return nullptr;
+
+        permit.consumed = true;
+        ++branch.attempts;
+        branch.state = BranchState::Adopting;
+        return &branch;
+    }
+
+    bool bindOperative(BranchStorage &branch, std::uint64_t actualProcess,
+                       std::uint64_t actualUid, std::uint64_t actualGeneration)
+    {
+        // An Adopting label alone cannot borrow a different account's slot.
+        // Check the exact constructor-born member before any state mutation.
+        bool owned = false;
+        for (std::size_t index = 0; index < BranchCount; ++index) {
+            if (&branch == &branches[index]) {
+                owned = branch.permit.owner == this &&
+                    branch.permit.ordinal == index + 1 &&
+                    branch.permit.cut == cutPermit.cut && branch.permit.consumed;
+                break;
+            }
+        }
+        if (!owned || branch.state != BranchState::Adopting) return false;
+        branch.state = BranchState::Refused;
+        if (!actualProcess || actualProcess == sourceProcess ||
+            actualUid != sourceUid || !actualGeneration)
+            return false;
+        for (const auto &other : branches) {
+            if (&other != &branch && other.operativeProcess == actualProcess)
+                return false;
+        }
+
+        branch.operativeProcess = actualProcess;
+        branch.operativeUid = actualUid;
+        branch.operativeGeneration = actualGeneration;
+        branch.state = BranchState::Adopted;
+        return true;
+    }
+
+    const OriginalScopeBinding binding;
+    const std::uint64_t sourceProcess;
+    const std::uint64_t sourceUid;
+    CutState cutState = CutState::Constructed;
+    std::uint64_t cutAttempts = 0;
+    std::uint64_t barrierGeneration = 0;
+    std::uint64_t stoppedTick = 0;
+    std::uint64_t objects = 0;
+    std::uint64_t edges = 0;
+    Digest closure{};
+    Digest prefix{};
+    Digest finalAccount{};
+    Digest image{};
+    Digest finalDelivery{};
+    NativeCutPermit cutPermit;
+    std::array<BranchStorage, BranchCount> branches;
+};
+
+} // namespace gem5::crucible
