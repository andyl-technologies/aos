+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026 Andyl, Inc.
+#include "dev/virtio/crucible_closed_script_block.hh"
+
+#include <algorithm>
+#include <limits>
+
+#include "base/logging.hh"
+#include "sim/crucible_native_scope.hh"
+#include "sim/system.hh"
+
+namespace gem5
+{
+
+CrucibleClosedScriptBlock::CrucibleClosedScriptBlock(const Params &parameters)
+    : VirtIOHostRequest(parameters), requestEvent(*this), reactionEvent(*this),
+      retirementEvent(*this), reactionDelay(parameters.reaction_delay)
+{
+    fatal_if(!block || requestCapacity != 1 || maximumPayloadBytes != 512 ||
+        capacitySectors != 8 || parameters.queue_size != 2 || !reactionDelay ||
+        reactionDelay == MaxTick,
+        "closed script block requires its exact private native geometry");
+    fatal_if(!bindRequestHandler(&requestEvent), "original native request handler bind failed");
+    registerKickCallback(InterruptDelivery{this});
+}
+
+void
+CrucibleClosedScriptBlock::RequestEvent::process()
+{
+    owner.received();
+}
+
+void
+CrucibleClosedScriptBlock::ReactionEvent::process()
+{
+    owner.react();
+}
+
+void
+CrucibleClosedScriptBlock::InterruptDelivery::operator()() const
+{
+    panic_if(!owner || owner->interruptsDelivered == UINT64_MAX,
+             "native block interrupt lifetime exceeded");
+    ++owner->interruptsDelivered;
+    panic_if(owner->retirementEvent.scheduled(), "native block retirement overlaps");
+    owner->schedule(owner->retirementEvent, curTick());
+}
+
+void
+CrucibleClosedScriptBlock::RetirementEvent::process()
+{
+    owner.retire();
+}
+
+void
+CrucibleClosedScriptBlock::retire()
+{
+    panic_if(requests.size() != 1 || !requests.front().completed ||
+        !requests.front().acknowledged || pendingRequest,
+        "native script retirement lacks the original completed request");
+    panic_if(!retireCompleted(requests.front().id), "native request retirement failed");
+}
+
+void
+CrucibleClosedScriptBlock::received()
+{
+    panic_if(pendingRequest || reactionEvent.scheduled() || requests.size() != 1,
+             "native script received an overlapping block reaction");
+    const auto &request = requests.front();
+    panic_if(request.completed || request.replyStaged || request.acknowledged ||
+        curTick() > MaxTick - reactionDelay - 1,
+        "native script request ownership/tick extent changed");
+    panic_if(!acknowledgeRequest(request.id), "native request acknowledgement failed");
+    pendingRequest = request.id;
+    schedule(reactionEvent, curTick() + reactionDelay);
+}
+
+void
+CrucibleClosedScriptBlock::react()
+{
+    panic_if(!pendingRequest || reactionAttempts == UINT64_MAX || requests.size() != 1,
+             "native script reaction lacks its original request");
+    ++reactionAttempts;
+    const auto &request = requests.front();
+    panic_if(request.id != pendingRequest || !request.acknowledged || request.completed ||
+        request.replyStaged || request.sector > capacitySectors ||
+        request.payloadBytes > maximumPayloadBytes || request.payloadBytes % 512 ||
+        request.payloadBytes / 512 > capacitySectors - request.sector,
+        "native script reaction request changed");
+
+    const auto offset = std::size_t(request.sector) * 512;
+    std::vector<std::uint8_t> reply;
+    if (request.opcode == 0) {
+        reply.assign(disk.begin() + offset, disk.begin() + offset + request.payloadBytes);
+    } else if (request.opcode == 1) {
+        panic_if(request.bytes.size() != request.payloadBytes,
+                 "native script write payload extent changed");
+        std::copy(request.bytes.begin(), request.bytes.end(), disk.begin() + offset);
+    } else {
+        panic_if(request.opcode != 4 || request.payloadBytes,
+                 "native script received an unsupported block command");
+    }
+    panic_if(!stageReply(request.id, curTick(), request.parent, 0, reply),
+             "native script reply staging failed");
+    pendingRequest = 0;
+}
+
+bool
+CrucibleClosedScriptBlock::crucibleNativeClosure(crucible::NativeClosureWalk &walk) const
+{
+    const auto &parameters = params();
+    const auto *interrupt = transKick.target<InterruptDelivery>();
+    if (!parameters.system || &memory != &parameters.system->physProxy ||
+        !block || requestCapacity != 1 || maximumPayloadBytes != 512 || capacitySectors != 8 ||
+        _queues.size() != 1 || _queues[0] != &queue || _queueSelect != 0 ||
+        requestHandler != &requestEvent || !requestEvent.ownedBy(this) ||
+        requestEvent.scheduled() || !reactionEvent.ownedBy(this) ||
+        !retirementEvent.ownedBy(this) ||
+        !interrupt || interrupt->owner != this || reactionDelay != 9 ||
+        requests.size() > requestCapacity ||
+        !queue.crucibleNativeOwnedBy(this) ||
+        !replyEvent.crucibleNativeOwnedBy(this, OwnerEvent::Action::First) ||
+        !creditEvent.crucibleNativeOwnedBy(this, OwnerEvent::Action::Second))
+        return false;
+
+    const auto ranges = parameters.system->getPhysMem().getConfAddrRanges();
+    if (ranges.size() != 1 || !queue.crucibleNativeOwnership(memory, ranges.front()))
+        return false;
+    const auto spanOwned = [&](Addr start, std::uint64_t bytes) {
+        return !bytes || (start >= ranges.front().start() &&
+            start <= ranges.front().end() &&
+            bytes - 1 <= ranges.front().end() - start);
+    };
+    for (const auto &request : requests) {
+        if (!request.id || request.id >= nextRequest || request.id <= retiredThrough ||
+            request.head >= queue.getSize() ||
+            request.queueIncarnation != queue.incarnation() ||
+            request.payloadBytes > maximumPayloadBytes ||
+            request.bytes.size() > maximumPayloadBytes ||
+            request.reply.size() > maximumPayloadBytes ||
+            request.writable.empty() || request.writable.size() > queue.getSize() ||
+            request.birthTick > curTick() ||
+            (request.completed && request.completionTick > curTick()) ||
+            (request.replyStaged && !request.acknowledged))
+            return false;
+
+        std::uint64_t writableBytes = 0;
+        for (const auto &span : request.writable) {
+            if (!spanOwned(span.address, span.length) ||
+                span.length > maximumPayloadBytes + 1 ||
+                writableBytes > maximumPayloadBytes + 1 - span.length)
+                return false;
+            writableBytes += span.length;
+        }
+        if (!writableBytes || request.writtenBytes > writableBytes) return false;
+    }
+    if (pendingRequest) {
+        if (requests.size() != 1 || requests.front().id != pendingRequest ||
+            !requests.front().acknowledged || requests.front().completed ||
+            requests.front().replyStaged || !reactionEvent.scheduled())
+            return false;
+    } else if (reactionEvent.scheduled()) {
+        return false;
+    }
+    if (retirementEvent.scheduled() && (requests.size() != 1 ||
+        !requests.front().completed || !requests.front().acknowledged || pendingRequest))
+        return false;
+    return walk.object(this, parameters.system, 1) &&
+        walk.callback(this, &requestEvent, 2) &&
+        walk.callback(this, &reactionEvent, 3) &&
+        walk.callback(this, &replyEvent, 4) &&
+        walk.callback(this, &creditEvent, 5) &&
+        walk.callback(this, &retirementEvent, 6);
+}
+
+} // namespace gem5
