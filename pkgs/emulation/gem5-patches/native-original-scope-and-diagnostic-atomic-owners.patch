+#define GEM5_SIM_CRUCIBLE_NATIVE_SCOPE_HH
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+#include "sim/crucible_kernel_process.hh"
+#include "sim/crucible_native_cut.hh"
+
+namespace gem5
+{
+
+class SimObject;
+class Event;
+class EventQueue;
+class Port;
+class ReplaceableEntry;
+class StaticInst;
+class PCStateBase;
+
+namespace crucible
+{
+
+class OriginalNodeScope;
+
+/** Visits actual source-owned objects and callbacks in one original scope.
+ *
+ * This visitor contains private native pointers. It never crosses a process
+ * boundary, supplies a public protocol layout or describes a serialized CPU.
+ * The complete process image preserves private fields; this walk checks their
+ * ownership and the source-controlled entry points which may affect them.
+ */
+class NativeClosureWalk
+{
+  public:
+    /** Checks an actual object edge, including cycles and shared children. */
+    bool object(const SimObject *owner, const SimObject *target,
+                std::uint32_t member);
+
+    /** Registers an exact callback member, rather than an event type name. */
+    bool callback(const SimObject *owner, const Event *event,
+                  std::uint32_t member);
+
+    /** Registers the original native port member for reciprocal edge checks. */
+    bool port(const SimObject *owner, const Port *port, std::uint32_t member);
+
+    /** Binds actual entry members before visiting their native indexing owner. */
+    bool tableEntry(const SimObject *owner, const SimObject *index,
+                    const ReplaceableEntry *entry);
+
+    /** Checks a native indexing slot against the original table member bank. */
+    bool indexedEntry(const SimObject *index, const ReplaceableEntry *entry);
+
+  private:
+    friend class OriginalNodeScope;
+    explicit NativeClosureWalk(OriginalNodeScope &original) : scope(original) {}
+
+    OriginalNodeScope &scope;
+};
+
+/** Owns constructor-born object identities and one finite closure walk.
+ *
+ * Selection and construction grant no cut permit. Every actual object must
+ * run its concrete source visitor, and every queued callback must match an
+ * original owner's exact member. Unknown objects, overflow, destruction,
+ * asynchronous work and changed kernel custody refuse this scope permanently.
+ * SourceCheckpointIssuer must additionally authenticate process resources,
+ * the complete image and final account/delivery before issuing branch permits.
+ */
+class OriginalNodeScope
+{
+  public:
+    static constexpr std::size_t ObjectCapacity = 256;
+    static constexpr std::size_t EdgeCapacity = 4096;
+    static constexpr std::size_t CallbackCapacity = 256;
+    static constexpr std::size_t PortCapacity = 256;
+    static constexpr std::size_t TableCapacity = 16;
+    static constexpr std::size_t TableEntryCapacity = 1024;
+
+    enum class State : unsigned char { Constructing, Walking, Refused, Walked };
+    enum class Refusal : unsigned char {
+        None, ForeignProcess, ObjectCapacity, ObjectDestroyed, DuplicateBirth,
+        UnknownObject, UnknownVisitor, EdgeCapacity, InvalidEdge,
+        CallbackCapacity, InvalidCallback, QueueOwnership, PendingAsync,
+        MissingCallback, ChangedTick, InvalidPhase, PortCapacity,
+        InvalidPort, MissingPeer, InvalidTable, TableCapacity, TableEntryCapacity
+    };
+
+    /** Selects original native storage before any SimObject is constructed.
+     *
+     * The lifetime reservation is consumed before validation. Failed selection
+     * cannot renew storage or create another original scope in this process.
+     */
+    static bool select(const OriginalScopeBinding &binding);
+
+    /** Returns the exact narrow diagnostic profile correlation. */
+    static const Digest &diagnosticProfile();
+
+    /** Runs the original source ownership walk without granting authority.
+     *
+     * The one attempt is retained even on refusal. This diagnostic reports
+     * native graph ownership only; runtime, resources, image/final delivery,
+     * source issuance and early restore adoption remain separate gates.
+     */
+    bool inspectOriginalOwnership(EventQueue &queue);
+    static OriginalNodeScope *selected();
+    static std::size_t storageBytes();
+
+    /** Records births directly from the original SimObject constructor. */
+    void born(const SimObject *object);
+    void destroyed(const SimObject *object);
+
+    /** Enforces the selected fixed ARM loop before a guest instruction effect.
+     *
+     * Runtime authority starts absent. Only the concrete original constructor
+     * gate or authenticated early adopter can install it after complete native
+     * checks. An ownership-only walk or parsed receipt cannot enable execution.
+     */
+    void beforeInstruction(const StaticInst *instruction, const PCStateBase &pc);
+
+    State state() const { return phase; }
+    Refusal refusal() const { return reason; }
+    std::size_t objectCount() const { return objectsUsed; }
+    std::size_t edgeCount() const { return edgesUsed; }
+    std::size_t callbackCount() const { return callbacksUsed; }
+
+    OriginalNodeScope(const OriginalNodeScope &) = delete;
+    OriginalNodeScope &operator=(const OriginalNodeScope &) = delete;
+    OriginalNodeScope(OriginalNodeScope &&) = delete;
+    OriginalNodeScope &operator=(OriginalNodeScope &&) = delete;
+
+  private:
+    friend class NativeClosureWalk;
+    friend class ArmAtomicClosedScope;
+    friend class SourceCheckpointIssuer;
+    friend class EarlyRestoreAdopter;
+    friend class ::gem5::EventQueue;
+
+    enum class Visit : unsigned char { Unvisited, Visiting, Complete };
+
+    struct ObjectBirth
+    {
+        const SimObject *object = nullptr;
+        Visit visit = Visit::Unvisited;
+    };
+
+    struct ObjectEdge
+    {
+        std::uint32_t owner = 0;
+        std::uint32_t target = 0;
+        std::uint32_t member = 0;
+    };
+
+    struct CallbackOwner
+    {
+        const Event *event = nullptr;
+        std::uint32_t owner = 0;
+        std::uint32_t member = 0;
+        bool queued = false;
+    };
+
+    struct PortOwner
+    {
+        const Port *port = nullptr;
+        std::uint32_t owner = 0;
+        std::uint32_t member = 0;
+    };
+
+    struct TableEntry
+    {
+        const ReplaceableEntry *entry = nullptr;
+        bool indexed = false;
+    };
+
+    struct TableOwner
+    {
