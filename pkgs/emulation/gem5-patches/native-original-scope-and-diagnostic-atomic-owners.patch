+
+namespace
+{
+
+// The storage and dispatcher outlive OpenSSL/provider and SimObject cleanup.
+// The reservation is never reset, including selection failure or source-gone
+// restore. It is process-private state, not a reusable allocation cache.
+struct ProcessLifetimeScope
+{
+    alignas(OriginalNodeScope) unsigned char storage[sizeof(OriginalNodeScope)];
+    OriginalNodeScope *active = nullptr;
+    bool reserved = false;
+};
+
+ProcessLifetimeScope lifetime;
+
+const Digest diagnosticProfileDigest = {0xcb, 0xf0, 0xf2, 0x00, 0xd6, 0x9a, 0x5c, 0xcc, 0x39, 0x5f, 0x7c, 0xbc, 0x36, 0x7d, 0xe0, 0xbb, 0x2d, 0xf3, 0x03, 0x9c, 0x34, 0xcc, 0x17, 0x7c, 0x1c, 0x39, 0x77, 0xca, 0x67, 0x68, 0xe3, 0x70};
+
+bool
+nonzero(const Digest &bytes)
+{
+    unsigned char value = 0;
+    for (const auto byte : bytes) value |= byte;
+    return value != 0;
+}
+
+} // anonymous namespace
+
+OriginalNodeScope::OriginalNodeScope(const OriginalScopeBinding &binding,
+                                     const KernelProcessObservation &process)
+    : originalProcess(process), account(binding, process.process, process.uid),
+      visitor(*this)
+{
+}
+
+bool
+OriginalNodeScope::select(const OriginalScopeBinding &binding)
+{
+    using kernel_process_detail::rawCall;
+    const long process = rawCall(SYS_getpid);
+    if (process <= 0 || rawCall(SYS_gettid) != process) return false;
+    if (lifetime.reserved) return false;
+    lifetime.reserved = true;
+
+    KernelProcessObservation actual;
+    if (!SimObject::simObjectList.empty() || !observeKernelProcess(actual) ||
+        actual.process != std::uint64_t(process) ||
+        actual.startTicks != binding.sourceProcessGeneration ||
+        !binding.nativeEpoch || !nonzero(binding.scope) ||
+        !nonzero(binding.setup) || !nonzero(binding.profile) ||
+        !nonzero(binding.implementation) || !nonzero(binding.queuePlan) ||
+        binding.profile != diagnosticProfileDigest)
+        return false;
+
+    lifetime.active = new (lifetime.storage) OriginalNodeScope(binding, actual);
+    return true;
+}
+
+const Digest &
+OriginalNodeScope::diagnosticProfile()
+{
+    return diagnosticProfileDigest;
+}
+
+bool
+OriginalNodeScope::inspectOriginalOwnership(EventQueue &queue)
+{
+    // Diagnostic ownership inspection cannot install runtime authority or
+    // seal the original account. The authentic source provider owns those
+    // distinct graph/resource/account/image transitions.
+    return walk(queue);
+}
+
+OriginalNodeScope *
+OriginalNodeScope::selected()
+{
+    return lifetime.active;
+}
+
+std::size_t
+OriginalNodeScope::storageBytes()
+{
+    return sizeof(lifetime);
+}
+
+bool
+OriginalNodeScope::refuse(Refusal failure)
+{
+    // Retain the first causal failure. Neither a later successful observation
+    // nor a fresh public description can restore the original walk attempt.
+    if (phase != State::Refused) reason = failure;
+    phase = State::Refused;
+    return false;
+}
+
+bool
+OriginalNodeScope::current()
+{
+    using kernel_process_detail::rawCall;
+    const auto expectedProcess = operativeProcess.process
+        ? operativeProcess.process : originalProcess.process;
+    if (rawCall(SYS_getpid) != long(expectedProcess) ||
+        rawCall(SYS_gettid) != long(expectedProcess) ||
+        rawCall(SYS_geteuid) != long(originalProcess.uid)) {
+        // The source records belong to the original main thread. A foreign
+        // caller cannot mutate them, enter inherited allocator/logger locks or
+        // return into an unverified callback. Outer custody retains exit125 as
+        // terminal/uncertain; this is not a NoEffects or state-preservation claim.
+        rawCall(SYS_exit_group, 125);
+        __builtin_unreachable();
+    }
+    return phase != State::Refused;
+}
+
+void
+OriginalNodeScope::beforeInstruction(const StaticInst *instruction, const PCStateBase &pc)
+{
+    using kernel_process_detail::rawCall;
+    const bool authorized = current() && runtimeAuthorized && instruction &&
+        !instruction->isSyscall() && !instruction->isPseudo() &&
+        !instruction->isInvalid() && !instruction->isMacroop() &&
+        !instruction->isMicroop();
+    bool fixedLoop = false;
+    if (authorized) {
+        const auto encoded = instruction->getEMI();
+        const auto opcode = std::uint32_t(encoded);
+        // ARM's source decoder records AArch64 at bit34. Fault, illegal,
+        // software-step and Thumb metadata cannot select another execution
+        // path for these two exact source-profile instructions.
+        const bool mode = (encoded & (UINT64_C(1) << 34)) &&
+            !(encoded & ((UINT64_C(15) << 60) | (UINT64_C(3) << 35)));
+        fixedLoop = mode &&
+            ((pc.instAddr() == 0x10000 && opcode == 0xD503201F) ||
+             (pc.instAddr() == 0x10004 && opcode == 0x17FFFFFF));
+    }
+    if (!fixedLoop) {
+        refuse(Refusal::InvalidPhase);
+        // Returning through guest syscall/fault helpers would enter host
+        // effects outside this narrow source profile. Preserve outer actor
+        // custody as terminal/uncertain; do not label the failed step NoEffects.
+        rawCall(SYS_exit_group, 126);
+        __builtin_unreachable();
+    }
+}
+
+std::size_t
+OriginalNodeScope::ordinal(const SimObject *object) const
+{
+    for (std::size_t index = 0; index < objectsUsed; ++index) {
+        if (objects[index].object == object) return index;
+    }
+    return ObjectCapacity;
+}
+
+void
+OriginalNodeScope::born(const SimObject *object)
+{
+    if (!current()) return;
+    if (phase != State::Constructing || !object) {
+        refuse(Refusal::InvalidPhase);
+        return;
+    }
+    if (ordinal(object) != ObjectCapacity) {
+        refuse(Refusal::DuplicateBirth);
+        return;
+    }
+    if (objectsUsed == ObjectCapacity) {
+        refuse(Refusal::ObjectCapacity);
+        return;
+    }
+    objects[objectsUsed++].object = object;
+}
+
+void
+OriginalNodeScope::destroyed(const SimObject *object)
+{
+    if (!current()) return;
+    if (ordinal(object) != ObjectCapacity) refuse(Refusal::ObjectDestroyed);
+}
+
+bool
+OriginalNodeScope::visit(const SimObject *object)
+{
+    if (!current() || phase != State::Walking) return false;
+    const auto index = ordinal(object);
+    if (index == ObjectCapacity) return refuse(Refusal::UnknownObject);
+    auto &birth = objects[index];
+    if (birth.visit != Visit::Unvisited) return true;
+
+    birth.visit = Visit::Visiting;
+    const auto *previous = visiting;
+    visiting = object;
+    const bool complete = object->probeManager &&
+        object->probeManager->crucibleNativeListenersAbsent() &&
+        object->crucibleNativeClosure(visitor);
+    visiting = previous;
+    if (!complete || phase != State::Walking || !tablesComplete(object))
+        return refuse(Refusal::UnknownVisitor);
+    birth.visit = Visit::Complete;
+    return true;
+}
+
+bool
+OriginalNodeScope::objectEdge(const SimObject *owner, const SimObject *target,
+                              std::uint32_t member)
+{
+    if (!current() || phase != State::Walking) return false;
+    const auto ownerIndex = ordinal(owner);
+    const auto targetIndex = ordinal(target);
+    if (owner != visiting || ownerIndex == ObjectCapacity ||
+        targetIndex == ObjectCapacity || !member)
+        return refuse(Refusal::InvalidEdge);
+    if (edgesUsed == EdgeCapacity) return refuse(Refusal::EdgeCapacity);
+
+    edges[edgesUsed++] = {std::uint32_t(ownerIndex + 1),
+                         std::uint32_t(targetIndex + 1), member};
+    return visit(target);
+}
+
+bool
+OriginalNodeScope::callbackOwner(const SimObject *owner, const Event *event,
+                                 std::uint32_t member)
+{
+    if (!current() || phase != State::Walking) return false;
+    const auto ownerIndex = ordinal(owner);
+    if (owner != visiting || ownerIndex == ObjectCapacity || !event || !member)
+        return refuse(Refusal::InvalidCallback);
+
+    for (std::size_t index = 0; index < callbacksUsed; ++index) {
+        if (callbacks[index].event == event)
+            return refuse(Refusal::InvalidCallback);
+    }
+    if (callbacksUsed == CallbackCapacity) return refuse(Refusal::CallbackCapacity);
+    callbacks[callbacksUsed++] = {event, std::uint32_t(ownerIndex + 1), member, false};
+    return true;
+}
+
+bool
+OriginalNodeScope::queued(const Event *event)
+{
+    if (phase != State::Walking || !event) return false;
+    for (std::size_t index = 0; index < callbacksUsed; ++index) {
+        auto &callback = callbacks[index];
+        if (callback.event != event) continue;
+        if (callback.queued) return refuse(Refusal::InvalidCallback);
+        callback.queued = true;
+        return true;
+    }
+    return refuse(Refusal::MissingCallback);
+}
+
+bool
+OriginalNodeScope::portOwner(const SimObject *owner, const Port *port,
+                             std::uint32_t member)
+{
+    if (!current() || phase != State::Walking) return false;
+    const auto ownerIndex = ordinal(owner);
+    if (owner != visiting || ownerIndex == ObjectCapacity || !port || !member)
+        return refuse(Refusal::InvalidPort);
+    for (std::size_t index = 0; index < portsUsed; ++index) {
+        if (ports[index].port == port) return refuse(Refusal::InvalidPort);
+    }
+    if (portsUsed == PortCapacity) return refuse(Refusal::PortCapacity);
+    ports[portsUsed++] = {port, std::uint32_t(ownerIndex + 1), member};
+    return true;
+}
+
+bool
+OriginalNodeScope::portsClosed()
+{
+    for (std::size_t index = 0; index < portsUsed; ++index) {
+        const auto *port = ports[index].port;
+        if (!port->_connected) {
+            if (port->_peer) return refuse(Refusal::InvalidPort);
+            continue;
+        }
+        bool owned = false;
+        for (std::size_t peer = 0; peer < portsUsed; ++peer) {
+            if (ports[peer].port == port->_peer) {
+                owned = true;
+                break;
+            }
+        }
+        if (!owned) return refuse(Refusal::MissingPeer);
+        if (!port->_peer->_connected || port->_peer->_peer != port)
+            return refuse(Refusal::InvalidPort);
+    }
+    return true;
+}
+
+bool
+OriginalNodeScope::tableEntry(const SimObject *owner, const SimObject *index,
+                              const ReplaceableEntry *entry)
+{
+    if (!current() || phase != State::Walking) return false;
+    if (visiting != owner || ordinal(owner) == ObjectCapacity ||
+        ordinal(index) == ObjectCapacity || !entry)
+        return refuse(Refusal::InvalidTable);
+
+    TableOwner *table = nullptr;
+    for (std::size_t slot = 0; slot < tablesUsed; ++slot) {
+        if (tables[slot].index != index) continue;
+        if (tables[slot].owner != owner) return refuse(Refusal::InvalidTable);
+        table = &tables[slot];
+        break;
+    }
+    if (!table) {
+        if (tablesUsed == TableCapacity) return refuse(Refusal::TableCapacity);
+        table = &tables[tablesUsed++];
+        table->owner = owner;
+        table->index = index;
+    }
+    for (std::size_t slot = 0; slot < table->used; ++slot) {
+        if (table->entries[slot].entry == entry) return refuse(Refusal::InvalidTable);
+    }
+    if (table->used == TableEntryCapacity)
+        return refuse(Refusal::TableEntryCapacity);
+    table->entries[table->used++].entry = entry;
+    return true;
+}
+
+bool
+OriginalNodeScope::indexedEntry(const SimObject *index, const ReplaceableEntry *entry)
+{
+    if (!current() || phase != State::Walking) return false;
+    if (visiting != index || !entry) return refuse(Refusal::InvalidTable);
+    for (std::size_t slot = 0; slot < tablesUsed; ++slot) {
+        auto &table = tables[slot];
+        if (table.index != index) continue;
+        for (std::size_t offset = 0; offset < table.used; ++offset) {
+            auto &original = table.entries[offset];
+            if (original.entry != entry) continue;
+            if (original.indexed) return refuse(Refusal::InvalidTable);
+            original.indexed = true;
+            return true;
+        }
+        return refuse(Refusal::InvalidTable);
+    }
+    return refuse(Refusal::InvalidTable);
+}
+
+bool
+OriginalNodeScope::tablesComplete(const SimObject *index)
+{
+    for (std::size_t slot = 0; slot < tablesUsed; ++slot) {
+        const auto &table = tables[slot];
+        if (table.index != index) continue;
+        for (std::size_t offset = 0; offset < table.used; ++offset) {
+            if (!table.entries[offset].indexed) return refuse(Refusal::InvalidTable);
+        }
+    }
+    return true;
+}
+
+bool
+OriginalNodeScope::walk(EventQueue &queue)
+{
+    if (!current()) return false;
+    if (phase != State::Constructing) return refuse(Refusal::InvalidPhase);
+    phase = State::Walking;
+    if (!objectsUsed || numMainEventQueues != 1 || mainEventQueue.size() != 1 ||
+        mainEventQueue[0] != &queue || inParallelMode ||
+        crucibleModelIsExecuting() || sim_clock::Frequency != 1000000000000ULL ||
+        System::systemList.size() != 1 || !System::systemList[0])
+        return refuse(Refusal::QueueOwnership);
+
+    stoppedTick = queue.getCurTick();
+    if (SimObject::simObjectList.size() != objectsUsed)
+        return refuse(Refusal::UnknownObject);
+    for (const auto *object : SimObject::simObjectList) {
+        if (ordinal(object) == ObjectCapacity) return refuse(Refusal::UnknownObject);
+    }
+    if (!queue.crucibleNativeClosure(*this)) return false;
+    if (!current() || queue.getCurTick() != stoppedTick)
+        return refuse(Refusal::ChangedTick);
+
+    // Walked only authenticates these native ownership records. It never
+    // substitutes for the process-resource/image/final-delivery source gate.
+    phase = State::Walked;
+    return true;
+}
+
+bool
+NativeClosureWalk::object(const SimObject *owner, const SimObject *target,
+                          std::uint32_t member)
+{
+    return scope.objectEdge(owner, target, member);
+}
+
+bool
+NativeClosureWalk::callback(const SimObject *owner, const Event *event,
+                            std::uint32_t member)
+{
+    return scope.callbackOwner(owner, event, member);
+}
+
+bool
+NativeClosureWalk::port(const SimObject *owner, const Port *port,
+                        std::uint32_t member)
+{
+    return scope.portOwner(owner, port, member);
+}
+
+bool
+NativeClosureWalk::tableEntry(const SimObject *owner, const SimObject *index,
+                             const ReplaceableEntry *entry)
+{
+    return scope.tableEntry(owner, index, entry);
+}
+
+bool
+NativeClosureWalk::indexedEntry(const SimObject *index, const ReplaceableEntry *entry)
+{
+    return scope.indexedEntry(index, entry);
+}
+
