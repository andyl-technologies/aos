+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026 Andyl, Inc.
+#ifndef GEM5_MEM_CRUCIBLE_ATOMIC_FABRIC_HH
+#define GEM5_MEM_CRUCIBLE_ATOMIC_FABRIC_HH
+
+#include <array>
+
+#include "mem/port.hh"
+#include "params/CrucibleAtomicFabric.hh"
+#include "sim/clocked_object.hh"
+
+namespace gem5
+{
+
+/** Owns a direct atomic route for an explicit private-memory source profile.
+ *
+ * This additional fabric does not change normal crossbar implementations.
+ * It has three original input members and one output, with no cache, timing,
+ * retry, queued packet or arbitrary observer state. Its profile must verify
+ * the actual native peers and private backing store before issuing a cut.
+ */
+class CrucibleAtomicFabric final : public ClockedObject
+{
+  private:
