+#ifndef GEM5_DEV_VIRTIO_CRUCIBLE_CLOSED_SCRIPT_BLOCK_HH
+#define GEM5_DEV_VIRTIO_CRUCIBLE_CLOSED_SCRIPT_BLOCK_HH
+
+#include <array>
+
+#include "dev/virtio/host_request.hh"
+#include "params/CrucibleClosedScriptBlock.hh"
+
+namespace gem5
+{
+
+/** Owns a source-defined block script and private disk in the native image.
+ *
+ * The request/reply queue keeps its original descriptor bodies and cursors.
+ * This script introduces no Python callback, external worker, host backing
+ * file or unbounded command stream. Its source-owned events and pending state
+ * remain live at the capture boundary; capture never drains them.
+ */
+class CrucibleClosedScriptBlock final : public VirtIOHostRequest
+{
+  private:
+    class RequestEvent final : public Event
+    {
+      public:
+        explicit RequestEvent(CrucibleClosedScriptBlock &block) : owner(block) {}
+        void process() override;
+        bool ownedBy(const CrucibleClosedScriptBlock *block) const { return &owner == block; }
+
+      private:
+        CrucibleClosedScriptBlock &owner;
+    };
+
+    class ReactionEvent final : public Event
+    {
+      public:
+        explicit ReactionEvent(CrucibleClosedScriptBlock &block) : owner(block) {}
+        void process() override;
+        bool ownedBy(const CrucibleClosedScriptBlock *block) const { return &owner == block; }
+
+      private:
+        CrucibleClosedScriptBlock &owner;
+    };
+
+    struct InterruptDelivery
+    {
+        CrucibleClosedScriptBlock *owner;
+        void operator()() const;
+    };
+
+    class RetirementEvent final : public Event
+    {
+      public:
+        explicit RetirementEvent(CrucibleClosedScriptBlock &block) : owner(block) {}
+        void process() override;
+        bool ownedBy(const CrucibleClosedScriptBlock *block) const { return &owner == block; }
+
+      private:
+        CrucibleClosedScriptBlock &owner;
+    };
+
+    RequestEvent requestEvent;
+    ReactionEvent reactionEvent;
+    RetirementEvent retirementEvent;
+    const Tick reactionDelay;
+    std::array<std::uint8_t, 4096> disk{};
+    std::uint64_t pendingRequest = 0;
+    std::uint64_t reactionAttempts = 0;
+    std::uint64_t interruptsDelivered = 0;
+
+    void received();
+    void react();
+    void retire();
+
+  public:
+    PARAMS(CrucibleClosedScriptBlock);
+    explicit CrucibleClosedScriptBlock(const Params &parameters);
+
+    bool crucibleNativeClosure(crucible::NativeClosureWalk &walk) const override;
+};
+
+} // namespace gem5
+
+#endif
