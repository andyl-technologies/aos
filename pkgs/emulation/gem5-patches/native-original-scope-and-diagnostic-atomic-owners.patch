+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026 Andyl, Inc.
+#ifndef GEM5_SIM_CRUCIBLE_KERNEL_PROCESS_HH
+#define GEM5_SIM_CRUCIBLE_KERNEL_PROCESS_HH
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <fcntl.h>
+#include <linux/magic.h>
+#include <sys/syscall.h>
+#include <sys/vfs.h>
+
+namespace gem5::crucible
+{
+
+/** Actual Linux process custody. These observations confer no source permit. */
+struct KernelProcessObservation
+{
+    std::uint64_t process = 0;
+    std::uint64_t uid = 0;
+    std::uint64_t startTicks = 0;
+};
+
+namespace kernel_process_detail
+{
+
+// A process-image provider may virtualize libc syscall/PID entry points. These
+// Linux calls must observe the current kernel process, including early restore
+// before provider wrappers and their logger/plugin owners are operational.
+inline long rawCall(long number, long first = 0, long second = 0,
+                    long third = 0, long fourth = 0)
+{
+#if defined(__x86_64__)
+    register long r10 __asm__("r10") = fourth;
+    long result;
+    __asm__ volatile("syscall" : "=a"(result)
+        : "a"(number), "D"(first), "S"(second), "d"(third), "r"(r10)
+        : "rcx", "r11", "memory");
+    return result;
+#elif defined(__aarch64__)
+    register long x8 __asm__("x8") = number;
+    register long x0 __asm__("x0") = first;
+    register long x1 __asm__("x1") = second;
+    register long x2 __asm__("x2") = third;
+    register long x3 __asm__("x3") = fourth;
+    __asm__ volatile("svc 0" : "+r"(x0)
+        : "r"(x8), "r"(x1), "r"(x2), "r"(x3) : "memory", "cc");
+    return x0;
+#else
+#error Unsupported native Linux host architecture
+#endif
+}
+
+inline bool decimal(const char *first, const char *limit, std::uint64_t &value)
+{
+    if (first == limit) return false;
+    std::uint64_t parsed = 0;
+    for (auto cursor = first; cursor != limit; ++cursor) {
+        if (*cursor < '0' || *cursor > '9') return false;
+        const unsigned digit = unsigned(*cursor - '0');
+        if (parsed > (UINT64_MAX - digit) / 10) return false;
+        parsed = parsed * 10 + digit;
+    }
+    value = parsed;
+    return true;
+}
+
+/** Reads field22 without treating spaces/parentheses in comm as separators. */
+inline bool startTicks(const char *bytes, std::size_t length,
+                       std::uint64_t expectedProcess, std::uint64_t &ticks)
+{
+    if (!bytes || !length || length >= 4096) return false;
+    const auto *limit = bytes + length;
+    const auto *separator = static_cast<const char *>(std::memchr(bytes, ' ', length));
+    std::uint64_t process = 0;
+    if (!separator || separator + 1 == limit || separator[1] != '(' ||
+        !decimal(bytes, separator, process) || process != expectedProcess)
+        return false;
+
+    // comm may include closing parentheses; only the last one ends field2.
+    const char *close = nullptr;
+    for (auto cursor = separator + 2; cursor != limit; ++cursor) {
+        if (*cursor == ')') close = cursor;
+    }
+    if (!close || close + 2 >= limit || close[1] != ' ') return false;
+
+    const char *cursor = close + 2;
+    for (unsigned field = 3; field <= 22; ++field) {
+        const char *end = cursor;
+        while (end != limit && *end != ' ' && *end != '\n') ++end;
+        if (end == cursor) return false;
+        if (field == 22)
+            return decimal(cursor, end, ticks) && ticks != 0;
+        if (end == limit || *end != ' ') return false;
+        cursor = end + 1;
+    }
+    return false;
+}
+
+} // namespace kernel_process_detail
+
+/** Borrows actual PID/UID/start-time through authenticated Linux procfs.
+ *
+ * The single bounded read and all failure paths close the original temporary
+ * descriptor. A failed read or close leaves the caller's output untouched.
+ * The observation remains descriptive; a native verifier must bind it to the
+ * original source account and complete actual closure before issuing a cut.
+ */
+inline bool observeKernelProcess(KernelProcessObservation &output)
+{
+    using namespace kernel_process_detail;
+    const long pid = rawCall(SYS_getpid);
+    const long uid = rawCall(SYS_geteuid);
+    if (pid <= 0 || uid < 0) return false;
+
+    const long fd = rawCall(SYS_openat, AT_FDCWD,
+        reinterpret_cast<long>("/proc/self/stat"), O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) return false;
+
+    struct statfs filesystem{};
+    char bytes[4096];
+    const long stat = rawCall(SYS_fstatfs, fd, reinterpret_cast<long>(&filesystem));
+    const long extent = stat == 0 && filesystem.f_type == PROC_SUPER_MAGIC
+        ? rawCall(SYS_read, fd, reinterpret_cast<long>(bytes), sizeof(bytes)) : -1;
+    const long closed = rawCall(SYS_close, fd);
+    std::uint64_t ticks = 0;
+    if (closed != 0 || extent <= 0 || extent >= long(sizeof(bytes)) ||
+        !startTicks(bytes, std::size_t(extent), std::uint64_t(pid), ticks) ||
+        rawCall(SYS_getpid) != pid || rawCall(SYS_geteuid) != uid)
+        return false;
+
+    output = {std::uint64_t(pid), std::uint64_t(uid), ticks};
+    return true;
+}
+
+} // namespace gem5::crucible
