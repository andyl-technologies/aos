+bool
+VirtQueue::crucibleNativeOwnership(const PortProxy &proxy,
+                                 const AddrRange &privateMemory) const
+{
+    if (&memProxy != &proxy || byteOrder != ByteOrder::little ||
+        _maxSize != 2 || _size != 2 || !_incarnation ||
+        descriptors.size() != _maxSize || privateMemory.interleaved() ||
+        !privateMemory.valid() ||
+        !avail.crucibleNativeOwnership(proxy, byteOrder, _size) ||
+        !used.crucibleNativeOwnership(proxy, byteOrder, _size))
+        return false;
+
+    const auto spanOwned = [&](Addr start, std::uint64_t bytes) {
+        return !bytes || (start >= privateMemory.start() &&
+            start <= privateMemory.end() &&
+            bytes - 1 <= privateMemory.end() - start);
+    };
+    if (_ready) {
+        if (!_address || !_driverAddress || !_deviceAddress ||
+            (_address & 15) || (_driverAddress & 1) || (_deviceAddress & 3) ||
+            avail.baseAddress() != _driverAddress ||
+            used.baseAddress() != _deviceAddress ||
+            !spanOwned(_address, _size * sizeof(vring_desc)) ||
+            !spanOwned(_driverAddress, 4 + _size * sizeof(std::uint16_t)) ||
+            !spanOwned(_deviceAddress, 4 + _size * sizeof(vring_used_elem)) ||
+            std::uint16_t(avail.header.index - _last_avail) > _size ||
+            used.header.index != _last_used)
+            return false;
+    } else if (_address || _driverAddress || _deviceAddress ||
+               avail.baseAddress() || used.baseAddress() || _last_avail ||
+               _last_used || avail.header.index || used.header.index) {
+        // Partially configured transports require their own declared profile.
+        // They cannot borrow this diagnostic private queue's closed geometry.
+        return false;
+    }
+
+    for (std::size_t index = 0; index < descriptors.size(); ++index) {
+        const auto &entry = descriptors[index];
+        if (entry.queue != this || entry.memProxy != &proxy ||
+            entry.byteOrder != byteOrder || entry._index != index ||
+            (entry.desc.flags & ~(VRING_DESC_F_NEXT | VRING_DESC_F_WRITE)) ||
+            !spanOwned(entry.desc.addr, entry.desc.len))
+            return false;
+
+        // Follow existing native links only. This walk never reloads a guest
+        // descriptor, advances a ring cursor or repairs a malformed chain.
+        std::array<bool, 2> seen{};
+        std::size_t cursor = index;
+        for (;;) {
+            if (cursor >= descriptors.size() || seen[cursor]) return false;
+            seen[cursor] = true;
+            const auto &link = descriptors[cursor].desc;
+            if (!(link.flags & VRING_DESC_F_NEXT)) break;
+            cursor = link.next;
+        }
+    }
+    return true;
