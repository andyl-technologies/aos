+{
+
+CrucibleAtomicFabric::CrucibleAtomicFabric(const Params &parameters)
+    : ClockedObject(parameters),
+      inputs{{InputPort(name() + ".cpu_side_ports[0]", *this, 0),
+              InputPort(name() + ".cpu_side_ports[1]", *this, 1),
+              InputPort(name() + ".cpu_side_ports[2]", *this, 2)}},
+      output(name() + ".mem_side_port", *this)
+{
+    fatal_if(parameters.port_cpu_side_ports_connection_count != inputs.size(),
+             "closed atomic fabric requires exactly three original inputs");
+}
+
+Port &
+CrucibleAtomicFabric::getPort(const std::string &name, PortID id)
+{
+    if (name == "cpu_side_ports" && id >= 0 && std::size_t(id) < inputs.size())
+        return inputs[std::size_t(id)];
+    if (name == "mem_side_port" && id == InvalidPortID) return output;
+    return ClockedObject::getPort(name, id);
+}
+
+Tick
+CrucibleAtomicFabric::InputPort::recvAtomic(PacketPtr packet)
+{
+    return owner.output.sendAtomic(packet);
+}
+
+void
+CrucibleAtomicFabric::InputPort::recvFunctional(PacketPtr packet)
+{
+    owner.output.sendFunctional(packet);
+}
+
+bool
+CrucibleAtomicFabric::InputPort::recvTimingReq(PacketPtr)
+{
+    panic("closed atomic fabric does not own a timing request route");
+}
+
+void
+CrucibleAtomicFabric::InputPort::recvRespRetry()
+{
+    panic("closed atomic fabric does not own a response retry route");
+}
+
+AddrRangeList
+CrucibleAtomicFabric::InputPort::getAddrRanges() const
+{
+    return owner.output.getAddrRanges();
+}
+
+void
+CrucibleAtomicFabric::OutputPort::recvRangeChange()
+{
+    for (auto &input : owner.inputs) {
+        if (input.isConnected()) input.sendRangeChange();
+    }
+}
+
+bool
+CrucibleAtomicFabric::OutputPort::recvTimingResp(PacketPtr)
+{
+    panic("closed atomic fabric does not own a timing response route");
+}
+
+void
+CrucibleAtomicFabric::OutputPort::recvReqRetry()
+{
+    panic("closed atomic fabric does not own a request retry route");
+}
+
+bool
+CrucibleAtomicFabric::crucibleNativeClosure(crucible::NativeClosureWalk &walk) const
+{
+    if (!powerState || !output.ownedBy(this) || !output.isConnected()) return false;
+    if (!walk.object(this, &crucibleNativeClockDomain(), 1) ||
+        !walk.object(this, powerState, 2) || !walk.port(this, &output, 3))
+        return false;
+    for (const auto &input : inputs) {
+        if (!input.ownedBy(this) || !input.isConnected() || !walk.port(this, &input, 4))
+            return false;
+    }
+    return true;
+}
