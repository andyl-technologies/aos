+// SPDX-License-Identifier: MIT
+#ifndef __SIM_CRUCIBLE_STATE_HH__
+#define __SIM_CRUCIBLE_STATE_HH__
+
+#include <algorithm>
+#include <cstdint>
+#include <cstddef>
+#include <map>
+#include <stdexcept>
+#include <string>
+#include <type_traits>
+#include <openssl/sha.h>
+
+namespace gem5
+{
+
+/** Canonical, address-free field values for explicitly audited native visitors. */
+class CrucibleStateWriter
+{
+  public:
+    std::map<std::string, std::string> fields;
+
+    void string(const std::string &key, const std::string &value)
+    {
+        if (!fields.emplace(key, value).second)
+            throw std::runtime_error("duplicate modeled field: " + key);
+    }
+
+    template<class T>
+    void set(const std::string &key, T value)
+    {
+        if constexpr (std::is_enum_v<T>)
+            set(key, static_cast<std::underlying_type_t<T>>(value));
+        else
+            string(key, std::to_string(value));
+    }
+
+    void bytes(const std::string &key, const uint8_t *data, size_t size)
+    {
+        if (!data && size)
+            throw std::runtime_error("missing modeled byte storage: " + key);
+        unsigned char digest[SHA256_DIGEST_LENGTH];
+        if (!SHA256(data, size, digest))
+            throw std::runtime_error("modeled byte digest failed: " + key);
+        static constexpr char hex[] = "0123456789abcdef";
+        std::string encoded;
+        encoded.reserve(2 * sizeof(digest));
+        for (unsigned char value : digest) {
+            encoded.push_back(hex[value >> 4]);
+            encoded.push_back(hex[value & 15]);
+        }
+        set(key + ".bytes", size);
+        string(key + ".sha256", encoded);
+    }
+};
+
+} // namespace gem5
+#endif
