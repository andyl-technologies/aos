+/** Retains literal LRU-constructor births in the original fixed scope bank.
+ *
+ * ReplacementData is deliberately nonpolymorphic upstream. A live pointer is
+ * never a substitute for its constructor and original shared ownership. Weak
+ * ownership keeps an expired control block distinct from a later allocation,
+ * without extending the data lifetime or allocating another control block.
+ * This bank grants no execution, process-resource or checkpoint authority.
+ */
+class LruConstructorBirths
+{
+  private:
+    friend class OriginalNodeScope;
+
+    LruConstructorBirths() = default;
+    LruConstructorBirths(const LruConstructorBirths &) = delete;
+    LruConstructorBirths &operator=(const LruConstructorBirths &) = delete;
+    LruConstructorBirths(LruConstructorBirths &&) = delete;
+    LruConstructorBirths &operator=(LruConstructorBirths &&) = delete;
+
+    // The unchanged selected ARM tables contain 64+64+1280+32+32 entries.
+    static constexpr std::size_t Capacity = 1472;
+    using Data = replacement_policy::ReplacementData;
+
+    struct Reservation
+    {
+        const LruConstructorBirths *bank = nullptr;
+        std::size_t slot = Capacity;
+    };
+
+    enum class State : unsigned char { Empty, Reserved, Published };
+
+    struct Birth
+    {
+        const SimObject *policy = nullptr;
+        const Data *data = nullptr;
+        std::weak_ptr<Data> ownership;
+        State state = State::Empty;
+    };
+
+    Reservation reserve(const SimObject *policy)
+    {
+        if (failed || !policy || used == Capacity) {
+            failed = true;
+            return {};
+        }
+
+        const auto slot = used++;
+        auto &birth = births[slot];
+        birth.policy = policy;
+        birth.state = State::Reserved;
+        return {this, slot};
+    }
+
+    bool publish(const Reservation &reservation, const SimObject *policy,
+                 const std::shared_ptr<Data> &data)
+    {
+        if (failed || reservation.bank != this || reservation.slot >= used ||
+            !data || data.use_count() != 1) {
+            failed = true;
+            return false;
+        }
+        auto &birth = births[reservation.slot];
+        if (birth.state != State::Reserved || birth.policy != policy) {
+            failed = true;
+            return false;
+        }
+
+        for (std::size_t slot = 0; slot < used; ++slot) {
+            const auto &prior = births[slot];
+            if (prior.state != State::Published) continue;
+            if (prior.data == data.get() ||
+                (!prior.ownership.owner_before(data) &&
+                 !data.owner_before(prior.ownership))) {
+                failed = true;
+                return false;
+            }
+        }
+
+        birth.data = data.get();
+        birth.ownership = data;
+        birth.state = State::Published;
+        return true;
+    }
+
+    bool matches(const SimObject *policy, const std::shared_ptr<Data> &data) const
+    {
+        if (failed || !policy || !data) return false;
+        for (std::size_t slot = 0; slot < used; ++slot) {
+            const auto &birth = births[slot];
+            if (birth.state != State::Published || birth.policy != policy ||
+                birth.data != data.get() || birth.ownership.expired())
+                continue;
+            if (!birth.ownership.owner_before(data) &&
+                !data.owner_before(birth.ownership))
+                return true;
+        }
+        return false;
+    }
+
+    bool complete() const
+    {
+        if (failed) return false;
+        for (std::size_t slot = 0; slot < used; ++slot) {
+            const auto &birth = births[slot];
+            if (birth.state != State::Published || birth.ownership.expired())
+                return false;
+        }
+        return true;
+    }
+
+    std::array<Birth, Capacity> births{};
+    std::size_t used = 0;
+    bool failed = false;
+};
+
+} // namespace crucible
+} // namespace gem5
+
+#endif
