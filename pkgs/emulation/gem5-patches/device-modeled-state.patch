+void
+VirtDescriptor::crucibleVisit(CrucibleStateWriter &writer,
+                              const std::string &prefix) const
+{
+    writer.reference(prefix + ".identity", this, "virtio-descriptor");
+    if (!writer.beginBody(this, "virtio-descriptor"))
+        return;
+    writer.reference(prefix + ".queue", queue, "virtio-queue");
+    writer.reference(prefix + ".proxy", memProxy, "port-proxy");
+    writer.set(prefix + ".byte_order", byteOrder);
+    writer.set(prefix + ".index", _index);
+    writer.set(prefix + ".buffer_address", desc.addr);
+    writer.set(prefix + ".buffer_length", desc.len);
+    writer.set(prefix + ".flags", desc.flags);
+    writer.set(prefix + ".next", desc.next);
+}
+
+void
+VirtQueue::crucibleVisit(CrucibleStateWriter &writer,
+                         const std::string &prefix) const
+{
+    writer.reference(prefix + ".identity", this, "virtio-queue");
+    if (!writer.beginBody(this, "virtio-queue"))
+        return;
+    writer.reference(prefix + ".proxy", &memProxy, "port-proxy");
+    writer.set(prefix + ".byte_order", byteOrder);
+    writer.set(prefix + ".maximum_size", _maxSize);
+    writer.set(prefix + ".selected_size", _size);
+    writer.set(prefix + ".descriptor_address", _address);
+    writer.set(prefix + ".driver_address", _driverAddress);
+    writer.set(prefix + ".device_address", _deviceAddress);
+    writer.set(prefix + ".modern", _modern);
+    writer.set(prefix + ".ready", _ready);
+    writer.set(prefix + ".last_available", _last_avail);
+    writer.set(prefix + ".last_used", _last_used);
+    writer.set(prefix + ".incarnation", _incarnation);
+    writer.set(prefix + ".available.base", avail.baseAddress());
+    writer.set(prefix + ".available.flags", avail.header.flags);
+    writer.set(prefix + ".available.index", avail.header.index);
+    writer.set(prefix + ".available.cached_count", avail.ring.size());
+    for (size_t index = 0; index < avail.ring.size(); ++index)
+        writer.set(prefix + ".available.cached[" + std::to_string(index) + "]",
+                   avail.ring[index]);
+    writer.set(prefix + ".used.base", used.baseAddress());
+    writer.set(prefix + ".used.flags", used.header.flags);
+    writer.set(prefix + ".used.index", used.header.index);
+    writer.set(prefix + ".used.cached_count", used.ring.size());
+    for (size_t index = 0; index < used.ring.size(); ++index) {
+        const auto key = prefix + ".used.cached[" + std::to_string(index) + "]";
+        writer.set(key + ".id", used.ring[index].id);
+        writer.set(key + ".length", used.ring[index].len);
+    }
+    writer.set(prefix + ".descriptor_storage_count", descriptors.size());
+    for (size_t index = 0; index < descriptors.size(); ++index)
+        descriptors[index].crucibleVisit(writer,
+            prefix + ".descriptor[" + std::to_string(index) + "]");
+}
+
+std::map<std::string, std::string>
+VirtIODeviceBase::crucibleModeledFields() const
+{
+    CrucibleStateWriter writer;
+    writer.set("virtio.device_id", deviceId);
+    writer.set("virtio.config_size", configSize);
+    writer.set("virtio.offered_features", deviceFeatures);
+    writer.set("virtio.guest_features", guestFeatures);
+    writer.set("virtio.byte_order", byteOrder);
+    writer.set("virtio.status", uint8_t(_deviceStatus));
+    writer.set("virtio.modern_transport", _modernTransport);
+    writer.set("virtio.features_finalized", _featuresFinalized);
+    writer.set("virtio.queue_select", _queueSelect);
+    writer.set("virtio.queue_count", _queues.size());
+    for (size_t index = 0; index < _queues.size(); ++index)
+        _queues[index]->crucibleVisit(writer,
+            "virtio.queue[" + std::to_string(index) + "]");
+    writer.set("virtio.transport_callback_installed", bool(transKick));
+    writer.string("coverage.unsupported",
+        "transport-callback-closure-proxy-address-map-and-inherited-simobject");
+    return std::move(writer.fields);
+}
+
