+std::map<std::string, std::string>
+VirtIONet::crucibleModeledFields() const
+{
+    CrucibleStateWriter writer;
+    writer.fields = VirtIODeviceBase::crucibleModeledFields();
+    writer.set("net.frame_capacity", frameCapacity);
+    writer.set("net.maximum_frame_bytes", maximumFrameBytes);
+    writer.bytes("net.mac", mac.data(), mac.size());
+    writer.set("net.last_accepted_rx", lastAcceptedRx);
+    writer.set("net.retired_rx", retiredRx);
+    writer.set("net.next_tx", nextTx);
+    writer.set("net.acknowledged_tx", acknowledgedTx);
+    writer.set("net.execution_parent", executionParent);
+    writer.reference("net.receive_event", static_cast<const Event *>(&receiveEvent), "event");
+    writer.reference("net.transmit_credit_event", static_cast<const Event *>(&transmitCreditEvent), "event");
+    writer.set("net.receive_scheduled", receiveEvent.scheduled());
+    if (receiveEvent.scheduled())
+        writer.set("net.receive_tick", receiveEvent.when());
+    writer.set("net.transmit_credit_scheduled", transmitCreditEvent.scheduled());
+    if (transmitCreditEvent.scheduled())
+        writer.set("net.transmit_credit_tick", transmitCreditEvent.when());
+    const auto visit = [&](const std::deque<Frame> &frames, const std::string &prefix) {
+        writer.set(prefix + ".count", frames.size());
+        size_t index = 0;
+        for (const Frame &frame : frames) {
+            const auto key = prefix + "[" + std::to_string(index++) + "]";
+            writer.set(key + ".id", frame.id);
+            writer.set(key + ".tick", frame.tick);
+            writer.set(key + ".parent", frame.parent);
+            writer.set(key + ".consumed", frame.consumed);
+            writer.set(key + ".event_ordinal", frame.eventOrdinal);
+            writer.set(key + ".tick_ordinal", frame.tickOrdinal);
+            writer.set(key + ".consumed_tick", frame.consumedTick);
+            writer.set(key + ".consumption_parent", frame.consumptionParent);
+            writer.bytes(key + ".payload", frame.bytes.data(), frame.bytes.size());
+        }
+    };
+    visit(inputs, "net.inputs");
+    visit(outputs, "net.outputs");
+    return std::move(writer.fields);
+}
+
+VirtIONet::OwnerEvent::OwnerEvent(VirtIONet &owner, Action action)
+    : Event(Default_Pri), owner(owner), action(action)
+{
+}
+
+void
+VirtIONet::OwnerEvent::process()
+{
+    switch (action) {
+      case Action::First: owner.receiveDue(); break;
+      case Action::Second: owner.transmitAvailable(); break;
+    }
+}
