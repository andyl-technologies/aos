+
+bool
+SystemCounter::crucibleNativeClosure(crucible::NativeClosureWalk &walk) const
+{
+    // Listener targets are nested ArchTimer/CoreTimers owners, not SimObjects.
+    // Until their original counter/parent/pin edges are closed, even one
+    // listener refuses this narrow producer. An event census cannot close it.
+    if (typeid(*this) != typeid(SystemCounter) || !_listeners.empty() ||
+        _listeners.capacity() || _freqTable.size() < 2 ||
+        _freqTable.size() > MAX_FREQ_ENTRIES ||
+        _freqTable.capacity() > 2 * MAX_FREQ_ENTRIES || _freqTable.back() ||
+        _activeFreqEntry >= _freqTable.size() - 1 ||
+        _nextFreqEntry >= _freqTable.size() - 1 || !_freq || !_period ||
+        _freqTable[_activeFreqEntry] != _freq ||
+        _increment != _freqTable.front() / _freq || _updateTick > curTick())
+        return false;
+
+    for (size_t index = 0; index + 1 < _freqTable.size(); ++index) {
+        if (!_freqTable[index] || _freqTable.front() % _freqTable[index])
+            return false;
+    }
+
+    // Register the exact constructor-bound member even when not scheduled.
+    // The existing walk checks its queued identity and unchanged native tick.
+    return walk.callback(this, &_freqUpdateEvent, 1);
+}
+
+std::map<std::string, std::string>
+SystemCounter::crucibleModeledFields() const
+{
+    if (_freqTable.size() > MAX_FREQ_ENTRIES)
+        throw std::runtime_error("counter frequency table exceeds source bound");
+
+    CrucibleStateWriter writer;
+    // value() and whenValue() update these cached fields. Inspection reads the
+    // stored values directly, without normalizing the counter or its events.
+    writer.set("counter.enabled", _enabled);
+    writer.set("counter.frequency", _freq);
+    writer.set("counter.cached_value", _value);
+    writer.set("counter.increment", _increment);
+    writer.set("counter.active_frequency_entry", _activeFreqEntry);
+    writer.set("counter.period", _period);
+    writer.set("counter.update_tick", _updateTick);
+    writer.set("counter.next_frequency_entry", _nextFreqEntry);
+    writer.set("counter.frequency_table_entries", _freqTable.size());
+    writer.set("counter.frequency_table_capacity_entries", _freqTable.capacity());
+    for (size_t index = 0; index < _freqTable.size(); ++index)
+        writer.set("counter.frequency_table[" + std::to_string(index) + "]",
+                   _freqTable[index]);
+
+    writer.set("counter.listener_count", _listeners.size());
+    writer.set("counter.listener_capacity_entries", _listeners.capacity());
+    writer.reference("counter.frequency_event",
+                     static_cast<const Event *>(&_freqUpdateEvent), "event");
+    writer.set("counter.frequency_event_scheduled", _freqUpdateEvent.scheduled());
+    if (_freqUpdateEvent.scheduled())
+        writer.set("counter.frequency_event_tick", _freqUpdateEvent.when());
+
+    writer.string("coverage.unsupported",
+        "counter-listener-targets-callback-payloads-native-backing-and-inherited-simobject");
+    return std::move(writer.fields);
 }
 
