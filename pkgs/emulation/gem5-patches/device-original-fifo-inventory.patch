+std::vector<uint8_t>
+VirtIOHostRequest::crucibleRequestPublicationBytes(uint64_t id) const
+{
+    for (const auto &request : requests) {
+        if (request.acknowledged)
+            continue;
+        if (request.id == id)
+            return request.bytes;
+    }
+    throw std::invalid_argument("publication bytes require an original retained identity");
+}
