+std::vector<std::vector<uint64_t>>
+VirtIOHostRequest::crucibleRequestPublicationInventory() const
+{
+    std::vector<std::vector<uint64_t>> result;
+    for (const auto &request : requests) {
+        if (request.acknowledged)
+            continue;
+        result.push_back({request.id, request.birthTick, request.parent, request.opcode, request.sector, request.tag, request.payloadBytes, request.birthOrdinal, request.birthTickOrdinal});
+    }
+    return result;
+}
