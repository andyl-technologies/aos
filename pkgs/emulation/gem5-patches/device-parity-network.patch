+
+"""Provides a bounded Ethernet endpoint driven by the admitted controller."""
+
+from m5.SimObject import PyBindMethod
+from m5.objects.VirtIO import VirtIODeviceBase
+from m5.params import Param
+
+
+class VirtIONet(VirtIODeviceBase):
+    type = "VirtIONet"
+    cxx_header = "dev/virtio/net.hh"
+    cxx_class = "gem5::VirtIONet"
+    cxx_exports = [
+        PyBindMethod("stageRx"),
+        PyBindMethod("retireRx"),
+        PyBindMethod("pendingRxMetadata"),
+        PyBindMethod("pendingRxCompletionMetadata"),
+        PyBindMethod("pendingTxMetadata"),
+        PyBindMethod("pendingTxBytes"),
+        PyBindMethod("acknowledgeTx"),
+        PyBindMethod("setExecutionParent"),
+    ]
+
+    queue_size = Param.UInt16(256, "Maximum descriptors per split ring")
+    frame_capacity = Param.Unsigned(256, "Maximum retained frames per direction")
+    maximum_frame_bytes = Param.Unsigned(4096, "Maximum Ethernet frame bytes")
+    mac = Param.EthernetAddr("02:00:00:00:00:01", "Explicit immutable MAC address")
