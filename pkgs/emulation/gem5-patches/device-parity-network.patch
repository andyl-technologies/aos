+
+#ifndef __DEV_VIRTIO_NET_HH__
+#define __DEV_VIRTIO_NET_HH__
+
+#include <array>
+#include <deque>
+#include <vector>
+
+#include "dev/virtio/base.hh"
+#include "sim/eventq.hh"
+
+namespace gem5
+{
+
+struct VirtIONetParams;
+
+/**
+ * Bounded VirtIO Ethernet endpoint with explicit native input/output custody.
+ *
+ * The controller stages complete timestamped frames while the owner is stopped.
+ * A native event delivers each sealed input cut to the guest. Guest TX retains
+ * immutable bytes until the host acknowledges publication of the original ID.
+ * No host socket, TAP, polling thread, or wall clock drives this device.
+ */
+class VirtIONet : public VirtIODeviceBase
+{
+  public:
+    explicit VirtIONet(const VirtIONetParams &params);
+    void readConfig(PacketPtr pkt, Addr cfgOffset) override;
+    void serialize(CheckpointOut &cp) const override;
+    void unserialize(CheckpointIn &cp) override;
+
+    /** Accepts an immutable consecutive input ID, without executing events. */
+    bool stageRx(uint64_t id, Tick tick, uint64_t causal_parent,
+                 const std::vector<uint8_t> &bytes);
+    /** Retires only the oldest actually delivered input after host custody ACK. */
+    bool retireRx(uint64_t id);
+    /** Returns all retained input identities/times/parents/consumption flags. */
+    std::vector<uint64_t> pendingRxMetadata() const;
+    /** Returns actual delivery birth and byte count without ACK authority. */
+    std::vector<uint64_t> pendingRxCompletionMetadata() const;
+    /** Returns the oldest unpublished TX identity/native tick/causal parent. */
+    std::vector<uint64_t> pendingTxMetadata() const;
+    std::vector<uint8_t> pendingTxBytes() const;
+    /** Idempotently acknowledges the oldest actual native output. */
+    bool acknowledgeTx(uint64_t id);
+    /** Binds subsequent native outputs to the controller's sealed execution. */
+    bool setExecutionParent(uint64_t parent);
+
+  private:
+    struct Frame : public Serializable
+    {
+        uint64_t id = 0;
+        Tick tick = 0;
+        uint64_t parent = 0;
+        bool consumed = false;
+        uint64_t eventOrdinal = 0;
+        uint64_t tickOrdinal = 0;
+        Tick consumedTick = 0;
+        uint64_t consumptionParent = 0;
+        std::vector<uint8_t> bytes;
+
+        void serialize(CheckpointOut &cp) const override;
+        void unserialize(CheckpointIn &cp) override;
+    };
+
+    class ReceiveQueue : public VirtQueue
+    {
+      public:
+        ReceiveQueue(PortProxy &proxy, uint16_t size, VirtIONet &parent);
+        void onNotify() override;
+      private:
+        VirtIONet &parent;
+    };
+
+    class TransmitQueue : public VirtQueue
+    {
+      public:
+        TransmitQueue(PortProxy &proxy, uint16_t size, VirtIONet &parent);
+        void onNotify() override;
+      private:
+        VirtIONet &parent;
+    };
+
+    void receiveDue();
+    void scheduleReceive();
+    void transmitAvailable();
+    unsigned headerSize() const;
+    void validateRestored() const;
+
+    const unsigned frameCapacity;
+    const unsigned maximumFrameBytes;
+    std::array<uint8_t, 6> mac;
+    ReceiveQueue receiveQueue;
+    TransmitQueue transmitQueue;
+    EventFunctionWrapper receiveEvent;
+    EventFunctionWrapper transmitCreditEvent;
+    std::deque<Frame> inputs;
+    std::deque<Frame> outputs;
+    uint64_t lastAcceptedRx = 0;
+    uint64_t retiredRx = 0;
+    uint64_t nextTx = 1;
+    uint64_t acknowledgedTx = 0;
+    uint64_t executionParent = 0;
+};
+
+} // namespace gem5
+
+#endif
