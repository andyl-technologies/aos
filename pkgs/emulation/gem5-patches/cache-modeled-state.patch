+/** Per-observation alias identities; private addresses never leave this scope. */
+class CrucibleStateIdentityScope
+{
+  public:
+    struct Record { std::string kind; };
+    std::vector<Record> records;
+    inline static thread_local CrucibleStateIdentityScope *active = nullptr;
+
+    CrucibleStateIdentityScope()
+    {
+        if (active)
+            throw std::runtime_error("nested modeled state inspection");
+        active = this;
+    }
+
+    ~CrucibleStateIdentityScope() { active = nullptr; }
+    CrucibleStateIdentityScope(const CrucibleStateIdentityScope &) = delete;
+    CrucibleStateIdentityScope &operator=(const CrucibleStateIdentityScope &) = delete;
+
+    bool beginBody(const void *pointer, const std::string &kind)
+    {
+        reference(pointer, kind);
+        return bodies.emplace(pointer).second;
+    }
+
+    std::string reference(const void *pointer, const std::string &kind)
+    {
+        if (!pointer)
+            return "null";
+        auto existing = identities.find(pointer);
+        if (existing != identities.end()) {
+            if (records[existing->second].kind != kind)
+                throw std::runtime_error("modeled alias has conflicting kinds");
+            return std::to_string(existing->second);
+        }
+        if (records.size() >= 1048576)
+            throw std::runtime_error("modeled reference inventory limit exceeded");
+        const auto identity = records.size();
+        records.push_back({kind});
+        identities.emplace(pointer, identity);
+        return std::to_string(identity);
+    }
+
+  private:
+    std::unordered_map<const void *, size_t> identities;
+    std::unordered_set<const void *> bodies;
+};
 
