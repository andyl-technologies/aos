 bool
+OriginalNodeScope::declareTable(const SimObject *owner, const SimObject *index,
+                                std::size_t entries)
+{
+    if (!current() || phase != State::Walking) return false;
+    const auto indexOrdinal = ordinal(index);
+    if (visiting != owner || ordinal(owner) == ObjectCapacity ||
+        indexOrdinal == ObjectCapacity || !entries || entries > TableEntryCapacity)
+        return refuse(Refusal::InvalidTable);
+    if (objects[indexOrdinal].visit != Visit::Unvisited)
+        return refuse(Refusal::InvalidTable);
+
+    // A declaration consumes one original slot. It cannot replace a partial
+    // declaration, renew an entry allowance or borrow another owner's index.
+    for (std::size_t slot = 0; slot < tablesUsed; ++slot) {
+        if (tables[slot].index == index) return refuse(Refusal::InvalidTable);
+    }
+    if (tablesUsed == TableCapacity) return refuse(Refusal::TableCapacity);
+    auto &table = tables[tablesUsed++];
+    table.owner = owner;
+    table.index = index;
+    table.expected = entries;
+    return true;
+}
