 void
+ThreadState::crucibleFields(CrucibleStateWriter &writer, const std::string &prefix) const
+{
+    crucibleBaseFields(writer, prefix);
+    writer.set(prefix + ".no_squash_from_context", noSquashFromTC);
+    writer.set(prefix + ".trap_pending", trapPending);
+    writer.reference(prefix + ".htm_checkpoint", htmCheckpoint.get(), "htm-checkpoint");
+    // The instruction event queue's thresholds are committed counts, not ticks.
+    const auto events = const_cast<EventQueue &>(comInstEventQueue).crucibleEventInventory();
+    writer.set(prefix + ".committed_events.count", events.size());
+    for (size_t index = 0; index < events.size(); ++index) {
+        const auto key = prefix + ".committed_event[" + std::to_string(index) + "]";
+        const auto &event = events[index];
+        writer.string(key + ".alias", event.alias);
+        writer.string(key + ".native_identity", event.identity);
+        writer.set(key + ".threshold", event.when);
+        writer.set(key + ".priority", event.priority);
+        writer.set(key + ".flags", event.flags);
+        writer.string(key + ".type", event.type);
+        writer.string(key + ".description", event.description);
+        for (const auto &[field, value] : event.fields)
+            writer.string(key + ".payload." + field, value);
+        if (event.fields.empty())
+            writer.string(key + ".coverage.unsupported", "unknown-committed-instruction-event-payload");
+    }
+    writer.string(prefix + ".coverage.unsupported", "pc-event-queue;htm-checkpoint-private-state;process-thread-context-transfer");
+}
