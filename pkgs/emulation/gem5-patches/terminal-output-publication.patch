+void
+Terminal::crucibleRequireStopped() const
+{
+    fatal_if(crucibleModelIsExecuting(),
+             "Terminal custody requires a stopped native event boundary");
+}
+
+void
+Terminal::crucibleConfigureOutput()
+{
+    crucibleRequireStopped();
+    fatal_if(crucibleOutputConfigured ||
+             crucibleNativeEventPosition().ordinal != 0 ||
+             listenEvent || dataEvent || data_fd != -1 || outfile ||
+             (listener && listener->islistening()) || !rxbuf.empty() || !txbuf.empty(),
+             "Terminal capture requires an unused private terminal before events");
+    crucibleOutputConfigured = true;
+}
+
+void
+Terminal::crucibleCaptureOutput(uint8_t byte)
+{
+    const auto birth = crucibleNativeEventPosition();
+    fatal_if(!birth.active || birth.tick != curTick(),
+             "Terminal output lacks its actual native callback birth");
+    fatal_if(crucibleRetainedOutput.size() >= 65536 ||
+             crucibleNextOutput == std::numeric_limits<uint64_t>::max(),
+             "Original terminal output credit exhausted before publication");
+    crucibleRetainedOutput.push_back(
+        {crucibleNextOutput, birth, crucibleOutputParent, byte});
+    ++crucibleNextOutput;
+}
+
+std::vector<uint64_t>
+Terminal::crucibleOutputMetadata() const
+{
+    crucibleRequireStopped();
+    if (crucibleRetainedOutput.empty())
+        return {};
+    const auto &output = crucibleRetainedOutput.front();
+    return {output.identifier, output.birth.tick, output.birth.ordinal,
+            output.birth.tickOrdinal, output.parent, 1};
+}
+
+std::vector<uint8_t>
+Terminal::crucibleOutputBytes() const
+{
+    crucibleRequireStopped();
+    if (crucibleRetainedOutput.empty())
+        return {};
+    return {crucibleRetainedOutput.front().byte};
+}
+
+bool
+Terminal::crucibleAcknowledgeOutput(uint64_t original_identifier)
+{
+    crucibleRequireStopped();
+    if (!crucibleOutputConfigured || original_identifier == 0)
+        return false;
+    if (original_identifier <= crucibleAcknowledgedThrough)
+        return true;
+    if (crucibleRetainedOutput.empty() ||
+        crucibleRetainedOutput.front().identifier != original_identifier)
+        return false;
+    crucibleRetainedOutput.pop_front();
+    crucibleAcknowledgedThrough = original_identifier;
+    return true;
+}
+
+bool
+Terminal::crucibleSetOutputParent(uint64_t original_parent)
+{
+    crucibleRequireStopped();
+    if (!crucibleOutputConfigured || !crucibleRetainedOutput.empty())
+        return false;
+    crucibleOutputParent = original_parent;
+    return true;
+}
+
 } // namespace gem5
