+bool
+SystemCounter::crucibleDiagnosticFrequencyMutation(unsigned mode,
+                                                   SystemCounter *other)
+{
+    auto *scope = crucible::OriginalNodeScope::selected();
+    if (!scope || !scope->diagnosticCallbackMutationAllowed())
+        return false;
+
+    // The real public wrapper copy API is exercised only on unqueued actual
+    // members. Corrupting a live event's links would not be an observation.
+    if (typeid(*this) != typeid(SystemCounter) || !other ||
+        typeid(*other) != typeid(SystemCounter) ||
+        _freqUpdateEvent.scheduled() || other->_freqUpdateEvent.scheduled())
+        return false;
+
+    switch (mode) {
+      case 0: {
+        if (other != this)
+            return false;
+        EventFunctionWrapper copy(_freqUpdateEvent);
+        _freqUpdateEvent = copy;
+        return true;
+      }
+      case 1:
+        if (other == this)
+            return false;
+        _freqUpdateEvent = other->_freqUpdateEvent;
+        return true;
+      case 2:
+        if (other == this)
+            return false;
+        _freqUpdateEvent = EventFunctionWrapper(FrequencyCallback(*other), name());
+        return true;
+      case 3:
+        if (other != this)
+            return false;
+        _freqUpdateEvent = EventFunctionWrapper([] {}, name());
+        return true;
+      case 4:
+        if (other != this)
+            return false;
+        _freqUpdateEvent = EventFunctionWrapper(std::function<void()>{}, name());
+        return true;
+      default:
+        return false;
+    }
 }
 
