+void
+Commit::crucibleState(CrucibleStateWriter &writer,
+                   const std::string &prefix) const
+{
+    writer.set(prefix + "._status", _status);
+    writer.set(prefix + "._nextStatus", _nextStatus);
+    writer.set(prefix + ".commitPolicy", commitPolicy);
+    writer.set(prefix + ".drainPending", drainPending);
+    writer.set(prefix + ".drainImminent", drainImminent);
+    writer.set(prefix + ".canHandleInterrupts", canHandleInterrupts);
+    writer.set(prefix + ".avoidQuiesceLiveLock", avoidQuiesceLiveLock);
+    writer.set(prefix + ".interrupt_present", interrupt != NoFault);
+    toIEW.crucibleState(writer, prefix + ".wire.to_iew", timeBuffer);
+    robInfoFromIEW.crucibleState(writer, prefix + ".wire.rob_from_iew", timeBuffer);
+    fromFetch.crucibleState(writer, prefix + ".wire.from_fetch", fetchQueue);
+    fromIEW.crucibleState(writer, prefix + ".wire.from_iew", iewQueue);
+    fromRename.crucibleState(writer, prefix + ".wire.from_rename", renameQueue);
+    size_t ordinal = 0;
+    for (const auto tid : priority_list)
+        writer.set(prefix + ".priority[" + std::to_string(ordinal++) + "]", tid);
+    writer.set(prefix + ".priority.count", ordinal);
+    for (ThreadID tid = 0; tid < numThreads; ++tid) {
+        const auto key = prefix + ".thread[" + std::to_string(tid) + "]";
+        writer.set(key + ".commitStatus", commitStatus[tid]);
+        writer.set(key + ".changedROBNumEntries", changedROBNumEntries[tid]);
+        writer.set(key + ".trapSquash", trapSquash[tid]);
+        writer.set(key + ".tcSquash", tcSquash[tid]);
+        writer.set(key + ".youngestSeqNum", youngestSeqNum[tid]);
+        writer.set(key + ".lastCommitedSeqNum", lastCommitedSeqNum[tid]);
+        writer.set(key + ".trapInFlight", trapInFlight[tid]);
+        writer.set(key + ".committedStores", committedStores[tid]);
+        writer.set(key + ".checkEmptyROB", checkEmptyROB[tid]);
+        writer.set(key + ".htmStarts", htmStarts[tid]);
+        writer.set(key + ".htmStops", htmStops[tid]);
+        cruciblePCReference(writer, key + ".architectural_pc", pc[tid].get());
+        crucibleInstructionReference(writer, key + ".squash_after", squashAfterInst[tid]);
+    }
+    writer.string(prefix + ".coverage.unsupported", "interrupt-fault-payload;trap-events;thread-context-and-htm-checkpoint;probes");
+}
