+    crucibleInstructionHandoff(writer, prefix, handoff);
+    for (ThreadID tid = 0; tid < MaxThreads; ++tid) {
+        const auto key = prefix + ".thread[" + std::to_string(tid) + "]";
+        crucibleInstructionReference(writer, key + ".mispredict", handoff.mispredictInst[tid]);
+        cruciblePCReference(writer, key + ".pc", handoff.pc[tid].get());
+        writer.set(key + ".mispredPC", handoff.mispredPC[tid]);
