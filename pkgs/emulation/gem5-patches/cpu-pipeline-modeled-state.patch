+void
+crucibleInstructionReference(CrucibleStateWriter &writer,
+                             const std::string &prefix, const DynInstPtr &inst)
+{
+    writer.reference(prefix + ".alias", inst.get(), "instruction");
+    writer.set(prefix + ".present", static_cast<bool>(inst));
+    if (inst) {
+        writer.set(prefix + ".sequence", inst->seqNum);
+        writer.set(prefix + ".thread", inst->threadNumber);
+        writer.string(prefix + ".cpu", inst->cpu->name());
+    }
+}
+
+void
+cruciblePCReference(CrucibleStateWriter &writer, const std::string &prefix,
+                   const PCStateBase *pc)
+{
+    writer.set(prefix + ".present", pc != nullptr);
+    if (pc) {
+        writer.set(prefix + ".instruction", pc->instAddr());
+        writer.set(prefix + ".micro_instruction", pc->microPC());
+        writer.string(prefix + ".type", typeid(*pc).name());
+        pc->crucibleFields(writer, prefix + ".semantic_state");
+    }
+}
+
+template<class Handoff>
+static void
+crucibleInstructionHandoff(CrucibleStateWriter &writer, const std::string &prefix,
+                           const Handoff &handoff)
+{
+    fatal_if(handoff.size < 0 || handoff.size > MaxWidth,
+             "Invalid instruction handoff size");
+    writer.set(prefix + ".size", handoff.size);
+    // Retained references outside the active prefix are visible as well.
+    for (size_t index = 0; index < MaxWidth; ++index)
+        crucibleInstructionReference(writer,
+            prefix + ".instruction[" + std::to_string(index) + "]", handoff.insts[index]);
+}
+
+void
+crucibleHandoff(CrucibleStateWriter &writer, const std::string &prefix,
+                const DecodeStruct &handoff)
+{
+    crucibleInstructionHandoff(writer, prefix, handoff);
+}
