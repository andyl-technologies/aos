+void
+crucibleHandoff(CrucibleStateWriter &writer, const std::string &prefix,
+                const RenameStruct &handoff)
+{
+    crucibleInstructionHandoff(writer, prefix, handoff);
+}
+
+void
+crucibleHandoff(CrucibleStateWriter &writer, const std::string &prefix,
