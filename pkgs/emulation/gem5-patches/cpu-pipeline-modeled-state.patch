+void
+MemDepUnit::crucibleState(CrucibleStateWriter &writer,
+                   const std::string &prefix) const
+{
+    writer.set(prefix + ".thread", id);
+    writer.string(prefix + ".instruction_queue", iqPtr ? iqPtr->name() : "");
+    depPred.crucibleState(writer, prefix + ".store_sets");
+    const auto list = [&](const std::string &name, const auto &instructions) {
+        writer.set(prefix + name + ".count", instructions.size());
+        size_t ordinal = 0;
+        for (const auto &inst : instructions)
+            crucibleInstructionReference(writer,
+                prefix + name + "[" + std::to_string(ordinal++) + "]", inst);
+    };
+    for (ThreadID tid = 0; tid < MaxThreads; ++tid)
+        list(".thread[" + std::to_string(tid) + "].instructions", instList[tid]);
+    list(".replay", instsToReplay);
+
+    // Integer-keyed hash iteration is retained because native insertion can
+    // copy barrier iteration into its future dependency traversal order.
+    const auto barriers = [&](const std::string &name, const auto &sequences) {
+        writer.set(prefix + name + ".count", sequences.size());
+        writer.set(prefix + name + ".buckets", sequences.bucket_count());
+        size_t ordinal = 0;
+        for (const auto sequence : sequences)
+            writer.set(prefix + name + "[" + std::to_string(ordinal++) + "]", sequence);
+    };
+    barriers(".load_barriers", loadBarrierSNs);
+    barriers(".store_barriers", storeBarrierSNs);
+    writer.set(prefix + ".hash.count", memDepHash.size());
+    writer.set(prefix + ".hash.buckets", memDepHash.bucket_count());
+    fatal_if(memDepHash.size() > 65536, "Memory dependency roster exceeds diagnostic ceiling");
+    std::vector<MemDepEntryPtr> pending;
+    std::unordered_set<const MemDepEntry *> seen;
+    pending.reserve(memDepHash.size());
+    size_t ordinal = 0;
+    for (const auto &[sequence, entry] : memDepHash) {
+        const auto key = prefix + ".hash[" + std::to_string(ordinal++) + "]";
+        writer.set(key + ".sequence", sequence);
+        writer.reference(key + ".entry", entry.get(), "memory-dependency-entry");
+        if (entry && seen.emplace(entry.get()).second)
+            pending.push_back(entry);
+    }
+
+    // Dependents may outlive their hash membership. A bounded breadth-first
+    // walk preserves every retained shared entry without recursive cycles.
+    for (size_t index = 0; index < pending.size(); ++index) {
+        const auto entry = pending[index];
+        const auto key = prefix + ".entry[" + std::to_string(index) + "]";
+        writer.reference(key + ".identity", entry.get(), "memory-dependency-entry");
+        crucibleInstructionReference(writer, key + ".instruction", entry->inst);
+        writer.set(key + ".registers_ready", entry->regsReady);
+        writer.set(key + ".dependencies_remaining", entry->memDeps);
+        writer.set(key + ".completed", entry->completed);
+        writer.set(key + ".squashed", entry->squashed);
+        writer.set(key + ".dependent_count", entry->dependInsts.size());
+        size_t dependent_index = 0;
+        for (const auto &dependent : entry->dependInsts) {
+            writer.reference(key + ".dependent[" + std::to_string(dependent_index++) + "]",
+                             dependent.get(), "memory-dependency-entry");
+            if (dependent && seen.emplace(dependent.get()).second) {
+                fatal_if(pending.size() >= 65536, "Memory dependency closure exceeds diagnostic ceiling");
+                pending.push_back(dependent);
+            }
+        }
+    }
+    writer.set(prefix + ".entry.count", pending.size());
+    writer.string(prefix + ".coverage.unsupported", "unordered-container-load-policy-and-iterator-lineage;probes");
