+        writer.set(key + ".renameStatus", renameStatus[tid]);
+        writer.set(key + ".instsInProgress", instsInProgress[tid]);
+        writer.set(key + ".loadsInProgress", loadsInProgress[tid]);
+        writer.set(key + ".storesInProgress", storesInProgress[tid]);
+        writer.set(key + ".emptyROB", emptyROB[tid]);
+        writer.set(key + ".serializeOnNextInst", serializeOnNextInst[tid]);
+        writer.set(key + ".stall.iew", stalls[tid].iew);
+        writer.set(key + ".stall.commit", stalls[tid].commit);
+        writer.set(key + ".free.iq", freeEntries[tid].iqEntries);
+        writer.set(key + ".free.rob", freeEntries[tid].robEntries);
+        writer.set(key + ".free.load", freeEntries[tid].lqEntries);
+        writer.set(key + ".free.store", freeEntries[tid].sqEntries);
+        crucibleInstructionReference(writer, key + ".serializing_instruction", serializeInst[tid]);
+        writer.set(key + ".input.count", insts[tid].size());
+        {
+            size_t ordinal = 0;
+            for (const auto &inst : insts[tid])
+                crucibleInstructionReference(writer, key + ".input[" + std::to_string(ordinal++) + "]", inst);
+        }
+        writer.set(key + ".skid.count", skidBuffer[tid].size());
+        {
+            size_t ordinal = 0;
+            for (const auto &inst : skidBuffer[tid])
+                crucibleInstructionReference(writer, key + ".skid[" + std::to_string(ordinal++) + "]", inst);
+        }
+
+        size_t ordinal = 0;
+        for (const auto &history : historyBuffer[tid]) {
+            const auto item = key + ".history[" + std::to_string(ordinal++) + "]";
+            writer.set(item + ".sequence", history.instSeqNum);
+            writer.set(item + ".architectural_class", history.archReg.classValue());
+            writer.set(item + ".architectural_index", history.archReg.index());
+            writer.set(item + ".architectural_pinned_writes", history.archReg.getNumPinnedWrites());
+            writer.set(item + ".new_physical", history.newPhysReg->flatIndex());
+            writer.set(item + ".previous_physical", history.prevPhysReg->flatIndex());
+        }
+        writer.set(key + ".history.count", ordinal);
+        ordinal = 0;
+        for (const auto *id : freeingInProgress[tid])
+            writer.set(key + ".freeing[" + std::to_string(ordinal++) + "]", id->flatIndex());
+        writer.set(key + ".freeing.count", ordinal);
+    }
+}
 
