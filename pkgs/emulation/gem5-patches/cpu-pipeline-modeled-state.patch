+    toRename.crucibleState(writer, prefix + ".wire.to_rename", decodeQueue);
+    fromFetch.crucibleState(writer, prefix + ".wire.from_fetch", fetchQueue);
+    for (ThreadID tid = 0; tid < numThreads; ++tid) {
+        const auto key = prefix + ".thread[" + std::to_string(tid) + "]";
+        writer.set(key + ".decodeStatus", decodeStatus[tid]);
+        writer.set(key + ".bdelayDoneSeqNum", bdelayDoneSeqNum[tid]);
