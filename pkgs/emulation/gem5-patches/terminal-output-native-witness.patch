+#include "dev/serial/crucible_terminal_witness.hh"
+
+#include "params/CrucibleTerminalWitness.hh"
+#include "sim/simulate.hh"
+
+namespace gem5
+{
+
+CrucibleTerminalWitness::CrucibleTerminalWitness(
+    const CrucibleTerminalWitnessParams &params)
+    : SimObject(params), terminal(*params.terminal),
+      publicationEvent([this] {
+          terminal.writeData('A');
+          terminal.writeData(0);
+          terminal.writeData('B');
+      }, name() + ".publication")
+{
+}
+
+bool
+CrucibleTerminalWitness::scheduleWrites(Tick tick)
+{
+    if (crucibleModelIsExecuting() || publicationEvent.scheduled() || tick <= curTick())
+        return false;
+    schedule(publicationEvent, tick);
+    return true;
+}
+
+} // namespace gem5
