+std::vector<std::vector<uint64_t>>
+Terminal::crucibleOutputInventory() const
+{
+    crucibleRequireStopped();
+    std::vector<std::vector<uint64_t>> result;
+    result.reserve(crucibleRetainedOutput.size());
+    // One callback may emit several bytes. Reading the complete original FIFO
+    // must not require releasing any byte before the external receipt ACK.
+    for (const auto &output : crucibleRetainedOutput) {
+        result.push_back({output.identifier, output.birth.tick,
+                          output.birth.ordinal, output.birth.tickOrdinal,
+                          output.parent, output.byte});
+    }
+    return result;
+}
