+def crucibleDeviceStateInventory(selected_names):
+    """Returns explicitly selected partial native device diagnostics at a parked cut.
+
+    Unselected CPU/RAM/object bodies are omitted, never declared complete. Exact
+    preservation separately requires the actual whole opaque native capture audit.
+    """
+    if not isinstance(selected_names, list) or not 0 < len(selected_names) <= 16:
+        raise ValueError("device diagnostic names exceed finite source scope")
+    return _m5_event.crucibleDeviceStateInventory(selected_names)
+
