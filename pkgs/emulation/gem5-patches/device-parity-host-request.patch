+#ifndef __DEV_VIRTIO_HOST_REQUEST_HH__
+#define __DEV_VIRTIO_HOST_REQUEST_HH__
+
+#include <deque>
+#include <string>
+#include <vector>
+
+#include "dev/virtio/base.hh"
+#include "sim/eventq.hh"
+
+namespace gem5
+{
+
+struct VirtIOHostRequestParams;
+
+/** Retains original guest requests until sealed replies and custody retirement. */
+class VirtIOHostRequest : public VirtIODeviceBase
+{
+  public:
+    explicit VirtIOHostRequest(const VirtIOHostRequestParams &params);
+    void readConfig(PacketPtr pkt, Addr offset) override;
+    void serialize(CheckpointOut &cp) const override;
+    void unserialize(CheckpointIn &cp) override;
+
+    bool setExecutionParent(uint64_t parent);
+    std::vector<uint64_t> pendingRequestMetadata() const;
+    std::vector<uint8_t> pendingRequestBytes() const;
+    /** Returns actual completed DMA birth and bytes without custody authority. */
+    std::vector<uint64_t> pendingCompletionMetadata() const;
+    bool acknowledgeRequest(uint64_t id);
+    bool stageReply(uint64_t id, Tick tick, uint64_t parent, uint8_t status,
+                    const std::vector<uint8_t> &payload);
+    bool retireCompleted(uint64_t id);
+
+  private:
+    struct Span
+    {
+        Addr address;
+        uint32_t length;
+    };
+
+    struct Request
+    {
+        uint64_t id;
+        Tick birthTick;
+        uint64_t birthOrdinal;
+        uint64_t birthTickOrdinal;
+        uint64_t parent;
+        uint32_t opcode;
+        uint64_t sector;
+        uint16_t tag;
+        uint16_t head;
+        uint64_t queueIncarnation;
+        size_t payloadBytes;
+        std::vector<uint8_t> bytes;
+        std::vector<Span> writable;
+        bool acknowledged = false;
+        bool replyStaged = false;
+        bool completed = false;
+        Tick replyTick = 0;
+        uint64_t replyParent = 0;
+        uint8_t status = 0;
+        Tick completionTick = 0;
+        uint64_t completionOrdinal = 0;
+        uint64_t completionTickOrdinal = 0;
+        uint64_t completionParent = 0;
+        size_t writtenBytes = 0;
+        std::vector<uint8_t> reply;
+    };
+
+    class Queue : public VirtQueue
+    {
+      public:
+        Queue(PortProxy &proxy, uint16_t size, VirtIOHostRequest &device);
+        void onNotify() override;
+      private:
+        VirtIOHostRequest &device;
+    };
+
+    void collectRequests();
+    Request decode(VirtDescriptor *head) const;
+    void completeDue();
+    void scheduleReplies();
+    size_t writeReply(const Request &request);
+
+    const bool block;
+    const unsigned requestCapacity;
+    const unsigned maximumPayloadBytes;
+    const uint64_t capacitySectors;
+    std::vector<uint8_t> configuration;
+    PortProxy &memory;
+    Queue queue;
+    EventFunctionWrapper replyEvent;
+    EventFunctionWrapper creditEvent;
+    std::deque<Request> requests;
+    uint64_t nextRequest = 1;
+    uint64_t retiredThrough = 0;
+    uint64_t executionParent = 0;
+};
+
+} // namespace gem5
+#endif
