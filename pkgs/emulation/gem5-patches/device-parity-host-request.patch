+"""Finite asynchronous block/9p frontend, with no host file or socket handles."""
+from m5.objects.VirtIO import VirtIODeviceBase
+from m5.params import Param
+from m5.SimObject import PyBindMethod
+
+
+class VirtIOHostRequest(VirtIODeviceBase):
+    type = "VirtIOHostRequest"
+    cxx_header = "dev/virtio/host_request.hh"
+    cxx_class = "gem5::VirtIOHostRequest"
+    cxx_exports = [
+        PyBindMethod("setExecutionParent"),
+        PyBindMethod("pendingRequestMetadata"),
+        PyBindMethod("pendingRequestBytes"),
+        PyBindMethod("pendingCompletionMetadata"),
+        PyBindMethod("acknowledgeRequest"),
+        PyBindMethod("stageReply"),
+        PyBindMethod("retireCompleted"),
+    ]
+    kind = Param.String("block", "Device kind: block or 9p")
+    queue_size = Param.Unsigned(128, "Finite power-of-two split-ring descriptors")
+    request_capacity = Param.Unsigned(128, "Retained requests including completions")
+    maximum_payload_bytes = Param.Unsigned(1048576, "Maximum request or reply bytes")
+    capacity_sectors = Param.UInt64(0, "Immutable block capacity in 512-byte sectors")
+    mount_tag = Param.String("crucible", "Immutable 9p mount tag")
