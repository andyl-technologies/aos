+        };
+        fatal_if((_numSrcRegs && !_srcRegIdxPtr) || (_numDestRegs && !_destRegIdxPtr),
+                 "Instruction metadata has missing operand arrays");
+        for (size_t index = 0; index < _numSrcRegs; ++index)
+            reg(prefix + ".source[" + std::to_string(index) + "]", srcRegIdx(index));
+        for (size_t index = 0; index < _numDestRegs; ++index)
+            reg(prefix + ".destination[" + std::to_string(index) + "]", destRegIdx(index));
+    }
