+#include "dev/virtio/queue_witness.hh"
+
+#include <array>
+
+#include "base/logging.hh"
+#include "dev/virtio/base.hh"
+#include "params/VirtIOQueueWitness.hh"
+#include "sim/system.hh"
+
+namespace gem5
+{
+
+VirtIOQueueWitness::VirtIOQueueWitness(const VirtIOQueueWitnessParams &params)
+    : SimObject(params), system(*params.system)
+{
+}
+
+std::vector<uint64_t>
+VirtIOQueueWitness::run(const std::string &test)
+{
+    class Queue : public VirtQueue
+    {
+      public:
+        explicit Queue(PortProxy &proxy)
+            : VirtQueue(proxy, ByteOrder::little, 8), checksum(0) {}
+
+        void onNotifyDescriptor(VirtDescriptor *desc) override
+        {
+            std::array<uint8_t, 4> payload{};
+            desc->chainRead(0, payload.data(), payload.size());
+            for (uint8_t value : payload)
+                checksum += value;
+            produceDescriptor(desc, 0);
+        }
+
+        uint64_t checksum;
+    } queue(system.physProxy);
+
+    if (test == "invalid-size") {
+        queue.setSize(3);
+        panic("Invalid queue size was accepted");
+    }
+    if (test == "oversized-queue") {
+        queue.setSize(16);
+        panic("Oversized queue was accepted");
+    }
+
+    if (test == "legacy-wrap") {
+        queue.setAddress(0xfffffffffffff000ULL);
+        panic("Wrapped legacy ring was accepted");
+    }
+
+    const bool legacy = test == "legacy";
+    if (legacy) {
+        queue.setAddress(0x1000);
+    } else {
+        queue.setSize(2);
+        queue.setModernAddress(0, test == "unaligned" ? 0x1001 : test == "ring-wrap" ? 0xfffffffffffffff0ULL : 0x1000);
+        queue.setModernAddress(1, 0x3000);
+        queue.setModernAddress(2, 0x7000);
+        // An unpublished queue must not even read a guest ring.
+        panic_if(queue.consumeDescriptor(), "Disabled queue consumed a chain");
+        queue.setReady(true);
+    }
+    if (test == "live-reprogram") {
+        queue.setModernAddress(0, 0x2000);
+        panic("Ready queue was reprogrammed");
+    }
+
+    const std::array<uint8_t, 4> payload{1, 3, 7, 11};
+    system.physProxy.writeBlob(0x9000, payload.data(), payload.size());
+    vring_desc descriptor{};
+    descriptor.addr = htole(uint64_t(0x9000));
+    descriptor.len = htole(uint32_t(payload.size()));
+    if (test == "buffer-wrap")
+        descriptor.addr = htole(uint64_t(0xfffffffffffffffeULL));
+    if (test == "cycle") {
+        descriptor.flags = htole(uint16_t(VRING_DESC_F_NEXT));
+        descriptor.next = htole(uint16_t(1));
+    }
+    if (test == "indirect")
+        descriptor.flags = htole(uint16_t(VRING_DESC_F_INDIRECT));
+    system.physProxy.writeBlob(queue.getAddress() + sizeof(vring_desc),
+                               &descriptor, sizeof(descriptor));
+
+    // Avail and used rings deliberately reside in noncontiguous memory.
+    const uint16_t flags = 0;
+    const uint16_t available = htole(uint16_t(test == "overrun" ? 9 : 1));
+    const uint16_t head = htole(uint16_t(test == "invalid-index" ? 8 : 1));
+    system.physProxy.writeBlob(queue.driverAddress(), &flags, sizeof(flags));
+    system.physProxy.writeBlob(queue.driverAddress() + 2, &available,
+                               sizeof(available));
+    system.physProxy.writeBlob(queue.driverAddress() + 4, &head, sizeof(head));
+    const std::array<uint8_t, 16> zero{};
+    system.physProxy.writeBlob(queue.deviceAddress(), zero.data(), zero.size());
+    if (test == "guest-used-index") {
+        const uint16_t forgedIndex = htole(uint16_t(7));
+        system.physProxy.writeBlob(queue.deviceAddress() + 2, &forgedIndex,
+                                   sizeof(forgedIndex));
+    }
+    queue.onNotify();
+
+    uint16_t usedIndex;
+    vring_used_elem used{};
+    system.physProxy.readBlob(queue.deviceAddress() + 2, &usedIndex,
+                              sizeof(usedIndex));
+    system.physProxy.readBlob(queue.deviceAddress() + 4, &used, sizeof(used));
+    return {queue.checksum, letoh(usedIndex), letoh(used.id), letoh(used.len),
+            queue.getSize(), queue.consumeDescriptor() == nullptr};
+}
+
+} // namespace gem5
