+static constexpr size_t CrucibleMaxDescriptors = 1024;
+static DmtcpCrucibleCapturedFd crucibleDescriptors[CrucibleMaxDescriptors];
+static int crucibleDescriptorCount = -1;
+
+static void
+crucibleRecordDescriptors()
+{
+  crucibleDescriptorCount = -1;
+  DIR *directory = _real_opendir("/proc/self/fd");
+  JASSERT(directory != NULL);
+  const int censusFd = dirfd(directory);
+  size_t count = 0;
+  while (struct dirent *entry = readdir(directory)) {
+    if (entry->d_name[0] == '.')
+      continue;
+    char *end = NULL;
+    const long fd = strtol(entry->d_name, &end, 10);
+    JASSERT(end && *end == '\0' && fd >= 0 && fd <= INT_MAX);
+    if (fd == censusFd)
+      continue;
+    JASSERT(count < CrucibleMaxDescriptors);
+    auto &record = crucibleDescriptors[count++];
+    memset(&record, 0, sizeof(record));
+    record.fd = fd;
+    const long descriptorFlags = _real_syscall(SYS_fcntl, fd, F_GETFD);
+    const long statusFlags = _real_syscall(SYS_fcntl, fd, F_GETFL);
+    JASSERT(descriptorFlags >= 0 && statusFlags >= 0);
+    record.descriptorFlags = descriptorFlags;
+    record.statusFlags = statusFlags;
+    struct stat metadata;
+    JASSERT(_real_syscall(SYS_fstat, fd, &metadata) == 0);
+    record.mode = metadata.st_mode;
+    record.device = metadata.st_dev;
+    record.inode = metadata.st_ino;
+    record.size = metadata.st_size;
+    record.links = metadata.st_nlink;
+    record.position = _real_syscall(SYS_lseek, fd, 0, SEEK_CUR);
+    record.protectedDescriptor = dmtcp_is_protected_fd(fd);
+    char path[64];
+    const int length = snprintf(path, sizeof(path), "/proc/self/fd/%ld", fd);
+    JASSERT(length > 0 && length < (int)sizeof(path));
+    const ssize_t targetLength = _real_readlink(path, record.target,
+                                              sizeof(record.target) - 1);
+    JASSERT(targetLength >= 0 && targetLength < (ssize_t)sizeof(record.target));
+  }
+  JASSERT(_real_closedir(directory) == 0);
+  crucibleDescriptorCount = count;
+}
+
+extern "C" int
+dmtcp_crucible_checkpoint_fd_count(void)
+{
+  return crucibleDescriptorCount;
+}
+
+extern "C" int
+dmtcp_crucible_checkpoint_fd(int index, uint64_t *address,
+                           void *bytes, size_t capacity)
+{
+  if (index < 0 || index >= crucibleDescriptorCount || !address || !bytes ||
+      capacity < sizeof(DmtcpCrucibleCapturedFd)) {
+    return -1;
+  }
+  const auto &record = crucibleDescriptors[index];
+  *address = (uint64_t)&record;
+  memcpy(bytes, &record, sizeof(record));
+  return sizeof(record);
+}
 
