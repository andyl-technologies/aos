+static constexpr size_t CrucibleMaxMappings = 8192;
+static constexpr size_t CrucibleAreaPrefixBytes = 1112;
+static Area crucibleMappings[CrucibleMaxMappings];
+static int crucibleMappingCount = -1;
+
+extern "C" int
+dmtcp_crucible_checkpoint_map_count(void)
+{
+  return crucibleMappingCount;
+}
+
+extern "C" int
+dmtcp_crucible_checkpoint_map(int index, uint64_t *address,
+                            void *bytes, size_t capacity)
+{
+  if (index < 0 || index >= crucibleMappingCount || !address || !bytes ||
+      capacity < CrucibleAreaPrefixBytes) {
+    return -1;
+  }
+  const auto &record = crucibleMappings[index];
+  *address = (uint64_t)&record;
+  memcpy(bytes, &record, CrucibleAreaPrefixBytes);
+  return CrucibleAreaPrefixBytes;
+}
