 __thread Thread *curThread ATTR_TLS_INITIAL_EXEC = NULL;
 Thread *ckptThread = NULL;
 
+// Captured while every application thread is suspended. The bounded ledger
+// lives in checkpointed private memory and is unchanged by resume/restart.
+static constexpr size_t CrucibleMaxThreads = 256;
+struct CrucibleThreadContext {
+  uint64_t address;
+  uint32_t realTid;
+  int state;
+  int role;
+  unsigned char bytes[sizeof(Thread)];
+};
+static CrucibleThreadContext crucibleContexts[CrucibleMaxThreads];
+static int crucibleContextCount = -1;
+
+static void
+crucibleRecordThreadContexts()
+{
+  crucibleContextCount = -1;
+  size_t count = 0;
+  for (Thread *thread = activeThreads; thread != NULL; thread = thread->next) {
+    JASSERT(count < CrucibleMaxThreads);
+    JASSERT(thread == ckptThread || thread->state == ST_SUSPENDED);
+    auto &record = crucibleContexts[count++];
+    record.address = (uint64_t)thread;
+    record.realTid = thread->tid;
+    record.state = thread->state;
+    record.role = thread == ckptThread ? 1 : 0;
+    memcpy(record.bytes, thread, sizeof(Thread));
+  }
+  JASSERT(count > 0);
+  crucibleContextCount = (int)count;
+}
+
+extern "C" int
+dmtcp_crucible_checkpoint_thread_count(void)
+{
+  return crucibleContextCount;
+}
+
+extern "C" int
+dmtcp_crucible_checkpoint_thread(int index, uint64_t *address,
+                               uint32_t *real_tid, int *state, int *role,
+                               void *bytes, size_t capacity)
+{
+  if (index < 0 || index >= crucibleContextCount || !address || !real_tid ||
+      !state || !role || !bytes || capacity < sizeof(Thread)) {
+    return -1;
+  }
+  const auto &record = crucibleContexts[index];
+  *address = record.address;
+  *real_tid = record.realTid;
+  *state = record.state;
+  *role = record.role;
+  memcpy(bytes, record.bytes, sizeof(Thread));
+  return sizeof(Thread);
+}
