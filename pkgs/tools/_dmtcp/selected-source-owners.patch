+// SPDX-License-Identifier: LGPL-3.0-or-later
+// Copyright (c) 2026 Andyl, Inc.
+#ifndef DMTCP_CRUCIBLE_ORIGINAL_SHARED_AREA_H
+#define DMTCP_CRUCIBLE_ORIGINAL_SHARED_AREA_H
+
+#include "crucible_raw_kernel_call.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <fcntl.h>
+#include <sys/stat.h>
+
+#include <sys/mman.h>
+
+namespace dmtcp_crucible::original_shared_area
+{
+
+using raw_kernel_call::kernelCall;
+
+/** Retains actual source creation effects, rather than a descriptor census.
+ *
+ * Every scalar is preservation data. A native source issuer must separately
+ * authenticate its original constructor/exec custody and whole process cut.
+ * This record cannot authorize a new open, mapping, branch or native Ready.
+ */
+struct OriginalRecord
+{
+  std::uint64_t process = 0;
+  std::uint64_t uid = 0;
+  std::uint64_t gid = 0;
+  std::uint64_t storageBytes = 0;
+  std::uint64_t device = 0;
+  std::uint64_t inode = 0;
+  std::uint64_t mappingBytes = 0;
+  std::uint64_t fileBytes = 0;
+  std::uint64_t mappingAddress = 0;
+  std::uint64_t libraryMappingAddress = 0;
+  std::uint64_t mappingSlotsReserved = 0;
+  std::uint64_t mappingStorageReserved = 0;
+  std::int64_t sourceDescriptor = -1;
+  std::int64_t protectedDescriptor = -1;
+  std::uint64_t openAttempt = 0;
+  std::uint64_t resizeAttempt = 0;
+  std::uint64_t duplicateAttempt = 0;
+  std::uint64_t closeAttempt = 0;
+  std::uint64_t mappingAttempt = 0;
+  bool openCompleted = false;
+  bool resizeCompleted = false;
+  bool duplicateCompleted = false;
+  bool closeCompleted = false;
+  bool closeUnknown = false;
+  bool mappingCompleted = false;
+  bool headerCompleted = false;
+  bool libraryMappingCompleted = false;
+  bool execImported = false;
+  bool refused = false;
+};
+
+/** Owns the selected launcher's initial shared-area creation before effects. */
+class OriginalSharedArea
+{
+public:
+  static constexpr int DescriptorLimit = 1024;
+  static constexpr std::size_t MappingLimit = 32 * 1024 * 1024;
+
+  OriginalSharedArea()
+      : ownerProcess(kernelCall(SYS_getpid)),
+        ownerUid(kernelCall(SYS_geteuid)), ownerGid(kernelCall(SYS_getegid))
+  {
+    authenticateOwner();
+  }
+  OriginalSharedArea(const OriginalSharedArea &) = delete;
+  OriginalSharedArea &operator=(const OriginalSharedArea &) = delete;
+
+  /** Consumes the sole creation before open and refuses an inherited alias. */
+  bool begin(std::size_t bytes, int protectedDescriptor)
+  {
+    authenticateOwner();
+    if (record.openAttempt || importConsumed || record.refused) {
+      if (record.openAttempt) current();
+      return refuse();
+    }
+    record.openAttempt = 1;
+    const long process = kernelCall(SYS_getpid);
+    const long uid = kernelCall(SYS_geteuid);
+    const long gid = kernelCall(SYS_getegid);
+    record.process = process;
+    record.uid = uid;
+    record.gid = gid;
+    record.storageBytes = sizeof(*this);
+    if (process <= 0 || uid < 0 || gid < 0 || kernelCall(SYS_gettid) != process ||
+        bytes == 0 || bytes > MappingLimit || bytes % 4096 != 0 ||
+        protectedDescriptor < 0 || protectedDescriptor >= DescriptorLimit ||
+        kernelCall(SYS_fcntl, protectedDescriptor, F_GETFD) != -9)
+      return refuse();
+
+    record.mappingBytes = bytes;
+    record.mappingSlotsReserved = 2;
+    record.mappingStorageReserved = 2 * bytes;
+    record.protectedDescriptor = protectedDescriptor;
+    return true;
+  }
+
+  /** Creates a new file exclusively; an existing pathname is never adopted. */
+  int openOriginal(const char *path)
+  {
+    if (!current() || record.openAttempt != 1 || record.openCompleted || !path)
+      return failedDescriptor();
+    const long descriptor = kernelCall(SYS_openat, AT_FDCWD,
+        reinterpret_cast<long>(path), O_RDWR | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+    record.sourceDescriptor = descriptor;
+    if (descriptor < 0) return failedDescriptor();
+
+    struct stat actual{};
+    if (kernelCall(SYS_fstat, descriptor, reinterpret_cast<long>(&actual)) != 0 ||
+        !S_ISREG(actual.st_mode) || (actual.st_mode & 07777) != 0600 ||
+        actual.st_nlink != 1 || actual.st_uid != record.uid || actual.st_size != 0)
+      return failedDescriptor();
+
+    record.device = actual.st_dev;
+    record.inode = actual.st_ino;
+    record.openCompleted = true;
+    return int(descriptor);
+  }
+
+  /** Extends the held original file, without resolving its pathname again. */
+  bool extendOriginal()
+  {
+    if (!current() || !record.openCompleted || record.resizeAttempt) return refuse();
+    record.resizeAttempt = 1;
+    if (kernelCall(SYS_ftruncate, record.sourceDescriptor, record.mappingBytes) != 0 ||
+        !fileCurrent(record.sourceDescriptor, record.mappingBytes))
+      return refuse();
+
+    record.fileBytes = record.mappingBytes;
+    record.resizeCompleted = true;
+    return true;
+  }
+
+  /** Retains the exact duplicate and one-way source-descriptor retirement. */
+  bool transferOriginal()
+  {
+    if (!current() || !record.resizeCompleted || record.duplicateAttempt ||
+        !fileCurrent(record.sourceDescriptor, record.fileBytes))
+      return refuse();
+    record.duplicateAttempt = 1;
+    if (record.sourceDescriptor != record.protectedDescriptor &&
+        kernelCall(SYS_fcntl, record.protectedDescriptor, F_GETFD) != -9)
+      return refuse();
+    if (kernelCall(SYS_dup2, record.sourceDescriptor, record.protectedDescriptor) !=
+        record.protectedDescriptor ||
+        !fileCurrent(record.protectedDescriptor, record.fileBytes))
+      return refuse();
+    record.duplicateCompleted = true;
+
+    const long flags = kernelCall(SYS_fcntl, record.protectedDescriptor, F_GETFD);
+    if (flags < 0 || kernelCall(SYS_fcntl, record.protectedDescriptor,
+                                F_SETFD, flags & ~FD_CLOEXEC) != 0)
+      return refuse();
+
+    if (record.sourceDescriptor != record.protectedDescriptor) {
+      record.closeAttempt = 1;
+      const int original = int(record.sourceDescriptor);
+      record.sourceDescriptor = -1;
+      if (kernelCall(SYS_close, original) != 0) {
+        record.closeUnknown = true;
+        return refuse();
+      }
+      record.closeCompleted = true;
+    }
+    return true;
+  }
+
+  /** Consumes original mapping storage before the source mmap call. */
+  bool beginMapping()
+  {
+    authenticateOwner();
+    const std::uint64_t expectedAttempt = record.execImported ? 1 : 0;
+    if (!current() || !record.duplicateCompleted ||
+        record.mappingAttempt != expectedAttempt ||
+        record.mappingSlotsReserved != 2 ||
+        record.mappingStorageReserved != 2 * record.mappingBytes ||
+        !fileCurrent(record.protectedDescriptor, record.fileBytes))
+      return refuse();
+    ++record.mappingAttempt;
+    return true;
+  }
+
+  bool mappedOriginal(void *actual)
+  {
+    authenticateOwner();
+    const bool library = record.execImported;
+    if (!current() || record.mappingAttempt != (library ? 2u : 1u) ||
+        (library ? record.libraryMappingCompleted : record.mappingCompleted) ||
+        actual == nullptr || actual == MAP_FAILED ||
+        reinterpret_cast<std::uintptr_t>(actual) % 4096 != 0)
+      return refuse();
+    if (library) {
+      record.libraryMappingAddress = reinterpret_cast<std::uintptr_t>(actual);
+      record.libraryMappingCompleted = true;
+    } else {
+      record.mappingAddress = reinterpret_cast<std::uintptr_t>(actual);
+      record.mappingCompleted = true;
+    }
+    return true;
+  }
+
+  /** Joins the actual header writer's existing final one-byte file extension. */
+  bool headerWritten()
+  {
+    if (!current() || !record.mappingCompleted || record.headerCompleted ||
+        !fileCurrent(record.protectedDescriptor, record.mappingBytes + 1))
+      return refuse();
+    record.fileBytes = record.mappingBytes + 1;
+    record.headerCompleted = true;
+    return true;
+  }
+
+  /** Observes current exec preservation; this does not issue a native cut. */
+  bool observeExec() const
+  {
+    if (!current()) return false;
+    return record.execImported && record.libraryMappingCompleted &&
+        record.mappingAttempt == 2 && record.headerCompleted &&
+        fileCurrent(record.protectedDescriptor, record.fileBytes);
+  }
+
+  const OriginalRecord &originalRecord() const
+  {
+    authenticateOwner();
+    return record;
+  }
+
+  /** Imports full original preservation data on the SAME kernel exec lineage.
+   *
+   * The selected exec receiver authenticates its original inherited journal
+   * and whole descriptor census first. This import cannot issue a cut or
+   * adopt a restored process; changed PID, aliases and renewed counters refuse.
+   */
+  bool importExecPreservation(const OriginalRecord &preserved)
+  {
+    authenticateOwner();
+    if (importConsumed || record.openAttempt || record.refused) return refuse();
+    importConsumed = true;
+    const long process = kernelCall(SYS_getpid);
+    if (process <= 0 || kernelCall(SYS_gettid) != process ||
+        preserved.process != std::uint64_t(process) ||
+        preserved.uid != std::uint64_t(kernelCall(SYS_geteuid)) ||
+        preserved.gid != std::uint64_t(kernelCall(SYS_getegid)) ||
+        preserved.storageBytes != sizeof(*this) || preserved.refused || preserved.closeUnknown ||
+        preserved.execImported || !preserved.openCompleted || !preserved.resizeCompleted ||
+        !preserved.duplicateCompleted || !preserved.mappingCompleted || !preserved.headerCompleted ||
+        preserved.openAttempt != 1 || preserved.resizeAttempt != 1 ||
+        preserved.duplicateAttempt != 1 || preserved.mappingAttempt != 1 ||
+        preserved.mappingSlotsReserved != 2 || preserved.mappingBytes == 0 ||
+        preserved.mappingBytes > MappingLimit || preserved.mappingBytes % 4096 != 0 ||
+        preserved.mappingStorageReserved != 2 * preserved.mappingBytes ||
+        preserved.fileBytes != preserved.mappingBytes + 1 ||
+        !preserved.mappingAddress || preserved.mappingAddress % 4096 != 0 ||
+        preserved.libraryMappingAddress || preserved.libraryMappingCompleted ||
+        (preserved.sourceDescriptor == -1 &&
+         (preserved.closeAttempt != 1 || !preserved.closeCompleted)) ||
+        (preserved.sourceDescriptor != -1 &&
+         (preserved.sourceDescriptor != preserved.protectedDescriptor ||
+          preserved.closeAttempt != 0 || preserved.closeCompleted)))
+      return refuse();
+
+    struct stat actual{};
+    if (preserved.protectedDescriptor < 0 ||
+        preserved.protectedDescriptor >= DescriptorLimit ||
+        kernelCall(SYS_fstat, preserved.protectedDescriptor, reinterpret_cast<long>(&actual)) != 0 ||
+        !S_ISREG(actual.st_mode) || (actual.st_mode & 07777) != 0600 ||
+        actual.st_uid != preserved.uid || actual.st_nlink != 1 ||
+        actual.st_dev != preserved.device || actual.st_ino != preserved.inode ||
+        actual.st_size != std::int64_t(preserved.fileBytes) ||
+        kernelCall(SYS_fcntl, preserved.protectedDescriptor, F_GETFD) != 0 ||
+        (kernelCall(SYS_fcntl, preserved.protectedDescriptor, F_GETFL) & O_ACCMODE) != O_RDWR)
+      return refuse();
+
+    // Preserve every earlier debit and original mapping address. The library
+    // consumes the second constructor-reserved slot; no balance is reset.
+    record = preserved;
+    record.execImported = true;
+    return true;
+  }
+
+private:
+  void authenticateOwner() const
+  {
+    if (ownerProcess <= 0 || kernelCall(SYS_getpid) != ownerProcess ||
+        kernelCall(SYS_gettid) != ownerProcess ||
+        kernelCall(SYS_geteuid) != ownerUid || kernelCall(SYS_getegid) != ownerGid) {
+      kernelCall(SYS_exit_group, 125);
+      __builtin_unreachable();
+    }
+  }
+
+  bool current() const
+  {
+    authenticateOwner();
+    if (record.openAttempt && (kernelCall(SYS_getpid) != long(record.process) ||
+        kernelCall(SYS_gettid) != long(record.process) ||
+        kernelCall(SYS_geteuid) != long(record.uid) ||
+        kernelCall(SYS_getegid) != long(record.gid))) {
+      kernelCall(SYS_exit_group, 125);
+      __builtin_unreachable();
+    }
+    return record.openAttempt && !record.refused && !record.closeUnknown;
+  }
+
+  bool fileCurrent(int descriptor, std::uint64_t bytes) const
+  {
+    struct stat actual{};
+    return descriptor >= 0 &&
+        kernelCall(SYS_fstat, descriptor, reinterpret_cast<long>(&actual)) == 0 &&
+        actual.st_dev == record.device && actual.st_ino == record.inode &&
+        actual.st_uid == record.uid && (actual.st_mode & 07777) == 0600 &&
+        actual.st_nlink == 1 && actual.st_size == std::int64_t(bytes);
+  }
+
+  bool refuse() { record.refused = true; return false; }
+  int failedDescriptor() { refuse(); return -1; }
+
+  const long ownerProcess;
+  const long ownerUid;
+  const long ownerGid;
+  OriginalRecord record{};
+  bool importConsumed = false;
+};
+
+inline OriginalSharedArea &original()
+{
+  static OriginalSharedArea owner;
+  return owner;
+}
+
+/** Encodes the complete bank explicitly; native object bytes never cross exec. */
+template<class Codec>
+inline void preservationFields(Codec &codec, OriginalRecord &record)
+{
+  codec.unsigned_value(record.process);
+  codec.unsigned_value(record.uid);
+  codec.unsigned_value(record.gid);
+  codec.unsigned_value(record.storageBytes);
+  codec.unsigned_value(record.device);
+  codec.unsigned_value(record.inode);
+  codec.unsigned_value(record.mappingBytes);
+  codec.unsigned_value(record.fileBytes);
+  codec.unsigned_value(record.mappingAddress);
+  codec.unsigned_value(record.libraryMappingAddress);
+  codec.unsigned_value(record.mappingSlotsReserved);
+  codec.unsigned_value(record.mappingStorageReserved);
+  codec.signed_value(record.sourceDescriptor);
+  codec.signed_value(record.protectedDescriptor);
+  codec.unsigned_value(record.openAttempt);
+  codec.unsigned_value(record.resizeAttempt);
+  codec.unsigned_value(record.duplicateAttempt);
+  codec.unsigned_value(record.closeAttempt);
+  codec.unsigned_value(record.mappingAttempt);
+  codec.boolean(record.openCompleted);
+  codec.boolean(record.resizeCompleted);
+  codec.boolean(record.duplicateCompleted);
+  codec.boolean(record.closeCompleted);
+  codec.boolean(record.closeUnknown);
+  codec.boolean(record.mappingCompleted);
+  codec.boolean(record.headerCompleted);
+  codec.boolean(record.libraryMappingCompleted);
+  codec.boolean(record.execImported);
+  codec.boolean(record.refused);
+}
+
+} // namespace dmtcp_crucible::original_shared_area
+
+#endif
