+  bool inspectCut(Thread *actualMother, Thread *actualCheckpoint, Thread *active)
+  {
+    authenticateProcess();
+    if (cutConsumed.exchange(true, std::memory_order_acq_rel)) return refuse();
+    if (phase.load(std::memory_order_acquire) != Phase::Born ||
+        !birthResultConsumed.load(std::memory_order_acquire) ||
+        birthResult != 0 || kernelCall(SYS_gettid) != checkpointTid ||
+        actualMother != mother || actualCheckpoint != &checkpoint ||
+        actualMother->state != ST_SUSPENDED || actualCheckpoint->state != ST_CKPNTHREAD ||
