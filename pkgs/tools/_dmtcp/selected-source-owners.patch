+    cutObserved = true;
+    return true;
+  }
+
+  bool owns(const Thread *thread) const
+  {
+    return selectionConsumed && (thread == mother || thread == &checkpoint);
+  }
+
+  /** Refuses retirement before freeing or reusing selected backing. */
+  [[noreturn]] void refuseRetirement()
+  {
+    authenticateProcess();
+    refuse();
+    kernelExit(86);
+  }
+
+  void *stackAddress()
+  {
+    authenticateProcess();
+    if (!motherBound || phase.load(std::memory_order_acquire) != Phase::Reserved)
+      kernelExit(86);
+    return checkpointStack.data();
+  }
+
+  bool observedCut() const { return cutObserved; }
+  Phase state() const { return phase.load(std::memory_order_acquire); }
+
+private:
+  static_assert(std::atomic<Phase>::is_always_lock_free);
+  static_assert(std::atomic<bool>::is_always_lock_free);
+
+  [[noreturn]] static void kernelExit(int status)
+  {
+    kernelCall(SYS_exit_group, status);
+    __builtin_trap();
+  }
+
+  bool refuse()
+  {
+    phase.store(Phase::Refused, std::memory_order_release);
+    return false;
+  }
+
+  std::atomic<Phase> phase{Phase::Unselected};
+  std::atomic<bool> cutConsumed{false};
+  long sourceProcess = 0;
+  long sourceUid = -1;
+  long checkpointTid = 0;
+  Thread *mother = nullptr;
+  Callback checkpointCallback = nullptr;
+  void *motherSelf = nullptr;
+  void *checkpointSelf = nullptr;
+  pid_t *motherTidPointer = nullptr;
+  pid_t *checkpointTidPointer = nullptr;
+  bool selectionConsumed = false;
+  bool motherBound = false;
+  std::atomic<bool> birthResultConsumed{false};
+  int birthResult = 0;
+  bool cutObserved = false;
+  Thread checkpoint{};
+  alignas(4096) std::array<unsigned char, StackBytes> checkpointStack{};
+};
+
+inline OriginalThreadOwner &original()
+{
+  static OriginalThreadOwner owner;
+  return owner;
+}
