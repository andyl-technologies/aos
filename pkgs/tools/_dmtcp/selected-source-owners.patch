+        actualMother->fn != nullptr || actualMother->arg != nullptr ||
+        actualCheckpoint->fn != checkpointCallback || actualCheckpoint->arg != nullptr ||
+        actualMother->pthreadSelf != motherSelf ||
+        actualCheckpoint->pthreadSelf != checkpointSelf ||
+        actualMother->ptid != motherTidPointer || actualMother->ctid != motherTidPointer ||
+        actualCheckpoint->ptid != checkpointTidPointer ||
+        actualCheckpoint->ctid != checkpointTidPointer ||
+        kernelCall(SYS_gettid) == sourceProcess ||
+        reinterpret_cast<void *>(pthread_self()) != checkpointSelf)
+      return refuse();
+
+    // Authenticate the original intrusive links; an unrelated pair cannot
+    // pass by supplying a count or a separately reconstructed list.
+    if (!active || active->prev != nullptr ||
+        (active != mother && active != &checkpoint) || !active->next ||
+        active->next->prev != active || active->next->next != nullptr ||
+        (active->next != mother && active->next != &checkpoint) || active->next == active)
+      return refuse();
