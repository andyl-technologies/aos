+// SPDX-License-Identifier: LGPL-3.0-or-later
+// Copyright (c) 2026 Andyl, Inc.
+#ifndef DMTCP_CRUCIBLE_ORIGINAL_THREAD_OWNER_H
+#define DMTCP_CRUCIBLE_ORIGINAL_THREAD_OWNER_H
+
+#include "crucible_raw_kernel_call.h"
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include "threadinfo.h"
+
+#include <atomic>
+#include <cstdlib>
+#include <pthread.h>
+
+namespace dmtcp_crucible::original_thread_owner
+{
+
+using raw_kernel_call::kernelCall;
+
+/** Reserves the selected diagnostic's two original native thread owners.
+ *
+ * The source constructor binds the literal checkpoint callback before thread
+ * creation. Its Thread and stack backing are static, so an allocation failure
+ * or retirement cannot obtain replacement backing or renew a birth. Ordinary
+ * DMTCP threads continue to use their existing allocation route.
+ *
+ * These owners are a component of process closure, not a cut issuer. Glibc's
+ * independently allocated TLS, loader state, descriptors and other mappings
+ * still require actual source ownership joins before native capture is allowed.
+ */
+class OriginalThreadOwner
+{
+public:
+  using Callback = void *(*)(void *);
+  static constexpr std::size_t StackBytes = 8 * 1024 * 1024;
+
+  enum class Phase : unsigned char
+  {
+    Unselected, Reserved, BirthConsumed, Born, Refused
+  };
+
+  OriginalThreadOwner() = default;
+  OriginalThreadOwner(const OriginalThreadOwner &) = delete;
+  OriginalThreadOwner &operator=(const OriginalThreadOwner &) = delete;
+
+  static constexpr std::size_t storageBytes() { return sizeof(OriginalThreadOwner); }
+
+  /** Selects the explicit new route before mother-thread preparation effects. */
+  bool select(Thread *motherStorage, Callback literalCheckpoint)
+  {
+    if (selectionConsumed) return refuse();
+    selectionConsumed = true;
+    sourceProcess = kernelCall(SYS_getpid);
+    sourceUid = kernelCall(SYS_geteuid);
+    if (sourceProcess <= 0 || sourceUid < 0 ||
+        kernelCall(SYS_gettid) != sourceProcess || !motherStorage || !literalCheckpoint)
+      return refuse();
+
+    mother = motherStorage;
+    checkpointCallback = literalCheckpoint;
+    phase.store(Phase::Reserved, std::memory_order_release);
+    return true;
+  }
+
+  /** Refuses inherited selected state before any old thread/list lock is used. */
+  void authenticateProcess() const
+  {
+    if (selectionConsumed && (kernelCall(SYS_getpid) != sourceProcess ||
+                             kernelCall(SYS_geteuid) != sourceUid))
+      kernelExit(125);
+  }
+
+  bool selected() const { return selectionConsumed; }
+
+  /** Rejects unrelated creation before inherited wrapper/list locks are used. */
+  void authenticateCreate(Callback callback, void *argument)
+  {
+    authenticateProcess();
+    if (selected() && (kernelCall(SYS_gettid) != sourceProcess ||
+        callback != checkpointCallback || argument != nullptr || !motherBound ||
+        phase.load(std::memory_order_acquire) != Phase::Reserved)) {
+      refuse();
+      kernelExit(86);
+    }
+  }
+
+  /** Consumes the original callback birth before pthread or allocator effects. */
+  Thread *reserveCheckpoint(Callback callback, void *argument)
+  {
+    authenticateProcess();
+    Phase expected = Phase::Reserved;
+    if (kernelCall(SYS_gettid) != sourceProcess || callback != checkpointCallback ||
+        argument != nullptr || !motherBound ||
+        !phase.compare_exchange_strong(expected, Phase::BirthConsumed,
+                                       std::memory_order_acq_rel)) {
+      refuse();
+      return nullptr;
+    }
+
+    return &checkpoint;
+  }
+
+  /** Binds actual kernel identity and source-created TLS pointers at initThread. */
+  bool bindThread(Thread *thread, long actualTid, void *actualPthreadSelf)
+  {
+    authenticateProcess();
+    if (!thread || actualTid != kernelCall(SYS_gettid) || actualTid <= 0 ||
+        !actualPthreadSelf || !thread->ptid || thread->ctid != thread->ptid)
+      return refuse();
+
+    if (thread == mother) {
+      if (kernelCall(SYS_gettid) != sourceProcess || motherBound ||
+          phase.load(std::memory_order_acquire) != Phase::Reserved ||
+          thread->fn != nullptr || thread->arg != nullptr)
+        return refuse();
+
+      motherSelf = actualPthreadSelf;
+      motherTidPointer = thread->ptid;
+      motherBound = true;
+      return true;
+    }
+
+    if (thread != &checkpoint || actualTid == sourceProcess ||
+        phase.load(std::memory_order_acquire) != Phase::BirthConsumed ||
+        thread->fn != checkpointCallback || thread->arg != nullptr)
+      return refuse();
+
+    // Check the actual helper's current stack pointer, not an imported range.
+    const unsigned char marker = 0;
+    const auto address = reinterpret_cast<std::uintptr_t>(&marker);
+    const auto begin = reinterpret_cast<std::uintptr_t>(checkpointStack.data());
+    const auto self = reinterpret_cast<std::uintptr_t>(actualPthreadSelf);
+    const auto tidPointer = reinterpret_cast<std::uintptr_t>(thread->ptid);
+    if (address < begin || address >= begin + checkpointStack.size() ||
+        self < begin || self >= begin + checkpointStack.size() ||
+        tidPointer < begin || tidPointer > begin + checkpointStack.size() - sizeof(pid_t))
+      return refuse();
+
+    checkpointSelf = actualPthreadSelf;
+    checkpointTidPointer = thread->ptid;
+    checkpointTid = actualTid;
+    // A concurrent refusal consumes this birth permanently. Publication may
+    // join only the SAME original BirthConsumed state; it cannot revive one.
+    Phase expected = Phase::BirthConsumed;
+    if (!phase.compare_exchange_strong(expected, Phase::Born,
+                                       std::memory_order_acq_rel))
