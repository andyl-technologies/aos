+    JASSERT(memchr(resolvedSavedPath, '\0', sizeof(resolvedSavedPath)) != NULL)
+      .Text("Saved checkpoint path exceeds relocation credit");
+    if (resolvedSavedPath[0] != '\0') {
+      _savedFilePath = resolvedSavedPath;
+    }
+  }
