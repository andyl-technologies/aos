+    // original script and its debit row remain when the alias changes.
+    char prior[LeafBytes];
+    ssize_t prior_length = readlinkat(account().root_descriptor, alias,
+                                     prior, sizeof(prior));
+    if (prior_length >= 0) {
+        JASSERT(static_cast<size_t>(prior_length) < sizeof(prior));
+        prior[prior_length] = '\0';
+        bool known = false;
+        for (unsigned index = 0; index < account().count; ++index) {
+            const OriginalFile &file = account().files[index];
+            known |= file.adopted && file.closed && strcmp(file.leaf, prior) == 0;
+        }
+        JASSERT(known);
+    } else {
+        JASSERT(errno == ENOENT);
+    }
