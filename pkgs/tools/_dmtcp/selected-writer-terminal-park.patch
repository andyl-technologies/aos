+    // between unlink and creation. A later attempt never overwrites this row.
+    link.unlink_attempted = true;
+    int removed = unlinkat(account().root_descriptor, alias, 0);
+    link.unlinked = removed == 0 || errno == ENOENT;
+    JASSERT(link.unlinked);
+    link.create_attempted = true;
+    link.created = symlinkat(name, account().root_descriptor, alias) == 0;
+    JASSERT(link.created);
