+#ifndef DMTCP_CRUCIBLE_RESTART_WRITER_H
+#define DMTCP_CRUCIBLE_RESTART_WRITER_H
+
+#include "crucible_single_worker.h"
+#include "../jalib/jassert.h"
+
+#include <atomic>
+#include <cerrno>
+#include <cstdarg>
+#include <cstdlib>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <fcntl.h>
+#include <limits.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace dmtcp_crucible {
+namespace restart_writer {
+
+constexpr unsigned FileLimit = 64;
+constexpr unsigned LinkLimit = 64;
+constexpr std::uint64_t FileBytes = 128 * 1024;
+constexpr std::uint64_t AttemptedBytes = 4 * 1024 * 1024;
+constexpr size_t FormatBytes = 16 * 1024;
+constexpr size_t LeafBytes = 256;
+constexpr size_t HistoryBytes = 64 * 1024;
+
+inline bool selected()
+{
+    // Once observed, removal of a selected environment cannot bypass its debit.
+    static std::atomic<bool> seen{false};
+    bool requested = std::getenv("CRUCIBLE_CAPTURE_COORDINATOR_WRITER_POLICY") != nullptr;
+    if (requested) {
+        seen.store(true);
+    }
+    return requested || seen.load();
+}
+
+inline bool admitted()
+{
+    const char *policy = std::getenv("CRUCIBLE_CAPTURE_COORDINATOR_WRITER_POLICY");
+    return policy != nullptr && std::strcmp(policy, "restart-script.v1") == 0 &&
+           selected_single_worker() && process_policy_admitted();
+}
+
+// Validate borrowed source inputs before writeScript creates streams or files.
+// This closed scope has one worker and one filename, not a multi-host script.
+template<class Text, class Filenames>
+inline void preflight_inputs(const Text &root, bool unique_filenames,
+                             const Filenames &local,
+                             const Filenames &remote_shell,
+                             const Filenames &secure_shell)
+{
+    if (!selected()) {
+        return;
+    }
+    JASSERT(admitted() && unique_filenames && !root.empty() &&
+            root.size() < PATH_MAX - LeafBytes &&
+            root.find('\0') == Text::npos &&
+            local.size() == 1 && remote_shell.empty() && secure_shell.empty());
+
+    const auto &host = *local.begin();
+    JASSERT(!host.first.empty() && host.first.size() < 80 &&
+            host.first.find('\0') == Text::npos && host.second.size() == 1);
+    const auto &filename = host.second.front();
+    JASSERT(!filename.empty() && filename.size() < PATH_MAX &&
+            filename.find('\0') == Text::npos);
+}
+
+struct OriginalFile {
+    char leaf[LeafBytes] = {};
+    int descriptor = -1;
+    dev_t device = 0;
+    ino_t inode = 0;
+    std::uint64_t charged = 0;
+    bool adopted = false;
+    bool close_attempted = false;
+    bool closed = false;
+};
+
+struct OriginalLink {
+    char alias[LeafBytes] = {};
+    unsigned file_index = 0;
+    std::uint64_t charged = 0;
+    bool unlink_attempted = false;
+    bool unlinked = false;
+    bool create_attempted = false;
+    bool created = false;
+};
+
+struct OriginalAccount {
+    std::atomic_flag lock = ATOMIC_FLAG_INIT;
+    bool initialized = false;
+    pid_t process = 0;
+    uid_t uid = 0;
+    int root_descriptor = -1;
+    dev_t device = 0;
+    ino_t root_inode = 0;
+    char root[PATH_MAX] = {};
+    unsigned count = 0;
+    unsigned attempted_links = 0;
+    std::uint64_t charged = 0;
+    OriginalFile files[FileLimit];
+    OriginalLink links[LinkLimit];
+};
+
+inline OriginalAccount &account()
+{
+    static OriginalAccount original;
+    return original;
+}
+
+class Guard {
+  public:
+    Guard()
+    {
+        while (account().lock.test_and_set(std::memory_order_acquire)) {}
+    }
