+    bool published = false;
+    unsigned target_index = 0;
+    for (unsigned index = 0; index < account().count; ++index) {
+        const OriginalFile &file = account().files[index];
+        if (strcmp(file.leaf, name) == 0 && file.adopted && file.closed) {
+            struct stat current;
+            JASSERT(fstatat(account().root_descriptor, name, &current,
+                            AT_SYMLINK_NOFOLLOW) == 0 &&
+                    S_ISREG(current.st_mode) && current.st_uid == account().uid &&
+                    current.st_nlink == 1 && (current.st_mode & 0777) == 0700 &&
+                    current.st_dev == file.device && current.st_ino == file.inode);
+            published = true;
+            target_index = index;
+        }
