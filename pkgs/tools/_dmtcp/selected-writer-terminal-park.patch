+    // Record the attempted close before libc can retire the descriptor. Its
+    // failure is Unknown custody; it cannot adopt a later numerical fd.
+    file.close_attempted = true;
+    int result = std::fclose(stream);
+    file.closed = result == 0;
+    JASSERT(result == 0);
+    return result;
+}
