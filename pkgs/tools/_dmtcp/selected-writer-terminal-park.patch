+namespace dmtcp_crucible {
+namespace log_writer {
+
+constexpr unsigned MessageLimit = 128;
+constexpr size_t MessageBytes = 8192;
+constexpr unsigned SinkLimit = 2;
+constexpr unsigned AttemptLimit = MessageLimit * SinkLimit;
+constexpr std::uint64_t SinkBytes = 1024 * 1024;
+constexpr std::uint64_t AttemptedBytes = 2 * SinkBytes;
+constexpr unsigned InvalidMessage = MessageLimit;
+
+enum class Refusal : unsigned {
+    None,
+    Policy,
+    ForeignProcess,
+    MessageCredit,
+    MessageExtent,
+    UnsupportedPrinter,
+    SinkIdentity,
+    SinkCredit,
+    WriteFailure,
+    ErrorExpansion,
+    EnvironmentExpansion,
+};
+
+struct OriginalMessage {
+    char body[MessageBytes + 1] = {};
+    size_t length = 0;
+    bool completed = false;
+    bool attempted[SinkLimit] = {};
+    std::int64_t written[SinkLimit] = {-2, -2};
+    int write_error[SinkLimit] = {};
+};
+
+struct OriginalSink {
+    int descriptor = -1;
+    int original_descriptor = -1;
+    dev_t device = 0;
+    ino_t inode = 0;
+    std::uint64_t attempted = 0;
+    bool adopted = false;
+    bool birth_attempted = false;
+    bool close_attempted = false;
+    bool retired = false;
+};
+
+struct OriginalAttempt {
+    unsigned message = 0;
+    unsigned sink = 0;
+    size_t charged = 0;
+    std::int64_t written = -2;
+    int write_error = 0;
+};
+
+struct OriginalAccount {
+    std::atomic_flag lock = ATOMIC_FLAG_INIT;
+    bool initialized = false;
+    pid_t process = 0;
+    uid_t uid = 0;
+    unsigned count = 0;
+    std::atomic<Refusal> refusal{Refusal::None};
+    unsigned attempt_count = 0;
+    std::uint64_t attempted = 0;
+    char log_path[PATH_MAX] = {};
+    char log_leaf[PATH_MAX] = {};
+    int root_descriptor = -1;
+    dev_t root_device = 0;
+    ino_t root_inode = 0;
+    OriginalMessage messages[MessageLimit];
+    OriginalSink sinks[SinkLimit];
+    OriginalAttempt attempts[AttemptLimit];
+};
+
+inline OriginalAccount &account()
+{
+    static OriginalAccount original;
+    return original;
+}
+
+class Guard {
+  public:
+    Guard()
+    {
+        while (account().lock.test_and_set(std::memory_order_acquire)) {}
+    }
+
+    ~Guard()
+    {
+        account().lock.clear(std::memory_order_release);
+    }
+};
+
+inline bool selected()
+{
+    static std::atomic<bool> seen{false};
+    bool requested = std::getenv("CRUCIBLE_CAPTURE_LOG_WRITER_POLICY") != nullptr;
+    if (requested) {
+        seen.store(true);
+    }
+    return requested || seen.load();
+}
+
+// This is a native producer failure, not a successful checkpoint or NoEffects
+// receipt. The outer owner must retain the exited Child and original work.
+[[noreturn]] inline void refuse(Refusal reason)
+{
+    Refusal empty = Refusal::None;
+    account().refusal.compare_exchange_strong(empty, reason);
+    _exit(86);
+}
+
+inline void require(bool condition, Refusal reason)
+{
+    if (!condition) {
+        refuse(reason);
+    }
+}
+
+inline void admit_original()
+{
+    const char *policy = std::getenv("CRUCIBLE_CAPTURE_LOG_WRITER_POLICY");
+    require(policy != nullptr && std::strcmp(policy, "assert-log.v1") == 0 &&
+            selected_single_worker() && process_policy_admitted(), Refusal::Policy);
+
+    OriginalAccount &original = account();
+    if (!original.initialized) {
+        original.process = getpid();
+        original.uid = geteuid();
+        original.initialized = true;
+    }
+    require(original.process == getpid() && original.uid == geteuid(),
+            Refusal::ForeignProcess);
+}
+
+inline long original_syscall(long number, std::uintptr_t first,
+                             std::uintptr_t second, std::uintptr_t third,
+                             std::uintptr_t fourth);
+
+inline void prepare_interface()
+{
+    long observed = original_syscall(SYS_getpid, 0, 0, 0, 0);
+    require(observed == getpid(), Refusal::ForeignProcess);
+}
+
+inline unsigned reserve_message()
+{
+    prepare_interface();
+    Guard guard;
+    admit_original();
+    require(account().count < MessageLimit, Refusal::MessageCredit);
+    return account().count++;
+}
+
+inline void append(unsigned row, const char *body, size_t length)
+{
+    prepare_interface();
+    Guard guard;
+    admit_original();
+    require(row < account().count && body != nullptr,
+            Refusal::MessageExtent);
+    OriginalMessage &message = account().messages[row];
+    require(!message.completed && length <= MessageBytes - message.length,
+            Refusal::MessageExtent);
+
+    // The complete extent is admitted before any copy. Failure never turns a
+    // full original message into a truncated successful diagnostic.
+    std::memcpy(message.body + message.length, body, length);
+    message.length += length;
+    message.body[message.length] = '\0';
+}
+
+inline void print(unsigned row, const char *text)
+{
+    if (text == nullptr) {
+        append(row, "<NULL>", 6);
+        return;
+    }
+    size_t length = ::strnlen(text, MessageBytes + 1);
+    require(length <= MessageBytes, Refusal::MessageExtent);
+    if (length == 0) {
+        append(row, "\"\"", 2);
+    } else {
+        append(row, text, length);
+    }
+}
+
+inline void print(unsigned row, char *text)
+{
+    print(row, static_cast<const char *>(text));
+}
+
+template<size_t Size>
+inline void print(unsigned row, const char (&text)[Size])
+{
+    print(row, static_cast<const char *>(text));
+}
+
+template<class Traits, class Allocator>
+inline void print(unsigned row,
+                  const std::basic_string<char, Traits, Allocator> &text)
+{
+    append(row, text.data(), text.size());
+}
+
+inline void print(unsigned row, char value)
+{
+    append(row, &value, 1);
+}
+
+inline void print(unsigned row, signed char value)
+{
+    print(row, static_cast<char>(value));
+}
+
+inline void print(unsigned row, unsigned char value)
+{
+    print(row, static_cast<char>(value));
+}
+
+template<class Value>
+inline typename std::enable_if<std::is_integral<Value>::value>::type
+print(unsigned row, Value value)
+{
+    char formatted[64];
+    int length = std::is_signed<Value>::value
+        ? std::snprintf(formatted, sizeof(formatted), "%lld",
+                        static_cast<long long>(value))
+        : std::snprintf(formatted, sizeof(formatted), "%llu",
+                        static_cast<unsigned long long>(value));
+    require(length >= 0 && static_cast<size_t>(length) < sizeof(formatted),
+            Refusal::MessageExtent);
+    append(row, formatted, static_cast<size_t>(length));
+}
+
+// Arbitrary operator<< implementations can allocate or call other producers.
+// They are not invoked merely because their final text might fit the buffer.
+template<class Value>
+inline typename std::enable_if<!std::is_integral<Value>::value>::type
+print(unsigned, const Value &)
+{
+    refuse(Refusal::UnsupportedPrinter);
+}
+
+// The pinned jalib variadic adapter reads seven void* arguments, including
+// unused slots. Supply their exact native ABI types; no pointer leaves process.
+inline long original_syscall(long number, std::uintptr_t first = 0,
+                             std::uintptr_t second = 0,
+                             std::uintptr_t third = 0,
+                             std::uintptr_t fourth = 0)
+{
+    return jalib::syscall(number, reinterpret_cast<void *>(first),
+                          reinterpret_cast<void *>(second),
+                          reinterpret_cast<void *>(third),
+                          reinterpret_cast<void *>(fourth),
+                          static_cast<void *>(nullptr),
+                          static_cast<void *>(nullptr),
+                          static_cast<void *>(nullptr));
+}
+
+inline bool same_sink(const OriginalSink &sink, int descriptor)
+{
+    struct stat current;
+    return sink.adopted && !sink.close_attempted && !sink.retired &&
+           descriptor == sink.descriptor &&
+           original_syscall(SYS_fstat, descriptor,
+                            reinterpret_cast<std::uintptr_t>(&current)) == 0 &&
+           S_ISREG(current.st_mode) && current.st_uid == account().uid &&
+           (current.st_mode & 0777) == 0600 && current.st_nlink == 1 &&
+           current.st_dev == sink.device && current.st_ino == sink.inode &&
+           current.st_size >= 0 &&
+           static_cast<std::uint64_t>(current.st_size) == sink.attempted &&
+           original_syscall(SYS_lseek, descriptor, 0, SEEK_CUR) ==
+               static_cast<long>(sink.attempted);
+}
+
+inline void adopt_sink(unsigned index, int descriptor, int protected_descriptor,
+                       bool close_source)
+{
+    OriginalSink &sink = account().sinks[index];
+    require(!sink.adopted && !sink.close_attempted && descriptor >= 0 &&
+            descriptor < 1024 && protected_descriptor >= 0 &&
+            protected_descriptor < 1024, Refusal::SinkIdentity);
+    sink.original_descriptor = descriptor;
+    sink.descriptor = descriptor;
+    struct stat current;
+    require(original_syscall(SYS_fstat, descriptor,
+                             reinterpret_cast<std::uintptr_t>(&current)) == 0 &&
+            S_ISREG(current.st_mode) &&
+            current.st_uid == account().uid && (current.st_mode & 0777) == 0600 &&
+            current.st_nlink == 1 && current.st_size == 0,
+            Refusal::SinkIdentity);
+
+    // Retain the actual first descriptor before dup2/close can fail. Numerical
+    // reuse cannot manufacture a newly admitted sink from a retired original.
+    sink.descriptor = descriptor;
+    sink.device = current.st_dev;
+    sink.inode = current.st_ino;
+    sink.adopted = true;
+    require(protected_descriptor != account().root_descriptor,
+            Refusal::SinkIdentity);
+    for (unsigned other = 0; other < SinkLimit; ++other) {
+        require(other == index || !account().sinks[other].adopted ||
+                account().sinks[other].descriptor != protected_descriptor,
+                Refusal::SinkIdentity);
+    }
+    if (descriptor != protected_descriptor) {
+        int status = original_syscall(SYS_fcntl, protected_descriptor, F_GETFD);
+        require(status == -1 && errno == EBADF, Refusal::SinkIdentity);
+    }
+    int duplicate = original_syscall(SYS_dup2, descriptor, protected_descriptor);
+    require(duplicate == protected_descriptor, Refusal::SinkIdentity);
+    sink.descriptor = duplicate;
+    if (close_source && descriptor != duplicate) {
+        require(original_syscall(SYS_close, descriptor) == 0, Refusal::SinkIdentity);
+    }
+}
+
+inline int adopt_console(int protected_descriptor)
+{
+    Guard guard;
+    admit_original();
+    OriginalSink &console = account().sinks[0];
+    if (!console.adopted) {
+        adopt_sink(0, STDERR_FILENO, protected_descriptor, false);
+    }
+    require(same_sink(console, protected_descriptor), Refusal::SinkIdentity);
+    return protected_descriptor;
+}
+
+inline void set_log_path(const char *path)
+{
+    prepare_interface();
+    Guard guard;
+    admit_original();
+    require(path != nullptr && ::strnlen(path, PATH_MAX) < PATH_MAX &&
+            account().log_path[0] == '\0', Refusal::SinkIdentity);
+    const char *root = std::getenv("CRUCIBLE_CAPTURE_LOG_ROOT");
+    char canonical[PATH_MAX];
+    require(root != nullptr && ::strnlen(root, PATH_MAX) < PATH_MAX &&
+            ::realpath(root, canonical) != nullptr && std::strcmp(root, canonical) == 0,
+            Refusal::SinkIdentity);
+    size_t root_length = std::strlen(root);
+    require(std::strncmp(path, root, root_length) == 0 &&
+            path[root_length] == '/', Refusal::SinkIdentity);
+    const char *leaf = path + root_length + 1;
+    require(*leaf != '\0' && std::strchr(leaf, '/') == nullptr &&
+            std::strcmp(leaf, ".") != 0 && std::strcmp(leaf, "..") != 0,
+            Refusal::SinkIdentity);
+    require(account().root_descriptor == -1, Refusal::SinkIdentity);
+    account().root_descriptor = original_syscall(SYS_openat, static_cast<std::uintptr_t>(AT_FDCWD),
+                            reinterpret_cast<std::uintptr_t>(root),
+                            O_DIRECTORY | O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+    struct stat directory;
+    require(account().root_descriptor >= 0 && account().root_descriptor < 1024 &&
+            original_syscall(SYS_fstat, account().root_descriptor,
+                             reinterpret_cast<std::uintptr_t>(&directory)) == 0 &&
+            S_ISDIR(directory.st_mode) && directory.st_uid == account().uid &&
+            (directory.st_mode & 0777) == 0700, Refusal::SinkIdentity);
+    account().root_device = directory.st_dev;
+    account().root_inode = directory.st_ino;
+    std::memcpy(account().log_path, path, std::strlen(path) + 1);
+    std::memcpy(account().log_leaf, leaf, std::strlen(leaf) + 1);
+}
+
+inline int open_log(int protected_descriptor)
+{
+    prepare_interface();
+    Guard guard;
+    admit_original();
+    OriginalSink &sink = account().sinks[1];
+    require(account().log_path[0] != '\0' && !sink.birth_attempted,
+            Refusal::SinkIdentity);
+    struct stat directory;
+    require(original_syscall(SYS_fstat, account().root_descriptor,
+                             reinterpret_cast<std::uintptr_t>(&directory)) == 0 &&
+            S_ISDIR(directory.st_mode) && directory.st_uid == account().uid &&
+            (directory.st_mode & 0777) == 0700 &&
+            directory.st_dev == account().root_device &&
+            directory.st_ino == account().root_inode, Refusal::SinkIdentity);
+    // There is no unaccounted _2..._5 fallback or adoption of an old logfile.
+    sink.birth_attempted = true;
+    int descriptor = original_syscall(SYS_openat, account().root_descriptor,
+                            reinterpret_cast<std::uintptr_t>(account().log_leaf),
+                            O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC,
+                            0600);
+    require(descriptor >= 0, Refusal::SinkIdentity);
+    adopt_sink(1, descriptor, protected_descriptor, true);
+    return protected_descriptor;
+}
+
+inline void emit(unsigned row, unsigned sink_index, int descriptor)
+{
+    prepare_interface();
+    Guard guard;
+    admit_original();
+    require(row < account().count && sink_index < SinkLimit,
+            Refusal::SinkIdentity);
+    OriginalMessage &message = account().messages[row];
+    OriginalSink &sink = account().sinks[sink_index];
+    require(same_sink(sink, descriptor) && !message.attempted[sink_index],
+            Refusal::SinkIdentity);
+    require(message.length <= SinkBytes - sink.attempted &&
+            message.length <= AttemptedBytes - account().attempted &&
+            account().attempt_count < AttemptLimit,
+            Refusal::SinkCredit);
+    OriginalAttempt &attempt = account().attempts[account().attempt_count++];
+    attempt.message = row;
+    attempt.sink = sink_index;
+    attempt.charged = message.length;
+    message.completed = true;
+    message.attempted[sink_index] = true;
+    sink.attempted += message.length;
+    account().attempted += message.length;
+
+    // Each original byte range is attempted once; failed/short writes retain
+    // the full debit and body. Host-held Unknown must own the resulting exit.
+    ssize_t written = original_syscall(SYS_write, descriptor,
+                                       reinterpret_cast<std::uintptr_t>(message.body),
+                                       message.length);
+    message.written[sink_index] = written;
+    message.write_error[sink_index] = written < 0 ? errno : 0;
+    attempt.written = message.written[sink_index];
+    attempt.write_error = message.write_error[sink_index];
+    require(written >= 0 && static_cast<size_t>(written) == message.length,
+            Refusal::WriteFailure);
+}
+
+inline void close_console(int descriptor)
+{
+    prepare_interface();
+    Guard guard;
+    admit_original();
+    OriginalSink &console = account().sinks[0];
+    require(same_sink(console, descriptor), Refusal::SinkIdentity);
+    console.close_attempted = true;
+    require(original_syscall(SYS_close, descriptor) == 0, Refusal::SinkIdentity);
+    console.retired = true;
+}
+
+} // namespace log_writer
+} // namespace dmtcp_crucible
+#endif
