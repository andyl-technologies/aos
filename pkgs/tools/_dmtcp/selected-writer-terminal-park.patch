+#ifndef DMTCP_CRUCIBLE_LOG_WRITER_H
+#define DMTCP_CRUCIBLE_LOG_WRITER_H
+
+#include "../src/crucible_single_worker.h"
+#include "jalib.h"
+
+#include <atomic>
+#include <cerrno>
+#include <cstdio>
+#include <cstdint>
+#include <cstring>
