+/* SPDX-License-Identifier: LGPL-3.0-or-later
+ * Copyright (C) 2026 Andyl, Inc.
+ * Original native final-history exchange; no durable/source authority is issued.
+ */
+#ifndef DMTCP_CRUCIBLE_FINAL_FRAME_H
+#define DMTCP_CRUCIBLE_FINAL_FRAME_H
+
+#include <type_traits>
+
+#include "crucible_capture_budget.h"
+#include "crucible_control_frame.h"
+
+namespace dmtcp_crucible {
+struct OriginalFinalExchange {
+    std::atomic_flag reservation = ATOMIC_FLAG_INIT;
+    std::atomic<bool> settled{false};
+    bool attempted = false;
+    bool received = false;
+    bool acknowledged = false;
+    pid_t process = 0;
+    size_t body_length = 0;
+    size_t request_transferred = 0;
+    size_t response_transferred = 0;
+    int error = 0;
+    unsigned char request[ControlHeaderBytes] = {};
+    unsigned char response[ControlHeaderBytes] = {};
+    unsigned char body[FinalPayloadBytes] = {};
+};
+
+inline OriginalFinalExchange &final_exchange()
+{
+    static OriginalFinalExchange original;
+    return original;
+}
+
+inline bool reserve_final_exchange()
+{
+    OriginalFinalExchange &original = final_exchange();
+    if (original.reservation.test_and_set(std::memory_order_acquire)) {
+        errno = EBUSY;
+        return false;
+    }
+    const pid_t actual = static_cast<pid_t>(_real_syscall(SYS_getpid));
+    if (!writer_cohort_admitted() || actual <= 0 || original.attempted) {
+        original.reservation.clear(std::memory_order_release);
+        errno = EALREADY;
+        return false;
+    }
+    original.attempted = true;
+    original.process = actual;
+    original.reservation.clear(std::memory_order_release);
+    return true;
+}
+
+struct OriginalFinalSettlement {
+    OriginalFinalExchange &original;
+
+    ~OriginalFinalSettlement()
+    {
+        original.settled.store(true, std::memory_order_release);
+    }
+};
+
+inline void final_header(dmtcp::DmtcpMessage &message,
+                         dmtcp::DmtcpMessageType type, pid_t worker, size_t extent)
+{
+    // These are DMTCP-private messages. Preserve a deterministic full original
+    // header without exposing this native layout as the Apache host protocol.
+    static_assert(std::is_trivially_copyable<dmtcp::DmtcpMessage>::value,
+                  "native original header copy requires trivial copy semantics");
+    auto *bytes = reinterpret_cast<unsigned char *>(&message);
+    for (size_t index = 0; index < sizeof(message); ++index) bytes[index] = 0;
+    const char magic[16] = DMTCP_MAGIC_STRING;
+    std::memcpy(message._magicBits, magic, sizeof(magic));
+    message._msgSize = sizeof(message);
+    message.type = type;
+    message.state = dmtcp::WorkerState::RUNNING;
+    message.from = dmtcp::UniquePid::ThisProcess();
+    message.realPid = worker;
+    message.extraBytes = extent;
+    message.coordTimeStamp = 1; // One original final exchange, no replenishment.
+    // The caller validates the exact loaded cookie before any send.
+    load_control_cookie(reinterpret_cast<unsigned char *>(message.barrier));
+}
+
+inline bool selected_publish_final(int fd)
+{
+    if (!reserve_final_exchange()) return false;
+    OriginalFinalExchange &original = final_exchange();
+    OriginalFinalSettlement settlement{original};
+    // Both directions belong to this original whole exchange. A competing
+    // idle receiver refuses before finalization rather than stealing its ACK.
+    OriginalChannelLease outgoing(fd, true);
+    if (outgoing.channel < 0) { original.error = errno; return false; }
+    OriginalChannelLease incoming(fd, false);
+    if (incoming.channel < 0) { original.error = errno; return false; }
+    if (!dmtcp_crucible_capture_budget_selected()) {
+        original.error = EINVAL;
+        return false;
+    }
+    original.body_length = dmtcp_crucible_finalize_capture_history(
+        original.body, sizeof(original.body));
+    if (original.body_length == 0) { original.error = errno; return false; }
+
+    dmtcp::DmtcpMessage request;
+    final_header(request, dmtcp::DMT_CRUCIBLE_WRITER_FINAL, original.process,
+                 original.body_length);
+    if (!control_cookie_matches(reinterpret_cast<unsigned char *>(request.barrier))) {
+        original.error = EACCES;
+        return false;
+    }
+    std::memcpy(original.request, &request, sizeof(request));
+    OriginalControlDeadline deadline;
+    size_t header_bytes;
+    if (!original_socket_bytes(fd, original.request, sizeof(request), true,
+                               deadline, header_bytes, original.error)) {
+        original.request_transferred = header_bytes;
+        return false;
+    }
+    size_t body_bytes;
+    if (!original_socket_bytes(fd, original.body, original.body_length, true,
+                               deadline, body_bytes, original.error)) {
+        original.request_transferred = sizeof(request) + body_bytes;
+        return false;
+    }
+    original.request_transferred = sizeof(request) + body_bytes;
+    original.received = true;
+    if (!original_socket_bytes(fd, original.response, sizeof(request), false,
+                               deadline, original.response_transferred, original.error))
+        return false;
+    dmtcp::DmtcpMessage response;
+    std::memcpy(&response, original.response, sizeof(response));
+    if (!bounded_header(response) || response.type != dmtcp::DMT_CRUCIBLE_WRITER_FINAL_ACK ||
+        response.extraBytes != 0 || response.realPid != original.process ||
+        response.coordTimeStamp != 1 || response.coordCmdStatus != 0 ||
+        !control_cookie_matches(reinterpret_cast<unsigned char *>(response.barrier))) {
+        original.error = EPROTO;
+        return false;
+    }
+    // This ACK means the coordinator retained this original body in memory.
+    // It frees no slot, proves no host durability and grants no restore right.
+    original.acknowledged = true;
+    return true;
+}
+
+inline bool selected_receive_final(int fd, const dmtcp::DmtcpMessage &request,
+                                  pid_t actual_worker,
+                                  OriginalControlDeadline &deadline,
+                                  OriginalControlFrame &retained_header)
+{
+    if (!reserve_final_exchange()) return false;
+    OriginalFinalExchange &original = final_exchange();
+    OriginalFinalSettlement settlement{original};
+    // Both directions belong to this original whole exchange. A competing
+    // idle receiver refuses before finalization rather than stealing its ACK.
+    OriginalChannelLease outgoing(fd, true);
+    if (outgoing.channel < 0) { original.error = errno; return false; }
+    OriginalIncomingTransfer incoming(fd, retained_header);
+    if (incoming.channel < 0) { original.error = errno; return false; }
+    std::memcpy(original.request, &request, sizeof(request));
+    original.request_transferred = sizeof(request);
+    if (!bounded_header(request) || request.type != dmtcp::DMT_CRUCIBLE_WRITER_FINAL ||
+        request.extraBytes < 56 || request.extraBytes > FinalPayloadBytes ||
+        actual_worker <= 0 || request.realPid != actual_worker ||
+        request.coordTimeStamp != 1 ||
+        !control_cookie_matches(reinterpret_cast<const unsigned char *>(request.barrier))) {
+        original.error = EPROTO;
+        return false;
+    }
+    original.body_length = request.extraBytes;
+    size_t body_bytes;
+    if (!original_socket_bytes(fd, original.body, original.body_length, false,
+                               deadline, body_bytes, original.error)) {
+        original.request_transferred += body_bytes;
+        return false;
+    }
+    original.request_transferred += body_bytes;
+    if (std::memcmp(original.body, "DCPBUD01", 8) != 0) {
+        original.error = EPROTO;
+        return false;
+    }
+    std::uint64_t original_pid = 0;
+    for (size_t index = 8; index < 16; ++index)
+        original_pid = (original_pid << 8) | original.body[index];
+    if (original_pid != static_cast<std::uint64_t>(actual_worker)) {
+        original.error = EPROTO;
+        return false;
+    }
+    original.received = true;
+    dmtcp::DmtcpMessage response;
+    final_header(response, dmtcp::DMT_CRUCIBLE_WRITER_FINAL_ACK, actual_worker, 0);
+    if (!control_cookie_matches(reinterpret_cast<const unsigned char *>(response.barrier))) {
+        original.error = EACCES;
+        return false;
+    }
+    std::memcpy(original.response, &response, sizeof(response));
+    if (!original_socket_bytes(fd, original.response, sizeof(response), true,
+                               deadline, original.response_transferred, original.error))
+        return false;
+    original.acknowledged = true;
+    return true;
+}
+// Exports immutable original evidence only. The native headers remain opaque
+// bytes; this is not a native-layout shared-memory protocol or an authority.
+inline size_t export_final_exchange(void *output, size_t capacity)
+{
+    OriginalFinalExchange &original = final_exchange();
+    if (!writer_cohort_admitted() || !original.settled.load(std::memory_order_acquire) ||
+        original.process != static_cast<pid_t>(_real_syscall(SYS_getpid)) || !output) {
+        errno = EBUSY;
+        return 0;
+    }
+    if (original.body_length > FinalPayloadBytes ||
+        original.request_transferred > ControlHeaderBytes + original.body_length ||
+        original.response_transferred > ControlHeaderBytes) {
+        errno = EINVAL;
+        return 0;
+    }
+    const size_t extent = 8 + 9 * 8 + 2 * ControlHeaderBytes + original.body_length;
+    if (capacity < extent) { errno = ENOSPC; return 0; }
+
+    auto *cursor = static_cast<unsigned char *>(output);
+    std::memcpy(cursor, "DCPFIN01", 8);
+    cursor += 8;
+    control_number(cursor, original.process);
+    control_number(cursor, original.received ? 1 : 0);
+    control_number(cursor, original.acknowledged ? 1 : 0);
+    control_number(cursor, original.body_length);
+    control_number(cursor, original.request_transferred);
+    control_number(cursor, original.response_transferred);
+    control_number(cursor, static_cast<unsigned>(original.error));
+    control_number(cursor, ControlHeaderBytes);
+    control_number(cursor, 1); // Original exchange ordinal, never replenished.
+    std::memcpy(cursor, original.request, ControlHeaderBytes);
+    cursor += ControlHeaderBytes;
+    std::memcpy(cursor, original.response, ControlHeaderBytes);
+    cursor += ControlHeaderBytes;
+    std::memcpy(cursor, original.body, original.body_length);
+    return extent;
+}
