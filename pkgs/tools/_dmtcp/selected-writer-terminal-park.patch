+    // Charge the original file slot before birth. fdopen/setvbuf failure leaves
+    // its descriptor and row owned; failed or short writes never refund credit.
+    OriginalFile &file = original.files[original.count++];
+    memcpy(file.leaf, name, strlen(name) + 1);
+    file.descriptor = openat(original.root_descriptor, name,
+                             O_CREAT | O_EXCL | O_WRONLY | O_NOFOLLOW |
+                             O_CLOEXEC, 0600);
