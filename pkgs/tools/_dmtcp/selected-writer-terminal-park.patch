+inline bool owns_root()
+{
+    const OriginalAccount &original = account();
+    struct stat directory;
+    return admitted() && original.initialized && original.process == getpid() &&
+           fstat(original.root_descriptor, &directory) == 0 &&
+           S_ISDIR(directory.st_mode) && directory.st_uid == original.uid &&
+           (directory.st_mode & 0777) == 0700 &&
+           directory.st_dev == original.device &&
+           directory.st_ino == original.root_inode;
+}
+
+inline const char *leaf(const char *path)
+{
+    const OriginalAccount &original = account();
+    JASSERT(path != nullptr && strnlen(path, PATH_MAX) < PATH_MAX);
+    size_t root_length = strlen(original.root);
+    JASSERT(strncmp(path, original.root, root_length) == 0 &&
+            path[root_length] == '/');
+
+    const char *name = path + root_length + 1;
+    size_t length = strnlen(name, LeafBytes);
+    JASSERT(length > 0 && length < LeafBytes && strchr(name, '/') == nullptr &&
+            strcmp(name, ".") != 0 && strcmp(name, "..") != 0);
+    return name;
+}
+
+inline bool owns_file(const OriginalFile &file, int descriptor)
+{
+    struct stat current;
+    return owns_root() && file.adopted && !file.close_attempted &&
+           descriptor == file.descriptor && fstat(descriptor, &current) == 0 &&
+           S_ISREG(current.st_mode) && current.st_uid == account().uid &&
+           current.st_nlink == 1 && (current.st_mode & 077) == 0 &&
+           current.st_dev == file.device && current.st_ino == file.inode;
+}
+
+inline OriginalFile &active_file(FILE *stream)
+{
+    JASSERT(stream != nullptr);
+    int descriptor = fileno(stream);
+    for (unsigned index = 0; index < account().count; ++index) {
+        OriginalFile &file = account().files[index];
+        if (file.descriptor == descriptor && owns_file(file, descriptor)) {
+            return file;
+        }
+    }
+    JASSERT(false).Text("selected script stream lacks its original live inode");
+    return account().files[0];
+}
+
+inline FILE *open_script(const char *root, const char *path)
+{
+    if (!selected()) {
+        return std::fopen(path, "w");
+    }
