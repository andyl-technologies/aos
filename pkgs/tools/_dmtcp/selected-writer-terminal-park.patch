+// This bounded portable record has no import setter. Host-held capture ancestry
+// must authenticate complete final debits before any operational rebind.
+inline size_t export_history(void *output, size_t capacity)
+{
+    static_assert(72 + PATH_MAX - 1 +
+                  (FileLimit + LinkLimit) * (56 + LeafBytes - 1) <= HistoryBytes,
+                  "complete original history must fit its fixed byte credit");
+    Guard guard;
+    if (!owns_root() || output == nullptr || capacity < HistoryBytes) {
+        return 0;
+    }
+    unsigned char *cursor = static_cast<unsigned char *>(output);
+    unsigned char *begin = cursor;
+    memcpy(cursor, "DCPRSTR1", 8);
+    cursor += 8;
+    auto number = [&cursor](std::uint64_t value) {
+        for (unsigned index = 0; index < 8; ++index) {
+            cursor[index] = static_cast<unsigned char>(value >> (56 - 8 * index));
+        }
+        cursor += 8;
+    };
