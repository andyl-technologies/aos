+    size_t bytes = strlen(name) + 1;
+    JASSERT(bytes <= AttemptedBytes - account().charged);
+    OriginalLink &link = account().links[account().attempted_links++];
+    memcpy(link.alias, alias, alias_length + 1);
+    link.file_index = target_index;
+    link.charged = bytes;
+    account().charged += bytes;
