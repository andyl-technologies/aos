+inline void publish_script(const char *path, const char *alias)
+{
+    Guard guard;
+    JASSERT(owns_root() && alias != nullptr);
+    const char *name = leaf(path);
+    size_t alias_length = strnlen(alias, LeafBytes);
+    JASSERT(alias_length > 0 && alias_length < LeafBytes &&
+            strchr(alias, '/') == nullptr && strcmp(alias, ".") != 0 &&
+            strcmp(alias, "..") != 0);
