+/* SPDX-License-Identifier: LGPL-3.0-or-later
+ * Copyright (C) 2026 Andyl, Inc.
+ * Selected native process producer restrictions, never execution authority.
+ */
+#ifndef DMTCP_CRUCIBLE_SINGLE_WORKER_H
+#define DMTCP_CRUCIBLE_SINGLE_WORKER_H
+
+#include <atomic>
+#include <cstdlib>
+#include <cstring>
+#include <sys/resource.h>
+
+namespace dmtcp_crucible {
+
+inline bool selected_single_worker()
+{
+    return std::getenv("CRUCIBLE_CAPTURE_PROCESS_POLICY") != nullptr;
+}
+
+inline bool process_policy_admitted()
+{
+    const char *policy = std::getenv("CRUCIBLE_CAPTURE_PROCESS_POLICY");
+    if (policy == nullptr) {
+        return true;
+    }
+    if (std::strcmp(policy, "cfi-single-worker-control.v3") != 0) {
+        return false;
+    }
+
+    struct rlimit limits;
+    return getrlimit(RLIMIT_NOFILE, &limits) == 0 &&
+           limits.rlim_cur <= 1024 && limits.rlim_max <= 1024;
+}
+
+inline bool join_coordinator_admitted(bool actual_join_mode)
+{
+    return !selected_single_worker() ||
+           (process_policy_admitted() && actual_join_mode);
+}
+
+inline bool foreground_coordinator_admitted(bool daemon)
+{
+    return !selected_single_worker() ||
+           (process_policy_admitted() && !daemon);
+}
+
+inline bool original_restore_admitted(size_t images, size_t targets,
+                                     size_t independent_roots, int peers,
+                                     bool orphan)
+{
+    return !selected_single_worker() ||
+           (process_policy_admitted() && images == 1 && targets == 1 &&
+            independent_roots == 1 && peers == 1 && !orphan);
+}
+
+inline bool coordinator_worker_admitted(size_t current_workers,
+                                       bool worker_connection, int peers)
+{
+    return !selected_single_worker() ||
+           (process_policy_admitted() && current_workers == 0 &&
+            worker_connection && peers == 1);
+}
+
+
+inline bool load_control_cookie(unsigned char *cookie)
+{
+    const char *text = std::getenv("CRUCIBLE_CAPTURE_CONTROL_COOKIE");
+    if (text == nullptr || ::strnlen(text, 65) != 64) {
+        return false;
+    }
+
+    for (unsigned index = 0; index < 32; ++index) {
+        unsigned value = 0;
+        for (unsigned half = 0; half < 2; ++half) {
+            unsigned char digit = text[2 * index + half];
+            unsigned decoded;
+            if (digit >= '0' && digit <= '9') {
+                decoded = digit - '0';
+            } else if (digit >= 'a' && digit <= 'f') {
+                decoded = digit - 'a' + 10;
+            } else {
+                return false;
+            }
+            value = 16 * value + decoded;
+        }
+        cookie[index] = static_cast<unsigned char>(value);
+    }
+    return true;
+}
+
+inline bool reserve_control_request(unsigned command)
+{
+    if (!selected_single_worker()) {
+        return true;
+    }
+    if (!process_policy_admitted() || (command != 'c' && command != 's')) {
+        return false;
+    }
+
+    // Both endpoints retain their own attempted-request debit. Transport failure
+    // or an unaccepted body never replenishes a selected connection slot.
+    static std::atomic<unsigned> attempted{0};
+    unsigned previous = attempted.load();
+    while (previous < 64) {
+        if (attempted.compare_exchange_weak(previous, previous + 1)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+inline bool control_cookie_matches(const unsigned char *supplied)
+{
+    unsigned char expected[32];
+    if (!load_control_cookie(expected)) {
+        return false;
+    }
+
+    unsigned difference = 0;
+    for (unsigned index = 0; index < 32; ++index) {
+        difference |= supplied[index] ^ expected[index];
+    }
+    return difference == 0;
+}
+
+inline bool reserve_original_probe()
+{
+    if (!selected_single_worker()) {
+        return true;
+    }
+    if (!process_policy_admitted()) {
+        return false;
+    }
+
+    // The launcher owns one original synchronous testFsGsBase child. Failure
+    // never replenishes this debit; later native checkpoint workers are denied.
+    static std::atomic<unsigned> reserved{0};
+    unsigned expected = 0;
+    return reserved.compare_exchange_strong(expected, 1);
+}
+
+inline bool extra_worker_admitted()
+{
+    return !selected_single_worker();
+}
+
+} // namespace dmtcp_crucible
+#endif
