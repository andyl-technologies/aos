+    const OriginalAccount &original = account();
+    number(original.process);
+    number(original.uid);
+    number(original.count);
+    number(original.attempted_links);
+    number(original.charged);
+    number(original.device);
+    number(original.root_inode);
+    size_t root_length = strlen(original.root);
+    number(root_length);
+    memcpy(cursor, original.root, root_length);
+    cursor += root_length;
+
+    for (unsigned index = 0; index < original.count; ++index) {
+        const OriginalFile &file = original.files[index];
+        size_t length = strlen(file.leaf);
+        number(length);
+        number(file.adopted);
+        number(file.close_attempted);
+        number(file.closed);
+        number(file.charged);
+        number(file.device);
+        number(file.inode);
+        memcpy(cursor, file.leaf, length);
+        cursor += length;
+    }
+    for (unsigned index = 0; index < original.attempted_links; ++index) {
+        const OriginalLink &link = original.links[index];
+        size_t length = strlen(link.alias);
+        number(link.file_index);
+        number(link.charged);
+        number(link.unlink_attempted);
+        number(link.unlinked);
+        number(link.create_attempted);
+        number(link.created);
+        number(length);
+        memcpy(cursor, link.alias, length);
+        cursor += length;
+    }
+    return static_cast<size_t>(cursor - begin);
+}
