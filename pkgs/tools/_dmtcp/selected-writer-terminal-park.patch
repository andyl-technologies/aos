+#include "crucible_capture_budget.h"
+
+#include <atomic>
+#include <cerrno>
+#include <cstdint>
+#include <cstring>
+#include <cstdlib>
+#include <limits.h>
+#include <sys/resource.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+extern "C" pid_t dmtcp_get_real_pid() __attribute__((weak));
+
+namespace {
+constexpr std::uint64_t FileBytes = 2ULL * 1024 * 1024 * 1024;
+constexpr std::uint64_t ArchiveBytes = 4ULL * 1024 * 1024 * 1024;
+constexpr unsigned FileCount = 4096;
+constexpr unsigned DescriptorLimit = 1024;
+constexpr size_t CopyBufferBytes = 4 * 1024 * 1024;
+constexpr size_t RelativePathBytes = 256;
+
+struct OriginalFile {
+    char relative[RelativePathBytes] = {};
+    int fd = -1;
+    dev_t device = 0;
+    ino_t inode = 0;
+    std::uint64_t charged = 0;
+    bool adopted = false;
+    bool directory = false;
+};
+
+struct OriginalBudget {
+    std::atomic_flag lock = ATOMIC_FLAG_INIT;
+    bool selected = false;
+    bool finalized = false;
+    pid_t process = 0;
+    uid_t uid = 0;
+    dev_t device = 0;
+    ino_t root_inode = 0;
+    char root[PATH_MAX] = {};
+    size_t root_length = 0;
+    OriginalFile files[FileCount];
+    unsigned count = 0;
+    char supplementary[RelativePathBytes] = {};
+    std::uint64_t charged = 0;
+    bool copy_buffer = false;
+};
+
+OriginalBudget budget;
+
+// This fixed storage is part of the selected native declaration. An installed
+// caller must reserve its complete native image and host decoding before Child.
+// It does not imply that any current profile has admitted these added bytes.
+constexpr size_t RestorePrefixBytes = 2 * 1024 * 1024;
+
+struct OriginalRestoreAttempt {
+    bool attempted = false;
+    pid_t process = 0;
+    uid_t uid = 0;
+    int reason = 0;
+    size_t prefix_length = 0;
+    unsigned char prefix[RestorePrefixBytes] = {};
+};
+
+OriginalRestoreAttempt restore_attempt;
+
+struct Guard {
+    Guard()
+    {
+        while (budget.lock.test_and_set(std::memory_order_acquire)) {}
+    }
+
+    ~Guard()
+    {
+        budget.lock.clear(std::memory_order_release);
+    }
+};
+
+bool refuse(int reason)
+{
+    errno = reason;
+    return false;
+}
+
+bool owns_process()
+{
+    return dmtcp_get_real_pid && budget.process > 0 &&
+           budget.process == dmtcp_get_real_pid() && budget.uid == geteuid();
+}
+
+bool current_account()
+{
+    // Reject a restored foreign owner before inspecting any original pathname.
+    // This is a selected writer gate, not imported-source or restore authority.
+    if (!owns_process()) return false;
+
+    struct rlimit descriptors;
+    struct stat directory;
+    return getrlimit(RLIMIT_NOFILE, &descriptors) == 0 &&
+           descriptors.rlim_cur <= DescriptorLimit &&
+           descriptors.rlim_max <= DescriptorLimit &&
+           lstat(budget.root, &directory) == 0 && S_ISDIR(directory.st_mode) &&
+           directory.st_uid == budget.uid && (directory.st_mode & 0777) == 0700 &&
+           directory.st_dev == budget.device && directory.st_ino == budget.root_inode;
+}
+
+bool file_path_identity(const OriginalFile &file, const struct stat &actual)
+{
+    // The fixed trusted opener must still enforce its original path/descriptor
+    // custody. These stopped identity checks do not promise atomic filesystem
+    // adoption against other processes or replace that opener's admission.
+    char path[PATH_MAX];
+    const size_t relative_length = strnlen(file.relative, RelativePathBytes);
+    if (relative_length == RelativePathBytes || budget.root_length == 0 ||
+        budget.root_length + 1 + relative_length >= sizeof(path)) return false;
+    memcpy(path, budget.root, budget.root_length);
+    path[budget.root_length] = '/';
+    memcpy(path + budget.root_length + 1, file.relative, relative_length + 1);
+
+    const char *slash = strchr(file.relative, '/');
+    struct stat visible;
+    if (slash) {
+        const size_t parent_length = budget.root_length + 1 +
+                                     static_cast<size_t>(slash - file.relative);
+        path[parent_length] = '\0';
+        const bool private_parent = lstat(path, &visible) == 0 &&
+            S_ISDIR(visible.st_mode) && visible.st_uid == budget.uid &&
+            (visible.st_mode & 0777) == 0700 && visible.st_dev == budget.device;
+        path[parent_length] = '/';
+        if (!private_parent) return false;
+    }
+
+    return lstat(path, &visible) == 0 && S_ISREG(visible.st_mode) &&
+           visible.st_uid == budget.uid && visible.st_nlink == 1 &&
+           (visible.st_mode & 0777) == 0600 &&
+           visible.st_dev == actual.st_dev && visible.st_ino == actual.st_ino;
+}
+
+bool identity(const OriginalFile &file, int fd)
+{
+    struct stat current;
+    return file.adopted && file.fd == fd && current_account() &&
+           fstat(fd, &current) == 0 && S_ISREG(current.st_mode) &&
+           current.st_uid == budget.uid && current.st_nlink == 1 &&
+           (current.st_mode & 0777) == 0600 && current.st_dev == file.device &&
+           current.st_ino == file.inode && file_path_identity(file, current);
+}
+
+bool relative_path(const char *path, const char **relative)
+{
+    if (!path || strnlen(path, PATH_MAX) == PATH_MAX ||
+        strncmp(path, budget.root, budget.root_length) != 0 ||
+        path[budget.root_length] != '/') return false;
+    *relative = path + budget.root_length + 1;
+    size_t length = strnlen(*relative, RelativePathBytes);
+    if (length == 0 || length == RelativePathBytes) return false;
+    unsigned components = 0;
+    const char *part = *relative;
+    for (const char *cursor = part;; ++cursor) {
+        if (*cursor == '/' || *cursor == '\0') {
+            size_t count = static_cast<size_t>(cursor - part);
+            if (count == 0 || (count == 1 && part[0] == '.') ||
+                (count == 2 && part[0] == '.' && part[1] == '.') ||
+                ++components > 2) return false;
+            if (*cursor == '\0') break;
+            part = cursor + 1;
+        }
+    }
+    return true;
+}
+} // namespace
+
+extern "C" int dmtcp_crucible_select_capture_budget(const char *root)
+{
+    Guard guard;
+    if (budget.selected || !root || !dmtcp_get_real_pid) {
+        errno = EINVAL; return -1;
+    }
+    char canonical[PATH_MAX];
+    struct stat directory;
+    struct rlimit descriptors;
+    if (!realpath(root, canonical) || strcmp(root, canonical) != 0 ||
+        stat(root, &directory) != 0 || !S_ISDIR(directory.st_mode) ||
+        directory.st_uid != geteuid() || (directory.st_mode & 0777) != 0700 ||
+        getrlimit(RLIMIT_NOFILE, &descriptors) != 0 ||
+        descriptors.rlim_cur > DescriptorLimit || descriptors.rlim_max > DescriptorLimit) {
+        errno = EINVAL; return -1;
+    }
+    budget.process = dmtcp_get_real_pid();
+    budget.uid = geteuid();
+    budget.device = directory.st_dev;
+    budget.root_inode = directory.st_ino;
+    budget.root_length = strlen(root);
+    memcpy(budget.root, root, budget.root_length + 1);
+    budget.selected = true;
+    return 0;
+}
+
+extern "C" bool dmtcp_crucible_capture_budget_selected()
+{
+    Guard guard;
+    return budget.selected;
+}
+
+extern "C" bool dmtcp_crucible_capture_process_current()
+{
+    Guard guard;
+    return !budget.selected || (current_account() && !budget.finalized);
+}
+
+extern "C" bool dmtcp_crucible_require_capture_root(const char *root)
+{
+    Guard guard;
+    if (!budget.selected) return true;
+    struct stat directory;
+    if (!current_account() || budget.finalized || !root || strcmp(root, budget.root) != 0 ||
+        stat(root, &directory) != 0 || directory.st_dev != budget.device ||
+        directory.st_ino != budget.root_inode || !S_ISDIR(directory.st_mode) ||
+        directory.st_uid != budget.uid || (directory.st_mode & 0777) != 0700)
+        return refuse(EINVAL);
+    return true;
+}
+
+extern "C" int dmtcp_crucible_reserve_capture_file(const char *path)
+{
+    Guard guard;
+    if (!budget.selected) return -2;
+    const char *relative;
+    if (!current_account() || budget.finalized || !relative_path(path, &relative) || budget.count == FileCount) {
+        errno = EFBIG; return -1;
+    }
+    for (unsigned index = 0; index < budget.count; ++index) {
+        if (strcmp(relative, budget.files[index].relative) == 0) {
+            errno = EALREADY; return -1;
+        }
+    }
+    const char *slash = strchr(relative, '/');
+    if (slash) {
+        size_t length = static_cast<size_t>(slash - relative);
+        if (length < 6 || memcmp(slash - 6, "_files", 6) != 0) {
+            errno = EINVAL; return -1;
+        }
+        if (budget.supplementary[0] == '\0') {
+            if (budget.count + 2 > FileCount) { errno = EFBIG; return -1; }
+            memcpy(budget.supplementary, relative, length);
+            budget.supplementary[length] = '\0';
+            OriginalFile &directory = budget.files[budget.count++];
+            memcpy(directory.relative, budget.supplementary, length + 1);
+            directory.directory = true;
+        } else if (strlen(budget.supplementary) != length ||
+                   memcmp(budget.supplementary, relative, length) != 0) {
+            errno = EINVAL; return -1;
+        }
+    }
+    unsigned index = budget.count++;
+    memcpy(budget.files[index].relative, relative, strlen(relative) + 1);
+    return static_cast<int>(index);
+}
+
+extern "C" bool dmtcp_crucible_adopt_capture_file(int ticket, int fd)
+{
+    Guard guard;
+    if (!budget.selected) return true;
+    struct stat file;
+    if (!current_account() || budget.finalized || ticket < 0 || static_cast<unsigned>(ticket) >= budget.count ||
+        fd < 0 || static_cast<unsigned>(fd) >= DescriptorLimit ||
+        fstat(fd, &file) != 0 || !S_ISREG(file.st_mode) || file.st_size != 0 ||
+        file.st_uid != budget.uid || file.st_nlink != 1 ||
+        (file.st_mode & 0777) != 0600 || file.st_dev != budget.device) return refuse(EINVAL);
+    OriginalFile &original = budget.files[ticket];
+    if (original.adopted || original.directory) return refuse(EALREADY);
+    if (!file_path_identity(original, file)) return refuse(EINVAL);
+    for (unsigned index = 0; index < budget.count; ++index) {
+        const OriginalFile &previous = budget.files[index];
+        if (previous.adopted && (previous.fd == fd ||
+            (previous.device == file.st_dev && previous.inode == file.st_ino)))
+            return refuse(EALREADY);
+    }
+    original.fd = fd;
+    original.device = file.st_dev;
+    original.inode = file.st_ino;
+    original.adopted = true;
+    return true;
+}
+
+extern "C" bool dmtcp_crucible_charge_capture_write(int fd, size_t count)
+{
+    Guard guard;
+    if (!budget.selected) return true;
+    if (budget.finalized) return refuse(EBUSY);
+    for (unsigned index = 0; index < budget.count; ++index) {
+        OriginalFile &file = budget.files[index];
+        if (file.fd != fd) continue;
+        if (!identity(file, fd) || count > FileBytes - file.charged ||
+            count > ArchiveBytes - budget.charged) return refuse(EFBIG);
+        file.charged += count;
+        budget.charged += count;
+        return true;
+    }
+    return refuse(EBADF);
+}
+
+extern "C" bool dmtcp_crucible_retire_capture_fd(int fd)
+{
+    Guard guard;
+    if (!budget.selected) return true;
+    if (budget.finalized) return refuse(EBUSY);
+    for (unsigned index = 0; index < budget.count; ++index) {
+        OriginalFile &file = budget.files[index];
+        if (file.fd != fd) continue;
+        if (!identity(file, fd)) return refuse(EBADF);
+        file.fd = -1; // The original path, inode and charged bytes remain retained.
+        return true;
+    }
+    return refuse(EBADF);
+}
+
+extern "C" bool dmtcp_crucible_capture_copy_buffer(size_t bytes)
+{
+    Guard guard;
+    if (!budget.selected) return true;
+    if (!current_account() || budget.finalized || budget.copy_buffer || bytes > CopyBufferBytes) return refuse(ENOMEM);
+    budget.copy_buffer = true;
+    return true;
+}
+
+extern "C" bool dmtcp_crucible_release_capture_copy_buffer()
+{
+    Guard guard;
+    if (!budget.selected) return true;
+    if (!current_account() || budget.finalized || !budget.copy_buffer) return refuse(EINVAL);
+    budget.copy_buffer = false;
+    return true;
+}
+
+namespace {
+size_t history_extent()
+{
+    // Eight magic bytes, six explicit U64 header fields and original root bytes.
+    size_t extent = 8 + 6 * 8 + budget.root_length;
+    for (unsigned index = 0; index < budget.count; ++index) {
+        extent += 7 * 8 + strlen(budget.files[index].relative);
+    }
+    return extent;
+}
+
+void put_u64(unsigned char *&cursor, std::uint64_t value)
+{
+    for (unsigned index = 0; index < 8; ++index) {
+        *cursor++ = static_cast<unsigned char>(value >> (56 - index * 8));
+    }
+}
+} // namespace
+
+extern "C" size_t dmtcp_crucible_capture_budget_storage_bytes()
+{
+    return sizeof(OriginalBudget);
+}
+
+extern "C" size_t dmtcp_crucible_capture_history_bytes()
+{
+    Guard guard;
+    if (!budget.selected || !current_account()) {
+        errno = EINVAL;
+        return 0;
+    }
+    return history_extent();
+}
+
+namespace {
+// The caller holds the one original budget lock. This encoder makes no writer
+// calls, allocation, reset or new root adoption; its v1 byte layout is unchanged.
+size_t encode_history(void *output, size_t capacity)
+{
+    const size_t extent = history_extent();
+    if (capacity < extent) {
+        errno = ENOBUFS;
+        return 0;
+    }
+
+    auto *cursor = static_cast<unsigned char *>(output);
+    memcpy(cursor, "DCPBUD01", 8);
+    cursor += 8;
+    put_u64(cursor, budget.process);
+    put_u64(cursor, budget.uid);
+    put_u64(cursor, budget.count);
+    put_u64(cursor, budget.charged);
+    put_u64(cursor, budget.copy_buffer ? 1 : 0);
+    put_u64(cursor, budget.root_length);
+    memcpy(cursor, budget.root, budget.root_length);
+    cursor += budget.root_length;
+
+    for (unsigned index = 0; index < budget.count; ++index) {
+        const OriginalFile &file = budget.files[index];
+        const size_t length = strlen(file.relative);
+        put_u64(cursor, length);
+        put_u64(cursor, file.directory ? 1 : 0);
+        put_u64(cursor, file.adopted ? 1 : 0);
+        put_u64(cursor, file.fd >= 0 ? 1 : 0);
+        put_u64(cursor, file.charged);
+        put_u64(cursor, file.device);
+        put_u64(cursor, file.inode);
+        memcpy(cursor, file.relative, length);
+        cursor += length;
+    }
+    return extent;
+}
+} // namespace
+
+extern "C" size_t dmtcp_crucible_export_capture_history(void *output, size_t capacity)
+{
+    Guard guard;
+    if (!budget.selected || !current_account() || !output) {
+        errno = EINVAL;
+        return 0;
+    }
+    return encode_history(output, capacity);
+}
+
+extern "C" size_t dmtcp_crucible_finalize_capture_history(void *output, size_t capacity)
+{
+    Guard guard;
+    if (!budget.selected || !current_account() || !output || budget.copy_buffer) {
+        errno = EINVAL;
+        return 0;
+    }
+    const size_t extent = history_extent();
+    if (capacity < extent) {
+        errno = ENOBUFS;
+        return 0;
+    }
+    for (unsigned index = 0; index < budget.count; ++index) {
+        if (budget.files[index].fd >= 0) {
+            errno = EBUSY;
+            return 0;
+        }
+    }
+
+    // The selected checkpoint/saved-file producer becomes monotone terminal
+    // before copying its final attempted charges. No later producer may reopen
+    // this account or use an earlier in-image snapshot as replenished credit.
+    budget.finalized = true;
+    return encode_history(output, capacity);
+}
+
+extern "C" bool dmtcp_crucible_capture_history_finalized()
+{
+    Guard guard;
+    return budget.selected && current_account() && budget.finalized;
+}
+
+namespace {
+struct RestoreGuard {
+    bool acquired;
+
+    RestoreGuard()
+        : acquired(!budget.lock.test_and_set(std::memory_order_acquire))
+    {}
+
+    ~RestoreGuard()
+    {
+        if (acquired) budget.lock.clear(std::memory_order_release);
+    }
+};
+
+bool captured_prefix_shape()
+{
+    // Inspect only bounded captured native fields, not any original source path.
+    if (budget.count > FileCount || budget.root_length == 0 ||
+        budget.root_length >= sizeof(budget.root) ||
+        strnlen(budget.root, sizeof(budget.root)) != budget.root_length ||
+        budget.charged > ArchiveBytes) return false;
+
+    std::uint64_t total = 0;
+    for (unsigned index = 0; index < budget.count; ++index) {
+        const OriginalFile &file = budget.files[index];
+        const size_t length = strnlen(file.relative, RelativePathBytes);
+        if (length == 0 || length == RelativePathBytes || file.charged > FileBytes ||
+            file.charged > ArchiveBytes - total) return false;
+        total += file.charged;
+    }
+    return total == budget.charged;
+}
+
+size_t restore_attempt_extent()
+{
+    // Versioned explicit integers; no native struct/pointer/FD layout is emitted.
+    return 8 + 4 * 8 + restore_attempt.prefix_length;
+}
+} // namespace
+
+extern "C" bool dmtcp_crucible_require_early_restore_account()
+{
+    // This is the first restored native thread. Never spin on a serialized lock
+    // whose captured owner might not have been reconstructed yet.
+    if (!budget.selected) return true;
+    RestoreGuard guard;
+    if (!guard.acquired) return refuse(EBUSY);
+    if (restore_attempt.attempted) return refuse(restore_attempt.reason);
+
+    // Retain the one original attempted owner before any validation failure.
+    // In-memory retention alone does not survive terminal process exit: the
+    // outer installed owner must retain its signed original image/history and
+    // actual Child/exit/Unknown custody. There is no new successful receipt.
+    restore_attempt.attempted = true;
+    restore_attempt.process = dmtcp_get_real_pid ? dmtcp_get_real_pid() : 0;
+    restore_attempt.uid = geteuid();
+    restore_attempt.reason = ENOTSUP;
+    if (restore_attempt.process <= 0 || !captured_prefix_shape()) {
+        restore_attempt.reason = EINVAL;
+        return refuse(restore_attempt.reason);
+    }
+
+    restore_attempt.prefix_length = encode_history(restore_attempt.prefix,
+                                                  sizeof(restore_attempt.prefix));
+    if (restore_attempt.prefix_length == 0) {
+        restore_attempt.reason = errno ? errno : EINVAL;
+        return refuse(restore_attempt.reason);
+    }
+
+    // No parser, caller-controlled expected digest or root pathname grants
+    // installed source permission. A later separately qualified consumer must
+    // bind the genuine original final post-write body to this captured prefix,
+    // complete signed image/capture/dependencies and a finite lineage account.
+    // Until then, do not rewrite original PID/root/counters or run restart work.
+    return refuse(restore_attempt.reason);
+}
+
+extern "C" size_t dmtcp_crucible_early_restore_storage_bytes()
+{
+    return sizeof(restore_attempt);
+}
+
+extern "C" size_t dmtcp_crucible_early_restore_attempt_bytes()
+{
+    Guard guard;
+    if (!restore_attempt.attempted || !dmtcp_get_real_pid ||
