+inline int print_script(FILE *stream, const char *format, ...)
+{
+    va_list arguments;
+    va_start(arguments, format);
+    if (!selected()) {
+        int result = std::vfprintf(stream, format, arguments);
+        va_end(arguments);
+        return result;
+    }
+
+    // Source formats are unchanged. Reject oversize output in fixed scratch
+    // storage instead of truncating it or giving FILE a growing output buffer.
+    char body[FormatBytes + 1];
+    int length = std::vsnprintf(body, sizeof(body), format, arguments);
+    va_end(arguments);
+    JASSERT(length >= 0 && static_cast<size_t>(length) <= FormatBytes);
+
+    Guard guard;
+    OriginalFile &file = active_file(stream);
+    size_t bytes = static_cast<size_t>(length);
+    JASSERT(bytes <= FileBytes - file.charged &&
+            bytes <= AttemptedBytes - account().charged);
+    file.charged += bytes;
+    account().charged += bytes;
+    JASSERT(std::fwrite(body, 1, bytes, stream) == bytes);
+    return length;
+}
+
+inline int close_script(FILE *stream)
+{
+    if (!selected()) {
+        return std::fclose(stream);
+    }
+
+    Guard guard;
+    OriginalFile &file = active_file(stream);
+    JASSERT(std::ferror(stream) == 0 && fflush(stream) == 0);
+    JASSERT(fchmod(file.descriptor, 0700) == 0);
