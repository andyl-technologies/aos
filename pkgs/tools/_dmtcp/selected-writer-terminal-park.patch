+    Guard guard;
+    JASSERT(admitted());
+    OriginalAccount &original = account();
+    if (!original.initialized) {
+        char canonical[PATH_MAX];
+        JASSERT(root != nullptr && strnlen(root, PATH_MAX) < PATH_MAX &&
+                realpath(root, canonical) != nullptr && strcmp(root, canonical) == 0);
+        original.process = getpid();
+        original.uid = geteuid();
+        memcpy(original.root, root, strlen(root) + 1);
