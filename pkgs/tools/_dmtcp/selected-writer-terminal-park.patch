+    struct stat identity;
+    JASSERT(fstat(file.descriptor, &identity) == 0 &&
+            S_ISREG(identity.st_mode) && identity.st_size == 0 &&
+            identity.st_uid == original.uid && identity.st_nlink == 1 &&
+            (identity.st_mode & 0777) == 0600 &&
+            identity.st_dev == original.device);
