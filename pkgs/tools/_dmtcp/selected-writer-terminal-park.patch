+        // One retained directory descriptor anchors every selected file route.
+        // A failed first open cannot reset this original admission attempt.
+        original.initialized = true;
+        original.root_descriptor = ::open(root, O_DIRECTORY | O_RDONLY |
+                                               O_NOFOLLOW | O_CLOEXEC);
+        JASSERT(original.root_descriptor >= 0 && original.root_descriptor < 1024);
+        struct stat directory;
+        JASSERT(fstat(original.root_descriptor, &directory) == 0);
+        original.device = directory.st_dev;
+        original.root_inode = directory.st_ino;
+    }
+    JASSERT(root != nullptr && strcmp(root, original.root) == 0 && owns_root());
+    const char *name = leaf(path);
+    JASSERT(original.count < FileLimit);
+    for (unsigned index = 0; index < original.count; ++index) {
+        JASSERT(strcmp(original.files[index].leaf, name) != 0);
+    }
