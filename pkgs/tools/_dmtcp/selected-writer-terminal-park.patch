+inline bool selected_writer_cohort()
+{
+    // A separate opt-in selection preserves old worker-controlV3 behavior.
+    // Once observed, environment removal cannot resume ordinary producers.
+    static std::atomic<bool> observed{false};
+    if (std::getenv("CRUCIBLE_CAPTURE_WRITER_COHORT_POLICY") != nullptr)
+        observed.store(true, std::memory_order_release);
+    return observed.load(std::memory_order_acquire);
+}
+
+inline bool writer_cohort_admitted()
+{
+    const char *policy = std::getenv("CRUCIBLE_CAPTURE_WRITER_COHORT_POLICY");
+    return policy && std::strcmp(policy, "cohort.v1") == 0 &&
+           selected_single_worker() && process_policy_admitted();
+}
+
+constexpr size_t ControlFrames = 64;
+constexpr size_t ControlPayloadBytes = 64 * 1024;
+constexpr size_t FinalPayloadBytes = 2 * 1024 * 1024;
+constexpr size_t ControlHeaderBytes = sizeof(dmtcp::DmtcpMessage);
+static_assert(ControlHeaderBytes <= 4096, "selected native control header extent");
+
+// The finite registry keys actual kernel socket identity, so duplicated
+// descriptors cannot bypass a same-direction lease. Entries are never reused.
+struct OriginalControlChannel {
+    dev_t device = 0;
+    ino_t inode = 0;
+    std::atomic<bool> outgoing{false};
+    std::atomic<bool> incoming{false};
+};
+
+struct OriginalControlChannels {
+    std::atomic_flag reservation = ATOMIC_FLAG_INIT;
+    pid_t process = 0;
+    size_t count = 0;
+    OriginalControlChannel channels[ControlFrames];
+};
+
+inline OriginalControlChannels &control_channels()
+{
+    static OriginalControlChannels original;
+    return original;
+}
+
+inline int acquire_control_channel(int fd, bool outgoing)
+{
+    OriginalControlChannels &bank = control_channels();
+    if (bank.reservation.test_and_set(std::memory_order_acquire)) {
+        errno = EBUSY;
+        return -1;
+    }
+    const pid_t actual = static_cast<pid_t>(_real_syscall(SYS_getpid));
+    struct stat identity = {};
+    if (!writer_cohort_admitted() || actual <= 0 || fd < 0 || fd >= 1024 ||
+        (bank.process != 0 && bank.process != actual) ||
+        _real_syscall(SYS_fstat, fd, &identity) != 0 || !S_ISSOCK(identity.st_mode) ||
+        identity.st_uid != static_cast<uid_t>(_real_syscall(SYS_geteuid))) {
+        bank.reservation.clear(std::memory_order_release);
+        errno = EACCES;
+        return -1;
+    }
+
+    size_t index = 0;
+    while (index < bank.count &&
+           (bank.channels[index].device != identity.st_dev ||
+            bank.channels[index].inode != identity.st_ino)) ++index;
+    if (index == bank.count) {
+        if (bank.count == ControlFrames) {
+            bank.reservation.clear(std::memory_order_release);
+            errno = ENOSPC;
+            return -1;
+        }
+        if (bank.process == 0) bank.process = actual;
+        bank.channels[index].device = identity.st_dev;
+        bank.channels[index].inode = identity.st_ino;
+        ++bank.count;
+    }
+    std::atomic<bool> &direction = outgoing ? bank.channels[index].outgoing :
+                                             bank.channels[index].incoming;
+    const bool busy = direction.exchange(true, std::memory_order_acq_rel);
+    bank.reservation.clear(std::memory_order_release);
+    if (busy) { errno = EBUSY; return -1; }
+    return static_cast<int>(index);
+}
+
+inline void release_control_channel(int channel, bool outgoing)
+{
+    if (channel < 0 || static_cast<size_t>(channel) >= ControlFrames) return;
+    OriginalControlChannels &bank = control_channels();
+    // Foreign restored owners cannot silently retire original channel custody.
+    if (bank.process != static_cast<pid_t>(_real_syscall(SYS_getpid))) return;
+    std::atomic<bool> &direction = outgoing ? bank.channels[channel].outgoing :
+                                             bank.channels[channel].incoming;
+    direction.store(false, std::memory_order_release);
+}
+
+struct OriginalChannelLease {
+    int channel;
+    bool outgoing;
+
+    OriginalChannelLease(int fd, bool direction)
+        : channel(acquire_control_channel(fd, direction)), outgoing(direction)
+    {}
+
+    ~OriginalChannelLease()
+    {
+        release_control_channel(channel, outgoing);
+    }
+
+    OriginalChannelLease(const OriginalChannelLease &) = delete;
+    OriginalChannelLease &operator=(const OriginalChannelLease &) = delete;
+};
+
+struct OriginalControlFrame {
+    std::atomic<bool> attempted{false};
+    bool outgoing = false;
+    bool complete = false;
+    int channel = 0;
+    std::atomic<bool> settled{false};
+    size_t extent = 0;
+    size_t transferred = 0;
+    int error = 0;
+    int close_error = 0;
+    unsigned char header[ControlHeaderBytes] = {};
+    unsigned char body[ControlPayloadBytes] = {};
+};
+
+
+// Transfer the already-held header lease without a release/reacquire window.
+// Only the owning header row and unchanged actual socket can supply this lease.
+inline bool original_control_frame_claimed(const OriginalControlFrame &frame);
+
+struct OriginalIncomingTransfer {
+    int channel = -1;
+
+    OriginalIncomingTransfer(int fd, OriginalControlFrame &header)
+    {
+        OriginalControlChannels &bank = control_channels();
+        struct stat identity = {};
+        if (!original_control_frame_claimed(header)) {
+            errno = EACCES;
+            return;
+        }
+        const int retained = header.channel;
+        if (retained < 0 ||
+            static_cast<size_t>(retained) >= ControlFrames ||
+            header.outgoing || header.settled.load(std::memory_order_acquire) ||
+            header.extent != ControlHeaderBytes ||
+            header.transferred != ControlHeaderBytes ||
+            bank.process != static_cast<pid_t>(_real_syscall(SYS_getpid)) ||
+            !bank.channels[retained].incoming.load(std::memory_order_acquire) ||
+            _real_syscall(SYS_fstat, fd, &identity) != 0 ||
+            !S_ISSOCK(identity.st_mode) ||
+            identity.st_dev != bank.channels[retained].device ||
+            identity.st_ino != bank.channels[retained].inode) {
+            errno = EACCES;
+            return;
+        }
+        channel = retained;
+        header.channel = -1;
+        header.complete = true;
+        header.settled.store(true, std::memory_order_release);
+    }
+
+    ~OriginalIncomingTransfer()
+    {
+        release_control_channel(channel, false);
+    }
+
+    OriginalIncomingTransfer(const OriginalIncomingTransfer &) = delete;
+    OriginalIncomingTransfer &operator=(const OriginalIncomingTransfer &) = delete;
+};
+
+struct OriginalControlBank {
+    std::atomic_flag reservation = ATOMIC_FLAG_INIT;
+    std::atomic<pid_t> process{0};
+    size_t count = 0;
+    OriginalControlFrame frames[ControlFrames];
+};
+
+inline OriginalControlBank &control_bank()
+{
+    static OriginalControlBank original;
+    return original;
+}
+
+// All unclaimed storage stays zero-filled. Identity plus release-published
+// claim state authenticates a row before its zero channel field is examined.
+inline bool original_control_frame_claimed(const OriginalControlFrame &frame)
+{
+    OriginalControlBank &bank = control_bank();
+    if (bank.process.load(std::memory_order_acquire) !=
+        static_cast<pid_t>(_real_syscall(SYS_getpid))) return false;
+    for (size_t index = 0; index < ControlFrames; ++index) {
+        if (&frame == &bank.frames[index])
+            return frame.attempted.load(std::memory_order_acquire);
+    }
+    return false;
+}
+
+// Reservation serializes the original c/s and worker-route callers without
+// spinning. Unique slots own later I/O. Full storage and decoded copies must be
+// enrolled in the selected process/image/host heap declaration before Child.
+inline OriginalControlFrame *reserve_control_frame(bool outgoing)
+{
+    OriginalControlBank &bank = control_bank();
+    if (bank.reservation.test_and_set(std::memory_order_acquire)) {
+        errno = EBUSY;
+        return nullptr;
+    }
+    const pid_t actual = static_cast<pid_t>(_real_syscall(SYS_getpid));
+    if (!writer_cohort_admitted() || actual <= 0 ||
+        (bank.process != 0 && bank.process != actual) || bank.count == ControlFrames) {
+        bank.reservation.clear(std::memory_order_release);
+        errno = ENOSPC;
+        return nullptr;
+    }
+    bank.process = actual;
+    OriginalControlFrame &frame = bank.frames[bank.count++];
+    frame.channel = -1;
+    frame.outgoing = outgoing;
+    frame.attempted.store(true, std::memory_order_release);
+    bank.reservation.clear(std::memory_order_release);
+    return &frame;
+}
+
+inline bool reserve_control_exchange(OriginalControlFrame **request,
+                                     OriginalControlFrame **response,
+                                     OriginalControlFrame **retirement = nullptr)
+{
+    OriginalControlBank &bank = control_bank();
+    if (bank.reservation.test_and_set(std::memory_order_acquire)) {
+        errno = EBUSY;
+        return false;
+    }
+    const pid_t actual = static_cast<pid_t>(_real_syscall(SYS_getpid));
+    const size_t required = retirement ? 3 : 2;
+    if (!request || !response || !writer_cohort_admitted() || actual <= 0 ||
+        (bank.process != 0 && bank.process != actual) ||
+        bank.count > ControlFrames - required) {
+        bank.reservation.clear(std::memory_order_release);
+        errno = ENOSPC;
+        return false;
+    }
+    bank.process = actual;
+    *request = &bank.frames[bank.count++];
+    *response = &bank.frames[bank.count++];
+    (*request)->channel = -1;
+    (*request)->outgoing = true;
+    (*request)->attempted.store(true, std::memory_order_release);
+    (*response)->channel = -1;
+    (*response)->outgoing = false;
+    (*response)->attempted.store(true, std::memory_order_release);
+    if (retirement) {
+        *retirement = &bank.frames[bank.count++];
+        (*retirement)->channel = -1;
+        (*retirement)->attempted.store(true, std::memory_order_release);
+    }
+    bank.reservation.clear(std::memory_order_release);
+    return true;
+}
+
+struct OriginalControlDeadline {
+    timespec expires = {};
+    bool valid = false;
+
+    explicit OriginalControlDeadline(bool selected = true)
+    {
+        if (selected && _real_syscall(SYS_clock_gettime, CLOCK_MONOTONIC, &expires) == 0 &&
+            expires.tv_sec <= static_cast<time_t>(INT64_MAX - 60)) {
+            expires.tv_sec += 60;
+            valid = true;
+        }
+    }
+
+    int remaining() const
+    {
+        timespec now;
+        if (!valid || _real_syscall(SYS_clock_gettime, CLOCK_MONOTONIC, &now) != 0)
+            return 0;
+        if (now.tv_sec > expires.tv_sec ||
+            (now.tv_sec == expires.tv_sec && now.tv_nsec >= expires.tv_nsec)) return 0;
+        const std::int64_t nanoseconds =
+            static_cast<std::int64_t>(expires.tv_sec - now.tv_sec) * 1000000000 +
+            expires.tv_nsec - now.tv_nsec;
+        return static_cast<int>((nanoseconds + 999999) / 1000000);
+    }
+};
+
+inline bool original_socket_bytes(int fd, void *data, size_t extent, bool outgoing,
+                                  OriginalControlDeadline &deadline,
+                                  size_t &transferred, int &error)
+{
+    transferred = 0;
+    error = 0;
+    while (transferred < extent) {
+        const int remaining = deadline.remaining();
+        if (remaining == 0) { error = ETIMEDOUT; return false; }
+        pollfd ready = {fd, static_cast<short>(outgoing ? POLLOUT : POLLIN), 0};
+        const long result = _real_syscall(SYS_poll, &ready, 1, remaining);
+        if (result < 0 && errno == EINTR) continue;
+        if (result <= 0) { error = result == 0 ? ETIMEDOUT : errno; return false; }
+        auto *position = static_cast<unsigned char *>(data) + transferred;
+        const size_t count = extent - transferred;
+        const long actual = outgoing
+            ? _real_syscall(SYS_sendto, fd, position, count,
+                            MSG_DONTWAIT | MSG_NOSIGNAL, nullptr, 0)
+            : _real_syscall(SYS_recvfrom, fd, position, count,
+                            MSG_DONTWAIT, nullptr, nullptr);
+        if (actual < 0 && (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK))
+            continue;
+        if (actual <= 0 || static_cast<size_t>(actual) > count) {
+            error = actual == 0 ? ECONNRESET : errno;
+            return false;
+        }
+        transferred += static_cast<size_t>(actual);
+    }
+    return true;
+}
+
+inline bool bounded_header(const dmtcp::DmtcpMessage &message)
+{
+    const char expected[16] = DMTCP_MAGIC_STRING;
+    return message._msgSize == ControlHeaderBytes &&
+           std::memcmp(message._magicBits, expected, sizeof(expected)) == 0;
+}
+
+// Native string readers may only consume exactly the admitted terminated
+// fields. No trailing body bytes or overreading legacy strlen are admitted.
+inline bool exact_cstrings(const void *body, size_t extent, unsigned fields)
+{
+    if (!body || extent == 0 || extent > ControlPayloadBytes) return false;
+    const auto *bytes = static_cast<const unsigned char *>(body);
+    size_t cursor = 0;
+    for (unsigned index = 0; index < fields; ++index) {
+        const void *end = std::memchr(bytes + cursor, 0, extent - cursor);
+        if (!end) return false;
+        cursor = static_cast<const unsigned char *>(end) - bytes + 1;
+    }
+    return cursor == extent;
+}
+
+inline bool selected_worker_message(const dmtcp::DmtcpMessage &message,
+                                    const void *body)
+{
+    using namespace dmtcp;
+    switch (message.type) {
+    case DMT_WORKER_RESUMING:
+    case DMT_GET_CKPT_DIR:
+        return message.extraBytes == 0;
+    case DMT_BARRIER:
+        return message.extraBytes == 0 &&
+               std::memchr(message.barrier, 0, sizeof(message.barrier));
+    case DMT_CKPT_FILENAME:
+    case DMT_UNIQUE_CKPT_FILENAME:
+        return exact_cstrings(body, message.extraBytes, 3);
+    case DMT_UPDATE_CKPT_DIR:
+    case DMT_UPDATE_PROCESS_INFO_AFTER_INIT_OR_EXEC:
+        // The owning coordinator separately requires the same original peer
+        // identity. This admits its bounded program-info body, not exec or a
+        // changed installed guest/resource identity.
+        return exact_cstrings(body, message.extraBytes, 1);
+    case DMT_KVDB_REQUEST:
+        return (message.kvdbRequest == kvdb::KVDBRequest::GET ||
+                message.kvdbRequest == kvdb::KVDBRequest::SET) &&
+               std::memchr(message.kvdbId, 0, sizeof(message.kvdbId)) &&
+               message.keyLen > 0 && message.valLen > 0 &&
+               message.keyLen <= message.extraBytes &&
+               message.valLen == message.extraBytes - message.keyLen &&
+               exact_cstrings(body, message.keyLen, 1) &&
+               exact_cstrings(static_cast<const unsigned char *>(body) +
+                              message.keyLen, message.valLen, 1);
+    default:
+        // Fork/exec, namespace peers and unknown administration have no
+        // selected original process or effect closure in this cohort.
+        return false;
+    }
+}
+
+struct OriginalFrameSettlement {
+    OriginalControlFrame &frame;
+
+    ~OriginalFrameSettlement()
+    {
+        // An exporter may only read immutable finished rows. Failure retains
+        // the partial original bytes and error, not a successful completion.
+        if (!original_control_frame_claimed(frame) ||
+            frame.settled.load(std::memory_order_acquire)) return;
+        release_control_channel(frame.channel, frame.outgoing);
+        frame.channel = -1;
+        frame.settled.store(true, std::memory_order_release);
+    }
+};
+
+inline void abandon_control_frame(OriginalControlFrame *frame, int error)
+{
+    if (!frame || !original_control_frame_claimed(*frame) ||
+        frame->settled.load(std::memory_order_acquire)) {
+        errno = EACCES;
+        return;
+    }
+    frame->error = error;
+    release_control_channel(frame->channel, frame->outgoing);
+    frame->channel = -1;
+    frame->settled.store(true, std::memory_order_release);
+}
+
+inline bool selected_send_reserved(int fd, dmtcp::DmtcpMessage &message,
+                                   const void *body, size_t extent,
+                                   OriginalControlFrame *frame,
+                                   OriginalControlDeadline &deadline)
+{
+    if (!frame || !original_control_frame_claimed(*frame) ||
+        !frame->outgoing || frame->settled.load(std::memory_order_acquire)) {
+        errno = EACCES;
+        return false;
+    }
+    OriginalFrameSettlement settlement{*frame};
+    frame->channel = acquire_control_channel(fd, true);
+    if (frame->channel < 0) { frame->error = errno; return false; }
+    if (extent > ControlPayloadBytes || (extent != 0 && body == nullptr) ||
+        !bounded_header(message)) { frame->error = EINVAL; return false; }
+    message.extraBytes = extent;
+    std::memcpy(frame->header, &message, sizeof(message));
+    if (extent != 0 && body != frame->body) std::memcpy(frame->body, body, extent);
+    frame->extent = sizeof(message) + extent;
+    size_t header_bytes;
+    if (!original_socket_bytes(fd, frame->header, sizeof(message), true,
+                               deadline, header_bytes, frame->error)) {
+        frame->transferred = header_bytes;
+        return false;
+    }
+    size_t body_bytes;
+    frame->complete = original_socket_bytes(fd, frame->body, extent, true,
+                                            deadline, body_bytes, frame->error);
+    frame->transferred = header_bytes + body_bytes;
+    return frame->complete;
+}
+
+inline bool selected_send_frame(int fd, dmtcp::DmtcpMessage &message,
+                                const void *body, size_t extent)
+{
+    OriginalControlFrame *original = reserve_control_frame(true);
+    if (!original) return false;
+    OriginalControlDeadline deadline;
+    return selected_send_reserved(fd, message, body, extent, original, deadline);
+}
+
+inline bool selected_read_header(int fd, dmtcp::DmtcpMessage &message,
+                                 OriginalControlFrame &frame,
+                                 OriginalControlDeadline &deadline)
+{
+    if (!original_control_frame_claimed(frame) || frame.outgoing ||
+        frame.settled.load(std::memory_order_acquire)) {
+        errno = EACCES;
+        return false;
+    }
+    frame.extent = sizeof(message);
+    frame.channel = acquire_control_channel(fd, false);
+    if (frame.channel < 0) {
+        abandon_control_frame(&frame, errno);
+        return false;
+    }
+    if (!original_socket_bytes(fd, frame.header, sizeof(message), false,
+                               deadline, frame.transferred, frame.error)) {
+        abandon_control_frame(&frame, frame.error);
+        return false;
+    }
+    std::memcpy(&message, frame.header, sizeof(message));
+    if (!bounded_header(message)) {
+        abandon_control_frame(&frame, EPROTO);
+        return false;
+    }
+    return true;
+}
+
+inline bool selected_read_body(int fd, const dmtcp::DmtcpMessage &message,
+                               OriginalControlFrame &frame,
+                               OriginalControlDeadline &deadline)
+{
+    if (!original_control_frame_claimed(frame) || frame.outgoing ||
+        frame.settled.load(std::memory_order_acquire) || frame.channel < 0) {
+        errno = EACCES;
+        return false;
+    }
+    OriginalFrameSettlement settlement{frame};
+    if (message.extraBytes > ControlPayloadBytes) {
+        frame.error = EFBIG;
+        return false;
+    }
+    frame.extent = sizeof(message) + message.extraBytes;
+    size_t body_bytes;
+    frame.complete = original_socket_bytes(fd, frame.body, message.extraBytes,
+                                           false, deadline, body_bytes, frame.error);
+    frame.transferred = sizeof(message) + body_bytes;
+    return frame.complete;
+}
+struct OriginalControlSnapshot {
+    OriginalControlBank &bank;
+    bool acquired;
+
+    explicit OriginalControlSnapshot(OriginalControlBank &original)
+        : bank(original), acquired(!bank.reservation.test_and_set(std::memory_order_acquire))
+    {}
+
+    ~OriginalControlSnapshot()
+    {
+        if (acquired) bank.reservation.clear(std::memory_order_release);
+    }
+};
+
+inline void control_number(unsigned char *&cursor, std::uint64_t number)
+{
+    for (unsigned shift = 64; shift != 0; shift -= 8)
+        *cursor++ = static_cast<unsigned char>(number >> (shift - 8));
+}
+
+inline size_t export_control_history(void *output, size_t capacity)
+{
+    OriginalControlBank &bank = control_bank();
+    OriginalControlSnapshot snapshot(bank);
+    const pid_t actual = static_cast<pid_t>(_real_syscall(SYS_getpid));
+    if (!snapshot.acquired || !writer_cohort_admitted() || actual <= 0 ||
+        bank.process != actual || !output) {
+        errno = EBUSY;
+        return 0;
+    }
+
+    size_t extent = 8 + 2 * 8;
+    for (size_t index = 0; index < bank.count; ++index) {
+        const OriginalControlFrame &frame = bank.frames[index];
+        if (!frame.settled.load(std::memory_order_acquire)) {
+            errno = EBUSY;
+            return 0;
+        }
+        if (frame.extent > ControlHeaderBytes + ControlPayloadBytes ||
+            frame.transferred > frame.extent) {
+            errno = EINVAL;
+            return 0;
+        }
+        extent += 7 * 8 + frame.extent;
+    }
+    if (capacity < extent) { errno = ENOSPC; return 0; }
+
+    auto *cursor = static_cast<unsigned char *>(output);
+    std::memcpy(cursor, "DCPCTL01", 8);
+    cursor += 8;
+    control_number(cursor, bank.process);
+    control_number(cursor, bank.count);
+    for (size_t index = 0; index < bank.count; ++index) {
+        const OriginalControlFrame &frame = bank.frames[index];
+        control_number(cursor, frame.outgoing ? 1 : 0);
+        control_number(cursor, frame.complete ? 1 : 0);
+        control_number(cursor, frame.extent);
+        control_number(cursor, frame.transferred);
+        control_number(cursor, static_cast<unsigned>(frame.error));
+        control_number(cursor, static_cast<unsigned>(frame.close_error));
+        control_number(cursor, index);
+        const size_t header = frame.extent < ControlHeaderBytes ?
+                              frame.extent : ControlHeaderBytes;
+        std::memcpy(cursor, frame.header, header);
+        cursor += header;
+        const size_t body = frame.extent - header;
+        if (body != 0) std::memcpy(cursor, frame.body, body);
+        cursor += body;
+    }
+    return extent;
+}
+
+} // namespace dmtcp_crucible
