+bool
+LookupService::processLargeMapSet(jalib::JSocket &remote, const DmtcpMessage &message,
+                                 pid_t actualWorker,
+                                 dmtcp_crucible::OriginalControlFrame &retainedHeader,
+                                 dmtcp_crucible::OriginalControlDeadline &deadline)
+{
+  return dmtcp_crucible::map_transfer::receive_and_reply(
+    remote.sockfd(), message, actualWorker, retainedHeader, deadline,
+    [&](const unsigned char *request, unsigned char *reply, size_t capacity,
+        size_t &oldBytes, bool &mutated) {
+      const char *key = reinterpret_cast<const char *>(request);
+      const char *value = key + message.keyLen;
+      string oldValue("0");
+      get(message.kvdbId, key, &oldValue);
+      if (oldValue.size() >= capacity) return false;
+
+      oldBytes = oldValue.size() + 1;
+      memcpy(reply, oldValue.c_str(), oldBytes);
+      _maps[message.kvdbId][key] = value;
+      mutated = true;
+      return true;
+    });
+}
