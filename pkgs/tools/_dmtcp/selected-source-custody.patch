+/* SPDX-License-Identifier: LGPL-3.0-or-later
+ * Copyright (C) 2026 Andyl, Inc.
+ * Native original coordinator export and hold; no SourceReady authority.
+ */
+#ifndef DMTCP_CRUCIBLE_SOURCE_CUSTODY_H
+#define DMTCP_CRUCIBLE_SOURCE_CUSTODY_H
+
+#include "crucible_source_capsule.h"
+#include "crucible_exec_custody.h"
+#include "crucible_final_frame.h"
+#include "crucible_restart_writer.h"
+
+namespace dmtcp_crucible {
+namespace source_custody {
+
+constexpr int Descriptor = 843;
+
+struct OriginalSource {
+    source_capsule::OriginalExport output;
+    source_capsule::Header header;
+    std::uint64_t reserved_bytes = 0;
+    int descriptor_status = 0;
+    int descriptor_flags = 0;
+    bool selected = false;
+    bool sealed = false;
+    std::uint32_t hold_word = 0;
+    unsigned char body[source_capsule::MaximumBytes] = {};
+    exec_state::State state_candidate;
+    exec_custody::Transfer descriptors;
+};
+
+inline OriginalSource &original()
+{
+    static OriginalSource source;
+    return source;
+}
+
+inline bool selected()
+{
+    return std::getenv("CRUCIBLE_CAPTURE_SOURCE_CUSTODY_POLICY") != nullptr ||
+           original().selected;
+}
+
+// Runs before logger initialization. No descriptor is born here. The outer
+// original owner supplied one private disk file; this native account reserves
+// its complete storage and sole attempted write before observing that role.
+inline bool admit()
+{
+    if (!selected()) return true;
+    OriginalSource &source = original();
+    if (source.selected || source.reserved_bytes != 0) return false;
+    source.selected = true;
+    source.reserved_bytes = source_capsule::MaximumBytes;
+
+    const char *policy = std::getenv("CRUCIBLE_CAPTURE_SOURCE_CUSTODY_POLICY");
+    if (policy == nullptr || std::strcmp(policy, "source-custody.v1") != 0 ||
+        !writer_cohort_admitted() || !terminal_control_park_admitted() ||
+        !restart_writer::admitted() || !load_control_cookie(source.header.cookie)) return false;
+
+    // Admission inspects the actual kernel namespace; lowering RLIMIT cannot
+    // hide an inherited descriptor outside the source capsule's finite table.
+    exec_custody::DescriptorOperations operations;
+    if (!descriptor_scope::bounded_namespace(operations)) return false;
+
+    struct stat identity = {};
+    const long process = kernel_identity::read(SYS_getpid);
+    const long thread = kernel_identity::read(SYS_gettid);
+    const long uid = exec_custody::syscall(SYS_geteuid);
+    const long status = exec_custody::syscall(SYS_fcntl, Descriptor, F_GETFL);
+    const long flags = exec_custody::syscall(SYS_fcntl, Descriptor, F_GETFD);
+    if (process <= 0 || thread != process || uid < 0 || status < 0 ||
+        flags < 0 ||
+        (status & O_ACCMODE) != O_WRONLY ||
+        (status & (O_APPEND | O_NONBLOCK)) != 0 ||
+        exec_custody::syscall(SYS_fstat, Descriptor, exec_custody::pointer(&identity)) != 0 ||
+        !S_ISREG(identity.st_mode) || identity.st_uid != static_cast<uid_t>(uid) ||
+        (identity.st_mode & 0777) != 0600 || identity.st_nlink != 1 || identity.st_size != 0 ||
+        exec_custody::syscall(SYS_lseek, Descriptor, 0, SEEK_CUR) != 0) return false;
+
+    source.header.process = process;
+    source.header.thread = thread;
+    source.header.uid = uid;
+    source.header.descriptor = Descriptor;
+    source.header.device = identity.st_dev;
+    source.header.inode = identity.st_ino;
+    source.descriptor_status = static_cast<int>(status);
+    source.descriptor_flags = static_cast<int>(flags);
+    source.output.admitted = true;
+    return true;
+}
+
+template<class Codec>
+inline void restart_fields(Codec &codec, restart_writer::OriginalAccount &account)
+{
+    codec.boolean(account.initialized);
+    codec.signed_value(account.process);
+    codec.unsigned_value(account.uid);
+    codec.signed_value(account.root_descriptor);
+    codec.unsigned_value(account.device);
+    codec.unsigned_value(account.root_inode);
+    codec.bytes(account.root, sizeof(account.root));
+    codec.unsigned_value(account.count);
+    codec.unsigned_value(account.attempted_links);
+    codec.unsigned_value(account.charged);
+
+    for (auto &file : account.files) {
+        codec.bytes(file.leaf, sizeof(file.leaf));
+        codec.signed_value(file.descriptor);
+        codec.unsigned_value(file.device);
+        codec.unsigned_value(file.inode);
+        codec.unsigned_value(file.charged);
+        codec.boolean(file.adopted);
+        codec.boolean(file.close_attempted);
+        codec.boolean(file.closed);
+    }
+    for (auto &link : account.links) {
+        codec.bytes(link.alias, sizeof(link.alias));
+        codec.unsigned_value(link.file_index);
+        codec.unsigned_value(link.charged);
+        codec.boolean(link.unlink_attempted);
+        codec.boolean(link.unlinked);
+        codec.boolean(link.create_attempted);
+        codec.boolean(link.created);
+    }
+}
+
+template<class Codec>
+inline void final_fields(Codec &codec, OriginalFinalExchange &exchange)
+{
+    exec_state::boolean(codec, exchange.settled);
+    codec.boolean(exchange.attempted);
+    codec.boolean(exchange.received);
+    codec.boolean(exchange.acknowledged);
+    codec.signed_value(exchange.process);
+    codec.unsigned_value(exchange.body_length);
+    codec.unsigned_value(exchange.request_transferred);
+    codec.unsigned_value(exchange.response_transferred);
+    codec.signed_value(exchange.error);
+    codec.bytes(exchange.request, sizeof(exchange.request));
+    codec.bytes(exchange.response, sizeof(exchange.response));
+    // Retain the complete source storage, not just its transferred prefix.
+    codec.bytes(exchange.body, sizeof(exchange.body));
+}
+
+inline bool capture_accounts(OriginalSource &source, unsigned char *body, size_t &extent)
+{
+    auto &log = log_writer::account();
+    if (log.lock.test_and_set(std::memory_order_acquire)) return false;
+    OriginalControlSnapshot control(control_bank());
+    auto &channels = control_channels();
+    const bool acquired_channels = !channels.reservation.test_and_set(std::memory_order_acquire);
+
+    unsigned requests = original_control_requests().load();
+    unsigned probes = original_probe_reservations().load();
+    unsigned exec_attempts = exec_custody::attempts();
+    exec_state::Writer writer(body, source_capsule::SectionLimits[0]);
+    if (control.acquired && acquired_channels) {
+        exec_state::fields(writer, log, control_bank(), channels,
+                           requests, probes, exec_attempts);
+    }
+    if (acquired_channels) channels.reservation.clear(std::memory_order_release);
+    log.lock.clear(std::memory_order_release);
+    if (!control.acquired || !acquired_channels || !writer.valid()) return false;
+
+    extent = writer.size();
+    exec_state::Reader check(body, extent);
+    auto &candidate = source.state_candidate;
+    exec_state::fields(check, candidate.log, candidate.control, candidate.channels,
+                       candidate.requests, candidate.probes, candidate.exec_attempts);
+    return check.complete() && exec_state::consistent_attempts(candidate, 0) &&
+           candidate.log.process == static_cast<pid_t>(source.header.process) &&
+           candidate.control.terminal.load() && candidate.channels.terminal.load();
+}
+
+// Called once after the original final-copy ACK has completed. Every emitted
+// section is custody data. Whole guest/clock/image closure and source-issued
+// permission remain separate and cannot be inferred from this function.
+inline bool publish_and_hold(int fd, pid_t worker)
+{
+    if (!selected()) return true;
+    OriginalSource &source = original();
+    auto &exchange = final_exchange();
+    const char *policy = std::getenv("CRUCIBLE_CAPTURE_SOURCE_CUSTODY_POLICY");
+    if (!source.output.admitted || source.output.attempted || source.sealed ||
+        policy == nullptr || std::strcmp(policy, "source-custody.v1") != 0 ||
+        !control_cookie_matches(source.header.cookie) ||
+        kernel_identity::read(SYS_getpid) != static_cast<long>(source.header.process) ||
+        kernel_identity::read(SYS_gettid) != static_cast<long>(source.header.thread) ||
+        worker <= 0 || worker == static_cast<pid_t>(source.header.process) ||
+        !exchange.settled.load() || !exchange.attempted || !exchange.received ||
+        !exchange.acknowledged || exchange.error != 0 || exchange.body_length == 0 ||
+        exchange.body_length > FinalPayloadBytes) return false;
+
+    struct stat channel = {};
+    if (!seal_terminal_control_channel(fd, source.header.process, source.header.uid, channel)) {
+        return false;
+    }
+    source.sealed = true;
+    source.header.worker = worker;
+    size_t offset = source_capsule::HeaderBytes;
+    size_t bytes = 0;
+    if (!capture_accounts(source, source.body + offset, bytes)) return false;
+    source.header.section_bytes[0] = bytes;
+    offset += bytes;
+
+    auto &restart = restart_writer::account();
+    if (restart.lock.test_and_set(std::memory_order_acquire)) return false;
+    exec_state::Writer scripts(source.body + offset, source_capsule::SectionLimits[1]);
+    const bool owns_scripts = restart_writer::owns_root() && restart.count <= restart_writer::FileLimit &&
+                              restart.attempted_links <= restart_writer::LinkLimit;
+    if (owns_scripts) restart_fields(scripts, restart);
+    restart.lock.clear(std::memory_order_release);
+    if (!owns_scripts || !scripts.valid()) return false;
+    source.header.section_bytes[1] = scripts.size();
+    offset += scripts.size();
+
+    exec_state::Writer final(source.body + offset, source_capsule::SectionLimits[2]);
+    final_fields(final, exchange);
+    if (!final.valid()) return false;
+    source.header.section_bytes[2] = final.size();
+    offset += final.size();
+
+    const dmtcp::UniquePid *peers[] = {&dmtcp::UniquePid::ThisProcess(true),
+                                     &dmtcp::UniquePid::ParentProcess()};
+    exec_custody::PeerIdentity *retained[] = {&source.descriptors.process,
+                                            &source.descriptors.parent};
+    for (unsigned index = 0; index < 2; ++index) {
+        retained[index]->host = peers[index]->hostid();
+        retained[index]->process = peers[index]->pid();
+        retained[index]->time = peers[index]->time();
+        retained[index]->generation = peers[index]->upid()._computation_generation;
+    }
+    std::memcpy(source.descriptors.cookie, source.header.cookie, sizeof(source.header.cookie));
+    exec_custody::require_bounded_namespace();
+    exec_custody::census(source.descriptors);
+    exec_state::Writer descriptors(source.body + offset, source_capsule::SectionLimits[3]);
+    exec_custody::descriptor_fields(descriptors, source.descriptors);
+    if (!descriptors.valid()) return false;
+    source.header.section_bytes[3] = descriptors.size();
+    offset += descriptors.size();
+    if (source_capsule::extent(source.header) != offset ||
+        !source_capsule::encode(source.header, source.body, sizeof(source.body)) ||
+        !source.output.reserve(offset)) return false;
+
+    struct stat output = {};
+    if (exec_custody::syscall(SYS_fstat, Descriptor, exec_custody::pointer(&output)) != 0 ||
+        !S_ISREG(output.st_mode) || output.st_uid != source.header.uid ||
+        (output.st_mode & 0777) != 0600 || output.st_nlink != 1 || output.st_size != 0 ||
+        output.st_dev != source.header.device || output.st_ino != source.header.inode ||
+        exec_custody::syscall(SYS_lseek, Descriptor, 0, SEEK_CUR) != 0 ||
+        exec_custody::syscall(SYS_fcntl, Descriptor, F_GETFL) != source.descriptor_status ||
+        exec_custody::syscall(SYS_fcntl, Descriptor, F_GETFD) != source.descriptor_flags) return false;
+
+    // One whole bounded attempt; a short/error write retains its full debit.
+    // This capsule contains the original accounts before its own output write.
+    // Completion stays in the held native account and is not predeclared.
+    const long written = exec_custody::syscall(SYS_write, Descriptor,
+                                              exec_custody::pointer(source.body), offset);
+    const int failure = written < 0 ? errno : 0;
+    if (!source.output.finish(written, failure) || written != static_cast<long>(offset)) return false;
+
+    source.hold_word = 1;
+    for (;;) {
+        const long result = _real_syscall(SYS_futex, &source.hold_word,
+                                          FUTEX_WAIT_PRIVATE, 1, nullptr, nullptr, 0);
+        if (result == 0 || errno == EINTR) continue;
+        return false;
+    }
+}
+
+} // namespace source_custody
+} // namespace dmtcp_crucible
+#endif
