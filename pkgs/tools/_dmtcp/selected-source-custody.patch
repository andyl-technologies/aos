+/* SPDX-License-Identifier: LGPL-3.0-or-later
+ * Copyright (C) 2026 Andyl, Inc.
+ * Borrowed native capsule validation; never source or execution authority.
+ */
+#ifndef DMTCP_CRUCIBLE_SOURCE_CAPSULE_READER_H
+#define DMTCP_CRUCIBLE_SOURCE_CAPSULE_READER_H
+
+#include "crucible_source_custody.h"
+
+namespace dmtcp_crucible {
+namespace source_capsule {
+
+struct Candidate {
+    Header header;
+    exec_state::State accounts;
+    restart_writer::OriginalAccount scripts;
+    OriginalFinalExchange exchange;
+    exec_custody::Transfer descriptors;
+};
+
+inline bool scripts_consistent(const Candidate &candidate)
+{
+    const auto &account = candidate.scripts;
+    if (!account.initialized || account.process != static_cast<pid_t>(candidate.header.process) ||
+        account.uid != candidate.header.uid || account.root_descriptor < 0 ||
+        account.root_descriptor >= 1024 || account.root_inode == 0 ||
+        std::memchr(account.root, 0, sizeof(account.root)) == nullptr ||
+        account.count > restart_writer::FileLimit ||
+        account.attempted_links > restart_writer::LinkLimit ||
+        account.charged > restart_writer::AttemptedBytes) return false;
+
+    std::uint64_t charged = 0;
+    for (unsigned index = 0; index < account.count; ++index) {
+        const auto &file = account.files[index];
+        const void *end = std::memchr(file.leaf, 0, sizeof(file.leaf));
+        if (end == nullptr || end == file.leaf || file.descriptor < 0 || file.descriptor >= 1024 ||
+            !file.adopted || !file.close_attempted || !file.closed ||
+            file.device != account.device || file.inode == 0 ||
+            file.charged > restart_writer::FileBytes ||
+            file.charged > restart_writer::AttemptedBytes - charged) return false;
+        const size_t length = static_cast<const char *>(end) - file.leaf;
+        if (std::memchr(file.leaf, '/', length) != nullptr ||
+            std::strcmp(file.leaf, ".") == 0 || std::strcmp(file.leaf, "..") == 0) return false;
+        for (unsigned earlier = 0; earlier < index; ++earlier) {
+            if (std::strcmp(account.files[earlier].leaf, file.leaf) == 0) return false;
+        }
+        charged += file.charged;
+    }
+    for (unsigned index = 0; index < account.attempted_links; ++index) {
+        const auto &link = account.links[index];
+        const void *end = std::memchr(link.alias, 0, sizeof(link.alias));
+        if (end == nullptr || end == link.alias || link.file_index >= account.count ||
+            !link.unlink_attempted || !link.unlinked || !link.create_attempted || !link.created ||
+            link.charged != std::strlen(account.files[link.file_index].leaf) + 1 ||
+            link.charged > restart_writer::AttemptedBytes - charged) return false;
+        const size_t length = static_cast<const char *>(end) - link.alias;
+        if (std::memchr(link.alias, '/', length) != nullptr ||
+            std::strcmp(link.alias, ".") == 0 || std::strcmp(link.alias, "..") == 0) return false;
+        charged += link.charged;
+    }
+    return charged == account.charged;
+}
+
+template<class Integer>
+inline Integer native_integer(const unsigned char *body, size_t offset)
+{
+    static_assert(std::is_integral<Integer>::value, "only scalar native fields are inspected");
+    Integer value = 0;
+    std::memcpy(&value, body + offset, sizeof(value));
+    return value;
+}
+
+inline bool final_header_consistent(const unsigned char *body, dmtcp::DmtcpMessageType type,
+                                    std::uint64_t worker, size_t extent,
+                                    const unsigned char *cookie, bool response)
+{
+    using Native = dmtcp::DmtcpMessage;
+    using Kind = std::underlying_type<dmtcp::DmtcpMessageType>::type;
+    static_assert(std::is_standard_layout<Native>::value, "native field offsets require standard layout");
+    const char magic[16] = DMTCP_MAGIC_STRING;
+    return std::memcmp(body + offsetof(Native, _magicBits), magic, sizeof(magic)) == 0 &&
+           native_integer<std::uint32_t>(body, offsetof(Native, _msgSize)) == ControlHeaderBytes &&
+           native_integer<Kind>(body, offsetof(Native, type)) == static_cast<Kind>(type) &&
+           native_integer<pid_t>(body, offsetof(Native, realPid)) == static_cast<pid_t>(worker) &&
+           native_integer<std::uint32_t>(body, offsetof(Native, extraBytes)) == extent &&
+           native_integer<std::uint64_t>(body, offsetof(Native, coordTimeStamp)) == 1 &&
+           (!response || native_integer<std::int32_t>(body, offsetof(Native, coordCmdStatus)) == 0) &&
+           std::memcmp(body + offsetof(Native, barrier), cookie, 32) == 0;
+}
+
+inline bool final_consistent(const Candidate &candidate)
+{
+    const auto &original = candidate.exchange;
+    if (!original.settled.load() || !original.attempted || !original.received ||
+        !original.acknowledged || original.process != static_cast<pid_t>(candidate.header.process) ||
+        original.body_length < 56 || original.body_length > FinalPayloadBytes ||
+        original.request_transferred != ControlHeaderBytes + original.body_length ||
+        original.response_transferred != ControlHeaderBytes || original.error != 0 ||
+        std::memcmp(original.body, "DCPBUD01", 8) != 0 ||
+        number(original.body + 8) != candidate.header.worker) return false;
+
+    // Inspect scalar fields without running a native message constructor,
+    // which would create a fresh peer identity while parsing borrowed bytes.
+    return final_header_consistent(original.request, dmtcp::DMT_CRUCIBLE_WRITER_FINAL,
+                                   candidate.header.worker, original.body_length,
+                                   candidate.header.cookie, false) &&
+           final_header_consistent(original.response, dmtcp::DMT_CRUCIBLE_WRITER_FINAL_ACK,
+                                   candidate.header.worker, 0,
+                                   candidate.header.cookie, true);
+}
+
+inline bool descriptor_consistent(const Candidate &candidate)
+{
+    const auto &descriptors = candidate.descriptors;
+    if (descriptors.process.process != static_cast<pid_t>(candidate.header.process) ||
+        std::memcmp(descriptors.cookie, candidate.header.cookie, 32) != 0) return false;
+    for (const auto &descriptor : descriptors.descriptors) {
+        if (descriptor.present && (descriptor.flags < 0 || descriptor.status < 0 ||
+            descriptor.offset < -1 || descriptor.inode == 0)) return false;
+    }
+
+    const auto &output = descriptors.descriptors[candidate.header.descriptor];
+    const auto &log = candidate.accounts.log;
+    const auto &scripts = candidate.scripts;
+    const auto &log_root = descriptors.descriptors[log.root_descriptor];
+    const auto &script_root = descriptors.descriptors[scripts.root_descriptor];
+    return output.present && S_ISREG(output.mode) && output.uid == candidate.header.uid &&
+           output.device == candidate.header.device && output.inode == candidate.header.inode &&
+           (output.status & O_ACCMODE) == O_WRONLY && output.offset == 0 &&
+           log_root.present && S_ISDIR(log_root.mode) && log_root.uid == log.uid &&
+           log_root.device == log.root_device && log_root.inode == log.root_inode &&
+           script_root.present && S_ISDIR(script_root.mode) && script_root.uid == scripts.uid &&
+           script_root.device == scripts.device && script_root.inode == scripts.root_inode;
+}
+
+// Decodes only into a caller-owned candidate. No original account, descriptor,
+// kernel peer, activation or readiness transition is changed by parsing.
+inline bool decode_preservation(const unsigned char *body, size_t extent, Candidate &candidate)
+{
+    if (!decode(body, extent, candidate.header)) return false;
+    size_t position = HeaderBytes;
+    auto section = [&](unsigned index) {
+        const size_t bytes = static_cast<size_t>(candidate.header.section_bytes[index]);
+        const unsigned char *start = body + position;
+        position += bytes;
+        return exec_state::Reader(start, bytes);
+    };
+
+    auto accounts = section(0);
+    auto &state = candidate.accounts;
+    exec_state::fields(accounts, state.log, state.control, state.channels,
+                       state.requests, state.probes, state.exec_attempts);
+    if (!accounts.complete() || !exec_state::consistent_attempts(state, 0) ||
+        state.log.process != static_cast<pid_t>(candidate.header.process) ||
+        state.log.uid != candidate.header.uid || state.log.root_descriptor < 0 ||
+        state.log.root_descriptor >= 1024 || !state.control.terminal.load() ||
+        !state.channels.terminal.load()) return false;
+
+    auto scripts = section(1);
+    source_custody::restart_fields(scripts, candidate.scripts);
+    if (!scripts.complete() || !scripts_consistent(candidate)) return false;
+
+    auto final = section(2);
+    source_custody::final_fields(final, candidate.exchange);
+    if (!final.complete() || !final_consistent(candidate)) return false;
+
+    auto descriptors = section(3);
+    exec_custody::descriptor_fields(descriptors, candidate.descriptors);
+    return descriptors.complete() && position == extent && descriptor_consistent(candidate);
+}
