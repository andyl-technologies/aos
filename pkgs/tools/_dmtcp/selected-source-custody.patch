+/* SPDX-License-Identifier: LGPL-3.0-or-later
+ * Copyright (C) 2026 Andyl, Inc.
+ * Bounded original coordinator preservation capsule; no execution authority.
+ */
+#ifndef DMTCP_CRUCIBLE_SOURCE_CAPSULE_H
+#define DMTCP_CRUCIBLE_SOURCE_CAPSULE_H
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace dmtcp_crucible {
+namespace source_capsule {
+
+constexpr size_t HeaderBytes = 160;
+constexpr size_t MaximumBytes = 10 * 1024 * 1024;
+constexpr unsigned SectionCount = 4;
+constexpr size_t SectionLimits[SectionCount] = {
+    6 * 1024 * 1024, 64 * 1024, 2 * 1024 * 1024 + 1024, 128 * 1024
+};
+
+struct Header {
+    std::uint64_t process = 0;
+    std::uint64_t thread = 0;
+    std::uint64_t uid = 0;
+    std::uint64_t worker = 0;
+    std::uint64_t descriptor = 0;
+    std::uint64_t device = 0;
+    std::uint64_t inode = 0;
+    std::uint64_t section_bytes[SectionCount] = {};
+    unsigned char cookie[32] = {};
+};
+
+inline void number(unsigned char *output, std::uint64_t value)
+{
+    for (unsigned index = 0; index < 8; ++index) {
+        output[index] = static_cast<unsigned char>(value >> (56 - 8 * index));
+    }
+}
+
+inline std::uint64_t number(const unsigned char *input)
+{
+    std::uint64_t value = 0;
+    for (unsigned index = 0; index < 8; ++index) value = (value << 8) | input[index];
+    return value;
+}
+
+inline size_t extent(const Header &header)
+{
+    if (header.process == 0 || header.thread == 0 || header.worker == 0 ||
+        header.process > INT32_MAX || header.thread > INT32_MAX ||
+        header.worker > INT32_MAX || header.uid > UINT32_MAX ||
+        header.process == header.worker || header.descriptor >= 1024 || header.inode == 0) {
+        return 0;
+    }
+
+    size_t size = HeaderBytes;
+    for (unsigned section = 0; section < SectionCount; ++section) {
+        const auto bytes = header.section_bytes[section];
+        if (bytes == 0 || bytes > SectionLimits[section] || bytes > MaximumBytes - size) {
+            return 0;
+        }
+        size += static_cast<size_t>(bytes);
+    }
+    return size;
+}
+
+inline bool encode(const Header &header, unsigned char *output, size_t capacity)
+{
+    const size_t size = extent(header);
+    if (size == 0 || output == nullptr || capacity < HeaderBytes) return false;
+
+    std::memset(output, 0, HeaderBytes);
+    std::memcpy(output, "DCPCCP01", 8);
+    number(output + 8, 1);
+    number(output + 16, size);
+    const std::uint64_t fields[] = {
+        header.process, header.thread, header.uid, header.worker,
+        header.descriptor, header.device, header.inode
+    };
+    for (unsigned index = 0; index < 7; ++index) number(output + 24 + 8 * index, fields[index]);
+    for (unsigned index = 0; index < SectionCount; ++index) {
+        number(output + 80 + 8 * index, header.section_bytes[index]);
+    }
+    std::memcpy(output + 112, header.cookie, sizeof(header.cookie));
+    // The trailing sixteen bytes are reserved and always zero in edition1.
+    return true;
+}
+
+inline bool decode(const unsigned char *body, size_t size, Header &header)
+{
+    if (body == nullptr || size < HeaderBytes || size > MaximumBytes ||
+        std::memcmp(body, "DCPCCP01", 8) != 0 || number(body + 8) != 1 ||
+        number(body + 16) != size) return false;
+    for (unsigned index = 144; index < HeaderBytes; ++index) {
+        if (body[index] != 0) return false;
+    }
+
+    Header candidate;
+    candidate.process = number(body + 24);
+    candidate.thread = number(body + 32);
+    candidate.uid = number(body + 40);
+    candidate.worker = number(body + 48);
+    candidate.descriptor = number(body + 56);
+    candidate.device = number(body + 64);
+    candidate.inode = number(body + 72);
+    for (unsigned index = 0; index < SectionCount; ++index) {
+        candidate.section_bytes[index] = number(body + 80 + 8 * index);
+    }
+    std::memcpy(candidate.cookie, body + 112, sizeof(candidate.cookie));
+    if (extent(candidate) != size) return false;
+    header = candidate;
+    return true;
+}
+
+// This pre-write account charges the complete one-shot export before the
+// syscall. Its byte record says nothing about completion or permission. The
+// actual native owner retains short-write/error outcome without renewal.
+struct OriginalExport {
+    bool admitted = false;
+    bool attempted = false;
+    bool settled = false;
+    std::uint64_t charged = 0;
+    std::int64_t written = -1;
+    int error = 0;
+
+    bool reserve(size_t size)
+    {
+        if (!admitted || attempted || settled || size < HeaderBytes || size > MaximumBytes) {
+            return false;
+        }
+        attempted = true;
+        charged = size;
+        return true;
+    }
+
+    bool finish(std::int64_t result, int failure)
+    {
+        if (!attempted || settled || result < -1 || failure < 0 ||
+            (result >= 0 && static_cast<std::uint64_t>(result) > charged) ||
+            (result >= 0 && failure != 0) || (result == -1 && failure == 0)) return false;
+        written = result;
+        error = failure;
+        settled = true;
+        return true;
+    }
+};
+
+} // namespace source_capsule
+} // namespace dmtcp_crucible
+#endif
