+    validate_census(transfer);
+
+    // No effects occur until the complete candidate and actual inherited
+    // census have passed. Installation preserves every attempted original row.
+    exec_state::Reader install(storage() + 24, extent - 24);
+    unsigned requests = 0;
+    unsigned probes = 0;
+    exec_state::fields(install, log_writer::account(), control_bank(), control_channels(),
+                       requests, probes, attempts());
+    original_control_requests().store(requests);
+    original_probe_reservations().store(probes);
+    const auto &process = transfer.process;
+    const auto &parent = transfer.parent;
+    DmtcpUniqueProcessId process_id = {};
+    process_id._hostid = process.host;
+    process_id._pid = process.process;
+    process_id._time = process.time;
+    process_id._computation_generation = process.generation;
+    DmtcpUniqueProcessId parent_id = {};
+    parent_id._hostid = parent.host;
+    parent_id._pid = parent.process;
+    parent_id._time = parent.time;
+    parent_id._computation_generation = parent.generation;
+    require(dmtcp::UniquePid::installSelectedExecIdentity(process_id, parent_id));
+    restored() = true;
+    require(syscall(SYS_close, PROTECTED_CRUCIBLE_EXEC_FD) == 0);
+    require(::unsetenv("CRUCIBLE_CAPTURE_EXEC_HANDOFF") == 0);
+}
