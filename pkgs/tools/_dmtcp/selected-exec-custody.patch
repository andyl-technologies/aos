+    // Validate the complete snapshot before creating a delivery file. The
+    // parser cannot install candidates or replenish a live producer account.
+    exec_state::Reader validation(storage() + 24, writer.size() - 24);
+    exec_state::fields(validation, transfer.state.log, transfer.state.control,
+                       transfer.state.channels, transfer.state.requests,
+                       transfer.state.probes, transfer.state.exec_attempts);
+    descriptor_fields(validation, transfer);
+    require(validation.complete() && exec_state::consistent(transfer.state));
+
+    unsigned char nonce[16];
+    require(syscall(SYS_getrandom, pointer(nonce), sizeof(nonce), 0) == sizeof(nonce));
+    char leaf[64] = ".crucible-exec-";
+    const char hexadecimal[] = "0123456789abcdef";
+    for (unsigned index = 0; index < sizeof(nonce); ++index) {
+        leaf[14 + 2 * index] = hexadecimal[nonce[index] >> 4];
+        leaf[15 + 2 * index] = hexadecimal[nonce[index] & 15];
+    }
+    const long output = syscall(SYS_openat, root, pointer(leaf),
+                               O_RDWR | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+    require(output >= 0 && output < DescriptorLimit);
+    require(syscall(SYS_unlinkat, root, pointer(leaf), 0) == 0);
+    require(syscall(SYS_write, output, pointer(storage()), writer.size()) ==
+            static_cast<long>(writer.size()));
+
+    char descriptor_path[64];
+    const int length = std::snprintf(descriptor_path, sizeof(descriptor_path),
+                                     "/proc/self/fd/%ld", output);
+    require(length > 0 && static_cast<size_t>(length) < sizeof(descriptor_path));
+    const long input = syscall(SYS_openat, static_cast<std::uintptr_t>(AT_FDCWD),
+                              pointer(descriptor_path), O_RDONLY | O_CLOEXEC);
+    require(input >= 0 && input < DescriptorLimit);
+    require(syscall(SYS_close, output) == 0);
+    require(syscall(SYS_dup2, input, PROTECTED_CRUCIBLE_EXEC_FD) == PROTECTED_CRUCIBLE_EXEC_FD);
+    require(syscall(SYS_close, input) == 0);
+    require(::setenv("CRUCIBLE_CAPTURE_EXEC_HANDOFF", "1", 1) == 0);
+
+    control_channels().reservation.clear(std::memory_order_release);
+    control_bank().reservation.clear(std::memory_order_release);
+    log_writer::account().lock.clear(std::memory_order_release);
+}
+
+// Must run before console adoption or any library assertion. The input is an
+// actual inherited descriptor from the selected source route, not a pathname.
+inline void restore_before_logger()
+{
+    if (!selected() || restored()) return;
+    const char *handoff = std::getenv("CRUCIBLE_CAPTURE_EXEC_HANDOFF");
+    if (handoff == nullptr) return;
+    require(std::strcmp(handoff, "1") == 0);
+    require(!log_writer::account().initialized && control_bank().count == 0 &&
+            control_channels().count == 0 && original_control_requests().load() == 0 &&
+            original_probe_reservations().load() == 0 && attempts() == 0);
+    struct stat identity = {};
+    require(syscall(SYS_fstat, PROTECTED_CRUCIBLE_EXEC_FD, pointer(&identity)) == 0 &&
+            S_ISREG(identity.st_mode) && identity.st_uid == static_cast<uid_t>(syscall(SYS_geteuid)) &&
+            (identity.st_mode & 0777) == 0600 && identity.st_nlink == 0 &&
+            identity.st_size > 24 && identity.st_size <= static_cast<off_t>(exec_state::MaximumBytes) &&
+            (syscall(SYS_fcntl, PROTECTED_CRUCIBLE_EXEC_FD, F_GETFL) & O_ACCMODE) == O_RDONLY &&
+            syscall(SYS_lseek, PROTECTED_CRUCIBLE_EXEC_FD, 0, SEEK_CUR) == 0);
+    const size_t extent = static_cast<size_t>(identity.st_size);
+    require(syscall(SYS_read, PROTECTED_CRUCIBLE_EXEC_FD, pointer(storage()), extent) ==
+            static_cast<long>(extent));
+    exec_state::Reader reader(storage(), extent);
+    unsigned char magic[8] = {};
+    reader.bytes(magic, sizeof(magic));
+    const unsigned char expected[8] = {'D', 'C', 'P', 'X', 'F', 'E', 'R', 0};
+    std::uint64_t edition = 0;
+    size_t header_bytes = 0;
+    reader.unsigned_value(edition);
+    reader.unsigned_value(header_bytes);
+    require(std::memcmp(magic, expected, sizeof(magic)) == 0 &&
+            edition == exec_state::Edition && header_bytes == ControlHeaderBytes);
+    Transfer &transfer = candidate();
+    exec_state::fields(reader, transfer.state.log, transfer.state.control,
+                       transfer.state.channels, transfer.state.requests,
+                       transfer.state.probes, transfer.state.exec_attempts);
+    descriptor_fields(reader, transfer);
+    require(reader.complete() && exec_state::consistent(transfer.state) &&
+            transfer.state.log.process == kernel_identity::read(SYS_getpid) &&
+            transfer.state.log.uid == syscall(SYS_geteuid) &&
+            control_cookie_matches(transfer.cookie));
