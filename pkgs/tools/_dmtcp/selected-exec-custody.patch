+ * Bounded actual descriptor-namespace inspection; no native authority.
+ */
+#ifndef DMTCP_CRUCIBLE_DESCRIPTOR_SCOPE_H
+#define DMTCP_CRUCIBLE_DESCRIPTOR_SCOPE_H
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace dmtcp_crucible {
+namespace descriptor_scope {
+
+constexpr unsigned Limit = 1024;
+
+class Namespace {
+  public:
+    bool observe(const unsigned char *body, size_t extent)
+    {
+        if (body == nullptr || extent == 0 || extent > 8192) return false;
+        size_t position = 0;
+        while (position < extent) {
+            // Linux getdents64 has a fixed name offset, with native-endian
+            // reclen at offset16. Only kernel-returned bytes are inspected.
+            if (extent - position < 21 || entries_ == Limit + 3) return false;
+            std::uint16_t record_bytes = 0;
+            std::memcpy(&record_bytes, body + position + 16, sizeof(record_bytes));
+            if (record_bytes < 21 || record_bytes > extent - position) return false;
+            const auto *name = body + position + 19;
+            const void *end = std::memchr(name, 0, record_bytes - 19);
+            if (end == nullptr) return false;
+            const size_t length = static_cast<const unsigned char *>(end) - name;
+            if (length == 0 || length > 10) return false;
+            ++entries_;
+
+            if (length == 1 && name[0] == '.') {
+                if (dot_) return false;
+                dot_ = true;
+            } else if (length == 2 && name[0] == '.' && name[1] == '.') {
+                if (parent_) return false;
+                parent_ = true;
+            } else {
+                unsigned descriptor = 0;
+                if (length > 1 && name[0] == '0') return false;
+                for (size_t index = 0; index < length; ++index) {
+                    if (name[index] < '0' || name[index] > '9') return false;
+                    descriptor = descriptor * 10 + name[index] - '0';
+                    if (descriptor >= Limit) return false;
+                }
+                if (seen_[descriptor]) return false;
+                seen_[descriptor] = true;
+            }
+            position += record_bytes;
+        }
+        return position == extent;
+    }
+
+  private:
+    unsigned entries_ = 0;
+    bool dot_ = false;
+    bool parent_ = false;
+    bool seen_[Limit] = {};
+};
+
+// Operations are private native implementation calls. No callback, pointer,
+// or implementation object is included in the exec preservation format.
+template<class Operations>
+inline bool bounded_namespace(Operations &operations)
+{
+    const int directory = operations.open_directory();
+    if (directory < 0 || static_cast<unsigned>(directory) >= Limit) {
+        if (directory >= 0) operations.close_directory(directory);
+        return false;
+    }
+
+    Namespace observed;
+    unsigned char body[8192];
+    bool complete = false;
+    for (unsigned block = 0; block < 16; ++block) {
+        const long count = operations.read_entries(directory, body, sizeof(body));
+        if (count == 0) {
+            complete = true;
+            break;
+        }
+        if (count < 0 || static_cast<size_t>(count) > sizeof(body) ||
+            !observed.observe(body, static_cast<size_t>(count))) break;
+    }
+    const bool closed = operations.close_directory(directory) == 0;
+    return complete && closed;
+}
+
+} // namespace descriptor_scope
+} // namespace dmtcp_crucible
+#endif
