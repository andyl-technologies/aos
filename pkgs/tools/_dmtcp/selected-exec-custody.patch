+#ifndef DMTCP_CRUCIBLE_KERNEL_IDENTITY_H
+#define DMTCP_CRUCIBLE_KERNEL_IDENTITY_H
+
+#include <cerrno>
+#include <cstdlib>
+#include <cstring>
+#include <sys/syscall.h>
+
+namespace dmtcp_crucible {
+namespace kernel_identity {
+
+inline bool selected()
+{
+    return std::getenv("CRUCIBLE_CAPTURE_EXEC_CUSTODY_POLICY") != nullptr;
+}
+
+// Calling the DMTCP "real" syscall chain can reach a later PID plugin, whose
+// virtual table is not initialized before logger adoption. These two identity
+// reads must reach the kernel directly and must never rewrite original IDs.
+inline long read(long number)
+{
+    const char *policy = std::getenv("CRUCIBLE_CAPTURE_EXEC_CUSTODY_POLICY");
+    if (policy == nullptr || std::strcmp(policy, "exec-custody.v1") != 0 ||
+        (number != SYS_getpid && number != SYS_gettid)) {
+        errno = EACCES;
+        return -1;
+    }
+
+    long result;
+#if defined(__x86_64__)
+    __asm__ volatile("syscall" : "=a"(result) : "a"(number) : "rcx", "r11", "memory");
+#elif defined(__aarch64__)
+    register long syscall_number __asm__("x8") = number;
+    register long returned __asm__("x0");
+    __asm__ volatile("svc #0" : "=r"(returned) : "r"(syscall_number) : "memory", "cc");
+    result = returned;
+#else
+    errno = ENOTSUP;
+    return -1;
+#endif
+    if (result <= 0) {
+        errno = EACCES;
+        return -1;
+    }
+    return result;
+}
