+/* SPDX-License-Identifier: LGPL-3.0-or-later
+ * Copyright (C) 2026 Andyl, Inc.
+ * Explicit selected-producer exec preservation data, never native authority.
+ */
+#ifndef DMTCP_CRUCIBLE_EXEC_STATE_H
+#define DMTCP_CRUCIBLE_EXEC_STATE_H
+
+#include "../jalib/crucible_log_writer.h"
+#include "crucible_control_frame.h"
+
+#include <limits>
+
+namespace dmtcp_crucible {
+namespace exec_state {
+
+constexpr size_t MaximumBytes = 6 * 1024 * 1024;
+constexpr std::uint64_t Edition = 1;
+
+// Atomics and locks are native implementation details. Every retained value
+// below is encoded explicitly; no C++ object representation crosses exec.
+struct State {
+    log_writer::OriginalAccount log;
+    OriginalControlBank control;
+    OriginalControlChannels channels;
+    unsigned requests = 0;
+    unsigned probes = 0;
+    unsigned exec_attempts = 0;
+};
+
+class Writer {
+  public:
+    Writer(unsigned char *body, size_t capacity)
+        : body_(body), capacity_(capacity), valid_(body != nullptr && capacity <= MaximumBytes)
+    {}
+
+    template<class Integer>
+    void unsigned_value(Integer &value)
+    {
+        word(static_cast<std::uint64_t>(value));
+    }
+
+    template<class Integer>
+    void signed_value(Integer &value)
+    {
+        word(static_cast<std::uint64_t>(static_cast<std::int64_t>(value)));
+    }
+
+    void boolean(bool &value)
+    {
+        std::uint64_t encoded = value ? 1 : 0;
+        word(encoded);
+    }
+
+    void bytes(void *source, size_t extent)
+    {
+        if (!valid_ || extent > capacity_ - position_) {
+            valid_ = false;
+            return;
+        }
+        std::memcpy(body_ + position_, source, extent);
+        position_ += extent;
+    }
+
+    bool valid() const { return valid_; }
+    size_t size() const { return position_; }
+
+  private:
+    void word(std::uint64_t value)
+    {
+        unsigned char encoded[8];
+        for (unsigned index = 0; index < 8; ++index) {
+            encoded[index] = static_cast<unsigned char>(value >> (8 * index));
+        }
+        bytes(encoded, sizeof(encoded));
+    }
+
+    unsigned char *body_;
+    size_t capacity_;
+    size_t position_ = 0;
+    bool valid_;
+};
+
+class Reader {
+  public:
+    Reader(const unsigned char *body, size_t extent)
+        : body_(body), extent_(extent), valid_(body != nullptr && extent <= MaximumBytes)
+    {}
+
+    template<class Integer>
+    void unsigned_value(Integer &value)
+    {
+        const std::uint64_t decoded = word();
+        if (decoded > static_cast<std::uint64_t>(std::numeric_limits<Integer>::max())) {
+            valid_ = false;
+            return;
+        }
+        value = static_cast<Integer>(decoded);
+    }
+
+    template<class Integer>
+    void signed_value(Integer &value)
+    {
+        const std::uint64_t encoded = word();
+        const std::int64_t decoded = encoded <= INT64_MAX
+            ? static_cast<std::int64_t>(encoded)
+            : -static_cast<std::int64_t>(UINT64_MAX - encoded) - 1;
+        if (decoded < std::numeric_limits<Integer>::min() ||
+            decoded > std::numeric_limits<Integer>::max()) {
+            valid_ = false;
+            return;
+        }
+        value = static_cast<Integer>(decoded);
+    }
+
+    void boolean(bool &value)
+    {
+        const std::uint64_t decoded = word();
+        if (decoded > 1) {
+            valid_ = false;
+            return;
+        }
+        value = decoded == 1;
+    }
+
+    void bytes(void *destination, size_t extent)
+    {
+        if (!valid_ || extent > extent_ - position_) {
+            valid_ = false;
+            return;
+        }
+        std::memcpy(destination, body_ + position_, extent);
+        position_ += extent;
+    }
+
+    bool complete() const { return valid_ && position_ == extent_; }
+
+  private:
+    std::uint64_t word()
+    {
+        unsigned char encoded[8] = {};
+        bytes(encoded, sizeof(encoded));
+        std::uint64_t value = 0;
+        for (unsigned index = 0; index < 8; ++index) {
+            value |= static_cast<std::uint64_t>(encoded[index]) << (8 * index);
+        }
+        return value;
+    }
+
+    const unsigned char *body_;
+    size_t extent_;
+    size_t position_ = 0;
+    bool valid_;
+};
+
+template<class Codec>
+inline void boolean(Codec &codec, std::atomic<bool> &field)
+{
+    bool value = field.load(std::memory_order_acquire);
+    codec.boolean(value);
+    field.store(value, std::memory_order_release);
+}
+
+template<class Codec>
+inline void fields(Codec &codec, log_writer::OriginalAccount &log,
+                   OriginalControlBank &control, OriginalControlChannels &channels,
+                   unsigned &requests, unsigned &probes, unsigned &exec_attempts)
+{
+    codec.boolean(log.initialized);
+    codec.signed_value(log.process);
+    codec.unsigned_value(log.uid);
+    codec.unsigned_value(log.count);
+    unsigned refusal = static_cast<unsigned>(log.refusal.load(std::memory_order_acquire));
+    codec.unsigned_value(refusal);
+    log.refusal.store(static_cast<log_writer::Refusal>(refusal), std::memory_order_release);
+    codec.unsigned_value(log.attempt_count);
+    codec.unsigned_value(log.attempted);
+    codec.bytes(log.log_path, sizeof(log.log_path));
+    codec.bytes(log.log_leaf, sizeof(log.log_leaf));
+    codec.signed_value(log.root_descriptor);
+    codec.unsigned_value(log.root_device);
+    codec.unsigned_value(log.root_inode);
+
+    for (auto &message : log.messages) {
+        // Retain entire original storage, including embedded NULs and suffix
+        // bytes. Length alone cannot stand in for the producer's original body.
+        codec.bytes(message.body, sizeof(message.body));
+        codec.unsigned_value(message.length);
+        codec.boolean(message.completed);
+        for (unsigned sink = 0; sink < log_writer::SinkLimit; ++sink) {
+            codec.boolean(message.attempted[sink]);
+            codec.signed_value(message.written[sink]);
+            codec.signed_value(message.write_error[sink]);
+        }
+    }
+    for (auto &sink : log.sinks) {
+        codec.signed_value(sink.descriptor);
+        codec.signed_value(sink.original_descriptor);
+        codec.unsigned_value(sink.device);
+        codec.unsigned_value(sink.inode);
+        codec.unsigned_value(sink.attempted);
+        codec.boolean(sink.adopted);
+        codec.boolean(sink.birth_attempted);
+        codec.boolean(sink.close_attempted);
+        codec.boolean(sink.retired);
+    }
+    for (auto &attempt : log.attempts) {
+        codec.unsigned_value(attempt.message);
+        codec.unsigned_value(attempt.sink);
+        codec.unsigned_value(attempt.charged);
+        codec.signed_value(attempt.written);
+        codec.signed_value(attempt.write_error);
+    }
+
+    pid_t control_process = control.process.load(std::memory_order_acquire);
+    codec.signed_value(control_process);
+    control.process.store(control_process, std::memory_order_release);
+    codec.unsigned_value(control.count);
+    boolean(codec, control.terminal);
+    for (auto &frame : control.frames) {
+        boolean(codec, frame.attempted);
+        codec.boolean(frame.outgoing);
+        codec.boolean(frame.complete);
+        codec.signed_value(frame.channel);
+        boolean(codec, frame.settled);
+        codec.unsigned_value(frame.extent);
+        codec.unsigned_value(frame.transferred);
+        codec.signed_value(frame.error);
+        codec.signed_value(frame.close_error);
+        codec.bytes(frame.header, sizeof(frame.header));
+        codec.bytes(frame.body, sizeof(frame.body));
+    }
+    codec.signed_value(channels.process);
+    codec.unsigned_value(channels.count);
+    boolean(codec, channels.terminal);
+    for (auto &channel : channels.channels) {
+        codec.unsigned_value(channel.device);
+        codec.unsigned_value(channel.inode);
+        boolean(codec, channel.outgoing);
+        boolean(codec, channel.incoming);
+    }
+    codec.unsigned_value(requests);
+    codec.unsigned_value(probes);
+    codec.unsigned_value(exec_attempts);
+}
+
+// Quiescent exec transfers no stack-owned in-flight lease. Failed original
+// writes and frames still retain their full attempted debit and error history.
+inline bool consistent(const State &state)
+{
+    const auto &log = state.log;
+    if (!log.initialized || log.process <= 0 || log.count > log_writer::MessageLimit ||
+        log.attempt_count > log_writer::AttemptLimit ||
+        static_cast<unsigned>(log.refusal.load()) >
+            static_cast<unsigned>(log_writer::Refusal::EnvironmentExpansion) ||
+        log.attempted > log_writer::AttemptedBytes ||
+        std::memchr(log.log_path, 0, sizeof(log.log_path)) == nullptr ||
+        std::memchr(log.log_leaf, 0, sizeof(log.log_leaf)) == nullptr ||
+        state.control.count > ControlFrames || state.channels.count > ControlFrames ||
+        state.requests > 64 || state.probes > 1 || state.exec_attempts != 1) {
+        return false;
+    }
+
+    bool encountered[log_writer::MessageLimit][log_writer::SinkLimit] = {};
+    std::uint64_t charged = 0;
+    std::uint64_t sinks[log_writer::SinkLimit] = {};
+    for (unsigned index = 0; index < log.count; ++index) {
+        const auto &message = log.messages[index];
+        if (message.length > log_writer::MessageBytes ||
+            message.body[message.length] != '\0') return false;
+    }
+    for (unsigned index = 0; index < log.attempt_count; ++index) {
+        const auto &attempt = log.attempts[index];
+        if (attempt.message >= log.count || attempt.sink >= log_writer::SinkLimit ||
+            encountered[attempt.message][attempt.sink]) return false;
+        const auto &message = log.messages[attempt.message];
+        if (!message.completed || !message.attempted[attempt.sink] ||
+            attempt.charged != message.length ||
+            attempt.written != message.written[attempt.sink] ||
+            attempt.write_error != message.write_error[attempt.sink] ||
+            attempt.written < -1 ||
+            (attempt.written >= 0 && static_cast<std::uint64_t>(attempt.written) > attempt.charged) ||
+            attempt.write_error < 0 ||
+            (attempt.written >= 0 && attempt.write_error != 0) ||
+            attempt.charged > log_writer::AttemptedBytes - charged ||
+            attempt.charged > log_writer::SinkBytes - sinks[attempt.sink]) return false;
+        encountered[attempt.message][attempt.sink] = true;
+        charged += attempt.charged;
+        sinks[attempt.sink] += attempt.charged;
+    }
+    if (charged != log.attempted) return false;
+    for (unsigned sink = 0; sink < log_writer::SinkLimit; ++sink) {
+        if (sinks[sink] != log.sinks[sink].attempted ||
+            (log.sinks[sink].retired && !log.sinks[sink].close_attempted)) return false;
+        for (unsigned message = 0; message < log.count; ++message) {
+            if (log.messages[message].attempted[sink] != encountered[message][sink]) return false;
+        }
+    }
+
+    const pid_t process = state.control.process.load();
+    if ((process != 0 && process != log.process) ||
+        (state.channels.process != 0 && state.channels.process != log.process)) return false;
+    for (size_t index = 0; index < state.control.count; ++index) {
+        const auto &frame = state.control.frames[index];
+        if (!frame.attempted.load() || !frame.settled.load() || frame.channel != -1 ||
+            frame.extent > ControlHeaderBytes + ControlPayloadBytes ||
+            frame.transferred > frame.extent || frame.error < 0 || frame.close_error < 0 ||
+            (frame.complete && (frame.transferred != frame.extent || frame.error != 0))) return false;
+    }
+    for (size_t index = 0; index < state.channels.count; ++index) {
+        const auto &channel = state.channels.channels[index];
+        if (channel.incoming.load() || channel.outgoing.load()) return false;
+        for (size_t earlier = 0; earlier < index; ++earlier) {
+            if (channel.device == state.channels.channels[earlier].device &&
+                channel.inode == state.channels.channels[earlier].inode) return false;
+        }
+    }
+    return true;
+}
+
+inline size_t encode(State &state, unsigned char *body, size_t capacity)
+{
+    if (!consistent(state)) return 0;
+    Writer writer(body, capacity);
+    unsigned char magic[8] = {'D', 'C', 'P', 'E', 'X', 'E', 'C', 0};
+    writer.bytes(magic, sizeof(magic));
+    std::uint64_t edition = Edition;
+    size_t header_bytes = ControlHeaderBytes;
+    writer.unsigned_value(edition);
+    writer.unsigned_value(header_bytes);
+    fields(writer, state.log, state.control, state.channels,
+           state.requests, state.probes, state.exec_attempts);
+    return writer.valid() ? writer.size() : 0;
+}
+
+// The destination is an untrusted candidate, never a live producer. Callers
+// must authenticate native custody and kernel descriptors before installation.
+inline bool decode(const unsigned char *body, size_t extent, State &candidate)
+{
+    Reader reader(body, extent);
+    unsigned char magic[8] = {};
+    reader.bytes(magic, sizeof(magic));
+    const unsigned char expected[8] = {'D', 'C', 'P', 'E', 'X', 'E', 'C', 0};
+    std::uint64_t edition = 0;
+    size_t header_bytes = 0;
+    reader.unsigned_value(edition);
+    reader.unsigned_value(header_bytes);
+    if (std::memcmp(magic, expected, sizeof(magic)) != 0 ||
+        edition != Edition || header_bytes != ControlHeaderBytes) return false;
+    fields(reader, candidate.log, candidate.control, candidate.channels,
+           candidate.requests, candidate.probes, candidate.exec_attempts);
+    return reader.complete() && consistent(candidate);
+}
