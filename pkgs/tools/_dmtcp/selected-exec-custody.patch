+    exec_state::Writer writer(storage(), exec_state::MaximumBytes);
+    unsigned char magic[8] = {'D', 'C', 'P', 'X', 'F', 'E', 'R', 0};
+    writer.bytes(magic, sizeof(magic));
+    std::uint64_t edition = exec_state::Edition;
+    size_t header_bytes = ControlHeaderBytes;
+    writer.unsigned_value(edition);
+    writer.unsigned_value(header_bytes);
+    unsigned requests = original_control_requests().load();
+    unsigned probes = original_probe_reservations().load();
+    exec_state::fields(writer, log_writer::account(), control_bank(), control_channels(),
+                       requests, probes, attempts());
+    descriptor_fields(writer, transfer);
+    require(writer.valid());
