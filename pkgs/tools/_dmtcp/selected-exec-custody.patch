+#ifndef DMTCP_CRUCIBLE_EXEC_CUSTODY_H
+#define DMTCP_CRUCIBLE_EXEC_CUSTODY_H
+
+#include "crucible_exec_state.h"
+#include "crucible_descriptor_scope.h"
+
+#include <sys/vfs.h>
+#include "protectedfds.h"
+
+namespace dmtcp_crucible {
+namespace exec_custody {
+
+constexpr unsigned DescriptorLimit = 1024;
+
+struct Descriptor {
+    bool present = false;
+    int flags = 0;
+    int status = 0;
+    dev_t device = 0;
+    ino_t inode = 0;
+    mode_t mode = 0;
+    uid_t uid = 0;
+    std::int64_t offset = -1;
+};
+
+struct PeerIdentity {
+    std::uint64_t host = 0;
+    pid_t process = 0;
+    std::uint64_t time = 0;
+    std::uint32_t generation = 0;
+};
+
+struct Transfer {
+    exec_state::State state;
+    PeerIdentity process;
+    PeerIdentity parent;
+    unsigned char cookie[32] = {};
+    Descriptor descriptors[DescriptorLimit];
+};
+
+inline bool selected()
+{
+    static std::atomic<bool> observed{false};
+    const char *policy = std::getenv("CRUCIBLE_CAPTURE_EXEC_CUSTODY_POLICY");
+    if (policy != nullptr || std::getenv("CRUCIBLE_CAPTURE_EXEC_HANDOFF") != nullptr) {
+        observed.store(true, std::memory_order_release);
+    }
+    if (!observed.load(std::memory_order_acquire)) return false;
+    log_writer::require(policy != nullptr && std::strcmp(policy, "exec-custody.v1") == 0 &&
+                        log_writer::selected() && writer_cohort_admitted(),
+                        log_writer::Refusal::Policy);
+    return true;
+}
+
+inline unsigned &attempts()
+{
+    static unsigned original = 0;
+    return original;
+}
+
+inline bool &restored()
+{
+    static bool imported = false;
+    return imported;
+}
+
+inline unsigned char *storage()
+{
+    static unsigned char body[exec_state::MaximumBytes];
+    return body;
+}
+
+inline Transfer &candidate()
+{
+    static Transfer transfer;
+    return transfer;
+}
+
+template<class Codec>
+inline void descriptor_fields(Codec &codec, Transfer &transfer)
+{
+    PeerIdentity *peers[] = {&transfer.process, &transfer.parent};
+    for (PeerIdentity *peer : peers) {
+        codec.unsigned_value(peer->host);
+        codec.signed_value(peer->process);
+        codec.unsigned_value(peer->time);
+        codec.unsigned_value(peer->generation);
+    }
+    codec.bytes(transfer.cookie, sizeof(transfer.cookie));
+    for (auto &descriptor : transfer.descriptors) {
+        codec.boolean(descriptor.present);
+        codec.signed_value(descriptor.flags);
+        codec.signed_value(descriptor.status);
+        codec.unsigned_value(descriptor.device);
+        codec.unsigned_value(descriptor.inode);
+        codec.unsigned_value(descriptor.mode);
+        codec.unsigned_value(descriptor.uid);
+        codec.signed_value(descriptor.offset);
+    }
+}
+
+inline void require(bool valid)
+{
+    log_writer::require(valid, log_writer::Refusal::SinkIdentity);
+}
+
+inline long syscall(long number, std::uintptr_t first = 0,
+                    std::uintptr_t second = 0, std::uintptr_t third = 0,
+                    std::uintptr_t fourth = 0)
+{
+    return log_writer::original_syscall(number, first, second, third, fourth);
+}
+
+inline std::uintptr_t pointer(const void *body)
+{
+    return reinterpret_cast<std::uintptr_t>(body);
+}
+
+class DescriptorOperations {
+  public:
+    int open_directory()
+    {
+        const char path[] = "/proc/self/fd";
+        const long fd = syscall(SYS_openat, static_cast<std::uintptr_t>(AT_FDCWD),
+                                pointer(path), O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+        if (fd < 0) return -1;
+        struct statfs filesystem = {};
+        if (syscall(SYS_fstatfs, fd, pointer(&filesystem)) != 0 ||
+            filesystem.f_type != 0x9fa0) { // Linux PROC_SUPER_MAGIC.
+            syscall(SYS_close, fd);
+            return -1;
+        }
+        return static_cast<int>(fd);
+    }
+
+    long read_entries(int directory, unsigned char *body, size_t extent)
+    {
+        return syscall(SYS_getdents64, directory, pointer(body), extent);
+    }
+
+    long close_directory(int directory)
+    {
+        return syscall(SYS_close, directory);
+    }
+};
+
+inline void require_bounded_namespace()
+{
+    // A lowered RLIMIT does not retire already inherited high descriptors.
+    // Refuse any such slot in the actual kernel table before a bounded census.
+    DescriptorOperations operations;
+    require(descriptor_scope::bounded_namespace(operations));
+}
+
+// The current source owns the actual descriptor census. Cookie equality and
+// file metadata alone do not issue any native source or activation permission.
+inline void census(Transfer &transfer)
+{
+    for (unsigned fd = 0; fd < DescriptorLimit; ++fd) {
+        auto &retained = transfer.descriptors[fd];
+        const long flags = syscall(SYS_fcntl, fd, F_GETFD);
+        if (flags < 0) {
+            require(errno == EBADF);
+            continue;
+        }
+        struct stat identity = {};
+        require(syscall(SYS_fstat, fd, pointer(&identity)) == 0);
+        retained.present = true;
+        retained.flags = static_cast<int>(flags);
+        retained.status = static_cast<int>(syscall(SYS_fcntl, fd, F_GETFL));
+        require(retained.status >= 0);
+        retained.device = identity.st_dev;
+        retained.inode = identity.st_ino;
+        retained.mode = identity.st_mode;
+        retained.uid = identity.st_uid;
+        retained.offset = syscall(SYS_lseek, fd, 0, SEEK_CUR);
+        require(retained.offset >= 0 || errno == ESPIPE);
+    }
+}
+
+inline void validate_census(const Transfer &transfer)
+{
+    for (unsigned fd = 0; fd < DescriptorLimit; ++fd) {
+        const auto &retained = transfer.descriptors[fd];
+        const long flags = syscall(SYS_fcntl, fd, F_GETFD);
+        if (!retained.present || (retained.flags & FD_CLOEXEC) != 0) {
+            if (fd != PROTECTED_CRUCIBLE_EXEC_FD) require(flags < 0 && errno == EBADF);
+            continue;
+        }
+        struct stat identity = {};
+        require(flags == retained.flags &&
+                syscall(SYS_fcntl, fd, F_GETFL) == retained.status &&
+                syscall(SYS_fstat, fd, pointer(&identity)) == 0 &&
+                identity.st_dev == retained.device && identity.st_ino == retained.inode &&
+                identity.st_mode == retained.mode && identity.st_uid == retained.uid);
+        const long offset = syscall(SYS_lseek, fd, 0, SEEK_CUR);
+        require(offset == retained.offset && (offset >= 0 || errno == ESPIPE));
+    }
+}
+
+// This call owns the sole attempted exec handoff. Any failure retains that
+// debit; retries, application re-exec and substitution are not admitted.
+inline void publish()
+{
+    if (!selected()) return;
+    require(std::getenv("CRUCIBLE_CAPTURE_EXEC_HANDOFF") == nullptr && attempts() == 0);
+    ++attempts();
+    require(!log_writer::account().lock.test_and_set(std::memory_order_acquire));
+    require(!control_bank().reservation.test_and_set(std::memory_order_acquire));
+    require(!control_channels().reservation.test_and_set(std::memory_order_acquire));
+
+    // Preserve the actual held root descriptor; opening a new path after exec
+    // would replace custody with a filesystem-name claim.
+    const int root = log_writer::account().root_descriptor;
+    require(root >= 0 && root < static_cast<int>(DescriptorLimit));
+    const long root_flags = syscall(SYS_fcntl, root, F_GETFD);
+    require(root_flags >= 0 && syscall(SYS_fcntl, root, F_SETFD, root_flags & ~FD_CLOEXEC) == 0);
+    require(syscall(SYS_fcntl, PROTECTED_CRUCIBLE_EXEC_FD, F_GETFD) == -1 && errno == EBADF);
+
+    Transfer &transfer = candidate();
+    require(load_control_cookie(transfer.cookie));
+    const dmtcp::UniquePid *peers[] = {&dmtcp::UniquePid::ThisProcess(true),
+                                     &dmtcp::UniquePid::ParentProcess()};
+    PeerIdentity *retained[] = {&transfer.process, &transfer.parent};
+    for (unsigned index = 0; index < 2; ++index) {
+        retained[index]->host = peers[index]->hostid();
+        retained[index]->process = peers[index]->pid();
+        retained[index]->time = peers[index]->time();
+        retained[index]->generation = peers[index]->upid()._computation_generation;
+    }
