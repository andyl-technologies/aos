 static FileConnList *fileConnList = NULL;
 static FileConnList *vfork_fileConnList = NULL;
 
+// These fixed records bind the real pre-transform file mapping to the saved
+// FileConnection copy. They are filled before the writer captures any bytes.
+struct CrucibleFileMapReceipt {
+  unsigned char original[1112];
+  char supplementary[4096];
+  uint64_t checkpointed;
+  uint64_t transient_fd;
+};
+static_assert(sizeof(CrucibleFileMapReceipt) == 5224, "receipt ABI changed");
+static CrucibleFileMapReceipt crucibleFileMaps[1024];
+static int crucibleFileMapCount = -1;
+
+extern "C" int
+dmtcp_crucible_checkpoint_file_map_count(void)
+{
+  return crucibleFileMapCount;
+}
+
+extern "C" int
+dmtcp_crucible_checkpoint_file_map(int index, uint64_t *address,
+                                 void *bytes, size_t capacity)
+{
+  if (index < 0 || index >= crucibleFileMapCount || !address || !bytes ||
+      capacity < sizeof(CrucibleFileMapReceipt)) {
+    return -1;
+  }
+  const auto &record = crucibleFileMaps[index];
+  *address = (uint64_t)&record;
+  memcpy(bytes, &record, sizeof(record));
+  return sizeof(record);
+}
