+    /// Registers an occupied source without consuming it on error or unwind.
+    #[track_caller]
+    pub(crate) fn new_with_retained_io_and_handle(
+        io: &mut Option<E>,
+        interest: Interest,
+        handle: scheduler::Handle,
+    ) -> io::Result<Self> {
+        let Some(source) = io.as_mut() else {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "I/O registration requires an occupied source slot",
+            ));
+        };
+
+        let registration = Registration::new_with_interest_and_handle(source, interest, handle)?;
+
+        // The exclusive source loan kept the slot occupied. Transfer only moves;
+        // no check or user code may run between registration and assembly.
+        Ok(Self {
+            io: io.take(),
+            registration,
+        })
+    }
 
