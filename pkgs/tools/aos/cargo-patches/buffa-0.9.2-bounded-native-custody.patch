+/// Merges one unknown field, retaining a failed group's materialized children.
+///
+/// With an ordinary context, this preserves the existing decode-then-push order.
+/// The optional context changes partial output ownership only, not wire validity
+/// or any parser budget. A partial group must never be used as successful DATA.
+///
+/// # Errors
+/// Returns the original unknown-field parser error, after parking any failed
+/// materialized group when partial-child retention is enabled.
+#[doc(hidden)]
+pub fn merge_unknown_field_retaining(
+    tag: Tag,
+    buf: &mut impl Buf,
+    ctx: crate::DecodeContext<'_>,
+    output: &mut crate::unknown_fields::UnknownFields,
+) -> Result<(), DecodeError> {
+    if !ctx.retains_partial_children() {
+        output.push(decode_unknown_field(tag, buf, ctx)?);
+        return Ok(());
+    }
+
+    let mut partial = None;
+    match decode_unknown_field_engine(tag, buf, ctx, Some(&mut partial)) {
+        Ok(field) => {
+            output.push(field);
+            Ok(())
+        }
+        Err(error) => {
+            if let Some(field) = partial {
+                output.push(field);
+            }
+            Err(error)
+        }
+    }
+}
