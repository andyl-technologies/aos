+    /// Merges with default budgets while retaining failed repeated/group children.
+    ///
+    /// The receiver must remain with the caller on error. Partial children are
+    /// comparison output and must never be treated as a successfully decoded
+    /// message. Singular message fields already merge in place. This hook does
+    /// not retain a failed map-entry or a replaced oneof's previous variant;
+    /// callers requiring complete partial custody must exclude those shapes.
+    /// Ordinary [`Message::merge_from_slice`] behavior is unchanged.
+    ///
+    /// # Errors
+    /// Returns the same parser error as the ordinary default-budget merge.
+    fn merge_retaining_from_slice(&mut self, mut data: &[u8]) -> Result<(), DecodeError> {
+        let limit = core::cell::Cell::new(DEFAULT_UNKNOWN_FIELD_LIMIT);
+        let elem_budget = core::cell::Cell::new(DEFAULT_ELEMENT_MEMORY_LIMIT);
+        self.merge(
+            &mut data,
+            DecodeContext::new(RECURSION_LIMIT, &limit)
+                .with_element_memory(&elem_budget)
+                .with_partial_child_retention(),
         )
