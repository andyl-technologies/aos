+#[cfg(test)]
+mod retained_unknown_group_tests {
+    use super::*;
+    use crate::{DecodeContext, UnknownFieldData, UnknownFields};
+
+    #[test]
+    fn malformed_nested_group_keeps_only_selected_partial_children() {
+        // Outer group 10, complete bytes child11, nested group12 containing a
+        // complete bytes child13 then a truncated varint child14.
+        let payload = [0x5a, 3, b'a', b'b', b'c', 0x63, 0x6a, 2, b'd', b'e', 0x70, 0x80];
+        let mut ordinary = UnknownFields::new();
+        let ordinary_limit = core::cell::Cell::new(crate::DEFAULT_UNKNOWN_FIELD_LIMIT);
+        let ordinary_ctx = DecodeContext::new(crate::RECURSION_LIMIT, &ordinary_limit);
+        let ordinary_error = merge_unknown_field_retaining(
+            Tag::new(10, WireType::StartGroup), &mut payload.as_slice(), ordinary_ctx,
+            &mut ordinary,
+        ).unwrap_err();
+
+        let mut retained = UnknownFields::new();
+        let retained_limit = core::cell::Cell::new(crate::DEFAULT_UNKNOWN_FIELD_LIMIT);
+        let retained_ctx = DecodeContext::new(crate::RECURSION_LIMIT, &retained_limit)
+            .with_partial_child_retention();
+        let retained_error = merge_unknown_field_retaining(
+            Tag::new(10, WireType::StartGroup), &mut payload.as_slice(), retained_ctx,
+            &mut retained,
+        ).unwrap_err();
+
+        assert_eq!(retained_error, ordinary_error);
+        assert_eq!(retained_limit.get(), ordinary_limit.get());
+        assert!(ordinary.is_empty());
+        let UnknownFieldData::Group(outer) = &retained.iter().next().unwrap().data else {
+            panic!("failed outer group was not retained");
+        };
+        assert_eq!(outer.len(), 2);
+        let UnknownFieldData::LengthDelimited(bytes) = &outer.iter().next().unwrap().data else {
+            panic!("first complete child was not retained");
+        };
+        assert_eq!(bytes, b"abc");
+        let UnknownFieldData::Group(inner) = &outer.iter().nth(1).unwrap().data else {
+            panic!("failed nested group was not retained");
+        };
+        assert_eq!(inner.len(), 1);
+        let UnknownFieldData::LengthDelimited(bytes) = &inner.iter().next().unwrap().data else {
+            panic!("completed inner child was not retained");
+        };
+        assert_eq!(bytes, b"de");
+    }
+}
