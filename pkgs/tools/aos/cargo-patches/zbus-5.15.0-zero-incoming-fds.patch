+    pub(crate) fn retain_auth_line(&self, bytes: &[u8]) -> crate::Result<()> {
+        let mut lines = self.auth_lines.try_lock().map_err(|_| crate::Error::InvalidReply)?;
+        if lines.len() == 4 || bytes.len() > LAUNCHER_AUTH_BYTES {
+            self.end();
+            return Err(crate::Error::ExcessData);
+        }
+        lines.push(bytes.to_vec());
+
+        Ok(())
+    }
