 #[cfg(all(unix, feature = "tokio"))]
+struct TokioReceiveDisposition<'a> {
+    control: IncomingControl,
+    failed: Option<&'a mut bool>,
+}
+
+#[cfg(all(unix, feature = "tokio"))]
+impl<'a> TokioReceiveDisposition<'a> {
+    fn legacy() -> Self {
+        Self {
+            control: IncomingControl::Legacy,
+            failed: None,
+        }
+    }
+
+    #[cfg(target_os = "linux")]
+    fn reject_incoming(failed: &'a mut bool) -> Self {
+        Self {
+            control: IncomingControl::RejectIncoming,
+            failed: Some(failed),
+        }
+    }
+
+    fn control(&self) -> IncomingControl {
+        self.control
+    }
+
+    fn require_open(&self) -> std::io::Result<()> {
+        #[cfg(target_os = "linux")]
+        if self.failed.as_deref() == Some(&true) {
+            return Err(IncomingControlError::Fenced.into_io());
+        }
+
+        Ok(())
+    }
+
+    fn retain_terminal(&mut self, _result: &super::RecvmsgResult) {
+        #[cfg(target_os = "linux")]
+        if let (Some(failed), Err(error)) = (self.failed.as_deref_mut(), _result) {
+            if error
+                .get_ref()
+                .is_some_and(|source| source.is::<IncomingControlError>())
+            {
+                *failed = true;
+            }
+        }
+    }
+}
