+    pub(crate) fn remaining_auth_bytes(&self) -> crate::Result<usize> {
+        let native = self.native.try_lock().map_err(|_| crate::Error::InvalidReply)?;
+        LAUNCHER_AUTH_BYTES.checked_sub(native.prefixes.len()).ok_or(crate::Error::ExcessData)
+    }
