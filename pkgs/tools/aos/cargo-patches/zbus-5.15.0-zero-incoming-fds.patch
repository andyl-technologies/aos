+#[cfg(all(test, target_os = "linux", feature = "tokio"))]
+mod incoming_control_tests {
+    use super::*;
+
+    #[test]
+    fn restricted_control_capacity_is_zero_not_one_fd() {
+        assert_eq!(IncomingControl::RejectIncoming.capacity(), 0);
+        assert_eq!(
+            IncomingControl::Legacy.capacity(),
+            rustix::cmsg_space!(ScmRights(FDS_MAX))
+        );
+    }
+
+    #[test]
+    fn control_truncation_is_typed_terminal_invalid_data() {
+        let error = require_untruncated_control(rustix::net::ReturnFlags::CTRUNC)
+            .unwrap_err();
+
+        assert_eq!(error.kind(), std::io::ErrorKind::InvalidData);
+        assert_eq!(
+            error
+                .get_ref()
+                .unwrap()
+                .downcast_ref::<IncomingControlError>(),
+            Some(&IncomingControlError::Truncated)
+        );
+        assert!(require_untruncated_control(rustix::net::ReturnFlags::empty()).is_ok());
+    }
+
+    #[test]
+    fn terminal_control_error_fences_later_reads_without_replacing_original() {
+        for cause in [
+            IncomingControlError::Truncated,
+            IncomingControlError::Unexpected,
+        ] {
+            let mut failed = false;
+            let mut disposition = TokioReceiveDisposition::reject_incoming(&mut failed);
+            let result = Err(cause.into_io());
+
+            disposition.retain_terminal(&result);
+            let later = disposition.require_open().unwrap_err();
+
+            assert_eq!(later.kind(), std::io::ErrorKind::InvalidData);
+            assert_eq!(
+                later
+                    .get_ref()
+                    .unwrap()
+                    .downcast_ref::<IncomingControlError>(),
+                Some(&IncomingControlError::Fenced)
+            );
+            assert!(
+                result
+                    .as_ref()
+                    .unwrap_err()
+                    .get_ref()
+                    .unwrap()
+                    .is::<IncomingControlError>()
+            );
+
+            disposition.retain_terminal(&Ok((1, vec![])));
+            assert!(disposition.require_open().is_err());
+        }
+    }
+
+    #[test]
+    fn native_retry_and_other_io_causes_are_not_control_rejections() {
+        for kind in [
+            std::io::ErrorKind::Interrupted,
+            std::io::ErrorKind::WouldBlock,
+            std::io::ErrorKind::BrokenPipe,
+        ] {
+            let mut failed = false;
+            let mut disposition = TokioReceiveDisposition::reject_incoming(&mut failed);
+            let result = Err(std::io::Error::from(kind));
+
+            disposition.retain_terminal(&result);
+
+            assert!(disposition.require_open().is_ok());
+            assert_eq!(result.unwrap_err().kind(), kind);
+        }
+    }
+
+    #[test]
+    fn empty_control_uses_same_parser_and_returns_no_fds() {
+        let mut storage = [];
+        let mut ancillary = RecvAncillaryBuffer::new(&mut storage);
+
+        let fds = collect_received_fds(&mut ancillary, IncomingControl::RejectIncoming)
+            .unwrap();
+
+        assert!(fds.is_empty());
+    }
+}
