+#[async_trait::async_trait]
+impl super::ReadHalf for LauncherUnixReadHalf {
+    async fn recvmsg(&mut self, buf: &mut [u8]) -> super::RecvmsgResult {
+        tokio_recvmsg(
+            &self.stream,
+            buf,
+            TokioReceiveDisposition::launcher(&self.custody),
+        )
+        .await
+    }
+
+    async fn receive_message(
+        &mut self,
+        seq: u64,
+        already_received_bytes: &mut Vec<u8>,
+        already_received_fds: &mut Vec<OwnedFd>,
+    ) -> crate::Result<crate::Message> {
+        let custody = self.custody.clone();
+        let mut boundary = LauncherReceiveBoundary::new(&custody);
+        custody.require_open()?;
+        let mut storage = custody.frames.lock().await;
+        custody.require_open()?;
+        let index = storage.next;
+        if index == LAUNCHER_MESSAGE_COUNT {
+            custody.retain_failure(crate::Error::ExcessData);
+            return Err(crate::Error::InvalidReply);
+        }
+        storage.next += 1;
+        custody.in_auth.store(false, std::sync::atomic::Ordering::Release);
+        custody.frame_fds.store(already_received_fds.len(), std::sync::atomic::Ordering::Release);
+
+        let result = super::receive_message_in_frame(
+            self,
+            seq,
+            already_received_bytes,
+            already_received_fds,
+            &mut storage.frames[index],
+        )
+        .await;
+        let message = match result {
+            Ok(message) => message,
+            Err(cause) => {
+                custody.retain_failure(cause);
+                return Err(crate::Error::InvalidReply);
+            }
+        };
+        storage.messages.push(message);
+        let Some(message) = storage.messages.last() else {
+            custody.retain_failure(crate::Error::InvalidReply);
+            return Err(crate::Error::InvalidReply);
+        };
+
+        let expected = custody.expected_image_serial.load(std::sync::atomic::Ordering::Acquire);
+        let matches_image = expected != 0 && message.header().reply_serial().is_some_and(|serial| serial.get() == expected);
+        if message.header().unix_fds().unwrap_or(0) as usize != message.data().fds().len()
+            || (!message.data().fds().is_empty()
+            && (!matches_image || message.data().fds().len() != 1
+                || message.message_type() != crate::message::Type::MethodReturn))
+        {
+            custody.retain_failure(crate::Error::InvalidReply);
+            return Err(crate::Error::InvalidReply);
+        }
+        if matches_image {
+            custody.expected_image_serial.store(0, std::sync::atomic::Ordering::Release);
+        }
+        let reply = message.clone();
+        boundary.complete();
+
+        Ok(reply)
+    }
+
+    fn can_pass_unix_fd(&self) -> bool {
+        true
+    }
+
+    async fn peer_credentials(&mut self) -> std::io::Result<crate::fdo::ConnectionCredentials> {
+        get_unix_peer_creds(&self.stream).await
+    }
+}
