+// Both recipes use the original Tokio readiness/syscall/retry engine.
+#[cfg(all(unix, feature = "tokio"))]
+async fn tokio_recvmsg(
+    stream: &tokio::net::UnixStream,
+    buf: &mut [u8],
+    mut disposition: TokioReceiveDisposition<'_>,
+) -> super::RecvmsgResult {
+    disposition.require_open()?;
+
+    poll_fn(|cx| {
+        loop {
+            match stream.try_io(tokio::io::Interest::READABLE, || {
+                // We use own custom function for reading because we need to receive file
+                // descriptors too.
+                match disposition.control() {
+                    IncomingControl::Legacy => fd_recvmsg(stream.as_fd(), buf),
+                    #[cfg(target_os = "linux")]
+                    IncomingControl::RejectIncoming => {
+                        fd_recvmsg_with_control(stream.as_fd(), buf, IncomingControl::RejectIncoming)
+                    }
+                    #[cfg(target_os = "linux")]
+                    IncomingControl::Launcher { .. } => match disposition.launcher {
+                        Some(custody) => fd_recvmsg_launcher(stream.as_fd(), buf, custody),
+                        None => Err(IncomingControlError::Fenced.into_io()),
+                    },
+                }
+            }) {
+                Err(e) if e.kind() == std::io::ErrorKind::Interrupted => {}
+                Err(e) if e.kind() == std::io::ErrorKind::WouldBlock => {
+                    match stream.poll_read_ready(cx) {
+                        Poll::Pending => return Poll::Pending,
+                        Poll::Ready(res) => res?,
+                    }
+                }
+                v => {
+                    disposition.retain_terminal(&v);
+
+                    return Poll::Ready(v);
+                }
+            }
+        }
+    })
+    .await
+}
