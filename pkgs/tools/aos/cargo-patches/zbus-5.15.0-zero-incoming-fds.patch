+#[cfg(all(target_os = "linux", feature = "tokio"))]
+fn fd_recvmsg_launcher(
+    fd: BorrowedFd<'_>,
+    buffer: &mut [u8],
+    custody: &LauncherImageReceiveCustodyV1,
+) -> super::RecvmsgResult {
+    use std::sync::atomic::Ordering;
+
+    if custody.require_open().is_err() {
+        return Err(IncomingControlError::Fenced.into_io());
+    }
+    let mut native = match custody.native.try_lock() {
+        Ok(native) => native,
+        Err(_) => {
+            custody.retain_failure(crate::Error::InvalidReply);
+            return Err(IncomingControlError::Fenced.into_io());
+        }
+    };
+    let mut boundary = LauncherReceiveBoundary::new(custody);
+    if native.current >= native.records.len()
+        || buffer.len() > LAUNCHER_CAPTURE_BYTES - native.prefixes.len()
+        || (custody.in_auth.load(Ordering::Acquire)
+            && buffer.len() > LAUNCHER_AUTH_BYTES - native.prefixes.len())
+    {
+        custody.retain_failure(crate::Error::ExcessData);
+        return Err(IncomingControlError::Fenced.into_io());
+    }
+
+    let accepts_image_fd = !custody.in_auth.load(Ordering::Acquire)
+        && custody.expected_image_serial.load(Ordering::Acquire) != 0
+        && custody.frame_fds.load(Ordering::Acquire) == 0;
+    if accepts_image_fd && native.current >= 2 {
+        custody.retain_failure(crate::Error::ExcessData);
+        return Err(IncomingControlError::Fenced.into_io());
+    }
+    let LauncherNativeCustody {
+        records, current, empty_reads, empty_bytes, empty_flags, prefixes, first_failure,
+    } = &mut *native;
+    let record = &mut records[*current];
+    record.capture.prefix_start = prefixes.len();
+    let control = IncomingControl::Launcher { accepts_image_fd };
+    let result = fd_recvmsg_in_storage(
+        fd,
+        buffer,
+        control,
+        &mut record.control[..control.capacity()],
+        Some(&mut record.capture),
+        Some(prefixes),
+    );
+
+    match result {
+        Ok((reported, fds)) => {
+            if record.capture.control_used == 0 {
+                // No cmsg bytes were captured. Capacity is not initialized data.
+                // All actual payload bytes remain in the aggregate prefix owner.
+                *empty_reads += 1;
+                *empty_bytes += reported;
+                *empty_flags |= record.capture.flags;
+                record.capture.reported = 0;
+                record.capture.prefix_start = prefixes.len();
+                record.capture.prefix_end = prefixes.len();
+            } else {
+                *current += 1;
+            }
+            custody.frame_fds.fetch_add(fds.len(), Ordering::AcqRel);
+            boundary.complete();
+            Ok((reported, fds))
+        }
+        // These two errno values arise only from recvmsg(-1). Post-consumption
+        // denials use InvalidData and therefore cannot enter Tokio's retry loop.
+        Err(error) if record.capture.reported == 0
+            && record.capture.control_used == 0
+            && matches!(error.kind(), std::io::ErrorKind::Interrupted | std::io::ErrorKind::WouldBlock) =>
+        {
+            boundary.complete();
+            Err(error)
+        }
+        Err(error) => {
+            custody.end();
+            if first_failure.is_none() {
+                *first_failure = Some(error);
+            }
+            Err(IncomingControlError::Fenced.into_io())
+        }
+    }
+}
