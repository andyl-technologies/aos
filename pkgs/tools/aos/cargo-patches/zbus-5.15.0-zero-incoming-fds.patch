+#[cfg(all(target_os = "linux", feature = "tokio"))]
+pub(crate) fn split_launcher_image(
+    stream: tokio::net::UnixStream,
+    custody: std::sync::Arc<LauncherImageReceiveCustodyV1>,
+) -> crate::Result<super::BoxedSplit> {
+    let mut boundary = LauncherReceiveBoundary::new(&custody);
+    custody.require_open()?;
+
+    // The Arc allocation is an explicit funding boundary. The outer attempt
+    // already owns custody; no successful allocation creates peer authority.
+    let stream = std::sync::Arc::new(stream);
+    if let Err(original) = custody.socket.set(stream.clone()) {
+        // This fixed builder has one split attempt. Park its actual rejected
+        // original before ending either queue; it is not a replacement stream.
+        let original = custody.rejected_socket.get_or_init(|| original);
+        custody.end();
+        custody.rejected_shutdown_result.get_or_init(|| {
+            rustix::net::shutdown(original.as_fd(), rustix::net::Shutdown::Both)
+                .map_err(std::io::Error::from)
+        });
+        return Err(crate::Error::InvalidReply);
+    }
+
+    let split = super::Split::new(
+        Box::new(LauncherUnixReadHalf { stream: stream.clone(), custody: custody.clone() }),
+        Box::new(LauncherUnixWriteHalf { stream, custody: custody.clone() }),
+    );
+    boundary.complete();
+
+    Ok(split)
+}
