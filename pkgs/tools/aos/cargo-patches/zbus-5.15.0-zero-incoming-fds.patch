+/// Owns one closed Mount or Source launcher-image observation over the fixed bus.
+///
+/// The original socket, AUTH bytes, requests, replies and consumed failure state
+/// stay resident. Completion yields transport DATA only: it does not admit an
+/// execution, make a fragment immutable or authorize a Source operation.
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+pub struct FixedLauncherImageAttemptV1 {
+    custody: std::sync::Arc<super::socket::LauncherImageReceiveCustodyV1>,
+    connection: Option<Connection>,
+    unit: &'static str,
+    attempted: bool,
+    next: usize,
+    owner: Option<crate::names::OwnedUniqueName>,
+    path: Option<zvariant::OwnedObjectPath>,
+    replies: Vec<Message>,
+}
+
+/// Fences the same original queue if its enclosing fixed observation is cancelled.
+///
+/// This guard owns no separate transport or descriptor and creates no authority.
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+pub struct FixedLauncherImageCancellationV1 {
+    custody: std::sync::Arc<super::socket::LauncherImageReceiveCustodyV1>,
+    completed: bool,
+}
+
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+impl std::fmt::Debug for FixedLauncherImageCancellationV1 {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.debug_struct("FixedLauncherImageCancellationV1")
+            .field("completed", &self.completed)
+            .finish_non_exhaustive()
+    }
+}
+
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+impl FixedLauncherImageCancellationV1 {
+    /// Disarms this negative guard after the complete enclosing DATA observation.
+    pub fn complete(&mut self) {
+        self.completed = true;
+    }
+}
+
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+impl Drop for FixedLauncherImageCancellationV1 {
+    fn drop(&mut self) {
+        if !self.completed {
+            self.custody.end();
+        }
+    }
+}
+
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+impl std::fmt::Debug for FixedLauncherImageAttemptV1 {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.debug_struct("FixedLauncherImageAttemptV1")
+            .field("attempted", &self.attempted)
+            .field("completed_steps", &self.next)
+            .finish_non_exhaustive()
+    }
+}
+
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+impl FixedLauncherImageAttemptV1 {
+    /// Creates an inert attempt for the fixed Mount service.
+    pub fn mount() -> Self {
+        Self::empty("aos-sandbox-mountd.service")
+    }
+
+    /// Creates an inert attempt for the fixed Source service.
+    pub fn source() -> Self {
+        Self::empty("aos-source-providerd.service")
+    }
+
+    fn empty(unit: &'static str) -> Self {
+        Self {
+            custody: std::sync::Arc::new(super::socket::LauncherImageReceiveCustodyV1::empty()),
+            connection: None,
+            unit,
+            attempted: false,
+            next: 0,
+            owner: None,
+            path: None,
+            replies: Vec::with_capacity(24),
+        }
+    }
+
+    /// Connects once to the fixed system bus and performs the existing AUTH/Hello.
+    ///
+    /// # Errors
+    /// Refuses a repeated or ended attempt. Native, AUTH or parser failure closes
+    /// the original queue and retains its owning cause; it never reconnects.
+    pub async fn connect(&mut self) -> Result<()> {
+        self.custody.require_open()?;
+        if self.attempted {
+            self.custody.end();
+            return Err(Error::InvalidReply);
+        }
+        self.attempted = true;
+        let custody = self.custody.clone();
+        let mut boundary = super::socket::LauncherReceiveBoundary::new(&custody);
+        let mut builder = match Builder::address("unix:path=/run/dbus/system_bus_socket") {
+            Ok(builder) => builder,
+            Err(cause) => {
+                custody.retain_failure(cause);
+                return Err(Error::InvalidReply);
+            }
+        };
+        builder.launcher_image = Some(custody.clone());
+        let result = builder.build().await;
+        match result {
+            Ok(connection) => self.connection = Some(connection),
+            Err(cause) => {
+                custody.retain_failure(cause);
+                return Err(Error::InvalidReply);
+            }
+        }
+        boundary.complete();
+
+        Ok(())
+    }
+
+    /// Advances the sole fixed 24-request recipe, returning its resident reply.
+    ///
+    /// # Errors
+    /// Refuses an unconnected, ended or malformed flight. No caller chooses a
+    /// destination, path, method, property, descriptor or expected image serial.
+    pub async fn observe_next(&mut self) -> Result<Option<&Message>> {
+        self.custody.require_open()?;
+        if self.next == 24 {
+            return Ok(None);
+        }
+        let custody = self.custody.clone();
+        let mut boundary = super::socket::LauncherReceiveBoundary::new(&custody);
+        let Some(connection) = self.connection.as_ref() else {
+            custody.retain_failure(Error::InvalidReply);
+            return Err(Error::InvalidReply);
+        };
+        const MANAGER_PATH: &str = "/org/freedesktop/systemd1";
+        const MANAGER_INTERFACE: &str = "org.freedesktop.systemd1.Manager";
+        const BUS_PATH: &str = "/org/freedesktop/DBus";
+        const BUS_INTERFACE: &str = "org.freedesktop.DBus";
+
+        let result = match self.next {
+            0 | 22 => connection.call_method(
+                Some(BUS_INTERFACE), BUS_PATH, Some(BUS_INTERFACE),
+                "GetNameOwner", &("org.freedesktop.systemd1",),
+            ).await,
+            1 | 23 => match self.owner.as_ref() {
+                Some(owner) => connection.call_method(
+                    Some(BUS_INTERFACE), BUS_PATH, Some(BUS_INTERFACE),
+                    "GetConnectionUnixProcessID", &(owner.as_str(),),
+                ).await,
+                None => Err(Error::InvalidReply),
+            },
+            2 | 21 => match self.owner.as_ref() {
+                Some(owner) => connection.call_method(
+                    Some(owner.as_str()), MANAGER_PATH, Some(MANAGER_INTERFACE),
+                    "GetUnit", &(self.unit,),
+                ).await,
+                None => Err(Error::InvalidReply),
+            },
+            11 | 20 => match self.owner.as_ref() {
+                Some(owner) => connection.call_method(
+                    Some(owner.as_str()), MANAGER_PATH, Some(MANAGER_INTERFACE),
+                    "GetAosOwnLauncherImageV1", &(),
+                ).await,
+                None => Err(Error::InvalidReply),
+            },
+            step => {
+                let property_index = if step < 11 { step - 3 } else { step - 12 };
+                let property = [
+                    "Id", "ActiveState", "SubState", "MainPID", "InvocationID",
+                    "FragmentPath", "DropInPaths", "Transient",
+                ][property_index];
+                let interface = if property == "MainPID" {
+                    "org.freedesktop.systemd1.Service"
+                } else {
+                    "org.freedesktop.systemd1.Unit"
+                };
+                match (self.owner.as_ref(), self.path.as_ref()) {
+                    (Some(owner), Some(path)) => connection.call_method(
+                        Some(owner.as_str()), path.as_str(), Some("org.freedesktop.DBus.Properties"),
+                        "Get", &(interface, property),
+                    ).await,
+                    _ => Err(Error::InvalidReply),
+                }
+            }
+        };
+        match result {
+            Ok(reply) => self.replies.push(reply),
+            Err(cause) => {
+                custody.retain_failure(cause);
+                return Err(Error::InvalidReply);
+            }
+        }
+
+        // The complete actual reply is parked before these canonical decoders.
+        let Some(reply) = self.replies.last() else {
+            custody.retain_failure(Error::InvalidReply);
+            return Err(Error::InvalidReply);
+        };
+        if self.next == 0 {
+            match reply.body().deserialize::<crate::names::OwnedUniqueName>() {
+                Ok(owner) => self.owner = Some(owner),
+                Err(cause) => {
+                    custody.retain_failure(cause);
+                    return Err(Error::InvalidReply);
+                }
+            }
+        } else if self.next == 2 {
+            match reply.body().deserialize::<zvariant::OwnedObjectPath>() {
+                Ok(path) if path.as_str().len() <= 4096 => self.path = Some(path),
+                Ok(_) => {
+                    custody.retain_failure(Error::ExcessData);
+                    return Err(Error::InvalidReply);
+                }
+                Err(cause) => {
+                    custody.retain_failure(cause);
+                    return Err(Error::InvalidReply);
+                }
+            }
+        }
+        self.next += 1;
+        boundary.complete();
+
+        Ok(self.replies.last())
+    }
+
+    /// Returns an already resident expected reply without observation or retry.
+    pub fn reply(&self, index: usize) -> Option<&Message> {
+        self.replies.get(index)
+    }
+
+    /// Arms cancellation shutdown over this same already resident original.
+    #[must_use]
+    pub fn cancellation_fence(&self) -> FixedLauncherImageCancellationV1 {
+        FixedLauncherImageCancellationV1 { custody: self.custody.clone(), completed: false }
+    }
+
+    /// Reports whether the original queue has permanently ended, without I/O.
+    #[must_use]
+    pub fn has_ended(&self) -> bool {
+        self.custody.require_open().is_err()
+    }
+
+    /// Borrows the actual resident failure without observing or retrying the bus.
+    ///
+    /// # Errors
+    /// Reports a locked or poisoned custody slot rather than recovering its state.
+    pub fn failure(&self) -> std::result::Result<
+        Option<super::socket::LauncherImageFailureLoanV1<'_>>,
+        super::socket::LauncherImageFailureUnavailableV1,
+    > {
+        self.custody.failure()
+    }
+
+    /// Borrows original and invariant-rejection shutdown outcomes, in that order.
+    ///
+    /// This performs no I/O or retry and does not borrow receive/parser slots.
+    /// None is unavailable, not successful shutdown; Ok is not drain proof.
+    pub fn shutdown_outcomes(&self) -> (
+        Option<&std::io::Result<()>>,
+        Option<&std::io::Result<()>>,
+    ) {
+        self.custody.shutdown_outcomes()
+    }
+
+    /// Permanently closes the original queue while retaining all flight state.
+    pub fn end(&self) {
+        self.custody.end();
+    }
+}
+
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+impl Drop for FixedLauncherImageAttemptV1 {
+    fn drop(&mut self) {
+        self.custody.end();
+    }
+}
+
+#[cfg(all(test, target_os = "linux", feature = "tokio"))]
+mod launcher_negative_tests {
+    #[test]
+    fn ended_attempt_refuses_connect_before_address_effects() {
+        struct InertWake;
+        impl std::task::Wake for InertWake {
+            fn wake(self: std::sync::Arc<Self>) {}
+        }
+        let mut attempt = super::FixedLauncherImageAttemptV1::mount();
+        attempt.end();
+        let waker = std::task::Waker::from(std::sync::Arc::new(InertWake));
+        let mut context = std::task::Context::from_waker(&waker);
+
+        let mut connect = Box::pin(attempt.connect());
+        assert!(matches!(
+            std::future::Future::poll(connect.as_mut(), &mut context),
+            std::task::Poll::Ready(Err(_))
+        ));
+        drop(connect);
+
+        assert!(!attempt.attempted);
+        assert!(attempt.has_ended());
+        assert!(attempt.shutdown_outcomes().0.is_none());
+    }
+}
