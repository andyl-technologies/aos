+    }
+
+    pub(crate) fn retain_failure(&self, cause: crate::Error) {
+        self.end();
+        let _ = self.first_failure.set(cause);
+    }
+
+    pub(crate) fn retain_request(&self, message: &crate::Message) -> crate::Result<()> {
+        self.require_open()?;
+        let mut requests = self.requests.try_lock().map_err(|_| crate::Error::InvalidReply)?;
+        if requests.len() == 25 || message.data().len() > LAUNCHER_MESSAGE_BYTES {
+            self.end();
+            return Err(crate::Error::ExcessData);
+        }
+        requests.push(message.clone());
+        if message.header().member().is_some_and(|member| member.as_str() == "GetAosOwnLauncherImageV1") {
+            self.expected_image_serial.store(
+                message.primary_header().serial_num().get(),
+                std::sync::atomic::Ordering::Release,
+            );
+        }
