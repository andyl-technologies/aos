+#[async_trait::async_trait]
+impl super::WriteHalf for LauncherUnixWriteHalf {
+    async fn sendmsg(&mut self, buffer: &[u8], fds: &[BorrowedFd<'_>]) -> std::io::Result<usize> {
+        let mut boundary = LauncherReceiveBoundary::new(&self.custody);
+        if self.custody.require_open().is_err() || !fds.is_empty() {
+            return Err(IncomingControlError::Fenced.into_io());
+        }
+
+        let result = tokio_sendmsg(&self.stream, buffer, fds).await;
+        match result {
+            Ok(written) => {
+                boundary.complete();
+                Ok(written)
+            }
+            Err(cause) => {
+                self.custody.retain_failure(cause.into());
+                Err(IncomingControlError::Fenced.into_io())
+            }
+        }
+    }
+
+    async fn close(&mut self) -> std::io::Result<()> {
+        self.custody.end();
+        // The native causes remain in custody; this refusal cannot clone them
+        // into the consuming trait return or erase a rejected-socket debt.
+        match (self.custody.shutdown_result.get(), self.custody.rejected_shutdown_result.get()) {
+            (Some(Ok(())), None | Some(Ok(()))) => Ok(()),
+            _ => Err(IncomingControlError::Fenced.into_io()),
+        }
+    }
+
+    fn can_pass_unix_fd(&self) -> bool {
+        true
+    }
+
+    async fn peer_credentials(&mut self) -> std::io::Result<crate::fdo::ConnectionCredentials> {
+        get_unix_peer_creds(&self.stream).await
+    }
+}
