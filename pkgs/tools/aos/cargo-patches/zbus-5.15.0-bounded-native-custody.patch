+#[cfg(unix)]
+fn fd_recvmsg_with_control(
+    fd: BorrowedFd<'_>,
+    buffer: &mut [u8],
+    control: IncomingControl,
+) -> std::io::Result<(usize, Vec<OwnedFd>)> {
+    use std::mem::MaybeUninit;
+
+    let mut cmsg_buffer = [MaybeUninit::uninit(); rustix::cmsg_space!(ScmRights(FDS_MAX))];
+    let control_storage = &mut cmsg_buffer[..control.capacity()];
+
+    fd_recvmsg_in_storage(fd, buffer, control, control_storage, None, None)
