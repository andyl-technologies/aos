+    pub(crate) fn returned_io_failure_v2(&self) -> std::io::Error {
+        if self.is_retained_manager_v4()
+            && self.host_first_cause.load(std::sync::atomic::Ordering::Acquire) != 0
+        {
+            std::io::Error::other(HostReturnedFailureV2 {
+                original: std::sync::Arc::clone(&self.materialization),
+            })
+        } else { IncomingControlError::Fenced.into_io() }
+    }
+
+    pub(crate) fn returned_failure_v2(&self) -> crate::Error {
+        if self.is_retained_manager_v4()
+            && self.host_first_cause.load(std::sync::atomic::Ordering::Acquire) != 0
+        {
+            crate::Error::InputOutput(std::sync::Arc::new(self.returned_io_failure_v2()))
+        } else { crate::Error::InvalidReply }
+    }
+
+    pub(crate) fn matches_returned_failure_v2(&self, returned: &crate::Error) -> bool {
+        match returned {
+            crate::Error::InputOutput(cause) => cause.get_ref()
+                .and_then(|cause| cause.downcast_ref::<HostReturnedFailureV2>())
+                .is_some_and(|cause| std::sync::Arc::ptr_eq(&cause.original, &self.materialization)),
+            _ => false,
+        }
+    }
+
+    pub(crate) fn require_open(&self) -> crate::Result<()> {
+        if self.ended.load(std::sync::atomic::Ordering::Acquire) {
+            return Err(self.returned_failure_v2());
+        }
+
+        Ok(())
+    }
+
+    pub(crate) fn retain_failure(&self, cause: crate::Error) {
+        if self.is_retained_manager_v4() {
+            // Park and select the actual primary source BEFORE shutdown can
+            // wake an independent reader into a later fenced/EOF result.
+            let _ = self.first_failure.set(cause);
+            let _ = self.host_first_cause.compare_exchange(0, 1,
+                std::sync::atomic::Ordering::AcqRel, std::sync::atomic::Ordering::Acquire);
+            self.end();
+        } else {
+            self.end();
+            let _ = self.first_failure.set(cause);
+        }
+    }
+
+    pub(crate) fn retain_request(&self, message: &crate::Message) -> crate::Result<()> {
+        self.require_open()?;
+        let mut requests = self.requests.try_lock().map_err(|_| crate::Error::InvalidReply)?;
+        if requests.len() == self.outgoing_limit || message.data().len() > self.maximum_request_bytes {
+            self.end();
+            return Err(crate::Error::ExcessData);
+        }
+        if self.is_network_worker_census_v4() {
+            let header = message.header();
+            let member = header.member().map(|value| value.as_str());
+            let valid = match (member, header.interface().map(|value| value.as_str()),
+                header.path().map(|value| value.as_str())) {
+                (Some("Hello" | "GetNameOwner" | "GetConnectionUnixProcessID"),
+                    Some("org.freedesktop.DBus"), Some("/org/freedesktop/DBus")) => true,
+                (Some("ListUnitsByPatterns"), Some("org.freedesktop.systemd1.Manager"),
+                    Some("/org/freedesktop/systemd1")) => {
+                    message.body().deserialize::<(Vec<String>, Vec<String>)>()
+                        .is_ok_and(|(states, patterns)| states.is_empty()
+                            && patterns.iter().map(String::as_str).eq([
+                                "aos-sandbox-network-worker@*.service",
+                                "aos-sandbox-network-observation-worker@*.service"]))
+                },
+                (Some("Get"), Some("org.freedesktop.DBus.Properties"),
+                    Some("/org/freedesktop/systemd1")) => {
+                    message.body().deserialize::<(String, String)>()
+                        .is_ok_and(|(interface, property)| interface == "org.freedesktop.systemd1.Manager"
+                            && property == "Reloading")
+                },
+                _ => false,
+            };
+            let hello_once = member != Some("Hello")
+                || (self.in_auth.load(std::sync::atomic::Ordering::Acquire) && requests.is_empty());
