+//! Selects the closed Host runtime inventory transport.
+
+use super::*;
+
+/// Describes one complete Host inventory snapshot pair as passive DATA.
+///
+/// The fixed roster is Hello, two unique owner/PID bookends, two Reloading
+/// reads and two complete ListUnitsByPatterns calls.
+/// Three incoming slots cover the two bus signals and terminal spare. Numeric
+/// extents grant no service role, snapshot authority or financing.
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+#[derive(Clone, Copy, Debug)]
+pub struct HostInventoryReceiveScheduleV5 {
+    pub(crate) raw: HostLaunchReceiveScheduleV2,
+    cleanup_incarnation: Option<[u8; 16]>,
+}
+
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+impl HostInventoryReceiveScheduleV5 {
+    /// Checks finite wire and materialization ceilings before allocation.
+    ///
+    /// # Errors
+    /// Refuses the canonical raw minimum/maximum or checked storage overflow.
+    pub fn new(maximum_message_bytes: usize, maximum_materialized_bytes: usize) -> Result<Self> {
+        Ok(Self {
+            raw: HostLaunchReceiveScheduleV2::new(
+                9,
+                12,
+                maximum_message_bytes,
+                16 + 8 * (8 + 4 + 255 + 1) + 4 * (3 * 255 + 128 + 16),
+                maximum_materialized_bytes,
+                0,
+            )?,
+            cleanup_incarnation: None,
+        })
+    }
+
+    /// Prices the finite readonly owned-cleanup comparison on the same engine.
+    ///
+    /// Two rounds each inspect payload and Guardian through GetUnit plus the
+    /// existing ten-property exact identity sandwich:44 additional requests
+    /// and replies. No unit reference, effect, subscription or rights is added.
+    ///
+    /// # Errors
+    /// Refuses invalid raw extents or checked native storage overflow.
+    pub fn for_owned_cleanup_v8(maximum_message_bytes: usize, maximum_materialized_bytes: usize,
+        incarnation: [u8; 16])
+        -> Result<Self> {
+        if incarnation == [0; 16] { return Err(Error::InvalidReply); }
+        // Borrow only the ordinary request geometry. The owned raw constructor
+        // below validates the actual materialization against its full 56-reply
+        // roster; applying the ordinary 12-reply cap here rejects a genuine quote.
+        let ordinary = Self::new(maximum_message_bytes, maximum_message_bytes)?;
+        Ok(Self { raw: HostLaunchReceiveScheduleV2::new(
+            9 + 2 * 2 * (1 + 10), 12 + 2 * 2 * (1 + 10),
+            maximum_message_bytes, ordinary.raw.raw().maximum_request_bytes(),
+            maximum_materialized_bytes, 0,
+        )?, cleanup_incarnation: Some(incarnation) })
+    }
+
+    /// Borrows the existing D-Bus wire parser's exact message extent range.
+    #[must_use]
+    pub const fn message_extent_range_v5() -> (usize, usize) {
+        (
+            crate::message::header::MIN_MESSAGE_SIZE,
+            crate::message::header::MAX_MESSAGE_SIZE,
+        )
+    }
+
+    /// Bounds the actual same raw native collector and constructor storage.
+    #[must_use]
+    pub fn receiving_storage_bytes_v5(self) -> Option<usize> {
+        self.raw
+            .receiving_storage_bytes_v2()?
+            .checked_add(2 * std::mem::size_of::<HostInventoryConnectionOriginalV5>())?
+            .checked_add(super::super::socket::network_cutoff_receiving_bytes_v4()?)?
+            .checked_add(
+                self.raw
+                    .raw()
+                    .maximum_request_bytes()
+                    .checked_div(5)?
+                    .checked_add(1)?
+                    .checked_mul(3 * std::mem::size_of::<String>())?
+                    .checked_add(self.raw.raw().maximum_request_bytes().checked_mul(3)?)?
+                    .checked_add(6 * std::mem::size_of::<Vec<String>>())?,
+            )
+    }
+
+    /// Bounds socket, same-OFD connect alias and raw receive refusal slots.
+    #[must_use]
+    pub fn maximum_native_files_v5(self) -> Option<usize> {
+        self.raw.maximum_native_files_v2()
+    }
+
+    /// Returns actual immutable finite framing extents as comparison DATA.
+    #[must_use]
+    pub const fn raw_data_v5(self) -> ReadonlyPropertyReceiveScheduleV2 {
+        self.raw.raw()
+    }
+}
+
+/// Owns a fixed read-only Host inventory connection on the shared raw engine.
+///
+/// This owner permits no mutation member, outgoing rights, Host effect gate,
+/// supplied bus address or resource-grant construction. The real caller pays
+/// its schedule and retains its independently owed service currentness posts.
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+pub struct HostInventoryConnectionOriginalV5 {
+    inner: HostLaunchConnectionOriginalV2,
+}
+
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+impl HostInventoryConnectionOriginalV5 {
+    /// Allocates the already-admitted finite representation without IO.
+    #[must_use]
+    pub fn new(schedule: HostInventoryReceiveScheduleV5) -> Self {
+        let custody = if let Some(incarnation) = schedule.cleanup_incarnation {
+            super::super::socket::LauncherImageReceiveCustodyV1::host_inventory_owned_cleanup_schedule_v8(schedule.raw, incarnation)
+        } else {
+            super::super::socket::LauncherImageReceiveCustodyV1::host_inventory_schedule_v5(schedule.raw)
+        };
+        Self {
+            inner: HostLaunchConnectionOriginalV2::from_custody_v4(custody),
+        }
+    }
+
+    /// Connects through the same native socket/AUTH/builder once.
+    ///
+    /// # Errors
+    /// Retains native setup, timeout, framing or cancellation failure.
+    pub async fn connect_once_v5(
+        &mut self,
+        deadline: tokio::time::Instant,
+        original_boottime_cutoff: u64,
+        original_wall_expiry: Option<i64>,
+    ) -> Result<()> {
+        self.inner
+            .custody
+            .arm_network_cutoff_v4(original_boottime_cutoff, original_wall_expiry)?;
+        self.inner.connect_once_v2(deadline).await
+    }
+
+    /// Borrows the actual connection; its fixed native grammar remains enforced.
+    #[must_use]
+    pub fn connection_v5(&self) -> Option<&Connection> {
+        self.inner.connection_v2()
+    }
+
+    /// Borrows the exact first native/protocol cause without cloning it.
+    ///
+    /// # Errors
+    /// Reports an unavailable original lock instead of replacing its state.
+    pub fn failure_v5(
+        &self,
+    ) -> std::result::Result<
+        Option<super::super::socket::LauncherImageFailureLoanV1<'_>>,
+        super::super::socket::LauncherImageFailureUnavailableV1,
+    > {
+        self.inner.failure_v2()
+    }
+
+    /// Tests only exact returned-marker identity for this original source.
+    #[must_use]
+    pub fn matches_returned_failure_v5(&self, cause: &crate::Error) -> bool {
+        self.inner.matches_returned_failure_v2(cause)
+    }
+
+    /// Arms the same retained native cancellation fence without a new socket.
+    #[must_use]
+    pub fn cancellation_fence_v5(&self) -> FixedLauncherImageCancellationV1 {
+        self.inner.cancellation_fence_v2()
+    }
+
+    /// Borrows actual reader-join or native-retirement refusal after entry.
+    #[must_use]
+    pub fn native_disposal_failure_v5(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        self.inner
+            .socket_reader_join
+            .as_ref()
+            .and_then(|result| result.as_ref().err())
+            .map(|cause| cause as &(dyn std::error::Error + 'static))
+            .or_else(|| {
+                self.inner
+                    .native_disposal
+                    .as_ref()?
+                    .as_ref()
+                    .err()
+                    .map(|cause| cause as _)
+            })
+    }
+
+    /// Fences the same transport while every original remains resident.
+    pub fn end_v5(&self) {
+        self.inner.end_v2();
+    }
+
+    /// Joins and closes only fully positive native leaves after upper posts.
+    ///
+    /// # Errors
+    /// Keeps actual aliases, incomplete frames, send prefixes or failed joins.
+    pub async fn retire_positive_native_once_v5(&mut self) -> std::result::Result<(), ()> {
+        self.inner
+            .retire_positive_native_once_v2()
+            .await
+            .map(|_| ())
+    }
+}
