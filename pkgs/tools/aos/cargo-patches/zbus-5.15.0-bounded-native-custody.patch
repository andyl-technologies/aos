+#[cfg(all(target_os = "linux", feature = "tokio"))]
+impl LauncherImageFailureLoanV1<'_> {
+    /// Borrows the one-shot shutdown outcome separately from the first cause.
+    ///
+    /// None means no resident socket was shut down; Ok does not prove peer
+    /// retirement, remote acknowledgement or descriptor drain.
+    pub fn shutdown_outcome(&self) -> Option<&std::io::Result<()>> {
+        self.owner.shutdown_result.get()
+    }
+
+    /// Borrows the one-shot outcome for a rejected duplicate socket, if any.
+    ///
+    /// The invariant-rejection original remains resident and cannot be retried.
+    pub fn rejected_shutdown_outcome(&self) -> Option<&std::io::Result<()>> {
+        self.owner.rejected_shutdown_result.get()
+    }
+
+    /// Borrows the original cause, never a copied I/O or decoded error.
+    pub fn cause(&self) -> LauncherImageFailureRefV1<'_> {
+        if self.owner.is_retained_manager_v4()
+            && self.owner.host_first_cause.load(std::sync::atomic::Ordering::Acquire) == 3
+        {
+            if let Some(cause) = self.owner.host_connect.failure_v2() {
+                return LauncherImageFailureRefV1::Native(cause);
+            }
+        }
+        if self.owner.is_retained_manager_v4()
+            && self.owner.host_first_cause.load(std::sync::atomic::Ordering::Acquire) == 1
+        {
+            if let Some(cause) = self.owner.first_failure.get() {
+                return LauncherImageFailureRefV1::Protocol(cause);
+            }
+        }
+        for record in &self.native.records {
+            if let Some(Err(cause)) = record.capture.metadata.as_ref() {
+                return LauncherImageFailureRefV1::Native(cause);
+            }
+        }
+        if let Some(cause) = self.native.first_failure.as_ref() {
+            return LauncherImageFailureRefV1::Native(cause);
+        }
+        if self.owner.is_retained_manager_v4() {
+            if let Some(cause) = self.owner.host_connect.failure_v2() {
+                return LauncherImageFailureRefV1::Native(cause);
+            }
+        }
+        match self.owner.first_failure.get() {
+            Some(cause) => LauncherImageFailureRefV1::Protocol(cause),
+            None => match self.owner.host_stopped_receive.get() {
+                Some(stop) if !stop.empty => match stop.returned_cause.as_ref() {
+                    Some(cause) => LauncherImageFailureRefV1::Protocol(cause),
+                    None => LauncherImageFailureRefV1::Ended,
+                },
+                _ => LauncherImageFailureRefV1::Ended,
+            },
+        }
+    }
+}
