+            // alignment puts the boolean at offset four. Two is invalid.
+            bytes[4..8].copy_from_slice(&if endian == LE {
+                2_u32.to_le_bytes()
+            } else {
+                2_u32.to_be_bytes()
+            });
+            let data = Data::new(bytes.clone(), Context::new_dbus(endian, 24));
+
+            let result = data.deserialize_with_seed(
+                PropertyVariantSeedV1::<bool>(std::marker::PhantomData),
+            );
+
+            assert!(result.is_err());
+            assert_eq!(&data[..], bytes.as_slice());
+        }
+    }
+
+    #[test]
+    fn property_signature_check_uses_the_original_alignment_and_byte_order() {
+        use zvariant::{Signature, serialized::Context, to_bytes, BE, LE};
+
+        for endian in [LE, BE] {
+            // `g` alignment is one even when the enclosing message body starts
+            // at a nonzero global position. Both scalar and nested fixed
+            // signatures go through the existing canonical signature parser.
+            for signature in ["u", "a(sasbttttuii)"] {
+                let expected: Signature = signature.try_into().unwrap();
+                let data = to_bytes(Context::new_dbus(endian, 24), &expected).unwrap();
+                assert!(require_property_value_signature(
+                    &data, &Signature::Variant, &expected,
+                ).is_ok());
+                assert!(require_property_value_signature(
+                    &data, &Signature::Str, &expected,
+                ).is_err());
+            }
+        }
+    }
