+// This is the original ancillary parser, with one closed rejection disposition.
+#[cfg(unix)]
+fn collect_received_fds(
+    ancillary: &mut RecvAncillaryBuffer<'_>,
+    control: IncomingControl,
+) -> std::io::Result<Vec<OwnedFd>> {
+    collect_received_fds_into(ancillary, control, None)
+}
+
+#[cfg(unix)]
+fn collect_received_fds_into(
+    ancillary: &mut RecvAncillaryBuffer<'_>,
+    control: IncomingControl,
+    mut capture: Option<&mut LauncherRawCapture>,
+) -> std::io::Result<Vec<OwnedFd>> {
+    let mut fds = vec![];
+    for msg in ancillary.drain() {
+        #[cfg(all(target_os = "linux", feature = "tokio"))]
+        if matches!(control, IncomingControl::RejectIncoming) {
+            // Dropping this message and the outer ancillary buffer releases all
+            // adopted rights before the error reaches authentication or a queue.
+            drop(msg);
+            return Err(IncomingControlError::Unexpected.into_io());
+        }
+
+        match msg {
+            RecvAncillaryMessage::ScmRights(iter) => {
+                #[cfg(all(target_os = "linux", feature = "tokio"))]
+                if let IncomingControl::Launcher { accepts_image_fd } = control {
+                    let Some(record) = capture.as_deref_mut() else {
+                        drop(iter);
+                        return Err(IncomingControlError::Fenced.into_io());
+                    };
+
+                    for original in iter {
+                        if !accepts_image_fd || record.ordinary.is_some() {
+                            drop(original);
+                            record.disposed += 1;
+                            return Err(IncomingControlError::Unexpected.into_io());
+                        }
+
+                        // metadata uses the actual adopted descriptor and needs
+                        // no procfs, unsafe conversion or extra rustix features.
+                        record.screening = Some(std::fs::File::from(original));
+                        record.metadata = match record.screening.as_ref() {
+                            Some(file) => Some(file.metadata()),
+                            None => return Err(IncomingControlError::Fenced.into_io()),
+                        };
+                        let regular = matches!(record.metadata.as_ref(), Some(Ok(metadata)) if metadata.is_file());
+                        if !regular {
+                            // Anonymous/ring or unidentifiable rights are disposed
+                            // before a retained error owner can become observable.
+                            drop(record.screening.take());
