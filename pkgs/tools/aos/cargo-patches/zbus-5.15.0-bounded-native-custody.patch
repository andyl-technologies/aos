+#[cfg(all(target_os = "linux", feature = "tokio"))]
+pub(crate) const LAUNCHER_MESSAGE_BYTES: usize = 64 * 1024;
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+pub(crate) const LAUNCHER_AUTH_BYTES: usize = 4 * 1024;
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+pub(crate) const LAUNCHER_MESSAGE_COUNT: usize = 33;
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+pub(crate) const LAUNCHER_CAPTURE_BYTES: usize =
+    LAUNCHER_AUTH_BYTES + LAUNCHER_MESSAGE_COUNT * LAUNCHER_MESSAGE_BYTES;
