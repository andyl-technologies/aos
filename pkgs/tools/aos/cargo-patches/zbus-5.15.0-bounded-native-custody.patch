+    where B: serde::ser::Serialize + zvariant::DynamicType,
+    {
+        let maximum_outgoing_fds = match self.disposition {
+            FixedReceiveDispositionV1::HostLaunch { maximum_outgoing_fds } => maximum_outgoing_fds,
+            FixedReceiveDispositionV1::NetworkFdStore | FixedReceiveDispositionV1::MountFdStore | FixedReceiveDispositionV1::HostInventory | FixedReceiveDispositionV1::HostInventoryOwnedCleanup { .. } | FixedReceiveDispositionV1::NetworkWorkerCensus => 0,
+            _ => return Err(self.returned_failure_v2()),
+        };
+        self.require_open()?;
+        let mut original = self.host_message_build.try_lock().map_err(|_| {
+            self.retain_failure(crate::Error::InvalidReply);
+            crate::Error::InvalidReply
+        })?;
+        let mut wire = self.host_outgoing_wire.try_lock().map_err(|_| {
+            self.retain_failure(crate::Error::InvalidReply);
+            crate::Error::InvalidReply
+        })?;
+        match builder.build_host_retaining_v2(body, self.maximum_request_bytes,
+            maximum_outgoing_fds, &mut original, &mut wire) {
+            Ok(message) => Ok(message),
+            Err(cause) => {
+                // The failed bytes/FD table were already parked before native
+                // duplication. Keep the actual serializer/IO cause before the
+                // consuming SDK marker and every independently owed cleanup.
+                self.retain_failure(cause);
+                Err(self.returned_failure_v2())
+            }
+        }
+    }
