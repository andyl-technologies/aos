+#[cfg(all(test, target_os = "linux", feature = "tokio"))]
+mod materialization_tests {
+    use super::*;
+    use std::sync::Arc;
+
+    #[derive(Debug)]
+    struct CapturedInput {
+        bytes: Vec<u8>,
+        next: usize,
+    }
+
+    #[async_trait::async_trait]
+    impl ReadHalf for CapturedInput {
+        async fn recvmsg(&mut self, output: &mut [u8]) -> RecvmsgResult {
+            let count = output.len().min(self.bytes.len() - self.next);
+            output[..count].copy_from_slice(&self.bytes[self.next..self.next + count]);
+            self.next += count;
+            Ok((count, Vec::new()))
+        }
+    }
+
+    fn wire_message() -> Vec<u8> {
+        Message::signal("/test", "org.example.Test", "Observe").unwrap()
+            .build(&vec![17_u8; 32]).unwrap().data().to_vec()
+    }
+
+    async fn capture(
+        bytes: Vec<u8>,
+        budget: Arc<MaterializationByteBudgetV1>,
+    ) -> (crate::Result<Message>, ReceiveFrame) {
+        let mut input = CapturedInput { bytes, next: 0 };
+        let mut frame = ReceiveFrame::selected(budget, MIN_MESSAGE_SIZE);
+        let result = receive_message_in_frame(
+            &mut input, 1, &mut Vec::new(), &mut Vec::new(), &mut frame,
+        ).await;
+        (result, frame)
+    }
+
+    #[tokio::test]
+    async fn exact_extent_materializes_the_same_retained_frame() {
+        let wire = wire_message();
+        let budget = Arc::new(MaterializationByteBudgetV1::new(wire.len()));
+
+        let (result, frame) = capture(wire.clone(), Arc::clone(&budget)).await;
+
+        let message = result.unwrap();
+        assert_eq!(budget.extent(), (wire.len(), wire.len(), None));
+        assert_eq!(message.body().deserialize::<Vec<u8>>().unwrap(), vec![17; 32]);
+        assert_eq!(&frame.data.as_ref().unwrap()[..], wire.as_slice());
+        assert!(frame.bytes.is_empty());
+    }
+
+    #[tokio::test]
+    async fn announced_extent_refuses_before_body_growth_or_another_read() {
+        let wire = wire_message();
+        let maximum = wire.len() - 1;
+        let budget = Arc::new(MaterializationByteBudgetV1::new(maximum));
+
+        let (result, frame) = capture(wire.clone(), Arc::clone(&budget)).await;
+
+        assert!(matches!(result, Err(crate::Error::ExcessData)));
+        assert_eq!(budget.extent(), (MIN_MESSAGE_SIZE, maximum, Some(wire.len() - MIN_MESSAGE_SIZE)));
+        assert_eq!(frame.bytes, wire[..MIN_MESSAGE_SIZE]);
+        assert!(frame.data.is_none());
+    }
+
+    #[tokio::test]
+    async fn over_budget_announcement_precedes_a_truncated_body_eof() {
+        let wire = wire_message();
+        let maximum = wire.len() - 1;
+        let budget = Arc::new(MaterializationByteBudgetV1::new(maximum));
+        let mut input = CapturedInput { bytes: wire[..MIN_MESSAGE_SIZE].to_vec(), next: 0 };
+        let mut frame = ReceiveFrame::selected(Arc::clone(&budget), MIN_MESSAGE_SIZE);
+
+        let result = receive_message_in_frame(
+            &mut input, 1, &mut Vec::new(), &mut Vec::new(), &mut frame,
+        ).await;
+
+        assert!(matches!(result, Err(crate::Error::ExcessData)));
+        assert_eq!(input.next, MIN_MESSAGE_SIZE);
+        assert_eq!(frame.bytes.len(), MIN_MESSAGE_SIZE);
+        assert_eq!(frame.bytes, wire[..MIN_MESSAGE_SIZE]);
+        assert!(frame.data.is_none());
+        assert_eq!(budget.extent(), (
+            MIN_MESSAGE_SIZE, maximum, Some(wire.len() - MIN_MESSAGE_SIZE),
+        ));
+    }
+
+    #[tokio::test]
+    async fn refusal_before_primary_header_keeps_only_the_consumed_prefix() {
+        let wire = wire_message();
+        let budget = Arc::new(MaterializationByteBudgetV1::new(MIN_MESSAGE_SIZE - 1));
+
+        let (result, frame) = capture(wire.clone(), Arc::clone(&budget)).await;
+
+        assert!(matches!(result, Err(crate::Error::ExcessData)));
+        assert_eq!(budget.extent(), (0, MIN_MESSAGE_SIZE - 1, Some(MIN_MESSAGE_SIZE)));
+        assert_eq!(frame.bytes, wire[..MIN_MESSAGE_SIZE]);
+        assert!(frame.data.is_none());
+    }
+
+    #[tokio::test]
+    async fn malformed_signature_keeps_the_charged_original_after_parser_error() {
+        let mut wire = wire_message();
+        let signature = wire.windows(3).position(|bytes| bytes == b"ay\0").unwrap();
+        wire[signature] = b'!';
+        let budget = Arc::new(MaterializationByteBudgetV1::new(wire.len()));
+
+        let (result, frame) = capture(wire.clone(), Arc::clone(&budget)).await;
+
+        assert!(result.is_err());
+        assert_eq!(budget.extent(), (wire.len(), wire.len(), None));
+        assert_eq!(&frame.data.as_ref().unwrap()[..], wire.as_slice());
+    }
+
+    #[tokio::test]
+    async fn later_frame_cannot_reuse_the_same_spent_allowance() {
+        let wire = wire_message();
+        let budget = Arc::new(MaterializationByteBudgetV1::new(wire.len()));
+        let (first, first_frame) = capture(wire.clone(), Arc::clone(&budget)).await;
+        assert!(first.is_ok());
+
+        let (second, second_frame) = capture(wire.clone(), Arc::clone(&budget)).await;
+
+        assert!(matches!(second, Err(crate::Error::ExcessData)));
+        assert_eq!(budget.extent(), (wire.len(), wire.len(), Some(MIN_MESSAGE_SIZE)));
+        assert_eq!(&first_frame.data.as_ref().unwrap()[..], wire.as_slice());
+        assert_eq!(second_frame.bytes, wire[..MIN_MESSAGE_SIZE]);
+    }
+
+    #[test]
+    fn checked_extent_overflow_is_permanent_without_replacing_its_first_refusal() {
+        let budget = MaterializationByteBudgetV1::new(usize::MAX);
+        budget.admit(usize::MAX).unwrap();
+
+        assert!(budget.admit(1).is_err());
+        assert!(budget.admit(0).is_err());
+        assert_eq!(budget.extent(), (usize::MAX, usize::MAX, Some(1)));
+    }
+}
