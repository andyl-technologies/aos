+#[cfg(unix)]
+impl IncomingControl {
+    fn capacity(self) -> usize {
+        match self {
+            Self::Legacy => rustix::cmsg_space!(ScmRights(FDS_MAX)),
+            #[cfg(all(target_os = "linux", feature = "tokio"))]
+            Self::RejectIncoming => 0,
+            #[cfg(all(target_os = "linux", feature = "tokio"))]
+            Self::Launcher { accepts_image_fd } => {
+                if accepts_image_fd { rustix::cmsg_space!(ScmRights(1)) } else { 0 }
