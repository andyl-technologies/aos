+/// Retains an actual selected socket-reader join or ownership refusal.
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+#[derive(Debug)]
+pub enum HostLaunchSocketTaskErrorV2 {
+    /// The supplied actual connection is outside the closed Host disposition.
+    NotSelected,
+    /// Another actual Connection alias remains live.
+    ConnectionAliased { /// Actual strong aliases.
+        strong: usize, /// Actual weak aliases.
+        weak: usize },
+    /// An additional object-server or registered-name task family is live.
+    AdditionalTasks,
+    /// The original connection has no reached reader task.
+    MissingTask,
+    /// The actual owned Tokio task failed and retains its panic/cancel payload.
+    Join(tokio::task::JoinError),
+    /// The same resident task has not completed within its owed delivery bound.
+    Timeout(tokio::time::error::Elapsed),
+}
+
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+impl std::fmt::Display for HostLaunchSocketTaskErrorV2 {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.write_str("Host launch socket reader did not retire")
+    }
+}
+
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+impl std::error::Error for HostLaunchSocketTaskErrorV2 {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        match self { Self::Join(cause) => Some(cause), Self::Timeout(cause) => Some(cause), _ => None }
+    }
+}
