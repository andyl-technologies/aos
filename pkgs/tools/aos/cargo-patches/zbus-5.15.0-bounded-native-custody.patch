+// Passive representation arithmetic shared by the actual constructor and
+// its upper demand supplier. This owns no socket, budget or admission.
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct ControllerRawReceiveStorageV1 {
+    pub(crate) raw_prefix_bytes: usize,
+    pub(crate) retained_frame_bytes: usize,
+    initial_frame_bytes: usize,
+}
+
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+impl ControllerRawReceiveStorageV1 {
+    fn full() -> Self {
+        Self {
+            raw_prefix_bytes: LAUNCHER_CAPTURE_BYTES,
+            retained_frame_bytes: LAUNCHER_MESSAGE_COUNT * LAUNCHER_MESSAGE_BYTES,
+            initial_frame_bytes: LAUNCHER_MESSAGE_BYTES,
+        }
+    }
+
+    pub(crate) fn for_materialization(maximum: usize) -> Self {
+        if maximum > LAUNCHER_MESSAGE_BYTES {
+            return Self::full();
+        }
+        let primary = crate::message::header::MIN_MESSAGE_SIZE;
+        Self {
+            // Every body read follows whole announced-extent admission. AUTH
+            // may prefetch binary bytes, but they already belong to AUTH's
+            // aggregate 4096. One next fixed header can precede a refusal.
+            raw_prefix_bytes: LAUNCHER_AUTH_BYTES + maximum + primary,
+            // All 33 fixed header buffers coexist. Dynamic growth is bounded
+            // by the shared admitted total. Explicit exact body growth and
+            // this doubled provision retain old/new allocation overlap; two
+            // AUTH-buffer widths also cover prefetched carryover ownership.
+            retained_frame_bytes: 2 * maximum
+                + LAUNCHER_MESSAGE_COUNT * primary + 2 * LAUNCHER_AUTH_BYTES,
+            initial_frame_bytes: primary,
+        }
+    }
