+#[cfg(all(target_os = "linux", feature = "tokio"))]
+pub(crate) fn retire_host_launch_native_leaves_v2(
+    owner: &mut std::sync::Arc<LauncherImageReceiveCustodyV1>,
+) -> Result<(), super::super::HostLaunchNativeDisposalErrorV2> {
+    use super::super::HostLaunchNativeDisposalErrorV2 as Refusal;
+    {
+        if owner.host_stopped_receive.get().is_some_and(|original| !original.empty) {
+            return Err(Refusal::Incomplete);
+        }
+        let frames = owner.frames.try_lock().map_err(|_| Refusal::Unavailable)?;
+        let complete = frames.next == frames.messages.len();
+        let empty_stopped = owner.host_stopped_receive.get().is_some_and(|stop| stop.empty)
+            && frames.messages.len().checked_add(1) == Some(frames.next);
+        if !complete && !empty_stopped { return Err(Refusal::Incomplete); }
+        if !owner.host_outgoing_wire.try_lock().map_err(|_| Refusal::Unavailable)?.complete_v2() {
+            return Err(Refusal::Incomplete);
+        }
+        let build = owner.host_message_build.try_lock().map_err(|_| Refusal::Unavailable)?;
+        if build.native_descriptor_count_v2() != 0 { return Err(Refusal::Incomplete); }
+        let sends = owner.host_launch_sends.try_lock().map_err(|_| Refusal::Unavailable)?;
+        if sends.iter().any(|send| send.written != send.expected || send.zero_progress) {
+            return Err(Refusal::Incomplete);
+        }
+        let requests = owner.requests.try_lock().map_err(|_| Refusal::Unavailable)?;
+        for request in requests.iter() {
+            let strong = std::sync::Arc::strong_count(&request.inner);
+            let weak = std::sync::Arc::weak_count(&request.inner);
+            if strong != 1 || weak != 0 { return Err(Refusal::MessageAliased { strong, weak }); }
+            let (strong, weak) = request.data().backing_ownership_extent_v2();
+            if strong != 1 || weak != 0 { return Err(Refusal::DataAliased { strong, weak }); }
+        }
+    }
+    retire_unique_socket_engine_v2(owner, RetiringDispositionV2::HostLaunch)
+        .map_err(Refusal::Socket)?;
+    let native = std::sync::Arc::get_mut(owner).ok_or(Refusal::Unavailable)?;
+    let requests = native.requests.get_mut().map_err(|_| Refusal::Unavailable)?;
+    // The same actual outgoing message FD objects close here, after their
+    // exclusive aliases and the native socket were proven quiescent. The end
+    // latch and spent schedule never reset; raw/error/traffic DATA stays held.
+    requests.clear();
+    Ok(())
+}
