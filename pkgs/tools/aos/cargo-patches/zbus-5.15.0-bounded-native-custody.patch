+    async fn host_close_requested_v2(&self) {
+        loop {
+            let notified = self.host_close_ready.notified();
+            if self.host_close_entered.load(std::sync::atomic::Ordering::Acquire) {
+                return;
+            }
+            notified.await;
+        }
+    }
+
+    fn stop_host_receive_v2(
+        &self,
+        prefix_before: usize,
+        carried_bytes: usize,
+        descriptors: usize,
+        returned_cause: Option<crate::Error>,
+    ) -> bool {
+        let Ok(native) = self.native.try_lock() else {
+            // A failed native checkpoint is itself a retained refusal. It can
+            // never turn into a clean end after the transient borrow ends.
+            self.retain_failure(crate::Error::InvalidReply);
+            return false;
+        };
+        let prefix_after = native.prefixes.len();
+        let local_boundary = match returned_cause.as_ref() {
+            None | Some(crate::Error::InvalidReply) => true,
+            Some(cause @ crate::Error::InputOutput(_)) if self.matches_returned_failure_v2(cause) => true,
+            Some(crate::Error::InputOutput(cause)) => cause.get_ref()
+                .and_then(|cause| cause.downcast_ref::<IncomingControlError>())
+                .is_some_and(|cause| matches!(cause, IncomingControlError::Fenced)),
+            _ => false,
+        };
+        let empty = local_boundary && self.is_retained_manager_v4()
+            && self.host_close_entered.load(std::sync::atomic::Ordering::Acquire)
+            && prefix_before == prefix_after && carried_bytes == 0 && descriptors == 0
+            && native.first_failure.is_none()
+            && native.records.iter().all(|record| !matches!(record.capture.metadata, Some(Err(_))))
+            && self.first_failure.get().is_none()
+            && self.materialization.extent().2.is_none();
+        drop(native);
+        let original = HostStoppedReceiveV2 { prefix_before, prefix_after, carried_bytes,
+            descriptors, returned_cause, empty };
+        if let Err(original) = self.host_stopped_receive.set(original) {
+            if let Some(cause) = original.returned_cause { self.retain_failure(cause); }
+            return false;
+        }
+        if !empty && self.host_stopped_receive.get().is_some_and(|stop| stop.returned_cause.is_none()) {
+            self.retain_failure(crate::Error::InvalidReply);
+        }
+        empty
+    }
+
+    /// Permanently shuts down the original transport without releasing custody.
+    pub fn end(&self) {
+        self.ended.store(true, std::sync::atomic::Ordering::Release);
+        self.reply_ready.notify_waiters();
+        if let Some(socket) = self.socket.get() {
+            self.shutdown_result.get_or_init(|| {
+                rustix::net::shutdown(socket.as_fd(), rustix::net::Shutdown::Both)
+                    .map_err(std::io::Error::from)
+            });
+        } else if self.is_retained_manager_v4() {
+            // Before AUTH adoption, the attempted socket's SAME-OFD alias is
+            // the independently owned shutdown destination, never a reopen.
+            self.host_connect.end_unadopted_v2();
+        }
+    }
+
+    pub(crate) fn failure(&self) -> Result<Option<LauncherImageFailureLoanV1<'_>>, LauncherImageFailureUnavailableV1> {
+        if !self.ended.load(std::sync::atomic::Ordering::Acquire) {
+            return Ok(None);
+        }
+        let native = self.native.try_lock().map_err(|error| match error {
+            std::sync::TryLockError::WouldBlock => LauncherImageFailureUnavailableV1::WouldBlock,
+            std::sync::TryLockError::Poisoned(_) => LauncherImageFailureUnavailableV1::Poisoned,
+        })?;
+
+        Ok(Some(LauncherImageFailureLoanV1 {
+            owner: self,
+            native,
+            not_sync: std::marker::PhantomData,
+        }))
+    }
+
+    pub(crate) fn shutdown_outcomes(&self) -> (
+        Option<&std::io::Result<()>>,
+        Option<&std::io::Result<()>>,
+    ) {
+        (self.shutdown_result.get(), self.rejected_shutdown_result.get())
+    }
