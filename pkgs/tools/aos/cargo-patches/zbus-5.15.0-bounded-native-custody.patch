+            disposition,
+            host_connect: HostConnectOriginalV2::new(),
+            network_cutoff: network_cutoff::NetworkNativeCutoffV4::new(),
+            materialization: std::sync::Arc::clone(&materialization),
+            raw_prefix_limit: std::sync::atomic::AtomicUsize::new(storage.raw_prefix_bytes),
+            incoming_limit,
+            outgoing_limit,
+            maximum_message_bytes,
+            maximum_request_bytes,
+            growth_enabled,
+            socket: std::sync::OnceLock::new(),
+            shutdown_result: std::sync::OnceLock::new(),
+            rejected_socket: std::sync::OnceLock::new(),
+            rejected_shutdown_result: std::sync::OnceLock::new(),
+            ended: std::sync::atomic::AtomicBool::new(false),
+            host_close_entered: std::sync::atomic::AtomicBool::new(false),
+            host_first_cause: std::sync::atomic::AtomicU8::new(0),
+            host_close_ready: tokio::sync::Notify::new(),
+            host_stopped_receive: std::sync::OnceLock::new(),
+            expected_image_serial: std::sync::atomic::AtomicU32::new(0),
+            frame_fds: std::sync::atomic::AtomicUsize::new(0),
+            in_auth: std::sync::atomic::AtomicBool::new(true),
+            native: std::sync::Mutex::new(LauncherNativeCustody {
+                records: [
+                    LauncherRawRecord::empty(0),
+                    LauncherRawRecord::empty(0),
+                    LauncherRawRecord::empty(0),
+                ],
+                current: 0,
+                empty_reads: 0,
+                empty_bytes: 0,
+                empty_flags: rustix::net::ReturnFlags::empty(),
+                prefixes: Vec::with_capacity(storage.raw_prefix_bytes),
+                first_failure: None,
+            }),
+            frames: tokio::sync::Mutex::new(LauncherFrames {
+                frames: (0..incoming_limit)
+                    .map(|_| {
+                        let mut frame = match disposition {
+                        FixedReceiveDispositionV1::ControllerProperties | FixedReceiveDispositionV1::NetworkFdStore | FixedReceiveDispositionV1::MountFdStore | FixedReceiveDispositionV1::HostInventory | FixedReceiveDispositionV1::HostInventoryOwnedCleanup { .. } | FixedReceiveDispositionV1::NetworkWorkerCensus | FixedReceiveDispositionV1::HostLaunch { .. } => {
+                            super::ReceiveFrame::controller_properties(
