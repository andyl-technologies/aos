+                next: 0,
+                messages: Vec::with_capacity(incoming_limit),
+            }),
+            first_failure: std::sync::OnceLock::new(),
+            requests: std::sync::Mutex::new(Vec::with_capacity(outgoing_limit)),
+            host_launch_sends: std::sync::Mutex::new(Vec::with_capacity(if matches!(disposition, FixedReceiveDispositionV1::HostLaunch { .. } | FixedReceiveDispositionV1::NetworkFdStore | FixedReceiveDispositionV1::MountFdStore | FixedReceiveDispositionV1::HostInventory | FixedReceiveDispositionV1::HostInventoryOwnedCleanup { .. } | FixedReceiveDispositionV1::NetworkWorkerCensus) { outgoing_limit } else { 0 })),
+            host_effect_write: std::sync::OnceLock::new(),
+            host_message_build: std::sync::Mutex::new(crate::message::HostMessageBuildOriginalV2::new(
+                match disposition { FixedReceiveDispositionV1::HostLaunch { maximum_outgoing_fds } => maximum_outgoing_fds, _ => 0 })),
+            host_outgoing_wire: std::sync::Mutex::new(crate::message::HostOutgoingWireBudgetV2::new(0, 0)),
+            auth_sent_bytes: std::sync::atomic::AtomicUsize::new(0),
+            auth_sends: tokio::sync::Mutex::new(Vec::with_capacity(4)),
