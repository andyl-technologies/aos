+    pub(crate) fn raise_materialization_limit_v2(&self, maximum: usize) -> crate::Result<()> {
+        use std::sync::atomic::Ordering;
+
+        self.require_open()?;
+        let previous = self.materialization.extent().1;
+        if !self.growth_enabled || maximum < previous
+            || self.incoming_limit.checked_mul(self.maximum_message_bytes)
+                .is_none_or(|limit| maximum > limit)
+        {
+            self.retain_failure(crate::Error::ExcessData);
+            return Err(crate::Error::InvalidReply);
+        }
+        let Some(raw_limit) = LAUNCHER_AUTH_BYTES.checked_add(maximum)
+            .and_then(|bytes| bytes.checked_add(crate::message::header::MIN_MESSAGE_SIZE))
+        else {
+            self.retain_failure(crate::Error::ExcessData);
+            return Err(crate::Error::InvalidReply);
+        };
+        let mut native = self.native.try_lock().map_err(|_| {
+            self.retain_failure(crate::Error::InvalidReply);
+            crate::Error::InvalidReply
+        })?;
+        // The native receiver releases this lock before waiting for readiness.
+        // Reserve the SAME raw-prefix backing before its bound can increase.
+        let Some(additional) = raw_limit.checked_sub(native.prefixes.len()) else {
+            self.retain_failure(crate::Error::ExcessData);
+            return Err(crate::Error::InvalidReply);
+        };
+        if let Err(cause) = native.prefixes.try_reserve_exact(additional) {
+            self.retain_failure(crate::Error::InputOutput(std::io::Error::other(cause).into()));
+            return Err(crate::Error::InvalidReply);
+        }
+        if let Err(cause) = self.materialization.raise_maximum_v2(maximum) {
+            self.retain_failure(cause);
+            return Err(crate::Error::InvalidReply);
+        }
+        self.raw_prefix_limit.store(raw_limit, Ordering::Release);
+        Ok(())
+    }
+
+    pub(crate) fn begin_readonly_interval_v2(&self) -> crate::Result<()> {
+        self.require_open()?;
+        let checkpoint = (|| {
+            if !self.growth_enabled || self.in_auth.load(std::sync::atomic::Ordering::Acquire) {
+                return Err(crate::Error::InvalidReply);
+            }
+            let requests = self.requests.try_lock().map_err(|_| crate::Error::InvalidReply)?;
+            if !self.pending_replies.try_lock().map_err(|_| crate::Error::InvalidReply)?.is_empty() {
+                return Err(crate::Error::InvalidReply);
+            }
+            let frames = self.frames.try_lock().map_err(|_| crate::Error::InvalidReply)?;
+            let native = self.native.try_lock().map_err(|_| crate::Error::InvalidReply)?;
+            let mut interval = self.interval.try_lock().map_err(|_| crate::Error::InvalidReply)?;
+            if interval.is_some() || frames.next != frames.messages.len()
+                || native.current != 0 || native.first_failure.is_some()
+                || self.materialization.extent().2.is_some()
+            { return Err(crate::Error::InvalidReply); }
+            *interval = Some(ReadonlyIntervalV2 {
+                frames: frames.next, requests: requests.len(),
+                admitted: self.materialization.extent().0, prefix: native.prefixes.len(),
+                empty_reads: native.empty_reads, empty_bytes: native.empty_bytes,
+                empty_flags: native.empty_flags,
+            });
+            Ok(())
+        })();
+        if checkpoint.is_err() { self.retain_failure(crate::Error::InvalidReply); }
+        checkpoint
+    }
+
+    pub(crate) fn retire_readonly_interval_v2(&self) -> crate::Result<()> {
+        self.require_open()?;
+        let retired = (|| {
+            let mut requests = self.requests.try_lock().map_err(|_| crate::Error::InvalidReply)?;
+            if !self.pending_replies.try_lock().map_err(|_| crate::Error::InvalidReply)?.is_empty() {
+                return Err(crate::Error::InvalidReply);
+            }
+            let mut frames = self.frames.try_lock().map_err(|_| crate::Error::InvalidReply)?;
+            let mut native = self.native.try_lock().map_err(|_| crate::Error::InvalidReply)?;
+            let mut interval = self.interval.try_lock().map_err(|_| crate::Error::InvalidReply)?;
+            let checkpoint = interval.as_ref().ok_or(crate::Error::InvalidReply)?;
+            if !self.growth_enabled || frames.next != frames.messages.len()
+                || native.current != 0 || native.first_failure.is_some()
+                || self.materialization.extent().2.is_some()
+                || frames.next < checkpoint.frames || requests.len() < checkpoint.requests
+                || native.prefixes.len() < checkpoint.prefix
+            { return Err(crate::Error::InvalidReply); }
+            if requests[checkpoint.requests..].iter().any(|message| std::sync::Arc::strong_count(&message.inner) != 1)
+                || frames.messages[checkpoint.frames..].iter().any(|message| std::sync::Arc::strong_count(&message.inner) != 1)
+            { return Err(crate::Error::InvalidReply); }
+            // Caller has disposed the exact enclosing positive typed/native
+            // interval. No failed byte, error or installed FD reaches here.
+            // The underlying Connection/socket and message serials never reset.
+            let end = frames.next;
+            frames.messages.truncate(checkpoint.frames);
+            for frame in &mut frames.frames[checkpoint.frames..end] {
+                frame.data = None;
+                frame.bytes.clear();
+                frame.fds.clear();
+            }
+            frames.next = checkpoint.frames;
+            requests.truncate(checkpoint.requests);
+            native.prefixes.truncate(checkpoint.prefix);
+            native.empty_reads = checkpoint.empty_reads;
+            native.empty_bytes = checkpoint.empty_bytes;
+            native.empty_flags = checkpoint.empty_flags;
+            self.materialization.retire_positive_interval_v2(checkpoint.admitted)?;
+            *interval = None;
+            Ok(())
+        })();
+        if retired.is_err() { self.retain_failure(crate::Error::InvalidReply); }
+        retired
+    }
