+//! Selects the closed Network metadata-only descriptor-store transport.
+
+use super::*;
+
+/// Describes one fixed Network FD-store snapshot pair as passive DATA.
+///
+/// The fixed roster is Hello plus two full existing service bookend/dump
+/// recipes: owner/PID2, GetUnit1, before properties5, dump/query4, after6.
+/// Three incoming slots cover the two bus signals and terminal spare. Numeric
+/// extents grant no service role, snapshot authority or financing.
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+#[derive(Clone, Copy, Debug)]
+pub struct NetworkFdStoreReceiveScheduleV4 {
+    pub(crate) raw: HostLaunchReceiveScheduleV2,
+}
+
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+impl NetworkFdStoreReceiveScheduleV4 {
+    /// Checks finite wire and materialization ceilings before allocation.
+    ///
+    /// # Errors
+    /// Refuses the canonical raw minimum/maximum or checked storage overflow.
+    pub fn new(maximum_message_bytes: usize, maximum_materialized_bytes: usize) -> Result<Self> {
+        Ok(Self {
+            raw: HostLaunchReceiveScheduleV2::new(
+                37,
+                40,
+                maximum_message_bytes,
+                16 + 8 * (8 + 4 + 255 + 1) + 4 * (3 * 255 + 128 + 16),
+                maximum_materialized_bytes,
+                0,
+            )?,
+        })
+    }
+
+    /// Bounds the actual same raw native collector and constructor storage.
+    #[must_use]
+    pub fn receiving_storage_bytes_v4(self) -> Option<usize> {
+        self.raw
+            .receiving_storage_bytes_v2()?
+            .checked_add(2 * std::mem::size_of::<NetworkFdStoreConnectionOriginalV4>())?
+            .checked_add(super::super::socket::network_cutoff_receiving_bytes_v4()?)
+    }
+
+    /// Bounds socket, same-OFD connect alias and raw receive refusal slots.
+    #[must_use]
+    pub fn maximum_native_files_v4(self) -> Option<usize> {
+        self.raw.maximum_native_files_v2()
+    }
+
+    /// Returns actual immutable finite framing extents as comparison DATA.
+    #[must_use]
+    pub const fn raw_data_v4(self) -> ReadonlyPropertyReceiveScheduleV2 {
+        self.raw.raw()
+    }
+}
+
+/// Owns a fixed read-only Network FD-store connection on the shared raw engine.
+///
