+mod host_effect_write_gate_tests {
+    use super::*;
+    use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+    use std::sync::Arc;
+
+    #[derive(Debug)]
+    struct ClockGate {
+        valid: AtomicBool,
+        calls: AtomicUsize,
+    }
+
+    impl HostLaunchEffectWriteGateV3 for ClockGate {
+        fn check_before_native_write_v3(&self) -> std::io::Result<()> {
+            self.calls.fetch_add(1, Ordering::AcqRel);
+            if self.valid.load(Ordering::Acquire) { Ok(()) }
+            else { Err(std::io::Error::other("original clock horizon expired")) }
+        }
+    }
+
+    fn owner() -> LauncherImageReceiveCustodyV1 {
+        let schedule = super::super::super::HostLaunchReceiveScheduleV2::new(
+            16, 32, 4096, 4096, 64 * 1024, 11).unwrap();
+        LauncherImageReceiveCustodyV1::host_launch_schedule_v2(schedule)
+    }
+
+    fn gate(valid: bool) -> Arc<ClockGate> {
+        Arc::new(ClockGate { valid: AtomicBool::new(valid), calls: AtomicUsize::new(0) })
+    }
+
+    #[tokio::test]
+    async fn expired_original_denies_native_send_and_retains_the_same_first_error() {
+        let original = owner();
+        let gate = gate(false);
+        original.arm_effect_write_gate_v3(gate.clone(), 2).unwrap();
+        let (sender, receiver) = tokio::net::UnixStream::pair().unwrap();
+        sender.writable().await.unwrap();
+
+        let returned = tokio_sendmsg_engine(&sender, b"must not be written", &[], Some(&original)).await;
+
+        assert!(returned.is_err());
+        assert_eq!(gate.calls.load(Ordering::Acquire), 1);
+        let cause = original.first_failure.get().unwrap();
+        assert!(matches!(cause, crate::Error::InputOutput(error)
+            if error.to_string() == "original clock horizon expired"));
+        let pointer = cause as *const crate::Error;
+        assert!(original.before_effect_native_write_v3().is_err());
+        assert_eq!(original.first_failure.get().unwrap() as *const _, pointer);
+        let mut buffer = [0; 32];
+        assert_eq!(rustix::io::read(&receiver, &mut buffer).unwrap_err(), rustix::io::Errno::AGAIN);
+    }
+
+    #[tokio::test]
+    async fn expiry_during_writable_wait_is_rechecked_before_retry_syscall() {
+        let original = owner();
+        let gate = gate(true);
+        original.arm_effect_write_gate_v3(gate.clone(), 2).unwrap();
+        let (sender, receiver) = tokio::net::UnixStream::pair().unwrap();
+        let fill = [5; 4096];
+        loop {
+            match fd_sendmsg(sender.as_fd(), &fill, &[]) {
+                Ok(_) => {},
+                Err(cause) if cause.kind() == std::io::ErrorKind::WouldBlock => break,
+                Err(cause) => panic!("fill failed: {cause}"),
+            }
+        }
+        // Force the first readiness observation, then preserve the pending
+        // future while the original horizon closes and the peer drains.
+        let pending = tokio_sendmsg_engine(&sender, b"late effect", &[], Some(&original));
+        tokio::pin!(pending);
+        tokio::select! {
+            returned = &mut pending => panic!("full socket completed: {returned:?}"),
+            _ = tokio::task::yield_now() => {},
+        }
+        gate.valid.store(false, Ordering::Release);
+        let mut drain = [0; 4096];
+        loop {
+            match rustix::io::read(&receiver, &mut drain) {
+                Ok(0) => panic!("unexpected EOF"),
+                Ok(_) => {},
+                Err(rustix::io::Errno::AGAIN) => break,
+                Err(cause) => panic!("drain failed: {cause}"),
+            }
+        }
+
+        assert!(tokio::time::timeout(std::time::Duration::from_secs(1), &mut pending)
+            .await.unwrap().is_err());
+        assert!(gate.calls.load(Ordering::Acquire) >= 1);
+        assert!(matches!(original.first_failure.get(), Some(crate::Error::InputOutput(error))
+            if error.to_string() == "original clock horizon expired"));
+        assert_eq!(rustix::io::read(&receiver, &mut drain).unwrap_err(), rustix::io::Errno::AGAIN);
+    }
+
+    #[tokio::test]
+    async fn retained_closed_effect_serial_alone_selects_the_native_gate() {
+        use crate::connection::socket::WriteHalf as _;
+        let original = Arc::new(owner());
+        let (stream, _peer) = tokio::net::UnixStream::pair().unwrap();
+        let mut halves = split_launcher_image(stream, original.clone()).unwrap();
+        original.in_auth.store(false, Ordering::Release);
+        for (member, expected) in [("GetUnit", false), ("StartTransientUnit", true), ("StopUnit", true)] {
+            let request = crate::Message::method_call("/org/freedesktop/systemd1", member).unwrap()
+                .destination("org.freedesktop.systemd1").unwrap()
+                .interface("org.freedesktop.systemd1.Manager").unwrap().build(&()).unwrap();
+            original.retain_request(&request).unwrap();
+            let serial = request.primary_header().serial_num().get();
+            let length = request.data().len();
+            halves.write_mut().message_send_started_v2(serial, length).unwrap();
+            assert_eq!(original.host_launch_sends.lock().unwrap().last().unwrap().effect, expected);
+            halves.write_mut().message_send_advanced_v2(serial, length).unwrap();
+        }
+        // A valid retained effect has no authority to invent its clock gate.
+        assert!(original.before_effect_native_write_v3().is_err());
