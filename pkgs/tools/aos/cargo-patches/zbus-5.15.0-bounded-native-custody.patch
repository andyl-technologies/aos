+#[cfg(all(target_os = "linux", feature = "tokio"))]
+async fn connect_fixed_manager(
+    owner: &std::sync::Arc<super::socket::LauncherImageReceiveCustodyV1>,
+    attempted: &mut bool,
+    destination: &mut Option<Connection>,
+) -> Result<()> {
+    owner.require_open()?;
+    if *attempted {
+        owner.end();
+        return Err(Error::InvalidReply);
+    }
+    *attempted = true;
+    let custody = owner.clone();
+    let mut boundary = super::socket::LauncherReceiveBoundary::new(&custody);
+    let mut builder = match Builder::address("unix:path=/run/dbus/system_bus_socket") {
+        Ok(builder) => builder,
+        Err(cause) => {
+            custody.retain_failure(cause);
+            return Err(Error::InvalidReply);
+        }
+    };
+    builder.launcher_image = Some(custody.clone());
+    let result = builder.build().await;
+    match result {
+        Ok(connection) => *destination = Some(connection),
+        Err(cause) => {
+            custody.retain_failure(cause);
+            return Err(Error::InvalidReply);
+        }
+    }
+    boundary.complete();
+
+    Ok(())
+}
