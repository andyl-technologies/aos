+    fn control_truncation_is_typed_terminal_invalid_data() {
+        let error = require_untruncated_control(rustix::net::ReturnFlags::CTRUNC)
+            .unwrap_err();
+
+        assert_eq!(error.kind(), std::io::ErrorKind::InvalidData);
+        assert_eq!(
+            error
+                .get_ref()
+                .unwrap()
+                .downcast_ref::<IncomingControlError>(),
+            Some(&IncomingControlError::Truncated)
+        );
+        assert!(require_untruncated_control(rustix::net::ReturnFlags::empty()).is_ok());
+    }
+
+    #[test]
+    fn terminal_control_error_fences_later_reads_without_replacing_original() {
+        for cause in [
+            IncomingControlError::Truncated,
+            IncomingControlError::Unexpected,
+        ] {
+            let mut failed = false;
+            let mut disposition = TokioReceiveDisposition::reject_incoming(&mut failed);
+            let result = Err(cause.into_io());
+
+            disposition.retain_terminal(&result);
+            let later = disposition.require_open().unwrap_err();
+
+            assert_eq!(later.kind(), std::io::ErrorKind::InvalidData);
+            assert_eq!(
+                later
+                    .get_ref()
+                    .unwrap()
+                    .downcast_ref::<IncomingControlError>(),
+                Some(&IncomingControlError::Fenced)
+            );
+            assert!(
+                result
+                    .as_ref()
+                    .unwrap_err()
+                    .get_ref()
+                    .unwrap()
+                    .is::<IncomingControlError>()
+            );
+
+            disposition.retain_terminal(&Ok((1, vec![])));
+            assert!(disposition.require_open().is_err());
+        }
+    }
