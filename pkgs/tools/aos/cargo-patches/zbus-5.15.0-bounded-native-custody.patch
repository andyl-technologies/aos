+#[cfg(all(target_os = "linux", feature = "tokio"))]
+pub(crate) fn compact_host_launch_storage_v2(
+    owner: &mut std::sync::Arc<LauncherImageReceiveCustodyV1>,
+) -> Result<super::super::HostLaunchCompactedCountsV2, super::super::HostLaunchStorageCompactionErrorV2> {
+    use super::super::HostLaunchStorageCompactionErrorV2 as Refusal;
+    let strong = std::sync::Arc::strong_count(owner);
+    let weak = std::sync::Arc::weak_count(owner);
+    let original = std::sync::Arc::get_mut(owner).ok_or(Refusal::CustodyAliased { strong, weak })?;
+    if !original.is_host_launch_v2() || original.socket.get().is_some()
+        || original.rejected_socket.get().is_some()
+        || !matches!(original.shutdown_result.get(), Some(Ok(())))
+        || !matches!(original.failure(), Ok(Some(cause)) if matches!(cause.cause(), LauncherImageFailureRefV1::Ended))
+    { return Err(Refusal::Incomplete); }
+    let frames = original.frames.get_mut();
+    if frames.frames.iter().any(|frame| !frame.fds.is_empty()) { return Err(Refusal::Incomplete); }
+    for message in &frames.messages {
+        let strong = std::sync::Arc::strong_count(&message.inner);
+        let weak = std::sync::Arc::weak_count(&message.inner);
+        if strong != 1 || weak != 0 { return Err(Refusal::MessageAliased { strong, weak }); }
+    }
+    // Every complete frame and Message owns an independent Data view of its
+    // SAME shared byte allocation. Count precisely those internal views; any
+    // external clone/slice or weak view keeps the whole original resident.
+    for data in frames.messages.iter().map(|message| message.data())
+        .chain(frames.frames.iter().filter_map(|frame| frame.data.as_ref()))
+    {
+        let internal = frames.messages.iter().filter(|message| message.data().shares_backing_v2(data)).count()
+            + frames.frames.iter().filter_map(|frame| frame.data.as_ref())
+                .filter(|frame| frame.shares_backing_v2(data)).count();
+        let (strong, weak) = data.backing_ownership_extent_v2();
+        if strong != internal || weak != 0 {
+            return Err(Refusal::DataAliased { strong, internal, weak });
+        }
+        if !data.fds().is_empty() { return Err(Refusal::Incomplete); }
+    }
+    let native = original.native.get_mut().map_err(|_| Refusal::Unavailable)?;
+    if native.records.iter().any(|record| record.capture.ordinary.is_some()
+        || record.capture.screening.is_some() || !record.capture.output.is_empty())
+    { return Err(Refusal::Incomplete); }
+    let requests = original.requests.get_mut().map_err(|_| Refusal::Unavailable)?;
+    if !requests.is_empty() { return Err(Refusal::Incomplete); }
+    let build = original.host_message_build.get_mut().map_err(|_| Refusal::Unavailable)?;
+    if build.native_descriptor_count_v2() != 0 { return Err(Refusal::Incomplete); }
+    let lines = original.auth_lines.get_mut().map_err(|_| Refusal::Unavailable)?;
+    let sends = original.auth_sends.get_mut();
+    let counts = super::super::HostLaunchCompactedCountsV2 {
+        received_bytes: native.prefixes.len(), incoming_messages: frames.messages.len(),
+        entered_frames: frames.next, auth_lines: lines.len(), auth_sends: sends.len(),
+    };
+    // No fallible/native operation follows the first positive storage drop.
+    // This permanently closes even an unused empty builder destination.
+    build.retire_empty_storage_v2().map_err(Refusal::Builder)?;
+    drop(std::mem::take(&mut frames.frames));
+    drop(std::mem::take(&mut frames.messages));
+    drop(std::mem::take(&mut native.prefixes));
+    for record in &mut native.records { drop(std::mem::take(&mut record.capture.output)); }
+    drop(std::mem::take(lines));
+    drop(std::mem::take(sends));
+    drop(std::mem::take(requests));
+    Ok(counts)
+}
