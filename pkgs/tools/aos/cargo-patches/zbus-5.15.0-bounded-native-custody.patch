+#[async_trait::async_trait]
+impl super::WriteHalf for LauncherUnixWriteHalf {
+    fn message_send_started_v2(&mut self, serial: u32, length: usize) -> crate::Result<()> {
+        if !self.custody.is_retained_manager_v4() { return Ok(()); }
+        let mut sends = self.custody.host_launch_sends.try_lock().map_err(|_| crate::Error::InvalidReply)?;
+        if sends.len() == self.custody.outgoing_limit || sends.last().is_some_and(|last| last.written != last.expected || last.zero_progress) {
+            self.custody.retain_failure(crate::Error::InvalidReply);
+            return Err(self.custody.returned_failure_v2());
+        }
+        // The full original Message is already retained before this shared
+        // cursor starts. Only the closed selected vocabulary's two effects
+        // need a live source-clock gate; owed RemoveMatch/Unref stays separate.
+        let effect = self.custody.requests.try_lock().map_err(|_| crate::Error::InvalidReply)?
+            .iter().find(|request| request.primary_header().serial_num().get() == serial)
+            .is_some_and(|request| request.header().member().is_some_and(|member|
+                matches!(member.as_str(), "StartTransientUnit" | "StopUnit")));
+        sends.push(HostLaunchSendProgressV2 { serial, expected: length, written: 0,
+            zero_progress: false, last_reported: 0, effect });
+        Ok(())
+    }
+
+    fn message_send_advanced_v2(&mut self, serial: u32, written: usize) -> crate::Result<()> {
+        if !self.custody.is_retained_manager_v4() { return Ok(()); }
+        let mut sends = self.custody.host_launch_sends.try_lock().map_err(|_| crate::Error::InvalidReply)?;
+        let last = sends.last_mut().ok_or(crate::Error::InvalidReply)?;
+        last.last_reported = written;
+        if last.serial != serial || written > last.expected.saturating_sub(last.written) {
+            self.custody.retain_failure(crate::Error::InvalidReply);
+            return Err(self.custody.returned_failure_v2());
+        }
+        last.written += written;
+        if written == 0 {
+            last.zero_progress = true;
+            self.custody.retain_failure(crate::Error::InvalidReply);
+            return Err(self.custody.returned_failure_v2());
+        }
+        Ok(())
+    }
+
+    async fn sendmsg(&mut self, buffer: &[u8], fds: &[BorrowedFd<'_>]) -> std::io::Result<usize> {
+        let mut boundary = LauncherReceiveBoundary::new(&self.custody);
+        let outgoing_permitted = match self.custody.disposition {
+            FixedReceiveDispositionV1::HostLaunch { maximum_outgoing_fds } =>
+                !self.custody.in_auth.load(std::sync::atomic::Ordering::Acquire) && fds.len() <= maximum_outgoing_fds,
+            _ => false,
+        };
+        if self.custody.require_open().is_err() || (!fds.is_empty() && !outgoing_permitted) {
+            return Err(self.custody.returned_io_failure_v2());
+        }
+
+        let effect = self.custody.is_host_launch_v2() && self.custody.host_launch_sends.try_lock()
+            .map_err(|_| self.custody.returned_io_failure_v2())?
+            .last().is_some_and(|send| send.effect && send.written < send.expected);
+        let result = if effect || self.custody.is_fixed_fd_store_v2() || self.custody.is_host_inventory_v5() || self.custody.is_network_worker_census_v4() {
+            tokio_sendmsg_engine(&self.stream, buffer, fds, Some(&self.custody)).await
+        } else {
+            tokio_sendmsg(&self.stream, buffer, fds).await
+        };
+        match result {
+            Ok(written) => {
+                if self.custody.is_retained_manager_v4() && self.custody.in_auth.load(std::sync::atomic::Ordering::Acquire) {
+                    self.custody.auth_sent_bytes.fetch_add(written, std::sync::atomic::Ordering::AcqRel);
+                }
+                boundary.complete();
+                Ok(written)
+            }
+            Err(cause) => {
+                self.custody.retain_failure(cause.into());
+                Err(self.custody.returned_io_failure_v2())
+            }
+        }
+    }
