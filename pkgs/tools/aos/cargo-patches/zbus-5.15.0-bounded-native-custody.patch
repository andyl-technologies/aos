+//! Gates each reached selected effect syscall on its original caller clock.
+//!
+//! The hook supplies no unit authority or payment. The actual Host original
+//! must prepay its finite native/clock attempt lane and retain its clock causes.
+//! Readiness, retries and partial writes do not renew that original horizon.
+
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::Arc;
+
+/// Denies a native effect write after the original caller's horizon closes.
+///
+/// Implementations retain the same original clock/source owner. This hook is
+/// mechanical and cannot authorize an effect, create a deadline or pay for IO.
+pub trait HostLaunchEffectWriteGateV3: std::fmt::Debug + Send + Sync + 'static {
+    /// Samples and validates the already-bound original horizon.
+    ///
+    /// Called immediately before each reached native effect syscall, after
+    /// readiness awaits and again on retries. No new deadline may be derived.
+    ///
+    /// # Errors
+    /// Retains the returned denial in the same raw original and prevents that
+    /// syscall; the implementation retains its actual clock-native prefix.
+    fn check_before_native_write_v3(&self) -> std::io::Result<()>;
+}
+
+pub(super) struct HostEffectWriteGateArmV3 {
+    gate: Arc<dyn HostLaunchEffectWriteGateV3>,
+    maximum_attempts: usize,
+    spent: AtomicUsize,
+}
+
+impl HostEffectWriteGateArmV3 {
+    pub(super) fn new(gate: Arc<dyn HostLaunchEffectWriteGateV3>, maximum_attempts: usize) -> Self {
+        Self { gate, maximum_attempts, spent: AtomicUsize::new(0) }
+    }
+
+    pub(super) fn maximum_attempts_v3(&self) -> usize { self.maximum_attempts }
+
+    pub(super) fn check_once_v3(&self, original: &super::LauncherImageReceiveCustodyV1)
+        -> std::io::Result<()> {
+        // Consume before the fresh clock gate and syscall. WouldBlock and
+        // Interrupted retries each need another already-admitted attempt;
+        // neither progress nor cancellation restores a spent slot.
+        if self.spent.fetch_update(Ordering::AcqRel, Ordering::Acquire, |spent|
+            (spent < self.maximum_attempts).then(|| spent + 1)).is_err()
+        {
+            original.retain_failure(std::io::Error::other(
+                "Host native effect write attempt capacity exhausted").into());
+            return Err(original.returned_io_failure_v2());
+        }
+        match self.gate.check_before_native_write_v3() {
+            Ok(()) => Ok(()),
+            Err(cause) => {
+                original.retain_failure(cause.into());
+                Err(original.returned_io_failure_v2())
+            }
+        }
+    }
+}
