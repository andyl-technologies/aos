+        Self {
+            inner: HostLaunchConnectionOriginalV2::from_custody_v4(
+                super::super::socket::LauncherImageReceiveCustodyV1::mount_fd_store_schedule_v2(schedule.raw)),
+        }
+    }
+
+    /// Connects through the same native socket/AUTH/builder once.
+    ///
+    /// # Errors
+    /// Retains native setup, timeout, framing or cancellation failure.
+    pub async fn connect_once_v4(
+        &mut self,
+        deadline: tokio::time::Instant,
+        original_boottime_cutoff: u64,
+        original_wall_expiry: Option<i64>,
+    ) -> Result<()> {
+        self.inner
+            .custody
