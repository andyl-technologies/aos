+#[async_trait::async_trait]
+impl super::ReadHalf for LauncherUnixReadHalf {
+    async fn recvmsg(&mut self, buf: &mut [u8]) -> super::RecvmsgResult {
+        tokio_recvmsg(
+            &self.stream,
+            buf,
+            TokioReceiveDisposition::launcher(&self.custody),
+        )
+        .await
+    }
+
+    async fn receive_message(
+        &mut self,
+        seq: u64,
+        already_received_bytes: &mut Vec<u8>,
+        already_received_fds: &mut Vec<OwnedFd>,
+    ) -> crate::Result<crate::Message> {
+        let custody = self.custody.clone();
+        let mut boundary = LauncherReceiveBoundary::new(&custody);
+        custody.require_open()?;
+        if custody.growth_enabled {
+            // No next frame/recvmsg is entered while no readonly RPC is owed.
+            // This leaves a genuine quiescent boundary for positive disposal
+            // on the SAME manager; the legacy finite observers do not use it.
+            loop {
+                let ready = custody.reply_ready.notified();
+                let pending = !custody.pending_replies.lock()
+                    .map_err(|_| crate::Error::InvalidReply)?.is_empty();
+                if pending { break; }
+                ready.await;
+                custody.require_open()?;
+            }
+        }
+        let mut storage = custody.frames.lock().await;
+        custody.require_open()?;
+        let index = storage.next;
+        if index == custody.incoming_limit {
+            custody.retain_failure(crate::Error::ExcessData);
+            return Err(custody.returned_failure_v2());
+        }
+        storage.next += 1;
+        custody.in_auth.store(false, std::sync::atomic::Ordering::Release);
+        custody.frame_fds.store(already_received_fds.len(), std::sync::atomic::Ordering::Release);
+
+        let result = if custody.is_retained_manager_v4() {
+            let carried_bytes = already_received_bytes.len();
+            let prefix_before = custody.native.try_lock()
+                .map_err(|_| crate::Error::InvalidReply)?.prefixes.len();
+            // Stop only the actual pending frame at explicit local close. The
+            // biased branch avoids polling a shutdown-woken empty syscall;
+            // any previously consumed prefix or native failure still refuses.
+            let received = tokio::select! {
+                biased;
+                _ = custody.host_close_requested_v2() => None,
+                received = super::receive_message_in_frame(self, seq,
+                    already_received_bytes, already_received_fds,
+                    &mut storage.frames[index]) => Some(received),
+            };
+            match received {
+                None => {
+                    custody.stop_host_receive_v2(prefix_before, carried_bytes,
+                        storage.frames[index].fds.len(), None);
+                    boundary.complete();
+                    return Err(custody.returned_failure_v2());
+                }
+                Some(Err(cause)) if custody.host_close_entered.load(std::sync::atomic::Ordering::Acquire) => {
+                    custody.stop_host_receive_v2(prefix_before, carried_bytes,
+                        storage.frames[index].fds.len(), Some(cause));
+                    boundary.complete();
+                    return Err(custody.returned_failure_v2());
+                }
+                Some(result) => result,
+            }
+        } else {
+            super::receive_message_in_frame(self, seq, already_received_bytes,
+                already_received_fds, &mut storage.frames[index]).await
+        };
+        let message = match result {
+            Ok(message) => message,
+            Err(cause) => {
+                custody.retain_failure(cause);
+                return Err(custody.returned_failure_v2());
+            }
+        };
+        storage.messages.push(message);
+        let Some(message) = storage.messages.last() else {
+            custody.retain_failure(crate::Error::InvalidReply);
+            return Err(custody.returned_failure_v2());
+        };
+
+        let expected = custody.expected_image_serial.load(std::sync::atomic::Ordering::Acquire);
+        let matches_image = expected != 0 && message.header().reply_serial().is_some_and(|serial| serial.get() == expected);
+        if message.header().unix_fds().unwrap_or(0) as usize != message.data().fds().len()
+            || (!message.data().fds().is_empty()
+            && (!matches_image || message.data().fds().len() != 1
+                || message.message_type() != crate::message::Type::MethodReturn))
+        {
+            custody.retain_failure(crate::Error::InvalidReply);
+            return Err(custody.returned_failure_v2());
+        }
+        if matches_image {
+            custody.expected_image_serial.store(0, std::sync::atomic::Ordering::Release);
+        }
+        if custody.growth_enabled {
+            match message.message_type() {
+                crate::message::Type::MethodReturn | crate::message::Type::Error => {
+                    let serial = message.header().reply_serial().map(|serial| serial.get())
+                        .ok_or(crate::Error::InvalidReply)?;
+                    let mut pending = custody.pending_replies.lock().map_err(|_| crate::Error::InvalidReply)?;
+                    let Some(index) = pending.iter().position(|expected| *expected == serial) else {
+                        custody.retain_failure(crate::Error::InvalidReply);
+                        return Err(custody.returned_failure_v2());
+                    };
+                    pending.remove(index);
+                }
+                crate::message::Type::Signal => {},
+                _ => {
+                    custody.retain_failure(crate::Error::InvalidReply);
+                    return Err(custody.returned_failure_v2());
+                }
+            }
+        }
+        let reply = message.clone();
+        boundary.complete();
+
+        Ok(reply)
+    }
+
+    fn can_pass_unix_fd(&self) -> bool {
+        !self.custody.is_controller_properties()
+    }
+
+    async fn peer_credentials(&mut self) -> std::io::Result<crate::fdo::ConnectionCredentials> {
+        get_unix_peer_creds(&self.stream).await
+    }
+}
