+// One syscall/control adopter serves Legacy, zero-FD and retained-image reads.
+#[cfg(unix)]
+fn fd_recvmsg_in_storage(
+    fd: BorrowedFd<'_>,
+    buffer: &mut [u8],
+    control: IncomingControl,
+    control_storage: &mut [std::mem::MaybeUninit<u8>],
+    mut capture: Option<&mut LauncherRawCapture>,
+    mut prefixes: Option<&mut Vec<u8>>,
+) -> std::io::Result<(usize, Vec<OwnedFd>)> {
+    let mut iov = [IoSliceMut::new(buffer)];
+    let mut ancillary = RecvAncillaryBuffer::new(control_storage);
+
+    #[cfg(all(target_os = "linux", feature = "tokio"))]
+    let flags = if matches!(control, IncomingControl::Launcher { .. }) {
+        RecvFlags::CMSG_CLOEXEC
+    } else {
+        RecvFlags::empty()
+    };
+    #[cfg(not(all(target_os = "linux", feature = "tokio")))]
+    let flags = RecvFlags::empty();
+    let msg = recvmsg(fd, &mut iov, &mut ancillary, flags)?;
+    if let Some(record) = capture.as_deref_mut() {
+        // This getter must precede drain: drain decreases the actual used count.
+        record.control_used = ancillary.received_control_len();
+        record.reported = msg.bytes;
+        record.flags = msg.flags;
+        if let Some(prefixes) = prefixes.as_deref_mut() {
+            prefixes.extend_from_slice(&buffer[..msg.bytes.min(buffer.len())]);
+            record.prefix_end = prefixes.len();
+        }
+    }
+    // Selected rejection happens before EOF and before any FD escapes this call.
+    #[cfg(all(target_os = "linux", feature = "tokio"))]
+    let selected_fds = if matches!(control, IncomingControl::RejectIncoming) {
+        require_untruncated_control(msg.flags)?;
+        Some(collect_received_fds(&mut ancillary, control)?)
+    } else if matches!(control, IncomingControl::Launcher { .. }) {
+        // Park every screened ordinary right through the same adopter before
+        // refusing truncated control. The buffer still owns undisposed rights.
+        let adopted = collect_received_fds_into(&mut ancillary, control, capture.as_deref_mut());
+        if msg.flags.intersects(rustix::net::ReturnFlags::CTRUNC | rustix::net::ReturnFlags::TRUNC) {
+            return Err(IncomingControlError::Truncated.into_io());
+        }
+        Some(adopted?)
+    } else {
+        None
+    };
+
+    if msg.bytes == 0 {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::BrokenPipe,
+            "failed to read from socket",
+        ));
+    }
+    #[cfg(all(target_os = "linux", feature = "tokio"))]
+    if let Some(fds) = selected_fds {
+        if matches!(control, IncomingControl::Launcher { .. }) {
+            if let Some(record) = capture {
+                if let Some(original) = record.ordinary.take() {
+                    record.output.push(original);
+                }
+
+                let output = if record.output.is_empty() {
+                    Vec::new()
+                } else {
+                    std::mem::take(&mut record.output)
+                };
+                return Ok((msg.bytes, output));
+            }
+            return Err(IncomingControlError::Fenced.into_io());
+        }
+        return Ok((msg.bytes, fds));
+    }
+
+    let fds = collect_received_fds(&mut ancillary, control)?;
+    Ok((msg.bytes, fds))
+}
+
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+fn require_untruncated_control(flags: rustix::net::ReturnFlags) -> std::io::Result<()> {
+    if flags.contains(rustix::net::ReturnFlags::CTRUNC) {
+        return Err(IncomingControlError::Truncated.into_io());
+    }
+
+    Ok(())
+}
