+/// Describes one finite Host launch connection's native representation only.
+///
+/// This DATA grants no role, permission, payment, unit reference or effect.
+/// The actual Host launch original must separately admit the complete schedule.
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+#[derive(Clone, Copy, Debug)]
+pub struct HostLaunchReceiveScheduleV2 {
+    raw: ReadonlyPropertyReceiveScheduleV2,
+    maximum_outgoing_fds: usize,
+    maximum_outgoing_wire_bytes: usize,
+}
+
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+impl HostLaunchReceiveScheduleV2 {
+    /// Checks complete finite native extents before allocating or connecting.
+    ///
+    /// Incoming slots include an explicitly prepaid asynchronous signal/noise
+    /// allowance. One StartTransientUnit may carry the bounded descriptor list;
+    /// every other request and all incoming messages must have no descriptors.
+    ///
+    /// # Errors
+    /// Rejects empty/overflowing wire extents or a descriptor bound above the
+    /// existing Unix send engine's actual ancillary capacity.
+    #[allow(clippy::too_many_arguments)]
+    pub fn new(outgoing: usize, incoming: usize, message_bytes: usize,
+        request_bytes: usize, materialized_bytes: usize, maximum_outgoing_fds: usize) -> Result<Self>
+    {
+        if maximum_outgoing_fds > crate::utils::FDS_MAX { return Err(Error::ExcessData); }
+        let raw = ReadonlyPropertyReceiveScheduleV2::new(outgoing, incoming, message_bytes, request_bytes, materialized_bytes)?;
+        let maximum_outgoing_wire_bytes = outgoing.checked_mul(request_bytes).ok_or(Error::ExcessData)?;
+        let schedule = Self { raw, maximum_outgoing_fds, maximum_outgoing_wire_bytes };
+        if schedule.receiving_storage_bytes_v2().is_none_or(|bytes| bytes > isize::MAX as usize) {
+            return Err(Error::ExcessData);
+        }
+        Ok(schedule)
+    }
+
+    /// Restricts the cumulative outgoing wire plane before any native growth.
+    ///
+    /// # Errors
+    /// Refuses a ceiling outside the checked per-request/count plane. This is
+    /// inert schedule DATA; it opens nothing and grants no resource authority.
+    pub fn with_outgoing_wire_bytes_v2(mut self, maximum: usize) -> Result<Self> {
+        if maximum < self.raw.maximum_request_bytes()
+            || self.raw.outgoing_messages().checked_mul(self.raw.maximum_request_bytes())
+                .is_none_or(|product| maximum > product)
+        { return Err(Error::ExcessData); }
+        self.maximum_outgoing_wire_bytes = maximum;
+        if self.receiving_storage_bytes_v2().is_none_or(|bytes| bytes > isize::MAX as usize) {
+            return Err(Error::ExcessData);
+        }
+        Ok(self)
+    }
+
+    /// Reports the immutable aggregate request-wire ceiling as representation DATA.
+    #[must_use]
+    pub const fn maximum_outgoing_wire_bytes_v2(self) -> usize { self.maximum_outgoing_wire_bytes }
+
+    /// Reports the complete raw/frame/request and descriptor-table storage.
+    #[must_use]
+    pub fn receiving_storage_bytes_v2(self) -> Option<usize> {
+        self.raw.receiving_storage_bytes_v2()?
+            .checked_sub(self.raw.outgoing_messages().checked_mul(self.raw.maximum_request_bytes())?)?
+            .checked_add(self.maximum_outgoing_wire_bytes)?
+            .checked_add(super::socket::host_launch_send_storage_bytes_v2(self.raw.outgoing_messages())?)?
+            // One possible FD-bearing Start build keeps its actual partial
+            // encoder bytes and bounded table before a Message exists. On
+            // success those SAME FD objects move into the retained Message.
+            .checked_add(self.raw.maximum_request_bytes())?
+            .checked_add(self.maximum_outgoing_fds.checked_mul(3 * std::mem::size_of::<zvariant::Fd<'static>>())?)?
+            .checked_add(self.raw.incoming_messages().checked_add(self.raw.outgoing_messages())?
+                .checked_add(8)?.checked_mul(super::socket::host_launch_compacted_error_storage_bytes_v2()?)?)?
+            .checked_add(2 * std::mem::size_of::<HostLaunchConnectionOriginalV2>())
+    }
+
+    /// Bounds the socket/raw refusal, retained connect alias and outgoing FD message.
+    ///
+    /// The one extra same-OFD alias stays resident until genuine positive native
+    /// shutdown/reader/join disposition closes it; failure grants no FD reuse.
+    #[must_use]
+    pub fn maximum_native_files_v2(self) -> Option<usize> {
+        self.raw.maximum_native_files_v2().checked_add(self.maximum_outgoing_fds)?.checked_add(1)
+    }
+
+    /// Returns the checked raw wire extents as passive representation DATA.
+    #[must_use]
+    pub const fn raw_data_v2(self) -> ReadonlyPropertyReceiveScheduleV2 { self.raw }
+
+    pub(crate) const fn raw(self) -> ReadonlyPropertyReceiveScheduleV2 { self.raw }
+    pub(crate) const fn maximum_outgoing_fds(self) -> usize { self.maximum_outgoing_fds }
+}
