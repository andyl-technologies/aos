+/// Holds a nonobserving loan of the same original failure slots.
+///
+/// This move-only loan is neither Send nor Sync and cannot reset the flight.
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+pub struct LauncherImageFailureLoanV1<'owner> {
+    owner: &'owner LauncherImageReceiveCustodyV1,
+    native: std::sync::MutexGuard<'owner, LauncherNativeCustody>,
+    not_sync: std::marker::PhantomData<std::cell::Cell<()>>,
