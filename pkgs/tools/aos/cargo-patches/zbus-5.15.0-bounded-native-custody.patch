+#[cfg(all(target_os = "linux", feature = "tokio"))]
+fn host_inventory_cleanup_name_v8(name: &str, incarnation: [u8; 16], object_path: bool) -> bool {
+    let (prefixes, suffix): ([&str; 2], &str) = if object_path {
+        (["/org/freedesktop/systemd1/unit/aos_2dsandbox_2d",
+            "/org/freedesktop/systemd1/unit/aos_2dlease_2dguard_2d"], "_2eservice")
+    } else {
+        (["aos-sandbox-", "aos-lease-guard-"], ".service")
+    };
+    const HEX: &[u8; 16] = b"0123456789abcdef";
+    prefixes.into_iter().any(|prefix| {
+        let Some(encoded) = name.strip_prefix(prefix).and_then(|tail| tail.strip_suffix(suffix))
+        else { return false; };
+        encoded.len() == 32 && incarnation.iter().enumerate().all(|(index, byte)| {
+            encoded.as_bytes()[2 * index] == HEX[usize::from(byte >> 4)]
+                && encoded.as_bytes()[2 * index + 1] == HEX[usize::from(byte & 15)]
+        })
+    })
