+//! Denies Network metadata IO after its original absolute native cutoff.
+//!
+//! These scalar observations are not a paired-clock grant. The real role owner
+//! retains its actual boot/pair/source and independently checks all authority.
+//! A successful scalar check has no later consumer; only the last completed
+//! observations remain. Every refusal moves into the same raw first-cause slot.
+
+use rustix::time::{ClockId, Timespec, clock_gettime};
+use std::sync::{Arc, Mutex, OnceLock};
+
+const ARM_REFUSAL: &str = "original Network metadata cutoff is absent or already armed";
+const UNARMED: &str = "original Network metadata cutoff is unarmed";
+const UNAVAILABLE: &str = "original Network metadata clock destination is unavailable";
+const INVALID_BOOT: &str = "original Network metadata BOOTTIME is invalid";
+const EXPIRED: &str = "original Network metadata native cutoff elapsed";
+
+#[derive(Clone, Copy)]
+struct Limits {
+    boottime: u64,
+    wall: Option<i64>,
+}
+
+#[derive(Default)]
+struct Samples {
+    last: Option<(Timespec, Timespec)>,
+    failure: Option<Arc<std::io::Error>>,
+}
+
+#[derive(Debug)]
+struct OriginalCutoffFailure(Arc<std::io::Error>);
+
+impl std::fmt::Display for OriginalCutoffFailure {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        std::fmt::Display::fmt(&self.0, formatter)
+    }
+}
+
+impl std::error::Error for OriginalCutoffFailure {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        Some(self.0.as_ref())
+    }
+}
+
+impl Samples {
+    fn refuse(&mut self, cause: std::io::Error) -> std::io::Error {
+        let original = self.failure.get_or_insert_with(|| Arc::new(cause));
+        std::io::Error::other(OriginalCutoffFailure(Arc::clone(original)))
+    }
+}
+
+pub(super) struct NetworkNativeCutoffV4 {
+    limits: OnceLock<Limits>,
+    last: Mutex<Samples>,
+}
+
+impl NetworkNativeCutoffV4 {
+    pub(super) fn new() -> Self {
+        Self {
+            limits: OnceLock::new(),
+            last: Mutex::new(Samples::default()),
+        }
+    }
+
+    pub(super) fn arm_once_v4(&self, boottime: u64, wall: Option<i64>) -> std::io::Result<()> {
+        if boottime == 0 || self.limits.set(Limits { boottime, wall }).is_err() {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                ARM_REFUSAL,
+            ));
+        }
+        self.observe_once_v4()
+    }
+
+    pub(super) fn observe_once_v4(&self) -> std::io::Result<()> {
+        let limits = self
+            .limits
+            .get()
+            .ok_or_else(|| std::io::Error::new(std::io::ErrorKind::InvalidInput, UNARMED))?;
+        let mut destination = self
+            .last
+            .try_lock()
+            .map_err(|_| std::io::Error::other(UNAVAILABLE))?;
+        if let Some(cause) = destination.failure.as_ref() {
+            return Err(std::io::Error::other(OriginalCutoffFailure(Arc::clone(
+                cause,
+            ))));
+        }
+        let boot = clock_gettime(ClockId::Boottime);
+        let wall = clock_gettime(ClockId::Realtime);
+        // The latch and actual first error are stored under this same lock;
+        // concurrent reader/writer refusals cannot replace the failed sample.
+        destination.last = Some((boot, wall));
+        let boot = u64::try_from(boot.tv_sec)
+            .ok()
+            .and_then(|seconds| seconds.checked_mul(1_000_000_000))
+            .and_then(|seconds| {
+                u64::try_from(boot.tv_nsec)
+                    .ok()
+                    .filter(|fraction| *fraction < 1_000_000_000)
+                    .and_then(|fraction| seconds.checked_add(fraction))
+            });
+        let Some(boot) = boot else {
+            return Err(destination.refuse(std::io::Error::new(
+                std::io::ErrorKind::InvalidData,
+                INVALID_BOOT,
+            )));
+        };
+        if boot >= limits.boottime || limits.wall.is_some_and(|expiry| wall.tv_sec >= expiry) {
+            return Err(
+                destination.refuse(std::io::Error::new(std::io::ErrorKind::TimedOut, EXPIRED))
+            );
+        }
+        Ok(())
+    }
+}
