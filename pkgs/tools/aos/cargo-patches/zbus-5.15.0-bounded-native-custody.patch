+fn assert_original_native_cutoff_refusal_v27(
+    original: &LauncherImageReceiveCustodyV1,
+    returned: std::io::Error,
+) {
+    assert!(original.matches_returned_failure_v2(&crate::Error::InputOutput(returned.into())));
+    let held = original.failure().unwrap().unwrap();
+    let LauncherImageFailureRefV1::Protocol(cause) = held.cause() else {
+        panic!("the actual native cutoff refusal was not retained");
+    };
+    let mut source: Option<&(dyn std::error::Error + 'static)> = Some(cause);
+    let mut timed_out = false;
+    while let Some(cause) = source {
+        timed_out |= cause.downcast_ref::<std::io::Error>()
+            .is_some_and(|cause| cause.kind() == std::io::ErrorKind::TimedOut);
+        source = cause.source();
+    }
+    assert!(timed_out, "the retained original chain has no cutoff TimedOut source");
+}
