+#[cfg(all(test, target_os = "linux", feature = "tokio"))]
+mod controller_socket_weak_and_driver_tests {
+    use super::*;
+    use std::sync::Arc;
+
+    fn descriptor_records() -> Vec<(i32, String)> {
+        std::fs::read_dir("/proc/self/fdinfo").unwrap()
+            .filter_map(|entry| {
+                let entry = entry.ok()?;
+                let descriptor = entry.file_name().to_str()?.parse::<i32>().ok()?;
+                let info = std::fs::read_to_string(entry.path()).ok()?;
+                Some((descriptor, info))
+            }).collect()
+    }
+
+    fn registered_descriptors(info: &str) -> Vec<i32> {
+        info.lines().filter_map(|line| {
+            line.strip_prefix("tfd:")?.split_whitespace().next()?.parse().ok()
+        }).collect()
+    }
+
+    fn event_id(info: &str) -> Option<&str> {
+        info.lines().find_map(|line| line.strip_prefix("eventfd-id:").map(str::trim))
+    }
+
+    #[tokio::test]
+    async fn weak_custody_and_weak_socket_aliases_also_refuse_native_disposal() {
+        let (stream, _peer) = tokio::net::UnixStream::pair().unwrap();
+        let mut owner = Arc::new(LauncherImageReceiveCustodyV1::controller_properties(64 * 1024));
+        let split = split_launcher_image(stream, Arc::clone(&owner)).unwrap();
+        owner.end();
+        drop(split);
+        let weak_custody = Arc::downgrade(&owner);
+
+        assert!(matches!(retire_unique_controller_socket_v1(&mut owner),
+            Err(ControllerSocketRetirementErrorV1::CustodyAliased { strong: 1, weak: 1 })));
+        assert!(owner.socket.get().is_some());
+        drop(weak_custody);
+
+        let weak_socket = Arc::downgrade(owner.socket.get().unwrap());
+        assert!(matches!(retire_unique_controller_socket_v1(&mut owner),
+            Err(ControllerSocketRetirementErrorV1::SocketAliased { strong: 1, weak: 1 })));
+        assert!(owner.socket.get().is_some());
+        drop(weak_socket);
+    }
+
+    #[test]
+    fn stream_retains_actual_driver_waker_until_native_socket_disposal() {
+        let runtime = tokio::runtime::Builder::new_current_thread().enable_all().build().unwrap();
+        let (mut owner, _peer, socket_descriptor) = runtime.block_on(async {
+            let (stream, peer) = tokio::net::UnixStream::pair().unwrap();
+            let socket_descriptor = stream.as_raw_fd();
+            let owner = Arc::new(LauncherImageReceiveCustodyV1::controller_properties(64 * 1024));
+            let split = split_launcher_image(stream, Arc::clone(&owner)).unwrap();
+            owner.end();
+            drop(split);
+            (owner, peer.into_std().unwrap(), socket_descriptor)
+        });
+        // The real epoll registration identifies this Runtime before Drop;
+        // process-global FD counts cannot distinguish concurrent test owners.
+        let records = descriptor_records();
+        let selectors: Vec<_> = records.iter().filter(|(_, info)|
+            registered_descriptors(info).contains(&socket_descriptor)).collect();
+        assert!(!selectors.is_empty());
+        let waker_descriptor = selectors.iter().flat_map(|(_, info)| registered_descriptors(info))
+            .find(|descriptor| records.iter().any(|(candidate, info)|
+                candidate == descriptor && event_id(info).is_some())).unwrap();
+        let pidfd = match rustix::process::pidfd_open(rustix::process::getpid(), rustix::process::PidfdFlags::empty()) {
+            Ok(pidfd) => pidfd,
+            Err(error) => {
+                eprintln!("RFC21_NATIVE_DRIVER_REGRESSION_UNAVAILABLE pidfd_open: {error}");
+                return;
+            }
+        };
+        // A safe kernel duplicate pins eventfd-id against reuse, without
+        // manufacturing a BorrowedFd from a raw integer or unsafe code.
+        let pinned_waker = match rustix::process::pidfd_getfd(
+            &pidfd, waker_descriptor, rustix::process::PidfdGetfdFlags::empty(),
+        ) {
+            Ok(waker) => waker,
+            Err(error) => {
+                eprintln!("RFC21_NATIVE_DRIVER_REGRESSION_UNAVAILABLE pidfd_getfd: {error}");
+                return;
+            }
+        };
+        let pinned_descriptor = pinned_waker.as_raw_fd();
+        let pinned_info = std::fs::read_to_string(format!("/proc/self/fdinfo/{pinned_descriptor}")).unwrap();
+        let identity = event_id(&pinned_info).unwrap();
+        drop(runtime);
+
+        let after_runtime = descriptor_records();
+        assert!(after_runtime.iter().filter(|(_, info)| event_id(info) == Some(identity)).count() > 1);
+        assert!(after_runtime.iter().any(|(_, info)| registered_descriptors(info).contains(&socket_descriptor)));
+        retire_unique_controller_socket_v1(&mut owner).unwrap();
+
+        let aliases: Vec<_> = descriptor_records().into_iter()
+            .filter(|(_, info)| event_id(info) == Some(identity))
+            .map(|(descriptor, _)| descriptor).collect();
+        assert_eq!(aliases, vec![pinned_descriptor]);
+        assert!(owner.socket.get().is_none());
+        assert!(matches!(owner.shutdown_result.get(), Some(Ok(()))));
+    }
+}
