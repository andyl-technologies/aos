+/// Describes one finite readonly manager receive schedule as inert DATA.
+///
+/// This value opens nothing and authenticates no role, service, payer or grant.
+/// The real caller prepays constructor bytes and every later monotone growth.
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+#[derive(Clone, Copy, Debug)]
+pub struct ReadonlyPropertyReceiveScheduleV2 {
+    outgoing: usize,
+    incoming: usize,
+    message_bytes: usize,
+    request_bytes: usize,
+    materialized_bytes: usize,
+}
+
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+impl ReadonlyPropertyReceiveScheduleV2 {
+    /// Checks finite representation arithmetic without constructing a receiver.
+    ///
+    /// # Errors
+    /// Refuses empty/overflowing schedules, missing bus-signal space or a message
+    /// extent outside the existing native D-Bus wire maximum.
+    pub fn new(outgoing: usize, incoming: usize, message_bytes: usize,
+        request_bytes: usize, materialized_bytes: usize) -> Result<Self>
+    {
+        let primary = crate::message::header::MIN_MESSAGE_SIZE;
+        if outgoing == 0 || outgoing.checked_add(2).is_none_or(|minimum| incoming < minimum)
+            || message_bytes < primary || message_bytes > crate::message::header::MAX_MESSAGE_SIZE
+            || request_bytes < primary || request_bytes > crate::message::header::MAX_MESSAGE_SIZE
+            || materialized_bytes < primary
+            || incoming.checked_mul(message_bytes).is_none_or(|maximum| materialized_bytes > maximum)
+            || materialized_bytes.checked_add(super::socket::LAUNCHER_AUTH_BYTES)
+                .and_then(|bytes| bytes.checked_add(primary)).is_none()
+            || materialized_bytes.checked_mul(2)
+                .and_then(|bytes| bytes.checked_add(incoming.checked_mul(primary)?))
+                .and_then(|bytes| bytes.checked_add(2 * super::socket::LAUNCHER_AUTH_BYTES)).is_none()
+        {
+            return Err(Error::ExcessData);
+        }
+        let schedule = Self { outgoing, incoming, message_bytes, request_bytes, materialized_bytes };
+        if schedule.receiving_storage_bytes_v2().is_none_or(|bytes| bytes > isize::MAX as usize) {
+            return Err(Error::ExcessData);
+        }
+        Ok(schedule)
+    }
+
+    /// Reports the exact fixed outgoing slot count, including Hello.
+    pub const fn outgoing_messages(self) -> usize { self.outgoing }
+
+    /// Reports the exact incoming slots, including the bounded initial signals.
+    pub const fn incoming_messages(self) -> usize { self.incoming }
+
+    /// Reports this DATA schedule's per-message wire extent.
+    pub const fn maximum_message_bytes(self) -> usize { self.message_bytes }
+
+    /// Reports the fixed readonly request producer's separate wire extent.
+    ///
+    /// Large property responses do not multiply the small fixed requests' bound.
+    pub const fn maximum_request_bytes(self) -> usize { self.request_bytes }
+
+    /// Reports this DATA schedule's initial cumulative materialization extent.
+    pub const fn maximum_materialized_bytes(self) -> usize { self.materialized_bytes }
+
+    /// Bounds the actual raw constructor's owned backing and concrete carriers.
+    ///
+    /// This includes frame/request tables and bodies, prefix growth overlap,
+    /// AUTH copies, FD scratch and
+    /// the shared custody/Arc control. It excludes the Connection/Runtime and
+    /// typed property/error decoder; those require separate caller payment.
+    /// No scalar or carrier count becomes MetadataEntries or a role grant.
+    #[must_use]
+    pub fn receiving_storage_bytes_v2(self) -> Option<usize> {
+        use std::mem::size_of;
+
+        let (raw, frames) = self.raw_receive_bytes_v2();
+        raw.checked_mul(2)?.checked_add(frames)?
+            .checked_add(self.incoming.checked_mul(size_of::<super::socket::ReceiveFrame>())?)?
+            .checked_add(self.incoming.checked_mul(size_of::<std::os::fd::OwnedFd>())?)?
+            .checked_add(self.incoming.checked_add(self.outgoing)?.checked_mul(
+                size_of::<crate::message::Inner>().checked_add(2 * size_of::<usize>())?,
+            )?)?
+            .checked_add(self.outgoing.checked_mul(self.request_bytes)?)?
+            .checked_add(self.outgoing.checked_mul(size_of::<u32>())?)?
+            .checked_add(self.incoming.checked_mul(size_of::<crate::Message>())?)?
+            .checked_add(self.outgoing.checked_mul(size_of::<crate::Message>())?)?
+            .checked_add(size_of::<super::socket::LauncherImageReceiveCustodyV1>())?
+            .checked_add(2 * size_of::<usize>())?
+            .checked_add(3 * size_of::<std::os::fd::OwnedFd>())?
+            .checked_add(8 * size_of::<Vec<u8>>())?
+            .checked_add(8 * super::socket::LAUNCHER_AUTH_BYTES)
+    }
+
+    /// Bounds one connection and the existing native ancillary scratch.
+    ///
+    /// The readonly engine forbids incoming rights before typed decoding; the
+    /// transient installed descriptors still belong in the enclosing limit.
+    /// This is DATA, not an open-file reservation or socket grant.
+    #[must_use]
+    pub const fn maximum_native_files_v2(self) -> usize { 4 }
+
+    /// Reports the SAME compact raw-prefix and retained-frame byte arithmetic.
+    pub fn raw_receive_bytes_v2(self) -> (usize, usize) {
+        let primary = crate::message::header::MIN_MESSAGE_SIZE;
+        (super::socket::LAUNCHER_AUTH_BYTES + self.materialized_bytes + primary,
+            2 * self.materialized_bytes + self.incoming * primary
+                + 2 * super::socket::LAUNCHER_AUTH_BYTES)
+    }
+}
