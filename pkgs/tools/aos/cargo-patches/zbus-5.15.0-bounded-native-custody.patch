+//! Retains the selected fixed system-bus native connection before AUTH.
+//!
+//! The existing Tokio UnixSocket engine performs the native connect. This
+//! private destination parks the real socket before duplication and keeps one
+//! same-OFD alias before its consuming async future can fail or be cancelled.
+//! It supplies no path factory, authority, role, clock, worker or payment.
+
+use super::*;
+use std::sync::{Mutex, OnceLock, atomic::{AtomicBool, Ordering}};
+
+pub(super) struct HostConnectOriginalV2 {
+    entered: AtomicBool,
+    deadline: OnceLock<tokio::time::Instant>,
+    socket: Mutex<Option<tokio::net::UnixSocket>>,
+    alias: OnceLock<OwnedFd>,
+    created: OnceLock<std::io::Result<()>>,
+    duplicated: OnceLock<std::io::Result<()>>,
+    connected: OnceLock<std::io::Result<()>>,
+    unadopted_shutdown: OnceLock<std::io::Result<()>>,
+    retired: AtomicBool,
+}
+
+impl HostConnectOriginalV2 {
+    pub(super) fn new() -> Self {
+        Self { entered: AtomicBool::new(false), deadline: OnceLock::new(), socket: Mutex::new(None),
+            alias: OnceLock::new(), created: OnceLock::new(), duplicated: OnceLock::new(),
+            connected: OnceLock::new(), unadopted_shutdown: OnceLock::new(),
+            retired: AtomicBool::new(false) }
+    }
+
+    pub(super) fn set_deadline_once_v2(&self, custody: &LauncherImageReceiveCustodyV1,
+        deadline: tokio::time::Instant,
+    ) -> crate::Result<()> {
+        if self.deadline.set(deadline).is_err() {
+            custody.retain_failure(crate::Error::InvalidReply);
+            return Err(custody.returned_failure_v2());
+        }
+        self.require_horizon_v2(custody)
+    }
+
+    fn require_horizon_v2(&self, custody: &LauncherImageReceiveCustodyV1) -> crate::Result<()> {
+        custody.require_network_native_cutoff_v4()
+            .map_err(|_| custody.returned_failure_v2())?;
+        if self.deadline.get().is_none_or(|deadline| tokio::time::Instant::now() >= *deadline) {
+            // This is a deny-only mechanical deadline, derived by the real
+            // caller from its original retained paired-clock cutoff. It never
+            // creates a new positive source window or a replacement lease.
+            custody.retain_failure(crate::Error::InputOutput(std::sync::Arc::new(
+                std::io::Error::new(std::io::ErrorKind::TimedOut,
+                    "original Host connection deadline is absent or elapsed"))));
+            return Err(custody.returned_failure_v2());
+        }
+        Ok(())
+    }
+
+    fn fail_v2(&self, custody: &LauncherImageReceiveCustodyV1) -> crate::Error {
+        // A real new/dup/connect error is resident before shutdown and before
+        // the caller can observe this consuming diagnostic projection.
+        let _ = custody.host_first_cause.compare_exchange(0, 3,
+            Ordering::AcqRel, Ordering::Acquire);
+        custody.end();
+        custody.returned_failure_v2()
+    }
+
+    pub(super) async fn connect_once_v2(&self,
+        custody: &LauncherImageReceiveCustodyV1, path: &std::path::Path,
+    ) -> crate::Result<tokio::net::UnixStream> {
+        custody.require_open()?;
+        if self.entered.swap(true, Ordering::AcqRel) {
+            custody.retain_failure(crate::Error::InvalidReply);
+            return Err(custody.returned_failure_v2());
+        }
+        self.require_horizon_v2(custody)?;
+        let created = {
+            let mut destination = self.socket.try_lock().map_err(|_| {
+                custody.retain_failure(crate::Error::InvalidReply);
+                custody.returned_failure_v2()
+            })?;
+            match tokio::net::UnixSocket::new_stream() {
+                Ok(socket) => { *destination = Some(socket); Ok(()) }
+                Err(cause) => Err(cause),
+            }
+        };
+        let failed = created.is_err();
+        if self.created.set(created).is_err() { std::process::abort(); }
+        if failed { return Err(self.fail_v2(custody)); }
+
+        self.require_horizon_v2(custody)?;
+        let duplicated = {
+            let original = self.socket.try_lock().map_err(|_| {
+                custody.retain_failure(crate::Error::InvalidReply);
+                custody.returned_failure_v2()
+            })?;
+            let Some(socket) = original.as_ref() else {
+                custody.retain_failure(crate::Error::InvalidReply);
+                return Err(custody.returned_failure_v2());
+            };
+            rustix::io::fcntl_dupfd_cloexec(socket, 0).map_err(std::io::Error::from)
+        };
+        let duplicated = match duplicated {
+            Ok(alias) => {
+                if self.alias.set(alias).is_err() { std::process::abort(); }
+                Ok(())
+            }
+            Err(cause) => Err(cause),
+        };
+        let failed = duplicated.is_err();
+        if self.duplicated.set(duplicated).is_err() { std::process::abort(); }
+        if failed { return Err(self.fail_v2(custody)); }
+
+        self.require_horizon_v2(custody)?;
+        let socket = self.socket.try_lock().map_err(|_| {
+            custody.retain_failure(crate::Error::InvalidReply);
+            custody.returned_failure_v2()
+        })?.take().ok_or_else(|| {
+            custody.retain_failure(crate::Error::InvalidReply);
+            custody.returned_failure_v2()
+        })?;
+        // Only the original Tokio consuming connect future receives the first
+        // descriptor. The actual same-OFD alias is already resident, so native
+        // connect/registration error or future cancellation loses no socket.
+        match socket.connect(path).await {
+            Ok(stream) => {
+                if self.connected.set(Ok(())).is_err() { std::process::abort(); }
+                Ok(stream)
+            }
+            Err(cause) => {
+                if self.connected.set(Err(cause)).is_err() { std::process::abort(); }
+                Err(self.fail_v2(custody))
+            }
+        }
+    }
+
+    pub(super) fn failure_v2(&self) -> Option<&std::io::Error> {
+        self.created.get().and_then(|result| result.as_ref().err())
+            .or_else(|| self.duplicated.get().and_then(|result| result.as_ref().err()))
+            .or_else(|| self.connected.get().and_then(|result| result.as_ref().err()))
+            .or_else(|| self.unadopted_shutdown.get().and_then(|result| result.as_ref().err()))
+    }
+
+    pub(super) fn end_unadopted_v2(&self) {
+        if let Some(alias) = self.alias.get() {
+            self.unadopted_shutdown.get_or_init(|| rustix::net::shutdown(
+                alias.as_fd(), rustix::net::Shutdown::Both).map_err(std::io::Error::from));
+        } else if let Ok(original) = self.socket.try_lock() {
+            if let Some(socket) = original.as_ref() {
+                self.unadopted_shutdown.get_or_init(|| rustix::net::shutdown(
+                    socket.as_fd(), rustix::net::Shutdown::Both).map_err(std::io::Error::from));
+            }
+        }
+    }
+
+    pub(super) fn positive_ready_v2(&self) -> bool {
+        if !self.entered.load(Ordering::Acquire) { return true; }
+        matches!(self.created.get(), Some(Ok(())))
+            && matches!(self.duplicated.get(), Some(Ok(())))
+            && matches!(self.connected.get(), Some(Ok(())))
+            && self.unadopted_shutdown.get().is_none()
+            && self.alias.get().is_some() && !self.retired.load(Ordering::Acquire)
+            && self.socket.try_lock().is_ok_and(|original| original.is_none())
+    }
+
+    pub(super) fn retire_positive_alias_v2(&mut self) {
+        // The sole caller already proved same-origin connect completion,
+        // actual reader/SDK joins, unique socket and its successful shutdown.
+        // No fallible/native operation follows this physical alias disposal.
+        drop(self.alias.take());
+        self.retired.store(true, Ordering::Release);
+    }
+}
+
