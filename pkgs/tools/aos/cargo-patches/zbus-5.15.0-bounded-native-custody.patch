+    inner: HostLaunchConnectionOriginalV2,
+}
+
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+impl NetworkFdStoreConnectionOriginalV4 {
+    /// Allocates the already-admitted finite representation without IO.
+    #[must_use]
