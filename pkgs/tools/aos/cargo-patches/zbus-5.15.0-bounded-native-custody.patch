+mod selected_frame_extent_tests {
+    use super::*;
+    use std::sync::Arc;
+    use tokio::io::AsyncWriteExt;
+
+    #[tokio::test]
+    async fn real_selected_socket_retains_only_header_before_budget_refusal() {
+        let wire = crate::Message::signal("/test", "org.example.Test", "Observe").unwrap()
+            .build(&vec![17_u8; 32]).unwrap().data().to_vec();
+        let header_bytes = crate::message::header::MIN_MESSAGE_SIZE;
+        let maximum = wire.len() - 1;
+        let custody = Arc::new(LauncherImageReceiveCustodyV1::controller_properties(maximum));
+        let (receiver, mut sender) = tokio::net::UnixStream::pair().unwrap();
+        let mut split = split_launcher_image(receiver, Arc::clone(&custody)).unwrap();
+        sender.write_all(&wire[..header_bytes]).await.unwrap();
+        sender.shutdown().await.unwrap();
+
+        let result = split.read_mut().receive_message(
+            1, &mut Vec::new(), &mut Vec::new(),
+        ).await;
+
+        assert!(matches!(result, Err(crate::Error::InvalidReply)));
+        assert_eq!(custody.materialization_extent(), (
+            header_bytes, maximum, Some(wire.len() - header_bytes),
+        ));
+        assert!(custody.ended.load(std::sync::atomic::Ordering::Acquire));
+        {
+            let native = custody.native.lock().unwrap();
+            assert_eq!(native.prefixes, wire[..header_bytes]);
+            assert_eq!(native.empty_bytes, header_bytes);
+            assert!(native.first_failure.is_none());
+        }
+        {
+            let frames = custody.frames.lock().await;
+            assert_eq!(frames.next, 1);
+            assert_eq!(frames.frames[0].bytes, wire[..header_bytes]);
+            assert!(frames.frames[0].data.is_none());
+            assert!(frames.messages.is_empty());
+        }
+        let original = custody.first_failure.get().unwrap();
+        assert!(matches!(original, crate::Error::ExcessData));
+        let original_pointer = std::ptr::from_ref(original);
+
+        assert!(split.read_mut().receive_message(
+            2, &mut Vec::new(), &mut Vec::new(),
+        ).await.is_err());
+
+        assert_eq!(original_pointer, std::ptr::from_ref(custody.first_failure.get().unwrap()));
+        assert_eq!(custody.native.lock().unwrap().prefixes, wire[..header_bytes]);
+        assert!(matches!(custody.shutdown_result.get(), Some(Ok(()))));
+    }
+}
