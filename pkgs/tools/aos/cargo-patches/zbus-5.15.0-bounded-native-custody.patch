+// Actual fixed request reservations remain on the original through build,
+// send, positive storage compaction and end. This is transport DATA, not a payer.
+pub(crate) struct HostOutgoingWireBudgetV2 {
+    maximum: usize,
+    maximum_frames: usize,
+    charged: usize,
+    frames: Vec<HostOutgoingWireFrameV2>,
+}
+
+pub(crate) struct HostOutgoingWireFrameV2 {
+    serial: u32,
+    width: usize,
+    retained: bool,
+}
+
+impl HostOutgoingWireBudgetV2 {
+    pub(crate) fn new(maximum: usize, messages: usize) -> Self {
+        Self { maximum, maximum_frames: messages, charged: 0, frames: Vec::with_capacity(messages) }
+    }
+
+    fn reserve_before_build_v2(&mut self, serial: u32, width: usize) -> Result<()> {
+        if self.frames.len() == self.maximum_frames
+            || self.frames.iter().any(|frame| frame.serial == serial)
+        { return Err(Error::ExcessData); }
+        let charged = self.charged.checked_add(width).filter(|value| *value <= self.maximum)
+            .ok_or(Error::ExcessData)?;
+        self.frames.push(HostOutgoingWireFrameV2 { serial, width, retained: false });
+        self.charged = charged;
+        Ok(())
+    }
+
+    pub(crate) fn retain_message_v2(&mut self, serial: u32, width: usize) -> Result<()> {
+        match self.frames.iter_mut().find(|frame| frame.serial == serial) {
+            Some(frame) if !frame.retained && frame.width == width => { frame.retained = true; Ok(()) }
+            Some(_) => Err(Error::InvalidReply),
+            None => {
+                self.reserve_before_build_v2(serial, width)?;
+                if let Some(frame) = self.frames.last_mut() { frame.retained = true; }
+                Ok(())
+            }
+        }
+    }
+
+    pub(crate) fn complete_v2(&self) -> bool {
+        self.frames.iter().all(|frame| frame.retained)
+    }
+}
