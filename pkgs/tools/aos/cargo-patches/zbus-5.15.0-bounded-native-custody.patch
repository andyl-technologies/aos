+/// Reports a refused physical native/message-FD disposition without healing it.
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+#[derive(Debug)]
+pub enum HostLaunchNativeDisposalErrorV2 {
+    /// The actual positive close/join/ownership frontier is incomplete.
+    Incomplete,
+    /// A native destination is borrowed or poisoned.
+    Unavailable,
+    /// Another actual outgoing message alias still owns its descriptor roles.
+    MessageAliased { /// Actual strong aliases.
+        strong: usize, /// Actual weak aliases.
+        weak: usize },
+    /// An independent serialized data clone/slice still owns outgoing FD roles.
+    DataAliased { /// Actual strong backing aliases.
+        strong: usize, /// Actual weak backing aliases.
