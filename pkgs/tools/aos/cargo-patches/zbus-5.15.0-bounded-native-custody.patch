+// Unique custody is a mechanical ownership check, not a caller's end/authority
+// label. Any pending reader, writehalf, cancellation guard or native borrower
+// must be gone before the actual kernel socket can be removed from its slot.
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+pub(crate) fn retire_unique_controller_socket_v1(
+    owner: &mut std::sync::Arc<LauncherImageReceiveCustodyV1>,
+) -> Result<(), ControllerSocketRetirementErrorV1> {
+    retire_unique_socket_engine_v2(owner, RetiringDispositionV2::Controller)
+}
+
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+enum RetiringDispositionV2 { Controller, HostLaunch }
+
+#[cfg(all(target_os = "linux", feature = "tokio"))]
+fn retire_unique_socket_engine_v2(
+    owner: &mut std::sync::Arc<LauncherImageReceiveCustodyV1>,
+    disposition: RetiringDispositionV2,
+) -> Result<(), ControllerSocketRetirementErrorV1> {
+
+    let strong = std::sync::Arc::strong_count(owner);
+    let weak = std::sync::Arc::weak_count(owner);
+    let native = std::sync::Arc::get_mut(owner)
+        .ok_or(ControllerSocketRetirementErrorV1::CustodyAliased { strong, weak })?;
+    if !match disposition {
+            RetiringDispositionV2::Controller => matches!(native.disposition, FixedReceiveDispositionV1::ControllerProperties),
+            RetiringDispositionV2::HostLaunch => native.is_retained_manager_v4(),
+        }
+        || !matches!(native.shutdown_result.get(), Some(Ok(())))
+        || native.rejected_socket.get().is_some()
+        || native.rejected_shutdown_result.get().is_some()
+        || !matches!(native.failure(), Ok(Some(cause)) if matches!(cause.cause(), LauncherImageFailureRefV1::Ended))
+    {
+        return Err(ControllerSocketRetirementErrorV1::Incomplete);
+    }
+    if matches!(disposition, RetiringDispositionV2::HostLaunch)
+        && !native.host_connect.positive_ready_v2()
+    { return Err(ControllerSocketRetirementErrorV1::Incomplete); }
+    let socket = native.socket.get_mut().ok_or(ControllerSocketRetirementErrorV1::Incomplete)?;
+    let strong = std::sync::Arc::strong_count(socket);
+    let weak = std::sync::Arc::weak_count(socket);
+    if std::sync::Arc::get_mut(socket).is_none() {
+        return Err(ControllerSocketRetirementErrorV1::SocketAliased { strong, weak });
+    }
+    // Every native check precedes the first positive descriptor disposal.
+    // The private alias comes from the SAME original Tokio socket, never an
+    // independently supplied descriptor or reconstructed connection.
+    if matches!(disposition, RetiringDispositionV2::HostLaunch) {
+        native.host_connect.retire_positive_alias_v2();
+    }
+    drop(native.socket.take());
+    Ok(())
+}
