+/// Decodes JSON with a conservative typed-carrier admission budget.
+///
+/// The budget covers reached typed cells, collection growth/reallocation and
+/// small collection floors. It is shared throughout this one synchronous parse.
+/// Nested visitor and seed roles are conservatively charged independently;
+/// this admission score can count the same typed representation more than once.
+/// Encoded input, string/byte contents, JSON scratch, allocator metadata and
+/// arbitrary allocations inside custom `Deserialize` implementations remain
+/// separate caller obligations. This does not parse through a JSON Value DOM.
+///
+/// # Errors
+/// Returns the original Serde JSON error, including trailing-input refusal,
+/// or a Serde custom error before a typed admission exceeds the budget.
+#[cfg(feature = "json")]
+pub fn decode_json_with_element_memory_limit<M: DeserializeOwned>(
+    data: &[u8],
+    maximum_element_memory: usize,
+) -> Result<M, serde_json::Error> {
+    json_carriers::decode(data, maximum_element_memory)
+}
+
