+    #[cfg(test)]
+    mod tests {
+        use super::*;
+        use serde::Deserialize;
+        use std::cell::Cell;
+        use std::collections::BTreeMap;
+
+        thread_local! { static CONSTRUCTIONS: Cell<usize> = const { Cell::new(0) }; }
+
+        #[derive(Debug)]
+        struct Heavy {
+            padding: [u64; 32],
+        }
+
+        impl<'de> Deserialize<'de> for Heavy {
+            fn deserialize<D: de::Deserializer<'de>>(decoder: D) -> Result<Self, D::Error> {
+                CONSTRUCTIONS.with(|count| count.set(count.get() + 1));
+                de::IgnoredAny::deserialize(decoder)?;
+                Ok(Self { padding: [0; 32] })
+            }
+        }
+
+        #[test]
+        fn exact_scalar_boundary_and_empty_collection_end_are_not_false_elements() {
+            let scalar = size_of::<u64>() + align_of::<u64>();
+            assert_eq!(decode::<u64>(b"7", scalar).unwrap(), 7);
+            assert!(decode::<u64>(b"7", scalar - 1).is_err());
+
+            let empty = size_of::<Vec<Heavy>>() + align_of::<Vec<Heavy>>();
+            assert!(decode::<Vec<Heavy>>(b"[]", empty).unwrap().is_empty());
+            assert!(decode::<Vec<Heavy>>(b"[] trailing", empty).is_err());
+        }
+
+        #[test]
+        fn heavy_element_refuses_before_its_deserializer_constructs_any_value() {
+            CONSTRUCTIONS.with(|count| count.set(0));
+            assert!(decode::<Vec<Heavy>>(b"[{}]", 1024).is_err());
+            assert_eq!(CONSTRUCTIONS.with(Cell::get), 0);
+
+            let value = decode::<Vec<Heavy>>(b"[{}]", usize::MAX).unwrap();
+            assert_eq!(CONSTRUCTIONS.with(Cell::get), 1);
+            assert_eq!(value[0].padding, [0; 32]);
+        }
+
+        #[derive(Deserialize, Debug)]
+        enum Nested {
+            Values(Vec<Heavy>),
+            Named { values: Vec<Heavy> },
+            Unit,
+        }
+
+        #[test]
+        fn map_values_and_enum_payloads_share_the_original_checked_budget() {
+            CONSTRUCTIONS.with(|count| count.set(0));
+            assert!(decode::<BTreeMap<String, Heavy>>(br#"{"left":{}}"#, 1024).is_err());
+            assert_eq!(CONSTRUCTIONS.with(Cell::get), 0);
+            let map = decode::<BTreeMap<String, Heavy>>(br#"{"left":{}}"#, usize::MAX).unwrap();
+            assert_eq!(map["left"].padding, [0; 32]);
+
+            for input in [
+                br#"{"Values":[{}]}"#.as_slice(),
+                br#"{"Named":{"values":[{}]}}"#,
+            ] {
+                assert!(decode::<Nested>(input, 1024).is_err());
+                match decode::<Nested>(input, usize::MAX).unwrap() {
+                    Nested::Values(values) | Nested::Named { values } => {
+                        assert_eq!(values.len(), 1)
+                    }
+                    Nested::Unit => panic!("wrong variant"),
+                }
+            }
+            assert!(matches!(
+                decode::<Nested>(br#""Unit""#, 1024).unwrap(),
+                Nested::Unit
+            ));
+        }
+
