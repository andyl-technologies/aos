+#[cfg(feature = "json")]
+mod json_carriers {
+    use serde::de::{
+        self, DeserializeOwned, DeserializeSeed, EnumAccess, MapAccess, SeqAccess, VariantAccess,
+        Visitor,
+    };
+    use std::fmt;
+    use std::mem::{align_of, size_of};
+
+    // Sequence growth retains at most old+new capacity plus one in-flight
+    // element. Maps also need sparse hash buckets: four cells cover the
+    // old+new 7/8-load-factor tables. The fixed floor covers small collections
+    // and one in-flight typed value. Map links are separate from byte contents.
+    const GROWTH: usize = 3;
+    const MAP_GROWTH: usize = 4;
+    const FLOOR: usize = 8;
+    const MAP_LINK_BYTES: usize = 8 * size_of::<usize>();
+
+    struct Budget {
+        remaining: usize,
+    }
+
+    impl Budget {
+        fn admit<T, E: de::Error>(&mut self, factor: usize, links: bool) -> Result<(), E> {
+            let error = || E::custom("JSON element memory limit exceeded");
+            let width = size_of::<T>()
+                .checked_add(align_of::<T>())
+                .ok_or_else(error)?;
+            let width = if links {
+                width.checked_add(MAP_LINK_BYTES).ok_or_else(error)?
+            } else {
+                width
+            };
+            let bytes = width.checked_mul(factor).ok_or_else(error)?;
+            self.remaining = self.remaining.checked_sub(bytes).ok_or_else(error)?;
+            Ok(())
+        }
+    }
+
+    pub(super) fn decode<M: DeserializeOwned>(
+        data: &[u8],
+        maximum: usize,
+    ) -> Result<M, serde_json::Error> {
+        let mut decoder = serde_json::Deserializer::from_slice(data);
+        let mut budget = Budget { remaining: maximum };
+        let value = M::deserialize(Decoder {
+            inner: &mut decoder,
+            budget: &mut budget,
+        })?;
+        decoder.end()?;
+        Ok(value)
+    }
+
+    struct Decoder<'b, D> {
+        inner: D,
+        budget: &'b mut Budget,
+    }
+
+    struct GuardVisitor<'b, V> {
+        inner: V,
+        budget: &'b mut Budget,
+    }
+
+    macro_rules! plain_decoder {
+        ($($name:ident),* $(,)?) => { $(
+            fn $name<V: Visitor<'de>>(self, visitor: V) -> Result<V::Value, Self::Error> {
+                self.budget.admit::<V::Value, Self::Error>(1, false)?;
+                self.inner.$name(GuardVisitor { inner: visitor, budget: self.budget })
+            }
+        )* };
+    }
+
+    impl<'de, D: de::Deserializer<'de>> de::Deserializer<'de> for Decoder<'_, D> {
+        type Error = D::Error;
+        plain_decoder!(
+            deserialize_any,
+            deserialize_bool,
+            deserialize_i8,
+            deserialize_i16,
+            deserialize_i32,
+            deserialize_i64,
+            deserialize_i128,
+            deserialize_u8,
+            deserialize_u16,
+            deserialize_u32,
+            deserialize_u64,
+            deserialize_u128,
+            deserialize_f32,
+            deserialize_f64,
+            deserialize_char,
+            deserialize_str,
+            deserialize_string,
+            deserialize_bytes,
+            deserialize_byte_buf,
+            deserialize_option,
+            deserialize_unit,
+            deserialize_seq,
+            deserialize_map,
+            deserialize_identifier,
+            deserialize_ignored_any
+        );
+
+        fn deserialize_unit_struct<V: Visitor<'de>>(
+            self,
+            name: &'static str,
+            visitor: V,
+        ) -> Result<V::Value, Self::Error> {
+            self.budget.admit::<V::Value, Self::Error>(1, false)?;
+            self.inner.deserialize_unit_struct(
+                name,
+                GuardVisitor {
+                    inner: visitor,
+                    budget: self.budget,
+                },
+            )
+        }
+
+        fn deserialize_newtype_struct<V: Visitor<'de>>(
+            self,
+            name: &'static str,
+            visitor: V,
+        ) -> Result<V::Value, Self::Error> {
+            self.budget.admit::<V::Value, Self::Error>(1, false)?;
+            self.inner.deserialize_newtype_struct(
+                name,
+                GuardVisitor {
+                    inner: visitor,
+                    budget: self.budget,
+                },
+            )
+        }
+
+        fn deserialize_tuple<V: Visitor<'de>>(
+            self,
+            len: usize,
+            visitor: V,
+        ) -> Result<V::Value, Self::Error> {
+            self.budget.admit::<V::Value, Self::Error>(1, false)?;
+            self.inner.deserialize_tuple(
+                len,
+                GuardVisitor {
+                    inner: visitor,
+                    budget: self.budget,
+                },
+            )
+        }
+
+        fn deserialize_tuple_struct<V: Visitor<'de>>(
+            self,
+            name: &'static str,
+            len: usize,
+            visitor: V,
+        ) -> Result<V::Value, Self::Error> {
+            self.budget.admit::<V::Value, Self::Error>(1, false)?;
+            self.inner.deserialize_tuple_struct(
+                name,
+                len,
+                GuardVisitor {
+                    inner: visitor,
+                    budget: self.budget,
+                },
+            )
+        }
+
+        fn deserialize_struct<V: Visitor<'de>>(
+            self,
+            name: &'static str,
+            fields: &'static [&'static str],
+            visitor: V,
+        ) -> Result<V::Value, Self::Error> {
+            self.budget.admit::<V::Value, Self::Error>(1, false)?;
+            self.inner.deserialize_struct(
+                name,
+                fields,
+                GuardVisitor {
+                    inner: visitor,
+                    budget: self.budget,
+                },
+            )
+        }
+
+        fn deserialize_enum<V: Visitor<'de>>(
+            self,
+            name: &'static str,
+            variants: &'static [&'static str],
+            visitor: V,
+        ) -> Result<V::Value, Self::Error> {
+            self.budget.admit::<V::Value, Self::Error>(1, false)?;
+            self.inner.deserialize_enum(
+                name,
+                variants,
+                GuardVisitor {
+                    inner: visitor,
+                    budget: self.budget,
+                },
+            )
+        }
+
+        fn is_human_readable(&self) -> bool {
+            self.inner.is_human_readable()
+        }
+    }
+
+    macro_rules! primitive_visitor {
+        ($($name:ident($ty:ty)),* $(,)?) => { $(
+            fn $name<E: de::Error>(self, value: $ty) -> Result<Self::Value, E> {
+                self.inner.$name(value)
+            }
+        )* };
+    }
+
+    impl<'de, V: Visitor<'de>> Visitor<'de> for GuardVisitor<'_, V> {
+        type Value = V::Value;
+
+        fn expecting(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+            self.inner.expecting(formatter)
+        }
+        primitive_visitor!(
+            visit_bool(bool),
+            visit_i8(i8),
+            visit_i16(i16),
+            visit_i32(i32),
+            visit_i64(i64),
+            visit_i128(i128),
+            visit_u8(u8),
+            visit_u16(u16),
+            visit_u32(u32),
+            visit_u64(u64),
+            visit_u128(u128),
+            visit_f32(f32),
+            visit_f64(f64),
+            visit_char(char),
+            visit_str(&str),
+            visit_string(String),
+            visit_bytes(&[u8]),
+            visit_byte_buf(Vec<u8>)
+        );
+
+        fn visit_borrowed_str<E: de::Error>(self, value: &'de str) -> Result<Self::Value, E> {
+            self.inner.visit_borrowed_str(value)
+        }
+
+        fn visit_borrowed_bytes<E: de::Error>(self, value: &'de [u8]) -> Result<Self::Value, E> {
+            self.inner.visit_borrowed_bytes(value)
+        }
+
+        fn visit_unit<E: de::Error>(self) -> Result<Self::Value, E> {
+            self.inner.visit_unit()
+        }
+
+        fn visit_none<E: de::Error>(self) -> Result<Self::Value, E> {
+            self.inner.visit_none()
+        }
+
+        fn visit_some<D: de::Deserializer<'de>>(self, decoder: D) -> Result<Self::Value, D::Error> {
+            self.inner.visit_some(Decoder {
+                inner: decoder,
+                budget: self.budget,
+            })
+        }
+
+        fn visit_newtype_struct<D: de::Deserializer<'de>>(
+            self,
+            decoder: D,
+        ) -> Result<Self::Value, D::Error> {
+            self.inner.visit_newtype_struct(Decoder {
+                inner: decoder,
+                budget: self.budget,
+            })
+        }
+
+        fn visit_seq<A: SeqAccess<'de>>(self, inner: A) -> Result<Self::Value, A::Error> {
+            self.inner.visit_seq(Sequence {
+                inner,
+                budget: self.budget,
+                first: true,
+            })
+        }
+
+        fn visit_map<A: MapAccess<'de>>(self, inner: A) -> Result<Self::Value, A::Error> {
+            self.inner.visit_map(Map {
+                inner,
+                budget: self.budget,
+                first_key: true,
+                first_value: true,
+            })
+        }
+
+        fn visit_enum<A: EnumAccess<'de>>(self, inner: A) -> Result<Self::Value, A::Error> {
+            self.inner.visit_enum(Enum {
+                inner,
+                budget: self.budget,
+            })
+        }
+    }
+
+    struct Seed<'b, S> {
+        inner: S,
+        budget: &'b mut Budget,
+        factor: usize,
+        links: bool,
+    }
+
+    impl<'de, S: DeserializeSeed<'de>> DeserializeSeed<'de> for Seed<'_, S> {
+        type Value = S::Value;
+
+        fn deserialize<D: de::Deserializer<'de>>(
+            self,
+            decoder: D,
+        ) -> Result<Self::Value, D::Error> {
+            // The actual parser checks a collection's closing delimiter before
+            // invoking this seed. An absent element never spends or refuses.
+            self.budget
+                .admit::<S::Value, D::Error>(self.factor, self.links)?;
+            self.inner.deserialize(Decoder {
+                inner: decoder,
+                budget: self.budget,
+            })
+        }
+    }
+
+    struct Sequence<'b, A> {
+        inner: A,
+        budget: &'b mut Budget,
+        first: bool,
+    }
+
+    impl<'de, A: SeqAccess<'de>> SeqAccess<'de> for Sequence<'_, A> {
+        type Error = A::Error;
+
+        fn next_element_seed<S: DeserializeSeed<'de>>(
+            &mut self,
+            seed: S,
+        ) -> Result<Option<S::Value>, Self::Error> {
+            let factor = GROWTH + if self.first { FLOOR } else { 0 };
+            self.first = false;
+            self.inner.next_element_seed(Seed {
+                inner: seed,
+                budget: self.budget,
+                factor,
+                links: false,
+            })
+        }
+
+        fn size_hint(&self) -> Option<usize> {
+            None
+        }
+    }
+
+    struct Map<'b, A> {
+        inner: A,
+        budget: &'b mut Budget,
+        first_key: bool,
+        first_value: bool,
+    }
+
+    impl<'de, A: MapAccess<'de>> MapAccess<'de> for Map<'_, A> {
+        type Error = A::Error;
+
+        fn next_key_seed<S: DeserializeSeed<'de>>(
+            &mut self,
+            seed: S,
+        ) -> Result<Option<S::Value>, Self::Error> {
+            let factor = MAP_GROWTH + if self.first_key { FLOOR } else { 0 };
+            self.first_key = false;
+            self.inner.next_key_seed(Seed {
+                inner: seed,
+                budget: self.budget,
+                factor,
+                links: true,
+            })
+        }
+
+        fn next_value_seed<S: DeserializeSeed<'de>>(
+            &mut self,
+            seed: S,
+        ) -> Result<S::Value, Self::Error> {
+            let factor = MAP_GROWTH + if self.first_value { FLOOR } else { 0 };
+            self.first_value = false;
+            self.inner.next_value_seed(Seed {
+                inner: seed,
+                budget: self.budget,
+                factor,
+                links: false,
+            })
+        }
+
+        fn size_hint(&self) -> Option<usize> {
+            None
+        }
+    }
+
+    struct Enum<'b, A> {
+        inner: A,
+        budget: &'b mut Budget,
+    }
+
+    struct Variant<'b, A> {
+        inner: A,
+        budget: &'b mut Budget,
+    }
+
+    impl<'de, 'b, A: EnumAccess<'de>> EnumAccess<'de> for Enum<'b, A> {
+        type Error = A::Error;
+        type Variant = Variant<'b, A::Variant>;
+
+        fn variant_seed<S: DeserializeSeed<'de>>(
+            self,
+            seed: S,
+        ) -> Result<(S::Value, Self::Variant), Self::Error> {
+            let (value, inner) = self.inner.variant_seed(Seed {
+                inner: seed,
+                budget: &mut *self.budget,
+                factor: 1,
+                links: false,
+            })?;
+            Ok((
+                value,
+                Variant {
+                    inner,
+                    budget: self.budget,
+                },
+            ))
+        }
+    }
+
+    impl<'de, A: VariantAccess<'de>> VariantAccess<'de> for Variant<'_, A> {
+        type Error = A::Error;
+
+        fn unit_variant(self) -> Result<(), Self::Error> {
+            self.inner.unit_variant()
+        }
+
+        fn newtype_variant_seed<S: DeserializeSeed<'de>>(
+            self,
+            seed: S,
+        ) -> Result<S::Value, Self::Error> {
+            self.inner.newtype_variant_seed(Seed {
+                inner: seed,
+                budget: self.budget,
+                factor: 1,
+                links: false,
+            })
+        }
+
+        fn tuple_variant<V: Visitor<'de>>(
+            self,
+            len: usize,
+            visitor: V,
+        ) -> Result<V::Value, Self::Error> {
+            self.budget.admit::<V::Value, Self::Error>(1, false)?;
+            self.inner.tuple_variant(
