+#[cfg(all(test, feature = "json"))]
+mod json_codec_budget_tests {
+    use super::*;
+    use buffa_types::google::protobuf::{BytesValue, ListValue, Value};
+
+    #[test]
+    fn real_proto_json_heavy_tiny_elements_are_bounded_below_the_wire_limit() {
+        let count = crate::test_budget::elements_over_default_budget::<Value>();
+        let mut input = String::from("[");
+        for index in 0..count {
+            if index != 0 {
+                input.push(',');
+            }
+            input.push_str("{}");
+        }
+        input.push(']');
+        assert!(input.len() < 4 * 1024 * 1024);
+        assert!(decode_json::<ListValue>(input.as_bytes()).is_err());
+        let value =
+            decode_json_with_element_memory_limit::<ListValue>(input.as_bytes(), usize::MAX)
+                .unwrap();
+        assert_eq!(value.values.len(), count);
+    }
+
+    #[test]
+    fn small_json_preserves_null_base64_unknown_duplicate_and_trailing_rules() {
+        let list =
+            decode_json_with_element_memory_limit::<ListValue>(b"[null,{},7]", 64 * 1024).unwrap();
+        assert_eq!(
+            list,
+            serde_json::from_slice::<ListValue>(b"[null,{},7]").unwrap()
+        );
+        let bytes =
+            decode_json_with_element_memory_limit::<BytesValue>(br#""AQID""#, 64 * 1024).unwrap();
+        assert_eq!(bytes.value.as_slice(), &[1, 2, 3]);
+
+        #[derive(serde::Deserialize, Debug, PartialEq)]
+        struct Metadata {
+            value: u64,
+        }
+        let input = br#"{"value":7,"unknown":{"nested":[true,false]}}"#;
+        assert_eq!(
+            decode_json_with_element_memory_limit::<Metadata>(input, 64 * 1024).unwrap(),
+            serde_json::from_slice::<Metadata>(input).unwrap()
+        );
+        for input in [
+            br#"{"value":7,"value":8}"#.as_slice(),
+            br#"{"value":7} false"#,
+        ] {
+            assert!(serde_json::from_slice::<Metadata>(input).is_err());
+            assert!(decode_json_with_element_memory_limit::<Metadata>(input, 64 * 1024).is_err());
+        }
+    }
