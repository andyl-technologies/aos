+impl<IS, SD> Future for MidHandshake<IS>
+where
+    IS: IoSession + Unpin,
+    IS::Io: AsyncRead + AsyncWrite + Unpin,
+    IS::Session: DerefMut + Deref<Target = ConnectionCommon<SD>> + Unpin,
+    SD: SideData,
+{
+    type Output = Result<IS, (io::Error, IS::Io)>;
+
+    fn poll(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        let this = self.get_mut();
+        // Legacy futures never retained the temporary record-loop EOF flag.
+        // Leave that behavior unchanged while sharing the resident engine.
+        let result = {
+            let mut guard = LegacyPollGuard {
+                state: &mut *this,
+                armed: true,
+            };
+            let mut progress = (false, false);
+            let result = guard.state.poll_handshake(cx, &mut progress);
+            guard.armed = false;
+            match result {
+                Poll::Pending => return Poll::Pending,
+                Poll::Ready(result) => result,
+            }
+        };
+
+        match (mem::replace(this, Self::End), result) {
+            (Self::Handshaking(stream), Ok(())) => Poll::Ready(Ok(stream)),
+            (Self::Handshaking(stream), Err(Some(error))) => {
+                Poll::Ready(Err((error, stream.into_io())))
+            }
+            (Self::SendAlert { io, error, .. } | Self::Error { io, error }, Err(None)) => {
+                Poll::Ready(Err((error, io)))
+            }
+            _ => panic!("unexpected polling after handshake"),
         }
+    }
+}
