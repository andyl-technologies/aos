+        let driver = std::future::poll_fn(|cx| Pin::new(&mut owner).poll_accept(cx));
+        drop(driver);
+
+        assert_eq!(owner.get_ref().unwrap() as *const TestIo, original);
+        assert_eq!(counts.reads.get(), 0);
+        assert_eq!(counts.drops.get(), 0);
+        drop(owner);
+        assert_eq!(counts.drops.get(), 1);
+    }
