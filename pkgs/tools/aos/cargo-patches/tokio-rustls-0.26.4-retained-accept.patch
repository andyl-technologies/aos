+        let (error, io) = match Pin::new(&mut accept).poll(&mut cx) {
+            Poll::Ready(Err(parts)) => parts,
+            _ => panic!("fallible initialization error must return original IO"),
+        };
+        assert_original_error(&error, &token);
+        assert_eq!(counts.drops.get(), 0);
+        drop(io);
