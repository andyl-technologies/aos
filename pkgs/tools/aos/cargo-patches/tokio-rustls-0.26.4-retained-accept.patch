+// Legacy polling previously installed End before entering user IO. Keep its
+// unwind/drop behavior without moving a session out while the engine is polled.
+// This guard does not catch a panic or promise recovery of provider state.
+struct LegacyPollGuard<'a, IS: IoSession> {
+    state: &'a mut MidHandshake<IS>,
+    armed: bool,
+}
+
+impl<IS: IoSession> Drop for LegacyPollGuard<'_, IS> {
+    fn drop(&mut self) {
+        if !self.armed {
+            return;
+        }
+
+        match mem::replace(self.state, MidHandshake::End) {
+            MidHandshake::Handshaking(stream) => drop(stream),
+            MidHandshake::SendAlert { io, alert, error } => {
+                drop(error);
+                drop(alert);
+                drop(io);
+            }
+            MidHandshake::Error { io, error } => {
+                drop(error);
+                drop(io);
+            }
+            MidHandshake::End => {}
+        }
+    }
+}
