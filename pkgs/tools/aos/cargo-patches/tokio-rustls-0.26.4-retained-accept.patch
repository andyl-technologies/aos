+    struct PeerIo {
+        client: ClientConnection,
+        output: Vec<u8>,
+        offset: usize,
+        drops: Rc<Cell<usize>>,
+    }
+
+    impl Drop for PeerIo {
+        fn drop(&mut self) {
+            self.drops.set(self.drops.get() + 1);
+        }
+    }
+
+    impl AsyncRead for PeerIo {
+        fn poll_read(
+            self: Pin<&mut Self>,
+            _: &mut Context<'_>,
+            buf: &mut ReadBuf<'_>,
+        ) -> Poll<io::Result<()>> {
+            let this = self.get_mut();
+            if this.offset == this.output.len() {
+                this.output.clear();
+                this.offset = 0;
+                this.client.write_tls(&mut this.output).unwrap();
+            }
+            if this.output.is_empty() {
+                return Poll::Pending;
+            }
+
+            let count = buf.remaining().min(this.output.len() - this.offset);
+            buf.put_slice(&this.output[this.offset..this.offset + count]);
+            this.offset += count;
+            Poll::Ready(Ok(()))
+        }
+    }
+
+    impl AsyncWrite for PeerIo {
+        fn poll_write(
+            self: Pin<&mut Self>,
+            _: &mut Context<'_>,
+            bytes: &[u8],
+        ) -> Poll<io::Result<usize>> {
+            let this = self.get_mut();
+            let mut remaining = bytes;
+            while !remaining.is_empty() {
+                let consumed = this.client.read_tls(&mut remaining).unwrap();
+                assert!(consumed > 0);
+                this.client.process_new_packets().unwrap();
+            }
+            Poll::Ready(Ok(bytes.len()))
+        }
+
+        fn poll_flush(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<()>> {
+            Poll::Ready(Ok(()))
+        }
+
+        fn poll_shutdown(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<()>> {
+            Poll::Ready(Ok(()))
+        }
+    }
+
+    #[test]
+    fn genuine_in_memory_tls_success_moves_the_sole_completed_stream() {
+        let (server, client) = configs();
+        let drops = Rc::new(Cell::new(0));
+        let io = PeerIo {
+            client: ClientConnection::new(
+                Arc::new(client),
+                ServerName::try_from("localhost").unwrap(),
+            )
+            .unwrap(),
+            output: Vec::new(),
+            offset: 0,
+            drops: drops.clone(),
+        };
+        let mut owner = TlsAcceptor::from(Arc::new(server)).accept_retained(io);
+        let waker = waker();
+        let mut cx = Context::from_waker(&waker);
+
+        let stream = match Pin::new(&mut owner).poll_accept(&mut cx) {
+            Poll::Ready(Ok(stream)) => stream,
+            _ => panic!("real in-memory TLS peers must complete the shared engine"),
+        };
+
+        assert!(!stream.get_ref().1.is_handshaking());
+        assert!(!stream.get_ref().0.client.is_handshaking());
+        assert!(owner.get_ref().is_none());
+        assert!(owner.tls_stream().is_none());
+        assert!(owner.error().is_none());
+        assert_eq!(drops.get(), 0);
+        drop(owner);
+        assert_eq!(drops.get(), 0);
+        drop(stream);
+        assert_eq!(drops.get(), 1);
+    }
