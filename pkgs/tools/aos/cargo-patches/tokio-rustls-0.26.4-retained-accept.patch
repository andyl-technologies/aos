+/// A terminal failure marker whose original cause remains in [`RetainedAccept`].
+///
+/// The marker carries no replacement error or reconstructed transport. Inspect
+/// the owning handshake's [`RetainedAccept::error`] for the actual first cause.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct RetainedAcceptFailure;
+
+/// A server handshake retaining its original transport and TLS state on failure.
+///
+/// Unlike [`Accept`], this is not an owning future. [`Self::poll_accept`] borrows
+/// it, so an outer driver may be cancelled without discarding the resident owner.
+/// Pending and failed sessions remain available through read-only borrows. A
+/// successful poll moves the sole completed stream out exactly once.
+///
+/// An initialization failure retains the original IO and cause, and the lazy
+/// accept error path also retains its actual accepted alert. Neither had a
+/// `ServerConnection` to retain. This does not recover bytes or TLS state already
+/// consumed/discarded inside rustls, provide an unwind-recovery guarantee, or
+/// register the owner against application cancellation. Dropping it drops IO.
+#[must_use = "the retained handshake owns its transport until success or explicit drop"]
+pub struct RetainedAccept<IO> {
+    inner: MidHandshake<TlsStream<IO>>,
+    error: Option<io::Error>,
+    failed: bool,
+    // Actual record-loop observations: EOF and whether flushing is still needed.
+    progress: (bool, bool),
+}
+
+impl<IO> RetainedAccept<IO> {
+    /// Borrows the original transport while the handshake remains resident.
+    pub fn get_ref(&self) -> Option<&IO> {
+        match &self.inner {
+            MidHandshake::Handshaking(stream) => Some(stream.get_ref().0),
+            MidHandshake::SendAlert { io, .. } | MidHandshake::Error { io, .. } => Some(io),
+            MidHandshake::End => None,
+        }
+    }
+
+    /// Borrows the actual pending or failed TLS stream, if construction succeeded.
+    pub fn tls_stream(&self) -> Option<&TlsStream<IO>> {
+        match &self.inner {
+            MidHandshake::Handshaking(stream) => Some(stream),
+            _ => None,
+        }
+    }
+
+    /// Borrows the original first cause after terminal failure.
+    ///
+    /// Repeated failed polls do not replace this error or perform more IO.
+    pub fn error(&self) -> Option<&io::Error> {
+        if !self.failed {
+            return None;
+        }
+
+        match &self.error {
+            Some(error) => Some(error),
+            None => match &self.inner {
+                MidHandshake::SendAlert { error, .. } | MidHandshake::Error { error, .. } => {
+                    Some(error)
+                }
+                _ => None,
+            },
+        }
+    }
+
+    /// Reports the last EOF flag observed by the actual TLS record loop.
+    ///
+    /// Initialization/accepted-alert paths have no such loop and report false.
+    pub fn handshake_eof(&self) -> bool {
+        self.progress.0
+    }
+
+    /// Reports the last flush flag observed by the actual TLS record loop.
+    ///
+    /// This is bookkeeping, not a promise that all ciphertext has been sent.
+    pub fn handshake_need_flush(&self) -> bool {
+        self.progress.1
+    }
+}
+
+impl<IO: AsyncRead + AsyncWrite + Unpin> RetainedAccept<IO> {
+    /// Drives the shared handshake engine while borrowing its resident state.
+    ///
+    /// # Errors
+    ///
+    /// Returns a marker on initialization, alert-write, record or flush failure.
+    /// The first actual cause remains borrowed through [`Self::error`]; the TLS
+    /// session, IO and alert (where present) remain owned here. Further polls
+    /// return the same marker without retrying IO or renewing the handshake.
+    ///
+    /// # Panics
+    ///
+    /// Panics if called after a successful poll moved out the completed stream,
+    /// as the legacy handshake future does. Provider/IO panics are not recovered.
+    pub fn poll_accept(
+        self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+    ) -> Poll<Result<TlsStream<IO>, RetainedAcceptFailure>> {
+        let this = self.get_mut();
+        if this.failed {
+            return Poll::Ready(Err(RetainedAcceptFailure));
+        }
+
+        match this.inner.poll_handshake(cx, &mut this.progress) {
+            Poll::Pending => Poll::Pending,
+            Poll::Ready(Err(error)) => {
+                this.error = error;
+                this.failed = true;
+                Poll::Ready(Err(RetainedAcceptFailure))
+            }
+            Poll::Ready(Ok(())) => match std::mem::replace(&mut this.inner, MidHandshake::End) {
+                MidHandshake::Handshaking(stream) => Poll::Ready(Ok(stream)),
+                _ => panic!("unexpected polling after handshake"),
+            },
+        }
+    }
+}
