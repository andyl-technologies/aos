+/// Retains the same serializer's reached native FD duplicates through refusal.
+///
+/// This inert native destination supplies no role, budget, or authority. The
+/// actual caller owns the writer, input, and returned original error separately.
+#[cfg(unix)]
+pub struct FdWriteOriginalV2 {
+    fds: FdList,
+    entered: bool,
+}
+
+#[cfg(unix)]
+impl FdWriteOriginalV2 {
+    /// Allocates an already-admitted bounded descriptor table without native IO.
+    ///
+    /// # Panics
+    /// Panics if the requested descriptor table exceeds Rust's allocation limit.
+    #[must_use]
+    pub fn new(maximum_descriptors: usize) -> Self {
+        Self { fds: FdList::Retained { fds: Vec::with_capacity(maximum_descriptors),
+            maximum: maximum_descriptors }, entered: false }
+    }
+
+    /// Closes an actually empty table and physically releases its storage.
+    ///
+    /// # Errors
+    /// Refuses a reached descriptor prefix. Success permanently closes this
+    /// destination; it never rearms serialization or changes a resource ledger.
+    pub fn retire_empty_storage_v2(&mut self) -> Result<()> {
+        if self.retained_descriptor_count_v2() != 0 { return Err(Error::OutOfBounds); }
+        self.entered = true;
+        match &mut self.fds {
+            FdList::Fds(fds) | FdList::Retained { fds, .. } => drop(std::mem::take(fds)),
+            FdList::Number(_) => return Err(Error::IncorrectType),
+        }
+        Ok(())
+    }
+
+    /// Reports reached native descriptor slots without exposing or adopting them.
+    #[must_use]
+    pub fn retained_descriptor_count_v2(&self) -> usize {
+        match &self.fds { FdList::Fds(fds) | FdList::Retained { fds, .. } => fds.len(), FdList::Number(_) => 0 }
+    }
+}
+
+#[cfg(unix)]
+impl Default for FdWriteOriginalV2 { fn default() -> Self { Self::new(0) } }
