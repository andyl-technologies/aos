+        let Value::Array(array) = &value else { panic!("array fixture") };
+        let outer = array.inner().as_ptr();
+        let Value::Structure(structure) = &array.inner()[0] else { panic!("structure fixture") };
+        let fields = structure.fields().as_ptr();
+        let Value::Str(text) = &structure.fields()[0] else { panic!("string fixture") };
+        let text_pointer = text.as_str().as_ptr();
+        let Value::Array(arguments) = &structure.fields()[1] else { panic!("argument fixture") };
+        let argument_cells = arguments.inner().as_ptr();
+
+        let owned = OwnedValue::from_static_value(value);
+
+        let Value::Array(array) = &*owned else { panic!("array output") };
+        assert_eq!(array.inner().as_ptr(), outer);
+        let Value::Structure(structure) = &array.inner()[0] else { panic!("structure output") };
+        assert_eq!(structure.fields().as_ptr(), fields);
+        let Value::Str(text) = &structure.fields()[0] else { panic!("string output") };
+        assert_eq!(text.as_str().as_ptr(), text_pointer);
+        let Value::Array(arguments) = &structure.fields()[1] else { panic!("argument output") };
+        assert_eq!(arguments.inner().as_ptr(), argument_cells);
+    }
