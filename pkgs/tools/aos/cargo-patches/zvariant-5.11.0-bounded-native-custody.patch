+#[cfg(test)]
+mod backing_ownership_tests {
+    use super::*;
+
+    #[test]
+    fn independent_clone_and_slice_retain_the_same_backing() {
+        let data = Data::new(vec![1, 2, 3], Context::new_dbus(crate::LE, 0));
+        assert_eq!(data.backing_ownership_extent_v2(), (1, 0));
+        let clone = data.clone();
+        let slice = data.slice(1..);
+        assert_eq!(data.backing_ownership_extent_v2(), (3, 0));
+        assert!(data.shares_backing_v2(&clone));
+        assert!(data.shares_backing_v2(&slice));
+        let separate = Data::new(vec![1, 2, 3], Context::new_dbus(crate::LE, 0));
+        assert!(!data.shares_backing_v2(&separate));
+        assert_eq!(slice.bytes(), &[2, 3]);
+        drop(clone);
+        assert_eq!(data.backing_ownership_extent_v2(), (2, 0));
+        drop(slice);
+        assert_eq!(data.backing_ownership_extent_v2(), (1, 0));
+    }
+}
