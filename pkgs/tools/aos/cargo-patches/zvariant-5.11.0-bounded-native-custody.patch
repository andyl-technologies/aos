+#[cfg(all(test, unix))]
+mod retained_fd_writer_tests {
+    use super::*;
+    use std::io::{Cursor, SeekFrom};
+    use std::os::fd::{AsFd, AsRawFd};
+
+    struct FailingWriter(Cursor<Vec<u8>>);
+
+    impl Write for FailingWriter {
+        fn write(&mut self, _: &[u8]) -> std::io::Result<usize> {
+            Err(std::io::Error::from_raw_os_error(28))
+        }
+        fn flush(&mut self) -> std::io::Result<()> { Ok(()) }
+    }
+
+    impl Seek for FailingWriter {
+        fn seek(&mut self, position: SeekFrom) -> std::io::Result<u64> { self.0.seek(position) }
+    }
+
+    #[test]
+    fn failed_native_write_keeps_actual_fd_duplicate_and_original_errno() {
+        let file = std::fs::File::open("/dev/null").unwrap();
+        let value = crate::Fd::from(file.as_fd());
+        let mut original = FdWriteOriginalV2::new(1);
+        let mut writer = FailingWriter(Cursor::new(Vec::new()));
+        // SAFETY: The same failed original and writer remain resident together
+        // throughout every byte/descriptor assertion below.
+        let cause = unsafe { to_writer_retaining_fds_v2(&mut writer,
+            Context::new_dbus(crate::LE, 0), &value, &mut original) }.unwrap_err();
+        assert!(matches!(&cause, Error::InputOutput(cause) if cause.raw_os_error() == Some(28)));
+        assert_eq!(original.retained_descriptor_count_v2(), 1);
+        let descriptor = match &original.fds {
+            FdList::Retained { fds, .. } => fds[0].as_raw_fd(),
+            _ => panic!("same retained native table missing"),
+        };
+        assert_ne!(descriptor, file.as_raw_fd());
+        let path = format!("/proc/self/fd/{descriptor}");
+        assert!(std::fs::read_link(&path).is_ok());
+        // SAFETY: Same original/writer ownership as the first call; reentry
+        // must refuse before any second native duplicate or write.
+        assert!(unsafe { to_writer_retaining_fds_v2(&mut writer,
+            Context::new_dbus(crate::LE, 0), &value, &mut original) }.is_err());
+        assert_eq!(original.retained_descriptor_count_v2(), 1);
+        assert!(std::fs::read_link(path).is_ok());
+    }
+
+    #[test]
+    fn retained_fd_table_exhaustion_refuses_before_the_next_duplicate() {
+        let first = std::fs::File::open("/dev/null").unwrap();
+        let second = std::fs::File::open("/dev/null").unwrap();
+        let value = (crate::Fd::from(first.as_fd()), crate::Fd::from(second.as_fd()));
+        let mut original = FdWriteOriginalV2::new(1);
+        let mut writer = Cursor::new(Vec::new());
+        // SAFETY: Failed FD destination stays alive with its exact byte writer.
+        let cause = unsafe { to_writer_retaining_fds_v2(&mut writer,
+            Context::new_dbus(crate::LE, 0), &value, &mut original) }.unwrap_err();
+        assert!(matches!(cause, Error::OutOfBounds));
+        assert_eq!(original.retained_descriptor_count_v2(), 1);
+        assert_eq!(writer.get_ref().len(), 4);
+    }
+
+    #[test]
+    fn empty_native_table_storage_disposal_cannot_rearm_serialization() {
+        let mut original = FdWriteOriginalV2::new(11);
+        original.retire_empty_storage_v2().unwrap();
+        assert!(original.entered);
+        match &original.fds {
+            FdList::Retained { fds, maximum } => {
+                assert_eq!(fds.capacity(), 0);
+                assert_eq!(*maximum, 11);
+            }
+            _ => panic!("original spent bound missing"),
+        }
+        let mut writer = Cursor::new(Vec::new());
+        // SAFETY: No successful call can enter the permanently closed empty
