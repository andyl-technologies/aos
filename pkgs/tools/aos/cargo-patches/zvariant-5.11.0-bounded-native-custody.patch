+/// Serializes through the same engine into an already-owned native destination.
+///
+/// # Errors
+/// Refuses reentry or any original signature, serializer, write, or descriptor
+/// duplication failure. Every reached duplicate remains in `original` on Err;
+/// successful `Written` owns those same duplicates as in the ordinary function.
+///
+/// # Safety
+/// The caller must keep either the failed `original` or successful `Written`
+/// alive for as long as any serialized bytes may refer to its descriptors.
+#[cfg(unix)]
+pub unsafe fn to_writer_retaining_fds_v2<W, T>(
+    writer: &mut W, ctxt: Context, value: &T, original: &mut FdWriteOriginalV2,
+) -> Result<Written>
+where W: Write + Seek, T: ?Sized + Serialize + DynamicType,
+{
+    if original.entered { return Err(Error::Message("retained serializer reentry".to_owned())); }
+    original.entered = true;
+    to_writer_for_signature_engine_v2(writer, ctxt, value.signature(), value, Some(&mut original.fds))
 }
 
