+        let owned = OwnedValue::from_static_value(value);
+
+        let Value::Structure(structure) = &*owned else { panic!("structure output") };
+        let Value::Fd(crate::Fd::Owned(descriptor)) = &structure.fields()[1] else {
+            panic!("original owned descriptor")
