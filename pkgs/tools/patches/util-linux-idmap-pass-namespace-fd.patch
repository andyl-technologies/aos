+/* The child opens its own namespace. Opening /proc/<child>/ns/user from
+ * the parent would additionally require CAP_SYS_PTRACE in the new userns. */
+static int send_userns_fd(int channel, int namespace_fd)
+{
+	char ready = '1';
+	struct iovec iov = { .iov_base = &ready, .iov_len = sizeof(ready) };
+	union {
+		struct cmsghdr alignment;
+		char bytes[CMSG_SPACE(sizeof(int))];
+	} control = {0};
+	struct msghdr message = {
+		.msg_iov = &iov,
+		.msg_iovlen = 1,
+		.msg_control = control.bytes,
+		.msg_controllen = sizeof(control.bytes),
+	};
+	struct cmsghdr *header = CMSG_FIRSTHDR(&message);
+	ssize_t result;
+
+	header->cmsg_level = SOL_SOCKET;
+	header->cmsg_type = SCM_RIGHTS;
+	header->cmsg_len = CMSG_LEN(sizeof(int));
+	memcpy(CMSG_DATA(header), &namespace_fd, sizeof(namespace_fd));
+
+	do {
+		result = sendmsg(channel, &message, MSG_NOSIGNAL);
+	} while (result < 0 && errno == EINTR);
+
+	return result == 1 ? 0 : -1;
+}
+
+static int receive_userns_fd(int channel)
+{
+	char ready = 0;
+	struct iovec iov = { .iov_base = &ready, .iov_len = sizeof(ready) };
+	union {
+		struct cmsghdr alignment;
+		char bytes[CMSG_SPACE(2 * sizeof(int))];
+	} control = {0};
+	struct msghdr message = {
+		.msg_iov = &iov,
+		.msg_iovlen = 1,
+		.msg_control = control.bytes,
+		.msg_controllen = sizeof(control.bytes),
+	};
+	ssize_t result;
+	int namespace_fd = -1;
+	unsigned count = 0;
+
+	do {
+		result = recvmsg(channel, &message, MSG_CMSG_CLOEXEC);
+	} while (result < 0 && errno == EINTR);
+	if (result < 0)
+		return -1;
+
+	bool valid = result == 1 && ready == '1' &&
+		!(message.msg_flags & (MSG_TRUNC | MSG_CTRUNC));
+	for (struct cmsghdr *header = CMSG_FIRSTHDR(&message); header;
+	     header = CMSG_NXTHDR(&message, header)) {
+		if (header->cmsg_level != SOL_SOCKET || header->cmsg_type != SCM_RIGHTS ||
+		    header->cmsg_len < CMSG_LEN(0)) {
+			valid = false;
+			continue;
+		}
+
+		size_t bytes = header->cmsg_len - CMSG_LEN(0);
+		if (bytes != sizeof(int))
+			valid = false;
+		/* Alignment can fit two FDs in space intended for one. Close every
+		 * actually received FD, including malformed or truncated handoffs. */
+		for (size_t offset = 0; offset + sizeof(int) <= bytes; offset += sizeof(int)) {
+			int received;
+			memcpy(&received, (char *)CMSG_DATA(header) + offset, sizeof(received));
+			if (count++ == 0)
+				namespace_fd = received;
+			else
+				close(received);
+		}
+	}
+
+	if (!valid || count != 1) {
+		if (namespace_fd >= 0)
+			close(namespace_fd);
+		errno = EPROTO;
+		return -1;
+	}
+
+	return namespace_fd;
+}
