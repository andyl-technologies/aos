# Every first-party dependency in one configuration selects the same resolved
# family. This preserves Rust type identity without globally unioning features.
[
    alias(
        name = "core_" + name.replace("-", "_"),
        actual = select({
            "//tools/bazel/rules:formats_dependencies": FORMATS_CRATES.get(name, "//tools/bazel/rules:formats_profile_required"),
            "//tools/bazel/rules:crucible_cli_dependencies": CRUCIBLE_CLI_CRATES.get(name, "//tools/bazel/rules:crucible_cli_profile_required"),
            "//tools/bazel/rules:daemon_dependencies": DAEMON_CRATES.get(name, "//tools/bazel/rules:daemon_profile_required"),
            "//tools/bazel/rules:store_s3_dependencies": STORE_S3_CRATES.get(name, "//tools/bazel/rules:store_s3_profile_required"),
            "//tools/bazel/rules:qemu_host_dependencies": QEMU_HOST_CRATES.get(name, "//tools/bazel/rules:qemu_host_profile_required"),
            "//tools/bazel/rules:control_dependencies": CONTROL_CRATES.get(name, "//tools/bazel/rules:control_profile_required"),
            "//tools/bazel/rules:session_dependencies": SESSION_CRATES.get(name, "//tools/bazel/rules:session_profile_required"),
            "//tools/bazel/rules:quota_dependencies": QUOTA_CRATES.get(name, "//tools/bazel/rules:quota_profile_required"),
            "//tools/bazel/rules:engine_dependencies": ENGINE_CRATES.get(name, "//tools/bazel/rules:engine_profile_required"),
            "//tools/bazel/rules:guest_dependencies": GUEST_CRATES.get(name, "//tools/bazel/rules:guest_profile_required"),
            "//tools/bazel/rules:device_dependencies": DEVICE_CRATES.get(name, "//tools/bazel/rules:store_profile_required"),
            "//tools/bazel/rules:store_dependencies": STORE_CRATES.get(name, "//tools/bazel/rules:device_profile_required"),
            "//conditions:default": CORE_CRATES.get(name, "//tools/bazel/rules:store_profile_required" if name in STORE_CRATES else "//tools/bazel/rules:device_profile_required"),
        }),
        visibility = ["//visibility:public"],
    )
    for name in sorted(dict(CORE_CRATES.items() + DEVICE_CRATES.items() + STORE_CRATES.items() + GUEST_CRATES.items() + ENGINE_CRATES.items() + QUOTA_CRATES.items() + SESSION_CRATES.items() + CONTROL_CRATES.items() + QEMU_HOST_CRATES.items() + STORE_S3_CRATES.items() + DAEMON_CRATES.items() + CRUCIBLE_CLI_CRATES.items() + FORMATS_CRATES.items()))
]

