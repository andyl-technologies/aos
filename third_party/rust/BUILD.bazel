    alias(
        name = "core_" + name.replace("-", "_"),
        actual = select({
            "//tools/bazel/rules:release_preparation_dependencies": RELEASE_PREPARATION_CRATES.get(name, "//tools/bazel/rules:formats_profile_required"),
