+#[cfg(test)]
+mod dependency_output_directory_tests {
+    use super::BuildScriptOutput;
+
+    #[test]
+    fn dependent_build_script_retains_producer_include_directory() {
+        let producer_output = "bazel-out/cfg/bin/libssh2/_bs.out_dir";
+        let metadata = [BuildScriptOutput::DepEnv(format!(
+            "INCLUDE=/producer/execroot/{producer_output}/include"
+        ))];
+
+        let serialized = BuildScriptOutput::outputs_to_dep_env(
+            &metadata,
+            "ssh2",
+            "/producer/execroot",
+            producer_output,
+        );
+        let consumed = serialized.replace("${pwd}", "/consumer/execroot");
+
+        assert_eq!(
+            consumed,
+            "DEP_SSH2_INCLUDE=/consumer/execroot/bazel-out/cfg/bin/libssh2/_bs.out_dir/include"
+        );
+    }
