+def _effective_profile(ctx, toolchain):
+    """Reports the compiled crate's profile, independently of the script binary."""
+    mode = get_compilation_mode_opts(ctx, toolchain)
+    values = {"opt-level": mode.opt_level, "debuginfo": mode.debug_info}
+
+    # These are the same role-specific global settings appended by rustc.bzl.
+    # The script executable itself always uses the execution configuration;
+    # its consumer can use a different target profile.
+    flags = ctx.attr.rustc_flags + collect_extra_rustc_flags(
+        ctx, toolchain, ctx.attr.script[rust_common.crate_info].root, "rlib",
+    )
+    pending_codegen = False
+    for flag in flags:
+        codegen = None
+        if pending_codegen:
+            codegen = flag
+            pending_codegen = False
+        elif flag in ["-C", "--codegen"]:
+            pending_codegen = True
+        elif flag.startswith("--codegen="):
+            codegen = flag[len("--codegen="):]
+        elif flag.startswith("-C"):
+            codegen = flag[2:]
+        if codegen != None:
+            name, separator, value = codegen.partition("=")
+            if separator and name in values:
+                values[name] = value
+
+    default_profile = "release" if ctx.var["COMPILATION_MODE"] == "opt" else "debug"
+    profile = ctx.var.get("AOS_CARGO_PROFILE", default_profile)
+    if profile not in ["debug", "release"]:
+        fail("AOS_CARGO_PROFILE must be debug or release")
+    return {
+        "OPT_LEVEL": values["opt-level"],
+        "DEBUG": "false" if str(values["debuginfo"]) in ["0", "none"] else "true",
+        "PROFILE": profile,
+    }
+
