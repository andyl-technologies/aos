# ANDYL OS -- VM Driver Kernel Configuration Fragment
#
# Virtio drivers for running ANDYL OS as a KVM/QEMU guest.
# Boot-critical drivers are built-in (=y); non-boot-critical are modules (=m).

# --- Virtio core ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_MODERN=y
CONFIG_VIRTIO_MMIO=y

# --- Virtio block (boot-critical, built-in) ---
CONFIG_VIRTIO_BLK=y

# --- Virtio SCSI (boot-critical, built-in) ---
CONFIG_SCSI_VIRTIO=y

# --- Virtio network (boot-critical, built-in) ---
CONFIG_VIRTIO_NET=y

# --- Virtio console (boot-critical, built-in) ---
CONFIG_VIRTIO_CONSOLE=y

# --- Virtio balloon (memory management, module) ---
CONFIG_VIRTIO_BALLOON=y

# --- Virtio RNG ---
CONFIG_HW_RANDOM_VIRTIO=y

# --- Virtio filesystem (host-guest sharing, module) ---
CONFIG_VIRTIO_FS=m

# --- Virtio GPU (console only, module) ---
CONFIG_DRM_VIRTIO_GPU=m

# --- Virtio input ---
CONFIG_VIRTIO_INPUT=y

# --- Virtio vsock (host-guest communication, module) ---
CONFIG_VIRTIO_VSOCK=m
CONFIG_VHOST_VSOCK=m

# --- QEMU guest agent support ---
CONFIG_VIRTIO_TRANSPORT_COMMON=y
