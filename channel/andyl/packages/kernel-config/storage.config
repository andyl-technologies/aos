# ANDYL OS -- Storage Kernel Configuration Fragment
#
# ZFS prerequisites, NVMe, AHCI SATA, crypto modules for ZFS checksums.
# ZFS itself is built out-of-tree; do NOT enable in-tree CONFIG_ZFS.

# --- ZFS prerequisites ---
CONFIG_FS_POSIX_ACL=y
CONFIG_TMPFS_POSIX_ACL=y

# --- Crypto acceleration for ZFS checksums and compression ---
CONFIG_CRYPTO=y
CONFIG_CRYPTO_DEFLATE=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZ4HC=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_SKCIPHER=y

# --- Unicode support for ZFS datasets ---
CONFIG_UNICODE=y

# --- NVMe (built-in for boot) ---
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_NVME_MULTIPATH=y
CONFIG_NVME_HWMON=y

# --- AHCI SATA (built-in for boot) ---
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=m
