# ANDYL OS -- Cloud Driver Kernel Configuration Fragment
#
# Drivers for AWS (EC2), GCP (Compute Engine), and Azure (Hyper-V).

# --- AWS EC2 ---
# ENA (Elastic Network Adapter)
CONFIG_ENA_ETHERNET=m
# NVMe (covered by storage.config, but ensure core is present)
CONFIG_NVME_CORE=y
# Xen (for older non-Nitro instance types)
CONFIG_XEN=y
CONFIG_XEN_PV=y
CONFIG_XEN_PVHVM=y
CONFIG_XEN_BLKDEV_FRONTEND=m
CONFIG_XEN_NETDEV_FRONTEND=m
# EFA (Elastic Fabric Adapter, HPC)
CONFIG_EFA=m
# Serial console (required for EC2 serial console)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# --- GCP Compute Engine ---
# gVNIC (Google Virtual NIC)
CONFIG_GVE=m
# ACPI support (Google guest environment)
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y

# --- Azure Hyper-V ---
CONFIG_HYPERV=y
CONFIG_HYPERV_UTILS=y
CONFIG_HYPERV_VMBUS=y
CONFIG_HYPERV_NET=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_KEYBOARD=m
CONFIG_HYPERV_BALLOON=m
CONFIG_DRM_HYPERV=m
