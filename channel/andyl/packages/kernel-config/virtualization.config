# ANDYL OS -- Virtualization Kernel Configuration Fragment
#
# KVM (Intel and AMD), vhost for accelerated guest I/O, IOMMU for device
# passthrough, VFIO, and huge pages for VM memory.

# --- KVM ---
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=m
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=m

# --- vhost for accelerated guest I/O ---
CONFIG_VHOST=m
CONFIG_VHOST_NET=m
CONFIG_VHOST_SCSI=m
CONFIG_VHOST_VSOCK=m

# --- IOMMU for device passthrough ---
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_AMD_IOMMU=y
CONFIG_VFIO=m
CONFIG_VFIO_PCI=m
CONFIG_VFIO_IOMMU_TYPE1=m

# --- Huge pages for VM memory ---
CONFIG_HUGETLBFS=y
CONFIG_HUGETLB_PAGE=y
CONFIG_TRANSPARENT_HUGEPAGE=y
