# ANDYL OS -- Bare Metal Server Driver Kernel Configuration Fragment
#
# NIC drivers, storage controllers, and IPMI for physical servers.
# All built as modules (=m) since they are not boot-critical.

# --- Intel NICs ---
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IXGBE=m
CONFIG_I40E=m
CONFIG_ICE=m

# --- Mellanox/NVIDIA NICs ---
CONFIG_MLX4_CORE=m
CONFIG_MLX4_EN=m
CONFIG_MLX5_CORE=m
CONFIG_MLX5_CORE_EN=m
CONFIG_MLX5_EN_IPSEC=y

# --- Broadcom NICs ---
CONFIG_BNXT=m
CONFIG_BNX2X=m

# --- Storage controllers ---
CONFIG_MEGARAID_SAS=m
CONFIG_MPTBASE=m
CONFIG_SCSI_MPT3SAS=m
CONFIG_SCSI_SMARTPQI=m
CONFIG_SCSI_HPSA=m

# --- IPMI (server management) ---
CONFIG_IPMI_HANDLER=m
CONFIG_IPMI_DEVICE_INTERFACE=m
CONFIG_IPMI_SI=m
CONFIG_IPMI_SSIF=m
