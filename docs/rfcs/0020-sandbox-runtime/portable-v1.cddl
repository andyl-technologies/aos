; RFC-0020 portable sandbox object schemas.
; Deterministic CBOR restrictions and semantic validation in
; 09-portable-format-profile.md are normative in addition to this CDDL.

id = bytes .size 16
digest = bytes .size 32
name = bytes .size (1..255)
path = [* name]
u64 = 0..18446744073709551615
positive-u64 = 1..18446744073709551615
i64 = -9223372036854775808..9223372036854775807
feature = [namespace: text .size (1..255), major: 0..4294967295, minor: 0..4294967295]
descriptor = [media-type: text .size (1..255), algorithm: 1, digest, encoded-size: u64]

; mode contains only the low 12 permission/special bits. Node kind is separate.
metadata = [
  mode: 0..4095,
  uid: 0..4294967295,
  gid: 0..4294967295,
  mtime-seconds: i64,
  mtime-nanos: 0..999999999,
  xattrs: [* xattr],
  acl: acl / null,
]
xattr = [name: bytes, value: bytes]
acl = [* acl-entry]
acl-entry = [
  tag: 0..5, ; user-obj, named-user, group-obj, named-group, mask, other
  qualifier: 0..4294967295 / null,
  permissions: 0..7,
]

; application/vnd.aos.sandbox.directory.v1+cbor
directory-v1 = [version: 1, metadata, entries: [* directory-entry]]
directory-entry = [name, node]
node = file-node / directory-node / symlink-node
file-node = [kind: 0, metadata, content-layout, hardlink-group: digest / null]
directory-node = [kind: 1, child: descriptor]
symlink-node = [kind: 2, metadata, target: bytes]

content-layout = whole-content / sparse-content
whole-content = [kind: 0, content: descriptor]
sparse-content = [kind: 1, logical-size: u64, extents: [* extent]]
extent = [offset: u64, length: positive-u64, content: descriptor]

; application/vnd.aos.sandbox.tree.v1+cbor
tree-v1 = [version: 1, root: descriptor, required-features: [* feature]]

; application/vnd.aos.sandbox.delta.v1+cbor
delta-v1 = [
  version: 1,
  base: descriptor,
  result: descriptor,
  added-objects: [* descriptor],
  required-features: [* feature],
]

view-source = immutable-tree-source / live-export-source
immutable-tree-source = [kind: 0, tree: descriptor]
live-export-source = [
  kind: 1,
  owner-sandbox: id,
  export: id,
  source-generation: u64,
]
view-presentation-action = view-include / view-exclude / view-present
view-include = [kind: 0, source-prefix: path, destination: path]
view-exclude = [kind: 1, destination: path]
view-present = [kind: 2, destination: path, presentation-profile: feature]

; application/vnd.aos.sandbox.view.v1+cbor
view-v1 = [
  version: 1,
  source: view-source,
  presentation: [* view-presentation-action],
  consistency: 0..2, ; immutable, local-live, external-versioned
  mutation: 0..4, ; read-only, read-write, private-cow, append-only, service
  identity-presentation: feature,
  disclosure: cache-domain,
  required-features: [* feature],
]

; application/vnd.aos.sandbox.environment.v1+cbor
environment-entry = [name: text .size (1..4096), value: text .size (0..1048576)]
environment-v1 = [
  version: 1,
  closure: [* descriptor],
  variables: [* environment-entry],
  command-search-path: [* path],
  required-features: [* feature],
]

; application/vnd.aos.sandbox.optimization.v1+cbor
optimization-v1 = [version: 1, entries: [* optimization]]

; application/vnd.aos.sandbox.spec.v1+cbor
identity-profile = private-userns-identity / host-identity
private-userns-identity = [
  kind: 0,
  id-range-size: 1..4294967295,
  unmappable-policy: 0..1, ; reject, synthesize through isolated presentation
  required-features: [* feature],
]
host-identity = [kind: 1, required-features: [* feature]]
resource-profile = [limits: [* limit]]
network-profile = [
  kind: 0..4, ; isolated, project, outbound, published, host
  endpoint-ids: [* id],
  required-features: [* feature],
]
sandbox-spec-v1 = [
  version: 1,
  runtime-profile: feature,
  identity-profile,
  resource-profile,
  environment: descriptor,
  root-view: descriptor,
  attachment-slots: [* id],
  network-profile,
  required-features: [* feature],
]

; Generic policy registry values are closed for v1.
resource-kind = 0..14
; sandbox, execution, snapshot, tree, live-export, private-delta, secret,
; device, network-endpoint, ipc-service, cache-read, cache-publish,
; environment, attachment-slot, child-delegation

operation-bits = 0..32767
; bit 0 discover, 1 metadata-read, 2 content-read, 3 execute, 4 create,
; 5 content-write, 6 remove, 7 rename, 8 link, 9 metadata-write,
; 10 attach, 11 lifecycle-control, 12 delegate, 13 publish,
; 14 live-kernel-coupled-read

selector = resource-selector / tree-selector / path-selector / profile-selector
resource-selector = [kind: 0, resource: id]
tree-selector = [kind: 1, tree: descriptor]
path-selector = [kind: 2, export: id, prefix: path]
profile-selector = [kind: 3, feature, body: descriptor]

grant = [
  grant-id: id,
  resource-kind,
  operation-bits,
  selector,
  delegable: bool,
]

limit-value = inherited-limit / bounded-limit / unlimited-limit
inherited-limit = [kind: 0]
bounded-limit = [kind: 1, value: u64]
unlimited-limit = [kind: 2, authority-grant: id]
limit = [dimension: 0..31, limit-value, enforcement: feature]

view-action = include-action / exclude-action / attach-action / present-action
include-action = [kind: 0, source: id, prefix: path]
exclude-action = [kind: 1, prefix: path]
attach-action = [kind: 2, source: id, destination-slot: id, mode: 0..4]
present-action = [kind: 3, prefix: path, presentation-profile: feature]

cache-domain = [kind: 0..3, domain-id: id]
revocation = [mode: 0..2, grace-nanos: u64]
optimization = [kind: 0..7, target: selector, bounded-value: u64]
reason = [code: 0..10, source: descriptor / null]

; application/vnd.aos.sandbox.policy.v1+cbor
policy-v1 = [
  version: 1,
  required-features: [* feature],
  input-commitments: [* descriptor],
  effective-grants: [* grant],
  delegable-grants: [* grant],
  limits: [* limit],
  view-actions: [* view-action],
  cache-domain,
  revocation,
  optimization-digest: descriptor / null,
  explanation-reasons: [* reason],
]

receipt = [algorithm: 1, digest]
retention-claim = storage-retention / content-retention / nix-retention / service-retention / secret-retention
storage-retention = [
  kind: 0,
  resource: id,
  opaque-version: bytes .size (1..255),
  version-sha256: digest,
  receipt,
]
content-retention = [kind: 1, object: descriptor, receipt]
nix-retention = [kind: 2, environment: descriptor, receipt]
service-retention = [
  kind: 3,
  service: id,
  checkpoint-version: bytes .size (1..255),
  checkpoint-sha256: digest,
  receipt,
  available-until: i64 / null,
]
secret-retention = [
  kind: 4,
  issuer: id,
  secret: id,
  opaque-version: bytes .size (1..255),
  restore-scope: id,
  receipt,
  expires-seconds: i64 / null,
]
storage-checkpoint = [
  backend: feature,
  portable-state: descriptor,
]
attachment-snapshot = [view: descriptor, destination-slot: id, mode: 0..4]
external-dependency = immutable-view-dependency / package-dependency / secret-dependency / service-dependency / network-dependency
immutable-view-dependency = [kind: 0, view: descriptor, required: bool]
package-dependency = [kind: 1, environment: descriptor, required: bool]
secret-dependency = [
  kind: 2,
  issuer: id,
  secret: id,
  opaque-version: bytes .size (1..255),
  restore-scope: id,
  expires-seconds: i64 / null,
  required: bool,
]
service-dependency = [
  kind: 3,
  service: id,
  checkpoint-version: bytes .size (1..255),
  checkpoint-sha256: digest,
  available-until: i64 / null,
  required: bool,
]
network-dependency = [
  kind: 4,
  endpoint: id,
  contract-version: bytes .size (1..255),
  available-until: i64 / null,
  required: bool,
]
quiesce-evidence = no-quiesce / guest-quiesce / backend-quiesce
no-quiesce = [kind: 0]
guest-quiesce = [kind: 1, agent-version: feature, result-sha256: digest]
backend-quiesce = [kind: 2, backend: feature, result-sha256: digest]

; application/vnd.aos.sandbox.snapshot.v1+cbor
snapshot-v1 = [
  version: 1,
  sandbox-spec: descriptor,
  historical-policy: descriptor,
  ancestry: [* id],
  private-roots: [* descriptor],
  storage-checkpoints: [* storage-checkpoint],
  retention-claims: [* retention-claim],
  environment: descriptor,
  attachments: [* attachment-snapshot],
  external-dependencies: [* external-dependency],
  consistency: 0..2,
  quiesce-evidence,
  required-restore-features: [* feature],
  source-assignment: [sandbox: id, incarnation: id, epoch: u64],
]

key-reference = [
  stable-key-id: text .size (1..255),
  generation: u64,
  public-key-sha256: digest,
  usage: 0..6, ; policy, tree, snapshot, distribution, broker-plan, ownership-lease, publisher
]

; application/vnd.aos.sandbox.trust-policy.v1+cbor
trust-policy-v1 = [
  version: 1,
  trust-scope: id,
  purpose: 0..6,
  allowed-keys: [* key-reference],
  required-features: [* feature],
]

signature-statement-v1 = [
  version: 1,
  subject: descriptor,
  trust-scope: id,
  signer: key-reference,
  algorithm: 1, ; Ed25519
  purpose: 0..6,
  issued-seconds: i64,
  expires-seconds: i64 / null,
  verification-policy: descriptor,
]

; application/vnd.aos.sandbox.signature.v1+cbor
signature-v1 = [statement: signature-statement-v1, signature: bytes .size 64]

broker-assignment-v1 = [
  sandbox: id,
  incarnation: id,
  epoch: u64,
  desired-generation: u64,
  assignment-digest: digest,
]

broker-target-v1 =
  [kind: 0] /                         ; assignment
  [kind: 1, resource: bytes .size 32] /
  [kind: 2, previous: bytes .size 32, successor: bytes .size 32]

broker-grant-v1 = [
  verb: 1..28,
  target: broker-target-v1,
  argument-commitment: digest,
  maximum-request-bytes: 1..16777216,
  maximum-descriptors: 0..16,
]

; application/vnd.aos.sandbox.broker-authorization-plan.v1+cbor
broker-authorization-plan-v1 = [
  version: 1,
  audience: 0..3,                    ; host, mount, storage, network
  protocol: 0..3,                    ; matching broker protocol; no publisher code
  protocol-major: 1,
  protocol-minor: 0..2,              ; 2 only for host; other brokers at most 1
  assignment: broker-assignment-v1,
  node: id,
  ownership-authority: key-reference,
  grants: [1*1024 broker-grant-v1],
  policy-commitment: digest,
  revocation-scope: id,
  issued-seconds: i64,
  expires-seconds: i64,
  required-features: [*64 feature],
]

; Publisher plans deliberately contain no sandbox assignment or ownership lease.
; This schema commits static request/configuration facts, not online admission
; or a retained completion permit. Project publication is not public promotion.
; All authority IDs, generations, channel and authority commitments are nonzero.
; Content media type is exactly application/vnd.aos.sandbox.content.v1;
; its encoded size must not exceed maximum-bytes. Features are strictly ordered.
; application/vnd.aos.sandbox.publisher-domain-plan.v1+cbor
publisher-domain-plan-v1 = [
  version: 1,
  publisher-protocol-version: [major: 1, minor: 0],
  target: [
    principal: id,
    instance: id,
    node: id,
    project: id,
    cache-domain: [kind: 1, domain: id],
    isolation-policy: digest,
  ],
  request: [
    holder: id,
    channel: bytes .size 32,
    operation: id,
    reservation: id,
    content: descriptor,
    source-authorization: digest,
    request-commitment: digest,
    maximum-bytes: 0..9223372036854775807,
  ],
  authority: [
    policy: digest,
    policy-generation: positive-u64,
    controller-generation: positive-u64,
    revocation-scope: id,
    revocation-generation: positive-u64,
    root-registry-generation: positive-u64,
  ],
  issued-seconds: i64,
  expires-seconds: i64,
  required-features: [*64 feature],
]

; application/vnd.aos.sandbox.ownership-lease.v1+cbor
ownership-lease-v1 = [
  version: 1,
  assignment: [sandbox: id, incarnation: id, epoch: u64, assignment-digest: digest],
  node: id,
  lease-generation: 1..18446744073709551615,
  authority-issued-seconds: i64,
  authority-expires-seconds: i64,
  maximum-clock-skew-seconds: u64,
  renewal-nonce: id,
]

; application/vnd.aos.sandbox.ownership-transaction-receipt.v1
; This registered object is NOT CBOR. Its normative fixed binary layout is:
; magic "AOSOTR1\0" (8 bytes), receipt-version u16be, protocol-code u16be,
; protocol-major u16be, protocol-minor u16be, action u8, reserved zero bytes[7],
; stable-key-id-length u16be, valid UTF-8 stable-key-id bytes[1..255], authority-generation
; u64be, authority-public-key-sha256 bytes[32], request-id bytes[16],
; claim-digest bytes[32], lease-size u64be, lease-digest bytes[32].
; The exact length is therefore 155..409 bytes. CDDL does not redefine this
; byte-oriented format as a CBOR byte string.
