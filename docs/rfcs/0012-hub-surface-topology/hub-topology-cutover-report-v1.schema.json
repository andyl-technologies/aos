        "algorithm": { "const": "permission-set-subset-v1" },
        "principal_scope_count": { "type": "integer", "minimum": 1 },
        "route_count": { "type": "integer", "minimum": 1 },
        "widening_count": { "type": "integer", "minimum": 0 },
        "source_policy_digest": { "$ref": "#/$defs/sha256" },
        "target_policy_digest": { "$ref": "#/$defs/sha256" },
        "proof_digest": { "$ref": "#/$defs/sha256" },
        "result": { "enum": ["pass", "fail"] },
        "evidence": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "resourceValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_count", "actual_count", "configuration_digest", "invalid_count", "evidence"],
      "properties": {
        "expected_count": { "type": "integer", "minimum": 0 },
        "actual_count": { "type": "integer", "minimum": 0 },
        "configuration_digest": { "$ref": "#/$defs/sha256" },
        "invalid_count": { "const": 0 },
        "evidence": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "topologyValidation": {
      "type": "object",
