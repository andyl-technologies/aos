    "executionCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_resource_set_digest", "reported_resource_set_digest", "plan_check_set_digest", "reported_check_set_digest", "plan_smoke_set_digest", "reported_smoke_set_digest", "plan_database_set_digest", "reported_database_set_digest", "plan_backup_set_digest", "reported_backup_set_digest", "missing_resource_count", "unplanned_resource_count", "missing_check_count", "unplanned_check_count", "failed_check_count", "not_run_check_count", "missing_smoke_count", "unplanned_smoke_count", "failed_smoke_count", "not_run_smoke_count", "missing_database_count", "unplanned_database_count", "missing_backup_count", "unplanned_backup_count", "failed_backup_count"],
      "properties": {
        "plan_resource_set_digest": { "$ref": "#/$defs/sha256" }, "reported_resource_set_digest": { "$ref": "#/$defs/sha256" },
        "plan_check_set_digest": { "$ref": "#/$defs/sha256" }, "reported_check_set_digest": { "$ref": "#/$defs/sha256" },
        "plan_smoke_set_digest": { "$ref": "#/$defs/sha256" }, "reported_smoke_set_digest": { "$ref": "#/$defs/sha256" },
        "plan_database_set_digest": { "$ref": "#/$defs/sha256" }, "reported_database_set_digest": { "$ref": "#/$defs/sha256" },
        "plan_backup_set_digest": { "$ref": "#/$defs/sha256" }, "reported_backup_set_digest": { "$ref": "#/$defs/sha256" },
        "missing_resource_count": { "type": "integer", "minimum": 0 }, "unplanned_resource_count": { "type": "integer", "minimum": 0 },
        "missing_check_count": { "type": "integer", "minimum": 0 }, "unplanned_check_count": { "type": "integer", "minimum": 0 }, "failed_check_count": { "type": "integer", "minimum": 0 }, "not_run_check_count": { "type": "integer", "minimum": 0 },
        "missing_smoke_count": { "type": "integer", "minimum": 0 }, "unplanned_smoke_count": { "type": "integer", "minimum": 0 }, "failed_smoke_count": { "type": "integer", "minimum": 0 }, "not_run_smoke_count": { "type": "integer", "minimum": 0 },
        "missing_database_count": { "type": "integer", "minimum": 0 }, "unplanned_database_count": { "type": "integer", "minimum": 0 }, "missing_backup_count": { "type": "integer", "minimum": 0 }, "unplanned_backup_count": { "type": "integer", "minimum": 0 }, "failed_backup_count": { "type": "integer", "minimum": 0 }
      }
    },
    "typedFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "code", "failed_check_id", "evidence"],
      "properties": {
        "stage": { "enum": ["preflight", "maintenance", "backup", "transform", "validation", "pre_switch_smoke", "switch", "post_switch_smoke", "rollback"] },
        "code": { "enum": ["quiesce_failed", "backup_failed", "transform_failed", "validation_failed", "smoke_failed", "switch_failed", "rollback_failed", "digest_mismatch", "resource_set_mismatch"] },
        "failed_check_id": { "anyOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }] },
        "evidence": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "legacyAbsenceCategories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "generated", "linked_symbols", "build_features", "database", "http_rpc", "cli", "environment", "configuration", "migrations", "worker_bindings", "deployed_manifests"],
      "properties": {
        "source": { "const": 0 }, "generated": { "const": 0 }, "linked_symbols": { "const": 0 }, "build_features": { "const": 0 }, "database": { "const": 0 }, "http_rpc": { "const": 0 }, "cli": { "const": 0 }, "environment": { "const": 0 }, "configuration": { "const": 0 }, "migrations": { "const": 0 }, "worker_bindings": { "const": 0 }, "deployed_manifests": { "const": 0 }
      }
    }
