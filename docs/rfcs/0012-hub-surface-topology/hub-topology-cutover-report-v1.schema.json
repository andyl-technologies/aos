      "required": ["instances", "organizations", "projects", "surfaces", "bindings", "binding_capability_observations", "credential_generations", "binding_write_revisions", "binding_grants", "storage_defaults", "placements", "write_authorities", "endpoints", "domains", "network_policies", "gateways", "routes", "route_configurations", "placement_policies", "equivalence_sets", "registry_publications", "publication_bindings", "population_targets", "retention_subscriptions", "placement_manifests"],
      "properties": {
