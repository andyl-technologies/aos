    "inventoryValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_count", "actual_count", "configuration_digest", "invalid_count", "evidence", "incomplete_count", "weak_identity_count"],
      "properties": {
        "expected_count": { "type": "integer", "minimum": 0 },
        "actual_count": { "type": "integer", "minimum": 0 },
        "configuration_digest": { "$ref": "#/$defs/sha256" },
        "invalid_count": { "const": 0 },
        "evidence": { "$ref": "#/$defs/artifactRef" },
        "incomplete_count": { "const": 0 },
        "weak_identity_count": { "const": 0 }
      }
    },
    "smokeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_id", "surface", "route_stable_id", "placement_stable_id", "binding_stable_id", "method", "path_digest", "auth_context", "result", "status", "response_digest", "evidence_required", "evidence"],
      "properties": {
        "test_id": { "$ref": "#/$defs/stableId" },
        "surface": { "enum": ["web", "api", "cli", "git", "nix_cache"] },
        "route_stable_id": { "anyOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }] },
        "placement_stable_id": { "anyOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }] },
        "binding_stable_id": { "anyOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }] },
        "method": { "enum": ["GET", "HEAD", "POST", "CLI"] },
        "path_digest": { "$ref": "#/$defs/sha256" },
        "auth_context": { "enum": ["anonymous", "least_privileged_reader", "operator", "private_network"] },
        "result": { "enum": ["pass", "fail", "not_run"] },
        "status": { "type": "integer", "minimum": 0, "maximum": 599 },
        "response_digest": { "$ref": "#/$defs/sha256" },
        "evidence_required": { "const": true },
        "evidence": { "anyOf": [{ "$ref": "#/$defs/artifactRef" }, { "type": "null" }] }
      }
    },
    "blockerResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocker_id", "code", "resource", "resolution_check_id", "state", "resolution_evidence"],
      "properties": {
        "blocker_id": { "$ref": "#/$defs/stableId" },
        "code": { "enum": ["stable_id_collision", "ambiguous_binding", "ambiguous_write_authority", "credential_reference_missing", "url_unmapped", "auth_widening", "inventory_incomplete", "retention_stale", "backup_unverified", "legacy_surface_present", "transform_digest_mismatch", "smoke_failed"] },
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "stable_id"],
