        "target_count": { "type": "integer", "minimum": 1 },
        "mapping_count": { "type": "integer", "minimum": 1 },
        "collision_count": { "type": "integer", "minimum": 0 },
        "missing_source_count": { "type": "integer", "minimum": 0 },
        "unplanned_target_count": { "type": "integer", "minimum": 0 },
        "mapping_digest": { "$ref": "#/$defs/sha256" },
        "result": { "enum": ["pass", "fail"] },
