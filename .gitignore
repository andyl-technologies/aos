/.claude
__pycache__/
*.pyc

# Built images and QEMU artifacts
output/

# Cached source tarballs
mirror/

# Rust build artifacts
cli/target/
crates/target/

# Nix build results
result
result-*

# Direnv
.direnv/

# Wrangler local state and caches
.wrangler/

# Doc index cache
.aos-doc-cache.json

# Per-operator boot configuration that bakes in an SSH authorized_key; keep it
# out of the tree (see docs/maintainers/source-build-quickstart.md).
/tests/ignition-test.json

# crucible CLI default runtime store (main.rs --store default_value)
.crucible/
/crates/crucible/crucible-daemon/run-state/

# Dev hub state (aos-hub `serve --dev`): local db + seeded bucket.
/crates/.aos-hub/
/crates/hub/aos-hub-native/.aos-hub/
