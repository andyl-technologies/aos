/.claude
__pycache__/
*.pyc

# Built images and QEMU artifacts at the checkout root
/output/

# Cached source tarballs at the checkout root
/mirror/

# Rust build artifacts
cli/target/
crates/target/

# Nix build output links. Git treats a link as a file, so the patterns below
# match links in any directory while the negations keep real directories,
# such as Rust modules named `result`, visible as source.
result
result-*
!result/
!result-*/

# Direnv
.direnv/

# Wrangler local state and caches
.wrangler/

# Doc index cache
.aos-doc-cache.json

# Per-operator ignition config (bakes in an SSH authorized_key; see
# docs/boot/qemu-uefi.md §0 — explicitly "not checked in").
/tests/ignition-test.json

# crucible CLI default runtime store (main.rs --store default_value)
.crucible/
/crates/crucible/crucible-daemon/run-state/

# Dev hub state (aos-hub `serve --dev`): local db + seeded bucket.
/crates/.aos-hub/
/crates/hub/aos-hub-native/.aos-hub/
