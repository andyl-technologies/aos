module(name = "aos", version = "0.1.0")

# Nix supplies every module as a pinned local source repository. Dependency
# updates are explicit; ordinary launchers disable repository downloads.
bazel_dep(name = "rules_rust", version = "0.71.2")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "1.1.0")

# Generated declarations contain no fetch logic. Nix supplies hashed sources.
include("//third_party/rust:core/repositories.MODULE.bazel")
include("//third_party/rust:device/repositories.MODULE.bazel")
include("//third_party/rust:store/repositories.MODULE.bazel")
include("//third_party/rust:guest/repositories.MODULE.bazel")
include("//third_party/rust:engine/repositories.MODULE.bazel")
include("//third_party/rust:quota/repositories.MODULE.bazel")
include("//third_party/rust:session/repositories.MODULE.bazel")
include("//third_party/rust:control/repositories.MODULE.bazel")
include("//third_party/rust:qemu-host/repositories.MODULE.bazel")
include("//third_party/rust:store-s3/repositories.MODULE.bazel")
include("//third_party/rust:daemon/repositories.MODULE.bazel")
include("//third_party/rust:crucible-cli/repositories.MODULE.bazel")
include("//third_party/rust:formats/repositories.MODULE.bazel")

# Register only source-built AOS Rust tools, never upstream binary toolchains.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(versions = [])

aos_tools = use_repo_rule("//tools/bazel/toolchains:repositories.bzl", "aos_tools_repository")
aos_tools(name = "aos_tools")
aos_tools(name = "aos_native")
aos_tools(name = "aos_cli_runtime")

register_toolchains("@aos_tools//:all")
