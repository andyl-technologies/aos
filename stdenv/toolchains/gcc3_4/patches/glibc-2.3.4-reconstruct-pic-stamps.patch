--- a/Makerules
+++ b/Makerules
@@ -748,0 +749,3 @@
+# GNU make 3.79.1 otherwise removes PIC stamps as intermediates.
+.SECONDARY: $(foreach o,$(object-suffixes-for-libc),$(objpfx)stamp$o)
+
@@ -787,0 +791,3 @@
+# The parent make owns the per-subdirectory stamps and must retain them too.
+.SECONDARY: $(foreach o,$(object-suffixes-for-libc),$(subst %,$o,$(subdirs-stamps)))
+
