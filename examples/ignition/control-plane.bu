# ANDYL OS -- Kubernetes Control Plane Butane Configuration
#
# This template extends the base configuration (base.bu) with
# Kubernetes control plane-specific configuration:
#
#   - Everything from the worker template (kubelet, containerd, node labels)
#   - etcd configuration and data directory
#   - kube-apiserver, kube-controller-manager, kube-scheduler static pods
#   - Control plane TLS certificates (etcd peer, API server serving)
#   - Additional ZFS dataset: datapool/var/lib/etcd (recordsize=4K)
#
# This template assumes the machine has role "k8s-control-plane" written
# to /etc/andyl-os/role by the base template.  The ZFS setup service
# reads this role to create:
#   - datapool/var/lib/containerd (recordsize=128K, for container images)
#   - datapool/var/lib/etcd (recordsize=4K, matching etcd's bbolt pages)
#
# Variables (in addition to base.bu and worker variables):
#   ETCD_INITIAL_CLUSTER     -- etcd initial cluster members
#   ETCD_NAME                -- etcd member name (usually hostname)
#   ETCD_PEER_CERT           -- etcd peer TLS certificate (PEM)
#   ETCD_PEER_KEY            -- etcd peer TLS private key (PEM)
#   API_SERVER_CERT          -- API server serving certificate (PEM)
#   API_SERVER_KEY           -- API server serving private key (PEM)
#   SERVICE_CLUSTER_IP_RANGE -- Kubernetes service CIDR (e.g., 10.96.0.0/12)
#   POD_CIDR                 -- Pod network CIDR (e.g., 10.244.0.0/16)
#
# See:
#   RFC-0006 section 2 (Butane config examples)
#   Phase 6 section 6.7 (Role-Specific Templates)

variant: fcos
version: "1.5.0"

storage:
  directories:
    # Static pod manifests directory (kubelet watches this for
    # control plane components: apiserver, controller-manager, scheduler)
    - path: /etc/kubernetes/manifests
      mode: 0755

    # Container storage root
    - path: /var/lib/containerd
      mode: 0710

    # Kubelet state directory
    - path: /var/lib/kubelet
      mode: 0750

    # etcd data directory (ZFS dataset: recordsize=4K)
    - path: /var/lib/etcd
      mode: 0700

    # Control plane PKI directory
    - path: /etc/kubernetes/pki
      mode: 0700

    # etcd PKI directory
    - path: /etc/kubernetes/pki/etcd
      mode: 0700

  files:
    # -----------------------------------------------------------------------
    # kubelet configuration (same as worker, with control plane tweaks)
    # -----------------------------------------------------------------------

    - path: /var/lib/kubelet/config.yaml
      mode: 0644
      contents:
        inline: |
          apiVersion: kubelet.config.k8s.io/v1beta1
          kind: KubeletConfiguration
          clusterDNS:
            - CLUSTER_DNS
          clusterDomain: CLUSTER_DOMAIN
          containerRuntimeEndpoint: unix:///run/containerd/containerd.sock
          staticPodPath: /etc/kubernetes/manifests
          cgroupDriver: systemd
          authentication:
            x509:
              clientCAFile: /etc/ssl/andyl-os/ca.pem
            anonymous:
              enabled: false
            webhook:
              enabled: true
          authorization:
            mode: Webhook
          readOnlyPort: 0
          protectKernelDefaults: true
          serializeImagePulls: false
          tlsCertFile: /etc/ssl/andyl-os/node.pem
          tlsPrivateKeyFile: /etc/ssl/andyl-os/node-key.pem
          # Control plane nodes register with a taint to prevent
          # workload scheduling unless explicitly tolerated.
          registerWithTaints:
            - key: node-role.kubernetes.io/control-plane
              effect: NoSchedule

    # -----------------------------------------------------------------------
    # containerd configuration
    # -----------------------------------------------------------------------

    - path: /etc/containerd/config.toml
      mode: 0644
      contents:
        inline: |
          version = 2
          [plugins]
            [plugins."io.containerd.grpc.v1.cri"]
              sandbox_image = "registry.k8s.io/pause:3.9"
              [plugins."io.containerd.grpc.v1.cri".containerd]
                [plugins."io.containerd.grpc.v1.cri".containerd.runtimes]
                  [plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runc]
                    runtime_type = "io.containerd.runc.v2"
                    [plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runc.options]
                      SystemdCgroup = true

    # -----------------------------------------------------------------------
    # etcd configuration
    # -----------------------------------------------------------------------
    # etcd stores the Kubernetes cluster state.  Uses dedicated TLS
    # certificates for peer-to-peer and client communication.  Data
    # is stored on ZFS with recordsize=4K matching etcd's bbolt pages.

    - path: /etc/kubernetes/pki/etcd/peer.pem
      mode: 0400
      contents:
        inline: |
          ETCD_PEER_CERT

    - path: /etc/kubernetes/pki/etcd/peer-key.pem
      mode: 0400
      contents:
        inline: |
          ETCD_PEER_KEY

    - path: /etc/kubernetes/pki/apiserver.pem
      mode: 0400
      contents:
        inline: |
          API_SERVER_CERT

    - path: /etc/kubernetes/pki/apiserver-key.pem
      mode: 0400
      contents:
        inline: |
          API_SERVER_KEY

    # -----------------------------------------------------------------------
    # etcd static pod manifest
    # -----------------------------------------------------------------------
    # kubelet runs etcd as a static pod from this manifest.

    - path: /etc/kubernetes/manifests/etcd.yaml
      mode: 0644
      contents:
        inline: |
          apiVersion: v1
          kind: Pod
          metadata:
            name: etcd
            namespace: kube-system
            labels:
              component: etcd
              tier: control-plane
          spec:
            hostNetwork: true
            containers:
              - name: etcd
                image: registry.k8s.io/etcd:3.5.12-0
                command:
                  - etcd
                  - --name=ETCD_NAME
                  - --data-dir=/var/lib/etcd
                  - --listen-client-urls=https://0.0.0.0:2379
                  - --advertise-client-urls=https://HOSTNAME:2379
                  - --listen-peer-urls=https://0.0.0.0:2380
                  - --initial-advertise-peer-urls=https://HOSTNAME:2380
                  - --initial-cluster=ETCD_INITIAL_CLUSTER
                  - --initial-cluster-state=new
                  - --cert-file=/etc/kubernetes/pki/etcd/peer.pem
                  - --key-file=/etc/kubernetes/pki/etcd/peer-key.pem
                  - --trusted-ca-file=/etc/ssl/andyl-os/ca.pem
                  - --peer-cert-file=/etc/kubernetes/pki/etcd/peer.pem
                  - --peer-key-file=/etc/kubernetes/pki/etcd/peer-key.pem
                  - --peer-trusted-ca-file=/etc/ssl/andyl-os/ca.pem
                  - --client-cert-auth=true
                  - --peer-client-cert-auth=true
                volumeMounts:
                  - name: etcd-data
                    mountPath: /var/lib/etcd
                  - name: etcd-certs
                    mountPath: /etc/kubernetes/pki/etcd
                    readOnly: true
                  - name: ca-cert
                    mountPath: /etc/ssl/andyl-os
                    readOnly: true
                livenessProbe:
                  httpGet:
                    host: 127.0.0.1
                    path: /health?serializable=true
                    port: 2381
                    scheme: HTTP
                  initialDelaySeconds: 10
                  periodSeconds: 10
                  timeoutSeconds: 15
            volumes:
              - name: etcd-data
                hostPath:
                  path: /var/lib/etcd
                  type: DirectoryOrCreate
              - name: etcd-certs
                hostPath:
                  path: /etc/kubernetes/pki/etcd
                  type: DirectoryOrCreate
              - name: ca-cert
                hostPath:
                  path: /etc/ssl/andyl-os
                  type: DirectoryOrCreate

    # -----------------------------------------------------------------------
    # kube-apiserver static pod manifest
    # -----------------------------------------------------------------------

    - path: /etc/kubernetes/manifests/kube-apiserver.yaml
      mode: 0644
      contents:
        inline: |
          apiVersion: v1
          kind: Pod
          metadata:
            name: kube-apiserver
            namespace: kube-system
            labels:
              component: kube-apiserver
              tier: control-plane
          spec:
            hostNetwork: true
            containers:
              - name: kube-apiserver
                image: registry.k8s.io/kube-apiserver:v1.31.0
                command:
                  - kube-apiserver
                  - --advertise-address=IP_ADDRESS_BARE
                  - --etcd-servers=https://127.0.0.1:2379
                  - --etcd-cafile=/etc/ssl/andyl-os/ca.pem
                  - --etcd-certfile=/etc/kubernetes/pki/etcd/peer.pem
                  - --etcd-keyfile=/etc/kubernetes/pki/etcd/peer-key.pem
                  - --tls-cert-file=/etc/kubernetes/pki/apiserver.pem
                  - --tls-private-key-file=/etc/kubernetes/pki/apiserver-key.pem
                  - --client-ca-file=/etc/ssl/andyl-os/ca.pem
                  - --service-cluster-ip-range=SERVICE_CLUSTER_IP_RANGE
                  - --service-account-key-file=/etc/kubernetes/pki/apiserver.pem
                  - --service-account-signing-key-file=/etc/kubernetes/pki/apiserver-key.pem
                  - --service-account-issuer=https://HOSTNAME:6443
                  - --authorization-mode=Node,RBAC
                  - --enable-bootstrap-token-auth=true
                  - --kubelet-certificate-authority=/etc/ssl/andyl-os/ca.pem
                  - --kubelet-client-certificate=/etc/kubernetes/pki/apiserver.pem
                  - --kubelet-client-key=/etc/kubernetes/pki/apiserver-key.pem
                volumeMounts:
                  - name: k8s-certs
                    mountPath: /etc/kubernetes/pki
                    readOnly: true
                  - name: ca-cert
                    mountPath: /etc/ssl/andyl-os
                    readOnly: true
            volumes:
              - name: k8s-certs
                hostPath:
                  path: /etc/kubernetes/pki
              - name: ca-cert
                hostPath:
                  path: /etc/ssl/andyl-os

systemd:
  units:
    # Node labels for control plane
    - name: kubelet-node-labels.service
      enabled: true
      contents: |
        [Unit]
        Description=Set Kubernetes control plane node labels
        After=kubelet.service
        Requires=kubelet.service

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        Restart=on-failure
        RestartSec=10s

        ExecStart=/usr/bin/bash -c '\
          HOSTNAME=$(cat /etc/hostname); \
          REGION=$(cat /etc/andyl-os/zone.json | grep region | cut -d\" -f4); \
          ZONE=$(cat /etc/andyl-os/zone.json | grep zone | head -1 | cut -d\" -f4); \
          RACK=$(cat /etc/andyl-os/zone.json | grep rack | cut -d\" -f4); \
          /usr/bin/kubectl label node "$HOSTNAME" \
            topology.kubernetes.io/region="$REGION" \
            topology.kubernetes.io/zone="$ZONE" \
            node-role.kubernetes.io/control-plane="" \
            node.andyl.internal/role=k8s-control-plane \
            node.andyl.internal/rack="$RACK" \
            --overwrite'

        [Install]
        WantedBy=multi-user.target
