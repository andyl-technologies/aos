# ANDYL OS -- Kubernetes Worker Node Butane Configuration
#
# This template extends the base configuration (base.bu) with
# Kubernetes worker-specific configuration:
#
#   - kubelet configuration (cluster DNS, container runtime, cgroup driver)
#   - kubelet bootstrap kubeconfig (for cluster join via TLS bootstrapping)
#   - containerd configuration drop-in
#   - Kubernetes manifests directory (for static pods)
#   - Container storage directory (/var/lib/containerd)
#   - Node labels service (sets topology and role labels)
#
# This template assumes the machine has role "k8s-worker" written to
# /etc/andyl-os/role by the base template.  The ZFS setup service
# reads this role to create the containerd dataset with recordsize=128K.
#
# Variables (in addition to base.bu variables):
#   CLUSTER_DNS       -- Kubernetes cluster DNS IP (e.g., 10.96.0.10)
#   CLUSTER_DOMAIN    -- Kubernetes cluster domain (e.g., cluster.local)
#   BOOTSTRAP_TOKEN   -- Kubernetes bootstrap token for TLS bootstrapping
#   API_SERVER        -- Kubernetes API server URL
#
# See:
#   RFC-0006 section 2 (example worker Butane config)
#   Phase 6 section 6.7 (Role-Specific Templates)

variant: fcos
version: "1.5.0"

storage:
  directories:
    # Static pod manifests directory (kubelet watches this)
    - path: /etc/kubernetes/manifests
      mode: 0755

    # Container storage root (ZFS dataset: recordsize=128K)
    - path: /var/lib/containerd
      mode: 0710

    # Kubelet state directory
    - path: /var/lib/kubelet
      mode: 0750

  files:
    # -----------------------------------------------------------------------
    # kubelet configuration
    # -----------------------------------------------------------------------
    # KubeletConfiguration for this worker node.  Uses systemd cgroup
    # driver (matching containerd), connects to the cluster DNS service,
    # and reads static pod manifests from /etc/kubernetes/manifests.

    - path: /var/lib/kubelet/config.yaml
      mode: 0644
      contents:
        inline: |
          apiVersion: kubelet.config.k8s.io/v1beta1
          kind: KubeletConfiguration
          clusterDNS:
            - CLUSTER_DNS
          clusterDomain: CLUSTER_DOMAIN
          containerRuntimeEndpoint: unix:///run/containerd/containerd.sock
          staticPodPath: /etc/kubernetes/manifests
          cgroupDriver: systemd
          authentication:
            x509:
              clientCAFile: /etc/ssl/andyl-os/ca.pem
            anonymous:
              enabled: false
            webhook:
              enabled: true
          authorization:
            mode: Webhook
          readOnlyPort: 0
          protectKernelDefaults: true
          serializeImagePulls: false
          tlsCertFile: /etc/ssl/andyl-os/node.pem
          tlsPrivateKeyFile: /etc/ssl/andyl-os/node-key.pem

    # -----------------------------------------------------------------------
    # kubelet bootstrap kubeconfig
    # -----------------------------------------------------------------------
    # Used by kubelet to perform TLS bootstrapping: the node presents
    # the bootstrap token to the API server, which issues a signed
    # certificate for the node.  After bootstrapping, kubelet uses
    # the issued certificate for subsequent API server communication.

    - path: /var/lib/kubelet/bootstrap-kubeconfig
      mode: 0600
      contents:
        inline: |
          apiVersion: v1
          kind: Config
          clusters:
            - cluster:
                server: API_SERVER
                certificate-authority: /etc/ssl/andyl-os/ca.pem
              name: andyl-os
          contexts:
            - context:
                cluster: andyl-os
                user: kubelet-bootstrap
              name: bootstrap
          current-context: bootstrap
          users:
            - name: kubelet-bootstrap
              user:
                token: BOOTSTRAP_TOKEN

    # -----------------------------------------------------------------------
    # containerd configuration drop-in
    # -----------------------------------------------------------------------
    # Extends the base containerd config with worker-specific settings.
    # Ensures the SystemdCgroup driver is used (matching kubelet config).

    - path: /etc/containerd/config.toml
      mode: 0644
      contents:
        inline: |
          version = 2
          [plugins]
            [plugins."io.containerd.grpc.v1.cri"]
              sandbox_image = "registry.k8s.io/pause:3.9"
              [plugins."io.containerd.grpc.v1.cri".containerd]
                [plugins."io.containerd.grpc.v1.cri".containerd.runtimes]
                  [plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runc]
                    runtime_type = "io.containerd.runc.v2"
                    [plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runc.options]
                      SystemdCgroup = true

systemd:
  units:
    # -----------------------------------------------------------------------
    # Kubernetes node labels service
    # -----------------------------------------------------------------------
    # Sets topology and role labels on the Kubernetes node after
    # kubelet has registered.  Labels include region, zone, rack,
    # and role from the Ignition-written zone.json metadata.
    #
    # This runs after kubelet.service and retries on failure (the
    # node may not be immediately ready after kubelet starts).

    - name: kubelet-node-labels.service
      enabled: true
      contents: |
        [Unit]
        Description=Set Kubernetes node labels
        After=kubelet.service
        Requires=kubelet.service

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        Restart=on-failure
        RestartSec=10s

        # Read zone metadata written by Ignition.
        ExecStart=/usr/bin/bash -c '\
          HOSTNAME=$(cat /etc/hostname); \
          ROLE=$(cat /etc/andyl-os/role); \
          REGION=$(cat /etc/andyl-os/zone.json | grep region | cut -d\" -f4); \
          ZONE=$(cat /etc/andyl-os/zone.json | grep zone | head -1 | cut -d\" -f4); \
          RACK=$(cat /etc/andyl-os/zone.json | grep rack | cut -d\" -f4); \
          /usr/bin/kubectl label node "$HOSTNAME" \
            topology.kubernetes.io/region="$REGION" \
            topology.kubernetes.io/zone="$ZONE" \
            node.andyl.internal/role="$ROLE" \
            node.andyl.internal/rack="$RACK" \
            --overwrite'

        [Install]
        WantedBy=multi-user.target
