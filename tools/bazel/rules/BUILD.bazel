load("@rules_rust//rust:defs.bzl", "rust_lint_config")
load(":profiles.bzl", "dependency_profile", "device_profile_required")

device_profile_required(
    name = "device_profile_required",
    visibility = ["//visibility:public"],
)

dependency_profile(
    name = "dependency_profile",
    build_setting_default = "core",
    visibility = ["//visibility:public"],
)

config_setting(
    name = "device_dependencies",
    flag_values = {":dependency_profile": "device"},
    visibility = ["//visibility:public"],
)

exports_files(["compile.bzl", "crates.bzl", "license.bzl", "package.bzl", "rust_package.bzl", "test.bzl", "generated.bzl"])

exports_files(["clippy.toml", "rustfmt.toml"])

# Mirrors crates/Cargo.toml while Cargo remains the migration oracle.
rust_lint_config(
    name = "workspace_lints",
    visibility = ["//visibility:public"],
    clippy = {
        "all": "deny",
        "disallowed_methods": "deny",
        "disallowed_types": "deny",
        "expect_used": "deny",
        "float_arithmetic": "deny",
        "unwrap_used": "deny",
    },
)
