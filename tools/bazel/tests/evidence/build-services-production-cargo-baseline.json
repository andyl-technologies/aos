  "recipe": "let\n  root = /home/dylan/src/aos/.worktrees/codex/bazel-integration-722;\n  pkgs = (import root {}).pkgs;\nin pkgs.mkDerivation {\n  pname = \"aos-bazel-build-services-production-cargo-baseline\";\n  version = \"1\";\n  src = import (root + \"/pkgs/tools/crucible/_cargo-source.nix\") {\n    inherit (pkgs) lib;\n    extraPaths = [\"api/proto/aos/cache/v1/cache.proto\" \"api/proto/aos/build/v1/build.proto\" \"api/proto/aos/gc/v1/gc.proto\" \"api/proto/aos/auth/v1/auth.proto\"];\n  };\n  buildDeps = [pkgs.rust pkgs.sed pkgs.python3 pkgs.pkg-config pkgs.protobuf];\n  runtimeDeps = [pkgs.openssl pkgs.zlib pkgs.sqlite pkgs.zstd];\n  sharedBuildCache = false;\n  dontStrip = true;\n  dontPatchELF = true;\n  dontNukeRefs = true;\n  phases = [{\n    name = \"compile\";\n    script = ''\n      cp -R \"$src\" source\n      chmod -R u+w source\n      cd source\n      export CARGO_HOME=\"$TMPDIR/cargo\" CARGO_TARGET_DIR=\"$TMPDIR/target\"\n      mkdir -p \"$CARGO_HOME\" .cargo \"$out\"\n      sed 's|@vendor@|${pkgs.aos.passthru.cargoDeps}|g' \\\n        ${pkgs.aos.passthru.cargoDeps}/.cargo/config.toml > .cargo/config.toml\n      export PROTOC=\"${pkgs.protobuf}/bin/protoc\"\n      export PROTOC_INCLUDE=\"${pkgs.protobuf}/include\"\n      cargo build --frozen --offline --manifest-path crates/Cargo.toml --lib \\\n        -p aos-build-api -p aos-build-client -p aos-build-server --jobs \"$NIX_BUILD_CORES\" \\\n        --message-format=json > \"$out/cargo-messages.jsonl\"\n      ${pkgs.python3}/bin/python3 - \"$out\" <<'PYGEN'\n      import json\n      from pathlib import Path\n      import shutil\n      import sys\n\n      output = Path(sys.argv[1])\n      generated = output / \"generated-api\"\n      events = [json.loads(line) for line in (output / \"cargo-messages.jsonl\").read_text().splitlines()]\n      scripts = [event for event in events if event.get(\"reason\") == \"build-script-executed\" and \"aos-build-api\" in event[\"package_id\"]]\n      assert len(scripts) == 1\n      shutil.copytree(scripts[0][\"out_dir\"], generated)\n      assert (generated / \"_connectrpc.rs\").is_file()\n      PYGEN\n    '';\n  }];\n}\n",
