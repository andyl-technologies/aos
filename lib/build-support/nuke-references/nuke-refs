#! @shell@
# nuke-refs [-e <storePath>]... <file>...
#
# Replaces every /nix/store/<32-char hash>- prefix in each file with
# /nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-, except for the hashes
# named via `-e`. Fixed-size writes preserve binary and archive structure.
set -eu
keep=""
while getopts e: o; do
  case "$o" in
    e)
      path_hash=${OPTARG#/nix/store/}
      h=${path_hash%%-*}
      case "$OPTARG" in
        /nix/store/*-*) ;;
        *) h="" ;;
      esac
      case "$h" in
        *[!a-z0-9]*) h="" ;;
      esac
      [ "${#h}" -eq 32 ] || {
        echo "nuke-refs: -e needs a store path" >&2
        exit 1
      }
      keep="${keep:+$keep }$h"
      ;;
  esac
done
shift $((OPTIND - 1))

for f in "$@"; do
  [ -L "$f" ] && continue
  [ -f "$f" ] || continue
  set +e
  matches=$(LC_ALL=C @grep@ -aobE '/nix/store/[a-z0-9]{32}-' -- "$f")
  status=$?
  set -e
  [ "$status" -le 1 ] || exit "$status"
  [ -n "$matches" ] || continue

  original_mode=$(@stat@ -c %a -- "$f")
  @chmod@ u+w -- "$f"

  while IFS=: read -r offset reference; do
    path_hash=${reference#/nix/store/}
    h=${path_hash%-}
    case " $keep " in
      *" $h "*) continue ;;
    esac

    hash_offset=$((offset + 11))
    printf '%s' eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee \
      | @dd@ of="$f" bs=1 seek="$hash_offset" count=32 conv=notrunc status=none
  done <<EOF
$matches
EOF

  @chmod@ "$original_mode" -- "$f"
done
