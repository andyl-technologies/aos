##! modules/security/fail2ban.nix — Fail2ban intrusion prevention module
##!
##! Configures fail2ban to monitor log files for authentication failures and
##! ban offending IP addresses. Generates the jail configuration file and the
##! fail2ban systemd service unit. The default configuration includes an SSH
##! jail that monitors sshd authentication failures.
##!
##! Options under aos.security.fail2ban:
##!   enable, maxRetry, banTime, findTime, ignoreIPs, jails
{
  config,
  pkgs,
  lib,
  ...
}:
let
  cfg = config.aos.security.fail2ban;

  # Format the list of ignored IPs for the jail.local config.
  ignoreIPsStr = builtins.concatStringsSep " " cfg.ignoreIPs;

  # Format individual jail sections from the jails attrset.
  jailSections = builtins.concatStringsSep "\n" (
    lib.mapAttrsToList (
      name: jailCfg:
      let
        # Convert each jail attribute to key = value lines.
        jailLines = lib.mapAttrsToList (key: value: "${key} = ${toString value}") jailCfg;
      in
      ''
        [${name}]
        ${builtins.concatStringsSep "\n" jailLines}
      ''
    ) cfg.jails
  );

  # Full jail.local configuration file.
  jailLocalText = ''
    # /etc/fail2ban/jail.local — generated by modules/security/fail2ban.nix
    # Do not edit manually.

    [DEFAULT]
    maxretry = ${toString cfg.maxRetry}
    bantime = ${cfg.banTime}
    findtime = ${cfg.findTime}
    ignoreip = ${ignoreIPsStr}

    ${jailSections}
  '';
in
{
  options.aos.security.fail2ban = {
    ## Enable the fail2ban intrusion prevention system.
    ##
    ## # Examples
    ## ```nix
    ## aos.security.fail2ban.enable = true;
    ## ```
    ##
    ## # See Also
    ## - `aos.security.fail2ban.maxRetry`, `aos.security.fail2ban.banTime`
    enable = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = ''
        Enable the fail2ban intrusion prevention system. When enabled, fail2ban
        monitors log files for repeated authentication failures and temporarily
        bans offending IP addresses using the firewall.
      '';
    };

    ## Number of authentication failures before an IP is banned.
    maxRetry = lib.mkOption {
      type = lib.types.int;
      default = 5;
      description = ''
        Number of authentication failures allowed before an IP address is
        banned. Lower values are more aggressive but may cause false positives.
      '';
    };

    ## Duration for which an offending IP address is banned.
    banTime = lib.mkOption {
      type = lib.types.str;
      default = "1h";
      description = ''
        Duration for which an offending IP address is banned. Accepts
        fail2ban time format: "10m", "1h", "1d", etc.
      '';
    };

    ## Time window in which maxRetry failures trigger a ban.
    findTime = lib.mkOption {
      type = lib.types.str;
      default = "10m";
      description = ''
        Time window in which maxRetry failures must occur to trigger a ban.
        If an IP exceeds maxRetry failures within findTime, it is banned.
      '';
    };

    ## IP addresses or CIDR ranges that are never banned.
    ignoreIPs = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [ "127.0.0.1/8" ];
      description = ''
        List of IP addresses or CIDR ranges that are never banned.
        The loopback range should always be included to prevent
        self-lockout.
      '';
    };

    ## Fail2ban jail definitions.
    ##
    ## # Examples
    ## ```nix
    ## aos.security.fail2ban.jails.sshd = { enabled = true; };
    ## ```
    jails = lib.mkOption {
      type = lib.types.attrsOf lib.types.anything;
      default = {
        sshd = {
          enabled = true;
        };
      };
      description = ''
        Attribute set of fail2ban jail definitions. Each key is the jail name
        and each value is an attribute set of jail configuration parameters.
        The default includes an SSH jail that monitors sshd log entries for
        authentication failures.
      '';
    };
  };

  config = lib.mkIf cfg.enable {
    environment.systemPackages = [ pkgs.fail2ban ];

    # /etc/fail2ban/jail.local — jail configuration.
    # Fail2ban reads this file to determine which services to monitor
    # and what action to take on repeated failures.
    environment.etc."fail2ban/jail.local" = {
      text = jailLocalText;
    };

    # fail2ban.service — the fail2ban daemon.
    # Monitors log files and bans IPs that exceed the failure threshold.
    systemd.services."fail2ban" = {
      description = "Fail2ban Intrusion Prevention";
      wantedBy = [ "multi-user.target" ];
      after = [
        "network.target"
        "nftables.service"
      ];
      serviceConfig = {
        Type = "forking";
        ExecStart = "${pkgs.fail2ban}/bin/fail2ban-server -xf start";
        ExecStop = "${pkgs.fail2ban}/bin/fail2ban-server stop";
        ExecReload = "${pkgs.fail2ban}/bin/fail2ban-server reload";
        Restart = "on-failure";
        RestartSec = "5s";
        # Security hardening for the fail2ban process itself.
        ProtectSystem = "strict";
        ProtectHome = true;
        ReadWritePaths = [
          "/var/run/fail2ban"
          "/var/lib/fail2ban"
          "/var/log/fail2ban"
        ];
      };
    };

    # Ensure fail2ban runtime directories exist.
    environment.etc."tmpfiles.d/aos-fail2ban.conf" = {
      text = ''
        # Ensure fail2ban directories exist with correct permissions.
        d /var/run/fail2ban 0755 root root -
        d /var/lib/fail2ban 0755 root root -
        d /var/log/fail2ban 0755 root root -
      '';
    };
  };
}
