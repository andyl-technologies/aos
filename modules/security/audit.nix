##! modules/security/audit.nix — Linux audit framework module
##!
##! Configures auditd for system call auditing. Generates the audit rules
##! file and the auditd systemd service. The default rules cover the CIS
##! benchmark requirements: execve logging, module loading, mount operations,
##! user/group modifications, SELinux policy changes, and sensitive file access.
##!
##! Absorbed TOML config values:
##!   [security.audit] enable, rules, backlog_limit, failure_mode
{
  config,
  pkgs,
  lib,
  ...
}: let
  cfg = config.aos.security.audit;

  # Format the audit rules file.
  # `-D` removed from the head — on kernels with preexisting audit
  # rules installed by systemd/dbus/SELinux during boot, deleting
  # them leaves the subsystem in a state where subsequent syscall
  # rule adds return EINVAL ("Error sending add rule data request").
  # Our audit-rules.service loads cleanly against an empty ruleset.
  auditRulesText = ''
    ## /etc/audit/audit.rules — generated by modules/security/audit.nix
    ## Do not edit manually.

    ## Set the backlog buffer size.
    -b ${toString cfg.backlogLimit}

    ## Set the failure mode (0=silent, 1=printk, 2=panic).
    -f ${toString cfg.failureMode}

    ## User-defined audit rules:
    ${builtins.concatStringsSep "\n" cfg.rules}
  '';
in {
  options.aos.security.audit = {
    ## Enable the Linux audit framework (auditd).
    ##
    ## Required for CIS compliance and security monitoring.
    ##
    ## # See Also
    ## - `aos.security.audit.rules`, `aos.security.audit.backlogLimit`
    enable = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Enable the Linux audit framework (auditd). When enabled, the kernel
        records system calls and events matching the configured rules.
        Required for CIS compliance and security monitoring.
        Enabled by default for production security.
      '';
    };

    ## Audit rules in auditctl(8) format.
    ##
    ## The defaults cover CIS benchmark recommendations for system call
    ## auditing, file integrity monitoring, and security event logging.
    ##
    ## # Examples
    ## ```nix
    ## aos.security.audit.rules = [
    ##   "-a always,exit -F arch=b64 -S execve -k exec"
    ## ];
    ## ```
    rules = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [
        # Execution auditing — log all execve calls.
        "-a always,exit -F arch=b64 -S execve -k exec"

        # Kernel module loading — detect unauthorized module insertion.
        "-a always,exit -F arch=b64 -S init_module -S finit_module -S delete_module -k modules"

        # Mount operations — detect filesystem mount/unmount.
        "-a always,exit -F arch=b64 -S mount -S umount2 -k mounts"

        # User and group modifications.
        "-w /etc/passwd -p wa -k user_modification"
        "-w /etc/group -p wa -k group_modification"
        "-w /etc/shadow -p wa -k shadow_modification"
        "-w /etc/gshadow -p wa -k gshadow_modification"

        # SELinux policy changes.
        "-w /etc/selinux/ -p wa -k selinux_policy"

        # Network configuration changes.
        "-a always,exit -F arch=b64 -S sethostname -S setdomainname -k network_config"
        "-w /etc/hostname -p wa -k network_config"

        # Sensitive file access.
        "-w /etc/ssh/sshd_config -p wa -k sshd_config"
        "-w /var/log/audit/ -p wa -k audit_log"
        "-w /etc/sudoers -p wa -k sudoers"
        "-w /etc/sudoers.d/ -p wa -k sudoers"

        # Time changes — detect clock manipulation.
        "-a always,exit -F arch=b64 -S adjtimex -S settimeofday -k time_change"
        "-w /etc/localtime -p wa -k time_change"
      ];
      description = ''
        List of audit rules in auditctl(8) format. Each string is one rule
        line. The defaults cover CIS benchmark recommendations for system
        call auditing, file integrity monitoring, and security-relevant
        event logging.
      '';
    };

    ## Kernel audit backlog buffer size.
    backlogLimit = lib.mkOption {
      type = lib.types.int;
      default = 8192;
      description = ''
        Kernel audit backlog buffer size. Increase if audit events are
        being dropped under heavy load. The kernel queues events in this
        buffer before auditd reads them.
      '';
    };

    ## Action when the audit system fails (0=silent, 1=printk, 2=panic).
    failureMode = lib.mkOption {
      type = lib.types.int;
      default = 1;
      description = ''
        Action to take when the audit system fails:
        0 = silent (discard events)
        1 = printk (log to kernel ring buffer)
        2 = panic (halt the system — use for high-security environments)
      '';
    };
  };

  config = lib.mkIf cfg.enable {
    # Enable the kernel audit subsystem at boot. CONFIG_AUDITSYSCALL=y
    # compiles the code in, but syscall-level rules
    # (`-a always,exit -F arch=b64 -S …`) are only accepted by the
    # kernel when `audit=1` appears on the command line. Without it
    # auditctl rejects those rules with EINVAL (observed on rules for
    # execve / init_module / mount / sethostname / adjtimex).
    aos.boot.kernelParams = ["audit=1"];

    system.checks.audit = {
      description = "Audit daemon checks";
      checks = [
        {
          name = "auditd-active";
          description = "auditd service is active";
          script = ''
            vm.succeed("systemctl is-active auditd")
          '';
        }
        {
          name = "audit-rules";
          description = "Audit rules file exists";
          script = ''
            vm.succeed("test -f /etc/audit/audit.rules")
          '';
        }
      ];
    };

    # /etc/audit/audit.rules — audit rule definitions.
    # Loaded by auditd on startup via auditctl.
    environment.etc."audit/audit.rules" = {
      text = auditRulesText;
    };

    # /etc/audit/auditd.conf — auditd daemon configuration.
    #
    # `mode = "0640"` (not the default "symlink") because auditd opens
    # its config with `open(..., O_RDONLY|O_NOFOLLOW)` — a deliberate
    # security check that refuses symlinked configs. The default
    # symlink representation in the composefs /etc image makes the
    # kernel return ELOOP, which auditd reports as "Too many levels
    # of symbolic links" before exiting with status=6 NOTCONFIGURED.
    # Octal-mode entries land as real files in `etc-basedir` and are
    # served through overlayfs metacopy, satisfying O_NOFOLLOW.
    environment.etc."audit/auditd.conf" = {
      mode = "0640";
      text = ''
        # /etc/audit/auditd.conf — generated by modules/security/audit.nix
        log_file = /var/log/audit/audit.log
        log_format = ENRICHED
        log_group = root
        priority_boost = 4
        flush = INCREMENTAL_ASYNC
        freq = 50
        num_logs = 5
        max_log_file = 50
        max_log_file_action = ROTATE
        space_left = 75
        space_left_action = SYSLOG
        admin_space_left = 50
        admin_space_left_action = SUSPEND
        disk_full_action = SUSPEND
        disk_error_action = SUSPEND
      '';
    };

    # auditd.service — the audit daemon.
    systemd.services."auditd" = {
      description = "Linux Audit Daemon";
      wantedBy = ["multi-user.target"];
      reloadIfChanged = true;
      after = [
        "local-fs.target"
        "systemd-tmpfiles-setup.service"
      ];
      serviceConfig = {
        # `Type=simple` with `-n` matches how modern systemd docs
        # recommend running daemons: the main process stays in the
        # foreground, systemd tracks its PID directly, no double-fork
        # race to get wrong.
        Type = "simple";
        ExecStart = "${pkgs.audit}/sbin/auditd -n";
        ExecReload = "${pkgs.coreutils}/bin/kill -HUP $MAINPID";
        Restart = "on-failure";
        RestartSec = "5s";
      };
    };

    # Rule-loading in a separate unit so a bad rule doesn't kill
    # auditd itself. Matches Fedora/RHEL's audit-rules.service design.
    #
    # `auditctl -R <file>` aborts on the first rule that errors —
    # there's no native per-rule tolerance flag. We iterate line by
    # line via a shell wrapper and log each rejection individually.
    # The service stays "active (exited)" regardless so auditd stays
    # clean in `systemctl --failed`.
    systemd.services."audit-rules" = {
      description = "Load Audit Rules";
      wantedBy = ["multi-user.target"];
      after = ["auditd.service"];
      requires = ["auditd.service"];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
      };
      script = ''
        rules=/etc/audit/audit.rules
        fail=0
        ok=0
        while IFS= read -r line; do
          # Skip blank lines and comments.
          [ -z "$line" ] && continue
          [ "''${line#\#}" != "$line" ] && continue
          err=$(${pkgs.audit}/sbin/auditctl $line 2>&1 >/dev/null) && rc=0 || rc=$?
          if [ "$rc" -eq 0 ]; then
            ok=$((ok + 1))
          else
            fail=$((fail + 1))
            echo "audit-rules: rejected [$rc]: $line -- $err"
          fi
        done < "$rules"
        echo "audit-rules: loaded $ok rule(s), rejected $fail"
      '';
    };

    # Ensure the audit log directory exists.
    environment.etc."tmpfiles.d/aos-audit.conf" = {
      text = ''
        # Ensure audit log directory exists with correct permissions.
        d /var/log/audit 0700 root root -
      '';
    };
  };
}
