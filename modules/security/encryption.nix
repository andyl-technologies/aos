# modules/security/encryption.nix — Encryption at rest module
#
# Configures LUKS-based disk encryption for block devices. Generates the
# /etc/crypttab entry for the encrypted device and provides configuration
# for the encryption cipher, key size, and key file. This module integrates
# with systemd-cryptsetup to unlock encrypted volumes during boot.
#
# Options under aos.security.encryption:
#   enable, device, keyFile, cipher, keySize

{
  config,
  pkgs,
  lib,
  ...
}:

let
  cfg = config.aos.security.encryption;

  # Generate the crypttab entry for the encrypted device.
  # Format: <name> <device> <key-file> <options>
  crypttabEntry =
    let
      keyField = if cfg.keyFile != "" then cfg.keyFile else "none";
      options = "luks,cipher=${cfg.cipher},size=${toString cfg.keySize}";
    in
    "encrypted ${cfg.device} ${keyField} ${options}";

  # Crypttab configuration file.
  crypttabText = ''
    # /etc/crypttab — generated by modules/security/encryption.nix
    # Do not edit manually.
    #
    # <name>      <device>    <key-file>    <options>
    ${crypttabEntry}
  '';

in
{
  options.aos.security.encryption = {
    enable = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = ''
        Enable disk encryption at rest using LUKS. When enabled, the
        specified block device is treated as a LUKS-encrypted volume
        and unlocked during boot via systemd-cryptsetup.
      '';
    };

    device = lib.mkOption {
      type = lib.types.str;
      default = "";
      description = ''
        Block device path for the LUKS-encrypted volume (e.g.,
        "/dev/vda2", "/dev/sda3"). This is the raw encrypted device
        that will be unlocked to create /dev/mapper/encrypted.
      '';
    };

    keyFile = lib.mkOption {
      type = lib.types.str;
      default = "";
      description = ''
        Path to the LUKS key file for automatic unlocking. If empty,
        a passphrase prompt will be presented during boot. For
        automated environments, point this to a key file provisioned
        via Ignition or a TPM-sealed key.
      '';
    };

    cipher = lib.mkOption {
      type = lib.types.str;
      default = "aes-xts-plain64";
      description = ''
        Encryption cipher specification for LUKS. The default
        "aes-xts-plain64" uses AES in XTS mode, which is the
        standard for full-disk encryption and provides protection
        against watermarking attacks.
      '';
    };

    keySize = lib.mkOption {
      type = lib.types.int;
      default = 512;
      description = ''
        Encryption key size in bits. For AES-XTS, this is split
        between the encryption key and the tweak key (e.g., 512 bits
        yields two 256-bit keys). 512 is the recommended default for
        AES-256-XTS.
      '';
    };
  };

  config = lib.mkIf cfg.enable {
    environment.systemPackages = [ pkgs.cryptsetup ];

    # /etc/crypttab — encrypted volume definitions.
    # Read by systemd-cryptsetup-generator to create units that unlock
    # encrypted volumes during boot.
    environment.etc."crypttab" = {
      text = crypttabText;
    };

    # /etc/cryptsetup-keys.d/ directory for key material.
    # systemd-cryptsetup looks here for key files by default.
    environment.etc."tmpfiles.d/aos-cryptsetup.conf" = {
      text = ''
        # Ensure cryptsetup key directory exists with restrictive permissions.
        d /etc/cryptsetup-keys.d 0700 root root -
      '';
    };

    # Include dm-crypt kernel module in the initrd so encrypted
    # volumes can be unlocked before the root filesystem is mounted.
    aos.boot.initrd.modules = [
      "virtio_blk"
      "virtio_pci"
      "ext4"
      "overlay"
      "dm_crypt"
    ];
  };
}
