# modules/security/ssh.nix — Hardened SSH configuration module
#
# Generates /etc/ssh/sshd_config with security-hardened defaults:
# key-only authentication, restricted ciphers/KEX/MACs, no root password
# login. Follows Mozilla "Modern" SSH configuration guidelines.
#
# Absorbed TOML config values:
#   [services.ssh] enable, port, permit_root_login, password_auth
#   [services.ssh] kbd_interactive_auth, x11_forwarding, max_auth_tries
#   [services.ssh] ciphers, kex_algorithms, macs, authorized_keys_file

{ config, pkgs, lib, ... }:

let
  cfg = config.aos.services.ssh;

  sshdConfig = ''
    # /etc/ssh/sshd_config — generated by modules/security/ssh.nix
    # Hardened OpenSSH server configuration. Do not edit manually.

    # Listening address and port.
    Port ${toString cfg.port}
    AddressFamily any
    ListenAddress 0.0.0.0
    ListenAddress ::

    # Host keys (ed25519 preferred, RSA as fallback).
    HostKey /etc/ssh/ssh_host_ed25519_key
    HostKey /etc/ssh/ssh_host_rsa_key

    # Authentication.
    PermitRootLogin ${cfg.permitRootLogin}
    PasswordAuthentication ${if cfg.passwordAuthentication then "yes" else "no"}
    KbdInteractiveAuthentication ${if cfg.kbdInteractiveAuthentication then "yes" else "no"}
    PubkeyAuthentication yes
    AuthorizedKeysFile ${cfg.authorizedKeysFile}
    MaxAuthTries ${toString cfg.maxAuthTries}

    # Disable unused authentication methods.
    ChallengeResponseAuthentication no
    GSSAPIAuthentication no
    HostbasedAuthentication no
    PermitEmptyPasswords no

    # Cryptographic algorithm restrictions (Mozilla Modern).
    Ciphers ${builtins.concatStringsSep "," cfg.allowedCiphers}
    KexAlgorithms ${builtins.concatStringsSep "," cfg.allowedKexAlgorithms}
    MACs ${builtins.concatStringsSep "," cfg.allowedMACs}

    # Session settings.
    X11Forwarding ${if cfg.x11Forwarding then "yes" else "no"}
    PrintMotd no
    PrintLastLog yes
    TCPKeepAlive yes
    UseDNS no

    # Security settings.
    StrictModes yes
    PermitUserEnvironment no
    AllowAgentForwarding no
    AllowTcpForwarding no
    PermitTunnel no
    MaxSessions 10
    MaxStartups 10:30:60
    LoginGraceTime 30

    # Logging.
    SyslogFacility AUTH
    LogLevel VERBOSE

    # Use the internal SFTP server.
    Subsystem sftp /usr/libexec/sftp-server

    # Client keepalive to detect dead connections.
    ClientAliveInterval 300
    ClientAliveCountMax 3
  '';

in
{
  options.aos.services.ssh = {
    enable = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Enable the OpenSSH server (sshd).";
    };

    port = lib.mkOption {
      type = lib.types.port;
      default = 22;
      description = "TCP port for the SSH server to listen on.";
    };

    permitRootLogin = lib.mkOption {
      type = lib.types.str;
      default = "prohibit-password";
      description = ''
        Root login policy. Valid values:
        - "yes": allow root login with any method
        - "prohibit-password": allow root login with keys only
        - "forced-commands-only": allow root login with keys only for forced commands
        - "no": disallow root login entirely
      '';
    };

    passwordAuthentication = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = ''
        Allow password-based authentication. Disabled by default on AOS
        because SSH key authentication is more secure and passwords are
        not set on system accounts.
      '';
    };

    kbdInteractiveAuthentication = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Allow keyboard-interactive authentication (PAM prompts).";
    };

    x11Forwarding = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Allow X11 forwarding. Disabled by default on headless servers.";
    };

    maxAuthTries = lib.mkOption {
      type = lib.types.int;
      default = 3;
      description = "Maximum authentication attempts per connection.";
    };

    allowedCiphers = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [
        "chacha20-poly1305@openssh.com"
        "aes256-gcm@openssh.com"
        "aes128-gcm@openssh.com"
      ];
      description = ''
        Allowed symmetric ciphers. The defaults are AEAD ciphers only,
        following Mozilla "Modern" SSH guidelines.
      '';
    };

    allowedKexAlgorithms = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [
        "curve25519-sha256"
        "curve25519-sha256@libssh.org"
      ];
      description = ''
        Allowed key exchange algorithms. The defaults use only Curve25519,
        which provides strong security without NIST curve concerns.
      '';
    };

    allowedMACs = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [
        "hmac-sha2-512-etm@openssh.com"
        "hmac-sha2-256-etm@openssh.com"
      ];
      description = ''
        Allowed MAC algorithms. The defaults use only Encrypt-then-MAC
        variants of SHA-2.
      '';
    };

    authorizedKeysFile = lib.mkOption {
      type = lib.types.str;
      default = "/etc/ssh/authorized_keys/%u";
      description = ''
        Path pattern for authorized_keys files. The %u placeholder is
        replaced by the username. Using a system-wide directory instead
        of ~/.ssh/authorized_keys because home directories may not exist
        on immutable systems.
      '';
    };
  };

  config = lib.mkIf cfg.enable {
    environment.systemPackages = [ pkgs.openssh ];

    # /etc/ssh/sshd_config — OpenSSH server configuration.
    environment.etc."ssh/sshd_config" = {
      text = sshdConfig;
    };

    # sshd.service — OpenSSH server daemon.
    systemd.services."sshd" = {
      description = "OpenSSH Daemon";
      wantedBy = [ "multi-user.target" ];
      after = [ "network.target" "sshd-keygen.target" ];
      wants = [ "sshd-keygen.target" ];
      serviceConfig = {
        Type = "notify";
        ExecStart = "/usr/sbin/sshd -D -f /etc/ssh/sshd_config";
        ExecReload = "/bin/kill -HUP $MAINPID";
        Restart = "on-failure";
        RestartSec = "5s";
        KillMode = "process";
        RuntimeDirectory = "sshd";
        RuntimeDirectoryMode = "0755";
      };
    };

    # Generate SSH host keys if they do not exist.
    # This runs once on first boot (via Ignition or this fallback).
    systemd.services."sshd-keygen" = {
      description = "Generate SSH Host Keys";
      wantedBy = [ "sshd-keygen.target" ];
      before = [ "sshd-keygen.target" ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        ExecStart = [
          "/usr/bin/ssh-keygen -A"
        ];
        ExecCondition = "/usr/bin/test ! -f /etc/ssh/ssh_host_ed25519_key";
      };
    };

    # Ensure the authorized_keys directory exists.
    environment.etc."tmpfiles.d/aos-ssh.conf" = {
      text = ''
        # Ensure SSH authorized_keys directory exists.
        d /etc/ssh/authorized_keys 0755 root root -
      '';
    };

    # Open the SSH port in the firewall.
    aos.firewall.allowedTCP = [ cfg.port ];
  };
}
