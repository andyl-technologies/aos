##! modules/services/dnsmasq.nix — Lightweight DNS and DHCP service
{
  config,
  lib,
  pkgs,
  ...
}: let
  cfg = config.aos.services.dnsmasq;
  portType = lib.types.addCheck lib.types.int (value: value >= 1 && value <= 65535);
  serviceManagement = lib.abilities.interfaces.serviceManagement;
  serviceTypes = serviceManagement.types;
  resultOf = lib.abilities.resultOf;
  producer = key: interface: parameters:
    serviceManagement.forProducer {
      consumerInstance = "system:dnsmasq";
      inherit key interface parameters;
    };
  command = entry_point: arguments: {
    executable = {
      artifact = lib.abilities.packageOutput {package = "dnsmasq";};
      inherit entry_point arguments;
    };
    ignore_failure = false;
  };
  configText = ''
    # Generated by modules/services/dnsmasq.nix.
    keep-in-foreground
    bind-dynamic
    port=${toString cfg.port}
    pid-file=/run/dnsmasq/dnsmasq.pid
    ${lib.concatMapStringsSep "\n" (address: "listen-address=${address}") cfg.listenAddresses}
    ${lib.concatMapStringsSep "\n" (server: "server=${server}") cfg.servers}
    ${lib.concatMapStringsSep "\n" (range: "dhcp-range=${range}") cfg.dhcpRanges}
    ${lib.optionalString cfg.domainNeeded "domain-needed"}
    ${lib.optionalString cfg.bogusPrivate "bogus-priv"}
    ${cfg.extraConfig}
  '';
  abilityFragments = [
    (producer "dnsmasq-network-readiness" serviceManagement.interfaces.networkReadiness {
      scope = "local-connectivity";
      address_families = ["ipv4" "ipv6"];
    })
    (serviceManagement.forConfiguration {
      inherit serviceTypes;
      consumerInstance = "system:dnsmasq";
      declaration = {
        name = "dnsmasq-config-file";
        source = {
          kind = "inline-text";
          content = configText;
        };
        mode = "0444";
      };
    })
    (serviceManagement.forService {
      inherit serviceTypes;
      consumerInstance = "system:dnsmasq";
      declaration = {
        service = "dnsmasq";
        enabled = true;
        lifecycle = {
          description = "dnsmasq DNS and DHCP server";
          execution_model = "foreground";
          environment_files = [];
          condition = [];
          pre_start = [];
          start = [(command "bin/dnsmasq" ["--conf-file" (resultOf "dnsmasq-config-file" "execution-path")])];
          post_start = [];
          stop = [];
          post_stop = [];
          restart = "on-failure";
          restart_delay_millis = 100;
          remain_after_exit = false;
          start_timeout_millis = 90000;
          stop_timeout_millis = 90000;
        };
        dependencies = {
          after = [(resultOf "dnsmasq-network-readiness" "readiness-resource")];
          before = [];
          requires = [];
          wants = [(resultOf "dnsmasq-network-readiness" "readiness-resource")];
        };
        reload = {
          strategy = "signal";
          commands = [];
          signal = "HUP";
          completion = "command-exit";
        };
        directories.managed = [{
          name = "dnsmasq";
          purpose = "runtime";
          mode = "0750";
          retention = "restart";
        }];
        configuration.views = [{
          name = "dnsmasq";
          source = resultOf "dnsmasq-config-file" "execution-path";
          optional = false;
        }];
        logging = {
          standard_output = "structured";
          standard_error = "structured";
          directories = [];
          directory_mode = "0750";
        };
        identity = {
          supplementary_groups = [];
          ephemeral = true;
          file_creation_mask = "0022";
        };
        isolation = {
          privilege = "unprivileged";
          filesystem = "read-only-system";
          network = "host";
          process_visibility = "host";
          termination_scope = "all-processes";
          temporary_directory = "private";
          devices = [];
          host_paths = [];
          permit_core_dumps = false;
        };
        linux_isolation = {
          allow_privilege_escalation = false;
          ambient_capabilities = ["CAP_NET_ADMIN" "CAP_NET_BIND_SERVICE" "CAP_NET_RAW"];
          bounding_capabilities = ["CAP_NET_ADMIN" "CAP_NET_BIND_SERVICE" "CAP_NET_RAW"];
          control_group_delegation = false;
          control_group_access = "host";
          device_namespace = "shared";
          kernel_clock_mutation = true;
          kernel_hostname_mutation = true;
          kernel_log_access = true;
          kernel_module_access = true;
          kernel_tunable_access = true;
          lock_personality = false;
          memory_write_execute = true;
          namespace_isolation = [];
          network_address_families = ["ipv4" "ipv6" "netlink" "packet" "unix"];
          oom_score_adjust = 0;
          permit_realtime = true;
          permit_suid_sgid = false;
          process_visibility = "all";
          syscall_architectures = [];
          syscall_allow = [];
          syscall_deny = [];
          syscall_profile = "privileged";
          user_namespace_ownership = "none";
        };
      };
    })
  ];
in {
  options.aos.services.dnsmasq = {
    enable = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Run dnsmasq as a DNS and optional DHCP server.";
    };

    port = lib.mkOption {
      type = portType;
      default = 53;
      description = "UDP and TCP port on which dnsmasq serves DNS.";
    };

    listenAddresses = lib.mkOption {
      type = lib.types.listOf (lib.types.strMatching "[A-Za-z0-9:.%_-]+");
      default = ["127.0.0.1"];
      description = "Addresses on which dnsmasq listens.";
    };

    servers = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [];
      description = "Upstream DNS server specifications.";
    };

    dhcpRanges = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [];
      description = "dnsmasq DHCP range specifications.";
    };

    domainNeeded = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Refuse to forward plain names without a domain.";
    };

    bogusPrivate = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Do not forward reverse lookups for private addresses.";
    };

    extraConfig = lib.mkOption {
      type = lib.types.lines;
      default = "";
      description = "Additional lines appended to dnsmasq.conf.";
    };
  };

  config = lib.mkIf cfg.enable (lib.mkMerge ([
    {
      assertions = [
        {
          assertion = cfg.listenAddresses != [];
          message = "aos.services.dnsmasq.listenAddresses must contain at least one address";
        }
      ];

      environment.systemPackages = [pkgs.dnsmasq pkgs.dnsutils];
      aos.abilities.instances."system:dnsmasq" = {};

      system.checks.dnsmasq = {
        description = "dnsmasq service checks";
        checks = [
          {
            name = "dnsmasq-active";
            description = "dnsmasq remains active after startup";
            script = ''
              vm.wait_until_succeeds(
                  "systemctl is-active --quiet dnsmasq.service", timeout=30
              )
            '';
          }
        ];
      };
    }
  ] ++ builtins.map (fragment: {aos.abilities = fragment;}) abilityFragments));
}
