##! modules/services/bind.nix — BIND authoritative and recursive DNS service
{
  config,
  lib,
  pkgs,
  ...
}: let
  cfg = config.aos.services.bind;
  portType = lib.types.addCheck lib.types.int (value: value >= 1 && value <= 65535);
  renderAddresses = values:
    if values == []
    then "none"
    else lib.concatStringsSep "; " values;
  ipv4Addresses = renderAddresses cfg.listenIPv4;
  ipv6Addresses = renderAddresses cfg.listenIPv6;
  forwarders = lib.concatStringsSep "; " cfg.forwarders;
  serviceManagement = lib.abilities.interfaces.serviceManagement;
  serviceTypes = serviceManagement.types;
  resultOf = lib.abilities.resultOf;
  producer = key: interface: parameters:
    serviceManagement.forProducer {
      consumerInstance = "system:bind";
      inherit key interface parameters;
    };
  command = entry_point: arguments: {
    executable = {
      artifact = lib.abilities.packageOutput {package = "bind";};
      inherit entry_point arguments;
    };
    ignore_failure = false;
  };
  namedConf = ''
    // Generated by modules/services/bind.nix.
    options {
      directory "/var/lib/bind";
      pid-file "/run/named/named.pid";
      session-keyfile "/run/named/session.key";
      managed-keys-directory "/var/lib/bind";
      listen-on port ${toString cfg.port} { ${ipv4Addresses}; };
      listen-on-v6 port ${toString cfg.port} { ${ipv6Addresses}; };
      recursion ${
      if cfg.recursion
      then "yes"
      else "no"
    };
      dnssec-validation auto;
      empty-zones-enable yes;
      ${lib.optionalString (cfg.forwarders != []) "forwarders { ${forwarders}; };"}
    };

    ${cfg.extraConfig}
  '';
  abilityFragments = [
    (producer "bind-network-readiness" serviceManagement.interfaces.networkReadiness {
      scope = "local-connectivity";
      address_families = ["ipv4" "ipv6"];
    })
    (serviceManagement.forConfiguration {
      inherit serviceTypes;
      consumerInstance = "system:bind";
      declaration = {
        name = "bind-config-file";
        source = {
          kind = "inline-text";
          content = namedConf;
        };
        mode = "0444";
      };
    })
    (serviceManagement.forService {
      inherit serviceTypes;
      consumerInstance = "system:bind";
      declaration = {
        service = "named";
        enabled = true;
        lifecycle = {
          description = "BIND Domain Name Server";
          execution_model = "foreground";
          environment_files = [];
          condition = [];
          pre_start = [];
          start = [(command "sbin/named" ["-f" "-c" (resultOf "bind-config-file" "execution-path")])];
          post_start = [];
          stop = [];
          post_stop = [];
          restart = "on-failure";
          restart_delay_millis = 100;
          remain_after_exit = false;
          start_timeout_millis = 90000;
          stop_timeout_millis = 90000;
        };
        dependencies = {
          after = [(resultOf "bind-network-readiness" "readiness-resource")];
          before = [];
          requires = [];
          wants = [(resultOf "bind-network-readiness" "readiness-resource")];
        };
        supervision = {
          startup_protocol = "notification";
          notification_access = "main-process";
        };
        readiness = {
          mechanism = "process-signal";
          signal_scope = "main-process";
          timeout_millis = 90000;
        };
        reload = {
          strategy = "command";
          commands = [(command "sbin/rndc" ["reload"])];
        };
        directories.managed = [
          {
            path = "named";
            purpose = "runtime";
            mode = "0750";
            retention = "restart";
          }
          {
            path = "bind";
            purpose = "state";
            mode = "0750";
            retention = "persistent";
          }
        ];
        configuration.views = [{
          name = "named";
          source = resultOf "bind-config-file" "execution-path";
          optional = false;
        }];
        logging = {
          standard_output = "structured";
          standard_error = "structured";
          directories = [];
          directory_mode = "0750";
        };
        identity = {
          supplementary_groups = [];
          ephemeral = true;
          file_creation_mask = "0022";
        };
        isolation = {
          privilege = "unprivileged";
          filesystem = "read-only-system";
          network = "host";
          process_visibility = "host";
          termination_scope = "all-processes";
          temporary_directory = "private";
          devices = [];
          host_paths = [];
          permit_core_dumps = false;
        };
        linux_isolation = {
          allow_privilege_escalation = false;
          ambient_capabilities = ["CAP_NET_BIND_SERVICE"];
          capability_bounds = {
            kind = "restricted";
            capabilities = ["CAP_NET_BIND_SERVICE"];
          };
          control_group_delegation = false;
          control_group_access = "host";
          device_namespace = "shared";
          kernel_clock_mutation = true;
          kernel_hostname_mutation = true;
          kernel_log_access = true;
          kernel_module_access = true;
          kernel_tunable_access = true;
          lock_personality = false;
          memory_write_execute = true;
          namespace_isolation = [];
          network_address_families = ["ipv4" "ipv6" "netlink" "packet" "unix"];
          oom_score_adjust = 0;
          permit_realtime = true;
          permit_suid_sgid = false;
          process_visibility = "all";
          syscall_architectures = [];
          syscall_allow = [];
          syscall_deny = [];
          syscall_profile = "privileged";
          user_namespace_ownership = "none";
        };
      };
    })
  ];
in {
  options.aos.services.bind = {
    enable = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Run the BIND DNS server.";
    };

    port = lib.mkOption {
      type = portType;
      default = 53;
      description = "TCP and UDP port on which named listens.";
    };

    listenIPv4 = lib.mkOption {
      type = lib.types.listOf (lib.types.strMatching "[A-Za-z0-9:.%_-]+");
      default = ["127.0.0.1"];
      description = "IPv4 addresses on which named listens.";
    };

    listenIPv6 = lib.mkOption {
      type = lib.types.listOf (lib.types.strMatching "[A-Za-z0-9:.%_-]+");
      default = ["::1"];
      description = "IPv6 addresses on which named listens.";
    };

    recursion = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Answer recursive DNS queries.";
    };

    forwarders = lib.mkOption {
      type = lib.types.listOf (lib.types.strMatching "[A-Za-z0-9:.%_-]+");
      default = [];
      description = "Upstream DNS servers used as forwarders.";
    };

    extraConfig = lib.mkOption {
      type = lib.types.lines;
      default = "";
      description = "Additional named.conf declarations, such as zone definitions.";
    };
  };

  config = lib.mkIf cfg.enable (lib.mkMerge ([
    {
      assertions = [
        {
          assertion = cfg.listenIPv4 != [] || cfg.listenIPv6 != [];
          message = "BIND must listen on at least one IPv4 or IPv6 address";
        }
        {
          assertion = !(config.aos.services.dnsmasq.enable && config.aos.services.dnsmasq.port == cfg.port);
          message = "BIND and dnsmasq cannot both listen on the same DNS port";
        }
      ];

      environment.systemPackages = [pkgs.bind pkgs.dnsutils];
      aos.abilities.instances."system:bind" = {};

      system.checks.bind = {
        description = "BIND DNS service checks";
        checks = [
          {
            name = "named-active";
            description = "named reaches its ready state";
            script = ''
              vm.wait_until_succeeds(
                  "systemctl is-active --quiet named.service", timeout=30
              )
              vm.succeed("dig -p ${toString cfg.port} @127.0.0.1 version.bind TXT CH +short")
            '';
          }
        ];
      };
    }
  ] ++ builtins.map (fragment: {aos.abilities = fragment;}) abilityFragments));
}
