#!@bash@
set -euo pipefail

PATH=@coreutils@/bin:@dosfstools@/sbin:@gptfdisk@/sbin:@mtools@/bin:@systemd@/bin:@systemd@/sbin:@util_linux@/bin:@util_linux@/sbin:@zfs@/bin:@zfs@/sbin
export PATH

usage() {
  echo "usage: aos-install-zfs --recovery-key-output PATH --confirm ERASE-AND-INSTALL --disk /dev/disk/by-id/ID [--disk ...]" >&2
  exit 2
}

recovery=
confirm=
disks=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --disk) [ "$#" -ge 2 ] || usage; disks+=("$2"); shift 2 ;;
    --recovery-key-output) [ "$#" -ge 2 ] || usage; recovery=$2; shift 2 ;;
    --confirm) [ "$#" -ge 2 ] || usage; confirm=$2; shift 2 ;;
    *) usage ;;
  esac
done

[ "$confirm" = ERASE-AND-INSTALL ] || usage
[ -n "$recovery" ] && [ "${recovery#/}" != "$recovery" ] \
  && [ ! -e "$recovery" ] && [ ! -L "$recovery" ] && [ -d "$(dirname "$recovery")" ] || {
  echo "recovery output must be a new path" >&2
  exit 1
}
[ "${#disks[@]}" -ge 2 ] && [ $(( ${#disks[@]} % 2 )) -eq 0 ] || {
  echo "supply an even number of at least two disks; adjacent disks form mirrors" >&2
  exit 1
}
[ "${#disks[@]}" -eq @esp_count@ ] || {
  echo "disk count must equal the configured EFI System Partition count (@esp_count@)" >&2
  exit 1
}

secure_boot_var=/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c
[ -r "$secure_boot_var" ] && [ "$(od -An -t u1 -j4 -N1 "$secure_boot_var" | tr -d ' ')" = 1 ] || {
  echo "installation requires UEFI Secure Boot enforcing before TPM policy sealing" >&2
  exit 1
}

resolved_disks=()
disk_sizes=()
expected_esps=(@esp_devices@)
index=0
for disk in "${disks[@]}"; do
  index=$((index + 1))
  case "$disk" in /dev/disk/by-id/*) ;; *) echo "unsafe disk identity: $disk" >&2; exit 1 ;; esac
  [ -b "$disk" ] || { echo "not a block device: $disk" >&2; exit 1; }
  device_type=$(lsblk -dno TYPE "$disk" | tr -d '[:space:]')
  [ "$device_type" = disk ] || {
    echo "refusing non-whole-disk device: $disk (type: $device_type)" >&2
    exit 1
  }
  resolved=$(readlink -f "$disk")
  for previous in "${resolved_disks[@]}"; do
    [ "$resolved" != "$previous" ] || {
      echo "disk was supplied more than once: $disk" >&2
      exit 1
    }
  done
  resolved_disks+=("$resolved")
  disk_bytes=$(lsblk -bndo SIZE "$disk")
  case "$disk_bytes" in ''|*[!0-9]*) echo "cannot determine disk capacity: $disk" >&2; exit 1 ;; esac
  disk_sizes+=("$disk_bytes")
  [ -z "$(lsblk -nrpo MOUNTPOINTS "$disk" | tr -d '[:space:]')" ] || {
    echo "refusing disk with a mounted filesystem: $disk" >&2
    exit 1
  }
  [ "$(lsblk -nrpo NAME "$disk" | wc -l)" -eq 1 ] || {
    echo "refusing disk with an existing partition table: $disk" >&2
    exit 1
  }
  [ -z "$(wipefs --noheadings --output TYPE "$disk")" ] || {
    echo "refusing disk with an existing filesystem or storage signature: $disk" >&2
    exit 1
  }
  [ ! -e "${disk}-part1" ] && [ ! -e "${disk}-part2" ] || {
    echo "refusing disk with existing partitions: $disk" >&2
    exit 1
  }
  case "${expected_esps[$((index - 1))]}" in
    /dev/disk/by-partlabel/aos-esp-"$index") ;;
    *)
      echo "configured ESP $index must be /dev/disk/by-partlabel/aos-esp-$index" >&2
      exit 1
      ;;
  esac
done

bundle=$(cd "$(dirname "$0")/.." && pwd -P)
esp_payload_kib=$(du -skL "$bundle/payload/esp" | cut -f1)
# Reserve a second copy of the installed UKI for A/B staging, then leave 32 MiB
# for FAT metadata and update bookkeeping.
uki_candidates=("$bundle"/payload/esp/EFI/Linux/*.efi)
[ "${#uki_candidates[@]}" -eq 1 ] && [ -f "${uki_candidates[0]}" ] || {
  echo "installer bundle must contain exactly one initial UKI" >&2
  exit 1
}
uki_bytes=$(stat -Lc %s "${uki_candidates[0]}")
required_esp_kib=$(( esp_payload_kib + (uki_bytes + 1023) / 1024 + 32768 ))
[ "$required_esp_kib" -le $(( @esp_size@ * 1024 )) ] || {
  echo "EFI payload exceeds the configured @esp_size@ MiB partition capacity" >&2
  exit 1
}
root_bytes=$(stat -Lc %s "$bundle/payload/root.img")
verity_bytes=$(stat -Lc %s "$bundle/payload/root.verity")
root_size=$(( @root_slot_size@ * 1048576 ))
verity_size=$(( @verity_slot_size@ * 1048576 ))
[ "$root_bytes" -le "$root_size" ] || { echo "root image exceeds configured zvol capacity" >&2; exit 1; }
[ "$verity_bytes" -le "$verity_size" ] || { echo "verity image exceeds configured zvol capacity" >&2; exit 1; }

# Partitioning consumes the configured ESP plus the leading alignment gap on every disk.
# A striped set of adjacent mirrors has the capacity of the smaller member of
# each pair. Validate the complete zvol allocation before touching a GPT.
partition_overhead=$(( (@esp_size@ + 1) * 1048576 ))
usable_pool_bytes=0
index=0
while [ "$index" -lt "${#disk_sizes[@]}" ]; do
  first=${disk_sizes[$index]}
  second=${disk_sizes[$((index + 1))]}
  [ "$first" -gt "$partition_overhead" ] && [ "$second" -gt "$partition_overhead" ] || {
    echo "disk pair $((index / 2 + 1)) is too small for the ESP and ZFS partition" >&2
    exit 1
  }
  if [ "$first" -lt "$second" ]; then pair_bytes=$first; else pair_bytes=$second; fi
  usable_pool_bytes=$((usable_pool_bytes + pair_bytes - partition_overhead))
  index=$((index + 2))
done
required_zvol_bytes=$(( 2 * root_size + 2 * verity_size ))
pool_headroom=$(( (${#disk_sizes[@]} / 2) * 1073741824 ))
required_pool_bytes=$((required_zvol_bytes + pool_headroom))
[ "$usable_pool_bytes" -ge "$required_pool_bytes" ] || {
  echo "RAID10 pool is too small for the configured immutable zvol slots" >&2
  exit 1
}
key=$(mktemp /run/aos-zfs-key.XXXXXX)
sealed=
esp=
esp_mounted=false
pool_created=false
cleanup() {
  if [ "$esp_mounted" = true ]; then umount "$esp" 2>/dev/null || true; fi
  if [ -n "$esp" ]; then rmdir "$esp" 2>/dev/null || true; fi
  if [ -n "$sealed" ]; then rm -f "$sealed"; fi
  if [ "$pool_created" = true ]; then zpool export @pool@ 2>/dev/null || true; fi
  shred -u "$key" 2>/dev/null || rm -f "$key"
}
trap cleanup EXIT INT TERM
dd if=/dev/urandom of="$key" bs=32 count=1 status=none
install -m 0600 "$key" "$recovery"

index=0
for disk in "${disks[@]}"; do
  index=$((index + 1))
  sgdisk --clear \
    --new=1:1MiB:+@esp_size@MiB --typecode=1:EF00 --change-name=1:"aos-esp-$index" \
    --new=2:0:0 --typecode=2:BF01 --change-name=2:"aos-zfs-$index" \
    "$disk"
done
udevadm settle

vdevs=()
index=0
for disk in "${disks[@]}"; do
  index=$((index + 1))
  [ -b "${disk}-part1" ] && [ -b "${disk}-part2" ] || {
    echo "partition nodes did not appear for $disk" >&2
    exit 1
  }
  mkfs.vfat -F 32 -n "AOS-ESP-$index" "${disk}-part1"
  if [ $((index % 2)) -eq 1 ]; then vdevs+=(mirror); fi
  vdevs+=("${disk}-part2")
done

zpool create -f -o ashift=12 -o autotrim=on \
  -O encryption=aes-256-gcm -O keyformat=raw -O keylocation="file://$key" \
  -O compression=zstd-3 -O atime=off -O mountpoint=none \
  @pool@ "${vdevs[@]}"
pool_created=true
zfs create -p -o mountpoint=none @pool@/@dataset@
zfs create -o mountpoint=legacy -o canmount=noauto @pool@/var
zfs create -o mountpoint=legacy @pool@/var/log
zfs create -o mountpoint=legacy @pool@/var/lib

for slot in a b; do
  zfs create -V "$root_size" -o volblocksize=16K -o compression=off @pool@/@dataset@/root-$slot
  zfs create -V "$verity_size" -o volblocksize=16K -o compression=off @pool@/@dataset@/root-$slot-hash
  dd if="$bundle/payload/root.img" of="/dev/zvol/@pool@/@dataset@/root-$slot" bs=4M conv=fsync status=progress
  dd if="$bundle/payload/root.verity" of="/dev/zvol/@pool@/@dataset@/root-$slot-hash" bs=4M conv=fsync status=progress
done
zpool sync @pool@

sealed=$(mktemp /run/aos-zfs-credential.XXXXXX)
systemd-creds encrypt --name=aos-zfs-key --with-key=tpm2 \
  --tpm2-public-key="$bundle/payload/pcr-public.pem" \
  --tpm2-public-key-pcrs=@signed_pcrs@ \
  --tpm2-pcrs=@pinned_pcrs@ "$key" "$sealed"

index=0
for disk in "${disks[@]}"; do
  index=$((index + 1))
  esp=$(mktemp -d /run/aos-esp.XXXXXX)
  mount -t vfat "${disk}-part1" "$esp"
  esp_mounted=true
  cp -aL "$bundle/payload/esp/." "$esp/"
  mkdir -p "$esp/$(dirname '@sealed_key_path@')"
  install -m 0600 "$sealed" "$esp/@sealed_key_path@"
  sync -f "$esp"
  umount "$esp"
  esp_mounted=false
  rmdir "$esp"
  esp=
done
rm -f "$sealed"
sealed=

index=0
for expected in @esp_devices@; do
  index=$((index + 1))
  [ -b "$expected" ] || {
    echo "configured ESP path did not resolve after installation: $expected" >&2
    exit 1
  }
  [ "$(readlink -f "$expected")" = "$(readlink -f "${disks[$((index - 1))]}-part1")" ] || {
    echo "configured ESP path does not identify installed disk $index: $expected" >&2
    exit 1
  }
done
zpool export @pool@
pool_created=false
echo "installation complete; escrow the recovery key at $recovery before rebooting"
