#!@bash@/bin/bash
# SPDX-License-Identifier: MIT
#
# modules/base/activate.sh.in — live install/upgrade/rollback driver.
#
# Built into `${toplevel}/activate` by `system.build.activateScript`
# (modules/base/build.nix), which substitutes the `@tool@` placeholders
# for absolute /nix/store paths. apm invokes it as `activate <gen>`
# after swinging the `current → gen-N` profile pointer: it rebuilds this
# generation's /etc composefs overlay on the live system, reconciles
# running daemons, and swaps the new /etc in atomically.
#
# The Phase B-post swap (`mount --move --beneath` + recursive
# lazy-umount) is cribbed from NixOS switch-to-configuration:
#   nixpkgs nixos/modules/system/activation/ (activation-script /etc swap)
# Portions © 2003-2026 Eelco Dolstra and the Nixpkgs/NixOS contributors.
# Used under the MIT license; see nixpkgs' COPYING file for the full text.

set -euo pipefail
export LC_ALL=C
export PATH=

# --- Stage markers ---------------------------------------------------
# Which step is currently executing. The ERR trap reads $STAGE to pick
# the exit code and the cleanup action. $STAGE is reassigned as the
# script advances; only these constants are readonly.
declare -r STAGE_PREFLIGHT=preflight  # arg + env checks, before any mount
declare -r STAGE_PREPARE=prepare      # render the new gen's ignition lower
declare -r STAGE_COMPOSE=compose      # build the candidate /etc overlay
declare -r STAGE_RECONCILE=reconcile  # hand off to apm activate-reconcile
declare -r STAGE_SWAP=swap            # mount-move-beneath + lazy-umount of /etc
declare -r STAGE_CLEANUP=cleanup      # tear down the previous gen's mounts

# --- Exit codes ------------------------------------------------------
# The activate script's contract. preflight and compose are both "setup
# failed before any swap", so they share value 2; the two names keep
# each call site self-documenting.
declare -ri EX_OK=0         # all steps succeeded, every unit healthy
declare -ri EX_PREPARE=1    # prepare failed; no swap, previous gen live
declare -ri EX_PREFLIGHT=2  # bad args / missing env; no mounts yet
declare -ri EX_COMPOSE=2    # candidate overlay couldn't be built
declare -ri EX_RECONCILE=3  # reconcile returned its catastrophic code
declare -ri EX_SWAP=4       # mount-move/lazy-umount failed; /etc indeterminate
declare -ri EX_CLEANUP=5    # prev-gen cleanup failed; the upgrade itself is fine
declare -ri EX_DEGRADED=6   # swap succeeded but reconcile reported failed units

# Set to 1 by the reconcile slot if `apm activate-reconcile` reports
# failed units. The switch still proceeds (the swap is authoritative),
# but the final exit becomes EX_DEGRADED so apm surfaces a non-zero code.
reconcile_degraded=0

# Variables the cleanup fn references are declared during preflight so
# the trap can run even if a phase fails before assigning them.
STAGE="$STAGE_PREFLIGHT"

cleanup_partial_gen() {
  # Best-effort teardown of a half-built generation. All guarded with
  # `|| true` + `:-` so the trap never fails inside itself.
  @util-linux@/bin/umount --lazy "${sys:-/nonexistent}/metadata" 2>/dev/null || true
  @util-linux@/bin/umount --lazy "${sys:-/nonexistent}/content"  2>/dev/null || true
  @util-linux@/bin/umount --lazy "${upper_root:-/nonexistent}"   2>/dev/null || true
  @coreutils@/bin/rm -rf "/run/etc/system-${N:-_}" \
                         "/run/etc/ignition-${N:-_}" \
                         "/run/etc/upper-${N:-_}" 2>/dev/null || true
}

on_err() {
  rc=$?
  # Quoted patterns are matched literally (no globbing), so each arm
  # fires when $STAGE equals the corresponding constant's value.
  case "$STAGE" in
    "$STAGE_PREFLIGHT") exit "$EX_PREFLIGHT" ;;        # no mounts yet
    "$STAGE_PREPARE")   cleanup_partial_gen; exit "$EX_PREPARE" ;;
    "$STAGE_COMPOSE")   cleanup_partial_gen; exit "$EX_COMPOSE" ;;
    "$STAGE_SWAP")      echo "FATAL: /etc swap incomplete (rc=$rc)" >&2; exit "$EX_SWAP" ;;
    "$STAGE_CLEANUP")
      # The swap already succeeded; a cleanup failure is cosmetic. If
      # reconcile also reported failed units, surface EX_DEGRADED (the
      # more important signal) rather than EX_CLEANUP.
      if [ "${reconcile_degraded:-0}" = 1 ]; then
        echo "WARN: prev-gen cleanup failed (rc=$rc); units also failed" >&2
        exit "$EX_DEGRADED"
      fi
      echo "WARN: prev-gen cleanup failed (rc=$rc)" >&2
      exit "$EX_CLEANUP" ;;
    *)                  exit "$EX_PREFLIGHT" ;;
  esac
}
trap on_err ERR

# --- preflight (STAGE is STAGE_PREFLIGHT from the header) ---
if [ $# -ne 1 ]; then
  echo "usage: activate <gen-number>" >&2
  exit "$EX_PREFLIGHT"
fi
N=$1
new_top=$(@coreutils@/bin/readlink /var/lib/profiles/system/gen-${N}/toplevel)

sys=/run/etc/system-${N}
ign=/run/etc/ignition-${N}
# Declared in preflight (not Phase B-pre) so cleanup_partial_gen can
# reference it if Phase A fails before the tmpfs is mounted.
upper_root=/run/etc/upper-${N}

# Source platform env. Required vars: PLATFORM_ID, optionally
# IGNITION_CONFIG_FILE (the `platform=file` provider needs this).
#
# /run/ignition/platform.env is written at first boot by
# aos-platform-detect (pkgs/boot/aos-platform-detect.nix) into the
# initrd's /run, which systemd-initrd moves to stage-2's /run across
# switch_root, so it persists for the whole boot. A live upgrade runs in
# that same boot, so the file is present. Fail loudly if it isn't,
# rather than running ignition with an empty PLATFORM_ID.
if [ ! -r /run/ignition/platform.env ]; then
  echo "activate: /run/ignition/platform.env missing; cannot determine platform" >&2
  exit "$EX_PREFLIGHT"
fi
. /run/ignition/platform.env

# --- prepare ---
# From here a failure maps to activate exit 1 (EX_PREPARE): the ERR trap
# tears down the partial generation and the previous gen stays live.
STAGE="$STAGE_PREPARE"

# Belt-and-suspenders: re-mount the userdata ISO if it's gone. (The
# systemd auto-cleanup of /run mounts is bounded by the lifetime of the
# mounting unit; if the metadata mount was reaped, restore it here so
# ignition's file provider can read /run/aos-metadata/config.json.)
if [ "$PLATFORM_ID" = "file" ] && \
   ! @util-linux@/bin/mountpoint -q /run/aos-metadata; then
  @coreutils@/bin/mkdir -p /run/aos-metadata
  @util-linux@/bin/mount -t iso9660 -o ro,nodev,nosuid \
    /dev/disk/by-label/aos-metadata /run/aos-metadata
fi

@coreutils@/bin/mkdir -p "$sys/metadata" "$sys/content" "$ign/etc"
@util-linux@/bin/mount --bind \
  "$new_top/etc-basedir" "$sys/content"
@util-linux@/bin/mount -t erofs -o ro,nodev,nosuid \
  "$new_top/etc-metadata.erofs" "$sys/metadata"

# Re-run ignition's fetch + files stages with the new gen's role bundle
# visible at the canonical /etc/aos/ignition-roles path.
#
# WHY unshare --mount + mount --make-rprivate /:
#   The role merge entries in the instance metadata are fixed URLs of
#   the form `file:///etc/aos/ignition-roles/<role>`. Ignition resolves
#   them against that literal path. But on the live system
#   /etc/aos/ignition-roles currently points at the OLD gen's bundle
#   (it's an environment.etc entry → the live /etc overlay). We need
#   ignition to read the NEW gen's bundle without disturbing the live
#   system's view of that path — other processes, and the rest of this
#   very script, must keep seeing the real live /etc.
#
#   `unshare --mount` gives the ignition child its own mount namespace:
#   the bind-mount of $new_top/ignition-roles over
#   /etc/aos/ignition-roles is visible ONLY to that child, and vanishes
#   when it exits. The live mount table is untouched.
#
#   `mount --make-rprivate /` severs mount-event propagation across the
#   namespace boundary in BOTH directions. systemd marks `/` as
#   MS_SHARED by default, so without this a mount or (worse) an unmount
#   inside the child could propagate back to the host and either briefly
#   repoint or tear down the live binding. util-linux `unshare --mount`
#   already defaults to --propagation=private (equivalent to rprivate);
#   the explicit call is belt-and-suspenders in case that default ever
#   changes.
#
# A fresh --config-cache avoids colliding with /run/ignition.json
# written by the first-boot fetch.
#
# IGNITION_CONFIG_FILE is forwarded explicitly: for `platform=file` it
# carries /run/aos-metadata/config.json (see
# pkgs/boot/aos-platform-detect.nix), and ignition's file provider reads
# it from the environment. `env` uses an absolute path so it doesn't
# rely on the inherited PATH (which we cleared).
@coreutils@/bin/env -i \
    new_top="$new_top" \
    ign="$ign" \
    N="$N" \
    PLATFORM_ID="$PLATFORM_ID" \
    IGNITION_CONFIG_FILE="${IGNITION_CONFIG_FILE:-}" \
    MOUNT="@util-linux@/bin/mount" \
    IGNITION="@ignition@/bin/ignition" \
    PATH="@coreutils@/bin" \
  @util-linux@/bin/unshare --mount \
  @bash@/bin/bash -eu <<'EOF'
  "$MOUNT" --make-rprivate /
  "$MOUNT" --bind --read-only \
    "$new_top/ignition-roles" \
    /etc/aos/ignition-roles

  "$IGNITION" --root="$ign" \
              --config-cache="/run/aos-ignition-$N.json" \
              --platform="$PLATFORM_ID" --stage=fetch \
              --log-to-stdout
  "$IGNITION" --root="$ign" \
              --config-cache="/run/aos-ignition-$N.json" \
              --platform="$PLATFORM_ID" --stage=files \
              --log-to-stdout
EOF

# --- compose ---
# From here a failure maps to activate exit 2 (EX_COMPOSE: the candidate
# overlay couldn't be built); the ERR trap cleans up and the previous
# gen stays live.
STAGE="$STAGE_COMPOSE"

# $upper_root was declared during preflight; mount its tmpfs now. It is
# a FRESH, empty tmpfs — the candidate overlay deliberately does not
# inherit the live system's runtime /etc writes (those live in the old
# gen's upper). This matches reboot semantics: the /etc upper is
# ephemeral; persistent host state lives in /var/etc (a shared lower
# present in both the old and candidate overlay).
@coreutils@/bin/mkdir -p "$upper_root"
@util-linux@/bin/mount -t tmpfs -o nosuid,nodev,mode=755 \
  tmpfs "$upper_root"
@coreutils@/bin/mkdir -p "$upper_root/upper" "$upper_root/work"

tmpEtc=$(@coreutils@/bin/mktemp -d -p /run aos-etc-final.XXXXXX)
@util-linux@/bin/mount --bind --make-private "$tmpEtc" "$tmpEtc"

# The overlay option string must contain no spaces; the continuation
# lines below are intentionally NOT indented so the `\`-joined value
# stays comma-separated with no embedded whitespace.
@util-linux@/bin/mount -t overlay overlay -o \
nodev,nosuid,metacopy=on,redirect_dir=on,\
lowerdir+=/var/etc,\
lowerdir+="$ign/etc",\
lowerdir+="$sys/metadata",\
datadir+="$sys/content",\
upperdir="$upper_root/upper",\
workdir="$upper_root/work" \
  "$tmpEtc"

# --- reconcile ---
# P1: reconciliation is stubbed. The real `apm activate-reconcile` call
# is wired in a follow-up phase; for now we proceed straight to the swap
# so the overlay-swap path can be exercised on its own. The call is kept
# outside the ERR trap (wrapped in set +e/set -e) because a reconcile
# exit of 1 must let the script PROCEED, which `set -e` would abort on.
STAGE="$STAGE_RECONCILE"
set +e
# (Replaced in P4 with: @apm@/bin/apm activate-reconcile --gen="$N" \
#   --candidate-etc="$tmpEtc" --new-toplevel="$new_top" \
#   --old-toplevel-symlink=/var/lib/profiles/system/current/toplevel)
true
reconcile_rc=$?
set -e

case "$reconcile_rc" in
  0) ;;                                              # clean — proceed
  1) reconcile_degraded=1
     echo "activate: reconcile reported failed units; switch proceeds" >&2 ;;
  *) cleanup_partial_gen; exit "$EX_RECONCILE" ;;    # catastrophic → abort
esac

# --- swap ---
# From here a failure maps to activate exit 4 (EX_SWAP): the swap is in
# progress, so an error leaves /etc in an indeterminate state and the
# ERR trap does NOT attempt cleanup — it only logs loudly. Operator
# intervention is expected in that case.
STAGE="$STAGE_SWAP"

# Carry any existing submounts under /etc into the new mount. (Operators
# may have manually mounted things under /etc — e.g. a /etc/secrets
# bind-mount from an encrypted volume. We preserve those.)
@util-linux@/bin/findmnt /etc --submounts --list \
  --noheading --kernel --output TARGET |
while read -r mountPoint; do
  [ "$mountPoint" = /etc ] && continue
  tmp="$tmpEtc/${mountPoint#/etc/}"
  [ -d "$mountPoint" ] && @coreutils@/bin/mkdir -p "$tmp"
  [ -f "$mountPoint" ] && @coreutils@/bin/touch  "$tmp"
  @util-linux@/bin/mount --bind "$mountPoint" "$tmp"
done

# `mount --move --beneath` requires util-linux 2.42.1+ (pinned in
# pkgs/tools/util-linux.nix). It slips the new /etc mount beneath the
# old, then the recursive lazy-umount drops the old; open fds on the old
# layer survive until their holders close them, so daemons that
# reconcile land on the new view and the rest drain naturally.
@util-linux@/bin/mount --move --beneath "$tmpEtc" /etc
@util-linux@/bin/umount --lazy --recursive /etc
@util-linux@/bin/umount --lazy "$tmpEtc"
@coreutils@/bin/rmdir "$tmpEtc"

# Retarget inspection symlinks.
prev_gen=$(@coreutils@/bin/readlink /run/etc/system \
           | @coreutils@/bin/cut -d- -f2-)
@coreutils@/bin/ln -sfn system-${N}   /run/etc/system
@coreutils@/bin/ln -sfn ignition-${N} /run/etc/ignition
@coreutils@/bin/ln -sfn upper-${N}    /run/etc/upper

# --- cleanup ---
# The swap already succeeded; a failure here is cosmetic (stale mounts),
# so STAGE_CLEANUP makes the ERR trap log a warning and exit EX_CLEANUP
# (5) — or EX_DEGRADED (6) if reconcile also reported failed units. apm
# maps 5 to a successful upgrade.
STAGE="$STAGE_CLEANUP"

if [ -n "${prev_gen:-}" ] && [ "$prev_gen" != "$N" ]; then
  @util-linux@/bin/umount --lazy "/run/etc/system-${prev_gen}/metadata" || true
  @util-linux@/bin/umount --lazy "/run/etc/system-${prev_gen}/content"  || true
  @util-linux@/bin/umount --lazy "/run/etc/upper-${prev_gen}"           || true
  @coreutils@/bin/rm -rf "/run/etc/system-${prev_gen}" \
                         "/run/etc/ignition-${prev_gen}" \
                         "/run/etc/upper-${prev_gen}"
fi

# All phases succeeded. If reconcile reported failed units the switch
# still stands, but exit EX_DEGRADED so apm surfaces a non-zero code.
if [ "${reconcile_degraded:-0}" = 1 ]; then
  exit "$EX_DEGRADED"
fi
exit "$EX_OK"
