##! modules/base/sysupdate.nix — systemd-sysupdate configuration module
##!
##! Configures systemd-sysupdate for atomic A/B OS image updates. sysupdate
##! downloads update artifacts from a transfer URL, verifies signatures, and
##! installs them to the inactive partition or ESP. Transfer definitions in
##! /etc/sysupdate.d/ describe what to fetch and where to install it.
##!
##! This integrates with the A/B partition scheme from modules/base/repart.nix:
##! updates are written to the inactive root partition, and the boot loader
##! entry is updated to point to the new partition on the next boot.
{
  config,
  pkgs,
  lib,
  ...
}:
let
  cfg = config.aos.sysupdate;

  # Generate a sysupdate.d transfer definition file.
  mkTransferConf =
    name: attrs:
    let
      # Build INI sections from the nested attribute set.
      # Each top-level key is a section name, each value is an attrset of settings.
      sections = lib.mapAttrsToList (
        section: settings:
        let
          lines = lib.mapAttrsToList (key: value: "${key}=${toString value}") settings;
        in
        ''
          [${section}]
          ${lib.concatStringsSep "\n" lines}
        ''
      ) attrs;
    in
    ''
      # /etc/sysupdate.d/${name}.conf
      # Generated by modules/base/sysupdate.nix — do not edit manually.

      ${lib.concatStringsSep "\n" sections}
    '';
in
{
  options.aos.sysupdate = {
    ## Enable systemd-sysupdate for atomic OS image updates.
    ##
    ## # See Also
    ## - `aos.sysupdate.definitions`, `aos.repart`
    enable = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = ''
        Enable systemd-sysupdate for atomic OS image updates. When enabled,
        a periodic timer checks for available updates and a service applies
        them. Transfer definitions describe what artifacts to fetch and where
        to install them.
      '';
    };

    ## Base URL for update artifacts.
    transferUrl = lib.mkOption {
      type = lib.types.str;
      default = "";
      description = ''
        Base URL for update artifacts. sysupdate appends the transfer
        definition's MatchPattern to this URL to locate downloadable
        update images. Example: "https://updates.aos.dev/images/".
      '';
    };

    ## Transfer definitions for systemd-sysupdate.
    definitions = lib.mkOption {
      type = lib.types.attrsOf lib.types.anything;
      default = { };
      description = ''
        Transfer definitions for systemd-sysupdate. Each key becomes a file
        in /etc/sysupdate.d/ (e.g. "50-root" -> /etc/sysupdate.d/50-root.conf).
        Values are nested attribute sets where top-level keys are INI section
        names. Example:

          definitions."50-root" = {
            Transfer = {
              ProtectVersion = "%A";
            };
            Source = {
              Type = "url-file";
              Path = "https://updates.aos.dev/images/";
              MatchPattern = "root-@v.raw.xz";
            };
            Target = {
              Type = "partition";
              Path = "auto";
              MatchPattern = "root-@v";
            };
          };
      '';
    };
  };

  config = lib.mkIf cfg.enable {
    # Generate /etc/sysupdate.d/*.conf files from definitions.
    environment.etc = lib.mapAttrs' (
      name: attrs:
      lib.nameValuePair "sysupdate.d/${name}.conf" {
        text = mkTransferConf name attrs;
      }
    ) cfg.definitions;

    # sysupdate-check.timer — periodic timer to check for available updates.
    systemd.timers."systemd-sysupdate" = {
      description = "systemd-sysupdate Check Timer";
      wantedBy = [ "timers.target" ];
      timerConfig = {
        OnBootSec = "10min";
        OnUnitActiveSec = "6h";
        RandomizedDelaySec = "30min";
        Persistent = true;
      };
    };

    # systemd-sysupdate.service — downloads and applies available updates.
    systemd.services."systemd-sysupdate" = {
      description = "Apply Atomic OS Update";
      after = [ "network-online.target" ];
      wants = [ "network-online.target" ];
      serviceConfig = {
        Type = "oneshot";
        ExecStart =
          "${pkgs.systemd}/bin/systemd-sysupdate update"
          + lib.optionalString (cfg.transferUrl != "") " --transfer-source=${cfg.transferUrl}";
        # sysupdate needs access to block devices to write partition images.
        ProtectSystem = false;
        # Limit network exposure to update fetching only.
        IPAddressDeny = "localhost";
      };
    };
  };
}
