##! modules/base/networking.nix — Network configuration module
##!
##! Configures networking via systemd-networkd and systemd-resolved.
##! Generates .network files for each interface, resolved.conf for DNS,
##! and manages the hostname.
##!
##! Absorbed TOML config values:
##!   [network] hostname, use_dhcp, nameservers, search_domains
##!   [network.interfaces.*] address, gateway, dns
##!   [network.resolved] enable, dnssec
{
  config,
  pkgs,
  lib,
  ...
}: let
  cfg = config.aos.networking;

  # Generate a systemd-networkd .network file for a named interface.
  mkNetworkUnit = name: ifCfg: let
    hasStaticAddr = ifCfg ? address && ifCfg.address != "";
  in ''
    # /etc/systemd/network/10-${name}.network
    # Generated by modules/base/networking.nix

    [Match]
    Name=${name}

    [Network]
    ${
      if hasStaticAddr
      then ''
        Address=${ifCfg.address}
        ${lib.optionalString (ifCfg ? gateway && ifCfg.gateway != "") "Gateway=${ifCfg.gateway}"}
        ${lib.optionalString (ifCfg ? dns && ifCfg.dns != "") "DNS=${ifCfg.dns}"}
      ''
      else ''
        DHCP=yes
      ''
    }
  '';

  # Build the default DHCP network unit if no interfaces are specified.
  defaultNetworkUnit = ''
    # /etc/systemd/network/80-dhcp.network
    # Generated by modules/base/networking.nix
    # Default: DHCP on all Ethernet interfaces.

    [Match]
    Name=en*
    Type=ether

    [Network]
    DHCP=yes

    [DHCPv4]
    UseDNS=yes
    UseNTP=yes
    UseDomains=yes
  '';

  # Build resolved.conf from DNS settings.
  resolvedConf = ''
    # /etc/systemd/resolved.conf
    # Generated by modules/base/networking.nix

    [Resolve]
    ${lib.optionalString (
      cfg.nameservers != []
    ) "DNS=${builtins.concatStringsSep " " cfg.nameservers}"}
    ${lib.optionalString (cfg.search != []) "Domains=${builtins.concatStringsSep " " cfg.search}"}
    DNSSEC=${cfg.resolved.dnssec}
    DNSOverTLS=opportunistic
    MulticastDNS=no
    LLMNR=no
  '';
in {
  options.aos.networking = {
    ## System hostname.
    hostName = lib.mkOption {
      type = lib.types.str;
      default = "aos";
      description = "System hostname. Written to /etc/hostname and set via hostnamectl.";
    };

    ## Use DHCP for all Ethernet interfaces by default.
    useDHCP = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Use DHCP for all Ethernet interfaces by default. When true and no
        static interfaces are defined, a catch-all .network file is generated
        that enables DHCP on all en* interfaces.
      '';
    };

    ## Per-interface network configuration.
    ##
    ## # Examples
    ## ```nix
    ## aos.networking.interfaces.eth0 = {
    ##   address = "10.0.0.5/24";
    ##   gateway = "10.0.0.1";
    ## };
    ## ```
    interfaces = lib.mkOption {
      type = lib.types.attrsOf (
        lib.types.submodule {
          options = {
            address = lib.mkOption {
              type = lib.types.str;
              default = "";
              description = "Static IPv4/IPv6 address in CIDR notation (e.g. 10.0.0.5/24).";
            };
            gateway = lib.mkOption {
              type = lib.types.str;
              default = "";
              description = "Default gateway for this interface.";
            };
            dns = lib.mkOption {
              type = lib.types.str;
              default = "";
              description = "DNS server for this interface.";
            };
          };
        }
      );
      default = {};
      description = ''
        Per-interface network configuration. Each key is the interface name
        (e.g. "eth0", "ens3"). If address is set, static configuration is
        used; otherwise DHCP is used for that interface.
      '';
    };

    ## Global DNS servers for systemd-resolved.
    nameservers = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [];
      description = "Global DNS servers for systemd-resolved.";
    };

    ## DNS search domains.
    search = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [];
      description = "DNS search domains.";
    };

    ## Default MTU for network interfaces (0 = kernel default).
    mtu = lib.mkOption {
      type = lib.types.int;
      default = 0;
      description = ''
        Default MTU for network interfaces. 0 means use the kernel default
        (typically 1500). Set to 9000 for jumbo frames on 10GbE+ networks.
      '';
    };

    ## VLAN interface definitions.
    vlans = lib.mkOption {
      type = lib.types.attrsOf (
        lib.types.submodule {
          options = {
            id = lib.mkOption {
              type = lib.types.int;
              description = "VLAN ID (1-4094).";
            };
            interface = lib.mkOption {
              type = lib.types.str;
              description = "Parent interface for this VLAN (e.g. eth0).";
            };
            address = lib.mkOption {
              type = lib.types.str;
              default = "";
              description = "Static address in CIDR notation, or empty for DHCP.";
            };
          };
        }
      );
      default = {};
      description = ''
        VLAN interface definitions. Each key becomes a netdev and network
        unit in systemd-networkd. Example:
          vlans.vlan100 = { id = 100; interface = "eth0"; address = "10.100.0.5/24"; };
      '';
    };

    ## Bond interface definitions.
    bonds = lib.mkOption {
      type = lib.types.attrsOf (
        lib.types.submodule {
          options = {
            interfaces = lib.mkOption {
              type = lib.types.listOf lib.types.str;
              description = "Member interfaces for this bond.";
            };
            mode = lib.mkOption {
              type = lib.types.str;
              default = "802.3ad";
              description = "Bond mode (802.3ad, active-backup, balance-rr, etc.).";
            };
            address = lib.mkOption {
              type = lib.types.str;
              default = "";
              description = "Static address in CIDR notation, or empty for DHCP.";
            };
          };
        }
      );
      default = {};
      description = ''
        Bond interface definitions. Each key becomes a netdev and network
        unit in systemd-networkd. Example:
          bonds.bond0 = { interfaces = ["eth0" "eth1"]; mode = "802.3ad"; };
      '';
    };

    ## Network tuning sysctl parameters.
    tuning = lib.mkOption {
      type = lib.types.attrsOf lib.types.str;
      default = {};
      description = ''
        Network tuning sysctl parameters. Written to
        /etc/sysctl.d/50-aos-network-tuning.conf. Example:
          { "net.core.rmem_max" = "16777216"; }
      '';
    };

    resolved = {
      ## Enable systemd-resolved for DNS resolution.
      enable = lib.mkOption {
        type = lib.types.bool;
        default = true;
        description = "Enable systemd-resolved for DNS resolution.";
      };

      ## DNSSEC validation mode.
      dnssec = lib.mkOption {
        type = lib.types.str;
        default = "allow-downgrade";
        description = ''
          DNSSEC validation mode. Valid values: "yes", "no",
          "allow-downgrade". The default allows DNSSEC when available
          but does not fail if the upstream does not support it.
        '';
      };
    };
  };

  config = {
    system.checks.networking-base = {
      description = "Base networking checks";
      checks =
        [
          {
            name = "loopback-exists";
            description = "Loopback interface exists";
            script = ''
              vm.succeed("test -d /sys/class/net/lo")
            '';
          }
          {
            name = "loopback-up";
            description = "Loopback interface is up";
            script = ''
              assert "unknown" in vm.succeed("cat /sys/class/net/lo/operstate")
            '';
          }
          {
            name = "proc-net";
            description = "/proc/net is available";
            script = ''
              vm.succeed("test -d /proc/net")
            '';
          }
          {
            name = "hostname-file";
            description = "/etc/hostname exists";
            script = ''
              vm.succeed("test -f /etc/hostname")
            '';
          }
        ]
        ++ lib.optionals cfg.resolved.enable [
          {
            name = "resolver-compatibility-link";
            description = "libc resolver configuration points at systemd-resolved";
            script = ''
              vm.wait_for_unit("systemd-resolved.service")
              vm.succeed("test -L /etc/resolv.conf")
              vm.succeed("test \"$(readlink /etc/resolv.conf)\" = /run/systemd/resolve/stub-resolv.conf")
              vm.succeed("test -s /etc/resolv.conf")
            '';
          }
        ];
    };

    # Per-interface network files.
    environment.etc = let
      interfaceFiles =
        lib.mapAttrs' (
          name: ifCfg:
            lib.nameValuePair "systemd/network/10-${name}.network" {
              text = mkNetworkUnit name ifCfg;
            }
        )
        cfg.interfaces;

      # Default DHCP unit when no interfaces are explicitly configured.
      defaultFile = lib.optionalAttrs (cfg.useDHCP && cfg.interfaces == {}) {
        "systemd/network/80-dhcp.network" = {
          text = defaultNetworkUnit;
        };
      };

      # resolved configuration.
      resolvedFile = lib.optionalAttrs cfg.resolved.enable {
        "systemd/resolved.conf" = {
          text = resolvedConf;
        };
        "tmpfiles.d/aos-resolved.conf" = {
          text = ''
            # Keep libc, language runtimes, and static tools on the same
            # resolver path as nss-resolve. The target is generated at runtime
            # by systemd-resolved, after the immutable /etc lower is mounted.
            L /etc/resolv.conf - - - - /run/systemd/resolve/stub-resolv.conf
          '';
        };
      };

      # VLAN netdev and network units.
      vlanNetdevFiles =
        lib.mapAttrs' (
          name: vlanCfg:
            lib.nameValuePair "systemd/network/05-${name}.netdev" {
              text = ''
                # /etc/systemd/network/05-${name}.netdev
                [NetDev]
                Name=${name}
                Kind=vlan

                [VLAN]
                Id=${toString vlanCfg.id}
              '';
            }
        )
        cfg.vlans;

      vlanNetworkFiles =
        lib.mapAttrs' (
          name: vlanCfg:
            lib.nameValuePair "systemd/network/10-${name}.network" {
              text = ''
                # /etc/systemd/network/10-${name}.network
                [Match]
                Name=${name}

                [Network]
                ${
                  if vlanCfg.address != ""
                  then "Address=${vlanCfg.address}"
                  else "DHCP=yes"
                }
              '';
            }
        )
        cfg.vlans;

      # Bond netdev and network units.
      bondNetdevFiles =
        lib.mapAttrs' (
          name: bondCfg:
            lib.nameValuePair "systemd/network/05-${name}.netdev" {
              text = ''
                # /etc/systemd/network/05-${name}.netdev
                [NetDev]
                Name=${name}
                Kind=bond

                [Bond]
                Mode=${bondCfg.mode}
                MIIMonitorSec=100ms
              '';
            }
        )
        cfg.bonds;

      bondNetworkFiles =
        lib.mapAttrs' (
          name: bondCfg:
            lib.nameValuePair "systemd/network/10-${name}.network" {
              text = ''
                # /etc/systemd/network/10-${name}.network
                [Match]
                Name=${name}

                [Network]
                ${
                  if bondCfg.address != ""
                  then "Address=${bondCfg.address}"
                  else "DHCP=yes"
                }
              '';
            }
        )
        cfg.bonds;

      # Network tuning sysctl drop-in.
      tuningFile = lib.optionalAttrs (cfg.tuning != {}) {
        "sysctl.d/50-aos-network-tuning.conf" = {
          text = ''
            # /etc/sysctl.d/50-aos-network-tuning.conf
            # Generated by modules/base/networking.nix
            ${builtins.concatStringsSep "\n" (lib.mapAttrsToList (k: v: "${k} = ${v}") cfg.tuning)}
          '';
        };
      };

      # Minimal /etc/protocols so getprotobyname() works — nftables
      # rules using named protocols (e.g. `ip6 nexthdr ipv6-icmp`) call
      # this lookup and fail the entire ruleset load if it's missing.
      # Hand-picked subset of the IANA protocol-numbers list covering
      # the protocols AOS policies actually reference today. Replace
      # with an iana-etc package when one is added.
      protocolsFile = {
        "protocols" = {
          text = ''
            # /etc/protocols — minimal, generated by modules/base/networking.nix
            ip          0       IP       # internet protocol, pseudo protocol number
            icmp        1       ICMP     # internet control message protocol
            igmp        2       IGMP     # Internet Group Management
            ggp         3       GGP      # gateway-gateway protocol
            ipencap     4       IP-ENCAP # IP encapsulated in IP
            tcp         6       TCP      # transmission control protocol
            egp         8       EGP      # exterior gateway protocol
            udp         17      UDP      # user datagram protocol
            ipv6        41      IPv6     # Internet Protocol, version 6
            ipv6-route  43      IPv6-Route
            ipv6-frag   44      IPv6-Frag
            rsvp        46      RSVP     # Reservation Protocol
            gre         47      GRE      # General Routing Encapsulation
            esp         50      ESP      # Encap Security Payload
            ah          51      AH       # Authentication Header
            ipv6-icmp   58      IPv6-ICMP # ICMP for IPv6
            ipv6-nonxt  59      IPv6-NoNxt
            ipv6-opts   60      IPv6-Opts
            eigrp       88      EIGRP    # Cisco EIGRP
            ospf        89      OSPFIGP  # Open Shortest Path First
            pim         103     PIM      # Protocol Independent Multicast
            sctp        132     SCTP     # Stream Control Transmission Protocol
            udplite     136     UDPLite  # UDP-Lite
          '';
        };
      };
    in
      interfaceFiles
      // defaultFile
      // resolvedFile
      // vlanNetdevFiles
      // vlanNetworkFiles
      // bondNetdevFiles
      // bondNetworkFiles
      // tuningFile
      // protocolsFile;

    # Enable the upstream systemd-networkd and systemd-resolved units
    # that ship at `$pkgs.systemd/lib/systemd/system/`. Spec v3.1 §6.8
    # explains why: the previous declarations overrode a complete
    # upstream unit (with `ExecStart=`, capabilities, dependencies,
    # …) with an incomplete re-declaration that had no `ExecStart`,
    # and systemd quietly ignored the whole thing.
    #
    # `overrideStrategy = "asDropin"` tells `generateUnits` to emit
    # the rendered unit as a drop-in file (`systemd-networkd.service.d/
    # overrides.conf`) rather than a full unit, which lets the
    # upstream unit at `$systemd/lib/systemd/system/systemd-networkd.
    # service` actually run with its full set of directives.
    #
    # The rendered unit text is essentially empty (we only provide
    # `wantedBy` to materialise the `multi-user.target.wants/
    # systemd-networkd.service` symlink); everything else comes from
    # the upstream unit file. systemd resolves the wantedBy symlink
    # by falling back to `SYSTEM_DATA_UNIT_DIR` lookup — see the
    # `0001-remove-usr-lib-unit-lookup-paths.patch` in
    # `pkgs/system/systemd.nix`.
    systemd.services."systemd-networkd" = {
      overrideStrategy = "asDropin";
      wantedBy = ["multi-user.target"];
    };

    systemd.services."systemd-resolved" = lib.mkIf cfg.resolved.enable {
      overrideStrategy = "asDropin";
      wantedBy = ["multi-user.target"];
    };
  };
}
