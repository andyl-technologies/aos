##! modules/monitoring/hardware.nix — Hardware monitoring module
##!
##! Configures hardware health monitoring including systemd watchdog
##! timers, S.M.A.R.T. disk health checks (via smartd), and thermal
##! throttling detection. The watchdog ensures the system reboots if
##! the kernel or systemd becomes unresponsive. SMART monitoring
##! provides early warning of disk failures.
##!
##! Options:
##!   [monitoring.hardware] enable, watchdog, watchdogTimeout, smartd
{
  config,
  pkgs,
  lib,
  ...
}: let
  cfg = config.aos.monitoring.hardware;

  # Watchdog configuration for systemd's system.conf.d drop-in.
  watchdogConf = ''
    # /etc/systemd/system.conf.d/watchdog.conf — generated by modules/monitoring/hardware.nix
    # Do not edit manually.

    [Manager]
    RuntimeWatchdogSec=${toString cfg.watchdogTimeout}
    RebootWatchdogSec=${toString (cfg.watchdogTimeout * 2)}
    KExecWatchdogSec=${toString (cfg.watchdogTimeout * 2)}
  '';

  # smartd configuration.
  smartdConf = ''
    # /etc/smartd.conf — generated by modules/monitoring/hardware.nix
    # Do not edit manually.

    # Monitor all devices, check every 30 minutes, log to syslog.
    # -a: monitor all SMART attributes
    # -o on: enable automatic offline testing
    # -S on: enable automatic attribute autosave
    # -n standby,q: skip checks if disk is in standby (quiet)
    # -W 5,45,55: track temperature, warn at 45C, critical at 55C
    # -m root: mail alerts to root
    DEVICESCAN -a -o on -S on -n standby,q -W 5,45,55 -m root
  '';
in {
  options.aos.monitoring.hardware = {
    ## Enable hardware health monitoring (watchdog, SMART, thermal).
    enable = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = ''
        Enable hardware health monitoring. Includes systemd watchdog,
        S.M.A.R.T. disk monitoring, and thermal throttling detection.
      '';
    };

    ## Enable the systemd hardware watchdog.
    ##
    ## # See Also
    ## - `aos.monitoring.hardware.watchdogTimeout`
    watchdog = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Enable the systemd hardware watchdog. If the kernel or systemd
        becomes unresponsive for longer than watchdogTimeout, the system
        will be automatically rebooted. Requires a hardware watchdog
        device (/dev/watchdog).
      '';
    };

    ## Watchdog timeout in seconds before triggering a reboot.
    watchdogTimeout = lib.mkOption {
      type = lib.types.int;
      default = 30;
      description = ''
        Watchdog timeout in seconds. If systemd does not pet the watchdog
        within this interval, the hardware watchdog triggers a reboot.
        The reboot watchdog is set to 2x this value.
      '';
    };

    ## Enable S.M.A.R.T. disk health monitoring via smartd.
    smartd = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Enable S.M.A.R.T. disk health monitoring via smartd. Monitors
        all detected drives for attribute changes, temperature, and
        pending failures. Sends alerts via syslog/mail.
      '';
    };

    # `thermalThrottling` was removed in the systemd refactor
    # (spec v3.1 §6.10). The previous implementation declared
    # `systemd.services."thermal-check.timer"` — a misuse pattern
    # that stuffed `[Timer]` directives into a `[Service]` section
    # of a file named `thermal-check.timer.service`, which systemd
    # silently ignored. Re-add when actually needed, declaring a
    # proper `systemd.services.thermal-check` + `systemd.timers.
    # thermal-check` pair.
  };

  config = lib.mkIf cfg.enable {
    # Watchdog configuration drop-in for systemd.
    environment.etc."systemd/system.conf.d/watchdog.conf" = lib.mkIf cfg.watchdog {
      text = watchdogConf;
    };

    # smartd configuration and service.
    environment.etc."smartd.conf" = lib.mkIf cfg.smartd {
      text = smartdConf;
    };

    systemd.services."smartd" = lib.mkIf cfg.smartd {
      description = "S.M.A.R.T. Disk Monitoring Daemon";
      wantedBy = ["multi-user.target"];
      after = ["local-fs.target"];
      serviceConfig = {
        Type = "forking";
        ExecStart = "${pkgs.smartmontools}/sbin/smartd -c /etc/smartd.conf";
        Restart = "on-failure";
        RestartSec = "30s";
        PIDFile = "/run/smartd.pid";
        # Security hardening — smartd needs access to block devices.
        ProtectHome = true;
        NoNewPrivileges = true;
        PrivateTmp = true;
      };
    };
  };
}
