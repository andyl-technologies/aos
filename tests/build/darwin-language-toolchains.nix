# Build-only validation for Linux-produced Darwin Go and Rust toolchains.
{pkgs}: let
  buildSystem = pkgs.stdenv.buildPlatform.system;
  x86 = import ../.. {
    system = buildSystem;
    crossSystem = "x86_64-darwin";
  };
  arm = import ../.. {
    system = buildSystem;
    crossSystem = "aarch64-darwin";
  };

  emptyCargoDeps = pkgs.runCommand "darwin-rust-smoke-cargo-deps" {} ''
    mkdir -p "$out"
  '';

  rustSmokeSource = pkgs.runCommand "darwin-rust-smoke-source" {} ''
    mkdir -p "$out/src"
    cat > "$out/Cargo.toml" <<'TOML'
    [package]
    name = "aos-darwin-rust-smoke"
    version = "0.1.0"
    edition = "2021"
    TOML
    cat > "$out/Cargo.lock" <<'LOCK'
    # This file is automatically @generated by Cargo.
    # It is not intended for manual editing.
    version = 4

    [[package]]
    name = "aos-darwin-rust-smoke"
    version = "0.1.0"
    LOCK
    cat > "$out/src/main.rs" <<'RUST'
    fn main() {
        println!("AOS Darwin Rust smoke");
    }
    RUST
  '';

  goSmokeSource = pkgs.runCommand "darwin-go-smoke-source" {} ''
    mkdir -p "$out"
    cat > "$out/go.mod" <<'MOD'
    module aos-darwin-go-smoke

    go 1.26
    MOD
    cat > "$out/main.go" <<'GO'
    package main

    import "fmt"

    func main() {
        fmt.Println("AOS Darwin Go smoke")
    }
    GO
  '';

  mkCargoSmoke = cross: expectedCpu:
    cross.pkgs.mkCargoPackage {
      pname = "darwin-rust-consumer-${cross.stdenv.hostPlatform.system}";
      version = "0";
      src = rustSmokeSource;
      cargoDeps = emptyCargoDeps;
      doCheck = true;

      # The generic cross fixup checks every installed Mach-O file as well;
      # retaining this per-consumer assertion makes an architecture failure
      # local to the language-toolchain test.
      postInstall = ''
        header=$("$OBJDUMP" --macho --private-header "$out/bin/aos-darwin-rust-smoke")
        if ! printf '%s\n' "$header" | grep -q '${expectedCpu}'; then
          echo "Cargo produced the wrong Mach-O architecture" >&2
          printf '%s\n' "$header" >&2
          exit 1
        fi
      '';
    };

  mkGoSmoke = cross: expectedCpu:
    cross.pkgs.mkGoPackage {
      pname = "darwin-go-consumer-${cross.stdenv.hostPlatform.system}";
      version = "0";
      src = goSmokeSource;
      goOutput = "aos-darwin-go-smoke";
      doCheck = true;

      postInstall = ''
        header=$("$OBJDUMP" --macho --private-header "$out/bin/aos-darwin-go-smoke")
        if ! printf '%s\n' "$header" | grep -q '${expectedCpu}'; then
          echo "Go produced the wrong Mach-O architecture" >&2
          printf '%s\n' "$header" >&2
          exit 1
        fi
      '';
    };

  x86Cargo = mkCargoSmoke x86 "X86_64";
  armCargo = mkCargoSmoke arm "ARM64";
  x86Go = mkGoSmoke x86 "X86_64";
  armGo = mkGoSmoke arm "ARM64";
in
  pkgs.mkDerivation {
    pname = "darwin-language-toolchains-check";
    version = "0";
    src = null;
    buildDeps = [pkgs.llvm];

    phases = [
      {
        name = "verify";
        script = ''
          verify_macho() {
            executable=$1
            expected_cpu=$2
            header=$(llvm-objdump --macho --private-header "$executable")
            if ! printf '%s\n' "$header" | grep -q "$expected_cpu"; then
              echo "unexpected Mach-O architecture in $executable: expected $expected_cpu" >&2
              printf '%s\n' "$header" >&2
              exit 1
            fi
          }

          test "$(cat ${x86.pkgs.go}/nix-support/aos-target-platform)" = x86_64-darwin
          test "$(cat ${arm.pkgs.go}/nix-support/aos-target-platform)" = aarch64-darwin
          verify_macho ${x86.pkgs.go}/bin/go X86_64
          verify_macho ${x86.pkgs.go}/pkg/tool/darwin_amd64/compile X86_64
          verify_macho ${arm.pkgs.go}/bin/go ARM64
          verify_macho ${arm.pkgs.go}/pkg/tool/darwin_arm64/compile ARM64

          test "$(cat ${x86.pkgs.rust}/nix-support/aos-target-platform)" = x86_64-darwin
          test "$(cat ${arm.pkgs.rust}/nix-support/aos-target-platform)" = aarch64-darwin
          test "$(cat ${x86.pkgs.rust.dev}/nix-support/aos-target-platform)" = x86_64-darwin
          test "$(cat ${arm.pkgs.rust.dev}/nix-support/aos-target-platform)" = aarch64-darwin
          verify_macho ${x86.pkgs.rust}/bin/rustc X86_64
          verify_macho ${x86.pkgs.rust}/bin/cargo X86_64
          verify_macho ${arm.pkgs.rust}/bin/rustc ARM64
          verify_macho ${arm.pkgs.rust}/bin/cargo ARM64
          test -n "$(find ${x86.pkgs.rust}/lib/rustlib/x86_64-apple-darwin/lib -name 'libstd-*.rlib' -print -quit)"
          test -n "$(find ${arm.pkgs.rust}/lib/rustlib/aarch64-apple-darwin/lib -name 'libstd-*.rlib' -print -quit)"
          test -n "$(find ${x86.pkgs.rust}/lib/rustlib/wasm32-unknown-unknown/lib -name 'libstd-*.rlib' -print -quit)"
          test -n "$(find ${arm.pkgs.rust}/lib/rustlib/wasm32-unknown-unknown/lib -name 'libstd-*.rlib' -print -quit)"

          test "$(cat ${x86Cargo}/nix-support/aos-target-platform)" = x86_64-darwin
          test "$(cat ${armCargo}/nix-support/aos-target-platform)" = aarch64-darwin
          test "$(cat ${x86Go}/nix-support/aos-target-platform)" = x86_64-darwin
          test "$(cat ${armGo}/nix-support/aos-target-platform)" = aarch64-darwin
          verify_macho ${x86Cargo}/bin/aos-darwin-rust-smoke X86_64
          verify_macho ${armCargo}/bin/aos-darwin-rust-smoke ARM64
          verify_macho ${x86Go}/bin/aos-darwin-go-smoke X86_64
          verify_macho ${armGo}/bin/aos-darwin-go-smoke ARM64

          mkdir -p "$out"
          printf 'PASS\n' > "$out/result"
        '';
      }
    ];
    passthru.x86.go = x86Go;
  }
