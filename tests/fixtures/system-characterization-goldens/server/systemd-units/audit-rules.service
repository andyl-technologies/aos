[Unit]
After=auditd.service
Description=Load Audit Rules
Requires=auditd.service

[Service]
Environment="PATH=/nix/store/<HASH>-coreutils-9.5/bin:/nix/store/<HASH>-findutils-4.10.0/bin:/nix/store/<HASH>-grep-3.11/bin:/nix/store/<HASH>-sed-4.9/bin:/nix/store/<HASH>-systemd-259.1/bin:/nix/store/<HASH>-coreutils-9.5/sbin:/nix/store/<HASH>-findutils-4.10.0/sbin:/nix/store/<HASH>-grep-3.11/sbin:/nix/store/<HASH>-sed-4.9/sbin:/nix/store/<HASH>-systemd-259.1/sbin"
ExecStart=<<aos-job-script>>
#!/nix/store/<HASH>-bash-5.2.37/bin/bash
set -e

rules=/etc/audit/audit.rules
fail=0
ok=0
while IFS= read -r line; do
  # Skip blank lines and comments.
  [ -z "$line" ] && continue
  [ "${line#\#}" != "$line" ] && continue
  err=$(/nix/store/<HASH>-audit-4.0.2/sbin/auditctl $line 2>&1 >/dev/null) && rc=0 || rc=$?
  if [ "$rc" -eq 0 ]; then
    ok=$((ok + 1))
  else
    fail=$((fail + 1))
    echo "audit-rules: rejected [$rc]: $line -- $err"
  fi
done < "$rules"
echo "audit-rules: loaded $ok rule(s), rejected $fail"
<<aos-job-script-end>>
RemainAfterExit=true
Type=oneshot

[Install]
WantedBy=multi-user.target
