[Unit]
After=systemd-user-sessions.service
Description=Autologin Getty on tty1

[Service]
Environment="PATH=/nix/store/<HASH>-coreutils-9.5/bin:/nix/store/<HASH>-findutils-4.10.0/bin:/nix/store/<HASH>-grep-3.11/bin:/nix/store/<HASH>-sed-4.9/bin:/nix/store/<HASH>-systemd-259.1/bin:/nix/store/<HASH>-coreutils-9.5/sbin:/nix/store/<HASH>-findutils-4.10.0/sbin:/nix/store/<HASH>-grep-3.11/sbin:/nix/store/<HASH>-sed-4.9/sbin:/nix/store/<HASH>-systemd-259.1/sbin"
ExecStart=
ExecStart=/nix/store/<HASH>-util-linux-2.42.1/sbin/agetty --autologin root --login-program=/nix/store/<HASH>-autologin-shell/bin/autologin-shell --noclear tty1 linux
Restart=always
RestartSec=0
SendSIGHUP=yes
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Type=idle
UtmpIdentifier=tty1

[Install]
WantedBy=getty.target
