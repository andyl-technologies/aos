[Unit]
After=local-fs.target
Before=network-pre.target
Description=nftables Firewall
Wants=network-pre.target
X-Reload-Triggers=/etc/nftables.conf
X-ReloadIfChanged=true

[Service]
Environment="PATH=/nix/store/<hash>-coreutils-9.5/bin:/nix/store/<hash>-findutils-4.10.0/bin:/nix/store/<hash>-grep-3.11/bin:/nix/store/<hash>-sed-4.9/bin:/nix/store/<hash>-systemd-259.1/bin:/nix/store/<hash>-coreutils-9.5/sbin:/nix/store/<hash>-findutils-4.10.0/sbin:/nix/store/<hash>-grep-3.11/sbin:/nix/store/<hash>-sed-4.9/sbin:/nix/store/<hash>-systemd-259.1/sbin"
ExecReload=/nix/store/<hash>-nftables-1.1.1/sbin/nft -f /etc/nftables.conf
ExecStart=/nix/store/<hash>-nftables-1.1.1/sbin/nft -f /etc/nftables.conf
ExecStop=/nix/store/<hash>-nftables-1.1.1/sbin/nft flush ruleset
RemainAfterExit=true
Type=oneshot

[Install]
WantedBy=multi-user.target
