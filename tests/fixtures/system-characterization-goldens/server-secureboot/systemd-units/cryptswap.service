[Unit]
After=local-fs.target dev-disk-by\x2dpartlabel-swap.device
Before=swap.target
ConditionPathExists=/dev/disk/by-partlabel/swap
DefaultDependencies=no
Description=Set Up Encrypted Swap
Requires=dev-disk-by\x2dpartlabel-swap.device

[Service]
Environment="PATH=/nix/store/fz9lrsrqpxhzmkhrbqzndjkh3fl9pygg-coreutils-9.5/bin:/nix/store/z5ydjk898pi7gz5gsdg8wfjwc4gl3bjv-findutils-4.10.0/bin:/nix/store/4zjrri4rqijr7s5jd1796a56vxfa37z0-grep-3.11/bin:/nix/store/j1pcpd7inhi6vkpdd3hmyc85ilss1hir-sed-4.9/bin:/nix/store/672bsqx8rpgn62q1vfvycw3ld8qz4nwc-systemd-259.1/bin:/nix/store/fz9lrsrqpxhzmkhrbqzndjkh3fl9pygg-coreutils-9.5/sbin:/nix/store/z5ydjk898pi7gz5gsdg8wfjwc4gl3bjv-findutils-4.10.0/sbin:/nix/store/4zjrri4rqijr7s5jd1796a56vxfa37z0-grep-3.11/sbin:/nix/store/j1pcpd7inhi6vkpdd3hmyc85ilss1hir-sed-4.9/sbin:/nix/store/672bsqx8rpgn62q1vfvycw3ld8qz4nwc-systemd-259.1/sbin"
ExecStart=<<aos-job-script>>
#!/nix/store/inkxqwa69sgkj934172yi7bwv97l726g-bash-5.2.37/bin/bash
set -e

set -euo pipefail
swap_dev=/dev/disk/by-partlabel/swap
dm_name=cryptswap

if [ -e /dev/mapper/$dm_name ]; then
  exit 0
fi

/nix/store/r1aipmpjdxkk2h9dvh7cz3zqgz6aaxsq-cryptsetup-2.8.4/sbin/cryptsetup open --type=plain \
  --cipher=aes-xts-plain64 \
  --key-size=256 \
  --key-file=/dev/urandom \
  "$swap_dev" "$dm_name"

/nix/store/frx251bq8f1b8vk84misiqfl9zm8fimg-util-linux-2.42.1/sbin/mkswap /dev/mapper/$dm_name
/nix/store/frx251bq8f1b8vk84misiqfl9zm8fimg-util-linux-2.42.1/sbin/swapon /dev/mapper/$dm_name
<<aos-job-script-end>>
ExecStop=<<aos-job-script>>
#!/nix/store/inkxqwa69sgkj934172yi7bwv97l726g-bash-5.2.37/bin/bash
set -e

set -eu
if /nix/store/frx251bq8f1b8vk84misiqfl9zm8fimg-util-linux-2.42.1/sbin/swapon --show=NAME --noheadings \
    | grep -qx /dev/mapper/cryptswap; then
  /nix/store/frx251bq8f1b8vk84misiqfl9zm8fimg-util-linux-2.42.1/sbin/swapoff /dev/mapper/cryptswap
fi
if [ -e /dev/mapper/cryptswap ]; then
  /nix/store/r1aipmpjdxkk2h9dvh7cz3zqgz6aaxsq-cryptsetup-2.8.4/sbin/cryptsetup close cryptswap
fi
<<aos-job-script-end>>
RemainAfterExit=true
Type=oneshot

[Install]
WantedBy=swap.target
