[Unit]
After=aos-graph-compile.service aos-activate.service
Before=multi-user.target
Description=Apply AOS package preset policy
Wants=aos-graph-compile.service

[Service]
Environment="PATH=/nix/store/<hash>-coreutils-9.5/bin:/nix/store/<hash>-findutils-4.10.0/bin:/nix/store/<hash>-grep-3.11/bin:/nix/store/<hash>-sed-4.9/bin:/nix/store/<hash>-systemd-259.1/bin:/nix/store/<hash>-coreutils-9.5/sbin:/nix/store/<hash>-findutils-4.10.0/sbin:/nix/store/<hash>-grep-3.11/sbin:/nix/store/<hash>-sed-4.9/sbin:/nix/store/<hash>-systemd-259.1/sbin"
ExecStart=<<aos-job-script>>
#!/nix/store/<hash>-bash-5.2.37/bin/bash
set -e

/nix/store/<hash>-systemd-259.1/bin/systemctl preset-all --preset-mode=enable-only

targets="$(
  /nix/store/<hash>-systemd-259.1/bin/systemctl list-unit-files 'aos-pkg-*.target' \
    --type=target \
    --state=enabled \
    --no-legend \
    --no-pager 2>/dev/null \
    | while read -r unit _rest; do
        [ -n "$unit" ] && printf '%s\n' "$unit"
      done
)"

if [ -n "$targets" ]; then
  /nix/store/<hash>-systemd-259.1/bin/systemctl start --no-block $targets
fi
<<aos-job-script-end>>
RemainAfterExit=true
Type=oneshot

[Install]
WantedBy=multi-user.target
