[Unit]
After=aos-seed-baked-packages.service aos-install-baked-packages.service
Description=Produce AOS package attestation quote

[Service]
Environment="PATH=/nix/store/fz9lrsrqpxhzmkhrbqzndjkh3fl9pygg-coreutils-9.5/bin:/nix/store/z5ydjk898pi7gz5gsdg8wfjwc4gl3bjv-findutils-4.10.0/bin:/nix/store/4zjrri4rqijr7s5jd1796a56vxfa37z0-grep-3.11/bin:/nix/store/j1pcpd7inhi6vkpdd3hmyc85ilss1hir-sed-4.9/bin:/nix/store/672bsqx8rpgn62q1vfvycw3ld8qz4nwc-systemd-259.1/bin:/nix/store/fz9lrsrqpxhzmkhrbqzndjkh3fl9pygg-coreutils-9.5/sbin:/nix/store/z5ydjk898pi7gz5gsdg8wfjwc4gl3bjv-findutils-4.10.0/sbin:/nix/store/4zjrri4rqijr7s5jd1796a56vxfa37z0-grep-3.11/sbin:/nix/store/j1pcpd7inhi6vkpdd3hmyc85ilss1hir-sed-4.9/sbin:/nix/store/672bsqx8rpgn62q1vfvycw3ld8qz4nwc-systemd-259.1/sbin"
ExecStart=<<aos-job-script>>
#!/nix/store/inkxqwa69sgkj934172yi7bwv97l726g-bash-5.2.37/bin/bash
set -e

nonce_file=/run/aos-attest/nonce
event_log=/run/log/aos-packages.cel
output_dir=/var/lib/aos-attest/quote
quote_json=/var/lib/aos-attest/quote.json
quote_json_tmp=/var/lib/aos-attest/quote.json.tmp
cleanup() {
  status=$?
  if ! /nix/store/fz9lrsrqpxhzmkhrbqzndjkh3fl9pygg-coreutils-9.5/bin/rm -f -- "$nonce_file" "$quote_json_tmp"; then
    if [ "$status" -eq 0 ]; then
      status=1
    fi
  fi
  exit "$status"
}
trap cleanup EXIT
# Package attestation produces a TPM quote over PCR 15. On TPM-less
# machines the PCR measurement is skipped entirely (see
# `measure_activated_packages` in crates/aos-package), so there is
# nothing to quote — skip cleanly instead of failing. This keeps the
# `apm upgrade --system` reconcile from failing on TPM-less hosts that
# bundle an exposed package (the same "degrade gracefully" intent as the
# measurement gate). `tpm2_tcti` probes these same device nodes.
if [ ! -e /dev/tpmrm0 ] && [ ! -e /dev/tpm0 ]; then
  echo "no TPM device; skipping package attestation quote" >&2
  exit 0
fi
if [ ! -s "$nonce_file" ]; then
  echo "write verifier nonce hex to $nonce_file before starting aos-attest.service" >&2
  exit 2
fi
if [ ! -s "$event_log" ]; then
  echo "package attestation event log $event_log is not ready" >&2
  exit 3
fi
/nix/store/fz9lrsrqpxhzmkhrbqzndjkh3fl9pygg-coreutils-9.5/bin/rm -rf -- "$output_dir"
/nix/store/fz9lrsrqpxhzmkhrbqzndjkh3fl9pygg-coreutils-9.5/bin/rm -f -- "$quote_json" "$quote_json_tmp"
/nix/store/y860ysgpqjmgsg1zsdb651kwd7v6dnwv-aos-0.1.0/bin/apm --json attest quote --nonce-file "$nonce_file" --output-dir "$output_dir" > "$quote_json_tmp"
/nix/store/fz9lrsrqpxhzmkhrbqzndjkh3fl9pygg-coreutils-9.5/bin/mv -f -- "$quote_json_tmp" "$quote_json"
<<aos-job-script-end>>
RuntimeDirectory=aos-attest
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StateDirectory=aos-attest
StateDirectoryMode=0700
Type=oneshot
