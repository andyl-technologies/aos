[Unit]
After=local-fs.target systemd-tmpfiles-setup.service dbus.socket
Description=D-Bus System Message Bus
Requires=dbus.socket systemd-tmpfiles-setup.service
X-ReloadIfChanged=true

[Service]
Environment="PATH=/nix/store/fz9lrsrqpxhzmkhrbqzndjkh3fl9pygg-coreutils-9.5/bin:/nix/store/z5ydjk898pi7gz5gsdg8wfjwc4gl3bjv-findutils-4.10.0/bin:/nix/store/4zjrri4rqijr7s5jd1796a56vxfa37z0-grep-3.11/bin:/nix/store/j1pcpd7inhi6vkpdd3hmyc85ilss1hir-sed-4.9/bin:/nix/store/672bsqx8rpgn62q1vfvycw3ld8qz4nwc-systemd-259.1/bin:/nix/store/fz9lrsrqpxhzmkhrbqzndjkh3fl9pygg-coreutils-9.5/sbin:/nix/store/z5ydjk898pi7gz5gsdg8wfjwc4gl3bjv-findutils-4.10.0/sbin:/nix/store/4zjrri4rqijr7s5jd1796a56vxfa37z0-grep-3.11/sbin:/nix/store/j1pcpd7inhi6vkpdd3hmyc85ilss1hir-sed-4.9/sbin:/nix/store/672bsqx8rpgn62q1vfvycw3ld8qz4nwc-systemd-259.1/sbin"
ExecReload=/nix/store/jjaz2x0iywy3wxwhlgxalmkavd4693br-dbus-1.14.10/bin/dbus-send --print-reply --system --type=method_call --dest=org.freedesktop.DBus / org.freedesktop.DBus.ReloadConfig
ExecStart=/nix/store/jjaz2x0iywy3wxwhlgxalmkavd4693br-dbus-1.14.10/bin/dbus-daemon --address=systemd: --nofork --nopidfile --systemd-activation --config-file=/nix/store/gpvp5mbhbiwrl1awng8r42frl2m4n0gc-aos-dbus-1/system.conf
LimitNOFILE=16384
NotifyAccess=main
OOMScoreAdjust=-900
Restart=on-failure
RestartSec=5s
RuntimeDirectory=dbus
RuntimeDirectoryMode=0755
Type=notify

[Install]
Alias=messagebus.service
WantedBy=multi-user.target
