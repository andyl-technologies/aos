[Unit]
After=local-fs.target systemd-tmpfiles-setup.service dbus.socket
Description=D-Bus System Message Bus
Requires=dbus.socket systemd-tmpfiles-setup.service
X-ReloadIfChanged=true

[Service]
Environment="PATH=/nix/store/<hash>-coreutils-9.5/bin:/nix/store/<hash>-findutils-4.10.0/bin:/nix/store/<hash>-grep-3.11/bin:/nix/store/<hash>-sed-4.9/bin:/nix/store/<hash>-systemd-259.1/bin:/nix/store/<hash>-coreutils-9.5/sbin:/nix/store/<hash>-findutils-4.10.0/sbin:/nix/store/<hash>-grep-3.11/sbin:/nix/store/<hash>-sed-4.9/sbin:/nix/store/<hash>-systemd-259.1/sbin"
ExecReload=/nix/store/<hash>-dbus-1.14.10/bin/dbus-send --print-reply --system --type=method_call --dest=org.freedesktop.DBus / org.freedesktop.DBus.ReloadConfig
ExecStart=/nix/store/<hash>-dbus-1.14.10/bin/dbus-daemon --address=systemd: --nofork --nopidfile --systemd-activation --config-file=/nix/store/<hash>-aos-dbus-1/system.conf
LimitNOFILE=16384
NotifyAccess=main
OOMScoreAdjust=-900
Restart=on-failure
RestartSec=5s
RuntimeDirectory=dbus
RuntimeDirectoryMode=0755
Type=notify

[Install]
Alias=messagebus.service
WantedBy=multi-user.target
