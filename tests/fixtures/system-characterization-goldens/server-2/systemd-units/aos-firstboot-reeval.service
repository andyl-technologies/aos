[Unit]
After=aos-seed-profiles.service
Before=aos-host-config-restore.service aos-eval.service multi-user.target
Description=Detect a running-image change requiring host re-evaluation
Requires=aos-seed-profiles.service

[Service]
Environment="PATH=/nix/store/fz9lrsrqpxhzmkhrbqzndjkh3fl9pygg-coreutils-9.5/bin:/nix/store/z5ydjk898pi7gz5gsdg8wfjwc4gl3bjv-findutils-4.10.0/bin:/nix/store/4zjrri4rqijr7s5jd1796a56vxfa37z0-grep-3.11/bin:/nix/store/j1pcpd7inhi6vkpdd3hmyc85ilss1hir-sed-4.9/bin:/nix/store/m58yqnq046yq05x3800az9qls9qwrdnh-systemd-259.1/bin:/nix/store/fz9lrsrqpxhzmkhrbqzndjkh3fl9pygg-coreutils-9.5/sbin:/nix/store/z5ydjk898pi7gz5gsdg8wfjwc4gl3bjv-findutils-4.10.0/sbin:/nix/store/4zjrri4rqijr7s5jd1796a56vxfa37z0-grep-3.11/sbin:/nix/store/j1pcpd7inhi6vkpdd3hmyc85ilss1hir-sed-4.9/sbin:/nix/store/m58yqnq046yq05x3800az9qls9qwrdnh-systemd-259.1/sbin"
ExecStart=<<aos-job-script>>
#!/nix/store/inkxqwa69sgkj934172yi7bwv97l726g-bash-5.2.37/bin/bash
set -e

set -eu
image_state=/var/lib/profiles/image/state.json
config_state=/var/lib/profiles/system/state.json
[ -s "$image_state" ] && [ -s "$config_state" ] || exit 1
running=$(/nix/store/i1dx1y98kj227w25kdhil47c64z6acn7-jq-1.8.1/bin/jq -er '.running' "$image_state")

# Reconcile the userspace-to-firmware selection journal before the
# evaluation graph can fail. A crash can leave this intent after the
# authenticated pending state or bootloader default was published. At
# this point aos-seed-profiles has authenticated the image that really
# booted, so the journal no longer needs to block an operator rollback.
stable_entry_id() {
  name=$1
  case "$name" in
    */*|"") return 1 ;;
    *.efi) ;;
    *) return 1 ;;
  esac
  stem=${name%.efi}
  case "$stem" in
    *+*)
      suffix=${stem##*+}
      tries=${suffix%%-*}
      case "$tries" in ""|*[!0-9]*) printf '%s\n' "$name"; return 0 ;; esac
      case "$suffix" in
        *-*)
          completed=${suffix#*-}
          case "$completed" in ""|*[!0-9]*|*-*) printf '%s\n' "$name"; return 0 ;; esac
          ;;
      esac
      printf '%s.efi\n' "${stem%+*}"
      ;;
    *) printf '%s\n' "$name" ;;
  esac
}
transition_intent=/var/lib/profiles/image/.transition-intent.json
if [ -s "$transition_intent" ]; then
  target=$(/nix/store/i1dx1y98kj227w25kdhil47c64z6acn7-jq-1.8.1/bin/jq -er '.target | select(type == "number" and . >= 0 and floor == .)' "$transition_intent")
  intent_entry=$(/nix/store/i1dx1y98kj227w25kdhil47c64z6acn7-jq-1.8.1/bin/jq -er '.entry_id | select(type == "string" and length > 0)' "$transition_intent")
  recorded_entry=$(/nix/store/i1dx1y98kj227w25kdhil47c64z6acn7-jq-1.8.1/bin/jq -er \
    --argjson target "$target" \
    '.generations[] | select(.number == $target) | .uki_path' \
    "$image_state")
  recorded_entry=${recorded_entry##*/}
  recorded_stable=$(stable_entry_id "$recorded_entry")
  intent_stable=$(stable_entry_id "$intent_entry")
  if [ "$recorded_stable" != "$intent_stable" ]; then
    echo "aos-firstboot-reeval: image transition intent disagrees with authenticated generation $target" >&2
    exit 1
  fi
  if [ "$target" -eq "$running" ]; then
    state_update='.default = $running'
  else
    state_update='.default = $running | .pending = null'
  fi
  /nix/store/i1dx1y98kj227w25kdhil47c64z6acn7-jq-1.8.1/bin/jq --argjson running "$running" "$state_update" \
    "$image_state" > "${image_state}.new"
  /nix/store/fz9lrsrqpxhzmkhrbqzndjkh3fl9pygg-coreutils-9.5/bin/sync -f "${image_state}.new"
  mv "${image_state}.new" "$image_state"
  /nix/store/fz9lrsrqpxhzmkhrbqzndjkh3fl9pygg-coreutils-9.5/bin/sync -f /var/lib/profiles/image
  rm -f "$transition_intent"
  /nix/store/fz9lrsrqpxhzmkhrbqzndjkh3fl9pygg-coreutils-9.5/bin/sync -f /var/lib/profiles/image
fi

parent=$(/nix/store/i1dx1y98kj227w25kdhil47c64z6acn7-jq-1.8.1/bin/jq -er \
  '.current as $current | [.generations[] | select(.number == $current) | .image_gen_parent][0] // 0' \
  "$config_state")
pending=$(/nix/store/i1dx1y98kj227w25kdhil47c64z6acn7-jq-1.8.1/bin/jq -er '.pending // 0' "$image_state")
if [ "$running" != "$parent" ] || [ "$pending" -ne 0 ]; then
  printf '%s\n' "$running" > /run/aos/image-reeval-required
else
  rm -f /run/aos/image-reeval-required
fi
<<aos-job-script-end>>
RemainAfterExit=true
RuntimeDirectory=aos
Type=oneshot

[Install]
WantedBy=multi-user.target
