[Unit]
After=local-fs.target aos-config-seed.service
Before=aos-host-config-restore.service aos-eval.service multi-user.target
Description=Persist provisioning evidence and manual repart definitions
Requires=local-fs.target

[Service]
Environment="PATH=/nix/store/<hash>-coreutils-9.5/bin:/nix/store/<hash>-findutils-4.10.0/bin:/nix/store/<hash>-grep-3.11/bin:/nix/store/<hash>-sed-4.9/bin:/nix/store/<hash>-systemd-259.1/bin:/nix/store/<hash>-coreutils-9.5/sbin:/nix/store/<hash>-findutils-4.10.0/sbin:/nix/store/<hash>-grep-3.11/sbin:/nix/store/<hash>-sed-4.9/sbin:/nix/store/<hash>-systemd-259.1/sbin"
ExecStart=<<aos-job-script>>
#!/nix/store/<hash>-bash-5.2.37/bin/bash
set -e

/nix/store/<hash>-aos-0.1.0/bin/aos metadata persist-provisioning \
  --state-dir /var/lib/aos-provisioning \
  --module-abi 1 \
  --image-version test-2
<<aos-job-script-end>>
RemainAfterExit=true
StateDirectory=aos-provisioning
StateDirectoryMode=0700
Type=oneshot

[Install]
WantedBy=multi-user.target
