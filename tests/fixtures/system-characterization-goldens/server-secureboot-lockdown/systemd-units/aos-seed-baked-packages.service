[Unit]
After=aos-seed-profiles.service nix-overlay-setup.service
Before=aos-install-baked-packages.service aos-preset.service multi-user.target
Description=Seed baked AOS package profile

[Service]
Environment="PATH=/nix/store/<hash>-coreutils-9.5/bin:/nix/store/<hash>-findutils-4.10.0/bin:/nix/store/<hash>-grep-3.11/bin:/nix/store/<hash>-sed-4.9/bin:/nix/store/<hash>-systemd-259.1/bin:/nix/store/<hash>-coreutils-9.5/sbin:/nix/store/<hash>-findutils-4.10.0/sbin:/nix/store/<hash>-grep-3.11/sbin:/nix/store/<hash>-sed-4.9/sbin:/nix/store/<hash>-systemd-259.1/sbin"
ExecStart=<<aos-job-script>>
#!/nix/store/<hash>-bash-5.2.37/bin/bash
set -e

profile=/var/lib/profiles/system-packages
if [ ! -e "$profile/state.json" ]; then
  if [ -f /etc/aos/packages.d/fleet-seed ]; then
    /nix/store/<hash>-coreutils-9.5/bin/mkdir -p "$profile/gen-1/usr" "$profile/gen-1/expose" "$profile/gen-1/cfgsrc" "$profile/gen-1/meta" "$profile/meta"
    printf '%s\n' '{"current_generation":1,"next_generation":2}' > "$profile/state.json"
    /nix/store/<hash>-coreutils-9.5/bin/ln -sfn gen-1 "$profile/current"
    seed_one() {
      case "$1" in
  aos-test-agent)
  /nix/store/<hash>-coreutils-9.5/bin/ln -sfn /nix/store/<hash>-aos-test-agent-0 "$profile/gen-1/usr/<store-identity>"
  /nix/store/<hash>-coreutils-9.5/bin/ln -sfn /nix/store/<hash>-expose-aos-test-agent "$profile/gen-1/expose/<store-identity>"
  /nix/store/<hash>-coreutils-9.5/bin/ln -sfn /nix/store/<hash>-aos-test-agent-config-0-config "$profile/gen-1/cfgsrc/<store-identity>"

  /nix/store/<hash>-coreutils-9.5/bin/cp /nix/store/<hash>-aos-package-aos-test-agent-meta.json/ri7af9743dclplw3vcyh9bv9bdk92in1.json "$profile/meta/<store-identity>.json"
  /nix/store/<hash>-coreutils-9.5/bin/cp /nix/store/<hash>-aos-package-aos-test-agent-meta.json/ri7af9743dclplw3vcyh9bv9bdk92in1.json "$profile/gen-1/meta/<store-identity>.json"
  ;;

        *)
          echo "unknown bundled AOS package seed '$1'" >&2
          exit 1
          ;;
      esac
    }
    while IFS= read -r package || [ -n "$package" ]; do
      [ -n "$package" ] || continue
      seed_one "$package"
    done < /etc/aos/packages.d/fleet-seed
  else
    /nix/store/<hash>-coreutils-9.5/bin/mkdir -p "$profile"
    /nix/store/<hash>-coreutils-9.5/bin/cp -a /nix/store/<hash>-aos-package-profile-seed/. "$profile/"
  fi
fi
AOS_EXPOSE_START_NO_WAIT=1 /nix/store/<hash>-aos-reconcile-exposed-units/bin/aos-reconcile-exposed-units --system
<<aos-job-script-end>>
RemainAfterExit=true
Type=oneshot

[Install]
WantedBy=multi-user.target
