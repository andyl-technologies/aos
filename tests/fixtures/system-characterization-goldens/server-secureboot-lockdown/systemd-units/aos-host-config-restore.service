[Unit]
After=aos-provisioning-persist.service aos-firstboot-reeval.service
Before=aos-eval.service multi-user.target
Description=Restore the last fully evaluated host input

[Service]
Environment="PATH=/nix/store/fz9lrsrqpxhzmkhrbqzndjkh3fl9pygg-coreutils-9.5/bin:/nix/store/z5ydjk898pi7gz5gsdg8wfjwc4gl3bjv-findutils-4.10.0/bin:/nix/store/4zjrri4rqijr7s5jd1796a56vxfa37z0-grep-3.11/bin:/nix/store/j1pcpd7inhi6vkpdd3hmyc85ilss1hir-sed-4.9/bin:/nix/store/672bsqx8rpgn62q1vfvycw3ld8qz4nwc-systemd-259.1/bin:/nix/store/fz9lrsrqpxhzmkhrbqzndjkh3fl9pygg-coreutils-9.5/sbin:/nix/store/z5ydjk898pi7gz5gsdg8wfjwc4gl3bjv-findutils-4.10.0/sbin:/nix/store/4zjrri4rqijr7s5jd1796a56vxfa37z0-grep-3.11/sbin:/nix/store/j1pcpd7inhi6vkpdd3hmyc85ilss1hir-sed-4.9/sbin:/nix/store/672bsqx8rpgn62q1vfvycw3ld8qz4nwc-systemd-259.1/sbin"
ExecStart=<<aos-job-script>>
#!/nix/store/inkxqwa69sgkj934172yi7bwv97l726g-bash-5.2.37/bin/bash
set -e

set -eu
if [ ! -e "/run/aos-metadata/host.nix" ]; then
  if ! /nix/store/iclrfmjn54cxl4ji6pdfgdmbx3c151mg-aos-0.1.0/bin/aos metadata restore-runtime \
    --state-dir /var/lib/aos-provisioning; then
    echo "aos-eval: cached host input is invalid; retaining the active generation" >&2
    exit 1
  fi
fi

# A missing operator input is legitimate only when no operator-backed
# generation has ever been committed. If fresh metadata and the
# authenticated cache are both absent after a platform/signed
# generation, fail closed instead of evaluating `{}` and silently
# erasing the host's policy.
if [ ! -e "/run/aos-metadata/host.nix" ] && [ -s /var/lib/profiles/system/state.json ]; then
  current=$(/nix/store/i1dx1y98kj227w25kdhil47c64z6acn7-jq-1.8.1/bin/jq -er '.current' /var/lib/profiles/system/state.json)
  # The seeded image state deliberately has no config generation yet.
  # Its first stage-2 transaction must be allowed to evaluate the
  # authenticated image-default empty module and create gen-1.
  if [ "$current" -eq 0 ] && /nix/store/i1dx1y98kj227w25kdhil47c64z6acn7-jq-1.8.1/bin/jq -e '.generations == []' \
    /var/lib/profiles/system/state.json >/dev/null; then
    :
  else
    manifest="/var/lib/profiles/system/gen-$current/manifest.json"
    [ -s "$manifest" ] || {
      echo "aos-eval: current generation has no retained host provenance; retaining it" >&2
      exit 1
    }
    trust=$(/nix/store/i1dx1y98kj227w25kdhil47c64z6acn7-jq-1.8.1/bin/jq -er '.inputs.host_nix.trust_mode' "$manifest")
    case "$trust" in
      image|image-default) ;;
      *)
        echo "aos-eval: operator-backed host input is unavailable; retaining generation $current" >&2
        exit 1
        ;;
    esac
  fi
fi
<<aos-job-script-end>>
RemainAfterExit=true
StateDirectory=aos-provisioning
StateDirectoryMode=0700
Type=oneshot

[Install]
WantedBy=multi-user.target
