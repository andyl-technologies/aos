[Unit]
After=local-fs.target aos-seed-baked-packages.service aos-install-baked-packages.service
Before=multi-user.target
ConditionPathExists=/etc/aos/policy.toml
Description=Load AOS fleet BPF-LSM policies

[Service]
Environment="PATH=/nix/store/<hash>-coreutils-9.5/bin:/nix/store/<hash>-findutils-4.10.0/bin:/nix/store/<hash>-grep-3.11/bin:/nix/store/<hash>-sed-4.9/bin:/nix/store/<hash>-systemd-259.1/bin:/nix/store/<hash>-coreutils-9.5/sbin:/nix/store/<hash>-findutils-4.10.0/sbin:/nix/store/<hash>-grep-3.11/sbin:/nix/store/<hash>-sed-4.9/sbin:/nix/store/<hash>-systemd-259.1/sbin"
AmbientCapabilities=
CapabilityBoundingSet=CAP_BPF CAP_SYS_ADMIN CAP_SYS_RESOURCE
DevicePolicy=closed
ExecStart=/nix/store/<hash>-aos-0.1.0/bin/apm _load-ebpf-lsm-policies --system
ExecStartPre=/nix/store/<hash>-aos-prepare-ebpf-lsm-bpffs/bin/aos-prepare-ebpf-lsm-bpffs
LimitMEMLOCK=infinity
MemoryDenyWriteExecute=true
NoNewPrivileges=false
PrivateDevices=true
PrivateNetwork=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/sys/fs/bpf
RemainAfterExit=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service mount umount2 bpf
Type=oneshot

[Install]
WantedBy=multi-user.target
