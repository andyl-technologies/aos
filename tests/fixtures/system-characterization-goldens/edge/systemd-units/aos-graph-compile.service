[Unit]
After=aos-eval.service
Before=aos-preset.service multi-user.target
ConditionPathExists=/run/aos/manifest.json
Description=Compile the AOS config eval output into a systemd unit graph
Wants=aos-eval.service

[Service]
Environment="PATH=/nix/store/<hash>-coreutils-9.5/bin:/nix/store/<hash>-findutils-4.10.0/bin:/nix/store/<hash>-grep-3.11/bin:/nix/store/<hash>-sed-4.9/bin:/nix/store/<hash>-systemd-259.1/bin:/nix/store/<hash>-coreutils-9.5/sbin:/nix/store/<hash>-findutils-4.10.0/sbin:/nix/store/<hash>-grep-3.11/sbin:/nix/store/<hash>-sed-4.9/sbin:/nix/store/<hash>-systemd-259.1/sbin"
ExecStart=/nix/store/<hash>-aos-0.1.0/bin/apm __graph-compile --manifest /run/aos/manifest.json --graph /run/aos/graph.json
NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/run/aos
ReadWritePaths=/run/systemd/system
RemainAfterExit=true
Type=oneshot
UMask=0077

[Install]
WantedBy=multi-user.target
