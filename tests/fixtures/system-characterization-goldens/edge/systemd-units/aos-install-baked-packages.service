[Unit]
After=aos-eval.service aos-config-seed.service aos-seed-profiles.service nix-overlay-setup.service
Before=aos-preset.service multi-user.target
ConditionPathExists=/etc/aos/packages.d/desired.toml
Description=Reconcile image-baked AOS desired packages

[Service]
Environment="PATH=/nix/store/<hash>-coreutils-9.5/bin:/nix/store/<hash>-findutils-4.10.0/bin:/nix/store/<hash>-grep-3.11/bin:/nix/store/<hash>-sed-4.9/bin:/nix/store/<hash>-systemd-259.1/bin:/nix/store/<hash>-coreutils-9.5/sbin:/nix/store/<hash>-findutils-4.10.0/sbin:/nix/store/<hash>-grep-3.11/sbin:/nix/store/<hash>-sed-4.9/sbin:/nix/store/<hash>-systemd-259.1/sbin"
ExecStart=<<aos-job-script>>
#!/nix/store/<hash>-bash-5.2.37/bin/bash
set -e

# A host-eval manifest belongs to the unit graph. Never run a
# second, monolithic reconciler over the same desired state.
if [ -e /run/aos/manifest.json ]; then
  exit 0
fi
AOS_EXPOSE_START_NO_WAIT=1 /nix/store/<hash>-aos-0.1.0/bin/apm install --system --from /etc/aos/packages.d/desired.toml --yes
<<aos-job-script-end>>
RemainAfterExit=true
TimeoutStartSec=2min
Type=oneshot

[Install]
WantedBy=multi-user.target
