[Unit]
After=aos-config-render.target aos-fetch.target aos-seed-profiles.service
Before=aos-preset.service
ConditionPathExists=/run/aos/manifest.json
Description=Commit the evaluated AOS host configuration
StartLimitBurst=3
StartLimitIntervalSec=30s
Wants=aos-config-render.target aos-fetch.target

[Service]
Environment="PATH=/nix/store/<hash>-coreutils-9.5/bin:/nix/store/<hash>-findutils-4.10.0/bin:/nix/store/<hash>-grep-3.11/bin:/nix/store/<hash>-sed-4.9/bin:/nix/store/<hash>-systemd-259.1/bin:/nix/store/<hash>-coreutils-9.5/sbin:/nix/store/<hash>-findutils-4.10.0/sbin:/nix/store/<hash>-grep-3.11/sbin:/nix/store/<hash>-sed-4.9/sbin:/nix/store/<hash>-systemd-259.1/sbin"
ExecStart=<<aos-job-script>>
#!/nix/store/<hash>-bash-5.2.37/bin/bash
set -e

set +e
/nix/store/<hash>-aos-0.1.0/bin/apm __activate-config \
  --manifest /run/aos/manifest.json \
  --graph /run/aos/graph.json \
  --module-abi 1 --require-attestation-quote
rc=$?
set -e
if [ "$rc" -eq 4 ]; then
  echo "aos-activate: /etc swap is indeterminate; entering rescue mode" >&2
  /nix/store/<hash>-systemd-259.1/bin/systemctl --no-block isolate rescue.target
fi
if [ "$rc" -eq 6 ]; then
  # The transaction committed after dropping unavailable package
  # projections. Keep the degraded outcome in activation.json while
  # allowing the ordering service and aos-config.target to settle.
  echo "aos-activate: committed a degraded host configuration" >&2
  exit 0
fi
exit "$rc"
<<aos-job-script-end>>
RemainAfterExit=true
Restart=on-failure
RestartPreventExitStatus=4
RestartSec=2s
TimeoutStartSec=180s
Type=oneshot
