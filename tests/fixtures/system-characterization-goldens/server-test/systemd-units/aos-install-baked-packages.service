[Unit]
After=aos-eval.service aos-config-seed.service aos-seed-profiles.service nix-overlay-setup.service
Before=aos-preset.service multi-user.target
ConditionPathExists=/etc/aos/packages.d/desired.toml
Description=Reconcile image-baked AOS desired packages

[Service]
Environment="PATH=/nix/store/fz9lrsrqpxhzmkhrbqzndjkh3fl9pygg-coreutils-9.5/bin:/nix/store/z5ydjk898pi7gz5gsdg8wfjwc4gl3bjv-findutils-4.10.0/bin:/nix/store/4zjrri4rqijr7s5jd1796a56vxfa37z0-grep-3.11/bin:/nix/store/j1pcpd7inhi6vkpdd3hmyc85ilss1hir-sed-4.9/bin:/nix/store/m58yqnq046yq05x3800az9qls9qwrdnh-systemd-259.1/bin:/nix/store/fz9lrsrqpxhzmkhrbqzndjkh3fl9pygg-coreutils-9.5/sbin:/nix/store/z5ydjk898pi7gz5gsdg8wfjwc4gl3bjv-findutils-4.10.0/sbin:/nix/store/4zjrri4rqijr7s5jd1796a56vxfa37z0-grep-3.11/sbin:/nix/store/j1pcpd7inhi6vkpdd3hmyc85ilss1hir-sed-4.9/sbin:/nix/store/m58yqnq046yq05x3800az9qls9qwrdnh-systemd-259.1/sbin"
ExecStart=<<aos-job-script>>
#!/nix/store/inkxqwa69sgkj934172yi7bwv97l726g-bash-5.2.37/bin/bash
set -e

# A host-eval manifest belongs to the unit graph. Never run a
# second, monolithic reconciler over the same desired state.
if [ -e /run/aos/manifest.json ]; then
  exit 0
fi
AOS_EXPOSE_START_NO_WAIT=1 /nix/store/apag7nvpzi1k39lszb3kkag18j6dhmyd-aos-0.1.0/bin/apm install --system --from /etc/aos/packages.d/desired.toml --yes
<<aos-job-script-end>>
RemainAfterExit=true
TimeoutStartSec=2min
Type=oneshot

[Install]
WantedBy=multi-user.target
