[Unit]
After=local-fs.target
Before=multi-user.target
Description=Seed Nix store database and AOS GC roots

[Service]
Environment="PATH=/nix/store/fz9lrsrqpxhzmkhrbqzndjkh3fl9pygg-coreutils-9.5/bin:/nix/store/z5ydjk898pi7gz5gsdg8wfjwc4gl3bjv-findutils-4.10.0/bin:/nix/store/4zjrri4rqijr7s5jd1796a56vxfa37z0-grep-3.11/bin:/nix/store/j1pcpd7inhi6vkpdd3hmyc85ilss1hir-sed-4.9/bin:/nix/store/m58yqnq046yq05x3800az9qls9qwrdnh-systemd-259.1/bin:/nix/store/fz9lrsrqpxhzmkhrbqzndjkh3fl9pygg-coreutils-9.5/sbin:/nix/store/z5ydjk898pi7gz5gsdg8wfjwc4gl3bjv-findutils-4.10.0/sbin:/nix/store/4zjrri4rqijr7s5jd1796a56vxfa37z0-grep-3.11/sbin:/nix/store/j1pcpd7inhi6vkpdd3hmyc85ilss1hir-sed-4.9/sbin:/nix/store/m58yqnq046yq05x3800az9qls9qwrdnh-systemd-259.1/sbin"
ExecStart=<<aos-job-script>>
#!/nix/store/inkxqwa69sgkj934172yi7bwv97l726g-bash-5.2.37/bin/bash
set -e

set -euo pipefail

# Initialise the store layout/schema if absent. Loading the registration
# stream is idempotent and does not canonicalise/chown store contents.
/nix/store/s06fk05p64jrww40ncam4kncidjbnblv-nix-2.24.12/bin/nix-store --init || true
if [ -r /aos-registration ]; then
  /nix/store/s06fk05p64jrww40ncam4kncidjbnblv-nix-2.24.12/bin/nix-store --load-db < /aos-registration
fi

# Nix's GC follows symlinks under gcroots recursively. This bridge makes
# apm's existing profile generation symlinks visible to Nix GC.
/nix/store/fz9lrsrqpxhzmkhrbqzndjkh3fl9pygg-coreutils-9.5/bin/mkdir -p /nix/var/nix/gcroots
/nix/store/fz9lrsrqpxhzmkhrbqzndjkh3fl9pygg-coreutils-9.5/bin/ln -sfn /var/lib/profiles /nix/var/nix/gcroots/aos-profiles
<<aos-job-script-end>>
RemainAfterExit=true
Type=oneshot

[Install]
WantedBy=multi-user.target
