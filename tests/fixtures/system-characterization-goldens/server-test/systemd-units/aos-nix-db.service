[Unit]
After=local-fs.target
Before=aos-eval.service multi-user.target
Description=Seed Nix store database and AOS GC roots

[Service]
Environment="PATH=/nix/store/<hash>-coreutils-9.5/bin:/nix/store/<hash>-findutils-4.10.0/bin:/nix/store/<hash>-grep-3.11/bin:/nix/store/<hash>-sed-4.9/bin:/nix/store/<hash>-systemd-259.1/bin:/nix/store/<hash>-coreutils-9.5/sbin:/nix/store/<hash>-findutils-4.10.0/sbin:/nix/store/<hash>-grep-3.11/sbin:/nix/store/<hash>-sed-4.9/sbin:/nix/store/<hash>-systemd-259.1/sbin"
ExecStart=<<aos-job-script>>
#!/nix/store/<hash>-bash-5.2.37/bin/bash
set -e

set -euo pipefail

# Initialise the store layout/schema if absent. Loading the registration
# stream is idempotent and does not canonicalise/chown store contents.
/nix/store/<hash>-nix-2.24.12/bin/nix-store --init || true
if [ -r /aos-registration ]; then
  /nix/store/<hash>-nix-2.24.12/bin/nix-store --load-db < /aos-registration
fi

# Nix recursively scans directories below gcroots, but does not follow
# a symlink whose target is an external directory. Bind the durable APM
# profile tree into a real gcroots directory so every generation root
# is visible to collection without duplicating profile state.
/nix/store/<hash>-coreutils-9.5/bin/mkdir -p \
  /var/lib/profiles \
  /nix/var/nix/gcroots
if [ -L /nix/var/nix/gcroots/aos-profiles ]; then
  /nix/store/<hash>-coreutils-9.5/bin/rm -f /nix/var/nix/gcroots/aos-profiles
fi
/nix/store/<hash>-coreutils-9.5/bin/mkdir -p \
  /nix/var/nix/gcroots/aos-profiles
if ! /nix/store/<hash>-util-linux-2.42.1/bin/mountpoint -q \
  /nix/var/nix/gcroots/aos-profiles; then
  /nix/store/<hash>-util-linux-2.42.1/bin/mount --bind \
    /var/lib/profiles \
    /nix/var/nix/gcroots/aos-profiles
fi
<<aos-job-script-end>>
RemainAfterExit=true
Type=oneshot

[Install]
WantedBy=multi-user.target
