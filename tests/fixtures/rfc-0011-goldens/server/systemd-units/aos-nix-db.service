[Unit]
After=local-fs.target
Before=multi-user.target
Description=Seed Nix store database and AOS GC roots

[Service]
Environment="PATH=/nix/store/zpzxzkj2m18xcdnv82fq870mjb4x54d3-coreutils-9.5/bin:/nix/store/rwd094cc19w6kq3hw035lvswcaydxz70-findutils-4.10.0/bin:/nix/store/mfwrbd36346z7h5vfz2qnvdrq3a9xsmg-grep-3.11/bin:/nix/store/m8ii1f2w43mqbax78y5daxabf6cgv3sx-sed-4.9/bin:/nix/store/z3xzkyz89bjq8d7h57b4hr6pcy3kfw78-systemd-259.1/bin:/nix/store/zpzxzkj2m18xcdnv82fq870mjb4x54d3-coreutils-9.5/sbin:/nix/store/rwd094cc19w6kq3hw035lvswcaydxz70-findutils-4.10.0/sbin:/nix/store/mfwrbd36346z7h5vfz2qnvdrq3a9xsmg-grep-3.11/sbin:/nix/store/m8ii1f2w43mqbax78y5daxabf6cgv3sx-sed-4.9/sbin:/nix/store/z3xzkyz89bjq8d7h57b4hr6pcy3kfw78-systemd-259.1/sbin"
ExecStart=<<aos-job-script>>
#!/nix/store/xjlpk0ffbq4jaqar3kgp7pnbza2x2yfy-bash-5.2.37/bin/bash
set -e

set -euo pipefail

# Initialise the store layout/schema if absent. Loading the registration
# stream is idempotent and does not canonicalise/chown store contents.
/nix/store/hwmvip2w165v2cxp6rag91vhplihjkk6-nix-2.24.12/bin/nix-store --init || true
if [ -r /aos-registration ]; then
  /nix/store/hwmvip2w165v2cxp6rag91vhplihjkk6-nix-2.24.12/bin/nix-store --load-db < /aos-registration
fi

# Nix's GC follows symlinks under gcroots recursively. This bridge makes
# apm's existing profile generation symlinks visible to Nix GC.
/nix/store/zpzxzkj2m18xcdnv82fq870mjb4x54d3-coreutils-9.5/bin/mkdir -p /nix/var/nix/gcroots
/nix/store/zpzxzkj2m18xcdnv82fq870mjb4x54d3-coreutils-9.5/bin/ln -sfn /var/lib/profiles /nix/var/nix/gcroots/aos-profiles
<<aos-job-script-end>>
RemainAfterExit=true
Type=oneshot

[Install]
WantedBy=multi-user.target
