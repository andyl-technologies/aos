[Unit]
After=local-fs.target aos-seed-baked-packages.service aos-install-packages.service
Before=multi-user.target
ConditionPathExists=/etc/aos/policy.toml
Description=Load AOS fleet BPF-LSM policies

[Service]
Environment="PATH=/nix/store/zpzxzkj2m18xcdnv82fq870mjb4x54d3-coreutils-9.5/bin:/nix/store/rwd094cc19w6kq3hw035lvswcaydxz70-findutils-4.10.0/bin:/nix/store/mfwrbd36346z7h5vfz2qnvdrq3a9xsmg-grep-3.11/bin:/nix/store/m8ii1f2w43mqbax78y5daxabf6cgv3sx-sed-4.9/bin:/nix/store/z3xzkyz89bjq8d7h57b4hr6pcy3kfw78-systemd-259.1/bin:/nix/store/zpzxzkj2m18xcdnv82fq870mjb4x54d3-coreutils-9.5/sbin:/nix/store/rwd094cc19w6kq3hw035lvswcaydxz70-findutils-4.10.0/sbin:/nix/store/mfwrbd36346z7h5vfz2qnvdrq3a9xsmg-grep-3.11/sbin:/nix/store/m8ii1f2w43mqbax78y5daxabf6cgv3sx-sed-4.9/sbin:/nix/store/z3xzkyz89bjq8d7h57b4hr6pcy3kfw78-systemd-259.1/sbin"
AmbientCapabilities=
CapabilityBoundingSet=CAP_BPF CAP_SYS_ADMIN CAP_SYS_RESOURCE
DevicePolicy=closed
ExecStart=/nix/store/azzd4qyybicvg2ck0wxsrv9601c2sm6d-aos-0.1.0/bin/apm _load-ebpf-lsm-policies --system
ExecStartPre=/nix/store/4g541cllb9wzb1vvih6rc35pyqrxnjnq-aos-prepare-ebpf-lsm-bpffs/bin/aos-prepare-ebpf-lsm-bpffs
LimitMEMLOCK=infinity
MemoryDenyWriteExecute=true
NoNewPrivileges=false
PrivateDevices=true
PrivateNetwork=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/sys/fs/bpf
RemainAfterExit=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service mount umount2 bpf
Type=oneshot

[Install]
WantedBy=multi-user.target
