[Unit]
After=local-fs.target dev-disk-by\x2dpartlabel-swap.device
Before=swap.target
ConditionPathExists=/dev/disk/by-partlabel/swap
DefaultDependencies=no
Description=Set Up Encrypted Swap
Requires=dev-disk-by\x2dpartlabel-swap.device

[Service]
Environment="PATH=/nix/store/zpzxzkj2m18xcdnv82fq870mjb4x54d3-coreutils-9.5/bin:/nix/store/rwd094cc19w6kq3hw035lvswcaydxz70-findutils-4.10.0/bin:/nix/store/mfwrbd36346z7h5vfz2qnvdrq3a9xsmg-grep-3.11/bin:/nix/store/m8ii1f2w43mqbax78y5daxabf6cgv3sx-sed-4.9/bin:/nix/store/z3xzkyz89bjq8d7h57b4hr6pcy3kfw78-systemd-259.1/bin:/nix/store/zpzxzkj2m18xcdnv82fq870mjb4x54d3-coreutils-9.5/sbin:/nix/store/rwd094cc19w6kq3hw035lvswcaydxz70-findutils-4.10.0/sbin:/nix/store/mfwrbd36346z7h5vfz2qnvdrq3a9xsmg-grep-3.11/sbin:/nix/store/m8ii1f2w43mqbax78y5daxabf6cgv3sx-sed-4.9/sbin:/nix/store/z3xzkyz89bjq8d7h57b4hr6pcy3kfw78-systemd-259.1/sbin"
ExecStart=<<aos-job-script>>
#!/nix/store/xjlpk0ffbq4jaqar3kgp7pnbza2x2yfy-bash-5.2.37/bin/bash
set -e

set -euo pipefail
swap_dev=/dev/disk/by-partlabel/swap
dm_name=cryptswap

if [ -e /dev/mapper/$dm_name ]; then
  exit 0
fi

/nix/store/x2hkcpsc9aj84q0v5k6krasrdzb16fyx-cryptsetup-2.8.4/sbin/cryptsetup open --type=plain \
  --cipher=aes-xts-plain64 \
  --key-size=256 \
  --key-file=/dev/urandom \
  "$swap_dev" "$dm_name"

/nix/store/r9x6kx7isq9p8zyaagp3dykwgfx1fhdg-util-linux-2.42.1/sbin/mkswap /dev/mapper/$dm_name
/nix/store/r9x6kx7isq9p8zyaagp3dykwgfx1fhdg-util-linux-2.42.1/sbin/swapon /dev/mapper/$dm_name
<<aos-job-script-end>>
ExecStop=<<aos-job-script>>
#!/nix/store/xjlpk0ffbq4jaqar3kgp7pnbza2x2yfy-bash-5.2.37/bin/bash
set -e

set -eu
if /nix/store/r9x6kx7isq9p8zyaagp3dykwgfx1fhdg-util-linux-2.42.1/sbin/swapon --show=NAME --noheadings \
    | grep -qx /dev/mapper/cryptswap; then
  /nix/store/r9x6kx7isq9p8zyaagp3dykwgfx1fhdg-util-linux-2.42.1/sbin/swapoff /dev/mapper/cryptswap
fi
if [ -e /dev/mapper/cryptswap ]; then
  /nix/store/x2hkcpsc9aj84q0v5k6krasrdzb16fyx-cryptsetup-2.8.4/sbin/cryptsetup close cryptswap
fi
<<aos-job-script-end>>
RemainAfterExit=true
Type=oneshot

[Install]
WantedBy=swap.target
