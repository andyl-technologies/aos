# Executable component assertions and separately inventoried native VM cases.
# Binding a native case records its intended scope, never execution evidence or
# an advertised runtime capability.
{lib}: let
  case = name: role: requirementIds: scope: {
    inherit name role requirementIds scope;
  };
  # Read Cargo's owning manifest so a package rename cannot silently leave the
  # qualification runner selecting a predecessor package.
  group = cratePath: target: features: cases: let
    manifest = builtins.fromTOML (builtins.readFile (../../crates/crucible + "/${cratePath}/Cargo.toml"));
  in {
    package = manifest.package.name;
    inherit target features cases;
  };
  component = gateName: evidenceClass: testGroups: {
    inherit gateName evidenceClass testGroups;
    requirementIds = lib.unique (lib.concatMap (group: lib.concatMap (case: case.requirementIds) group.cases) testGroups);
  };
  components = {
    format = component "gate:ram-format" "format" [
      (group "protocol/crucible-ram" "topology_sort" [] [
        (case "ascii_inventory_ordering_allocates_only_its_shared_output" "adversarial" ["RAM-1" "RAM-12"] "Actual construction across empty, single, twelve, 64 and 4096-region maximum-width ASCII inventories and four input orders allocates only its shared output. An independent binary inventory and topology hash preserve canonical ordering; the same finite caller prepays the complete existing decode bound through output close, with no native authority.")
        (case "utf8_inventory_ordering_allocates_only_its_shared_output" "adversarial" ["RAM-1" "RAM-12"] "Maximum-width UTF-8 inventories use an in-place unsigned-byte sort across all four classes and four input orders. Actual allocation observation permits only shared output, and independently encoded inventory bytes and digest match under unchanged finite caller funding; physical memory and execution are not qualified.")
        (case "duplicate_inventory_refusal_needs_no_sorting_allocation" "adversarial" ["RAM-1" "RAM-12"] "Actual duplicate identifiers in two, 64 and 4096-region inventories refuse with the existing InvalidOrder error across scrambled, sorted, reversed and rotated inputs, without allocation or reallocation. Original finite caller credit stays charged throughout the refusal observation; no physical OOM is injected.")
      ])
      (group "protocol/crucible-ram" "descriptor_decode" [] [
        (case "selected_descriptor_checks_allocate_no_identifier_copies" "adversarial" ["RAM-9" "RAM-12"] "Actual root decoding adds only its retained selected-root vector to the measured inventory prefix across 96 empty, single, twelve and maximum-width inventory/class/scope/identifier combinations. Repeated descriptors borrow canonical input instead of allocating discarded identifiers; finite caller credit grants no native authority.")
        (case "selected_descriptor_validation_preserves_original_error_kinds" "adversarial" ["RAM-9" "RAM-12"] "Thirteen actual malformed repeated-descriptor cases preserve the original identifier, class, mask, geometry and comparison error precedence. Canonical input is built before finite caller admission, which stays live through returned-error close; no physical OOM or native qualification is claimed.")
      ])
      (group "protocol/crucible-ram" "conformance" [] [
        (case "canonical_golden_vectors" "positive" ["RAM-3" "RAM-4" "RAM-5" "RAM-7"] "Canonical construction and mathematical scope selection; no machine inventory admission.")
        (case "primitive_mode_and_output_are_fixed" "adversarial" ["RAM-7"] "Official unkeyed vectors and refusal of keyed or derived modes.")
        (case "canonical_codec_adversarial" "adversarial" ["RAM-1" "RAM-2" "RAM-6" "RAM-9"] "Canonical structural records and decoding bounds.")
        (case "proof_rejects_position_length_padding_and_root" "adversarial" ["RAM-6" "RAM-7" "RAM-8" "RAM-9"] "Proof position, valid length, padding and selected root binding.")
      ])
      (group "protocol/crucible-ram" "allocation_causes" [] [
        (case "root_inventory_vector_refusal_preserves_actual_allocator_source" "adversarial" ["RAM-9" "RAM-12"] "Actual root inventory vector allocation refusal retains its typed allocator cause in bounded inline result storage; cloning needs no allocation or second admission. The finite caller credit grants no native authority.")
        (case "topology_inventory_vector_refusal_preserves_actual_allocator_source" "adversarial" ["RAM-9" "RAM-12"] "Actual standalone inventory vector allocation refusal retains its typed allocator cause and the original finite caller credit; no physical memory pressure or native resource qualification.")
        (case "selected_root_vector_refusal_preserves_actual_allocator_source" "adversarial" ["RAM-9" "RAM-12"] "Actual selected-root vector allocation refusal retains its typed allocator cause after successful inventory decoding; no native admission.")
        (case "proof_identifier_refusal_preserves_actual_allocator_source" "adversarial" ["RAM-9" "RAM-12"] "Actual proof identifier allocation refusal preserves the original allocator source through allocation-free error cloning; caller credit remains finite and separate from native authority.")
        (case "proof_sibling_vector_refusal_preserves_actual_allocator_source" "adversarial" ["RAM-9" "RAM-12"] "Actual bounded proof sibling-vector allocation refusal preserves its typed source after the successful identifier prefix; no native resource qualification.")
        (case "root_identifier_refusal_preserves_actual_allocator_source" "adversarial" ["RAM-9" "RAM-12"] "The fallible root descriptor identifier copy returns the actual injected allocator cause without aborting. This exercises the fixed path only; the predecessor's infallible allocation is not fault-injected.")
        (case "topology_identifier_refusal_preserves_actual_allocator_source" "adversarial" ["RAM-9" "RAM-12"] "The fallible standalone inventory identifier copy retains the actual injected allocator source and original finite caller admission. No predecessor abort or native capacity qualification is claimed.")
      ])
    ];
    merkle = component "gate:ram-merkle-oracle" "model" [
      (group "protocol/crucible-ram" "conformance" [] [
        (case "persistent_tree_sparse_extreme_geometry" "positive" ["RAM-3" "RAM-6" "RAM-7" "RAM-12"] "Sparse geometry and shared immutable metadata.")
        (case "persistent_updates_fork_isolation_and_budget_rollback" "adversarial" ["RAM-12" "FP-6" "FP-7"] "Immutable paths, content reversion and metadata budget rollback.")
        (case "persistent_batches_match_independent_oracle_across_geometry" "positive" ["RAM-7" "RAM-8" "RAM-12" "FP-12"] "Independent oracle over multiple geometries, reverse updates and every page proof.")
        (case "oracle_independent_full_recompute_detects_suppressed_dirty" "adversarial" ["FP-12" "TEST-4" "TEST-5"] "Deliberately omitted dirty notification in the logical model; no deployed writer coverage.")
        (case "owned_metadata_reservations_release_and_refuse_excess" "adversarial" ["RAM-12"] "Owned metadata reservation lifetime and bounded admission.")
      ])
      (group "protocol/crucible-ram" "opaque" [] [
        (case "opaque_snapshot_seeds_scoped_roots_without_page_reads" "positive" ["RAM-4" "RAM-5" "CHECK-3"] "Authenticated opaque scoped root construction does not read page bodies; no live source admission.")
        (case "opaque_hydration_preserves_changes_and_matches_independent_oracle" "positive" ["FP-6" "FP-12" "CHECK-5"] "Proof-backed hydration retains changed paths and agrees with an independent logical oracle.")
        (case "opaque_hydration_rejects_foreign_evidence_and_rolls_back_budget" "adversarial" ["RAM-8" "RAM-12"] "Foreign proof evidence and metadata exhaustion cannot publish a hydrated successor.")
        (case "opaque_geometry_and_execution_scope_fail_closed" "adversarial" ["RAM-3" "RAM-4" "RAM-5"] "Opaque descriptors refuse mismatched geometry and execution scope.")
        (case "snapshot_rejects_independent_tree_accounting_domains" "adversarial" ["RAM-12"] "Snapshots reject trees owned by independent metadata accounting domains.")
        (case "dense_metadata_bound_covers_distinct_versions_and_checks_overflow" "positive" ["RAM-12"] "Distinct dense persistent versions remain within the model bound; bound arithmetic rejects overflow.")
      ])
      (group "protocol/crucible-ram" "lib" [] [
        (case "snapshot::tests::shared_control_closes_before_original_refund" "adversarial" ["RAM-12" "STORE-4"] "Actual logical snapshot control deallocation precedes refund of its original finite metadata charge, through ordinary aliases and eight concurrent final borrowers. The genuine budget counter is sampled after System free; cached original tree credit remains distinct, with no native stack or execution admission.")
        (case "tree::tests::shared_control_closes_before_original_refund" "adversarial" ["RAM-12" "STORE-4"] "Actual persistent tree-node control deallocation precedes refund of its original finite metadata charge, through ordinary aliases and eight concurrent final borrowers. Shared-owner, nullable-root and fixed cache extents remain unchanged; native admission and performance remain unqualified.")
      ])
    ];
    dirty = component "gate:ram-dirty-epochs" "model" [
      (group "protocol/crucible-ram" "conformance" [] [
        (case "dirty_consumers_preserve_races_and_cancel" "positive" ["TRACK-8" "TRACK-9" "TRACK-10"] "Independent consumer capture, acknowledgement, cancellation and concurrent model versions.")
        (case "dirty_fork_and_restore_reject_stale_receipts" "adversarial" ["TRACK-14" "TRACK-15"] "Private tracking incarnations and stale receipts; no native fork or restore qualification.")
        (case "dirty_limits_reject_atomically" "adversarial" ["TRACK-11"] "Range bounds and atomic failure before admitted metadata mutation.")
        (case "dirty_chunks_bound_dense_metadata_and_private_forks" "positive" ["TRACK-8" "TRACK-14"] "Dense chunk accounting, acknowledgement order and private model forks.")
      ])
      (group "protocol/crucible-ram" "lib" [] [
        (case "dirty::tests::shared_control_closes_before_original_refund" "adversarial" ["RAM-12" "TRACK-8"] "Actual dirty-capture control deallocation precedes refund of its original finite metadata charge, through ordinary aliases and eight concurrent final borrowers. The authentic tracker ledger stays live as an independent counter baseline; no guest barrier or native worker funding is qualified.")
        (case "dirty::tests::monotonic_counter_exhaustion_preserves_ledger" "adversarial" ["TRACK-11"] "Monotonic counter exhaustion leaves the prior ledger intact.")
      ])
    ];
    store = component "gate:ram-store-transfer" "model" [
      (group "storage/crucible-store" "lib" [] [
        (case "ram::tests::metadata_lifecycle::representation_domains::stored_page_identity_and_logical_digest_have_distinct_preimages" "positive" ["RAM-11"] "Actual directory-backed capture across all four region classes and one-byte, partial and full pages authenticates canonical CAS bytes separately from raw logical page bytes. The logical region commitment matches an independent oracle under finite prepaid caller funding; no execution or whole-world readiness is issued.")
        (case "ram::tests::metadata_lifecycle::representation_domains::valid_cas_and_consistent_catalog_cannot_substitute_storage_hash_for_page_digest" "adversarial" ["RAM-11"] "A genuinely stored page, leaf and root all authenticate by CAS and consistently claim a substituted storage hash as the page digest. Catalog open succeeds, but actual byte hashing refuses complete verification, page read and traversal before visitor delivery. Finite caller funding remains live through result close; no native qualification is claimed.")
        (case "ram::tests::metadata_lifecycle::update_admission::update_rechecks_original_after_backend_headroom_before_successor_effects" "adversarial" ["INV-6" "INV-10" "STORE-4"] "The actual backend admits headroom before irreversibly revoking the same finite caller. Update then incurs only its measured successful-admission and genuine refusal prefixes, with no successor copies, stream read, callback or extra loan. Typed original custody stays charged after caller close until final error close; no account is reactivated or native race freedom claimed.")
        (case "ram::tests::metadata_lifecycle::update_allocation::successor_catalog_vector_refusal_retains_original_allocator_cause" "adversarial" ["INV-6" "INV-10" "STORE-4"] "Only the new fallible successor catalog copy is fault-injected after the actual admission prefix proves its extent absent. The real allocator cause remains typed with no diagnostic allocation or loan; its original finite caller account stays charged after caller close until returned-error close. No predecessor abort or native qualification is claimed.")
        (case "ram::tests::metadata_lifecycle::update_allocation::successor_digest_vector_refusal_retains_original_allocator_cause" "adversarial" ["INV-6" "INV-10" "STORE-4"] "The new fallible successor digest copy refuses after exactly one earlier catalog allocation, using distinct actual vector extents and a measured admission prefix. Typed allocator cause, zero stream/callback effects, no additional diagnostic loan and original credit through final error close are checked without injecting the predecessor or claiming physical OOM.")
        (case "ram::tests::metadata_lifecycle::update_admission::revoked_update_original_refuses_before_successor_vector_copies" "adversarial" ["INV-6" "INV-10" "STORE-4"] "A genuinely revoked finite caller under an independently live backend refuses before successor-vector copies. Actual update allocations equal its same-account admission-only diagnostic prefix; typed original revocation, zero stream/callback effects and original credit through error close remain checked, with no native authority or physical OOM qualification.")
        (case "ram::tests::metadata_lifecycle::update_coordinates::ordered_updates_reuse_incoming_maximum_byte_ascii_identifiers" "adversarial" ["RAM-12" "STORE-3" "STORE-4"] "Actual ordered updates reuse prepared maximum-byte ASCII identifiers across same-region, cross-region and partial-page changes without allocating another identifier extent. An independent full capture supplies identical logical and canonical CAS successors; the finite caller account stays live through output close, with no native or performance qualification.")
        (case "ram::tests::metadata_lifecycle::update_coordinates::ordered_updates_reuse_incoming_maximum_byte_utf8_identifiers" "adversarial" ["RAM-12" "STORE-3" "STORE-4"] "Actual ordered updates reuse prepared maximum-byte UTF-8 identifiers and match an independent complete capture while preserving predecessor pages. Real allocation observation runs after input construction and finite caller admission; no shadow resource account or native authority is issued.")
        (case "ram::tests::metadata_lifecycle::update_coordinates::coordinate_or_stream_refusal_cannot_publish_a_partial_successor" "adversarial" ["RAM-12" "STORE-3" "STORE-4"] "Actual duplicate, descending-page, descending-region and original stream failures stop after the second read and publish no successor root. The retained predecessor remains readable and the same finite caller account covers returned-error close; partial unnamed children confer no readiness.")
        (case "ram::tests::metadata_lifecycle::root_decode::root_catalog_decode_allocates_only_its_returned_reference_vector" "adversarial" ["RAM-12" "STORE-4"] "Actual catalog decoding adds only its returned reference vector to the measured logical-record prefix, with no child-role scratch allocation or reallocation. Canonical input matches a genuinely captured root and the complete storage decode bound is prepaid by the same finite caller; no native authority is issued.")
        (case "ram::tests::metadata_lifecycle::root_decode::root_catalog_reference_vector_refusal_preserves_typed_cause" "adversarial" ["RAM-12" "STORE-4"] "Only the new fallible catalog reference vector is fault-injected, after actual prefix observation rules out an earlier matching infallible allocation. Its real allocator source remains typed with no diagnostic allocation or new admission; caller credit stays live through error close. No predecessor abort or physical OOM qualification is claimed.")
        (case "ram::tests::metadata_lifecycle::logical_causes::actual_logical_validation_bridge_retains_cause_without_allocating" "adversarial" ["RAM-12" "STORE-4"] "An actual malformed logical decode retains its typed validation cause through the storage bridge with zero diagnostic allocation or additional admission. The original finite caller account remains live through returned-error close; no native authority is issued.")
        (case "ram::tests::metadata_lifecycle::logical_causes::root_inventory_allocator_refusal_retains_typed_logical_cause" "adversarial" ["RAM-12" "STORE-4"] "Actual root inventory vector refusal survives catalog decoding as a typed allocator source under the original finite caller account. Canonical input matches a genuinely captured root identity before injection; no physical OOM or native admission is qualified.")
        (case "ram::tests::metadata_lifecycle::logical_causes::root_identifier_allocator_refusal_retains_typed_logical_cause" "adversarial" ["RAM-12" "STORE-4"] "Actual root identifier allocation refusal retains its original logical and allocator error chain through storage decoding without another resource request. Canonical input comes from a genuine captured catalog; caller result ownership grants no native authority.")
        (case "ram::tests::metadata_lifecycle::logical_causes::root_selected_vector_allocator_refusal_retains_typed_logical_cause" "adversarial" ["RAM-12" "STORE-4"] "Actual selected-root vector refusal retains its typed cause after successful inventory decoding under original finite caller credit. The control preserves canonical capture identity and returns credit after error close, without native resource qualification.")
        (case "owned_decode::tests::exhausted_account_reports_its_prepaid_cause_without_allocating" "adversarial" ["RAM-12"] "Actual account exhaustion retains its typed prepaid cause without another allocator entry or resource request; component credit supplies no Native authority.")
        (case "owned_decode::tests::prepaid_refusals_keep_account_identity_and_do_not_retain_the_account" "positive" ["RAM-12"] "Actual errors remain distinct across original accounts and retain only their separately paid diagnostics after both accounts close; no live machine admission.")
        (case "owned_decode::tests::final_prepaid_refusal_control_frees_before_its_original_loan" "positive" ["RAM-12"] "The installed allocator observes the actual final diagnostic control deallocation while its same original loan is still charged; no Native physical-return qualification.")
        (case "owned_decode::tests::poisoned_account_reports_from_prepaid_storage_without_allocating" "adversarial" ["RAM-12"] "A genuinely poisoned account reports its original typed refusal without allocating another holder; this component issues no Source custody.")
        (case "owned_decode::tests::unused_prepaid_refusal_control_frees_before_its_original_loan" "positive" ["RAM-12"] "Unused diagnostic storage physically deallocates before returning its original loan, as observed by the actual allocator; component credit creates no Native authority.")
        (case "owned_decode::tests::refusal_storage_is_not_born_when_its_original_credit_refuses" "adversarial" ["RAM-12"] "The original authority refuses diagnostic credit before its actual control allocation is born; no substitute account or Native authority is issued.")
        (case "owned_decode::tests::array_size_overflow_reports_a_prepaid_cause_without_poisoning" "adversarial" ["RAM-12"] "On 64-bit hosts, overflowing typed arrays retain their original prepaid cause without allocating, charging payload credit or poisoning the account; component authority supplies no native payer.")
        (case "owned_decode::tests::vector_size_overflow_retains_the_innermost_prepaid_cause_without_allocating" "adversarial" ["RAM-12"] "Scoped vector overflow retains the exact innermost account's prepaid cause without allocation or mutation; independent aliases retain credit through final close, without native issuance.")
        (case "owned_decode::tests::bulk_btree_bound_is_one_target_request_and_overflow_is_sticky" "adversarial" ["RAM-12"] "Bulk B-tree admission makes one actual original request; oversized geometry retains its typed prepaid refusal without allocation or credit growth, with 64-bit multiplication overflow and sticky failure; component credit issues no Native authority.")
        (case "owned_decode::tests::btree_node_overflow_uses_its_own_prepaid_account_under_a_foreign_scope" "adversarial" ["RAM-12"] "On 64-bit hosts, actual node-geometry overflow uses its explicit account's prepaid diagnostic despite a foreign installed scope; original credit remains through final error close, without native issuance.")
        (case "owned_decode::tests::key_layout_overflow_retains_its_actual_cause_without_allocating" "adversarial" ["RAM-12"] "On 64-bit hosts, the real key layout refusal preserves its typed cause and original account credit without allocation; a foreign codec scope cannot redirect ownership, and no native authority is issued.")
        (case "owned_decode::tests::value_layout_overflow_retains_its_actual_cause_without_allocating" "adversarial" ["RAM-12"] "On 64-bit hosts, the real value layout refusal retains its actual typed cause and paid handle through the final error alias without allocation or new credit; component evidence supplies no native issuer.")
        (case "owned_decode::tests::vector_capacity_refusal_keeps_actual_typed_source_without_allocating" "adversarial" ["RAM-12"] "A genuine Vec capacity refusal retains its actual typed source without another allocation; finite preborn component loans and final diagnostic aliases preserve original credit, without native RAM issuance.")
