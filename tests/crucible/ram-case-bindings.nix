        (case "ram::tests::metadata_lifecycle::record_prepay::root_publication::paid_root_logical_allocator_refusal_preserves_actual_partition_cause" "adversarial" ["RAM-12" "STORE-4"] "A real root logical allocation refuses within its original prepaid partition, preserves the actual allocator source and paid diagnostic loan before any publication, and refunds after final error close. No native custody or physical OOM is claimed.")
