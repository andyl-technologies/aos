  "read_only_typed_cpu_conversion_proof": {
    "conclusion": "CPU(env_archcpu(env)) already performs unchecked typed pointer arithmetic. env_cpu(env) computes the same CPUState pointer; substitution would improve style but does not eliminate a QOM call or demonstrate a speed win. No production source was changed.",
    "source_revision": "ee97d5506f9e2c38614fbdec732ea58dad89b0a4",
    "definition_and_layout_proofs": [
      {
        "source_path": "include/hw/core/cpu.h",
        "revision": "ee97d5506f9e2c38614fbdec732ea58dad89b0a4",
        "whole_file_sha256": "204ad253f3fdd32e245291bb91d6a1c26591286117e3750e372012c9e3ee8d01",
        "git_blob": "16883f1bb2d315dae0f1e13a5142700e3ac10d46",
        "read_only_excerpts": [
          {
            "first_line": 50,
            "last_line": 56,
            "source": "#define TYPE_CPU \"cpu\"\n\n/* Since this macro is used a lot in hot code paths and in conjunction with\n * FooCPU *foo_env_get_cpu(), we deviate from usual QOM practice by using\n * an unchecked cast.\n */\n#define CPU(obj) ((CPUState *)(obj))\n"
          }
        ]
      },
      {
        "source_path": "include/exec/cpu-common.h",
        "revision": "ee97d5506f9e2c38614fbdec732ea58dad89b0a4",
        "whole_file_sha256": "a0636baa6ba1531e5e71a1374866e6e07183b6d4b4f6b8fda66285fc1a2315df",
        "git_blob": "6594f7fa1be0d24d19fcda9f9c5832a214bf00a1",
        "read_only_excerpts": [
          {
            "first_line": 82,
            "last_line": 113,
            "source": "/**\n * env_archcpu(env)\n * @env: The architecture environment\n *\n * Return the ArchCPU associated with the environment.\n */\nstatic inline ArchCPU *env_archcpu(CPUArchState *env)\n{\n    return (void *)env - sizeof(CPUState);\n}\n\n/**\n * env_cpu_const(env)\n * @env: The architecture environment\n *\n * Return the CPUState associated with the environment.\n */\nstatic inline const CPUState *env_cpu_const(const CPUArchState *env)\n{\n    return (void *)env - sizeof(CPUState);\n}\n\n/**\n * env_cpu(env)\n * @env: The architecture environment\n *\n * Return the CPUState associated with the environment.\n */\nstatic inline CPUState *env_cpu(CPUArchState *env)\n{\n    return (CPUState *)env_cpu_const(env);\n}\n"
          }
        ]
      },
      {
        "source_path": "target/i386/cpu.h",
        "revision": "ee97d5506f9e2c38614fbdec732ea58dad89b0a4",
        "whole_file_sha256": "4cccf4bdcc99e5cf5d89820134064479e73126fa5d382230078490183fb7c6e1",
        "git_blob": "eb816c9d4e7148ad30b8f79b2d44a90ddb98011c",
        "read_only_excerpts": [
          {
            "first_line": 2334,
            "last_line": 2338,
            "source": "struct ArchCPU {\n    CPUState parent_obj;\n\n    CPUX86State env;\n    VMChangeStateEntry *vmsentry;\n"
          }
        ]
      },
      {
        "source_path": "target/i386/tcg/misc_helper.c",
        "revision": "ee97d5506f9e2c38614fbdec732ea58dad89b0a4",
        "whole_file_sha256": "274d9c19c7a4baee32679b851341112e2b68a28358618a1da2b634960dd96dde",
        "git_blob": "b201933cbb2c30ddac2d2c9fe945cea220859958",
        "read_only_excerpts": [
          {
            "first_line": 68,
            "last_line": 99,
            "source": "void helper_rdtsc(CPUX86State *env)\n{\n    uint64_t val;\n\n    if ((env->cr[4] & CR4_TSD_MASK) && ((env->hflags & HF_CPL_MASK) != 0)) {\n        raise_exception_ra(env, EXCP0D_GPF, GETPC());\n    }\n    cpu_svm_check_intercept_param(env, SVM_EXIT_RDTSC, 0, GETPC());\n\n    val = cpu_get_tsc(env) + env->tsc_offset;\n    if (qemu_crucible_fault_clock_source_active(\n            QEMU_CRUCIBLE_CLOCK_X86_TSC,\n            CPU(env_archcpu(env))->cpu_index)) {\n        bool read_error;\n        uint64_t transformed;\n\n        if (!qemu_crucible_fault_clock_read_ticks(\n                QEMU_CRUCIBLE_CLOCK_X86_TSC,\n                CPU(env_archcpu(env))->cpu_index, val,\n                qemu_crucible_fault_observed_icount(),\n                &transformed, &read_error)) {\n            error_report(\"Crucible x86 TSC transform failed\");\n            abort();\n        }\n        if (read_error) {\n            raise_exception_ra(env, EXCP0D_GPF, GETPC());\n        }\n        val = transformed;\n    }\n    env->regs[R_EAX] = (uint32_t)(val);\n    env->regs[R_EDX] = (uint32_t)(val >> 32);\n}\n"
          }
        ]
      }
    ],
