load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_binary", "rust_library")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")

package(default_visibility = ["//crates:__subpackages__"])

RUST_PACKAGE = aos_rust_package(
    name = "aos-package-manager",
    version = "0.1.0",
    edition = "2024",
    description = "",
    license_expression = "Apache-2.0",
    license_domain = "apache-host",
)

DEPENDENCIES = [
    "//crates/aos/activation/aos-activation:lib",
    "//crates/aos/boot/aos-platform-metadata:lib",
    "//crates/aos/boot/aos-storage-layout:lib",
    "//crates/aos/cli/aos-cli-ui:lib",
    "//crates/aos/modules/aos-module-docs:lib",
    "//crates/aos/modules/aos-module-format:lib",
    "//crates/aos/packages/aos-deployment-format:lib",
    "//crates/aos/packages/aos-deployment:lib",
    "//crates/aos/packages/aos-nix-cache:lib",
    "//crates/aos/registry/aos-registry-authoring:lib",
    "//crates/aos/registry/aos-registry-client:lib",
    "//crates/aos/registry/aos-registry-format:lib",
    "//crates/hub/aos-hub-api:lib",
    "//crates/hub/aos-hub-client:lib",
    "//crates/shared/aos-core:lib",
    "//crates/shared/aos-nar:lib",
    "//crates/shared/aos-nix:lib",
    "//crates/shared/aos-transfer:lib",
    "//third_party/rust:core_anyhow",
    "//third_party/rust:core_base64",
    "//third_party/rust:core_clap",
    "//third_party/rust:core_ed25519_dalek",
    "//third_party/rust:core_hex",
    "//third_party/rust:core_libc",
    "//third_party/rust:core_rand",
    "//third_party/rust:core_rustix",
    "//third_party/rust:core_semver",
    "//third_party/rust:core_serde",
    "//third_party/rust:core_serde_json",
    "//third_party/rust:core_sha2",
    "//third_party/rust:core_ssh_key",
    "//third_party/rust:core_tempfile",
    "//third_party/rust:core_thiserror",
    "//third_party/rust:core_tokio",
    "//third_party/rust:core_toml",
    "//third_party/rust:core_url",
    "//third_party/rust:core_zstd",
]

TEST_DEPENDENCIES = [
    "//third_party/rust:core_crc32fast",
    "//third_party/rust:core_zbus",
]

# Existing fixtures preload this shim only in selected child processes.
TEST_RUNFILES = {
    "SSL_CERT_FILE": "@aos_cli_runtime//:ca-certificates.crt",
    "AOS_TEST_IDENTITY_PRELOAD": "//crates/hub/aos-hub-native:libnix_test_identity.so",
}

rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    crate_name = "aos_package_manager",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"], exclude = ["src/bin/**/*.rs"]),
    deps = DEPENDENCIES,
)

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    crate = ":lib",
    deps = TEST_DEPENDENCIES,
    setup = "@aos_registry_runtime//:setup",
    data = ["@aos_registry_runtime//:closure.json"],
    runfile_env = TEST_RUNFILES,
)

rust_binary(
    name = "aos-deployment-check",
    package = RUST_PACKAGE,
    crate_name = "aos_deployment_check",
    crate_root = "src/bin/aos-deployment-check.rs",
    srcs = ["src/bin/aos-deployment-check.rs"],
    deps = [":lib"] + DEPENDENCIES,
)

aos_rust_test(
    name = "bin_aos-deployment-check",
    package = RUST_PACKAGE,
    crate_name = "aos_deployment_check",
    crate_root = "src/bin/aos-deployment-check.rs",
    srcs = ["src/bin/aos-deployment-check.rs"],
    deps = [":lib"] + DEPENDENCIES + TEST_DEPENDENCIES,
)

rust_binary(
    name = "aos-image-rollout-boot",
    package = RUST_PACKAGE,
    crate_name = "aos_image_rollout_boot",
    crate_root = "src/bin/aos-image-rollout-boot.rs",
    srcs = ["src/bin/aos-image-rollout-boot.rs"],
    deps = [":lib"] + DEPENDENCIES,
)

aos_rust_test(
    name = "bin_aos-image-rollout-boot",
    package = RUST_PACKAGE,
    crate_name = "aos_image_rollout_boot",
    crate_root = "src/bin/aos-image-rollout-boot.rs",
    srcs = ["src/bin/aos-image-rollout-boot.rs"],
    deps = [":lib"] + DEPENDENCIES + TEST_DEPENDENCIES,
    allow_empty = True,
)

rust_binary(
    name = "aos-image-rollout-observer",
    package = RUST_PACKAGE,
    crate_name = "aos_image_rollout_observer",
    crate_root = "src/bin/aos-image-rollout-observer.rs",
    srcs = ["src/bin/aos-image-rollout-observer.rs"],
    deps = [":lib"] + DEPENDENCIES,
)

aos_rust_test(
    name = "bin_aos-image-rollout-observer",
    package = RUST_PACKAGE,
    crate_name = "aos_image_rollout_observer",
    crate_root = "src/bin/aos-image-rollout-observer.rs",
    srcs = ["src/bin/aos-image-rollout-observer.rs"],
    deps = [":lib"] + DEPENDENCIES + TEST_DEPENDENCIES,
    allow_empty = True,
)

rust_binary(
    name = "aos-image-rollout-provider",
    package = RUST_PACKAGE,
    crate_name = "aos_image_rollout_provider",
    crate_root = "src/bin/aos-image-rollout-provider.rs",
    srcs = ["src/bin/aos-image-rollout-provider.rs"],
    deps = [":lib"] + DEPENDENCIES,
)

aos_rust_test(
    name = "bin_aos-image-rollout-provider",
    package = RUST_PACKAGE,
    crate_name = "aos_image_rollout_provider",
    crate_root = "src/bin/aos-image-rollout-provider.rs",
    srcs = ["src/bin/aos-image-rollout-provider.rs"],
    deps = [":lib"] + DEPENDENCIES + TEST_DEPENDENCIES,
    allow_empty = True,
)

rust_binary(
    name = "aos-package-attestation-provider",
    package = RUST_PACKAGE,
    crate_name = "aos_package_attestation_provider",
    crate_root = "src/bin/aos-package-attestation-provider.rs",
    srcs = ["src/bin/aos-package-attestation-provider.rs"],
    deps = [":lib"] + DEPENDENCIES,
)

aos_rust_test(
    name = "bin_aos-package-attestation-provider",
    package = RUST_PACKAGE,
    crate_name = "aos_package_attestation_provider",
    crate_root = "src/bin/aos-package-attestation-provider.rs",
    srcs = ["src/bin/aos-package-attestation-provider.rs"],
    deps = [":lib"] + DEPENDENCIES + TEST_DEPENDENCIES,
    allow_empty = True,
)

aos_rust_test(
    name = "package_command_scopes",
    package = RUST_PACKAGE,
    crate_name = "package_command_scopes",
    crate_root = "tests/package_command_scopes.rs",
    srcs = glob(["tests/**/*.rs"]),
    deps = [":lib"] + DEPENDENCIES + TEST_DEPENDENCIES,
    setup = "@aos_registry_runtime//:setup",
    data = ["@aos_registry_runtime//:closure.json"],
    runfile_env = TEST_RUNFILES,
)

aos_rust_test(
    name = "registry_cache_e2e",
    package = RUST_PACKAGE,
    crate_name = "registry_cache_e2e",
    crate_root = "tests/registry_cache_e2e.rs",
    srcs = glob(["tests/**/*.rs"]),
    deps = [":lib"] + DEPENDENCIES + TEST_DEPENDENCIES,
    setup = "@aos_registry_runtime//:setup",
    data = ["@aos_registry_runtime//:closure.json"],
    runfile_env = TEST_RUNFILES,
)

# Cargo test compiles this fixture driver without executing its command workflow.
rust_binary(
    name = "package_deployment_check",
    package = RUST_PACKAGE,
    crate_name = "package_deployment_check",
    crate_root = "examples/package_deployment_check.rs",
    srcs = ["examples/package_deployment_check.rs"],
    deps = [":lib"] + DEPENDENCIES,
)

rust_doc_test(name = "doc", crate = ":lib")

PRODUCTION_ARTIFACTS = [
    ":lib",
    ":aos-deployment-check",
    ":aos-image-rollout-boot",
    ":aos-image-rollout-observer",
    ":aos-image-rollout-provider",
    ":aos-package-attestation-provider",
]

DEVELOPER_ARTIFACTS = [
    ":package_deployment_check",
    ":lib",
    ":unit_binary",
    ":aos-deployment-check",
    ":bin_aos-deployment-check_binary",
    ":aos-image-rollout-boot",
    ":bin_aos-image-rollout-boot_binary",
    ":aos-image-rollout-observer",
    ":bin_aos-image-rollout-observer_binary",
    ":aos-image-rollout-provider",
    ":bin_aos-image-rollout-provider_binary",
    ":aos-package-attestation-provider",
    ":bin_aos-package-attestation-provider_binary",
    ":package_command_scopes_binary",
    ":registry_cache_e2e_binary",
]

rust_clippy(name = "clippy", testonly = True, deps = DEVELOPER_ARTIFACTS)
rustfmt_test(name = "format", targets = DEVELOPER_ARTIFACTS)
rust_doc(name = "documentation", crate = ":lib")

aos_license_check(
    name = "license_closure",
    testonly = True,
    roots = DEVELOPER_ARTIFACTS,
    license_domain = RUST_PACKAGE.license_domain,
)

aos_license_check(
    name = "production_license_closure",
    roots = PRODUCTION_ARTIFACTS,
    license_domain = RUST_PACKAGE.license_domain,
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)
