load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_binary", "rust_library")
load("//tools/bazel/rules:package.bzl", "aos_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")

RUST_PACKAGE = aos_rust_package(
    edition = "2024",
    name = "aos-boot-identity",
    version = "0.1.0",
    license_expression = "Apache-2.0",
    license_domain = "apache-host",
    description = "Normal and recovery boot identity parsing and UKI inspection",
)

# This pilot is compared with the current production recipe before cutover.
rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    crate_name = "aos_boot_identity",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    visibility = [
        "//crates/aos/boot:__subpackages__",
        "//crates/aos/release:__subpackages__",
    ],
)

rust_binary(
    name = "aos-boot-identity",
    package = RUST_PACKAGE,
    crate_name = "aos_boot_identity",
    srcs = ["src/main.rs"],
    deps = [":lib"],
)

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    crate = ":lib",
)

aos_rust_test(
    name = "uki_cli",
    package = RUST_PACKAGE,
    srcs = ["tests/uki_cli.rs"],
    deps = [":lib"],
    data = [":aos-boot-identity"],
    rustc_env = {"CARGO_BIN_EXE_aos-boot-identity": "$(rootpath :aos-boot-identity)"},
)

rust_doc_test(
    name = "doc",
    crate = ":lib",
)

aos_package(
    name = "package",
    package = RUST_PACKAGE,
    artifacts = {":aos-boot-identity": "bin/aos-boot-identity"},
    executables = ["bin/aos-boot-identity"],
)

rust_clippy(
    name = "clippy",
    testonly = True,
    deps = [":lib", ":unit_binary", ":aos-boot-identity", ":uki_cli_binary"],
)

rustfmt_test(
    name = "format",
    targets = [":lib", ":unit_binary", ":aos-boot-identity", ":uki_cli_binary"],
)

rust_doc(
    name = "documentation",
    crate = ":lib",
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)
