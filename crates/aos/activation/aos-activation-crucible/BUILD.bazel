load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_binary", "rust_library")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:package.bzl", "aos_package")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")

package(default_visibility = ["//crates:__subpackages__"])

RUST_PACKAGE = aos_rust_package(
    name = "aos-activation-crucible",
    version = "0.1.0",
    edition = "2024",
    license_expression = "Apache-2.0",
    license_domain = "apache-host",
)

DEPENDENCIES = [
    "//crates/aos/activation/aos-activation:lib",
    "//crates/shared/aos-core:lib",
    "//crates/crucible/guest/crucible-guest:lib",
    "//third_party/rust:core_anyhow",
    "//third_party/rust:core_rustix",
    "//third_party/rust:core_serde",
]

# Host-side verdict assertions consume the public protocol and engine test API.
# They never link QEMU, its plugin, or any QEMU implementation headers.
DEVELOPMENT_DEPENDENCIES = [
    "//crates/crucible/engine/crucible-engine:lib_test_support",
    "//third_party/rust:core_tempfile",
]

rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "aos_activation_crucible",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    deps = DEPENDENCIES,
)

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate = ":lib",
    deps = DEVELOPMENT_DEPENDENCIES,
)

rust_doc_test(name = "doc", crate = ":lib")

# The installed name is independent of the Cargo package name. Its workspace
# supplies the declared static runtime and target-only crt-static flags.
rust_binary(
    name = "aos-ability-crucible",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "aos_ability_crucible",
    crate_root = "src/main.rs",
    srcs = ["src/main.rs"],
    deps = [":lib"] + DEPENDENCIES,
)

aos_rust_test(
    name = "bin_aos-ability-crucible",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate = ":aos-ability-crucible",
    deps = DEVELOPMENT_DEPENDENCIES,
    allow_empty = True,
)

DEVELOPER_ARTIFACTS = [":lib", ":unit_binary", ":aos-ability-crucible", ":bin_aos-ability-crucible_binary"]

rust_clippy(name = "clippy", testonly = True, deps = DEVELOPER_ARTIFACTS)
rustfmt_test(name = "format", targets = DEVELOPER_ARTIFACTS)
rust_doc(name = "documentation", crate = ":lib")

aos_license_check(
    name = "license_closure",
    testonly = True,
    roots = DEVELOPER_ARTIFACTS,
    license_domain = RUST_PACKAGE.license_domain,
)

aos_license_check(
    name = "production_license_closure",
    roots = [":lib", ":aos-ability-crucible"],
    license_domain = RUST_PACKAGE.license_domain,
)

aos_package(
    name = "package",
    # Preserve the existing Nix package identity independently of the crate.
    package_name = "aos-ability-crucible",
    version = RUST_PACKAGE.version,
    license_expression = RUST_PACKAGE.license_expression,
    license_domain = RUST_PACKAGE.license_domain,
    artifacts = {":aos-ability-crucible": "bin/aos-ability-crucible"},
    executables = ["bin/aos-ability-crucible"],
    visibility = ["//visibility:public"],
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)
