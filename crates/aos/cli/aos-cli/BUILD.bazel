load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_binary", "rust_library")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:package.bzl", "aos_package")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")
load("//tools/bazel/rules:test_sources.bzl", "aos_repository_test_sources")

package(default_visibility = ["//crates:__subpackages__"])

RUST_PACKAGE = aos_rust_package(
    name = "aos-cli",
    version = "0.1.0",
    edition = "2024",
    license_expression = "Apache-2.0",
    license_domain = "apache-host",
)

# The shipped package includes fleet helpers; ordinary CLI tests keep them optional.
FEATURES = select({
    "//tools/bazel/rules:aos_cli_fleet_tests_dependencies": ["release-fleet-fixture"],
    "//tools/bazel/rules:aos_cli_production_dependencies": ["release-fleet-fixture"],
    "//conditions:default": [],
})

DEPENDENCIES = [
    "//crates/aos/activation/aos-activation:lib",
    "//crates/aos/cli/aos-cli-ui:lib",
    "//crates/aos/cli/aos-closure-analysis:lib",
    "//crates/aos/cli/aos-nix-docs:lib",
    "//crates/aos/modules/aos-module-docs:lib",
    "//crates/aos/modules/aos-module-format:lib",
    "//crates/aos/packages/aos-build-client:lib",
    "//crates/aos/packages/aos-build-server:lib",
    "//crates/aos/packages/aos-deployment-format:lib",
    "//crates/aos/packages/aos-deployment:lib",
    "//crates/aos/packages/aos-nix-cache:lib",
    "//crates/aos/packages/aos-package-manager:lib",
    "//crates/aos/registry/aos-registry-authoring:lib",
    "//crates/aos/registry/aos-registry-client:lib",
    "//crates/aos/registry/aos-registry-format:lib",
    "//crates/aos/release/aos-image-finalizer:lib",
    "//crates/aos/release/aos-package-maintenance:lib",
    "//crates/aos/release/aos-release-coordinator:lib",
    "//crates/aos/release/aos-release-format:lib",
    "//crates/hub/aos-hub-api:lib",
    "//crates/hub/aos-hub-client:lib",
    "//crates/shared/aos-artifact-evidence:lib",
    "//crates/shared/aos-core:lib",
    "//crates/shared/aos-nar:lib",
    "//crates/shared/aos-nix:lib",
    "//crates/shared/aos-oci-types:lib",
    "//crates/shared/aos-oci:lib",
    "//crates/shared/aos-transfer:lib",
    "//third_party/rust:core_alejandra",
    "//third_party/rust:core_anyhow",
    "//third_party/rust:core_axum",
    "//third_party/rust:core_base64",
    "//third_party/rust:core_clap",
    "//third_party/rust:core_clap_complete",
    "//third_party/rust:core_console",
    "//third_party/rust:core_crossterm",
    "//third_party/rust:core_ed25519_dalek",
    "//third_party/rust:core_futures_util",
    "//third_party/rust:core_glob",
    "//third_party/rust:core_hex",
    "//third_party/rust:core_humantime",
    "//third_party/rust:core_hyper_util",
    "//third_party/rust:core_ignore",
    "//third_party/rust:core_indicatif",
    "//third_party/rust:core_libc",
    "//third_party/rust:core_rand",
    "//third_party/rust:core_ratatui",
    "//third_party/rust:core_regex",
    "//third_party/rust:core_reqwest",
    "//third_party/rust:core_rnix",
    "//third_party/rust:core_rustix",
    "//third_party/rust:core_rustls_pemfile",
    "//third_party/rust:core_semver",
    "//third_party/rust:core_serde",
    "//third_party/rust:core_serde_json",
    "//third_party/rust:core_sha2",
    "//third_party/rust:core_tempfile",
    "//third_party/rust:core_thiserror",
    "//third_party/rust:core_tokio",
    "//third_party/rust:core_tokio_rustls",
    "//third_party/rust:core_tokio_util",
    "//third_party/rust:core_toml",
    "//third_party/rust:core_tower",
    "//third_party/rust:core_tracing",
    "//third_party/rust:core_url",
    "//third_party/rust:core_zeroize",
]

PROC_MACRO_DEPENDENCIES = [
    "//third_party/rust:core_async_trait",
]

TEST_DEPENDENCIES = [
    "//crates/hub/aos-hub-db:lib",
    "//crates/hub/aos-hub-model:lib",
    "//crates/hub/aos-hub-native:lib",
    "//crates/hub/aos-hub-service:lib",
    "//third_party/rust:core_flate2",
    "//third_party/rust:core_tar",
    "//third_party/rust:core_uuid",
    "//third_party/rust:core_zstd",
]

ENTRY_POINTS = {
    "aos": "src/main.rs",
    "apr": "src/apr.rs",
    "apm": "src/apm.rs",
    "aos-package-runtime": "src/package_runtime.rs",
    "aos-boot-configuration": "src/boot_configuration.rs",
    "aos-provisioning-configuration-evaluator": "src/provisioning_configuration_evaluator.rs",
}

FLEET_ENTRY_POINTS = {
    "aos-release-fleet-fixture": "tests/support/release_fleet_fixture.rs",
    "aos-ability-interruption-audit": "tests/support/ability_interruption_audit.rs",
    "aos-ability-authority-audit": "tests/support/ability_authority_audit.rs",
}

LIBRARY_SOURCES = glob(["src/**/*.rs"])
FIXTURE_SOURCES = glob(["tests/support/**/*.rs"])
INTEGRATIONS = glob(["tests/*.rs"])
INTEGRATION_SOURCES = glob(["tests/**/*.rs"])

aos_repository_test_sources(
    name = "repository_test_sources",
    manifest = "@aos_cli_test_sources//:manifest.json",
    sources = "@aos_cli_test_sources//:sources",
    source_suffix = ".aos-source",
)

# Cross-package path modules are source inputs, rather than linked libraries.
TEST_COMPILE_INPUTS = [
    "//crates/aos/release/aos-release-format:qualification_fixture_sources",
    "//crates/aos/packages/aos-package-manager:registry_fixture_sources",
    "//crates/shared/aos-oci:registry_fixture_sources",
]

TEST_DATA = [":repository_test_sources", "@aos_registry_runtime//:closure.json"]
TEST_ENV = {"CARGO_MANIFEST_DIR": "$(rootpath :repository_test_sources)/crates/aos/cli/aos-cli"}
TEST_RUNFILES = {
    "SSL_CERT_FILE": "@aos_cli_runtime//:ca-certificates.crt",
    "AOS_TEST_IDENTITY_PRELOAD": "//crates/hub/aos-hub-native:libnix_test_identity.so",
}

rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    crate_name = "aos_cli",
    crate_root = "src/lib.rs",
    srcs = LIBRARY_SOURCES,
    crate_features = FEATURES,
    deps = DEPENDENCIES,
    proc_macro_deps = PROC_MACRO_DEPENDENCIES,
)

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    crate = ":lib",
    crate_features = FEATURES,
    compile_data = TEST_COMPILE_INPUTS,
    deps = TEST_DEPENDENCIES,
    data = TEST_DATA,
    rustc_env = TEST_ENV,
    setup = "@aos_registry_runtime//:setup",
    runfile_env = TEST_RUNFILES,
)

[
    rust_binary(
        name = name,
        package = RUST_PACKAGE,
        crate_name = name.replace("-", "_"),
        crate_root = source,
        srcs = LIBRARY_SOURCES + FIXTURE_SOURCES,
        crate_features = ["release-fleet-fixture"] if name in FLEET_ENTRY_POINTS else FEATURES,
        compile_data = TEST_COMPILE_INPUTS,
        deps = [":lib"] + DEPENDENCIES,
        proc_macro_deps = PROC_MACRO_DEPENDENCIES,
    )
    for name, source in (ENTRY_POINTS | FLEET_ENTRY_POINTS).items()
]

[
    aos_rust_test(
        name = "bin_" + name,
        package = RUST_PACKAGE,
        crate_name = name.replace("-", "_"),
        crate_root = source,
        srcs = LIBRARY_SOURCES + FIXTURE_SOURCES,
        crate_features = ["release-fleet-fixture"] if name in FLEET_ENTRY_POINTS else FEATURES,
        compile_data = TEST_COMPILE_INPUTS,
        deps = [":lib"] + DEPENDENCIES + TEST_DEPENDENCIES,
        proc_macro_deps = PROC_MACRO_DEPENDENCIES,
        allow_empty = name != "aos-release-fleet-fixture",
        data = TEST_DATA,
        rustc_env = TEST_ENV,
        setup = "@aos_registry_runtime//:setup",
        runfile_env = TEST_RUNFILES,
    )
    for name, source in (ENTRY_POINTS | FLEET_ENTRY_POINTS).items()
]

BINARIES = [":" + name for name in ENTRY_POINTS] + select({
    "//tools/bazel/rules:aos_cli_fleet_tests_dependencies": [":" + name for name in FLEET_ENTRY_POINTS],
    "//tools/bazel/rules:aos_cli_production_dependencies": [":" + name for name in FLEET_ENTRY_POINTS],
    "//conditions:default": [],
})

BIN_ENV = {"CARGO_BIN_EXE_" + name: "$(rootpath :" + name + ")" for name in ENTRY_POINTS}
FLEET_BIN_ENV = {"CARGO_BIN_EXE_" + name: "$(rootpath :" + name + ")" for name in FLEET_ENTRY_POINTS}
INTEGRATION_ENV = {
    "//tools/bazel/rules:aos_cli_fleet_tests_dependencies": TEST_ENV | BIN_ENV | FLEET_BIN_ENV,
    "//tools/bazel/rules:aos_cli_production_dependencies": TEST_ENV | BIN_ENV | FLEET_BIN_ENV,
    "//conditions:default": TEST_ENV | BIN_ENV,
}

[
    aos_rust_test(
        name = source.removeprefix("tests/").removesuffix(".rs"),
        package = RUST_PACKAGE,
        crate_name = source.removeprefix("tests/").removesuffix(".rs"),
        crate_root = source,
        srcs = LIBRARY_SOURCES + INTEGRATION_SOURCES,
        crate_features = FEATURES,
        compile_data = TEST_COMPILE_INPUTS,
        deps = [":lib"] + DEPENDENCIES + TEST_DEPENDENCIES,
        proc_macro_deps = PROC_MACRO_DEPENDENCIES,
        data = TEST_DATA + BINARIES,
        rustc_env_variants = INTEGRATION_ENV,
        setup = "@aos_registry_runtime//:setup",
        runfile_env = TEST_RUNFILES,
    )
    for source in INTEGRATIONS
]

TEST_ARTIFACTS = [":unit_binary"] + [":bin_" + name + "_binary" for name in ENTRY_POINTS] + [":" + source.removeprefix("tests/").removesuffix(".rs") + "_binary" for source in INTEGRATIONS] + select({
    "//tools/bazel/rules:aos_cli_fleet_tests_dependencies": [":bin_" + name + "_binary" for name in FLEET_ENTRY_POINTS],
    "//tools/bazel/rules:aos_cli_production_dependencies": [":bin_" + name + "_binary" for name in FLEET_ENTRY_POINTS],
    "//conditions:default": [],
})

rust_doc_test(name = "doc", crate = ":lib")
rust_clippy(name = "clippy", testonly = True, deps = [":lib"] + BINARIES + TEST_ARTIFACTS)
rustfmt_test(name = "format", targets = [":lib"] + BINARIES + TEST_ARTIFACTS)
rust_doc(name = "documentation", crate = ":lib")

aos_license_check(name = "license_closure", testonly = True, roots = [":lib"] + BINARIES + TEST_ARTIFACTS, license_domain = RUST_PACKAGE.license_domain)
aos_license_check(name = "production_license_closure", roots = BINARIES, license_domain = RUST_PACKAGE.license_domain)

aos_package(
    name = "cli_binaries",
    package = RUST_PACKAGE,
    artifacts = {":" + name: "bin/" + name for name in ENTRY_POINTS} | {":" + name: "bin/" + name for name in FLEET_ENTRY_POINTS},
    executables = ["bin/" + name for name in ENTRY_POINTS | FLEET_ENTRY_POINTS],
)

# The production Cargo invocation also ships the native package and image tools.
PRODUCTION_HELPERS = {
    "//crates/aos/packages/aos-package-manager:aos-deployment-check": "aos-deployment-check",
    "//crates/aos/packages/aos-package-manager:aos-image-rollout-boot": "aos-image-rollout-boot",
    "//crates/aos/packages/aos-package-manager:aos-image-rollout-observer": "aos-image-rollout-observer",
    "//crates/aos/packages/aos-package-manager:aos-image-rollout-provider": "aos-image-rollout-provider",
    "//crates/aos/packages/aos-package-manager:aos-package-attestation-provider": "aos-package-attestation-provider",
    "//crates/aos/release/aos-image-finalizer:aos-image-metadata": "aos-image-metadata",
}

aos_package(
    name = "production_binaries",
    package = RUST_PACKAGE,
    artifacts = {":" + name: "bin/" + name for name in ENTRY_POINTS | FLEET_ENTRY_POINTS} | {label: "bin/" + name for label, name in PRODUCTION_HELPERS.items()},
    executables = ["bin/" + name for name in ENTRY_POINTS | FLEET_ENTRY_POINTS] + ["bin/" + name for name in PRODUCTION_HELPERS.values()],
)

rust_clippy(
    name = "production_clippy",
    deps = BINARIES + list(PRODUCTION_HELPERS),
)

aos_license_check(
    name = "production_suite_license_closure",
    roots = BINARIES + list(PRODUCTION_HELPERS),
    license_domain = RUST_PACKAGE.license_domain,
)

aos_source_package(name = "source_package", package = RUST_PACKAGE, srcs = glob(["**/*.rs"]), visibility = ["//visibility:public"])
