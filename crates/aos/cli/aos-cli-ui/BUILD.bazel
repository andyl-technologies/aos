load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_library")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")

package(default_visibility = ["//crates:__subpackages__"])

RUST_PACKAGE = aos_rust_package(
    name = "aos-cli-ui",
    version = "0.1.0",
    edition = "2024",
    description = "Terminal presentation, structured results, progress, and command hints",
    license_expression = "Apache-2.0",
    license_domain = "apache-host",
)

# Cargo unifies transfer features across registry acquisition and presentation.
# Both users must share one crate instance for observer trait identity.
DEPENDENCIES = select({
    "//tools/bazel/rules:hub_native_tests_dependencies": ["//crates/shared/aos-transfer:lib"],
    "//tools/bazel/rules:package_manager_dependencies": ["//crates/shared/aos-transfer:lib"],
    "//tools/bazel/rules:package_manager_tests_dependencies": ["//crates/shared/aos-transfer:lib"],
    "//tools/bazel/rules:release_coordination_dependencies": ["//crates/shared/aos-transfer:lib"],
    "//tools/bazel/rules:registry_native_dependencies": ["//crates/shared/aos-transfer:lib"],
    "//tools/bazel/rules:registry_native_tests_dependencies": ["//crates/shared/aos-transfer:lib"],
    "//tools/bazel/rules:hub_service_tests_dependencies": ["//crates/shared/aos-transfer:lib"],
    "//tools/bazel/rules:hub_service_all_features_tests_dependencies": ["//crates/shared/aos-transfer:lib"],
    "//conditions:default": ["//crates/shared/aos-transfer:lib_without_transfer"],
}) + [
    "//third_party/rust:core_console",
    "//third_party/rust:core_indicatif",
    "//third_party/rust:core_serde_json",
    "//third_party/rust:core_tokio",
]

DEVELOPMENT_DEPENDENCIES = []

rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "aos_cli_ui",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    deps = DEPENDENCIES,
)

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate = ":lib",
    deps = DEVELOPMENT_DEPENDENCIES,
)

rust_doc_test(name = "doc", crate = ":lib")
rust_clippy(name = "clippy", testonly = True, deps = [":lib", ":unit_binary"])
rustfmt_test(name = "format", targets = [":lib", ":unit_binary"])
rust_doc(name = "documentation", crate = ":lib")

aos_license_check(
    name = "license_closure",
    testonly = True,
    roots = [":lib", ":unit_binary"],
    license_domain = RUST_PACKAGE.license_domain,
)

aos_license_check(
    name = "production_license_closure",
    roots = [":lib"],
    license_domain = RUST_PACKAGE.license_domain,
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)
