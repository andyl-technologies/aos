load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rust_lint_config", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_library")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")

package(default_visibility = ["//crates/accache:__subpackages__"])

RUST_PACKAGE = aos_rust_package(
    name = "accache-frontend",
    version = "0.1.0",
    edition = "2024",
    license_expression = "Apache-2.0",
    license_domain = "apache-host",
)

# Cargo leaves frontend warnings at their default level. An explicit setting
# prevents rules_rust from adding its fallback denial of every warning.
rust_lint_config(name = "lints", rustc = {"warnings": "warn"})

rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    lint_config = ":lints",
    crate_name = "accache_frontend",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//third_party/rust:core_log",
        "//third_party/rust:core_serde",
        "//third_party/rust:core_shlex",
    ],
)

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    lint_config = ":lints",
    crate = ":lib",
    deps = [
        "//third_party/rust:core_itertools",
        "//third_party/rust:core_temp_env",
        "//third_party/rust:core_tempfile",
    ],
)

DEVELOPER_ARTIFACTS = [":lib", ":unit_binary"]
rust_doc_test(name = "doc", crate = ":lib")
rust_clippy(name = "clippy", testonly = True, deps = DEVELOPER_ARTIFACTS)
rustfmt_test(name = "format", targets = DEVELOPER_ARTIFACTS)
rust_doc(name = "documentation", crate = ":lib")

aos_license_check(
    name = "license_closure",
    testonly = True,
    roots = DEVELOPER_ARTIFACTS,
    license_domain = RUST_PACKAGE.license_domain,
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    data = ["LICENSE", "UPSTREAM.md"],
    visibility = ["//visibility:public"],
)
