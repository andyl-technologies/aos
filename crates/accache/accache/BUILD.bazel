load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_lint_config", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_binary")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:package.bzl", "aos_package")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")

package(default_visibility = ["//crates/accache:__subpackages__"])

RUST_PACKAGE = aos_rust_package(
    name = "accache",
    version = "0.1.0",
    edition = "2024",
    description = "Daemonless compiler action cache for declared Nix build environments",
    license_expression = "Apache-2.0",
    license_domain = "apache-host",
)

# Mirrors this standalone package's Cargo policy, independently of Crucible lints.
rust_lint_config(
    name = "lints",
    clippy = {"unwrap_used": "deny", "expect_used": "deny"},
)

rust_binary(
    name = "accache",
    package = RUST_PACKAGE,
    lint_config = ":lints",
    crate_name = "accache",
    crate_root = "src/main.rs",
    srcs = glob(["src/**/*.rs"]),
    link_deps = ["@aos_native//:unwinder"],
    deps = [
        "//crates/accache/accache-frontend:lib",
        "//third_party/rust:core_anyhow",
        "//third_party/rust:core_hex",
        "//third_party/rust:core_prost",
        "//third_party/rust:core_rustix",
        "//third_party/rust:core_serde",
        "//third_party/rust:core_serde_json",
        "//third_party/rust:core_sha2",
        "//third_party/rust:core_tempfile",
    ],
)

aos_rust_test(
    name = "bin_accache",
    package = RUST_PACKAGE,
    lint_config = ":lints",
    crate = ":accache",
)

DEVELOPER_ARTIFACTS = [":accache", ":bin_accache_binary"]
rust_clippy(name = "clippy", testonly = True, deps = DEVELOPER_ARTIFACTS)
rustfmt_test(name = "format", targets = DEVELOPER_ARTIFACTS)
rust_doc(name = "documentation", crate = ":accache")

aos_license_check(
    name = "license_closure",
    testonly = True,
    roots = DEVELOPER_ARTIFACTS,
    license_domain = RUST_PACKAGE.license_domain,
)

aos_license_check(
    name = "production_license_closure",
    roots = [":accache"],
    license_domain = RUST_PACKAGE.license_domain,
)

aos_package(
    name = "package",
    package = RUST_PACKAGE,
    artifacts = {":accache": "bin/accache"},
    executables = ["bin/accache"],
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    # Catalog-only data is absent from compilation-only source selections.
    data = glob(["README.md", "tests/**/*.py"], allow_empty = True),
    visibility = ["//visibility:public"],
)
