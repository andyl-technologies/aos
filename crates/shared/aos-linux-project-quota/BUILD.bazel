load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_binary", "rust_library")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:package.bzl", "aos_package")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")

package(default_visibility = ["//visibility:public"])

RUST_PACKAGE = aos_rust_package(
    name = "aos-linux-project-quota",
    version = "0.1.0",
    edition = "2024",
    license_expression = "Apache-2.0",
    license_domain = "apache-host",
)

DEPENDENCIES = [
    "//third_party/rust:core_libc",
    "//third_party/rust:core_rustix",
    "//third_party/rust:core_thiserror",
]

rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "aos_linux_project_quota",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    deps = DEPENDENCIES,
    target_compatible_with = ["@platforms//os:linux"],
)

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate = ":lib",
)

# This executable requires a disposable ext4 guest. Qualification compiles it;
# the separate VM flight supplies its filesystem and privilege boundary.
rust_binary(
    name = "project-quota-flight",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "project_quota_flight",
    crate_root = "examples/project-quota-flight.rs",
    srcs = ["examples/project-quota-flight.rs"],
    deps = [":lib"] + DEPENDENCIES,
)

rust_doc_test(
    name = "doc",
    crate = ":lib",
)

rust_clippy(
    name = "clippy",
    testonly = True,
    deps = [":lib", ":unit_binary", ":project-quota-flight"],
)

rustfmt_test(
    name = "format",
    targets = [":lib", ":unit_binary", ":project-quota-flight"],
)

rust_doc(
    name = "documentation",
    crate = ":lib",
)

aos_license_check(
    name = "license_closure",
    testonly = True,
    roots = [":lib", ":unit_binary", ":project-quota-flight"],
    license_domain = RUST_PACKAGE.license_domain,
)

aos_package(
    name = "flight_package",
    package = RUST_PACKAGE,
    artifacts = {":project-quota-flight": "bin/project-quota-flight"},
    executables = ["bin/project-quota-flight"],
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)
