load("//tools/bazel/rules:clippy.bzl", "aos_package_clippy")
load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_library")
load("//tools/bazel/rules:controller_graph.bzl", "controller_dependencies", "controller_library", "controller_tests")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")

package(default_visibility = ["//crates/crucible:__subpackages__"])

RUST_PACKAGE = aos_rust_package(
    name = "crucible-campaign",
    version = "0.1.0",
    edition = "2024",
    license_expression = "Apache-2.0",
)

DEPENDENCIES = [
    "//third_party/rust:core_blake3",
    "//third_party/rust:core_ed25519_dalek",
    "//third_party/rust:core_num_bigint",
    "//third_party/rust:core_num_integer",
    "//third_party/rust:core_num_traits",
    "//third_party/rust:core_serde",
    "//third_party/rust:core_thiserror",
    "//third_party/rust:core_unicode_normalization",
]

DEVELOPMENT_DEPENDENCIES = [
    "//third_party/rust:core_serde_json",
    "//third_party/rust:core_tempfile",
]

# The combined controller tests retain the S3 development feature graph.
controller_library(
    package = RUST_PACKAGE,
    sources = glob(["src/**/*.rs"], exclude = ["src/bin/**"]),
    common_deps = DEPENDENCIES,
    library_names = ["store"],
)

controller_tests(
    package = RUST_PACKAGE,
    integrations = glob(["tests/*.rs"], exclude = ["tests/gate_campaign_mutation_scaling.rs"], allow_empty = True),
    dependencies = DEPENDENCIES + controller_dependencies(["store"]),
    development_deps = DEVELOPMENT_DEPENDENCIES,
    unit_compile_data = ["//docs/rfcs/0020-crucible-campaigns:schema-registry.tsv", "//docs/rfcs/0020-crucible-campaigns:11-implementation-plan.md"],
)

# Each nondefault variant selects the same named family configuration in both
# packages. Default application consumers retain the ordinary feature graph.
VARIANTS = {
    "": [],
    "_test_support": ["test-support"],
    "_recovery_faults": ["destructive-recovery-faults"],
    "_all_features": ["test-support", "destructive-recovery-faults"],
}

[
    rust_library(
        name = "lib" + suffix,
        package = RUST_PACKAGE,
        lint_config = "//tools/bazel/rules:workspace_lints",
        crate_name = "crucible_campaign",
        crate_root = "src/lib.rs",
        srcs = glob(["src/**/*.rs"], exclude = ["src/bin/**"]),
        crate_features = features,
        deps = DEPENDENCIES + ["//crates/crucible/crucible-store:lib" + suffix],
    )
    for suffix, features in VARIANTS.items()
]

[
    aos_rust_test(
        name = "unit" + suffix,
        package = RUST_PACKAGE,
        lint_config = "//tools/bazel/rules:workspace_lints",
        crate = ":lib" + suffix,
        crate_features = features,
        deps = DEVELOPMENT_DEPENDENCIES,
        compile_data = ["//docs/rfcs/0020-crucible-campaigns:schema-registry.tsv", "//docs/rfcs/0020-crucible-campaigns:11-implementation-plan.md"],
    )
    for suffix, features in VARIANTS.items()
]

# Library-only source selections may omit this package's integration tree.
[
    aos_rust_test(
        name = source.removeprefix("tests/").removesuffix(".rs") + suffix,
        package = RUST_PACKAGE,
        lint_config = "//tools/bazel/rules:workspace_lints",
        crate_root = source,
        srcs = [source] + glob([source.removesuffix(".rs") + "/**/*.rs"], allow_empty = True),
        crate_features = features,
        deps = [":lib" + suffix] + DEPENDENCIES + DEVELOPMENT_DEPENDENCIES + ["//crates/crucible/crucible-store:lib" + suffix],
    )
    for suffix, features in VARIANTS.items()
    for source in glob(["tests/*.rs"], allow_empty = True)
    if source != "tests/gate_campaign_mutation_scaling.rs" or "test-support" in features
]

[
    rust_doc_test(
        name = "doc" + suffix,
        crate = ":lib" + suffix,
    )
    for suffix in VARIANTS
]

TEST_ARTIFACTS = [":unit" + suffix + "_binary" for suffix in VARIANTS] + [
    ":" + source.removeprefix("tests/").removesuffix(".rs") + suffix + "_binary"
    for suffix, features in VARIANTS.items()
    for source in glob(["tests/*.rs"], allow_empty = True)
    if source != "tests/gate_campaign_mutation_scaling.rs" or "test-support" in features
]

[
    test_suite(
        name = "tests" + suffix,
        tests = [":unit" + suffix, ":doc" + suffix] + [
            ":" + source.removeprefix("tests/").removesuffix(".rs") + suffix
            for source in glob(["tests/*.rs"], allow_empty = True)
            if source != "tests/gate_campaign_mutation_scaling.rs" or "test-support" in features
        ],
    )
    for suffix, features in VARIANTS.items()
]

rust_clippy(
    name = "clippy",
    testonly = True,
    deps = [":lib" + suffix for suffix in VARIANTS] + TEST_ARTIFACTS,
)

rustfmt_test(
    name = "format",
    targets = [":lib" + suffix for suffix in VARIANTS] + TEST_ARTIFACTS,
)

rust_doc(
    name = "documentation",
    crate = ":lib",
)

[
    aos_license_check(
        name = "license_closure" + suffix,
        testonly = True,
        roots = [":lib" + suffix, ":unit" + suffix + "_binary"] + [
            ":" + source.removeprefix("tests/").removesuffix(".rs") + suffix + "_binary"
            for source in glob(["tests/*.rs"], allow_empty = True)
            if source != "tests/gate_campaign_mutation_scaling.rs" or "test-support" in features
        ],
        license_domain = RUST_PACKAGE.license_domain,
    )
    for suffix, features in VARIANTS.items()
]

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)

aos_package_clippy(name = "clippy_all")
