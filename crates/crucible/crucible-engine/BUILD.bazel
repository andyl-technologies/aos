    ],
    "tests/host_side_assertions.rs": [
        "src/trigger/assertions.rs",
        "src/trigger/evaluation.rs",
    ],
    "tests/live_qemu_search_fixture.rs": ["//tests/crucible:engine_fixture_inputs"],
    "tests/observed_state_materialization.rs": [
        "src/trigger/conditions.rs",
