        "src/trigger/observability.rs",
    ],
    "tests/debugger_live_fixture.rs": ["//tests/crucible:engine_fixture_inputs"],
    "tests/fault_reference.rs": ["//docs/users/crucible:engine_contracts"],
    "tests/formal_trace_export.rs": [
        "BUILD.bazel",
