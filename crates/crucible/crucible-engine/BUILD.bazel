load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_binary", "rust_library")
load("//tools/bazel/rules:daemon_graph.bzl", "daemon_dependency_libraries")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")

package(default_visibility = ["//crates/crucible:__subpackages__"])

exports_files(["src/model.rs"], visibility = ["//crates/crucible/crucible-cli:__pkg__"])

RUST_PACKAGE = aos_rust_package(
    name = "crucible-engine",
    version = "0.1.0",
    edition = "2024",
    license_expression = "Apache-2.0",
)

DEPENDENCIES = [
    "//crates/crucible/crucible-determinism:lib",
    "//crates/crucible/crucible-campaign:lib",
    "//crates/crucible/crucible-device:lib",
    "//crates/crucible/crucible-store:lib",
    "//crates/crucible/crucible-qemu-protocol:lib",
] + [
    "//third_party/rust:core_" + name
    for name in ["blake3", "ciborium", "regex", "serde", "serde_json", "thiserror", "toml", "tracing"]
]

SHARED_MEMORY = "//crates/crucible/crucible-qemu-shmem:lib"

DEVELOPMENT_DEPENDENCIES = [
    SHARED_MEMORY,
    "//crates/crucible/crucible-test-support:lib",
]

VARIANTS = {
    "": ["default"],
    "_test_support": ["default", "test-support"],
    "_test_double": ["default", "test-double"],
    "_all_features": ["default", "test-double", "test-support"],
}

TEST_DOUBLE_TARGETS = [
    "gate_replay_oracle",
    "gate_abi_conformance",
    "gate_scheduler_liveness",
    "gate_e2e_determinism_concurrency",
]

# Cargo still builds these artifacts when cfg gates remove every test case.
EMPTY_WITHOUT_TEST_DOUBLE = [
    "guest_host_channel_determinism",
    "guest_host_marker_observability",
    "property_fingerprint_neutrality",
]

SOURCES = glob(["src/**/*.rs"])
# Dependency-only workspaces omit this package's tests. Selected test labels and
# Cargo parity still require every test in the family under qualification.
INTEGRATIONS = glob(["tests/*.rs"], allow_empty = True)
EXAMPLES = glob(["examples/*.rs"], allow_empty = True)

[
    rust_library(
        name = "lib" + suffix,
        visibility = ["//crates/crucible:__subpackages__"] + (["//crates/activation/aos-activation-crucible:__pkg__"] if suffix == "_test_support" else []),
        package = RUST_PACKAGE,
        lint_config = "//tools/bazel/rules:workspace_lints",
        crate_name = "crucible_engine",
        crate_root = "src/lib.rs",
        srcs = SOURCES,
        compile_data = ["//crates/crucible/crucible-qemu-shmem:src/abi_version.in"],
        crate_features = features,
        deps = DEPENDENCIES + ([SHARED_MEMORY] if "test-double" in features else []),
    )
    for suffix, features in VARIANTS.items()
]

[
    aos_rust_test(
        name = "unit" + suffix,
        package = RUST_PACKAGE,
        lint_config = "//tools/bazel/rules:workspace_lints",
        crate = ":lib" + suffix,
        crate_features = features,
        deps = DEVELOPMENT_DEPENDENCIES,
    )
    for suffix, features in VARIANTS.items()
]

# Compile-time audits own their exact source, fixture, and documentation inputs.
TEST_COMPILE_INPUTS = {
    "tests/assertion_determinism_nonperturbation.rs": [
        "src/trigger/assertions.rs",
        "src/trigger/evaluation.rs",
    ],
    "tests/assertion_log_fold.rs": [
        "src/trigger/assertions.rs",
