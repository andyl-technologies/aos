    "tests/workload_model.rs": [
        "src/backend.rs",
        "src/device.rs",
    ],
}

EXAMPLE_COMPILE_INPUTS = {
    "examples/phase5_live_asset_fixture.rs": ["//tests/crucible:engine_fixture_inputs"],
}

TEST_SOURCE_INPUTS = {
    "tests/assertion_quiescence_leaves.rs": ["tests/support/mod.rs"],
    "tests/compound_condition_combinators.rs": ["tests/support/mod.rs"],
    "tests/condition_time_leaves.rs": ["tests/support/mod.rs"],
    "tests/condition_vocabulary_shared.rs": ["tests/support/mod.rs"],
    "tests/coverage_condition_leaf.rs": ["tests/support/mod.rs"],
    "tests/event_graph_control_flow.rs": ["tests/support/mod.rs"],
    "tests/gate_guided_adaptive_exploration.rs": [
        "tests/support/adaptive_campaign.rs",
        "tests/support/guidance_search.rs",
    ],
    "tests/gate_signal_fault_system.rs": ["tests/fault_reference.rs"],
    "tests/guest_host_os_agnostic.rs": ["tests/support/mod.rs"],
    "tests/guest_marker_condition_leaf.rs": ["tests/support/mod.rs"],
    "tests/memory_condition_leaf.rs": ["tests/support/mod.rs"],
    "tests/observable_condition_leaves.rs": ["tests/support/mod.rs"],
    "tests/source_size.rs": ["//crates/crucible/crucible-test-support:tests/support/workspace.rs"],
}

TEST_RUNTIME_INPUTS = {
    "tests/source_size.rs": ["//crates:source_catalog", "//tests/crucible:engineering-hygiene-baseline.txt"],
    "tests/workload_model.rs": SOURCES,
}

TEST_ENVIRONMENTS = {
    "tests/source_size.rs": {"AOS_SOURCE_CATALOG": "crates/source_catalog.json"},
    "tests/workload_model.rs": {"AOS_ENGINE_SOURCE_DIR": "crates/crucible/crucible-engine/src"},
}

[
    aos_rust_test(
        name = source.removeprefix("tests/").removesuffix(".rs") + suffix,
        package = RUST_PACKAGE,
        lint_config = "//tools/bazel/rules:workspace_lints",
        crate_root = source,
        srcs = [source] + glob([source.removesuffix(".rs") + "/**/*.rs"], allow_empty = True) + TEST_SOURCE_INPUTS.get(source, []),
        compile_data = TEST_COMPILE_INPUTS.get(source, []),
        env = TEST_ENVIRONMENTS.get(source, {}),
        data = TEST_RUNTIME_INPUTS.get(source, []),
        allow_empty = "test-double" not in features and source.removeprefix("tests/").removesuffix(".rs") in EMPTY_WITHOUT_TEST_DOUBLE,
        crate_features = features,
        deps = [":lib" + suffix] + DEPENDENCIES + DEVELOPMENT_DEPENDENCIES,
    )
    for suffix, features in VARIANTS.items()
    for source in INTEGRATIONS
    if "test-double" in features or source.removeprefix("tests/").removesuffix(".rs") not in TEST_DOUBLE_TARGETS
]

[
    rust_binary(
        name = source.removeprefix("examples/").removesuffix(".rs") + suffix,
        package = RUST_PACKAGE,
        lint_config = "//tools/bazel/rules:workspace_lints",
        crate_name = source.removeprefix("examples/").removesuffix(".rs").replace("-", "_"),
        crate_root = source,
        srcs = [source],
        compile_data = EXAMPLE_COMPILE_INPUTS.get(source, []),
        crate_features = features,
        deps = [":lib" + suffix] + DEPENDENCIES,
    )
    for suffix, features in VARIANTS.items()
    for source in EXAMPLES
]

[
    rust_doc_test(name = "doc" + suffix, crate = ":lib" + suffix)
    for suffix in VARIANTS
]

TEST_ARTIFACTS = [":unit" + suffix + "_binary" for suffix in VARIANTS] + [
    ":" + source.removeprefix("tests/").removesuffix(".rs") + suffix + "_binary"
    for suffix, features in VARIANTS.items()
    for source in INTEGRATIONS
    if "test-double" in features or source.removeprefix("tests/").removesuffix(".rs") not in TEST_DOUBLE_TARGETS
]

EXAMPLE_ARTIFACTS = [
    ":" + source.removeprefix("examples/").removesuffix(".rs") + suffix
    for suffix in VARIANTS
    for source in EXAMPLES
]

rust_clippy(
    name = "clippy",
    testonly = True,
    deps = [":lib" + suffix for suffix in VARIANTS] + TEST_ARTIFACTS + EXAMPLE_ARTIFACTS,
)

rustfmt_test(
    name = "format",
    targets = [":lib" + suffix for suffix in VARIANTS] + TEST_ARTIFACTS + EXAMPLE_ARTIFACTS,
)

rust_doc(name = "documentation", crate = ":lib")

[
    aos_license_check(
        name = "license_closure" + suffix,
        testonly = True,
        roots = [":lib" + suffix, ":unit" + suffix + "_binary"] + [
            ":" + source.removeprefix("tests/").removesuffix(".rs") + suffix + "_binary"
            for source in INTEGRATIONS
            if "test-double" in features or source.removeprefix("tests/").removesuffix(".rs") not in TEST_DOUBLE_TARGETS
        ] + [
            ":" + source.removeprefix("examples/").removesuffix(".rs") + suffix
            for source in EXAMPLES
        ],
        license_domain = RUST_PACKAGE.license_domain,
    )
    for suffix, features in VARIANTS.items()
]

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)

# Daemon-selected features remain separate from this package's own test graph.
daemon_dependency_libraries(
    component = "engine",
    package = RUST_PACKAGE,
    sources = SOURCES,
    common_deps = [
        dependency
        for dependency in DEPENDENCIES
        if dependency not in [
            "//crates/crucible/crucible-campaign:lib",
            "//crates/crucible/crucible-store:lib",
        ]
    ],
    compile_data = ["//crates/crucible/crucible-qemu-shmem:src/abi_version.in"],
)
