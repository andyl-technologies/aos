load("//tools/bazel/rules:clippy.bzl", "aos_package_clippy")
load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_library")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")

package(default_visibility = ["//crates/crucible:__subpackages__"])

RUST_PACKAGE = aos_rust_package(
    name = "crucible-device",
    version = "0.1.0",
    edition = "2024",
    license_expression = "Apache-2.0",
)

DEPENDENCIES = [
    "//crates/crucible/crucible-determinism:lib",
    "//crates/crucible/crucible-qemu-shmem:lib",
    "//third_party/rust:core_blake3",
    "//third_party/rust:core_ciborium",
    "//third_party/rust:core_serde",
    "//third_party/rust:core_thiserror",
]

[
    rust_library(
        name = "lib" + suffix,
        package = RUST_PACKAGE,
        lint_config = "//tools/bazel/rules:workspace_lints",
        crate_name = "crucible_device",
        crate_root = "src/lib.rs",
        srcs = glob(["src/**/*.rs"]),
        crate_features = features,
        deps = DEPENDENCIES,
    )
    for suffix, features in {"": ["default"], "_no_default": []}.items()
]

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate = ":lib",
    crate_features = ["default"],
)

[
    aos_rust_test(
        name = source.removeprefix("tests/").removesuffix(".rs"),
        package = RUST_PACKAGE,
        lint_config = "//tools/bazel/rules:workspace_lints",
        crate_root = source,
        srcs = [source] + glob([source.removesuffix(".rs") + "/**/*.rs"], allow_empty = True),
        crate_features = ["default"],
        deps = [":lib"] + DEPENDENCIES,
    )
    for source in glob(["tests/*.rs"], allow_empty = True)
]

TEST_ARTIFACTS = [":unit_binary"] + [
    ":" + source.removeprefix("tests/").removesuffix(".rs") + "_binary"
    for source in glob(["tests/*.rs"], allow_empty = True)
]

rust_doc_test(
    name = "doc",
    crate = ":lib",
)

rust_clippy(
    name = "clippy",
    testonly = True,
    deps = [":lib"] + TEST_ARTIFACTS,
)

rustfmt_test(
    name = "format",
    targets = [":lib"] + TEST_ARTIFACTS,
)

rust_doc(
    name = "documentation",
    crate = ":lib",
)

aos_license_check(
    name = "license_closure",
    testonly = True,
    roots = [":lib"] + TEST_ARTIFACTS,
    license_domain = RUST_PACKAGE.license_domain,
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "gate_manifest_reference",
    testonly = True,
    # Nix source gates still name this file; retain their existence assertions
    # until those consumers have migrated to declared Bazel contracts.
    srcs = ["Cargo.toml"],
    visibility = ["//crates/crucible/crucible-test-support:__pkg__"],
)

aos_package_clippy(name = "clippy_all")
