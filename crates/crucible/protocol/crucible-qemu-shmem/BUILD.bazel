load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_binary", "rust_library")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")

RUST_PACKAGE = aos_rust_package(
    edition = "2024",
    name = "crucible-qemu-shmem",
    version = "0.1.0",
    license_expression = "MIT OR Apache-2.0",
    license_domain = "permissive-protocol",
)

package(default_visibility = ["//crates/crucible:__subpackages__"])

exports_files(
    ["src/abi_version.in"],
    visibility = [
        "//crates/crucible/engine/crucible-engine:__pkg__",
        "//crates/crucible/testing/crucible-test-support:__pkg__",
    ],
)

DEPENDENCIES = [
    "//third_party/rust:core_blake3",
    "//third_party/rust:core_libc",
    "//third_party/rust:core_sha2",
    "//third_party/rust:core_thiserror",
    "//third_party/rust:core_serde",
    "//third_party/rust:core_serde_json",
    "//crates/crucible/protocol/crucible-qemu-protocol:lib",
]

rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "crucible_qemu_shmem",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["src/abi_version.in"],
    deps = DEPENDENCIES,
)

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate = ":lib",
    compile_data = glob(["tests/fixtures/**"], allow_empty = True),
)

# Each Cargo integration root remains a separate libtest artifact; its support
# modules and compile-time fixtures are declared without an ambient manifest.
[
    aos_rust_test(
        name = source.removeprefix("tests/").removesuffix(".rs"),
        lint_config = "//tools/bazel/rules:workspace_lints",
        package = RUST_PACKAGE,
        crate_root = source,
        srcs = [source] + glob([source.removesuffix(".rs") + "/**/*.rs"], allow_empty = True),
        deps = [":lib"] + DEPENDENCIES,
        compile_data = glob(["src/**/*.rs"]) + glob(["include/**", "tests/fixtures/**"], allow_empty = True),
    )
    for source in glob(["tests/*.rs"], allow_empty = True)
]

rust_doc_test(
    name = "doc",
    crate = ":lib",
)

rust_binary(
    name = "crucible-shmem-abi-header",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "crucible_shmem_abi_header",
    srcs = ["examples/crucible-shmem-abi-header.rs"],
    deps = [":lib"],
)

# Test-only roots need the same closure analysis as installable package roots.
aos_license_check(
    name = "license_closure",
    testonly = True,
    roots = [":lib", ":unit_binary"] + [":crucible-shmem-abi-header"] + [
        ":" + source.removeprefix("tests/").removesuffix(".rs") + "_binary"
        for source in glob(["tests/*.rs"], allow_empty = True)
    ],
    license_domain = "permissive-protocol",
)

rust_clippy(
    name = "clippy",
    testonly = True,
    deps = [":lib", ":unit_binary"] + [
        ":" + source.removeprefix("tests/").removesuffix(".rs") + "_binary"
        for source in glob(["tests/*.rs"], allow_empty = True)
    ],
)

rustfmt_test(
    name = "format",
    targets = [":lib", ":unit_binary"] + [
        ":" + source.removeprefix("tests/").removesuffix(".rs") + "_binary"
        for source in glob(["tests/*.rs"], allow_empty = True)
    ],
)

rust_doc(
    name = "documentation",
    crate = ":lib",
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)
