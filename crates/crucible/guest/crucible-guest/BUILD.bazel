load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_binary", "rust_library")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:package.bzl", "aos_package")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")
load("//tools/bazel/rules:generated.bzl", "aos_python_generator")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")

package(default_visibility = ["//crates/crucible:__subpackages__"])

RUST_PACKAGE = aos_rust_package(
    name = "crucible-guest",
    version = "0.1.0",
    edition = "2024",
    license_expression = "Apache-2.0",
)

DEPENDENCIES = [
    "//crates/crucible/protocol/crucible-qemu-protocol:lib",
    "//third_party/rust:core_libc",
    "//third_party/rust:core_thiserror",
]

# Dependency-only workspaces omit guest integration-test source roots.
INTEGRATIONS = glob(["tests/*.rs"], allow_empty = True)

rust_library(
    name = "lib",
    visibility = ["//crates/crucible:__subpackages__", "//crates/aos/activation/aos-activation-crucible:__pkg__"],
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "crucible_guest",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs", "src/selectable_group.rs"]),
    deps = DEPENDENCIES,
    link_deps = ["@aos_native//:static_runtime"],
)

# Host tests use the guest protocol library without the guest static runtime.
rust_library(
    name = "lib_host",
    testonly = True,
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "crucible_guest",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs", "src/selectable_group.rs"]),
    deps = DEPENDENCIES,
)

rust_binary(
    name = "crucible-guest",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "crucible_guest",
    crate_root = "src/main.rs",
    srcs = ["src/main.rs", "src/selectable_group.rs"],
    deps = [":lib"] + DEPENDENCIES,
)

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate = ":lib",
    deps = ["//crates/crucible/engine/crucible-campaign:lib"],
)

aos_rust_test(
    name = "bin_crucible-guest",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate = ":crucible-guest",
    deps = ["//crates/crucible/engine/crucible-campaign:lib"],
)

[
    aos_rust_test(
        name = source.removeprefix("tests/").removesuffix(".rs"),
        package = RUST_PACKAGE,
        lint_config = "//tools/bazel/rules:workspace_lints",
        crate_root = source,
        srcs = [source],
        deps = [":lib", "//crates/crucible/engine/crucible-campaign:lib"] + DEPENDENCIES,
        data = ["//:MODULE.bazel"] + ([
            ":BUILD.bazel",
            "//tests/build:_bazel-guest.nix",
        ] if source == "tests/gate_abi_conformance.rs" else [
            "//tests/crucible:phase1-production-fingerprint-sample.nix",
            "//tests/crucible:phase7-production-rust-plugin-flight.nix",
            "//docs/rfcs/0010-crucible:24-determinism-harness-testing.md",
        ]),
    )
    for source in INTEGRATIONS
]

rust_doc_test(
    name = "doc",
    crate = ":lib",
)

TEST_ARTIFACTS = [":unit_binary", ":bin_crucible-guest_binary"] + [
    ":" + source.removeprefix("tests/").removesuffix(".rs") + "_binary"
    for source in INTEGRATIONS
]

rust_clippy(
    name = "clippy",
    testonly = True,
    deps = [":lib", ":crucible-guest"] + TEST_ARTIFACTS,
)

rustfmt_test(
    name = "format",
    targets = [":lib", ":crucible-guest"] + TEST_ARTIFACTS,
)

rust_doc(
    name = "documentation",
    crate = ":lib",
)

aos_license_check(
    name = "license_closure",
    testonly = True,
    roots = [":lib", ":crucible-guest"] + TEST_ARTIFACTS,
    license_domain = RUST_PACKAGE.license_domain,
)

config_setting(
    name = "aarch64",
    constraint_values = ["@platforms//cpu:aarch64"],
)

aos_python_generator(
    name = "build_info",
    script = "//tools/bazel/metadata:guest_build_info.py",
    srcs = ["//crates/crucible/protocol/crucible-qemu-protocol:src/doorbell_abi.rs"],
    outs = ["crucible-guest-build-info"],
    env = select({
        ":aarch64": {"AOS_GUEST_SYSTEM": "aarch64-linux"},
        "//conditions:default": {"AOS_GUEST_SYSTEM": "x86_64-linux"},
    }),
)

aos_package(
    name = "package",
    package = RUST_PACKAGE,
    artifacts = {":crucible-guest": "bin/crucible-guest", ":build_info": "nix-support/crucible-guest-build-info"},
    executables = ["bin/crucible-guest"],
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)
