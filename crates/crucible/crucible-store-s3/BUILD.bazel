load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_library")
load("//tools/bazel/rules:controller_graph.bzl", "controller_dependencies", "controller_library", "controller_tests")
load("//tools/bazel/rules:daemon_graph.bzl", "daemon_dependency_libraries")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")

package(default_visibility = ["//crates/crucible:__subpackages__"])

RUST_PACKAGE = aos_rust_package(
    name = "crucible-store-s3",
    version = "0.1.0",
    edition = "2024",
    license_expression = "Apache-2.0",
    license_domain = "apache-host",
)

STORE = "//crates/crucible/crucible-store"
DEPENDENCIES = [
    "//third_party/rust:core_aws_sdk_s3",
    "//third_party/rust:core_thiserror",
    "//third_party/rust:core_tokio",
]
SOURCES = glob(["src/**/*.rs"])
INTEGRATIONS = glob(["tests/*.rs"], allow_empty = True)

rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "crucible_store_s3",
    crate_root = "src/lib.rs",
    srcs = SOURCES,
    deps = [STORE + ":lib"] + DEPENDENCIES,
)

# Cargo enables the store conformance API through a development dependency.
rust_library(
    name = "lib_for_tests",
    testonly = True,
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "crucible_store_s3",
    crate_root = "src/lib.rs",
    srcs = SOURCES,
    deps = [STORE + ":lib_test_support"] + DEPENDENCIES,
)

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate = ":lib_for_tests",
    deps = ["//third_party/rust:core_aws_config"],
)

[
    aos_rust_test(
        name = source.removeprefix("tests/").removesuffix(".rs"),
        package = RUST_PACKAGE,
        lint_config = "//tools/bazel/rules:workspace_lints",
        crate_root = source,
        allow_ignored_only = source == "tests/live_conformance.rs",
        srcs = [source] + glob([source.removesuffix(".rs") + "/**/*.rs"], allow_empty = True),
        deps = [":lib_for_tests", STORE + ":lib_test_support", "//third_party/rust:core_aws_config"] + DEPENDENCIES,
    )
    for source in INTEGRATIONS
]

rust_doc_test(name = "doc", crate = ":lib_for_tests")

TEST_ARTIFACTS = [":unit_binary"] + [
    ":" + source.removeprefix("tests/").removesuffix(".rs") + "_binary"
    for source in INTEGRATIONS
]

rust_clippy(
    name = "clippy",
    testonly = True,
    deps = [":lib", ":lib_for_tests"] + TEST_ARTIFACTS,
)

rustfmt_test(name = "format", targets = [":lib", ":lib_for_tests"] + TEST_ARTIFACTS)

rust_doc(name = "documentation", crate = ":lib")

aos_license_check(
    name = "license_closure",
    testonly = True,
    roots = [":lib_for_tests"] + TEST_ARTIFACTS,
    license_domain = RUST_PACKAGE.license_domain,
)

aos_license_check(
    name = "production_license_closure",
    roots = [":lib"],
    license_domain = RUST_PACKAGE.license_domain,
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)

# The combined controller tests retain the S3 development feature graph.
controller_library(
    package = RUST_PACKAGE,
    sources = SOURCES,
    common_deps = DEPENDENCIES,
    library_names = ["store"],
)

controller_tests(
    package = RUST_PACKAGE,
    integrations = INTEGRATIONS,
    dependencies = DEPENDENCIES + controller_dependencies(["store"]),
    development_deps = ["//third_party/rust:core_aws_config"],
    ignored_only = ["tests/live_conformance.rs"],
)

# Daemon-selected features remain separate from this package's own test graph.
daemon_dependency_libraries(
    component = "s3",
    package = RUST_PACKAGE,
    sources = SOURCES,
    common_deps = DEPENDENCIES,
    compile_data = [],
)
