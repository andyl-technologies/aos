load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_binary", "rust_library")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:package.bzl", "aos_package")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")

package(default_visibility = ["//crates/crucible:__subpackages__"])

RUST_PACKAGE = aos_rust_package(
    name = "crucible-qemu-debug-gateway",
    version = "0.1.0",
    edition = "2024",
    license_expression = "GPL-2.0-only",
    license_domain = "gpl-qemu",
)

SOURCES = glob(["src/**/*.rs"])
DEPENDENCIES = [
    "//crates/crucible/protocol/crucible-qemu-protocol:lib",
    "//third_party/rust:core_thiserror",
]

rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "crucible_qemu_debug_gateway",
    crate_root = "src/lib.rs",
    srcs = SOURCES,
    deps = DEPENDENCIES,
)

rust_binary(
    name = "crucible-debug-gateway",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_root = "src/main.rs",
    srcs = SOURCES,
    deps = [":lib"] + DEPENDENCIES,
)

rust_clippy(name = "clippy", deps = [":lib", ":crucible-debug-gateway"])
rust_doc(name = "documentation", crate = ":lib")
rustfmt_test(name = "format", targets = [":lib", ":crucible-debug-gateway"])

aos_license_check(
    name = "production_license_closure",
    roots = [":lib", ":crucible-debug-gateway"],
    license_domain = "gpl-qemu",
)

aos_package(
    name = "compiler_artifact",
    package = RUST_PACKAGE,
    artifacts = {":crucible-debug-gateway": "bin/crucible-debug-gateway"},
    executables = ["bin/crucible-debug-gateway"],
)

# Lifecycle tests retain the actual Apache client. Their Bazel migration must
# execute that client in a separate process rather than link it into GPL code.
aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)
