load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_binary", "rust_library")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")

package(default_visibility = ["//crates/crucible:__subpackages__"])

RUST_PACKAGE = aos_rust_package(
    name = "crucible-qemu-host",
    version = "0.1.0",
    edition = "2024",
    license_expression = "Apache-2.0",
    license_domain = "apache-host",
)

ENGINE = "//crates/crucible/engine/crucible-engine"
SCHEMA = "//docs/rfcs/0020-crucible-campaigns:schema-registry.tsv"

COMMON_DEPENDENCIES = [
    "//crates/crucible/engine/crucible-device:lib",
    "//crates/shared/aos-linux-project-quota:lib",
    "//crates/crucible/protocol/crucible-qemu-protocol:lib",
    "//crates/crucible/protocol/crucible-qemu-shmem:lib",
] + [
    "//third_party/rust:core_" + name
    for name in ["blake3", "ciborium", "libc", "rustix", "serde", "serde_json", "sha2", "tempfile", "thiserror", "tracing"]
]

VARIANTS = {
    "": ["default"],
    "_test_support": ["default", "test-support"],
}

SOURCES = glob(["src/**/*.rs"])
INTEGRATIONS = glob(["tests/*.rs"], allow_empty = True)
EXAMPLES = glob(["examples/*.rs"], allow_empty = True)

[
    rust_library(
        name = "lib" + suffix,
        package = RUST_PACKAGE,
        lint_config = "//tools/bazel/rules:workspace_lints",
        crate_name = "crucible_qemu_host",
        crate_root = "src/lib.rs",
        srcs = SOURCES,
        crate_features = features,
        deps = COMMON_DEPENDENCIES + [ENGINE + (":lib_test_double" if suffix else ":lib")],
    )
    for suffix, features in VARIANTS.items()
]

# Cargo's development dependency enables the engine test double independently
# of this package's own feature. Production consumers retain the graph above.
[
    rust_library(
        name = "lib_for_tests" + suffix,
        testonly = True,
        package = RUST_PACKAGE,
        lint_config = "//tools/bazel/rules:workspace_lints",
        crate_name = "crucible_qemu_host",
        crate_root = "src/lib.rs",
        srcs = SOURCES,
        crate_features = features,
        deps = COMMON_DEPENDENCIES + [ENGINE + ":lib_test_double"],
    )
    for suffix, features in VARIANTS.items()
]

[
    aos_rust_test(
        name = "unit" + suffix,
        package = RUST_PACKAGE,
        lint_config = "//tools/bazel/rules:workspace_lints",
        crate = ":lib_for_tests" + suffix,
        compile_data = [SCHEMA],
        crate_features = features,
    )
    for suffix, features in VARIANTS.items()
]

SHARED_TEST_SOURCES = {
    "tests/debug_gdbstub.rs": ["tests/support/mod.rs"],
    "tests/deterministic_launch.rs": ["tests/support/mod.rs"],
    "tests/qmp_launch_channel.rs": ["tests/support/mod.rs"],
}

[
    aos_rust_test(
        name = source.removeprefix("tests/").removesuffix(".rs") + suffix,
        package = RUST_PACKAGE,
        lint_config = "//tools/bazel/rules:workspace_lints",
        crate_root = source,
        srcs = [source] + glob([source.removesuffix(".rs") + "/**/*.rs"], allow_empty = True) + SHARED_TEST_SOURCES.get(source, []),
        compile_data = [SCHEMA, "//:qemu_host_patch_audit"] if source == "tests/qmp.rs" else [],
        data = ["//:qemu_host_build_audit", "//tests/crucible:qemu_host_gate_audit"] if source == "tests/gate_qemu_inert.rs" else [],
        crate_features = features,
        deps = [":lib_for_tests" + suffix, ENGINE + ":lib_test_double"] + COMMON_DEPENDENCIES,
    )
    for suffix, features in VARIANTS.items()
    for source in INTEGRATIONS
]

[
    rust_binary(
        name = source.removeprefix("examples/").removesuffix(".rs") + suffix,
        testonly = True,
        package = RUST_PACKAGE,
        lint_config = "//tools/bazel/rules:workspace_lints",
        crate_name = source.removeprefix("examples/").removesuffix(".rs").replace("-", "_"),
        crate_root = source,
        srcs = [source] + glob([source.removesuffix(".rs") + "/**/*.rs"], allow_empty = True),
        crate_features = features,
        deps = [":lib_for_tests" + suffix, ENGINE + ":lib_test_double"] + COMMON_DEPENDENCIES,
    )
    for suffix, features in VARIANTS.items()
    for source in EXAMPLES
]

[
    rust_doc_test(name = "doc" + suffix, crate = ":lib_for_tests" + suffix)
    for suffix in VARIANTS
]

TEST_ARTIFACTS = [":unit" + suffix + "_binary" for suffix in VARIANTS] + [
    ":" + source.removeprefix("tests/").removesuffix(".rs") + suffix + "_binary"
    for suffix in VARIANTS
    for source in INTEGRATIONS
]

EXAMPLE_ARTIFACTS = [
    ":" + source.removeprefix("examples/").removesuffix(".rs") + suffix
    for suffix in VARIANTS
    for source in EXAMPLES
]

LIBRARIES = [":lib" + suffix for suffix in VARIANTS] + [":lib_for_tests" + suffix for suffix in VARIANTS]

rust_clippy(
    name = "clippy",
    testonly = True,
    deps = LIBRARIES + TEST_ARTIFACTS + EXAMPLE_ARTIFACTS,
)

rustfmt_test(
    name = "format",
    targets = LIBRARIES + TEST_ARTIFACTS + EXAMPLE_ARTIFACTS,
)

rust_doc(name = "documentation", crate = ":lib")

[
    aos_license_check(
        name = "license_closure" + suffix,
        testonly = True,
        roots = [":lib_for_tests" + suffix, ":unit" + suffix + "_binary"] + [
            ":" + source.removeprefix("tests/").removesuffix(".rs") + suffix + "_binary"
            for source in INTEGRATIONS
        ] + [
            ":" + source.removeprefix("examples/").removesuffix(".rs") + suffix
            for source in EXAMPLES
        ],
        license_domain = RUST_PACKAGE.license_domain,
    )
    for suffix in VARIANTS
]

[
    aos_license_check(
        name = "production_license_closure" + suffix,
        roots = [":lib" + suffix],
        license_domain = RUST_PACKAGE.license_domain,
    )
    for suffix in VARIANTS
]

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)
