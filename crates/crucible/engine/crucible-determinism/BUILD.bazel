load("@rules_rust//rust:defs.bzl", "rust_doc_test")
load("//tools/bazel/rules:compile.bzl", "rust_library")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")

rust_library(
    name = "lib",
    crate_name = "crucible_determinism",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    deps = ["//third_party/rust:core_thiserror"],
    edition = "2024",
    visibility = ["//crates/crucible:__subpackages__"],
)

aos_rust_test(
    name = "unit",
    package_name = "crucible-determinism",
    crate = ":lib",
)

rust_doc_test(
    name = "doc",
    crate = ":lib",
)
