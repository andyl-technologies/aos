load("//tools/bazel/rules:compile.bzl", "rust_library")
load("//tools/bazel/rules:package.bzl", "aos_package")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")
load("@rules_rust//rust:defs.bzl", "rust_doc_test")

RUST_PACKAGE = aos_rust_package(
    name = "crucible-test-support",
    version = "0.1.0",
    edition = "2024",
    license_expression = "Apache-2.0",
    license_domain = "apache-host",
)

rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    testonly = True,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "crucible_test_support",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    compile_data = [
        "//crates/crucible/crucible-qemu-shmem:src/abi_version.in",
        "//crates/crucible/crucible-qemu-protocol:src/control_protocol_version.in",
    ],
    visibility = ["//crates/crucible:__subpackages__"],
)

exports_files(
    ["tests/support/workspace.rs"],
    visibility = ["//crates/crucible/crucible-engine:__pkg__"],
)

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate = ":lib",
)

# Repository audits and the feature-powerset driver need their own declared
# source/tool inputs. These fixtures execute the harness directly without them.
[
    aos_rust_test(
        name = target,
        package = RUST_PACKAGE,
        lint_config = "//tools/bazel/rules:workspace_lints",
        crate_root = "tests/" + target + ".rs",
        srcs = ["tests/" + target + ".rs"],
        deps = [":lib"],
    )
    for target in [
        "adversarial_host_fixture",
        "fingerprint_definition",
        "gate_abi_conformance",
        "gate_adversarial_determinism",
        "gate_divergence_bisect",
        "gate_e2e_determinism",
        "gate_layer0_determinism",
        "reproduction_artifact",
    ]
]

rust_doc_test(
    name = "doc",
    crate = ":lib",
)

# Runtime ownership comes from the declared catalog. Keep the unused Cargo
# fallback relative: rules_rust's absolute default embeds a sandbox sequence
# number in env!("CARGO_MANIFEST_DIR"), making audit binaries depend on scheduling.
SOURCE_AUDIT_COMPILER_ENV = {"CARGO_MANIFEST_DIR": "crates/crucible/crucible-test-support"}

aos_rust_test(
    name = "crate_unsafe_fence",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_root = "tests/crate_unsafe_fence.rs",
    srcs = [
        "tests/crate_unsafe_fence.rs",
        "tests/support/crate_unsafe_fence.rs",
        "tests/support/workspace.rs",
    ],
    env = {"AOS_SOURCE_CATALOG": "crates/source_catalog.json"},
    rustc_env = SOURCE_AUDIT_COMPILER_ENV,
    data = ["//crates:source_catalog"],
    deps = [
        ":lib",
        "//third_party/rust:core_serde",
        "//third_party/rust:core_serde_json",
        "//third_party/rust:core_toml",
    ],
)

aos_rust_test(
    name = "concurrency_abi_oracle_standards",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_root = "tests/concurrency_abi_oracle_standards.rs",
    srcs = [
        "tests/concurrency_abi_oracle_standards.rs",
        "tests/support/concurrency_abi_oracle_standards.rs",
        "tests/support/workspace.rs",
    ],
    env = {"AOS_SOURCE_CATALOG": "crates/source_catalog.json"},
    rustc_env = SOURCE_AUDIT_COMPILER_ENV,
    data = ["//crates:source_catalog"],
    deps = [
        ":lib",
        "//third_party/rust:core_serde",
        "//third_party/rust:core_serde_json",
        "//third_party/rust:core_toml",
    ],
)

aos_rust_test(
    name = "harness_lint_annotations",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_root = "tests/harness_lint_annotations.rs",
    srcs = [
        "tests/harness_lint_annotations.rs",
        "tests/support/harness_lint/allow.rs",
        "tests/support/harness_lint/common.rs",
        "tests/support/harness_lint/error_logging.rs",
        "tests/support/harness_lint/guidance.rs",
        "tests/support/harness_lint/lex.rs",
        "tests/support/harness_lint/scan.rs",
        "tests/support/source_sections.rs",
        "tests/support/workspace.rs",
    ],
    env = {"AOS_SOURCE_CATALOG": "crates/source_catalog.json"},
    rustc_env = SOURCE_AUDIT_COMPILER_ENV,
    data = ["//crates:source_catalog"],
    deps = [
        ":lib",
        "//third_party/rust:core_serde",
        "//third_party/rust:core_serde_json",
        "//third_party/rust:core_toml",
    ],
)

aos_rust_test(
    name = "determinism_core_coverage",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_root = "tests/determinism_core_coverage.rs",
    srcs = [
        "tests/determinism_core_coverage.rs",
        "tests/support/workspace.rs",
    ],
    env = {"AOS_SOURCE_CATALOG": "crates/source_catalog.json"},
    rustc_env = SOURCE_AUDIT_COMPILER_ENV,
    data = ["//crates:source_catalog"],
    deps = [
        ":lib",
        "//third_party/rust:core_serde",
        "//third_party/rust:core_serde_json",
        "//third_party/rust:core_toml",
    ],
)

aos_package(
    name = "source_audit_binaries",
    package = RUST_PACKAGE,
    testonly = True,
    artifacts = {
        ":crate_unsafe_fence_binary": "bin/crate_unsafe_fence",
        ":concurrency_abi_oracle_standards_binary": "bin/concurrency_abi_oracle_standards",
        ":harness_lint_annotations_binary": "bin/harness_lint_annotations",
        ":determinism_core_coverage_binary": "bin/determinism_core_coverage",
    },
    executables = ["bin/crate_unsafe_fence", "bin/concurrency_abi_oracle_standards", "bin/harness_lint_annotations", "bin/determinism_core_coverage"],
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)
