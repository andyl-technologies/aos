load("//tools/bazel/rules:compile.bzl", "rust_library")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:package.bzl", "aos_package")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")
load("@rules_rust//rust:defs.bzl", "rust_doc_test")

RUST_PACKAGE = aos_rust_package(
    name = "crucible-test-support",
    version = "0.1.0",
    edition = "2024",
    license_expression = "Apache-2.0",
    license_domain = "apache-host",
)

rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    testonly = True,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "crucible_test_support",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    compile_data = [
        "//crates/crucible/crucible-qemu-shmem:src/abi_version.in",
        "//crates/crucible/crucible-qemu-protocol:src/control_protocol_version.in",
    ],
    visibility = ["//crates/crucible:__subpackages__"],
)

exports_files(
    ["tests/support/workspace.rs"],
    visibility = ["//crates/crucible/crucible-engine:__pkg__"],
)

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate = ":lib",
)

# Repository audits and the feature-powerset driver need their own declared
# source/tool inputs. These fixtures execute the harness directly without them.
[
    aos_rust_test(
        name = target,
        package = RUST_PACKAGE,
        lint_config = "//tools/bazel/rules:workspace_lints",
        crate_root = "tests/" + target + ".rs",
        srcs = ["tests/" + target + ".rs"],
        deps = [":lib"],
    )
    for target in [
        "adversarial_host_fixture",
        "fingerprint_definition",
        "gate_abi_conformance",
        "gate_adversarial_determinism",
        "gate_divergence_bisect",
        "gate_e2e_determinism",
        "gate_layer0_determinism",
        "reproduction_artifact",
    ]
]

rust_doc_test(
    name = "doc",
    crate = ":lib",
)

# Runtime ownership comes from the declared catalog. Keep the unused Cargo
# fallback relative: rules_rust's absolute default embeds a sandbox sequence
# number in env!("CARGO_MANIFEST_DIR"), making audit binaries depend on scheduling.
SOURCE_AUDIT_COMPILER_ENV = {"CARGO_MANIFEST_DIR": "crates/crucible/crucible-test-support"}

# The full controller includes every harness integration root, including the
# audits whose Cargo-dependent runtime inputs still need migration. These
# declarations establish compilation coverage, not passing runtime parity.
CONTROLLER_DEVELOPMENT_DEPENDENCIES = [
    "//third_party/rust:core_" + name
    for name in ["rustix", "serde", "serde_json", "sha2", "tempfile", "toml"]
]
CONTROLLER_INTEGRATIONS = glob(["tests/*.rs"])
CONTROLLER_COMPILE_INPUTS = [
    "//crates/crucible/crucible-engine:source_package",
    "//tests/crucible:controller_audit_inputs",
    "//docs/rfcs/0020-crucible-campaigns:controller_audit_inputs",
    "//:qemu_plugin_gate_audit",
]

aos_rust_test(
    name = "unit_controller",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate = ":lib",
    deps = CONTROLLER_DEVELOPMENT_DEPENDENCIES,
)

[
    aos_rust_test(
        name = source.removeprefix("tests/").removesuffix(".rs") + "_controller",
        package = RUST_PACKAGE,
        lint_config = "//tools/bazel/rules:workspace_lints",
        crate_root = source,
        srcs = [source] + glob([source.removesuffix(".rs") + "/**/*.rs", "tests/support/**/*.rs"], allow_empty = True),
        compile_data = CONTROLLER_COMPILE_INPUTS,
        rustc_env = SOURCE_AUDIT_COMPILER_ENV,
        env = {"AOS_SOURCE_CATALOG": "crates/source_catalog.json"},
        runfile_env = {
            "AOS_FEATURE_EVIDENCE": "@aos_controller_features//:features.json",
            "AOS_FEATURE_AUDIT_SCRIPT": "@aos_controller_features//:controller_feature_evidence.py",
            "AOS_FEATURE_AUDIT_PYTHON": "@aos_tools//:python",
        } if source == "tests/feature_powerset.rs" else {
            "AOS_BAZEL_ARCHITECTURE": "@aos_architecture//:architecture.json",
        } if source in ["tests/control_plane_boundary.rs", "tests/crate_layer_graph.rs", "tests/crate_artifact_types.rs"] else {},
        data = ["//crates:source_catalog"] + CONTROLLER_COMPILE_INPUTS + [
            "//tests/crucible:engineering-hygiene-baseline.txt",
            "//tests/crucible:testing-standards-baseline.txt",
            "//docs/rfcs/0010-crucible:spec_index_audit",
        ] + (["@aos_controller_features//:tools"] if source == "tests/feature_powerset.rs" else []),
        deps = [":lib"] + CONTROLLER_DEVELOPMENT_DEPENDENCIES,
    )
    for source in CONTROLLER_INTEGRATIONS
]

CONTROLLER_TESTS = [":unit_controller"] + [
    ":" + source.removeprefix("tests/").removesuffix(".rs") + "_controller"
    for source in CONTROLLER_INTEGRATIONS
]

test_suite(name = "controller_tests", tests = CONTROLLER_TESTS)

aos_license_check(
    name = "controller_test_license_closure",
    testonly = True,
    roots = [":lib"] + [target + "_binary" for target in CONTROLLER_TESTS],
    license_domain = RUST_PACKAGE.license_domain,
)

