load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_binary", "rust_library")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")

package(default_visibility = ["//crates:__subpackages__"])

RUST_PACKAGE = aos_rust_package(
    name = "aos-configuration-image",
    version = "0.1.0",
    edition = "2024",
    description = "Deterministic configuration images, verified boot mounting, and certificate bundles",
    license_expression = "Apache-2.0",
    license_domain = "apache-host",
)

DEPENDENCIES = [
    "//crates/activation/aos-activation:lib",
    "//crates/core/aos-core:lib",
    "//third_party/rust:core_anyhow",
    "//third_party/rust:core_base64",
    "//third_party/rust:core_rustix",
    "//third_party/rust:core_serde",
    "//third_party/rust:core_serde_json",
    "//third_party/rust:core_sha2",
]

rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    crate_name = "aos_configuration_image",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"], exclude = ["src/bin/**/*.rs", "src/mount_main.rs", "src/boot_main.rs", "src/certificate_main.rs", "src/main.rs"]),
    deps = DEPENDENCIES,
)

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    crate = ":lib",
    deps = ["//third_party/rust:core_tempfile"],
)

rust_binary(
    name = "aos-certificate-bundle",
    package = RUST_PACKAGE,
    crate_name = "aos_certificate_bundle",
    crate_root = "src/certificate_main.rs",
    srcs = ["src/certificate_main.rs"],
    deps = [":lib"] + DEPENDENCIES,
)

aos_rust_test(
    name = "bin_aos-certificate-bundle",
    package = RUST_PACKAGE,
    crate_name = "aos_certificate_bundle",
    crate_root = "src/certificate_main.rs",
    srcs = ["src/certificate_main.rs"],
    deps = [":lib"] + DEPENDENCIES,
    allow_empty = True,
)

rust_binary(
    name = "aos-configuration-boot",
    package = RUST_PACKAGE,
    crate_name = "aos_configuration_boot",
    crate_root = "src/boot_main.rs",
    srcs = ["src/boot_main.rs"],
    deps = [":lib"] + DEPENDENCIES,
    # Only command targets bind the package runtime; library consumers do not.
    rustc_env_files = ["@aos_boot_tools//:configuration.env"],
    compile_data = ["@aos_boot_tools//:closure.json"],
)

aos_rust_test(
    name = "bin_aos-configuration-boot",
    package = RUST_PACKAGE,
    crate_name = "aos_configuration_boot",
    crate_root = "src/boot_main.rs",
    srcs = ["src/boot_main.rs"],
    deps = [":lib"] + DEPENDENCIES,
    # Only command targets bind the package runtime; library consumers do not.
    rustc_env_files = ["@aos_boot_tools//:configuration.env"],
    compile_data = ["@aos_boot_tools//:closure.json"],
    allow_empty = True,
)

rust_binary(
    name = "aos-configuration-lower",
    package = RUST_PACKAGE,
    crate_name = "aos_configuration_lower",
    crate_root = "src/main.rs",
    srcs = ["src/main.rs"],
    deps = [":lib"] + DEPENDENCIES,
    # Only command targets bind the package runtime; library consumers do not.
    rustc_env_files = ["@aos_boot_tools//:configuration.env"],
    compile_data = ["@aos_boot_tools//:closure.json"],
)

aos_rust_test(
    name = "bin_aos-configuration-lower",
    package = RUST_PACKAGE,
    crate_name = "aos_configuration_lower",
    crate_root = "src/main.rs",
    srcs = ["src/main.rs"],
    deps = [":lib"] + DEPENDENCIES,
    # Only command targets bind the package runtime; library consumers do not.
    rustc_env_files = ["@aos_boot_tools//:configuration.env"],
    compile_data = ["@aos_boot_tools//:closure.json"],
    allow_empty = True,
)

rust_binary(
    name = "aos-configuration-mount",
    package = RUST_PACKAGE,
    crate_name = "aos_configuration_mount",
    crate_root = "src/mount_main.rs",
    srcs = ["src/mount_main.rs"],
    deps = [":lib"] + DEPENDENCIES,
    # Only command targets bind the package runtime; library consumers do not.
    rustc_env_files = ["@aos_boot_tools//:configuration.env"],
    compile_data = ["@aos_boot_tools//:closure.json"],
)

aos_rust_test(
    name = "bin_aos-configuration-mount",
    package = RUST_PACKAGE,
    crate_name = "aos_configuration_mount",
    crate_root = "src/mount_main.rs",
    srcs = ["src/mount_main.rs"],
    deps = [":lib"] + DEPENDENCIES,
    # Only command targets bind the package runtime; library consumers do not.
    rustc_env_files = ["@aos_boot_tools//:configuration.env"],
    compile_data = ["@aos_boot_tools//:closure.json"],
    allow_empty = True,
)

rust_doc_test(name = "doc", crate = ":lib")

PRODUCTION_ARTIFACTS = [
    ":lib",
    ":aos-certificate-bundle",
    ":aos-configuration-boot",
    ":aos-configuration-lower",
    ":aos-configuration-mount",
]

DEVELOPER_ARTIFACTS = [
    ":lib",
    ":unit_binary",
    ":aos-certificate-bundle",
    ":bin_aos-certificate-bundle_binary",
    ":aos-configuration-boot",
    ":bin_aos-configuration-boot_binary",
    ":aos-configuration-lower",
    ":bin_aos-configuration-lower_binary",
    ":aos-configuration-mount",
    ":bin_aos-configuration-mount_binary",
]

rust_clippy(name = "clippy", testonly = True, deps = DEVELOPER_ARTIFACTS)
rustfmt_test(name = "format", targets = DEVELOPER_ARTIFACTS)
rust_doc(name = "documentation", crate = ":lib")

aos_license_check(
    name = "license_closure",
    testonly = True,
    roots = DEVELOPER_ARTIFACTS,
    license_domain = RUST_PACKAGE.license_domain,
)

aos_license_check(
    name = "production_license_closure",
    roots = PRODUCTION_ARTIFACTS,
    license_domain = RUST_PACKAGE.license_domain,
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)
