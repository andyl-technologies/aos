load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_binary", "rust_library")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")

package(default_visibility = ["//crates:__subpackages__"])

RUST_PACKAGE = aos_rust_package(
    name = "aos-platform-metadata",
    version = "0.1.0",
    edition = "2024",
    description = "Platform facts acquisition, configuration authorization, and first-boot network values",
    license_expression = "Apache-2.0",
    license_domain = "apache-host",
)

DEPENDENCIES = [
    "//crates/activation/aos-activation:lib",
    "//crates/boot/aos-storage-layout:lib",
    "//crates/modules/aos-module-format:lib",
    "//crates/core/aos-core:lib",
    "//crates/nix/aos-nix:lib",
    "//crates/transfer/aos-transfer:lib",
    "//third_party/rust:core_anyhow",
    "//third_party/rust:core_base64",
    "//third_party/rust:core_hex",
    "//third_party/rust:core_rand",
    "//third_party/rust:core_reqwest",
    "//third_party/rust:core_serde",
    "//third_party/rust:core_serde_json",
    "//third_party/rust:core_sha2",
    "//third_party/rust:core_ssh_key",
    "//third_party/rust:core_tempfile",
    "//third_party/rust:core_tokio",
    "//third_party/rust:core_url",
]

PROC_MACROS = [
    "//third_party/rust:core_async_trait",
]

rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    crate_name = "aos_platform_metadata",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"], exclude = ["src/bin/**/*.rs"]),
    deps = DEPENDENCIES,
    proc_macro_deps = PROC_MACROS,
)

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    crate = ":lib",
    compile_data = glob(["tests/fixtures/**/*.yaml"]),
)

rust_binary(
    name = "aos-metadata-acquisition-provider",
    package = RUST_PACKAGE,
    crate_name = "aos_metadata_acquisition_provider",
    crate_root = "src/bin/aos-metadata-acquisition-provider.rs",
    srcs = ["src/bin/aos-metadata-acquisition-provider.rs"],
    deps = [":lib"] + DEPENDENCIES,
    proc_macro_deps = PROC_MACROS,
)

aos_rust_test(
    name = "bin_aos-metadata-acquisition-provider",
    package = RUST_PACKAGE,
    crate_name = "aos_metadata_acquisition_provider",
    crate_root = "src/bin/aos-metadata-acquisition-provider.rs",
    srcs = ["src/bin/aos-metadata-acquisition-provider.rs"],
    deps = [":lib"] + DEPENDENCIES,
    proc_macro_deps = PROC_MACROS,
    allow_empty = True,
)

rust_binary(
    name = "aos-metadata-policy-provider",
    package = RUST_PACKAGE,
    crate_name = "aos_metadata_policy_provider",
    crate_root = "src/bin/aos-metadata-policy-provider.rs",
    srcs = ["src/bin/aos-metadata-policy-provider.rs"],
    deps = [":lib"] + DEPENDENCIES,
    proc_macro_deps = PROC_MACROS,
)

aos_rust_test(
    name = "bin_aos-metadata-policy-provider",
    package = RUST_PACKAGE,
    crate_name = "aos_metadata_policy_provider",
    crate_root = "src/bin/aos-metadata-policy-provider.rs",
    srcs = ["src/bin/aos-metadata-policy-provider.rs"],
    deps = [":lib"] + DEPENDENCIES,
    proc_macro_deps = PROC_MACROS,
    allow_empty = True,
)

rust_doc_test(name = "doc", crate = ":lib")

PRODUCTION_ARTIFACTS = [
    ":lib",
    ":aos-metadata-acquisition-provider",
    ":aos-metadata-policy-provider",
]

DEVELOPER_ARTIFACTS = [
    ":lib",
    ":unit_binary",
    ":aos-metadata-acquisition-provider",
    ":bin_aos-metadata-acquisition-provider_binary",
    ":aos-metadata-policy-provider",
    ":bin_aos-metadata-policy-provider_binary",
]

rust_clippy(name = "clippy", testonly = True, deps = DEVELOPER_ARTIFACTS)
rustfmt_test(name = "format", targets = DEVELOPER_ARTIFACTS)
rust_doc(name = "documentation", crate = ":lib")

aos_license_check(
    name = "license_closure",
    testonly = True,
    roots = DEVELOPER_ARTIFACTS,
    license_domain = RUST_PACKAGE.license_domain,
)

aos_license_check(
    name = "production_license_closure",
    roots = PRODUCTION_ARTIFACTS,
    license_domain = RUST_PACKAGE.license_domain,
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    data = glob(["tests/fixtures/**/*.yaml"]),
    visibility = ["//visibility:public"],
)
