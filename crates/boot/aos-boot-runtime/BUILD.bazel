load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_binary", "rust_library")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:package.bzl", "aos_package")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")

package(default_visibility = ["//crates:__subpackages__"])

RUST_PACKAGE = aos_rust_package(
    name = "aos-boot-runtime",
    version = "0.1.0",
    edition = "2024",
    description = "Retained boot preparation, image staging, boot selection, and initrd store operations",
    license_expression = "Apache-2.0",
    license_domain = "apache-host",
)

DEPENDENCIES = [
    "//crates/activation/aos-activation:lib",
    "//crates/core/aos-core:lib",
    "//third_party/rust:core_anyhow",
    "//third_party/rust:core_serde",
    "//third_party/rust:core_serde_json",
] + select({
    "//tools/bazel/rules:boot_preparation_minimal_dependencies": [],
    "//conditions:default": [
        "//crates/boot/aos-boot-identity:lib",
        "//crates/release/aos-release-format:lib",
        "//crates/nix/aos-nix:lib",
        "//third_party/rust:core_hex",
        "//third_party/rust:core_rustix",
        "//third_party/rust:core_sha2",
        "//third_party/rust:core_tempfile",
        "//third_party/rust:core_zstd",
    ],
})

# The preparation provider also runs before the full image tooling is present.
BOOT_FEATURES = select({
    "//tools/bazel/rules:boot_preparation_minimal_dependencies": [],
    "//conditions:default": ["default", "boot-tools"],
})

rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "aos_boot_runtime",
    crate_root = "src/lib.rs",
    # The standalone-only Nix source slice omits the unselected library tree.
    # Selecting this library still requires its explicit crate_root.
    srcs = glob(["src/**/*.rs"], exclude = ["src/bin/**/*.rs"], allow_empty = True),
    crate_features = BOOT_FEATURES,
    deps = DEPENDENCIES,
)

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate = ":lib",
    crate_features = BOOT_FEATURES,
    deps = ["//third_party/rust:core_tempfile"],
    setup = "@aos_boot_tools//:test-setup",
)

rust_binary(
    name = "aos-boot-preparation-provider",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "aos_boot_preparation_provider",
    crate_root = "src/bin/aos-boot-preparation-provider.rs",
    srcs = ["src/bin/aos-boot-preparation-provider.rs"],
    crate_features = BOOT_FEATURES,
    deps = [":lib"] + DEPENDENCIES,
)

aos_rust_test(
    name = "bin_aos-boot-preparation-provider",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "aos_boot_preparation_provider",
    crate_root = "src/bin/aos-boot-preparation-provider.rs",
    srcs = ["src/bin/aos-boot-preparation-provider.rs"],
    crate_features = BOOT_FEATURES,
    deps = [":lib"] + DEPENDENCIES,
    allow_empty = True,
)

rust_binary(
    name = "aos-systemd-boot-platform",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "aos_systemd_boot_platform",
    crate_root = "src/bin/aos-systemd-boot-platform.rs",
    srcs = ["src/bin/aos-systemd-boot-platform.rs"],
    crate_features = BOOT_FEATURES,
    deps = [":lib"] + DEPENDENCIES,
    target_compatible_with = select({
        "//tools/bazel/rules:boot_preparation_minimal_dependencies": ["@platforms//:incompatible"],
