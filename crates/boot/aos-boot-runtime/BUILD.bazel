BOOT_COMMANDS = select({
    "//tools/bazel/rules:boot_preparation_minimal_dependencies": [],
    "//conditions:default": [":aos-systemd-boot-platform", ":aos-systemd-image-evidence", ":aos-systemd-image-stage", ":aos-systemd-initrd-store"],
})

BOOT_TEST_ARTIFACTS = select({
    "//tools/bazel/rules:boot_preparation_minimal_dependencies": [],
    "//conditions:default": [":bin_aos-systemd-boot-platform_binary", ":bin_aos-systemd-image-evidence_binary", ":bin_aos-systemd-image-stage_binary", ":bin_aos-systemd-initrd-store_binary"],
})

rust_doc_test(name = "doc", crate = ":lib", crate_features = BOOT_FEATURES)

PRODUCTION_ARTIFACTS = [
    ":lib",
    ":aos-boot-preparation-provider",
] + BOOT_COMMANDS

DEVELOPER_ARTIFACTS = [
    ":lib",
    ":unit_binary",
    ":aos-boot-preparation-provider",
    ":bin_aos-boot-preparation-provider_binary",
] + BOOT_COMMANDS + BOOT_TEST_ARTIFACTS

rust_clippy(name = "clippy", testonly = True, deps = DEVELOPER_ARTIFACTS)
rustfmt_test(name = "format", targets = DEVELOPER_ARTIFACTS)
rust_doc(name = "documentation", crate = ":lib", crate_features = BOOT_FEATURES)

aos_license_check(
    name = "license_closure",
    testonly = True,
    roots = DEVELOPER_ARTIFACTS,
    license_domain = RUST_PACKAGE.license_domain,
)

aos_package(
    name = "systemd_production_package",
    package_name = "aos-systemd-provider-boot-tools",
    version = "0.1.0",
    license_expression = RUST_PACKAGE.license_expression,
    license_domain = RUST_PACKAGE.license_domain,
    artifacts = {
        ":aos-systemd-boot-platform": "bin/aos-systemd-boot-platform",
        ":aos-systemd-image-evidence": "bin/aos-systemd-image-evidence",
        ":aos-systemd-image-stage": "bin/aos-systemd-image-stage",
        ":aos-systemd-initrd-store": "bin/aos-systemd-initrd-store",
    },
    executables = ["bin/aos-systemd-boot-platform", "bin/aos-systemd-image-evidence", "bin/aos-systemd-image-stage", "bin/aos-systemd-initrd-store"],
    visibility = ["//visibility:public"],
)

aos_license_check(
    name = "systemd_production_license_closure",
    roots = BOOT_COMMANDS,
    license_domain = RUST_PACKAGE.license_domain,
)

aos_license_check(
    name = "production_license_closure",
    roots = PRODUCTION_ARTIFACTS,
    license_domain = RUST_PACKAGE.license_domain,
)

# The installed preparation handler excludes boot-tools and uses the static
# runtime. Its profile must stay independent of the image tooling above.
PREPARATION_DEPENDENCIES = [
    "//crates/activation/aos-activation:lib",
    "//crates/core/aos-core:lib",
    "//third_party/rust:core_anyhow",
    "//third_party/rust:core_serde",
    "//third_party/rust:core_serde_json",
]

rust_library(
    name = "lib_preparation",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "aos_boot_runtime",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"], exclude = ["src/bin/**/*.rs"], allow_empty = True),
    deps = PREPARATION_DEPENDENCIES,
    link_deps = ["@aos_native//:static_runtime"],
)

rust_binary(
    name = "static_preparation_provider",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "aos_boot_preparation_provider",
    crate_root = "src/bin/aos-boot-preparation-provider.rs",
    srcs = ["src/bin/aos-boot-preparation-provider.rs"],
    deps = [":lib_preparation"] + PREPARATION_DEPENDENCIES,
)

aos_rust_test(
    name = "preparation_unit",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate = ":lib_preparation",
    deps = ["//third_party/rust:core_tempfile"],
    tags = ["manual"],
)

aos_rust_test(
    name = "preparation_bin",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate = ":static_preparation_provider",
    allow_empty = True,
    tags = ["manual"],
)

rust_doc_test(name = "doc_preparation", crate = ":lib_preparation", tags = ["manual"])

aos_license_check(
    name = "preparation_production_license_closure",
    roots = [":lib_preparation", ":static_preparation_provider"],
    license_domain = RUST_PACKAGE.license_domain,
)

aos_license_check(
    name = "preparation_license_closure",
    testonly = True,
    roots = [":preparation_unit_binary", ":preparation_bin_binary"],
    license_domain = RUST_PACKAGE.license_domain,
)

aos_package(
    name = "preparation_package",
    package_name = "aos-boot-preparation-provider",
    version = RUST_PACKAGE.version,
    license_expression = RUST_PACKAGE.license_expression,
    license_domain = RUST_PACKAGE.license_domain,
    artifacts = {":static_preparation_provider": "bin/aos-boot-preparation-provider"},
    executables = ["bin/aos-boot-preparation-provider"],
    visibility = ["//visibility:public"],
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)

# Early initrd orchestration deliberately has no Cargo dependency graph.
rust_binary(
    name = "standalone",
    package = RUST_PACKAGE,
    crate_name = "aos_initrd_preparation",
    crate_root = "standalone/initrd_preparation.rs",
    srcs = ["standalone/initrd_preparation.rs"],
    rustc_env_files = ["@aos_boot_tools//:standalone.env"],
    compile_data = ["@aos_boot_tools//:closure.json"],
)

aos_rust_test(
    name = "standalone_unit",
    package = RUST_PACKAGE,
    crate_name = "aos_initrd_preparation",
    crate_root = "standalone/initrd_preparation.rs",
    srcs = ["standalone/initrd_preparation.rs"],
    rustc_env_files = ["@aos_boot_tools//:standalone.env"],
    compile_data = ["@aos_boot_tools//:closure.json"],
)

STANDALONE_ARTIFACTS = [":standalone", ":standalone_unit_binary"]

aos_package(
    name = "standalone_package",
    package = RUST_PACKAGE,
    artifacts = {":standalone": "bin/aos-boot-preparations"},
    executables = ["bin/aos-boot-preparations"],
)

aos_license_check(
    name = "standalone_production_license_closure",
    roots = [":standalone"],
    license_domain = RUST_PACKAGE.license_domain,
)

rust_clippy(name = "standalone_clippy", testonly = True, deps = STANDALONE_ARTIFACTS)
rustfmt_test(name = "standalone_format", targets = STANDALONE_ARTIFACTS)

aos_license_check(
    name = "standalone_license_closure",
    testonly = True,
    roots = STANDALONE_ARTIFACTS,
    license_domain = RUST_PACKAGE.license_domain,
)
