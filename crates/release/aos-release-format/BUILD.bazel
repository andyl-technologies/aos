load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_library")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")

package(default_visibility = ["//crates:__subpackages__"])

RUST_PACKAGE = aos_rust_package(
    name = "aos-release-format",
    version = "0.1.0",
    edition = "2024",
    description = "Pure release contracts and offline verification for canonical AOS publication",
    license_expression = "Apache-2.0",
    license_domain = "apache-host",
)

DEPENDENCIES = [
    "//third_party/rust:core_anyhow",
    "//crates/core/aos-core:lib",
    "//crates/modules/aos-module-format:lib",
    "//crates/registry/aos-registry-format:lib",
    "//third_party/rust:core_base64",
    "//third_party/rust:core_ed25519_dalek",
    "//third_party/rust:core_humantime",
    "//third_party/rust:core_semver",
    "//third_party/rust:core_serde",
    "//third_party/rust:core_serde_json",
    "//third_party/rust:core_sha2",
]

TEST_DEPENDENCIES = [
    "//third_party/rust:core_tempfile",
]

rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "aos_release_format",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    deps = DEPENDENCIES,
)

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate = ":lib",
    deps = TEST_DEPENDENCIES,
)

aos_rust_test(
    name = "nix_inventory",
    # This artifact retains its existing ignored checkout/Nix integration case.
    allow_ignored_only = True,
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "nix_inventory",
    crate_root = "tests/nix_inventory.rs",
    srcs = ["tests/nix_inventory.rs"],
    deps = [":lib"] + DEPENDENCIES + TEST_DEPENDENCIES,
)

aos_rust_test(
    name = "qualification",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "qualification",
    crate_root = "tests/qualification.rs",
    # The adversarial integration suite imports the same checked-in policy
    # fixture used by the library's tests through an explicit path module.
    # Library-only source selections omit the integration directory. The
    # selected suite still requires its explicit crate_root.
    srcs = glob(["tests/*.rs", "src/test_support/qualification/**/*.rs"], allow_empty = True),
    deps = [":lib"] + DEPENDENCIES + TEST_DEPENDENCIES,
)

rust_doc_test(
    name = "doc",
    crate = ":lib",
)

DEVELOPER_ARTIFACTS = [
    ":lib",
    ":unit_binary",
    ":nix_inventory_binary",
    ":qualification_binary",
]

aos_license_check(
    name = "license_closure",
    testonly = True,
    roots = DEVELOPER_ARTIFACTS,
    license_domain = RUST_PACKAGE.license_domain,
)

rust_clippy(
    name = "clippy",
    testonly = True,
    deps = DEVELOPER_ARTIFACTS,
)

rustfmt_test(
    name = "format",
    targets = DEVELOPER_ARTIFACTS,
)

rust_doc(
    name = "documentation",
    crate = ":lib",
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)

# Shared source fixtures compile in the consuming integration test crate.
filegroup(
    name = "qualification_fixture_sources",
    srcs = glob(["src/test_support/qualification/**/*.rs"], allow_empty = True),
    tags = ["aos-license:apache-host"],
    visibility = ["//crates:__subpackages__"],
)
