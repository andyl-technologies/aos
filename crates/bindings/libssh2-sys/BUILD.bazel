load("//tools/bazel/rules:build_script.bzl", "aos_rust_build_script")
load("//tools/bazel/rules:compile.bzl", "rust_library")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")

package(default_visibility = ["//visibility:public"])

RUST_PACKAGE = aos_rust_package(
    name = "libssh2-sys",
    version = "0.3.1",
    edition = "2021",
    license_expression = "MIT OR Apache-2.0",
    description = "Native bindings to the AOS libssh2 package",
    repository = "https://github.com/andyl-org/aos",
)

aos_rust_build_script(
    name = "build_script",
    package = RUST_PACKAGE,
    src = "build.rs",
    deps = ["//third_party/rust:core_pkg_config"],
    data = ["@aos_native//:ssh_files", "@aos_native//:crypto_files", "@aos_native//:zlib_files"],
    tools = ["@aos_native//:ssh/pkg-config", "@aos_native//:ssh_pkg_config_tools"],
    env = {
        "PKG_CONFIG": "$(execpath @aos_native//:ssh/pkg-config)",
        "PKG_CONFIG_ALLOW_CROSS": "1",
    },
    env_files = ["@aos_native//:ssh/prefix.env"],
    links = "ssh2",
)

rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    crate_name = "libssh2_sys",
    crate_root = "lib.rs",
    srcs = ["lib.rs"],
    deps = [
        ":build_script",
        "//third_party/rust:core_libc",
        "//third_party/rust:core_libz_sys",
        "//third_party/rust:core_openssl_sys",
    ],
    link_deps = ["@aos_native//:ssh"],
)

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    crate = ":lib",
)

aos_license_check(
    name = "production_license_closure",
    roots = [":lib", ":build_script_program"],
    license_domain = RUST_PACKAGE.license_domain,
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = ["build.rs", "lib.rs"],
)
