load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")

# Source ownership is declared before this package's compilation migrates.
RUST_PACKAGE = aos_rust_package(
    name = "aos-hub-service",
    version = "0.1.0",
    edition = "2021",
    license_expression = "Apache-2.0",
    license_domain = "apache-host",
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "presentation_stylesheet",
    srcs = ["src/web/static_assets/style.css"],
    visibility = ["//crates/hub/aos-hub-ui:__pkg__"],
)
