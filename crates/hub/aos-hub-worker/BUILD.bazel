load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_library", "rust_shared_library")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:package.bzl", "aos_package")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")
load("//tools/bazel/rules:worker.bzl", "aos_worker_bundle")

package(default_visibility = ["//crates:__subpackages__"])

RUST_PACKAGE = aos_rust_package(
    name = "aos-hub-worker",
    version = "0.1.0",
    edition = "2021",
    description = "Cloudflare Worker shell for AOS Hub over HubDb colocated SQLite, R2 surfaces, and the shared runtime-neutral application",
    license_expression = "Apache-2.0",
    license_domain = "apache-host",
)

WORKER_FEATURES = select({
    "//tools/bazel/rules:hub_worker_all_features_tests_dependencies": ["default", "do-e2e", "query-timing"],
    "//tools/bazel/rules:hub_worker_wasm_do_e2e_dependencies": ["default", "do-e2e"],
    "//tools/bazel/rules:hub_worker_wasm_all_features_dependencies": ["default", "do-e2e", "query-timing"],
    "//conditions:default": ["default"],
})

DEPENDENCIES = [
    "//third_party/rust:core_anyhow",
    "//crates/hub/aos-hub-db:lib",
    "//crates/hub/aos-hub-model:lib",
    "//crates/hub/aos-hub-service:lib",
    "//crates/artifacts/aos-oci-types:lib",
    "//crates/registry/aos-registry-format:lib",
    "//third_party/rust:core_axum",
    "//third_party/rust:core_base64",
    "//third_party/rust:core_ed25519_dalek",
    "//third_party/rust:core_form_urlencoded",
    "//third_party/rust:core_futures_util",
    "//third_party/rust:core_hex",
    "//third_party/rust:core_http",
    "//third_party/rust:core_js_sys",
    "//third_party/rust:core_rand",
    "//third_party/rust:core_semver",
    "//third_party/rust:core_send_wrapper",
    "//third_party/rust:core_serde",
    "//third_party/rust:core_serde_wasm_bindgen",
    "//third_party/rust:core_serde_json",
    "//third_party/rust:core_sha2",
    "//third_party/rust:core_toml",
    "//third_party/rust:core_tower",
    "//third_party/rust:core_tracing",
    "//third_party/rust:core_url",
    "//third_party/rust:core_uuid",
    "//third_party/rust:core_wasm_bindgen",
    "//third_party/rust:core_wasm_bindgen_futures",
    "//third_party/rust:core_worker",
    "//third_party/rust:core_worker_sys",
]
PROC_MACROS = ["//third_party/rust:core_async_trait"]
SOURCES = glob(["src/**/*.rs"])
WASM_ONLY = ["@platforms//cpu:wasm32", "@platforms//os:none"]

rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    crate_name = "aos_hub_worker",
    crate_root = "src/lib.rs",
    srcs = SOURCES,
    crate_features = WORKER_FEATURES,
    deps = DEPENDENCIES,
    proc_macro_deps = PROC_MACROS,
)

rust_shared_library(
    name = "shared",
    package = RUST_PACKAGE,
    crate_name = "aos_hub_worker",
    crate_root = "src/lib.rs",
    srcs = SOURCES,
    crate_features = WORKER_FEATURES,
    deps = DEPENDENCIES,
    proc_macro_deps = PROC_MACROS,
    target_compatible_with = WASM_ONLY,
)

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    crate = ":lib",
    crate_features = WORKER_FEATURES,
    deps = ["//crates/hub/aos-hub-api:lib", "//crates/hub/aos-hub-native:lib", "//third_party/rust:core_tokio"],
    proc_macro_deps = PROC_MACROS,
)

rust_doc_test(name = "doc", crate = ":lib")
rust_clippy(name = "clippy", testonly = True, deps = [":lib", ":unit_binary"])
rust_clippy(name = "worker_clippy", deps = [":shared"], target_compatible_with = WASM_ONLY)
rust_doc(name = "documentation", crate = ":lib")
rustfmt_test(name = "format", targets = [":lib", ":unit_binary"])
aos_license_check(name = "license_closure", testonly = True, license_domain = "apache-host", roots = [":lib", ":unit_binary"])
aos_license_check(name = "production_license_closure", license_domain = "apache-host", roots = [":shared"])

aos_worker_bundle(
    name = "deployment",
    wasm = ":shared",
    static_assets = "//crates/hub/aos-hub-service:static_assets",
    console = ["@aos_console_assets//:javascript", "@aos_console_assets//:wasm", "@aos_console_assets//:stylesheet"],
    test_hooks = select({
        "//tools/bazel/rules:hub_worker_wasm_do_e2e_dependencies": True,
        "//tools/bazel/rules:hub_worker_wasm_all_features_dependencies": True,
        "//conditions:default": False,
    }),
    target_compatible_with = WASM_ONLY,
)

[
    filegroup(name = "worker_" + kind, srcs = [":deployment"], output_group = "worker_" + kind)
    for kind in ["javascript", "wasm", "assets"]
]

aos_package(
    name = "worker_dist",
    package = RUST_PACKAGE,
    artifacts = {":worker_javascript": "shim.mjs", ":worker_wasm": "index.wasm"},
    directories = {":worker_assets": "assets"},
    target_compatible_with = WASM_ONLY,
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    data = ["README.md", "deploy/DEPLOY.md", "wrangler.toml"],
    visibility = ["//visibility:public"],
)
