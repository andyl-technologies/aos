load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "cc_binary", "rust_binary", "rust_library")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:package.bzl", "aos_package")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")

package(default_visibility = ["//crates:__subpackages__"])

RUST_PACKAGE = aos_rust_package(
    name = "aos-hub-native",
    version = "0.1.0",
    edition = "2021",
    description = "Multi-tenant AOS registry management WebUI and read index (RFC-0004)",
    license_expression = "Apache-2.0",
    license_domain = "apache-host",
)

# The installed package enables PostgreSQL; ordinary tests retain Cargo defaults.
NATIVE_FEATURES = select({
    "//tools/bazel/rules:hub_worker_tests_dependencies": ["default", "test-support"],
    "//tools/bazel/rules:hub_worker_all_features_tests_dependencies": ["default", "test-support"],
    "//tools/bazel/rules:hub_native_postgres_dependencies": ["default", "postgres"],
    "//conditions:default": ["default"],
})

DEPENDENCIES = [
    "//third_party/rust:core_aes_gcm",
    "//third_party/rust:core_anyhow",
    "//crates/core/aos-core:lib",
    "//crates/hub/aos-hub-db:lib",
    "//crates/hub/aos-hub-model:lib",
    "//crates/hub/aos-hub-service:lib",
    "//crates/artifacts/aos-nar:lib",
    "//crates/registry/aos-registry-client:lib",
    "//crates/registry/aos-registry-format:lib",
    "//third_party/rust:core_argon2",
    "//third_party/rust:core_axum",
    "//third_party/rust:core_base64",
    "//third_party/rust:core_bzip2_rs",
    "//third_party/rust:core_ciborium",
    "//third_party/rust:core_clap",
    "//third_party/rust:core_ed25519_dalek",
    "//third_party/rust:core_flate2",
    "//third_party/rust:core_futures_util",
    "//third_party/rust:core_hex",
    "//third_party/rust:core_hmac",
    "//third_party/rust:core_p256",
    "//third_party/rust:core_rand",
    "//third_party/rust:core_reqwest",
    "//third_party/rust:core_rustix",
    "//third_party/rust:core_rustls_pemfile",
    "//third_party/rust:core_semver",
    "//third_party/rust:core_serde",
    "//third_party/rust:core_serde_json",
    "//third_party/rust:core_sha2",
    "//third_party/rust:core_tempfile",
    "//third_party/rust:core_thiserror",
    "//third_party/rust:core_tokio",
    "//third_party/rust:core_tokio_rustls",
    "//third_party/rust:core_tokio_util",
    "//third_party/rust:core_toml",
    "//third_party/rust:core_tower_http",
    "//third_party/rust:core_tracing",
    "//third_party/rust:core_url",
    "//third_party/rust:core_uuid",
    "//third_party/rust:core_xz2",
    "//third_party/rust:core_zeroize",
    "//third_party/rust:core_zstd",
]

TEST_DEPENDENCIES = [
    "//third_party/rust:core_rcgen",
    "//crates/hub/aos-hub-api:lib",
    "//crates/hub/aos-hub-client:lib",
    "//crates/packages/aos-nix-cache:lib",
    "//crates/artifacts/aos-oci:lib",
    "//crates/artifacts/aos-oci-types:lib",
    "//crates/registry/aos-registry-authoring:lib",
    "//third_party/rust:core_futures",
    "//third_party/rust:core_http",
    "//third_party/rust:core_http_body_util",
    "//third_party/rust:core_jsonwebtoken",
    "//third_party/rust:core_lzma_rs",
    "//third_party/rust:core_rusqlite",
    "//third_party/rust:core_sqlx",
    "//third_party/rust:core_tower",
]

PROC_MACROS = ["//third_party/rust:core_async_trait"]
# Other families select only the C identity fixture. Discovery may be empty in
# those source snapshots; compiled Rust targets still require their crate roots.
LIBRARY_SOURCES = glob(["src/**/*.rs"], exclude = ["src/main.rs", "src/bin/**/*.rs"], allow_empty = True)
BINARY_SOURCES = {
    "aos-hub": "src/main.rs",
    "aos-hub-egress": "src/bin/aos-hub-egress.rs",
}

# Child Git/SSH commands opt into the identity shim; the runner never preloads it.
TEST_RUNFILES = {
    "SSL_CERT_FILE": "@aos_cli_runtime//:ca-certificates.crt",
    "AOS_TEST_IDENTITY_PRELOAD": "//crates/hub/aos-hub-native:libnix_test_identity.so",
}
TEST_RUNTIME_DATA = ["@aos_registry_runtime//:closure.json"]

rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    crate_name = "aos_hub_native",
    crate_root = "src/lib.rs",
    srcs = LIBRARY_SOURCES,
    crate_features = NATIVE_FEATURES,
    deps = DEPENDENCIES,
    proc_macro_deps = PROC_MACROS,
)

[
    rust_binary(
        name = name,
        package = RUST_PACKAGE,
        crate_name = name.replace("-", "_"),
        crate_root = source,
        srcs = [source],
        crate_features = NATIVE_FEATURES,
        deps = [":lib"] + DEPENDENCIES,
        proc_macro_deps = PROC_MACROS,
        # Keep the binary and libtest editor views on the same declared root.
        rustc_env = {"CARGO_MANIFEST_DIR": "crates/hub/aos-hub-native"},
    )
    for name, source in BINARY_SOURCES.items()
]

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    crate = ":lib",
    crate_features = NATIVE_FEATURES,
    deps = TEST_DEPENDENCIES,
    proc_macro_deps = PROC_MACROS,
    setup = "@aos_registry_runtime//:setup",
    data = TEST_RUNTIME_DATA,
    runfile_env = TEST_RUNFILES,
)

[
    aos_rust_test(
        name = "bin_" + name,
        allow_empty = name == "aos-hub-egress",
        package = RUST_PACKAGE,
        crate_name = name.replace("-", "_"),
        crate_root = source,
        srcs = [source],
        crate_features = NATIVE_FEATURES,
        deps = [":lib"] + DEPENDENCIES + TEST_DEPENDENCIES,
        proc_macro_deps = PROC_MACROS,
        setup = "@aos_registry_runtime//:setup",
        # Main's command coverage reads the declared VM test at runtime.
        data = TEST_RUNTIME_DATA + (["//tests/vm:hub_native_operations_source"] if name == "aos-hub" else []),
        rustc_env = {"CARGO_MANIFEST_DIR": "crates/hub/aos-hub-native"},
        runfile_env = TEST_RUNFILES,
    )
    for name, source in BINARY_SOURCES.items()
]

INTEGRATIONS = [
    "auth",
    "config",
    "console",
    "container_admin",
    "dialect",
    "e2e",
    "git_interop",
    "gitconfig",
    "hardening",
    "http_source",
    "mirror",
    "oci_alert_rules",
    "oci_distribution",
    "oidc",
    "operations",
    "password",
    "seed",
    "settings_workflows",
    "tenancy",
    "tenancy_read_authz",
    "web",
    "webauthn",
    "webhook"
]

COMMON_INTEGRATIONS = [
    "config",
    "dialect",
    "e2e",
    "git_interop",
    "gitconfig",
    "hardening",
    "http_source",
    "mirror",
    "oci_distribution",
    "operations",
    "password",
    "settings_workflows",
    "tenancy",
    "tenancy_read_authz",
    "web",
    "webhook"
]

INTEGRATION_INPUTS = {
    "console": ["tests/fixtures/removed-management-paths-v1.json", "tests/fixtures/removed-management-posts-v1.json"],
    "oci_alert_rules": ["monitoring/oci-alerts.rules.yml"],
    "oci_distribution": ["tests/fixtures/oci-protocol-parity-v1.json"],
}

[
    aos_rust_test(
        name = name,
        package = RUST_PACKAGE,
        crate_name = name,
        crate_root = "tests/" + name + ".rs",
        srcs = ["tests/" + name + ".rs"] + (glob(["tests/common/**/*.rs"], allow_empty = True) if name in COMMON_INTEGRATIONS else []),
        compile_data = INTEGRATION_INPUTS.get(name, []),
        crate_features = NATIVE_FEATURES,
        deps = [":lib"] + DEPENDENCIES + TEST_DEPENDENCIES,
        proc_macro_deps = PROC_MACROS,
        setup = "@aos_registry_runtime//:setup",
        data = TEST_RUNTIME_DATA,
        runfile_env = TEST_RUNFILES,
    )
    for name in INTEGRATIONS
]

DEVELOPER_ARTIFACTS = [":lib", ":unit_binary"] + [
    ":" + name for name in BINARY_SOURCES
] + [
    ":bin_" + name + "_binary" for name in BINARY_SOURCES
] + [
    ":" + name + "_binary" for name in INTEGRATIONS
]

rust_doc_test(name = "doc", crate = ":lib")
rust_clippy(name = "clippy", testonly = True, deps = DEVELOPER_ARTIFACTS)
rustfmt_test(name = "format", targets = DEVELOPER_ARTIFACTS)
rust_doc(name = "documentation", crate = ":lib")

aos_license_check(
    name = "license_closure",
    testonly = True,
    roots = DEVELOPER_ARTIFACTS,
    license_domain = RUST_PACKAGE.license_domain,
)

aos_license_check(
    name = "production_license_closure",
    roots = [":lib"] + [":" + name for name in BINARY_SOURCES],
    license_domain = RUST_PACKAGE.license_domain,
)

# The product name differs from the Cargo crate's internal name.
aos_package(
    name = "native_package",
    package_name = "aos-hub",
    version = RUST_PACKAGE.version,
    license_expression = RUST_PACKAGE.license_expression,
    license_domain = RUST_PACKAGE.license_domain,
    artifacts = {":" + name: "bin/" + name for name in BINARY_SOURCES},
    executables = ["bin/" + name for name in BINARY_SOURCES],
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"], allow_empty = True),
    data = glob(["tests/fixtures/*.json", "monitoring/*.yml", "tests/*.c"], allow_empty = True),
    visibility = ["//visibility:public"],
)

# Source-built Git/OpenSSH fixtures need an identity even when the Nix build
# user is absent from passwd. Existing tests scope this shim to child commands.
cc_binary(
    name = "libnix_test_identity.so",
    srcs = ["tests/nix_builder_identity.c"],
    copts = ["-O2", "-fPIC", "-Wall", "-Wextra", "-Werror"],
    linkshared = True,
    visibility = ["//crates/cli:__subpackages__", "//crates/packages:__subpackages__", "//crates/registry:__subpackages__", "//crates/release:__subpackages__"],
)
