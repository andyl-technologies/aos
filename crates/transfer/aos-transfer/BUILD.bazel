load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_library")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")

package(default_visibility = ["//crates:__subpackages__"])

RUST_PACKAGE = aos_rust_package(
    name = "aos-transfer",
    version = "0.1.0",
    edition = "2021",
    description = "",
    license_expression = "Apache-2.0",
    license_domain = "apache-host",
)

# These consumers explicitly opt in without enabling the Cargo default flag.
TRANSFER_FEATURES = select({
    "//tools/bazel/rules:aos_cli_tests_dependencies": ["transfer"],
    "//tools/bazel/rules:aos_cli_fleet_tests_dependencies": ["transfer"],
    "//tools/bazel/rules:aos_cli_production_dependencies": ["transfer"],
    "//tools/bazel/rules:hub_worker_tests_dependencies": ["transfer"],
    "//tools/bazel/rules:hub_worker_all_features_tests_dependencies": ["transfer"],
    "//tools/bazel/rules:hub_native_postgres_dependencies": ["transfer"],
    "//tools/bazel/rules:hub_native_tests_dependencies": ["transfer"],
    "//tools/bazel/rules:package_manager_dependencies": ["transfer"],
    "//tools/bazel/rules:package_manager_tests_dependencies": ["transfer"],
    "//tools/bazel/rules:boot_preparation_dependencies": ["transfer"],
    "//tools/bazel/rules:boot_preparation_minimal_dependencies": ["transfer"],
    "//tools/bazel/rules:release_coordination_dependencies": ["transfer"],
    "//tools/bazel/rules:registry_native_dependencies": ["transfer"],
    "//tools/bazel/rules:registry_native_tests_dependencies": ["transfer"],
    "//tools/bazel/rules:hub_service_tests_dependencies": ["transfer"],
    "//tools/bazel/rules:hub_service_all_features_tests_dependencies": ["transfer"],
    "//conditions:default": ["default", "transfer"],
})

TRANSFER_DEPENDENCIES = [
    "//third_party/rust:core_aws_config",
    "//third_party/rust:core_aws_sdk_s3",
    "//third_party/rust:core_aws_types",
    "//third_party/rust:core_bytes",
    "//third_party/rust:core_digest",
    "//third_party/rust:core_futures_util",
    "//third_party/rust:core_hex",
    "//third_party/rust:core_rand",
    "//third_party/rust:core_reqwest",
    "//third_party/rust:core_serde",
    "//third_party/rust:core_sha2",
    "//third_party/rust:core_ssh2",
    "//third_party/rust:core_tempfile",
    "//third_party/rust:core_tokio",
    "//third_party/rust:core_tokio_util",
    "//third_party/rust:core_tracing",
    "//third_party/rust:core_url",
]

COMMON_DEPENDENCIES = ["//third_party/rust:core_anyhow", "//third_party/rust:core_serde_json"]

# Tempfile remains available to tests when the optional transport is disabled.
TEST_DEPENDENCIES = ["//third_party/rust:core_tempfile"]

rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    crate_name = "aos_transfer",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    crate_features = TRANSFER_FEATURES,
    deps = COMMON_DEPENDENCIES + TRANSFER_DEPENDENCIES,
    proc_macro_deps = ["//third_party/rust:core_async_trait"],
)

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    runfile_env = {"SSL_CERT_FILE": "@aos_cli_runtime//:ca-certificates.crt"},
    crate = ":lib",
    crate_features = TRANSFER_FEATURES,
    deps = TEST_DEPENDENCIES,
)

rust_doc_test(
    name = "doc",
    crate = ":lib",
    crate_features = TRANSFER_FEATURES,
)

# Disabling transfer leaves the lightweight shared error/config surface.
rust_library(
    name = "lib_without_transfer",
    package = RUST_PACKAGE,
    crate_name = "aos_transfer",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    deps = COMMON_DEPENDENCIES,
)

aos_rust_test(
    name = "unit_without_transfer",
    package = RUST_PACKAGE,
    crate = ":lib_without_transfer",
    deps = TEST_DEPENDENCIES,
)

rust_doc_test(
    name = "doc_without_transfer",
    crate = ":lib_without_transfer",
)

aos_license_check(
    name = "license_closure_without_transfer",
    testonly = True,
    roots = [":lib_without_transfer", ":unit_without_transfer_binary"],
    license_domain = RUST_PACKAGE.license_domain,
)

DEVELOPER_ARTIFACTS = [
    ":lib_without_transfer",
    ":unit_without_transfer_binary",
    ":lib",
    ":unit_binary",
]

aos_license_check(
    name = "license_closure",
    testonly = True,
    roots = [":lib", ":unit_binary"],
    license_domain = RUST_PACKAGE.license_domain,
)

rust_clippy(
    name = "clippy",
    testonly = True,
    deps = DEVELOPER_ARTIFACTS,
)

rustfmt_test(
    name = "format",
    targets = DEVELOPER_ARTIFACTS,
)

rust_doc(
    name = "documentation",
    crate = ":lib",
    crate_features = TRANSFER_FEATURES,
)

aos_license_check(
    name = "production_license_closure",
    roots = [":lib"],
    license_domain = RUST_PACKAGE.license_domain,
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)
