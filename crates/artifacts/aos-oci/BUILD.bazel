load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_library")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")

package(default_visibility = ["//crates:__subpackages__"])

RUST_PACKAGE = aos_rust_package(
    name = "aos-oci",
    version = "0.1.0",
    edition = "2024",
    description = "Verified OCI layout, archive, and Distribution operations for AOS",
    license_expression = "Apache-2.0",
    license_domain = "apache-host",
)

DEPENDENCIES = [
    "//third_party/rust:core_anyhow",
    "//crates/artifacts/aos-oci-types:lib",
    "//crates/registry/aos-registry-format:lib",
    "//third_party/rust:core_base64",
    "//third_party/rust:core_bytes",
    "//third_party/rust:core_flate2",
    "//third_party/rust:core_futures_util",
    "//third_party/rust:core_hex",
    "//third_party/rust:core_reqwest",
    "//third_party/rust:core_rustix",
    "//third_party/rust:core_rustls_native_certs",
    "//third_party/rust:core_serde",
    "//third_party/rust:core_serde_json",
    "//third_party/rust:core_sha2",
    "//third_party/rust:core_tar",
    "//third_party/rust:core_tempfile",
    "//third_party/rust:core_tokio",
    "//third_party/rust:core_tokio_util",
    "//third_party/rust:core_url",
    "//third_party/rust:core_zeroize",
    "//third_party/rust:core_zstd",
]

TEST_DEPENDENCIES = [
    "//third_party/rust:core_axum",
    "//third_party/rust:core_ed25519_dalek",
]

rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "aos_oci",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    deps = DEPENDENCIES,
)

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    runfile_env = {"SSL_CERT_FILE": "@aos_cli_runtime//:ca-certificates.crt"},
    crate = ":lib",
    deps = TEST_DEPENDENCIES,
)

aos_rust_test(
    name = "external_signing",
    runfile_env = {"SSL_CERT_FILE": "@aos_cli_runtime//:ca-certificates.crt"},
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "external_signing",
    crate_root = "tests/external_signing.rs",
    srcs = glob(["tests/**/*.rs"]),
    deps = [":lib"] + DEPENDENCIES + TEST_DEPENDENCIES,
)

aos_rust_test(
    name = "layout",
    runfile_env = {"SSL_CERT_FILE": "@aos_cli_runtime//:ca-certificates.crt"},
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "layout",
    crate_root = "tests/layout.rs",
    srcs = glob(["tests/**/*.rs"]),
    deps = [":lib"] + DEPENDENCIES + TEST_DEPENDENCIES,
)

aos_rust_test(
    name = "registry",
    runfile_env = {"SSL_CERT_FILE": "@aos_cli_runtime//:ca-certificates.crt"},
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "registry",
    crate_root = "tests/registry.rs",
    srcs = glob(["tests/**/*.rs"]),
    deps = [":lib"] + DEPENDENCIES + TEST_DEPENDENCIES,
)

rust_doc_test(
    name = "doc",
    crate = ":lib",
)

DEVELOPER_ARTIFACTS = [
    ":lib",
    ":unit_binary",
    ":external_signing_binary",
    ":layout_binary",
    ":registry_binary",
]

aos_license_check(
    name = "license_closure",
    testonly = True,
    roots = DEVELOPER_ARTIFACTS,
    license_domain = RUST_PACKAGE.license_domain,
)

rust_clippy(
    name = "clippy",
    testonly = True,
    deps = DEVELOPER_ARTIFACTS,
)

rustfmt_test(
    name = "format",
    targets = DEVELOPER_ARTIFACTS,
)

rust_doc(
    name = "documentation",
    crate = ":lib",
)

aos_license_check(
    name = "production_license_closure",
    roots = [":lib"],
    license_domain = RUST_PACKAGE.license_domain,
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)

# Shared source fixtures compile in the consuming integration test crate.
filegroup(
    name = "registry_fixture_sources",
    srcs = glob(["tests/support/**/*.rs"]),
    tags = ["aos-license:apache-host"],
    visibility = ["//crates:__subpackages__"],
)
