load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_library")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")

package(default_visibility = ["//crates:__subpackages__"])

RUST_PACKAGE = aos_rust_package(
    name = "aos-nar",
    version = "0.1.0",
    edition = "2024",
    description = "Nix archive formats, binary-cache metadata, and content signing",
    license_expression = "Apache-2.0",
    license_domain = "apache-host",
)

DEPENDENCIES = [
    "//third_party/rust:core_anyhow",
    "//third_party/rust:core_base64",
    "//third_party/rust:core_ed25519_dalek",
    "//third_party/rust:core_hex",
    "//third_party/rust:core_sha2",
]

# Cargo unifies compression across package dispatch and registry consumers.
LIBRARY_FEATURES = select({
    "//tools/bazel/rules:aos_cli_tests_dependencies": ["compression", "default"],
    "//tools/bazel/rules:aos_cli_fleet_tests_dependencies": ["compression", "default"],
    "//tools/bazel/rules:aos_cli_production_dependencies": ["compression", "default"],
    "//tools/bazel/rules:package_manager_dependencies": ["compression", "default"],
    "//tools/bazel/rules:deployment_check_dependencies": ["compression", "default"],
    "//tools/bazel/rules:package_manager_tests_dependencies": ["compression", "default"],
    "//tools/bazel/rules:package_evaluation_driver_dependencies": ["compression", "default"],
    "//conditions:default": ["default"],
})

COMPRESSION_DEPENDENCIES = select({
    "//tools/bazel/rules:aos_cli_tests_dependencies": ["//third_party/rust:core_thiserror", "//third_party/rust:core_zstd"],
    "//tools/bazel/rules:aos_cli_fleet_tests_dependencies": ["//third_party/rust:core_thiserror", "//third_party/rust:core_zstd"],
    "//tools/bazel/rules:aos_cli_production_dependencies": ["//third_party/rust:core_thiserror", "//third_party/rust:core_zstd"],
    "//tools/bazel/rules:package_manager_dependencies": ["//third_party/rust:core_thiserror", "//third_party/rust:core_zstd"],
    "//tools/bazel/rules:deployment_check_dependencies": ["//third_party/rust:core_thiserror", "//third_party/rust:core_zstd"],
    "//tools/bazel/rules:package_manager_tests_dependencies": ["//third_party/rust:core_thiserror", "//third_party/rust:core_zstd"],
    "//tools/bazel/rules:package_evaluation_driver_dependencies": ["//third_party/rust:core_thiserror", "//third_party/rust:core_zstd"],
    "//conditions:default": [],
})

rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "aos_nar",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    crate_features = LIBRARY_FEATURES,
    deps = DEPENDENCIES + COMPRESSION_DEPENDENCIES,
)

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate = ":lib",
    crate_features = LIBRARY_FEATURES,
    deps = ["//third_party/rust:core_tempfile"],
)

rust_doc_test(
    name = "doc",
    crate = ":lib",
)

aos_license_check(
    name = "license_closure",
    testonly = True,
    roots = [":lib", ":unit_binary"],
    license_domain = RUST_PACKAGE.license_domain,
)

rust_library(
    name = "lib_compression",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "aos_nar",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["compression", "default"],
    deps = DEPENDENCIES + ["//third_party/rust:core_thiserror", "//third_party/rust:core_zstd"],
)

aos_rust_test(
    name = "unit_compression",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate = ":lib_compression",
    crate_features = ["compression", "default"],
    deps = ["//third_party/rust:core_tempfile"],
)

rust_doc_test(
    name = "doc_compression",
    crate = ":lib_compression",
)

aos_license_check(
    name = "license_closure_compression",
    testonly = True,
    roots = [":lib_compression", ":unit_compression_binary"],
    license_domain = RUST_PACKAGE.license_domain,
)

DEVELOPER_ARTIFACTS = [":lib", ":lib_compression", ":unit_binary", ":unit_compression_binary"]

rust_clippy(
    name = "clippy",
    testonly = True,
    deps = DEVELOPER_ARTIFACTS,
)

rustfmt_test(
    name = "format",
    targets = DEVELOPER_ARTIFACTS,
)

rust_doc(
    name = "documentation",
    crate = ":lib",
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)
