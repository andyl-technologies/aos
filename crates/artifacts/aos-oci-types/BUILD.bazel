load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_library")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")

package(default_visibility = ["//crates:__subpackages__"])

RUST_PACKAGE = aos_rust_package(
    name = "aos-oci-types",
    version = "0.1.0",
    edition = "2024",
    description = "Wasm-friendly OCI image and Distribution contracts for AOS",
    license_expression = "Apache-2.0",
)

DEPENDENCIES = [
    "//third_party/rust:core_base64",
    "//third_party/rust:core_serde",
    "//third_party/rust:core_serde_json",
    "//crates/core/aos-core:lib",
    "//third_party/rust:core_thiserror",
]

rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "aos_oci_types",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    deps = DEPENDENCIES,
)

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate = ":lib",
)

[
    aos_rust_test(
        name = source.removeprefix("tests/").removesuffix(".rs"),
        package = RUST_PACKAGE,
        lint_config = "//tools/bazel/rules:workspace_lints",
        crate_root = source,
        srcs = [source],
        compile_data = glob(["tests/*.json"], allow_empty = True),
        deps = [":lib"] + DEPENDENCIES,
    )
    # Dependency-only source slices omit this package's integration roots.
    for source in glob(["tests/*.rs"], allow_empty = True)
]

TEST_ARTIFACTS = [":unit_binary"] + [
    ":" + source.removeprefix("tests/").removesuffix(".rs") + "_binary"
    for source in glob(["tests/*.rs"], allow_empty = True)
]

rust_doc_test(
    name = "doc",
    crate = ":lib",
)

rust_clippy(
    name = "clippy",
    testonly = True,
    deps = [":lib"] + TEST_ARTIFACTS,
)

rustfmt_test(
    name = "format",
    targets = [":lib"] + TEST_ARTIFACTS,
)

rust_doc(
    name = "documentation",
    crate = ":lib",
)

aos_license_check(
    name = "license_closure",
    testonly = True,
    roots = [":lib"] + TEST_ARTIFACTS,
    license_domain = RUST_PACKAGE.license_domain,
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)
