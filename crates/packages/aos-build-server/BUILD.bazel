load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_library")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")

package(default_visibility = ["//crates:__subpackages__"])

RUST_PACKAGE = aos_rust_package(
    name = "aos-build-server",
    version = "0.1.0",
    edition = "2024",
    license_expression = "Apache-2.0",
    license_domain = "apache-host",
)

DEPENDENCIES = [
    "//crates/artifacts/aos-nar:lib",
    "//crates/nix/aos-nix:lib",
    "//crates/packages/aos-build-api:lib",
    "//third_party/rust:core_anyhow",
    "//third_party/rust:core_serde",
    "//third_party/rust:core_serde_json",
    "//third_party/rust:core_tokio",
    "//third_party/rust:core_axum",
    "//third_party/rust:core_tower_http",
    "//third_party/rust:core_rusqlite",
    "//third_party/rust:core_jsonwebtoken",
    "//third_party/rust:core_uuid",
    "//third_party/rust:core_rand",
    "//third_party/rust:core_ed25519_dalek",
    "//third_party/rust:core_zstd",
    "//third_party/rust:core_tokio_stream",
    "//third_party/rust:core_humantime",
    "//third_party/rust:core_humantime_serde",
    "//third_party/rust:core_sha2",
    "//third_party/rust:core_hex",
    "//third_party/rust:core_base64",
    "//third_party/rust:core_toml",
    "//third_party/rust:core_tokio_util",
    "//third_party/rust:core_regex",
    "//third_party/rust:core_glob",
    "//third_party/rust:core_indicatif",
    "//third_party/rust:core_console",
    "//third_party/rust:core_futures_util",
    "//third_party/rust:core_tracing",
    "//third_party/rust:core_connectrpc",
    "//third_party/rust:core_buffa",
    "//third_party/rust:core_prost",
    "//third_party/rust:core_futures",
    "//third_party/rust:core_rustls",
    "//third_party/rust:core_rustls_pemfile",
    "//third_party/rust:core_rustls_pki_types",
    "//third_party/rust:core_tokio_rustls",
    "//third_party/rust:core_rcgen",
]

DEVELOPMENT_DEPENDENCIES = [
    "//crates/packages/aos-build-client:lib",
    "//third_party/rust:core_tempfile",
]

rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    crate_name = "aos_build_server",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    deps = DEPENDENCIES,
    proc_macro_deps = ["//third_party/rust:core_async_trait"],
)

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    crate = ":lib",
    deps = DEVELOPMENT_DEPENDENCIES,
)

aos_rust_test(
    name = "rpc_roundtrip",
    package = RUST_PACKAGE,
    crate_name = "rpc_roundtrip",
    crate_root = "tests/rpc_roundtrip.rs",
    srcs = ["tests/rpc_roundtrip.rs"],
    deps = [":lib"] + DEPENDENCIES + DEVELOPMENT_DEPENDENCIES,
    proc_macro_deps = ["//third_party/rust:core_async_trait"],
)

DEVELOPER_ARTIFACTS = [
    ":lib",
    ":unit_binary",
    ":rpc_roundtrip_binary",
]

rust_doc_test(name = "doc", crate = ":lib")
rust_clippy(name = "clippy", testonly = True, deps = DEVELOPER_ARTIFACTS)
rustfmt_test(name = "format", targets = DEVELOPER_ARTIFACTS)
rust_doc(name = "documentation", crate = ":lib")

aos_license_check(
    name = "license_closure",
    testonly = True,
    roots = DEVELOPER_ARTIFACTS,
    license_domain = RUST_PACKAGE.license_domain,
)

aos_license_check(
    name = "production_license_closure",
    roots = [":lib"],
    license_domain = RUST_PACKAGE.license_domain,
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)
