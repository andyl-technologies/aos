load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_binary", "rust_library", "rust_shared_library")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:package.bzl", "aos_package")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")
load("//tools/bazel/rules:wasm.bzl", "aos_browser_dist", "aos_wasm_bindgen")

package(default_visibility = ["//crates:__subpackages__"])

RUST_PACKAGE = aos_rust_package(
    name = "aos-registry-web",
    version = "0.1.0",
    edition = "2021",
    description = "The registry web-surface SPA (RFC-0004): a Leptos client-side-rendered WASM app that progressively enhances a registry's static no-JS pages and verifies channel partitions in the browser using the hub's own surface reader",
    license_expression = "Apache-2.0",
    license_domain = "apache-host",
)

# Cargo declares the browser dependencies on both native and Wasm targets.
DEPENDENCIES = [
    "//crates/registry/aos-registry-format:lib",
    "//third_party/rust:core_anyhow",
    "//third_party/rust:core_gloo_net",
    "//third_party/rust:core_hex",
    "//third_party/rust:core_leptos",
    "//third_party/rust:core_leptos_router",
    "//third_party/rust:core_serde",
    "//third_party/rust:core_serde_json",
    "//third_party/rust:core_wasm_bindgen",
    "//third_party/rust:core_wasm_bindgen_futures",
]

rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    crate_name = "aos_registry_web",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["assets/app.css"],
    deps = DEPENDENCIES,
)

rust_shared_library(
    name = "shared",
    package = RUST_PACKAGE,
    crate_name = "aos_registry_web",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["assets/app.css"],
    deps = DEPENDENCIES,
)

rust_binary(
    name = "aos-registry-spa",
    package = RUST_PACKAGE,
    crate_name = "aos_registry_spa",
    crate_root = "src/main.rs",
    srcs = ["src/main.rs"],
    deps = [":lib"],
)

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    crate = ":lib",
    deps = ["//third_party/rust:core_ed25519_dalek"],
)

aos_rust_test(
    name = "bin_aos-registry-spa",
    package = RUST_PACKAGE,
    crate = ":aos-registry-spa",
    allow_empty = True,
)

DEVELOPER_ARTIFACTS = [":lib", ":shared", ":unit_binary", ":bin_aos-registry-spa_binary"]
rust_doc_test(name = "doc", crate = ":lib")
rust_clippy(name = "clippy", testonly = True, deps = DEVELOPER_ARTIFACTS)
rustfmt_test(name = "format", targets = DEVELOPER_ARTIFACTS)
rust_doc(name = "documentation", crate = ":lib")

aos_license_check(
    name = "license_closure",
    testonly = True,
    roots = DEVELOPER_ARTIFACTS,
    license_domain = RUST_PACKAGE.license_domain,
)

aos_license_check(
    name = "production_license_closure",
    roots = [":lib", ":shared", ":aos-registry-spa"],
    license_domain = RUST_PACKAGE.license_domain,
)

WASM_CONSTRAINTS = ["@platforms//cpu:wasm32", "@platforms//os:none"]

# The real binary mounts the SPA; bindings from the library alone would omit it.
aos_wasm_bindgen(
    name = "browser_bindings",
    wasm = ":aos-registry-spa",
    output_name = "app",
    typescript = True,
    target_compatible_with = WASM_CONSTRAINTS,
)

aos_browser_dist(
    name = "browser_assets",
    bindings = ":browser_bindings",
    stylesheet = "assets/app.css",
    target_compatible_with = WASM_CONSTRAINTS,
)

aos_package(
    name = "browser_dist",
    package = RUST_PACKAGE,
    artifacts = {":aos-registry-spa": "registry-spa.wasm"},
    directories = {":browser_assets": "dist"},
    target_compatible_with = WASM_CONSTRAINTS,
)

rust_clippy(
    name = "browser_clippy",
    deps = [":lib", ":shared", ":aos-registry-spa"],
    target_compatible_with = WASM_CONSTRAINTS,
)

# Foreign libtest artifacts are compiled for later browser qualification.
aos_package(
    name = "browser_test_artifacts",
    package = RUST_PACKAGE,
    testonly = True,
    artifacts = {":unit_binary": "unit.wasm", ":bin_aos-registry-spa_binary": "bin.wasm"},
    target_compatible_with = WASM_CONSTRAINTS,
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    data = ["assets/app.css", "index.html", "Trunk.toml"],
    visibility = ["//visibility:public"],
)
