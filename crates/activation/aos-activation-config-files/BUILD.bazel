load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "cc_binary", "rust_binary", "rust_library")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:package.bzl", "aos_package")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")

package(default_visibility = ["//crates:__subpackages__"])

RUST_PACKAGE = aos_rust_package(
    name = "aos-activation-config-files",
    version = "0.1.0",
    edition = "2024",
    license_expression = "Apache-2.0",
    license_domain = "apache-host",
)

DEPENDENCIES = [
    "//third_party/rust:core_anyhow",
    "//third_party/rust:core_rustix",
    "//third_party/rust:core_serde",
    "//third_party/rust:core_serde_json",
    "//third_party/rust:core_sha2",
]

DEVELOPMENT_DEPENDENCIES = [
    "//third_party/rust:core_tempfile",
    "//third_party/rust:core_toml",
]

# Keep the helper adjacent to the provider in ordinary Bazel outputs as well
# as installed packages, so execution never depends on the caller's PATH.
cc_binary(
    name = "aos-account-lookup",
    srcs = ["//pkgs/system/_aos-configuration-provider:account-lookup.c"],
    copts = ["-std=c11", "-O2", "-Wall", "-Wextra", "-Werror"],
    # rules_cc supplies C++ system libraries; retain the original C-only imports.
    linkopts = ["-Wl,--as-needed"],
)

rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    crate_name = "aos_activation_config_files",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    deps = DEPENDENCIES,
)

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    crate = ":lib",
    deps = DEVELOPMENT_DEPENDENCIES,
    runfile_env = {"AOS_TEST_ACCOUNT_LOOKUP": ":aos-account-lookup"},
)

rust_doc_test(name = "doc", crate = ":lib")

# Preserve the installed command name independently of its package identity.
rust_binary(
    name = "aos-configuration-provider",
    package = RUST_PACKAGE,
    crate_name = "aos_configuration_provider",
    crate_root = "src/main.rs",
    srcs = ["src/main.rs"],
    deps = [":lib"] + DEPENDENCIES,
    data = [":aos-account-lookup"],
)

aos_rust_test(
    name = "bin_aos-configuration-provider",
    package = RUST_PACKAGE,
    crate = ":aos-configuration-provider",
    deps = DEVELOPMENT_DEPENDENCIES,
    allow_empty = True,
)

DEVELOPER_ARTIFACTS = [
    ":lib",
    ":unit_binary",
    ":aos-configuration-provider",
    ":bin_aos-configuration-provider_binary",
]

rust_clippy(name = "clippy", testonly = True, deps = DEVELOPER_ARTIFACTS)
rustfmt_test(name = "format", targets = DEVELOPER_ARTIFACTS)
rust_doc(name = "documentation", crate = ":lib")

aos_license_check(
    name = "license_closure",
    testonly = True,
    roots = DEVELOPER_ARTIFACTS + [":aos-account-lookup"],
    license_domain = RUST_PACKAGE.license_domain,
)

aos_license_check(
    name = "production_license_closure",
    roots = [
        ":lib",
        ":aos-configuration-provider",
        ":aos-account-lookup",
    ],
    license_domain = RUST_PACKAGE.license_domain,
)

aos_package(
    name = "package",
    package_name = "aos-configuration-provider",
    version = "1",
    license_expression = RUST_PACKAGE.license_expression,
    license_domain = RUST_PACKAGE.license_domain,
    artifacts = {
        ":aos-configuration-provider": "bin/aos-configuration-provider",
        ":aos-account-lookup": "bin/aos-account-lookup",
    },
    executables = ["bin/aos-configuration-provider", "bin/aos-account-lookup"],
    visibility = ["//visibility:public"],
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)
