load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_binary", "rust_library")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:package.bzl", "aos_package")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")
load("//tools/bazel/rules:test.bzl", "aos_libtest", "aos_rust_test")

package(default_visibility = ["//crates:__subpackages__"])

RUST_PACKAGE = aos_rust_package(
    name = "aos-activation-nix-store",
    version = "0.1.0",
    edition = "2024",
    license_expression = "Apache-2.0",
    license_domain = "apache-host",
)

DEPENDENCIES = [
    "//crates/activation/aos-activation:lib",
    "//crates/modules/aos-module-format:lib",
    "//crates/artifacts/aos-artifact-evidence:lib",
    "//crates/core/aos-core:lib",
    "//third_party/rust:core_anyhow",
    "//third_party/rust:core_libc",
    "//third_party/rust:core_serde",
    "//third_party/rust:core_serde_json",
    "//third_party/rust:core_tempfile",
]

DEVELOPMENT_DEPENDENCIES = [
    "//third_party/rust:core_tempfile",
]

rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    crate_name = "aos_activation_nix_store",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    deps = DEPENDENCIES,
)

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    crate = ":lib",
    deps = DEVELOPMENT_DEPENDENCIES,
)

rust_doc_test(name = "doc", crate = ":lib")

# Preserve the installed command name independently of its package identity.
rust_binary(
    name = "aos-nix-store-provider",
    package = RUST_PACKAGE,
    crate_name = "aos_nix_store_provider",
    crate_root = "src/main.rs",
    srcs = ["src/main.rs"],
    deps = [":lib"] + DEPENDENCIES,
)

aos_rust_test(
    name = "bin_aos-nix-store-provider",
    package = RUST_PACKAGE,
    crate = ":aos-nix-store-provider",
    deps = DEVELOPMENT_DEPENDENCIES,
    allow_empty = True,
)

DEVELOPER_ARTIFACTS = [
    ":lib",
    ":unit_binary",
    ":aos-nix-store-provider",
    ":bin_aos-nix-store-provider_binary",
]

rust_clippy(name = "clippy", testonly = True, deps = DEVELOPER_ARTIFACTS)
rustfmt_test(name = "format", targets = DEVELOPER_ARTIFACTS)
rust_doc(name = "documentation", crate = ":lib")

aos_license_check(
    name = "license_closure",
    testonly = True,
    roots = DEVELOPER_ARTIFACTS,
    license_domain = RUST_PACKAGE.license_domain,
)

aos_license_check(
    name = "production_license_closure",
    roots = [
        ":lib",
        ":aos-nix-store-provider",
    ],
    license_domain = RUST_PACKAGE.license_domain,
)

# The installed early-boot handler retains its static runtime independently
# of the ordinary development targets.
rust_library(
    name = "static_lib",
    package = RUST_PACKAGE,
    crate_name = "aos_activation_nix_store",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    deps = DEPENDENCIES,
    link_deps = ["@aos_native//:static_runtime"],
)

rust_binary(
    name = "static_provider",
    package = RUST_PACKAGE,
    crate_name = "aos_nix_store_provider",
    crate_root = "src/main.rs",
    srcs = ["src/main.rs"],
    deps = [":static_lib"] + DEPENDENCIES,
)

aos_rust_test(
    name = "static_unit",
    package = RUST_PACKAGE,
    crate = ":static_lib",
    deps = DEVELOPMENT_DEPENDENCIES,
    tags = ["manual"],
)

aos_rust_test(
    name = "static_bin",
    package = RUST_PACKAGE,
    crate = ":static_provider",
    deps = DEVELOPMENT_DEPENDENCIES,
    allow_empty = True,
    tags = ["manual"],
)

rust_doc_test(name = "doc_static", crate = ":static_lib", tags = ["manual"])

aos_license_check(
    name = "static_production_license_closure",
    roots = [":static_lib", ":static_provider"],
    license_domain = RUST_PACKAGE.license_domain,
)

aos_license_check(
    name = "static_license_closure",
    testonly = True,
    roots = [":static_unit_binary", ":static_bin_binary"],
    license_domain = RUST_PACKAGE.license_domain,
)

aos_libtest(
    name = "static_real_nix",
    binary = ":static_unit_binary",
    package_name = RUST_PACKAGE.name,
    # The closure identity also invalidates results when a runtime library changes.
    runfile_env = {
        "AOS_TEST_NIX_STORE": "@aos_nix_test_tools//:bin/nix-store",
        "AOS_TEST_NIX_STORE_CLOSURE": "@aos_nix_test_tools//:closure.json",
    },
    args = [
        "--ignored", "only",
        "--exact", "--filter", "artifact::tests::source_built_nix_store_alias_adds_and_verifies_exact_content",
        "--expected-count", "1",
        "--require-case", "artifact::tests::source_built_nix_store_alias_adds_and_verifies_exact_content",
    ],
    tags = ["manual"],
)

aos_package(
    name = "static_package",
    package_name = "aos-nix-store-provider",
    version = RUST_PACKAGE.version,
    license_expression = RUST_PACKAGE.license_expression,
    license_domain = RUST_PACKAGE.license_domain,
    artifacts = {":static_provider": "bin/aos-nix-store-provider"},
    executables = ["bin/aos-nix-store-provider"],
    visibility = ["//visibility:public"],
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)
