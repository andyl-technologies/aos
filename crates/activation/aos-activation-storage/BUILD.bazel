DEVELOPER_ARTIFACTS = [
    ":lib",
    ":unit_binary",
    ":aos-cryptsetup-provider",
    ":bin_aos-cryptsetup-provider_binary",
    ":aos-storage-format-provider",
    ":bin_aos-storage-format-provider_binary",
    ":aos-zfs-pool-provider",
    ":bin_aos-zfs-pool-provider_binary",
    ":aos-zfs-dataset-provider",
    ":bin_aos-zfs-dataset-provider_binary",
    ":aos-zfs-memory-policy",
    ":bin_aos-zfs-memory-policy_binary",
    ":aos-zfs-maintenance",
    ":bin_aos-zfs-maintenance_binary",
    ":aos-storage-provisioning-provider",
    ":bin_aos-storage-provisioning-provider_binary",
    ":aos-storage-provisioning-marker-observer",
    ":bin_aos-storage-provisioning-marker-observer_binary",
    ":aos-boot-transaction-storage-provider",
    ":bin_aos-boot-transaction-storage-provider_binary",
]

rust_clippy(name = "clippy", testonly = True, deps = DEVELOPER_ARTIFACTS)
rustfmt_test(name = "format", targets = DEVELOPER_ARTIFACTS)
rust_doc(name = "documentation", crate = ":lib")

aos_license_check(
    name = "license_closure",
    testonly = True,
    roots = DEVELOPER_ARTIFACTS,
    license_domain = RUST_PACKAGE.license_domain,
)

aos_license_check(
    name = "production_license_closure",
    roots = [
        ":lib",
        ":aos-cryptsetup-provider",
        ":aos-storage-format-provider",
        ":aos-zfs-pool-provider",
        ":aos-zfs-dataset-provider",
        ":aos-zfs-memory-policy",
        ":aos-zfs-maintenance",
        ":aos-storage-provisioning-provider",
        ":aos-storage-provisioning-marker-observer",
        ":aos-boot-transaction-storage-provider",
    ],
    license_domain = RUST_PACKAGE.license_domain,
)

# The early-boot journal handler keeps a static runtime independently of the
# ordinary activation commands above.
rust_library(
    name = "lib_boot_transaction",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "aos_activation_storage",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    deps = DEPENDENCIES,
    link_deps = ["@aos_native//:static_runtime"],
)

rust_binary(
    name = "static_boot_transaction_storage_provider",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate_name = "aos_boot_transaction_storage_provider",
    crate_root = "src/bin/boot_transaction_storage.rs",
    srcs = ["src/bin/boot_transaction_storage.rs"],
    deps = [":lib_boot_transaction"] + DEPENDENCIES,
)

aos_rust_test(
    name = "boot_transaction_unit",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate = ":lib_boot_transaction",
    deps = DEVELOPMENT_DEPENDENCIES,
    tags = ["manual"],
)

aos_rust_test(
    name = "boot_transaction_bin",
    package = RUST_PACKAGE,
    lint_config = "//tools/bazel/rules:workspace_lints",
    crate = ":static_boot_transaction_storage_provider",
    allow_empty = True,
    tags = ["manual"],
)

rust_doc_test(name = "doc_boot_transaction", crate = ":lib_boot_transaction", tags = ["manual"])

aos_license_check(
    name = "boot_transaction_production_license_closure",
    roots = [":lib_boot_transaction", ":static_boot_transaction_storage_provider"],
    license_domain = RUST_PACKAGE.license_domain,
)

aos_license_check(
    name = "boot_transaction_license_closure",
    testonly = True,
    roots = [":boot_transaction_unit_binary", ":boot_transaction_bin_binary"],
    license_domain = RUST_PACKAGE.license_domain,
)

aos_package(
    name = "boot_transaction_package",
    package_name = "aos-boot-transaction-storage-provider",
    version = RUST_PACKAGE.version,
    license_expression = RUST_PACKAGE.license_expression,
    license_domain = RUST_PACKAGE.license_domain,
    artifacts = {":static_boot_transaction_storage_provider": "bin/aos-boot-transaction-storage-provider"},
    executables = ["bin/aos-boot-transaction-storage-provider"],
    visibility = ["//visibility:public"],
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)
