load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_doc", "rust_doc_test", "rustfmt_test")
load("//tools/bazel/rules:compile.bzl", "rust_library")
load("//tools/bazel/rules:license.bzl", "aos_license_check")
load("//tools/bazel/rules:rust_package.bzl", "aos_rust_package")
load("//tools/bazel/rules:source_package.bzl", "aos_source_package")
load("//tools/bazel/rules:test.bzl", "aos_rust_test")

package(default_visibility = ["//crates:__subpackages__"])

RUST_PACKAGE = aos_rust_package(
    name = "aos-systemd-client",
    version = "0.1.0",
    edition = "2024",
    description = "",
    license_expression = "Apache-2.0",
    license_domain = "apache-host",
)

DEPENDENCIES = [
    "//third_party/rust:core_anyhow",
    "//third_party/rust:core_futures_util",
    "//third_party/rust:core_serde",
    "//third_party/rust:core_thiserror",
    "//third_party/rust:core_tokio",
    "//third_party/rust:core_tracing",
    "//third_party/rust:core_zbus",
]

rust_library(
    name = "lib",
    package = RUST_PACKAGE,
    crate_name = "aos_systemd_client",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    deps = DEPENDENCIES,
)

aos_rust_test(
    name = "unit",
    package = RUST_PACKAGE,
    crate = ":lib",
)

aos_rust_test(
    name = "client",
    package = RUST_PACKAGE,
    crate_name = "client",
    crate_root = "tests/client.rs",
    srcs = glob(["tests/**/*.rs"]),
    deps = [":lib"] + DEPENDENCIES,
)

aos_rust_test(
    name = "pinned_bus",
    allow_ignored_only = True,
    package = RUST_PACKAGE,
    crate_name = "pinned_bus",
    crate_root = "tests/pinned_bus.rs",
    srcs = glob(["tests/**/*.rs"]),
    deps = [":lib"] + DEPENDENCIES,
)

rust_doc_test(
    name = "doc",
    crate = ":lib",
)

DEVELOPER_ARTIFACTS = [
    ":lib",
    ":unit_binary",
    ":client_binary",
    ":pinned_bus_binary",
]

aos_license_check(
    name = "license_closure",
    testonly = True,
    roots = DEVELOPER_ARTIFACTS,
    license_domain = RUST_PACKAGE.license_domain,
)

rust_clippy(
    name = "clippy",
    testonly = True,
    deps = DEVELOPER_ARTIFACTS,
)

rustfmt_test(
    name = "format",
    targets = DEVELOPER_ARTIFACTS,
)

rust_doc(
    name = "documentation",
    crate = ":lib",
)

aos_license_check(
    name = "production_license_closure",
    roots = [":lib"],
    license_domain = RUST_PACKAGE.license_domain,
)

aos_source_package(
    name = "source_package",
    package = RUST_PACKAGE,
    srcs = glob(["**/*.rs"]),
    visibility = ["//visibility:public"],
)
