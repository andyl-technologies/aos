{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dispatch:schema:v1:assignment",
  "title": "Dispatch Assignment version 1",
  "$ref": "#/$defs/Assignment",
  "$defs": {
    "Assignment": {
      "type": "object",
      "properties": {
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Binding"
          },
          "propertyNames": {
            "type": "string",
            "maxLength": 4096
          }
        }
      },
      "required": [
        "bindings"
      ],
      "additionalProperties": false
    },
    "Binding": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "target"
            },
            "target": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "deferred"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
